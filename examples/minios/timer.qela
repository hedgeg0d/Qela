fn pic_init() {
	outb(0x20, 0x11);
	outb(0xa0, 0x11);
	outb(0x21, 0x20);
	outb(0xa1, 0x28);
	outb(0x21, 0x04);
	outb(0xa1, 0x02);
	outb(0x21, 0x01);
	outb(0xa1, 0x01);
	outb(0x21, 0xfd);
	outb(0xa1, 0xff);
}

var ticks i64 = 0;

fn pit_init() {
	outb(0x43, 0x36);
	outb(0x40, 0x9b);
	outb(0x40, 0x2e);
}

fn interrupt timer() {
	ticks = ticks + 1;
	outb(0x20, 0x20);
}
