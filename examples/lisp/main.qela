// expect-exit: 0
// The self-test lives in tests.lisp; `qela test . tests.lisp` runs it.
// main.qela — the driver: an interactive REPL, a batch mode for scripts,
// and a built-in self-test.
//
// The REPL accumulates input lines until the parens balance (the scanner
// skips strings and comments, so only real parens count), then reads,
// evaluates and prints one result per form. Errors never kill the session:
// the error channel is cleared before every top-level form.
//
// Build and run from this directory:
//
//   qela .            # one static binary, no imports between files
//   qela run .        # compile and start the REPL
//   qela run . --test # run the self-test suite
//   qela run . fib.lisp

import "std/buf.qela";
import "std/fmt.qela";
import "std/io.qela";
import "std/str.qela";
import "std/sys.qela";

// Reads one line from fd 0 into out, without the newline. Returns 0 at
// EOF and 1 on a line. There is no read_line in the standard library, so
// the interpreter carries its own.
fn io_read_line(out *Buf) i64 {
	while (true) {
		var c u8 = 0;
		var got i64 = sys_read(0, &c, 1);
		if (got <= 0) { return 0; }
		if (c == '\n') { return 1; }
		if (c == '\r') { continue; }
		buf_u8(out, c);
	}
}

// Paren balance of a REPL buffer: '(' minus ')' with strings and comments
// ignored, so multi-line forms accumulate until they are complete.
fn scan_balance(s str) i64 {
	var bal i64 = 0;
	var i i64 = 0;
	while (i < s.len) {
		var c u8 = s.ptr[i];
		if (c == ';') {
			while (i < s.len && s.ptr[i] != '\n') { i = i + 1; }
			continue;
		}
		if (c == '"') {
			i = i + 1;
			while (i < s.len && s.ptr[i] != '"') {
				if (s.ptr[i] == '\\') { i = i + 1; }
				i = i + 1;
			}
		} else if (c == '(') {
			bal = bal + 1;
		} else if (c == ')') {
			bal = bal - 1;
		}
		i = i + 1;
	}
	return bal;
}

fn print_err() {
	var b Buf;
	fmt_str(&b, "error: ");
	fmt_str(&b, g_msg);
	fmt_str(&b, "\n");
	sys_write(2, b.p, b.n);
}

// Evaluates every form in src, printing each result. Used by the REPL.
fn run_input(env *Env, src str) {
	g_err = false;
	if (src.len == 0) { return; }
	var toks *Tok = lex(src);
	var t *Tok = toks;
	while (t.kind != TK_END) {
		var o Obj = rd_read(&t);
		if (g_err) { print_err(); return; }
		var r Obj = ev_eval(env, o);
		if (g_err) { print_err(); return; }
		var pb Buf;
		pr_obj(&pb, r, true);
		buf_u8(&pb, '\n');
		sys_write(1, pb.p, pb.n);
	}
}

fn repl(env *Env) int {
	var input Buf;
	while (true) {
		write_str(1, "lisp> ");
		var got i64 = io_read_line(&input);
		if (got == 0) {
			if (input.n > 0) { run_input(env, buf_str(&input)); }
			write_str(1, "\n");
			return 0;
		}
		var bal i64 = scan_balance(buf_str(&input));
		if (bal < 0) {
			write_str(2, "error: unbalanced )\n");
			input.n = 0;
			continue;
		}
		if (bal > 0) { continue; }
		run_input(env, buf_str(&input));
		input.n = 0;
	}
	return 0;
}

fn batch(env *Env, path str) int {
	g_err = false;
	var src str = read_file(path);
	var toks *Tok = lex(src);
	var t *Tok = toks;
	while (t.kind != TK_END) {
		var o Obj = rd_read(&t);
		if (g_err) { print_err(); return 1; }
		ev_eval(env, o);
		if (g_err) { print_err(); return 1; }
	}
	return 0;
}

fn init_env(env *Env) {
	env_define(env, "t", sym_intern("t"));
	env_define(env, "nil", Obj.Nil);
	bl_install(env);
}

fn usage() {
	write_str(1, "qela-lisp — a Lisp interpreter in Qela\n\nusage: lisp [file.lisp]\n\nno arguments     start the REPL\nfile.lisp        evaluate the file, then exit\n\nself-test:       qela test . tests.lisp\n");
}

fn main(argc int, argv **u8) int {
	var env *Env = env_new(0 as *Env);
	init_env(env);
	if (argc >= 2) {
		var a str = str_from_cstr(argv[1]);
		if (str_eq(a, "-h") || str_eq(a, "--help")) { usage(); return 0; }
		return batch(env, a);
	}
	return repl(env);
}
