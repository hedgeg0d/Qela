import "arena.qela";
import "buf.qela";
import "str.qela";
import "sys.qela";

fn fmt_i64(b *Buf, v i64) {
	var neg bool = v < 0;
	if (neg) { v = -v; }
	var rev [24]u8;
	var n i64 = 0;
	if (v == 0) { rev[0] = '0'; n = 1; }
	while (v > 0) {
		rev[n] = ('0' as i64 + v % 10) as u8;
		v = v / 10;
		n = n + 1;
	}
	if (neg) { rev[n] = '-'; n = n + 1; }
	while (n > 0) { n = n - 1; buf_u8(b, rev[n]); }
}

// Same as fmt_i64 but writes directly to a file descriptor: no Buf
// allocation, no copy. Used by diagnostics on stderr.
fn fmt_i64_to_fd(fd i64, v i64) {
	var neg bool = v < 0;
	if (neg) { v = -v; }
	var rev [24]u8;
	var n i64 = 0;
	if (v == 0) { rev[0] = '0'; n = 1; }
	while (v > 0) {
		rev[n] = ('0' as i64 + v % 10) as u8;
		v = v / 10;
		n = n + 1;
	}
	if (neg) { rev[n] = '-'; n = n + 1; }
	while (n > 0) { n = n - 1; sys_write(fd, &rev[n], 1); }
}

fn fmt_hex(b *Buf, v i64) {
	var hex [16]u8;
	hex[0] = '0'; hex[1] = '1'; hex[2] = '2'; hex[3] = '3';
	hex[4] = '4'; hex[5] = '5'; hex[6] = '6'; hex[7] = '7';
	hex[8] = '8'; hex[9] = '9'; hex[10] = 'a'; hex[11] = 'b';
	hex[12] = 'c'; hex[13] = 'd'; hex[14] = 'e'; hex[15] = 'f';
	var i i64 = 60;
	while (i >= 0) {
		var d i64 = (v >> i) & 15;
		buf_u8(b, hex[d]);
		i = i - 4;
	}
}

fn fmt_str(b *Buf, s str) {
	buf_bytes(b, s.ptr, s.len);
}

// The by-value chain behind "..." string interpolation: the compiler
// rewrites an interpolated string into fmt_result(fmt_put_*(...,
// fmt_begin())). Each chain allocates its own buffer, so two interpolated
// strings alive at once never alias. Note for maintainers: this module's
// text is embedded in the compiler as a string literal, so the two
// characters that start an interpolation must never appear here.
fn fmt_begin() Buf {
	var b Buf;
	return b;
}

fn fmt_put_str(b Buf, s str) Buf {
	buf_bytes(&b, s.ptr, s.len);
	return b;
}

fn fmt_put_i64(b Buf, v i64) Buf {
	fmt_i64(&b, v);
	return b;
}

fn fmt_put_hex(b Buf, v i64) Buf {
	fmt_hex(&b, v);
	return b;
}

fn fmt_put_bool(b Buf, v bool) Buf {
	if (v) { fmt_str(&b, "true"); }
	else { fmt_str(&b, "false"); }
	return b;
}

// `${s!r}`: a quoted, escaped repr of a string.
fn fmt_put_repr(b Buf, s str) Buf {
	buf_u8(&b, '"');
	var i i64 = 0;
	while (i < s.len) {
		var c u8 = s.ptr[i];
		if (c == '"') { fmt_str(&b, "\\\""); }
		else if (c == '\\') { fmt_str(&b, "\\\\"); }
		else if (c == '\n') { fmt_str(&b, "\\n"); }
		else if (c == '\t') { fmt_str(&b, "\\t"); }
		else if (c == '\r') { fmt_str(&b, "\\r"); }
		else { buf_u8(&b, c); }
		i = i + 1;
	}
	buf_u8(&b, '"');
	return b;
}

// `${x:5d}` / `${x:05d}`: decimal padded to a width, spaces or zeros.
// The sign sits inside the padding: -5 with :05d prints "-0005".
fn fmt_put_i64_w(b Buf, v i64, w i64, zp bool) Buf {
	var neg bool = v < 0;
	if (neg) { v = -v; }
	var rev [24]u8;
	var n i64 = 0;
	if (v == 0) { rev[0] = '0'; n = 1; }
	while (v > 0) {
		rev[n] = ('0' as i64 + v % 10) as u8;
		v = v / 10;
		n = n + 1;
	}
	var pad i64 = w - n;
	if (neg) { pad = pad - 1; }
	if (pad < 0) { pad = 0; }
	if (!zp) {
		var i i64 = 0;
		while (i < pad) { buf_u8(&b, ' '); i = i + 1; }
	}
	if (neg) { buf_u8(&b, '-'); }
	if (zp) {
		var i i64 = 0;
		while (i < pad) { buf_u8(&b, '0'); i = i + 1; }
	}
	while (n > 0) { n = n - 1; buf_u8(&b, rev[n]); }
	return b;
}

// `${x:08x}` / `${x:08X}`: the low `w` hex digits, zero-padded. A width
// past 16 is all leading zeros: the value's bits never go that high.
fn fmt_put_hex_w(b Buf, v i64, w i64, upper bool) Buf {
	var hex [16]u8;
	hex[0] = '0'; hex[1] = '1'; hex[2] = '2'; hex[3] = '3';
	hex[4] = '4'; hex[5] = '5'; hex[6] = '6'; hex[7] = '7';
	hex[8] = '8'; hex[9] = '9'; hex[10] = 'a'; hex[11] = 'b';
	hex[12] = 'c'; hex[13] = 'd'; hex[14] = 'e'; hex[15] = 'f';
	var n i64 = w;
	if (n > 16) { n = 16; }
	var i i64 = 0;
	while (i < w - n) { buf_u8(&b, '0'); i = i + 1; }
	i = n - 1;
	while (i >= 0) {
		var d i64 = (v >> (4 * i)) & 15;
		var c u8 = hex[d];
		if (upper && d >= 10) { c = (c as i64 - 32) as u8; }
		buf_u8(&b, c);
		i = i - 1;
	}
	return b;
}

fn fmt_result(b Buf) str {
	var s str;
	s.ptr = b.p;
	s.len = b.n;
	return s;
}

// Float printing, pure integer arithmetic: stage0 compiles this module with
// no float support, so a float never appears here as a value — the caller
// passes the raw IEEE754 bit pattern as an i64, converted digit-by-digit on
// a binary big-number array.
let FDIG_CAP = 1200;

// Divides the MSB-first bit array by 10 in place; returns the remainder,
// the next decimal digit from the low end (used to print an exact integer).
fn fdig_div10(a *u8, start i64, end i64) i64 {
	var rem i64 = 0;
	var i i64 = start;
	while (i < end) {
		var cur i64 = rem * 2 + (a[i] as i64);
		a[i] = (cur / 10) as u8;
		rem = cur % 10;
		i = i + 1;
	}
	return rem;
}

// Multiplies the MSB-first bit array by 10 in place; the overflow past the
// array's own width is the next decimal digit (used to print a fraction).
fn fdig_mul10(a *u8, start i64, end i64) i64 {
	var carry i64 = 0;
	var i i64 = end - 1;
	while (i >= start) {
		var v i64 = (a[i] as i64) * 10 + carry;
		a[i] = (v % 2) as u8;
		carry = v / 2;
		i = i - 1;
	}
	return carry;
}

fn fdig_allzero(a *u8, start i64, end i64) bool {
	var i i64 = start;
	while (i < end) {
		if (a[i] != 0) { return false; }
		i = i + 1;
	}
	return true;
}

// bits: the raw IEEE754 double bit pattern. Ties round half-up rather than
// half-to-even and denormals print as 0 -- acceptable for a hobby compiler,
// not for a libc (dec_to_f64_bits carries the same limitations).
fn fmt_f64_bits(b *Buf, bits i64) {
	var sign i64 = (bits >> 63) & 1;
	var expf i64 = (bits >> 52) & 0x7ff;
	var mant i64 = bits & 0xfffffffffffff;

	if (sign != 0) { buf_u8(b, '-'); }

	if (expf == 0x7ff) {
		if (mant == 0) { fmt_str(b, "inf"); } else { fmt_str(b, "nan"); }
		return;
	}
	if (expf == 0 && mant == 0) { fmt_str(b, "0"); return; }

	var m i64 = mant;
	var e i64 = 0;
	if (expf == 0) {
		e = 1 - 1023 - 52;
	} else {
		m = mant | 0x10000000000000;
		e = expf - 1023 - 52;
	}

	// m's 53 significant bits, MSB first.
	var mbits [53]u8;
	var i i64 = 0;
	while (i < 53) {
		mbits[i] = ((m >> (52 - i)) & 1) as u8;
		i = i + 1;
	}

	if (e >= 0) {
		// An exact integer: pad m with e zero bits and read decimal digits
		// off the low end.
		var n i64 = 53 + e;
		var arr *u8 = arena_alloc(n, 1);
		i = 0;
		while (i < 53) { arr[i] = mbits[i]; i = i + 1; }
		i = 53;
		while (i < n) { arr[i] = 0; i = i + 1; }
		fdig_print_int(b, arr, n);
		return;
	}

	var w i64 = -e;
	if (w >= 53) { buf_u8(b, '0'); }
	else { fmt_i64(b, m >> w); }
	buf_u8(b, '.');

	var frac *u8 = arena_alloc(w, 1);
	if (w > 53) {
		i = 0;
		while (i < w - 53) { frac[i] = 0; i = i + 1; }
		var j i64 = 0;
		while (j < 53) { frac[w - 53 + j] = mbits[j]; j = j + 1; }
	} else {
		i = 0;
		while (i < w) { frac[i] = mbits[53 - w + i]; i = i + 1; }
	}

	// A double carries at most ~17 significant decimal digits; past that the
	// exact binary-to-decimal expansion is just noise. Leading zeros before
	// the first nonzero digit do not count against the cap.
	var printed i64 = 0;
	var any bool = false;
	var sig i64 = 0;
	while (printed < w && sig < 17) {
		if (fdig_allzero(frac, 0, w)) { break; }
		var d i64 = fdig_mul10(frac, 0, w);
		buf_u8(b, ('0' as i64 + d) as u8);
		any = true;
		printed = printed + 1;
		if (d != 0 || sig > 0) { sig = sig + 1; }
	}
	if (!any) { buf_u8(b, '0'); }
}

fn fmt_put_f64_bits(b Buf, bits i64) Buf {
	fmt_f64_bits(&b, bits);
	return b;
}

// Prints an MSB-first bit array's decimal value. Used by fmt_f64_bits and
// fmt_f64_fixed for the integer part.
fn fdig_print_int(b *Buf, arr *u8, n i64) {
	var digs *u8 = arena_alloc(n, 1);
	var nd i64 = 0;
	while (!fdig_allzero(arr, 0, n) && nd < FDIG_CAP) {
		digs[nd] = fdig_div10(arr, 0, n) as u8;
		nd = nd + 1;
	}
	if (nd == 0) { buf_u8(b, '0'); }
	else {
		var i i64 = nd;
		while (i > 0) { i = i - 1; buf_u8(b, ('0' as i64 + (digs[i] as i64)) as u8); }
	}
}

// `${x:.2f}`: fixed-point with exactly `prec` digits after the point,
// rounding half-up on the prec+1-th digit. The carry can ripple into the
// integer part, so the fraction is fully rounded before it is printed.
fn fmt_f64_fixed(b *Buf, bits i64, prec i64) {
	var sign i64 = (bits >> 63) & 1;
	var expf i64 = (bits >> 52) & 0x7ff;
	var mant i64 = bits & 0xfffffffffffff;

	if (sign != 0) { buf_u8(b, '-'); }

	if (expf == 0x7ff) {
		if (mant == 0) { fmt_str(b, "inf"); } else { fmt_str(b, "nan"); }
		return;
	}
	if (expf == 0 && mant == 0) {
		buf_u8(b, '0');
		var z i64 = 0;
		while (z < prec) { buf_u8(b, '0'); z = z + 1; }
		return;
	}

	var m i64 = mant;
	var e i64 = 0;
	if (expf == 0) {
		e = 1 - 1023 - 52;
	} else {
		m = mant | 0x10000000000000;
		e = expf - 1023 - 52;
	}

	var mbits [53]u8;
	var i i64 = 0;
	while (i < 53) {
		mbits[i] = ((m >> (52 - i)) & 1) as u8;
		i = i + 1;
	}

	var intv i64 = 0;
	if (e >= 0) {
		// An exact integer: the fraction is all zeros.
		var n i64 = 53 + e;
		var arr *u8 = arena_alloc(n, 1);
		i = 0;
		while (i < 53) { arr[i] = mbits[i]; i = i + 1; }
		i = 53;
		while (i < n) { arr[i] = 0; i = i + 1; }
		fdig_print_int(b, arr, n);
		buf_u8(b, '.');
		i = 0;
		while (i < prec) { buf_u8(b, '0'); i = i + 1; }
		return;
	}

	var w i64 = -e;
	if (w < 53) { intv = m >> w; }

	var frac *u8 = arena_alloc(w, 1);
	if (w > 53) {
		i = 0;
		while (i < w - 53) { frac[i] = 0; i = i + 1; }
		var j i64 = 0;
		while (j < 53) { frac[w - 53 + j] = mbits[j]; j = j + 1; }
	} else {
		i = 0;
		while (i < w) { frac[i] = mbits[53 - w + i]; i = i + 1; }
	}

	var digs *u8 = arena_alloc(prec + 1, 1);
	var k i64 = 0;
	while (k < prec) {
		digs[k] = fdig_mul10(frac, 0, w) as u8;
		k = k + 1;
	}
	var round_up bool = fdig_mul10(frac, 0, w) >= 5;
	var carry bool = round_up;
	k = prec;
	while (k > 0 && carry) {
		k = k - 1;
		var d i64 = digs[k] as i64 + 1;
		if (d == 10) { digs[k] = 0; carry = true; }
		else { digs[k] = d as u8; carry = false; }
	}
	if (carry) { intv = intv + 1; }

	fmt_i64(b, intv);
	buf_u8(b, '.');
	k = 0;
	while (k < prec) {
		buf_u8(b, ('0' as i64 + (digs[k] as i64)) as u8);
		k = k + 1;
	}
}

fn fmt_put_f64_fixed(b Buf, bits i64, prec i64) Buf {
	fmt_f64_fixed(&b, bits, prec);
	return b;
}

fn eprint_i64(v i64) {
	var b Buf;
	fmt_i64(&b, v);
	sys_write(STDERR, b.p, b.n);
}

fn eprint_str(s str) {
	sys_write(STDERR, s.ptr, s.len);
}
