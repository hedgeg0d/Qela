// Deterministic xorshift64* — a split-mix style generator with 64 bits of
// state and an output that passes simple statistical eyeballing. The
// default seed is fixed, so an unseeded program is reproducible; seed once
// with rand_init for anything that must not be.

var rand_state i64 = 0x9E3779B97F4A7C15;

/// Seeds the random generator with a value.
fn rand_init(seed i64) {
	rand_state = seed;
	if (rand_state == 0) { rand_state = 0x9E3779B97F4A7C15; }
}

// A full 64-bit value. The top bit is masked off so the result is never
// negative, which keeps `%` well-behaved in rand_range.
/// Returns a random unsigned 64-bit value.
fn rand_u64() i64 {
	var x i64 = rand_state;
	x = x ^ (x >> 12);
	x = x ^ (x << 25);
	x = x ^ (x >> 27);
	rand_state = x;
	return (x * 0x2545F4914F6CDD1D) & 0x7FFFFFFFFFFFFFFF;
}

/// Returns a random integer in a half-open range.
fn rand_range(lo i64, hi i64) i64 {
	if (hi <= lo) { return lo; }
	return lo + rand_u64() % (hi - lo);
}
