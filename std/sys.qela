// The only place in stage1 where a raw syscall is allowed.
import "str.qela";

let SYS_READ  = 0;
let SYS_WRITE = 1;
let SYS_OPEN  = 2;
let SYS_CLOSE = 3;
let SYS_STAT  = 4;
let SYS_MMAP  = 9;
let SYS_EXIT   = 60;
let SYS_EXIT_GROUP = 231;
let SYS_FORK   = 57;
let SYS_EXECVE = 59;
let SYS_WAIT4  = 61;
let SYS_UNLINK = 87;
let SYS_GETPID = 39;
let SYS_GETDENTS = 217;
let SYS_DUP2 = 33;
let SYS_IOCTL = 16;
let SYS_MUNMAP = 11;
let SYS_CLONE = 56;
let SYS_ARCH_PRCTL = 158;
let SYS_FUTEX = 202;
let SYS_SCHED_YIELD = 24;
let SYS_READLINK = 89;
let SYS_MEMFD_CREATE = 319;
let SYS_EXECVEAT = 322;
let SYS_PIPE2 = 293;
let SYS_SOCKETPAIR = 53;
let SYS_MPROTECT = 10;
let SYS_UNAME   = 63;
let SYS_MKDIR  = 83;
let SYS_RMDIR  = 84;
let SYS_RENAME = 82;
let SYS_GETCWD = 79;
let SYS_RT_SIGACTION = 13;
let SYS_KILL   = 62;
let SYS_RT_SIGRETURN = 15;
let SIG_DFL = 0;
let SIG_IGN = 1;
let SIGUSR1 = 10;
let SIGUSR2 = 12;
let SIGALRM = 14;
let SIGTERM = 15;
let SIGINT  = 2;
let SA_RESTORER = 0x04000000;
let SA_RESTART  = 0x10000000;
let SA_NODEFER  = 0x40000000;

$if (TARGET != "x86_64") {
let SYS_READ_N  = 63;
let SYS_WRITE_N = 64;
let SYS_OPENAT_N = 56;
let SYS_CLOSE_N = 57;
let SYS_NEWFSTATAT_N = 79;
let SYS_MMAP_N  = 222;
let SYS_EXIT_N   = 93;
let SYS_EXIT_GROUP_N = 94;
let SYS_EXECVE_N = 221;
let SYS_WAIT4_N  = 260;
let SYS_UNLINKAT_N = 35;
let SYS_GETPID_N = 172;
let SYS_GETDENTS_N = 61;
let SYS_DUP3_N = 24;
let SYS_IOCTL_N = 29;
let SYS_MKDIR_N = 34;
let SYS_RMDIR_N = 21;
let SYS_RENAME_N = 82;
let SYS_GETCWD_N = 17;
let SYS_RT_SIGACTION_N = 134;
let SYS_KILL_N = 129;
let SYS_RT_SIGRETURN_N = 139;
let SYS_MUNMAP_N = 215;
let SYS_CLONE_N = 220;
let SYS_FUTEX_N = 98;
let SYS_SCHED_YIELD_N = 124;
let SYS_READLINKAT_N = 78;
let SYS_MEMFD_CREATE_N = 279;
let SYS_EXECVEAT_N = 281;
let SYS_PIPE2_N = 59;
let SYS_SOCKETPAIR_N = 199;
let SYS_MPROTECT_N = 226;
let SYS_UNAME_N   = 160;
let AT_FDCWD = -100;
}

let AT_EMPTY_PATH = 0x1000;
let AF_UNIX = 1;
let SOCK_STREAM = 1;

let ARCH_SET_FS = 0x1002;
let ARCH_GET_FS = 0x1003;

let FUTEX_WAIT = 0;
let FUTEX_WAKE = 1;

// CLONE_VM(0x100)|CLONE_FS(0x200)|CLONE_FILES(0x400)|CLONE_SIGHAND(0x800)|
// CLONE_THREAD(0x10000) -- a real OS thread sharing the parent's address
// space, not a fork. No CLONE_SETTLS yet: that lands with the tvar/TLS
// phase, once there's a per-thread block to point %fs at. arm64 adds
// CLONE_SYSVSEM(0x40000): qemu user-mode rejects the bare thread set with
// EINVAL, and real kernels accept both forms.
$if (TARGET != "x86_64") {
let CLONE_THREAD_FLAGS = 331520;
} $else {
let CLONE_THREAD_FLAGS = 69376;
}

let STDOUT = 1;
let STDERR = 2;

let O_WRITE_NEW   = 577;  // O_WRONLY | O_CREAT | O_TRUNC
let O_WRITE_APPEND = 1089; // O_WRONLY | O_CREAT | O_APPEND

fn sys_read(fd i64, buf *u8, n i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_READ_N, fd, buf as i64, n);
	}
	return syscall(SYS_READ, fd, buf as i64, n);
}

fn sys_write(fd i64, buf *u8, n i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_WRITE_N, fd, buf as i64, n);
	}
	return syscall(SYS_WRITE, fd, buf as i64, n);
}

fn sys_open_read(path *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_OPENAT_N, AT_FDCWD, path as i64, 0, 0);
	}
	return syscall(SYS_OPEN, path as i64, 0, 0);
}

fn sys_open_exec(path *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_OPENAT_N, AT_FDCWD, path as i64, O_WRITE_NEW, 493);
	}
	return syscall(SYS_OPEN, path as i64, O_WRITE_NEW, 493);
}

fn sys_open_append(path *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_OPENAT_N, AT_FDCWD, path as i64, O_WRITE_APPEND, 493);
	}
	return syscall(SYS_OPEN, path as i64, O_WRITE_APPEND, 493);
}

fn sys_close(fd i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_CLOSE_N, fd, 0, 0);
	}
	return syscall(SYS_CLOSE, fd, 0, 0);
}

fn sys_mmap_anon(n i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_MMAP_N, 0, n, 3, 34, -1, 0);
	}
	return syscall(SYS_MMAP, 0, n, 3, 34, -1, 0);
}

fn sys_munmap(addr i64, n i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_MUNMAP_N, addr, n, 0);
	}
	return syscall(SYS_MUNMAP, addr, n, 0);
}

// A full mmap: an anonymous mapping is sys_mmap_anon(0, n, rw, anon,
// -1, 0); a file mapping passes the fd and offset. Returns the mapping
// address or a negative errno.
fn sys_mmap(addr i64, len i64, prot i64, flags i64, fd i64, off i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_MMAP_N, addr, len, prot, flags, fd, off);
	}
	return syscall(SYS_MMAP, addr, len, prot, flags, fd, off);
}

fn sys_mkdir(path *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_MKDIR_N, path as i64, 0, 0);
	}
	return syscall(SYS_MKDIR, path as i64, 0, 0);
}

fn sys_rmdir(path *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_RMDIR_N, path as i64, 0, 0);
	}
	return syscall(SYS_RMDIR, path as i64, 0, 0);
}

fn sys_rename(old *u8, new *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_RENAME_N, old as i64, new as i64, 0);
	}
	return syscall(SYS_RENAME, old as i64, new as i64, 0);
}

fn sys_getcwd(buf *u8, n i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_GETCWD_N, buf as i64, n, 0);
	}
	return syscall(SYS_GETCWD, buf as i64, n, 0);
}

// The rt_sigaction layout is the same on every target: handler, flags,
// restorer, then the 8-byte kernel sigset. act may be null to read only.
fn sys_rt_sigaction(sig i64, act *u8, old *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_RT_SIGACTION_N, sig, act as i64, old as i64, 8);
	}
	return syscall(SYS_RT_SIGACTION, sig, act as i64, old as i64, 8);
}

fn sys_kill(pid i64, sig i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_KILL_N, pid, sig, 0);
	}
	return syscall(SYS_KILL, pid, sig, 0);
}

fn sys_sigreturn() i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_RT_SIGRETURN_N, 0, 0, 0);
	}
	return syscall(SYS_RT_SIGRETURN, 0, 0, 0);
}

// Raw x86-64 clone() argument order: flags, child stack top, parent tid
// pointer, child tid pointer, tls base. The caller builds the child's
// initial stack image itself -- there is no libc clone() wrapper to hide
// that behind. ARM64 clone() takes the same argument order.
fn sys_clone(flags i64, stack i64, ptid i64, ctid i64, tls i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_CLONE_N, flags, stack, ptid, ctid, tls);
	}
	return syscall(SYS_CLONE, flags, stack, ptid, ctid, tls);
}

fn sys_arch_prctl(code i64, addr i64) i64 {
	return syscall(SYS_ARCH_PRCTL, code, addr, 0);
}

fn sys_futex(uaddr *i64, op i64, val i64, timeout i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_FUTEX_N, uaddr as i64, op, val, timeout, 0, 0);
	}
	return syscall(SYS_FUTEX, uaddr as i64, op, val, timeout, 0, 0);
}

// Gives up the rest of this thread's timeslice, so a spin-wait doesn't
// starve another thread of the core it needs to make progress.
fn sys_sched_yield() {
	$if (TARGET != "x86_64") {
		syscall(SYS_SCHED_YIELD_N, 0, 0, 0, 0, 0, 0);
		return;
	}
	syscall(SYS_SCHED_YIELD, 0, 0, 0, 0, 0, 0);
}

// exit_group, not exit: this ends the whole process, not just the calling
// thread. A program that has spawned real OS threads (thread_clone,
// thread_pool_init/go) and then hits any of this module's early-exit paths
// (die(), a file error, ...) would otherwise only kill the calling thread --
// every other thread (a pool worker's own infinite loop, in particular)
// keeps running forever, holding stdout/stderr open and the process alive
// as far as anything waiting on it (a shell's `$(...)`, `wait4`) can tell.
// Found by exactly that: a corpus test hung forever under a plain foreground
// run once its debug-log write hit a permission error and called die(),
// confirmed with `strace -f` showing a bare exit(1) (not exit_group) while
// four pool-worker threads kept running.
fn sys_exit(code i64) {
	$if (TARGET != "x86_64") {
		syscall(SYS_EXIT_GROUP_N, code, 0, 0, 0, 0, 0);
	} $else {
		syscall(SYS_EXIT_GROUP, code, 0, 0, 0, 0, 0);
	}
}

fn sys_fork() i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_CLONE_N, 17, 0, 0, 0, 0);
	}
	return syscall(SYS_FORK, 0, 0, 0);
}

fn sys_execve(path *u8, argv *u8, envp *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_EXECVE_N, path as i64, argv as i64, envp as i64);
	}
	return syscall(SYS_EXECVE, path as i64, argv as i64, envp as i64);
}

fn sys_wait4(pid i64, status *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_WAIT4_N, pid, status as i64, 0, 0);
	}
	return syscall(SYS_WAIT4, pid, status as i64, 0, 0);
}

fn sys_unlink(path *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_UNLINKAT_N, AT_FDCWD, path as i64, 0);
	}
	return syscall(SYS_UNLINK, path as i64, 0, 0);
}

// Reads /proc/self/environ and returns the value of `name` if set, "" if
// not. The string is the slice between this 'name=' and the next NUL byte.
// Used by diagnostics to honour NO_COLOR and check TERM. Empty when not on
// Linux; the caller treats "" as "not set".
fn sys_getenv(name str) str {
	var path str = "/proc/self/environ";
	var fd i64 = sys_open_read(cstr(path));
	if (fd < 0) { var e str; return e; }
	var buf [4096]u8;
	var n i64 = 0;
	var got i64 = 1;
	while (got > 0) {
		got = sys_read(fd, &buf[0] + n, 4096 - n);
		if (got > 0) { n = n + got; }
	}
	sys_close(fd);
	if (n == 0) { var e str; return e; }
	var i i64 = 0;
	while (i < n) {
		var eq i64 = i;
		while (eq < n && buf[eq] != '=') { eq = eq + 1; }
		if (eq >= n) { break; }
		var end i64 = eq + 1;
		while (end < n && buf[end] != 0) { end = end + 1; }
		if (eq - i == name.len) {
			var k i64 = 0;
			var found bool = true;
			while (k < name.len) {
				if (buf[i + k] != name.ptr[k]) { found = false; }
				k = k + 1;
			}
			if (found) {
				var r str;
				r.ptr = &buf[0] + eq + 1;
				r.len = end - eq - 1;
				return r;
			}
		}
		i = end + 1;
	}
	var e str;
	return e;
}

fn sys_getpid() i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_GETPID_N, 0, 0, 0);
	}
	return syscall(SYS_GETPID, 0, 0, 0);
}

fn sys_stat(path *u8, buf *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_NEWFSTATAT_N, AT_FDCWD, path as i64, buf as i64, 0);
	}
	return syscall(SYS_STAT, path as i64, buf as i64, 0);
}

