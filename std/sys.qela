	$if (TARGET != "x86_64") {
		return syscall(SYS_GETDENTS_N, fd, buf as i64, n);
	}
	return syscall(SYS_GETDENTS, fd, buf as i64, n);
}

fn sys_dup2(old i64, new i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_DUP3_N, old, new, 0);
	}
	return syscall(SYS_DUP2, old, new, 0);
}

// TIOCGETS succeeds on a terminal: 0 on a tty, -1 elsewhere.
fn sys_isatty() i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_IOCTL_N, 0, 0x5401, 0);
	}
	return syscall(SYS_IOCTL, 0, 0x5401, 0);
}

fn sys_readlink(path *u8, buf *u8, n i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_READLINKAT_N, AT_FDCWD, path as i64, buf as i64, n);
	}
	return syscall(SYS_READLINK, path as i64, buf as i64, n);
}

fn sys_memfd_create(name *u8, flags i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_MEMFD_CREATE_N, name as i64, flags, 0);
	}
	return syscall(SYS_MEMFD_CREATE, name as i64, flags, 0);
}

// execveat with AT_EMPTY_PATH wants a valid pointer to an empty string,
// not NULL -- the kernel faults on the latter.
var fexec_empty [1]u8;

fn sys_fexecve(fd i64, argv *u8, envp *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_EXECVEAT_N, fd, &fexec_empty[0] as i64, argv as i64, envp as i64, AT_EMPTY_PATH, 0);
	}
	return syscall(SYS_EXECVEAT, fd, &fexec_empty[0] as i64, argv as i64, envp as i64, AT_EMPTY_PATH, 0);
}

fn sys_pipe2(fds *i32, flags i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_PIPE2_N, fds as i64, flags, 0);
	}
	return syscall(SYS_PIPE2, fds as i64, flags, 0);
}

fn sys_socketpair(domain i64, kind i64, protocol i64, fds *i32) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_SOCKETPAIR_N, domain, kind, protocol, fds as i64, 0);
	}
	return syscall(SYS_SOCKETPAIR, domain, kind, protocol, fds as i64, 0);
}

fn sys_mprotect(addr i64, len i64, prot i64) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_MPROTECT_N, addr, len, prot);
	}
	return syscall(SYS_MPROTECT, addr, len, prot);
}

// uname(2): fills the 390-byte struct utsname (six 65-byte fields:
// sysname, nodename, release, version, machine, domainname). The machine
// field starts at offset 195. Used by the compiler to detect the host
// architecture when no --target was given.
fn sys_uname(buf *u8) i64 {
	$if (TARGET != "x86_64") {
		return syscall(SYS_UNAME_N, buf as i64, 0, 0);
	}
	return syscall(SYS_UNAME, buf as i64, 0, 0);
}

// A syscall whose number is only known at runtime, for srcql/interp.qela:
// an interpreted `syscall(...)` forwards straight to the host kernel. The
// arguments arrive through a pointer because a function takes at most six
// parameters and a syscall takes six plus its number. Unused trailing
// arguments must be zero, which every caller here arranges.
fn sys_call6(nr i64, a *i64) i64 {
	return syscall(nr, a[0], a[1], a[2], a[3], a[4], a[5]);
}

fn write_str(fd i64, s str) {
	sys_write(fd, s.ptr, s.len);
}

fn eprint(s str) {
	sys_write(STDERR, s.ptr, s.len);
}
