import "sys.qela";
import "str.qela";
import "buf.qela";
import "fmt.qela";
import "arena.qela";
import "abiwire.qela";

var abi_pid i64 = -1;
var abi_in i64 = -1;
var abi_out i64 = -1;

fn abi_path_exists(p str) bool {
	var st [144]u8;
	return sys_stat(cstr(p), &st[0]) == 0;
}

fn abi_find_on_path(name str) str {
	var path str = sys_getenv("PATH");
	var i i64 = 0;
	while (i <= path.len) {
		var start i64 = i;
		while (i < path.len && path.ptr[i] != ':') { i = i + 1; }
		var dir str = str_slice(path, start, i);
		if (dir.len > 0) {
			var b Buf;
			fmt_str(&b, dir);
			buf_u8(&b, '/');
			fmt_str(&b, name);
			var cand str = buf_str(&b);
			if (abi_path_exists(cand)) { return cand; }
		}
		i = i + 1;
	}
	var e str;
	return e;
}

fn abi_self_path() str {
	var qp str = sys_getenv("QELAPATH");
	if (qp.len > 0) { return qp; }
	var found str = abi_find_on_path("qela");
	if (found.len > 0) { return found; }
	eprint("eval/interpreted/dynamic needs the qela compiler at runtime; set QELAPATH=$(which qela) or put qela on PATH\n");
	sys_exit(1);
	var e str;
	return e;
}

fn abi_spawn() {
	if (abi_pid >= 0) { return; }
	var path str = abi_self_path();

	var in_pipe [2]i32;
	var out_pipe [2]i32;
	if (sys_pipe2(&in_pipe[0], 0) != 0) { eprint("eval: pipe failed\n"); sys_exit(1); }
	if (sys_pipe2(&out_pipe[0], 0) != 0) { eprint("eval: pipe failed\n"); sys_exit(1); }

	var pid i64 = sys_fork();
	if (pid == 0) {
		sys_dup2(in_pipe[0] as i64, ABI_FD_HOST_TO_CHILD);
		sys_dup2(out_pipe[1] as i64, ABI_FD_CHILD_TO_HOST);
		if (in_pipe[0] as i64 != ABI_FD_HOST_TO_CHILD && in_pipe[0] as i64 != ABI_FD_CHILD_TO_HOST) {
			sys_close(in_pipe[0] as i64);
		}
		if (in_pipe[1] as i64 != ABI_FD_HOST_TO_CHILD && in_pipe[1] as i64 != ABI_FD_CHILD_TO_HOST) {
			sys_close(in_pipe[1] as i64);
		}
		if (out_pipe[0] as i64 != ABI_FD_HOST_TO_CHILD && out_pipe[0] as i64 != ABI_FD_CHILD_TO_HOST) {
			sys_close(out_pipe[0] as i64);
		}
		if (out_pipe[1] as i64 != ABI_FD_HOST_TO_CHILD && out_pipe[1] as i64 != ABI_FD_CHILD_TO_HOST) {
			sys_close(out_pipe[1] as i64);
		}
		var cpath *u8 = cstr(path);
		var cargv [3]i64;
		cargv[0] = cpath as i64;
		cargv[1] = cstr("--abi-server") as i64;
		cargv[2] = 0;
		var envp [1]i64;
		envp[0] = 0;
		sys_execve(cpath, &cargv[0] as *u8, &envp[0] as *u8);
		sys_exit(127);
	}
	sys_close(in_pipe[0] as i64);
	sys_close(out_pipe[1] as i64);
	abi_pid = pid;
	abi_in = in_pipe[1] as i64;
	abi_out = out_pipe[0] as i64;

	var bundle str = __interp_all_src();
	if (bundle.len > 0) {
		abi_send_frame(abi_in, 1 as u8, bundle.ptr, bundle.len);
		var bkind u8 = 0;
		var bbuf [8]u8;
		var bn i64 = abi_wait_result(&bkind, &bbuf[0], 8);
		if (bn < 0 || bkind == 2) {
			eprint("eval: an interpreted/dynamic function failed to register at startup\n");
			sys_exit(1);
		}
	}
}

// Answers a child→host request (3 = call a host fn, 4 = read a host
// global, 5 = write one) that arrived while the host was waiting for its
// own response. Shared by both waiters so the marshalled path answers
// interleaved requests exactly like the scalar one.
fn abi_serve_host_req(kind u8, buf *u8, n i64) {
	if (kind == 4) {
		var gname str;
		gname.ptr = buf;
		gname.len = n;
		var gr i64 = __eval_get_dispatch(gname);
		var grb [8]u8;
		*(&grb[0] as *i64) = gr;
		abi_send_frame(abi_in, 1 as u8, &grb[0], 8);
		return;
	}
	if (kind == 5) {
		if (n < 9) { return; }
		var snlen i64 = buf[0] as i64;
		if (n < 1 + snlen + 8) { return; }
		var sname str;
		sname.ptr = buf + 1;
		sname.len = snlen;
		var sv i64 = abi_decode_u64(buf + 1 + snlen);
		__eval_set_dispatch(sname, sv);
		var srb [8]u8;
		*(&srb[0] as *i64) = 0;
		abi_send_frame(abi_in, 1 as u8, &srb[0], 8);
		return;
	}
	if (kind != 3) { return; }
	if (n < 1) { return; }
	var nlen i64 = buf[0] as i64;
	if (n < 1 + nlen + 48) { return; }
	var name str;
	name.ptr = buf + 1;
	name.len = nlen;
	var args [6]i64;
	var vp *u8 = buf + 1 + nlen;
	var i i64 = 0;
	while (i < 6) {
		args[i] = abi_decode_u64(vp + i * 8);
		i = i + 1;
	}
	var r i64 = __eval_call_dispatch(name, &args[0]);
	var rb [8]u8;
	*(&rb[0] as *i64) = r;
	abi_send_frame(abi_in, 1 as u8, &rb[0], 8);
}

fn abi_wait_result(kind *u8, buf *u8, cap i64) i64 {
	var scratch [512]u8;
	while (true) {
		var n i64 = abi_recv_frame(abi_out, kind, &scratch[0], 512);
		if (n < 0) { return n; }
		if (*kind == 4 || *kind == 5 || *kind == 3) {
			abi_serve_host_req(*kind, &scratch[0], n);
			continue;
		}
		if (n > cap) { return -1; }
		var ci i64 = 0;
		while (ci < n) { buf[ci] = scratch[ci]; ci = ci + 1; }
		return n;
	}
}

// The marshalled-call variant: the response payload can be arbitrarily
// large, so it is received into the arena instead of a caller buffer.
// kind 0 means the child died; 1 = ok, 2 = error, and the payload is the
// marshalled value or the error message.
fn abi_wait_result_payload(kind *u8) str {
	while (true) {
		var total i64 = abi_peek_len(abi_out);
		if (total < 0) { *kind = 0; var e str; return e; }
		var pb *u8 = arena_alloc(total, 8);
		var k u8 = 0;
		if (!abi_recv_rest(abi_out, &k, pb, total - 1)) {
			*kind = 0;
			var e str;
			return e;
		}
		*kind = k;
		if (k == 4 || k == 5 || k == 3) {
			abi_serve_host_req(k, pb, total - 1);
			continue;
		}
		var s str;
		s.ptr = pb;
		s.len = total - 1;
		return s;
	}
}
