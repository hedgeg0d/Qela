import "sys.qela";
import "str.qela";
import "buf.qela";
import "fmt.qela";
import "arena.qela";
import "abiwire.qela";

var abi_pid i64 = -1;
var abi_in i64 = -1;
var abi_out i64 = -1;

// A handle into the child's parsed-AST cache. Every handle is opaque and
// sequential: the child's ids run from 1 in parse order, which is exactly
// why a respawn can replay the sources and keep every handle valid.
// A child handle (from ast_child/ast_next) also records how it was
// reached -- its parent handle and the child index (or -1 for the
// statement chain) -- so the replay can rebuild it with the same id.
// The chain also carries each handle's source so the replay knows what to
// re-parse.
struct Ast;
struct Ast {
	id     i64,
	src    str,
	next   *Ast,
	parent *Ast,
	index  i64,
}
var abi_asts *Ast = null;
var abi_asts_tail *Ast = null;
var abi_respawned bool = false;

// A recorded ast_set: (handle, index, replacement handle). The replay
// re-applies them in order after the handles are rebuilt, so a mutated
// tree comes back mutated.
struct AstSet;
struct AstSet {
	parent *Ast,
	index  i64,
	child  *Ast,
	next   *AstSet,
}
var abi_sets *AstSet = null;
var abi_sets_tail *AstSet = null;

// The ast request kinds live here (not in eval.qela) because the respawn
// replay uses them too.
let ABI_REQ_PARSE = 7;
let ABI_REQ_AST_INFO = 9;
let ABI_REQ_AST_CHILD = 10;
let ABI_REQ_AST_NEXT = 11;
let ABI_REQ_AST_SET = 12;

// The parent tells the child which target it was compiled for, one byte
// before the registration bundle: the child must parse the bundle and
// JIT-compile dynamic functions with the parent's target, not with its
// own host architecture -- under qemu the host is x86 while the parent
// may be running arm64/riscv64 code, and a JIT unit of the wrong arch
// is an illegal instruction in the parent.
let ABI_REQ_TARGET = 13;
$if (TARGET == "arm64") { let ABI_TARGET_BYTE = 1; }
$if (TARGET == "riscv64") { let ABI_TARGET_BYTE = 2; }
$if (TARGET == "x86_64") { let ABI_TARGET_BYTE = 0; }

/// Records an abstract handle for later replay.
fn abi_ast_register(a *Ast) {
	if (abi_asts_tail as i64 == 0) { abi_asts = a; }
	else { abi_asts_tail.next = a; }
	abi_asts_tail = a;
}

/// Records an abstract mutation for later replay.
fn abi_set_record(parent *Ast, index i64, child *Ast) {
	var s *AstSet = arena_alloc(sizeof(AstSet), 8) as *AstSet;
	s.parent = parent;
	s.index = index;
	s.child = child;
	if (abi_sets_tail as i64 == 0) { abi_sets = s; }
	else { abi_sets_tail.next = s; }
	abi_sets_tail = s;
}

// Binds a fresh child after the old one died and rebuilds the session:
// the registration bundle (interpreted/dynamic functions, eval vars) and
// every cached ast handle, in creation order -- the child's ids are
// sequential, so the replay reproduces them exactly. Handles obtained
// through ast_child/ast_next are rebuilt by re-traversing their recorded
// parent, and every recorded ast_set is re-applied, so a mutated tree
// comes back mutated. One respawn per process; a second death means the
// session is genuinely broken and the caller reports it. At-least-once:
// a request that was in flight when the child died is re-sent by its
// caller and may have already run.
/// Restarts the child and replays the full session.
fn abi_respawn() bool {
	if (abi_respawned) { return false; }
	abi_respawned = true;
	if (abi_in >= 0) { sys_close(abi_in as i64); }
	if (abi_out >= 0) { sys_close(abi_out as i64); }
	abi_pid = -1;
	abi_in = -1;
	abi_out = -1;
	abi_spawn();
	var a *Ast = abi_asts;
	while (a as i64 != 0) {
		var ok bool = false;
		if (a.parent as i64 == 0) {
			abi_send_frame(abi_in, ABI_REQ_PARSE as u8, a.src.ptr, a.src.len);
			var k u8 = 0;
			var bb [8]u8;
			var bn i64 = abi_wait_result(&k, &bb[0], 8);
			ok = bn >= 0 && k != 2;
		} else if (a.index < 0) {
			var hb [8]u8;
			*(&hb[0] as *i64) = a.parent.id;
			abi_send_frame(abi_in, ABI_REQ_AST_NEXT as u8, &hb[0], 8);
			var k2 u8 = 0;
			var bb2 [8]u8;
			var bn2 i64 = abi_wait_result(&k2, &bb2[0], 8);
			ok = bn2 >= 0 && k2 != 2;
		} else {
			var cb [16]u8;
			*(&cb[0] as *i64) = a.parent.id;
			*(&cb[8] as *i64) = a.index;
			abi_send_frame(abi_in, ABI_REQ_AST_CHILD as u8, &cb[0], 16);
			var k3 u8 = 0;
			var bb3 [8]u8;
			var bn3 i64 = abi_wait_result(&k3, &bb3[0], 8);
			ok = bn3 >= 0 && k3 != 2;
		}
		if (!ok) { return false; }
		a = a.next;
	}
	var s *AstSet = abi_sets;
	while (s as i64 != 0) {
		var sb [24]u8;
		*(&sb[0] as *i64) = s.parent.id;
		*(&sb[8] as *i64) = s.index;
		*(&sb[16] as *i64) = s.child.id;
		abi_send_frame(abi_in, ABI_REQ_AST_SET as u8, &sb[0], 24);
		var k4 u8 = 0;
		var bb4 [8]u8;
		var bn4 i64 = abi_wait_result(&k4, &bb4[0], 8);
		if (bn4 < 0 || k4 == 2) { return false; }
		s = s.next;
	}
	return true;
}

// The embedded compiler copy: the compiler itself fills these in when it
// builds a program that pulls in the ABI (see codegen's embed handling),
// so a shipped binary can spawn its own child without qela installed.
// Zero in a program that was not compiled with the embed (e.g. under
// `qela irun`, where no codegen runs) -- the spawn falls back then.
var __qela_embedded *u8 = null;
var __qela_embedded_len i64 = 0;

/// Reports whether a filesystem path exists.
fn abi_path_exists(p str) bool {
	var st [144]u8;
	return sys_stat(cstr(p), &st[0]) == 0;
}

/// Locates an executable by searching the PATH variable.
fn abi_find_on_path(name str) str {
	var path str = sys_getenv("PATH");
	var i i64 = 0;
	while (i <= path.len) {
		var start i64 = i;
		while (i < path.len && path.ptr[i] != ':') { i = i + 1; }
		var dir str = str_slice(path, start, i);
		if (dir.len > 0) {
			var b Buf;
			fmt_str(&b, dir);
			buf_u8(&b, '/');
			fmt_str(&b, name);
			var cand str = buf_str(&b);
			if (abi_path_exists(cand)) { return cand; }
		}
		i = i + 1;
	}
	var e str;
	return e;
}

/// Launches the qela child process and opens pipes.
fn abi_spawn() {
	if (abi_pid >= 0) { return; }
	// $QELAPATH is an explicit override; otherwise the embedded compiler
	// copy (if the build embedded one), then a $PATH search.
	var qp str = sys_getenv("QELAPATH");
	var use_memfd bool = false;
	var path str;
	if (qp.len > 0) {
		path = qp;
	} else if (__qela_embedded_len > 0) {
		use_memfd = true;
	} else {
		path = abi_find_on_path("qela");
		if (path.len == 0) {
			eprint("eval/interpreted/dynamic needs the qela compiler at runtime; set QELAPATH=$(which qela) or put qela on PATH\n");
			sys_exit(1);
		}
	}

	var in_pipe [2]i32;
	var out_pipe [2]i32;
	if (sys_pipe2(&in_pipe[0], 0) != 0) { eprint("eval: pipe failed\n"); sys_exit(1); }
	if (sys_pipe2(&out_pipe[0], 0) != 0) { eprint("eval: pipe failed\n"); sys_exit(1); }

	var pid i64 = sys_fork();
	if (pid == 0) {
		sys_dup2(in_pipe[0] as i64, ABI_FD_HOST_TO_CHILD);
		sys_dup2(out_pipe[1] as i64, ABI_FD_CHILD_TO_HOST);
		if (in_pipe[0] as i64 != ABI_FD_HOST_TO_CHILD && in_pipe[0] as i64 != ABI_FD_CHILD_TO_HOST) {
			sys_close(in_pipe[0] as i64);
		}
		if (in_pipe[1] as i64 != ABI_FD_HOST_TO_CHILD && in_pipe[1] as i64 != ABI_FD_CHILD_TO_HOST) {
			sys_close(in_pipe[1] as i64);
		}
		if (out_pipe[0] as i64 != ABI_FD_HOST_TO_CHILD && out_pipe[0] as i64 != ABI_FD_CHILD_TO_HOST) {
			sys_close(out_pipe[0] as i64);
		}
		if (out_pipe[1] as i64 != ABI_FD_HOST_TO_CHILD && out_pipe[1] as i64 != ABI_FD_CHILD_TO_HOST) {
			sys_close(out_pipe[1] as i64);
		}
		var cargv [3]i64;
		cargv[0] = cstr("qela") as i64;
		cargv[1] = cstr("--abi-server") as i64;
		cargv[2] = 0;
		var envp [1]i64;
		envp[0] = 0;
		if (use_memfd) {
			var mfd i64 = sys_memfd_create(cstr("qela"), 0);
			if (mfd < 0) { sys_exit(126); }
			abi_write_exact(mfd, __qela_embedded, __qela_embedded_len);
			sys_fexecve(mfd, &cargv[0] as *u8, &envp[0] as *u8);
			sys_exit(127);
		}
		var cpath *u8 = cstr(path);
		cargv[0] = cpath as i64;
		sys_execve(cpath, &cargv[0] as *u8, &envp[0] as *u8);
		sys_exit(127);
	}
	sys_close(in_pipe[0] as i64);
	sys_close(out_pipe[1] as i64);
	abi_pid = pid;
	abi_in = in_pipe[1] as i64;
	abi_out = out_pipe[0] as i64;

	var tb [1]u8;
	tb[0] = ABI_TARGET_BYTE as u8;
	abi_send_frame(abi_in, ABI_REQ_TARGET as u8, &tb[0], 1);

	var bundle str = __interp_all_src();
	if (bundle.len > 0) {
		abi_send_frame(abi_in, 1 as u8, bundle.ptr, bundle.len);
		var bkind u8 = 0;
		var bbuf [8]u8;
		var bn i64 = abi_wait_result(&bkind, &bbuf[0], 8);
		if (bn < 0 || bkind == 2) {
			eprint("eval: an interpreted/dynamic function failed to register at startup\n");
			sys_exit(1);
		}
	}
}

// Answers a child→host request (3 = call a host fn, 4 = read a host
// global, 5 = write one) that arrived while the host was waiting for its
// own response. Shared by both waiters so the marshalled path answers
// interleaved requests exactly like the scalar one.
/// Answers a child-to-host call or global access request.
fn abi_serve_host_req(kind u8, buf *u8, n i64) {
	if (kind == 4) {
		var gname str;
		gname.ptr = buf;
		gname.len = n;
		var gr str = __eval_get_dispatch(gname);
		if (gr.len == 0) {
			// An unknown name reads as zero, as it always has: the
			// dispatcher's empty payload would leave the caller's buffer
			// untouched, so answer the old 8 zero bytes explicitly.
			var zb [8]u8;
			*(&zb[0] as *i64) = 0;
			abi_send_frame(abi_in, 1 as u8, &zb[0], 8);
			return;
		}
		abi_send_frame(abi_in, 1 as u8, gr.ptr, gr.len);
		return;
	}
	if (kind == 5) {
		if (n < 1) { return; }
		var snlen i64 = buf[0] as i64;
		if (n < 1 + snlen) { return; }
		var sname str;
		sname.ptr = buf + 1;
		sname.len = snlen;
		__eval_set_dispatch(sname, buf + 1 + snlen);
		var srb [8]u8;
		*(&srb[0] as *i64) = 0;
		abi_send_frame(abi_in, 1 as u8, &srb[0], 8);
		return;
	}
	if (kind != 3) { return; }
	if (n < 1) { return; }
	var nlen i64 = buf[0] as i64;
	if (n < 1 + nlen) { return; }
	var name str;
	name.ptr = buf + 1;
	name.len = nlen;
	// The dispatcher decodes the marshalled arguments per the function's
	// own signature and marshals the return value into `resp`; an unknown
	// name answers a plain zero, which the caller decodes per its own
	// expected type (an empty str for a str-typed call).
	var resp Buf;
	var found bool = __eval_call_dispatch(name, buf + 1 + nlen, &resp);
	if (!found) { buf_u64(&resp, 0); }
	abi_send_frame(abi_in, 1 as u8, resp.p, resp.n);
}

/// Waits for a child response into a fixed buffer.
fn abi_wait_result(kind *u8, buf *u8, cap i64) i64 {
	var scratch [512]u8;
	while (true) {
		var n i64 = abi_recv_frame(abi_out, kind, &scratch[0], 512);
		if (n < 0) { return n; }
		if (*kind == 4 || *kind == 5 || *kind == 3) {
			abi_serve_host_req(*kind, &scratch[0], n);
			continue;
		}
		if (n > cap) { return -1; }
		var ci i64 = 0;
		while (ci < n) { buf[ci] = scratch[ci]; ci = ci + 1; }
		return n;
	}
}

// The marshalled-call variant: the response payload can be arbitrarily
// large, so it is received into the arena instead of a caller buffer.
// kind 0 means the child died; 1 = ok, 2 = error, and the payload is the
// marshalled value or the error message.
/// Waits for a child response delivered into the arena.
fn abi_wait_result_payload(kind *u8) str {
	while (true) {
		var total i64 = abi_peek_len(abi_out);
		if (total < 0) { *kind = 0; var e str; return e; }
		var pb *u8 = arena_alloc(total, 8);
		var k u8 = 0;
		if (!abi_recv_rest(abi_out, &k, pb, total - 1)) {
			*kind = 0;
			var e str;
			return e;
		}
		*kind = k;
		if (k == 4 || k == 5 || k == 3) {
			abi_serve_host_req(k, pb, total - 1);
			continue;
		}
		var s str;
		s.ptr = pb;
		s.len = total - 1;
		return s;
	}
}
