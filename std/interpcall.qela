import "sys.qela";
import "str.qela";
import "buf.qela";
import "arena.qela";
import "abiwire.qela";
import "abiconn.qela";

let ABI_REQ_RUN = 1;
let ABI_REQ_CALL = 2;
let ABI_RESP_ERR = 2;

struct InterpReg;
struct InterpReg {
	name str,
	next *InterpReg,
}
var interp_registered *InterpReg = 0 as *InterpReg;

fn interp_is_registered(name str) bool {
	var r *InterpReg = interp_registered;
	while (r as i64 != 0) {
		if (str_eq(r.name, name)) { return true; }
		r = r.next;
	}
	return false;
}

fn interp_mark_registered(name str) {
	var r *InterpReg = arena_alloc(sizeof(InterpReg), 8) as *InterpReg;
	r.name = name;
	r.next = interp_registered;
	interp_registered = r;
}

fn interp_register(def_src str, name str) {
	if (interp_is_registered(name)) { return; }
	abi_send_frame(abi_in, ABI_REQ_RUN as u8, def_src.ptr, def_src.len);
	var buf [8]u8;
	var kind u8 = 0;
	var n i64 = abi_recv_frame(abi_out, &kind, &buf[0], 8);
	if (n < 0) {
		eprint("interpreted: the qela subprocess died while registering '");
		eprint(name);
		eprint("'\n");
		sys_exit(1);
	}
	if (kind == (ABI_RESP_ERR as u8)) {
		eprint("interpreted: '");
		eprint(name);
		eprint("' failed to compile in the runtime subprocess\n");
		sys_exit(1);
	}
	interp_mark_registered(name);
}

fn __interp_call_dispatch(def_src str, name str, args *i64) i64 {
	abi_spawn();
	interp_register(def_src, name);

	var b Buf;
	buf_u8(&b, name.len as u8);
	buf_bytes(&b, name.ptr, name.len);
	var i i64 = 0;
	while (i < 6) {
		buf_u64(&b, args[i]);
		i = i + 1;
	}
	var msg str = buf_str(&b);
	abi_send_frame(abi_in, ABI_REQ_CALL as u8, msg.ptr, msg.len);

	var rbuf [8]u8;
	var kind u8 = 0;
	var n i64 = abi_recv_frame(abi_out, &kind, &rbuf[0], 8);
	if (n < 0) {
		eprint("interpreted: the qela subprocess died while calling '");
		eprint(name);
		eprint("'\n");
		sys_exit(1);
	}
	if (kind == (ABI_RESP_ERR as u8)) {
		eprint("interpreted: '");
		eprint(name);
		eprint("' raised an error at runtime\n");
		sys_exit(1);
	}
	return *(&rbuf[0] as *i64);
}
