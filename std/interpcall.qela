import "sys.qela";
import "str.qela";
import "buf.qela";
import "abiwire.qela";
import "abiconn.qela";

let ABI_REQ_CALL = 2;
let ABI_RESP_ERR = 2;

fn __interp_call_dispatch(name str, args *i64) i64 {
	abi_spawn();

	var b Buf;
	buf_u8(&b, name.len as u8);
	buf_bytes(&b, name.ptr, name.len);
	var i i64 = 0;
	while (i < 6) {
		buf_u64(&b, args[i]);
		i = i + 1;
	}
	var msg str = buf_str(&b);
	abi_send_frame(abi_in, ABI_REQ_CALL as u8, msg.ptr, msg.len);

	var rbuf [8]u8;
	var kind u8 = 0;
	var n i64 = abi_wait_result(&kind, &rbuf[0], 8);
	if (n < 0) {
		eprint("interpreted: the qela subprocess died while calling '");
		eprint(name);
		eprint("'\n");
		sys_exit(1);
	}
	if (kind == (ABI_RESP_ERR as u8)) {
		eprint("interpreted: '");
		eprint(name);
		eprint("' raised an error at runtime\n");
		sys_exit(1);
	}
	return *(&rbuf[0] as *i64);
}
