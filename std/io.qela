import "sys.qela";
import "buf.qela";
import "str.qela";

let IO_CHUNK = 65536;

fn die(msg str) {
	eprint(msg);
	eprint("\n");
	sys_exit(1);
}

fn print(s str) {
	write_str(STDOUT, s);
}

fn println(s str) {
	write_str(STDOUT, s);
	write_str(STDOUT, "\n");
}

fn file_exists(path str) bool {
	var fd i64 = sys_open_read(cstr(path));
	if (fd < 0) { return false; }
	sys_close(fd);
	return true;
}

fn read_file(path str) str {
	var fd i64 = sys_open_read(cstr(path));
	if (fd < 0) {
		eprint("error: cannot open ");
		eprint(path);
		eprint("\n");
		sys_exit(1);
	}
	var b Buf;
	var got i64 = 1;
	while (got > 0) {
		buf_grow(&b, IO_CHUNK);
		got = sys_read(fd, b.p + b.n, IO_CHUNK);
		if (got > 0) { b.n = b.n + got; }
	}
	sys_close(fd);
	return buf_str(&b);
}

fn read_stdin() str {
	var b Buf;
	var got i64 = 1;
	while (got > 0) {
		buf_grow(&b, IO_CHUNK);
		got = sys_read(0, b.p + b.n, IO_CHUNK);
		if (got > 0) { b.n = b.n + got; }
	}
	return buf_str(&b);
}

// One line, newline included; "" only at end of input. An empty line
// returns "\n", so a caller can tell the two apart.
fn read_line() str {
	var b Buf;
	var c u8 = 0;
	while (true) {
		var got i64 = sys_read(0, &c, 1);
		if (got <= 0) { break; }
		buf_u8(&b, c);
		if (c == '\n') { break; }
	}
	return buf_str(&b);
}

fn write_file(path str, data *u8, n i64) {
	var fd i64 = sys_open_exec(cstr(path));
	if (fd < 0) {
		eprint("error: cannot write ");
		eprint(path);
		eprint("\n");
		sys_exit(1);
	}
	var off i64 = 0;
	while (off < n) {
		var wrote i64 = sys_write(fd, data + off, n - off);
		if (wrote <= 0) { die("error: short write"); }
		off = off + wrote;
	}
	sys_close(fd);
}

// The full x86-64 struct stat is 144 bytes; the kernel writes all of it,
// and a smaller struct would let the syscall clobber the stack frame. The
// mode field sits at offset 24, and st_blksize (the last word we name) at
// 56, but the size must stay 144.
struct Stat {
	d0 i64, d1 i64, d2 i64, mode i64, d4 i64, d5 i64, d6 i64,
	d7 i64, d8 i64, d9 i64, d10 i64, d11 i64, d12 i64, d13 i64,
	d14 i64, d15 i64, d16 i64, d17 i64,
}

fn is_dir(path str) bool {
	var st Stat;
	if (sys_stat(cstr(path), &st as *u8) != 0) { return false; }
	var mode i64 = st.mode;
	$if (TARGET != "x86_64") {
		mode = st.d2;
	}
	return (mode & 0xf000) == 0x4000;
}

// Appends the names of the .qela files under a directory, one per line, to
// out -- recursively, so a project's files can live in subdirectories.
// Names carry their path relative to the top directory (e.g. "sub/x.qela").
// getdents64 entries are: ino u64, off i64, reclen u16, type u8, name.
// Entries come in directory order, so the caller sorts before use. A
// dot-directory (".git", ".foo") is skipped, same convention most tools use
// for "not part of the project".
fn read_dir_rec(path str, prefix str, out *Buf) {
	var fd i64 = sys_open_read(cstr(path));
	if (fd < 0) {
		eprint("error: cannot open directory ");
		eprint(path);
		eprint("\n");
		sys_exit(1);
	}
	var chunk [2048]u8;
	while (true) {
		var got i64 = sys_getdents(fd, &chunk[0], 2048);
		if (got <= 0) { break; }
		var off i64 = 0;
		while (off < got) {
			var p i64 = off;
			var reclen i64 = (chunk[p + 16] as i64) | ((chunk[p + 17] as i64) << 8);
			var typ u8 = chunk[p + 18];
			if (typ == 4 || typ == 8) {  // DT_DIR or DT_REG
				var n i64 = 0;
				while (chunk[p + 19 + n] != 0) { n = n + 1; }
				if (typ == 4) {
					var dot bool = chunk[p + 19] == '.';
					if (!dot) {
						var sub Buf;
						buf_bytes(&sub, path.ptr, path.len);
						if (sub.n == 0 || sub.p[sub.n - 1] != '/') { buf_u8(&sub, '/'); }
						var k i64 = 0;
						while (k < n) { buf_u8(&sub, chunk[p + 19 + k]); k = k + 1; }

						var subprefix Buf;
						buf_bytes(&subprefix, prefix.ptr, prefix.len);
						k = 0;
						while (k < n) { buf_u8(&subprefix, chunk[p + 19 + k]); k = k + 1; }
						buf_u8(&subprefix, '/');

						read_dir_rec(buf_str(&sub), buf_str(&subprefix), out);
					}
				} else if (n > 5 &&
				    chunk[p + 19 + n - 5] == '.' && chunk[p + 19 + n - 4] == 'q' &&
				    chunk[p + 19 + n - 3] == 'e' && chunk[p + 19 + n - 2] == 'l' &&
				    chunk[p + 19 + n - 1] == 'a') {
					buf_bytes(out, prefix.ptr, prefix.len);
					var k i64 = 0;
					while (k < n) { buf_u8(out, chunk[p + 19 + k]); k = k + 1; }
					buf_u8(out, '\n');
				}
			}
			off = off + reclen;
		}
	}
	sys_close(fd);
}

fn read_dir(path str, out *Buf) { read_dir_rec(path, "", out); }
