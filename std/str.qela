import "arena.qela";

/// Returns whether two strings hold the same bytes.
fn str_eq(a str, b str) bool {
	if (a.len != b.len) { return false; }
	var i i64 = 0;
	while (i < a.len) {
		if (a.ptr[i] != b.ptr[i]) { return false; }
		i = i + 1;
	}
	return true;
}

/// Returns the length of a NUL-terminated string.
fn str_len_cstr(p *u8) i64 {
	var n i64 = 0;
	while (p[n] != 0) { n = n + 1; }
	return n;
}

/// Wraps a NUL-terminated pointer as a str without copying.
fn str_from_cstr(p *u8) str {
	var s str;
	s.ptr = p;
	s.len = str_len_cstr(p);
	return s;
}

/// Returns a substring view over [lo, hi), sharing the storage.
fn str_slice(s str, lo i64, hi i64) str {
	var r str;
	r.ptr = s.ptr + lo;
	r.len = hi - lo;
	return r;
}

/// Returns the index of byte c, or -1 when absent.
fn str_find(s str, c u8) i64 {
	var i i64 = 0;
	while (i < s.len) {
		if (s.ptr[i] == c) { return i; }
		i = i + 1;
	}
	return -1;
}

/// Copies s into fresh arena memory with a trailing NUL.
fn str_dup(s str) str {
	var p *u8 = arena_alloc(s.len + 1, 1);
	var i i64 = 0;
	while (i < s.len) { p[i] = s.ptr[i]; i = i + 1; }
	p[s.len] = 0;
	var r str;
	r.ptr = p;
	r.len = s.len;
	return r;
}

/// Returns a NUL-terminated copy, for paths handed to a syscall.
fn cstr(s str) *u8 {
	return str_dup(s).ptr;
}

/// Builds a one-byte string from a character.
fn str_from_char(c u8) str {
	var p *u8 = arena_alloc(1, 1);
	p[0] = c;
	var r str;
	r.ptr = p;
	r.len = 1;
	return r;
}

/// Returns the last index of byte c, or -1 when absent.
fn str_rfind(s str, c u8) i64 {
	var i i64 = s.len;
	while (i > 0) {
		i = i - 1;
		if (s.ptr[i] == c) { return i; }
	}
	return -1;
}

/// Returns the index of the first occurrence of sub, or -1.
fn str_index(s str, sub str) i64 {
	if (sub.len == 0) { return 0; }
	if (sub.len > s.len) { return -1; }
	var i i64 = 0;
	while (i + sub.len <= s.len) {
		var j i64 = 0;
		while (j < sub.len) {
			if (s.ptr[i + j] != sub.ptr[j]) { j = sub.len + 1; }
			else { j = j + 1; }
		}
		if (j == sub.len) { return i; }
		i = i + 1;
	}
	return -1;
}

/// Returns whether s contains sub anywhere.
fn str_contains(s str, sub str) bool {
	return str_index(s, sub) >= 0;
}

/// Returns whether s begins with prefix p.
fn str_starts_with(s str, p str) bool {
	if (p.len > s.len) { return false; }
	return str_eq(str_slice(s, 0, p.len), p);
}

/// Returns whether s ends with suffix p.
fn str_ends_with(s str, p str) bool {
	if (p.len > s.len) { return false; }
	return str_eq(str_slice(s, s.len - p.len, s.len), p);
}

/// Returns whether c is a space, tab, newline or carriage return.
fn str_is_space(c u8) bool {
	return c == ' ' || c == 9 as u8 || c == 10 as u8 || c == 13 as u8;
}

/// Removes leading whitespace.
fn str_trim_left(s str) str {
	var i i64 = 0;
	while (i < s.len && str_is_space(s.ptr[i])) { i = i + 1; }
	return str_slice(s, i, s.len);
}

/// Removes trailing whitespace.
fn str_trim_right(s str) str {
	var n i64 = s.len;
	while (n > 0 && str_is_space(s.ptr[n - 1])) { n = n - 1; }
	return str_slice(s, 0, n);
}

/// Removes leading and trailing whitespace.
fn str_trim(s str) str {
	return str_trim_left(str_trim_right(s));
}

/// Concatenates a and b into a fresh string.
fn str_cat(a str, b str) str {
	var p *u8 = arena_alloc(a.len + b.len + 1, 1);
	var i i64 = 0;
	while (i < a.len) { p[i] = a.ptr[i]; i = i + 1; }
	i = 0;
	while (i < b.len) { p[a.len + i] = b.ptr[i]; i = i + 1; }
	p[a.len + b.len] = 0;
	var r str;
	r.ptr = p;
	r.len = a.len + b.len;
	return r;
}

/// Returns s repeated n times.
fn str_repeat(s str, n i64) str {
	if (n <= 0) { return ""; }
	var p *u8 = arena_alloc(s.len * n + 1, 1);
	var k i64 = 0;
	while (k < n) {
		var i i64 = 0;
		while (i < s.len) { p[k * s.len + i] = s.ptr[i]; i = i + 1; }
		k = k + 1;
	}
	p[s.len * n] = 0;
	var r str;
	r.ptr = p;
	r.len = s.len * n;
	return r;
}

/// Returns a copy of s with uppercase letters lowered.
fn str_lower(s str) str {
	var d str = str_dup(s);
	var i i64 = 0;
	while (i < d.len) {
		if (d.ptr[i] >= 'A' && d.ptr[i] <= 'Z') {
			d.ptr[i] = (d.ptr[i] as i64 + 32) as u8;
		}
		i = i + 1;
	}
	return d;
}

/// Returns a copy of s with lowercase letters uppercased.
fn str_upper(s str) str {
	var d str = str_dup(s);
	var i i64 = 0;
	while (i < d.len) {
		if (d.ptr[i] >= 'a' && d.ptr[i] <= 'z') {
			d.ptr[i] = (d.ptr[i] as i64 - 32) as u8;
		}
		i = i + 1;
	}
	return d;
}

/// Compares a and b lexicographically: negative, zero or positive.
fn str_cmp(a str, b str) i64 {
	var n i64 = a.len;
	if (b.len < n) { n = b.len; }
	var i i64 = 0;
	while (i < n) {
		if (a.ptr[i] != b.ptr[i]) {
			if (a.ptr[i] < b.ptr[i]) { return -1; }
			return 1;
		}
		i = i + 1;
	}
	if (a.len < b.len) { return -1; }
	if (a.len > b.len) { return 1; }
	return 0;
}

/// Counts non-overlapping occurrences of sub in s.
fn str_count(s str, sub str) i64 {
	if (sub.len == 0) { return 0; }
	var n i64 = 0;
	var i i64 = 0;
	while (i + sub.len <= s.len) {
		if (str_starts_with(str_slice(s, i, s.len), sub)) {
			n = n + 1;
			i = i + sub.len;
		} else {
			i = i + 1;
		}
	}
	return n;
}

/// Replaces every occurrence of old with new in a fresh string.
fn str_replace(s str, old str, new str) str {
	if (old.len == 0) { return s; }
	var hits i64 = str_count(s, old);
	if (hits == 0) { return s; }
	var n i64 = s.len + hits * (new.len - old.len);
	var p *u8 = arena_alloc(n + 1, 1);
	var i i64 = 0;
	var o i64 = 0;
	while (i < s.len) {
		if (i + old.len <= s.len && str_starts_with(str_slice(s, i, s.len), old)) {
			var k i64 = 0;
			while (k < new.len) { p[o + k] = new.ptr[k]; k = k + 1; }
			o = o + new.len;
			i = i + old.len;
		} else {
			p[o] = s.ptr[i];
			o = o + 1;
			i = i + 1;
		}
	}
	p[o] = 0;
	var r str;
	r.ptr = p;
	r.len = o;
	return r;
}

/// Parses an integer from s, setting ok only on a full valid parse.
fn str_to_int(s str, ok *bool) i64 {
	var t str = str_trim(s);
	*ok = false;
	if (t.len == 0) { return 0; }
	var i i64 = 0;
	var neg bool = false;
	if (t.ptr[0] == '-' || t.ptr[0] == '+') {
		neg = t.ptr[0] == '-';
		i = 1;
	}
	if (i >= t.len) { return 0; }
	var v i64 = 0;
	while (i < t.len) {
		if (t.ptr[i] < '0' || t.ptr[i] > '9') { return 0; }
		v = v * 10 + (t.ptr[i] as i64 - '0' as i64);
		i = i + 1;
	}
	*ok = true;
	if (neg) { return -v; }
	return v;
}

/// Parses an integer from s, returning 0 when it does not parse.
fn str_int(s str) i64 {
	var ok bool = false;
	return str_to_int(s, &ok);
}

// Split s on every occurrence of sep (an empty sep yields an empty slice).
// The pieces are str slices into s, so nothing is copied; only the slice
// array itself is arena-allocated. A trailing separator keeps an empty
// piece: str_split("a,", ",") is ["a", ""].
/// Splits s on sep into non-copying slices, keeping no limit.
fn str_split(s str, sep str) []str {
	return str_split_n(s, sep, -1);
}

// str_split_n caps the result at n pieces; the last piece takes the rest of
// s. A negative n splits without a cap.
/// Splits s on sep, at most n pieces with the last taking the remainder.
fn str_split_n(s str, sep str, n i64) []str {
	var cnt i64 = 1;
	if (n >= 0 && n < cnt) { cnt = n; }
	if (sep.len == 0) {
		if (n == 1) {
			var one []str;
			one.ptr = arena_alloc(sizeof(str), 8) as *str;
			one.len = 1;
			one.ptr[0] = s;
			return one;
		}
		var empty []str;
		empty.len = 0;
		return empty;
	}
	if (s.len == 0) {
		if (n == 0) {
			var empty []str;
			empty.len = 0;
			return empty;
		}
		var one []str;
		one.ptr = arena_alloc(sizeof(str), 8) as *str;
		one.len = 1;
		one.ptr[0] = s;
		return one;
	}
	var i i64 = 0;
	while (i + sep.len <= s.len) {
		if (n >= 0 && cnt >= n) { break; }
		var j i64 = 0;
		while (j < sep.len && s.ptr[i + j] == sep.ptr[j]) { j = j + 1; }
		if (j == sep.len) { cnt = cnt + 1; i = i + sep.len; }
		else { i = i + 1; }
	}
	if (n >= 0 && cnt > n) { cnt = n; }
	if (cnt == 0) {
		var empty []str;
		empty.len = 0;
		return empty;
	}
	var out []str;
	out.ptr = arena_alloc(cnt * sizeof(str), 8) as *str;
	out.len = cnt;
	var start i64 = 0;
	var k i64 = 0;
	i = 0;
	while (i + sep.len <= s.len && k < cnt - 1) {
		var j i64 = 0;
		while (j < sep.len && s.ptr[i + j] == sep.ptr[j]) { j = j + 1; }
		if (j == sep.len) {
			out.ptr[k] = str_slice(s, start, i);
			k = k + 1;
			start = i + sep.len;
			i = i + sep.len;
		} else {
			i = i + 1;
		}
	}
	out.ptr[k] = str_slice(s, start, s.len);
	return out;
}
