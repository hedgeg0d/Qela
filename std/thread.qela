import "sys.qela";
import "coro.qela";
import "chan.qela";

// A fixed pool of OS threads, each running its own cooperative coroutine
// scheduler -- goroutines multiplexed over real parallelism. go() round-
// robins a spawn request onto one pool thread's queue; that thread's own
// loop drains it into a local coro_spawn the next time it polls. Channels
// (chan.qela) are the supported way to hand results back across threads.
//
// Work-stealing only covers requests that have not started running yet:
// an idle thread with nothing of its own to drain tries its neighbors'
// queues before spinning. A coroutine already coro_spawn'd is pinned to
// its thread's tvar-scoped coros[] for good -- migrating a *running*
// coroutine's stack/registers to another OS thread mid-flight is real
// extra work (a safe migration point that isn't inside a lock or a GC
// safepoint, plus re-homing it into the target's own coros[] slot) that
// nothing here has needed yet; this is the cheap win, not that one.
//
// A pool thread never calls gc_thread_enter itself -- that would force
// every user of thread.qela to also pull in gc.qela. A program that wants
// its pool threads to be GC roots has to register them itself (e.g. by
// wrapping the function passed to go() to call gc_thread_enter on first
// entry to that thread, or by using a custom pool loop built the same way
// this one is).

let POOL_MAX = 32;
let POOL_QUEUE = 64;
let POOL_STACK = 262144;

struct SpawnReq {
	fn_ptr i64,
	a0     i64,
	a1     i64,
	a2     i64,
	a3     i64,
	a4     i64,
}

var pool_n i64 = 0;
var pool_next i64 = 0;
var pool_queue [32][64]SpawnReq;
var pool_head [32]i64;
var pool_tail [32]i64;
var pool_lock [32]i64;

// Pops at most one entry per call, not the whole backlog: holding the
// lock (or even just re-acquiring it back to back in a tight loop) across
// every pending coro_spawn starves pool_steal's try-lock for as long as
// this thread's own backlog lasts, which defeats stealing entirely
// whenever a queue gets a real burst pushed onto it. pool_worker calls
// this every iteration, so the backlog still drains, just interleaved
// with give-someone-else-a-turn spacing instead of all at once.
/// Pops one pending spawn request off the queue.
fn pool_drain(id i64) {
	if (pool_head[id] == pool_tail[id]) { return; }
	if (!atomic_cas(&pool_lock[id], 0, 1)) { return; }
	if (pool_head[id] == pool_tail[id]) {
		atomic_store(&pool_lock[id], 0);
		return;
	}
	var slot i64 = pool_head[id] % POOL_QUEUE;
	var r SpawnReq = pool_queue[id][slot];
	pool_head[id] = pool_head[id] + 1;
	atomic_store(&pool_lock[id], 0);
	coro_spawn(r.fn_ptr, r.a0, r.a1, r.a2, r.a3, r.a4);
}

// Tries every other pool thread's queue once, starting just past its own
// id (so threads don't all pile onto neighbor 0 first). A try-lock, not a
// blocking one: a busy victim is skipped rather than waited on, since the
// whole point is to not stall while there might be idle work elsewhere.
/// Steals one pending task from a neighbor's queue.
fn pool_steal(id i64) bool {
	var i i64 = 1;
	while (i < pool_n) {
		var victim i64 = (id + i) % pool_n;
		if (pool_head[victim] != pool_tail[victim] && atomic_cas(&pool_lock[victim], 0, 1)) {
			if (pool_head[victim] != pool_tail[victim]) {
				var slot i64 = pool_head[victim] % POOL_QUEUE;
				var r SpawnReq = pool_queue[victim][slot];
				pool_head[victim] = pool_head[victim] + 1;
				atomic_store(&pool_lock[victim], 0);
				coro_spawn(r.fn_ptr, r.a0, r.a1, r.a2, r.a3, r.a4);
				return true;
			}
			atomic_store(&pool_lock[victim], 0);
		}
		i = i + 1;
	}
	return false;
}

// Which pool thread the calling coroutine is actually running on right
// now -- set once per thread, read by any coroutine scheduled on it.
tvar pool_worker_id i64 = -1;

/// Runs one pool thread's scheduling loop forever.
fn pool_worker(id i64) i64 {
	tls_init();
	chan_thread_enter();
	pool_worker_id = id;
	while (true) {
		pool_drain(id);
		if (coro_pending()) {
			coro_yield();
		} else if (!pool_steal(id)) {
			fence();
			sys_sched_yield();
		}
	}
	return 0;
}

// Spawns n OS threads, each running its own coroutine scheduler. Call
// once; there is no way to grow the pool afterward.
/// Spawns a fixed pool of operating-system threads.
fn thread_pool_init(n i64) {
	// The single-scheduler deadlock heuristic in chan.qela can't tell a
	// slow sibling thread from real deadlock; see chan_deadlock_check.
	chan_deadlock_check = false;
	if (n > POOL_MAX) { n = POOL_MAX; }
	var i i64 = 0;
	while (i < n) {
		pool_head[i] = 0;
		pool_tail[i] = 0;
		pool_lock[i] = 0;
		var stack i64 = sys_mmap_anon(POOL_STACK);
		var top i64 = (stack + POOL_STACK) & ~15;
		thread_clone(pool_worker, i, top, CLONE_THREAD_FLAGS);
		i = i + 1;
	}
	pool_n = n;
	// The cross-thread deadlock check never reports before every pool
	// thread has registered (registration is a worker's first act):
	// a worker that has not registered yet cannot have done anything.
	atomic_store(&chan_pool_threads, n);
}

// Round-robins a goroutine onto one of the pool's threads. fn takes up to
// five i64/pointer-sized arguments, the same convention coro_spawn uses.
/// Schedules a goroutine onto one of the pool threads.
fn go(fn_ptr i64, a0 i64, a1 i64, a2 i64, a3 i64, a4 i64) {
	// A go() source is a channel-progress source for the cross-thread
	// deadlock check: register it, so a stalled world never mistakes
	// this thread for one that can no longer act. (Requires tls_init,
	// like every tvar touch -- true for main and for pool workers.)
	if (chan_my_slot < 0) { chan_thread_enter(); }
	var id i64 = atomic_add(&pool_next, 1) % pool_n;
	while (!atomic_cas(&pool_lock[id], 0, 1)) { sys_sched_yield(); }
	while (pool_tail[id] - pool_head[id] >= POOL_QUEUE) {
		atomic_store(&pool_lock[id], 0);
		fence();
		sys_sched_yield();
		while (!atomic_cas(&pool_lock[id], 0, 1)) { sys_sched_yield(); }
	}
	var slot i64 = pool_tail[id] % POOL_QUEUE;
	pool_queue[id][slot].fn_ptr = fn_ptr;
	pool_queue[id][slot].a0 = a0;
	pool_queue[id][slot].a1 = a1;
	pool_queue[id][slot].a2 = a2;
	pool_queue[id][slot].a3 = a3;
	pool_queue[id][slot].a4 = a4;
	pool_tail[id] = pool_tail[id] + 1;
	atomic_store(&pool_lock[id], 0);
}
