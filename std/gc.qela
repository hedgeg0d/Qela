import "sys.qela";
import "coro.qela";

// A conservative mark-sweep collector, written in Qela like everything else
// the compiler ships. Arenas stay the default; this is for programs whose
// lifetimes are not stack-shaped.
//
// Conservative means any machine word that looks like a pointer into the
// heap keeps its block alive. That over-approximates, which is safe, and it
// needs no cooperation from the type checker.
//
// Roots are the callee-saved registers (spilled by gc_save_regs), the stack
// between the base captured at gc_init and the current frame, and the whole
// data segment, whose bounds gc_data_base and gc_data_end get from the
// compiler.
//
// Threads: a collecting thread stops the world by cooperative safepoint
// polling, not signals -- gc_safepoint runs at gc_alloc's own entry, the
// one call every allocating thread makes often enough to park promptly,
// and without pulling a gc.qela dependency into coro.qela/chan.qela just
// to add more polling points. A thread that never allocates and is not
// registered holds no roots this collector needs to find, so it is never
// waited on; a registered thread that stops allocating for a long stretch
// (no allocation, no gc_thread_exit) delays the next collection until it
// allocates again -- a known limit of polling-only safepoints, not
// something this collector tries to paper over.

let GC_CHUNK  = 1048576;
let GC_HEADER = 32;
let GC_MAX_THREADS = 64;

// gc_save_regs spills every callee-saved register: x86's RBX/R12-R15 (padded
// to 6), ARM64's x19-x28 (10) -- sized for the larger of the two so one
// struct layout serves both targets; the unused tail on x86 stays zeroed and
// gc_mark_range over zero words is a no-op.
let GC_NREGS = 10;

// Every block carries: size, mark flag, and links for the all-blocks list
// and the free list.
struct GcBlock;
struct GcBlock {
	size   i64,
	marked i64,
	next   *GcBlock,
	free   *GcBlock,
}

struct GcThread {
	active       i64,
	stack_base   i64,
	sp           i64,
	regs         [10]i64,
	at_safepoint i64,
}

var gc_blocks *GcBlock;
var gc_freelist *GcBlock;
var gc_cur i64 = 0;
var gc_end i64 = 0;
var gc_lo i64 = 0;
var gc_hi i64 = 0;
var gc_stack_base i64 = 0;
var gc_live i64 = 0;
var gc_ready bool = false;

var gc_alloc_lock i64 = 0;
var gc_reg_lock i64 = 0;
var gc_stw_requested i64 = 0;
var gc_threads [64]GcThread;
tvar gc_my_slot i64 = -1;

/// Acquires the collector's allocation lock.
fn gc_lock() { while (!atomic_cas(&gc_alloc_lock, 0, 1)) { sys_sched_yield(); } }
/// Releases the collector's allocation lock.
fn gc_unlock() { atomic_store(&gc_alloc_lock, 0); }

/// Initializes the collector once, if not already ready.
fn gc_init() {
	if (gc_ready) { return; }
	gc_ready = true;
	var anchor i64 = 0;
	gc_stack_base = &anchor as i64;
}

// Registers the calling thread as a GC root source. Every thread that
// allocates or holds a live pointer across an allocation must call this
// once, early -- the stack base recorded here has to sit above every frame
// that will ever need scanning, the same assumption gc_init makes for the
// thread that happens to trigger it first.
/// Registers the calling thread as a garbage collection root.
fn gc_thread_enter() {
	gc_init();
	while (!atomic_cas(&gc_reg_lock, 0, 1)) { sys_sched_yield(); }
	var i int = 0;
	while (i < GC_MAX_THREADS) {
		if (gc_threads[i].active == 0) {
			var anchor i64 = 0;
			gc_threads[i].stack_base = &anchor as i64;
			gc_threads[i].at_safepoint = 0;
			gc_threads[i].active = 1;
			gc_my_slot = i as i64;
			atomic_store(&gc_reg_lock, 0);
			return;
		}
		i = i + 1;
	}
	atomic_store(&gc_reg_lock, 0);
}

/// Deregisters the calling thread from the collector.
fn gc_thread_exit() {
	if (gc_my_slot < 0) { return; }
	while (!atomic_cas(&gc_reg_lock, 0, 1)) { sys_sched_yield(); }
	gc_threads[gc_my_slot as int].active = 0;
	atomic_store(&gc_reg_lock, 0);
	gc_my_slot = -1;
}

// Called from every point a thread might sit idle for a while: a collector
// on another thread can only scan roots it has actually parked.
/// Parks the calling thread so a collector can scan it.
fn gc_safepoint() {
	if (atomic_load(&gc_stw_requested) == 0) { return; }
	if (gc_my_slot < 0) { return; }
	var slot int = gc_my_slot as int;
	gc_save_regs(&gc_threads[slot].regs[0]);
	var here i64 = 0;
	gc_threads[slot].sp = &here as i64;
	atomic_store(&gc_threads[slot].at_safepoint, 1);
	while (atomic_load(&gc_stw_requested) != 0) { }
	atomic_store(&gc_threads[slot].at_safepoint, 0);
}

/// Maps a new chunk large enough for the requested need.
fn gc_chunk(need i64) bool {
	var want i64 = GC_CHUNK;
	while (want < need) { want = want * 2; }
	var p i64 = sys_mmap_anon(want);
	if (p < 0 && p > -4096) { return false; }
	gc_cur = p;
	gc_end = p + want;
	if (gc_lo == 0 || p < gc_lo) { gc_lo = p; }
	if (p + want > gc_hi) { gc_hi = p + want; }
	return true;
}

/// Claims a fresh block of the requested size from a chunk.
fn gc_take(size i64) *u8 {
	var total i64 = GC_HEADER + ((size + 7) & ~7);
	if (gc_end - gc_cur < total) {
		if (!gc_chunk(total)) { return null; }
	}
	var b *GcBlock = gc_cur as *GcBlock;
	gc_cur = gc_cur + total;
	b.size = total;
	b.marked = 0;
	b.next = gc_blocks;
	b.free = null;
	gc_blocks = b;
	gc_live = gc_live + total;
	return (b as i64 + GC_HEADER) as *u8;
}

/// Reuses a free block large enough for the size.
fn gc_reuse(size i64) *u8 {
	var total i64 = GC_HEADER + ((size + 7) & ~7);
	var prev *GcBlock = null;
	var b *GcBlock = gc_freelist;
	while (b as i64 != 0) {
		if (b.size >= total) {
			if (prev as i64 == 0) { gc_freelist = b.free; }
			else { prev.free = b.free; }
			b.free = null;
			b.marked = 0;
			gc_live = gc_live + b.size;
			return (b as i64 + GC_HEADER) as *u8;
		}
		prev = b;
		b = b.free;
	}
	return null;
}

/// Allocates a collectible block of the requested size.
fn gc_alloc(size i64) *u8 {
	gc_init();
	gc_safepoint();
	if (size <= 0) { size = 1; }
	gc_lock();
	var p *u8 = gc_reuse(size);
	if (p as i64 == 0) { p = gc_take(size); }
	gc_unlock();
	return p;
}

// A word is a candidate only if it lands inside a mapped chunk and points
// exactly at a block's payload.
/// Returns the block that owns a payload address.
fn gc_block_at(addr i64) *GcBlock {
	if (addr < gc_lo + GC_HEADER || addr >= gc_hi) { return null; }
	if ((addr & 7) != 0) { return null; }
	var b *GcBlock = gc_blocks;
	while (b as i64 != 0) {
		if ((b as i64) + GC_HEADER == addr) { return b; }
		b = b.next;
	}
	return null;
}

/// Marks the block a word points into as reachable.
fn gc_mark_word(w i64) {
	var b *GcBlock = gc_block_at(w);
	if (b as i64 == 0) { return; }
	if (b.marked != 0) { return; }
	b.marked = 1;

	// The block's own payload can hold pointers too.
	var p *i64 = ((b as i64) + GC_HEADER) as *i64;
	var words i64 = (b.size - GC_HEADER) / 8;
	var i i64 = 0;
	while (i < words) {
		gc_mark_word(p[i]);
		i = i + 1;
	}
}

/// Marks every reachable block in a memory range.
fn gc_mark_range(lo i64, hi i64) {
	var p i64 = (lo + 7) & ~7;
	while (p + 8 <= hi) {
		var w *i64 = p as *i64;
		gc_mark_word(*w);
		p = p + 8;
	}
}

// marked: 0 = live but unreached this cycle, 1 = reached, -1 = on the free
// list. The third state keeps a second sweep from linking a block twice.
/// Frees unreached blocks and resets live bytes.
fn gc_sweep() {
	gc_live = 0;
	var b *GcBlock = gc_blocks;
	while (b as i64 != 0) {
		if (b.marked == 1) {
			b.marked = 0;
			gc_live = gc_live + b.size;
		} else if (b.marked == 0) {
			b.marked = -1;
			b.free = gc_freelist;
			gc_freelist = b;
		}
		b = b.next;
	}
}

/// Runs a full stop-the-world garbage collection.
fn gc_collect() {
	gc_init();

	// Ask every other registered thread to park at its next safepoint,
	// and wait for each of them to actually get there -- this has to
	// happen before taking gc_alloc_lock, or a thread already inside its
	// own allocation (past its safepoint check, waiting on this same
	// lock to finish a later one) could never reach the safepoint this
	// loop is waiting for.
	//
	// A thread can also finish and call gc_thread_exit without ever
	// hitting another safepoint after the flag above went up (its last
	// gc_alloc, if any, already ran before the check saw the request).
	// That is a valid way out of the wait too, by contract: a thread must
	// stop caring about its own local roots before it deregisters, the
	// same discipline any handoff across gc_thread_exit already needs.
	atomic_store(&gc_stw_requested, 1);
	var wi int = 0;
	while (wi < GC_MAX_THREADS) {
		if (gc_threads[wi].active != 0 && (gc_my_slot < 0 || (wi as i64) != gc_my_slot)) {
			while (gc_threads[wi].active != 0 && atomic_load(&gc_threads[wi].at_safepoint) == 0) { }
		}
		wi = wi + 1;
	}

	gc_lock();

	var regs [10]i64;
	gc_save_regs(&regs[0]);
	gc_mark_range(&regs[0] as i64, (&regs[0] as i64) + GC_NREGS * 8);

	var here i64 = 0;
	var sp i64 = &here as i64;
	// Under `qela irun` a coroutine's frames live in a region of the
	// interpreter's own, one per context, and gc_stack_base would name
	// whichever context happened to allocate first -- a range spanning two
	// unrelated mappings. The interpreter knows the right bounds.
	$if (INTERP == "1") {
		gc_mark_range(interp_coro_sp(cur_coro), interp_coro_top(cur_coro));
	} $else {
		gc_mark_range(sp, gc_stack_base + 8);
	}
	gc_mark_range(gc_data_base(), gc_data_end());

	// Every other parked OS thread's roots, captured when it hit its
	// safepoint above.
	var ti int = 0;
	while (ti < GC_MAX_THREADS) {
		if (gc_threads[ti].active != 0 && (gc_my_slot < 0 || (ti as i64) != gc_my_slot)) {
			gc_mark_range(&gc_threads[ti].regs[0] as i64, (&gc_threads[ti].regs[0] as i64) + GC_NREGS * 8);
			gc_mark_range(gc_threads[ti].sp, gc_threads[ti].stack_base + 8);
		}
		ti = ti + 1;
	}

	// Other live coroutines on this thread's own scheduler -- the scan
	// above only covers the coroutine gc_collect runs on.
	var ci int = 1;
	while (ci <= coro_slots()) {
		if (ci != cur_coro && coros[ci].alive && !coros[ci].done) {
			$if (INTERP == "1") {
				gc_mark_range(interp_coro_sp(ci), interp_coro_top(ci));
			} $else {
				gc_mark_range(coros[ci].sp, coros[ci].top);
			}
		}
		ci = ci + 1;
	}

	gc_sweep();
	gc_unlock();
	atomic_store(&gc_stw_requested, 0);
}

/// Returns the number of live bytes currently allocated.
fn gc_live_bytes() i64 { return gc_live; }
