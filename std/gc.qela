import "sys.qela";

// A conservative mark-sweep collector, written in Qela like everything else
// the compiler ships. Arenas stay the default; this is for programs whose
// lifetimes are not stack-shaped.
//
// Conservative means any machine word that looks like a pointer into the
// heap keeps its block alive. That over-approximates, which is safe, and it
// needs no cooperation from the type checker.
//
// Roots are the callee-saved registers (spilled by gc_save_regs), the stack
// between the base captured at gc_init and the current frame, and the whole
// data segment, whose bounds gc_data_base and gc_data_end get from the
// compiler.

let GC_CHUNK  = 1048576;
let GC_HEADER = 32;

// Every block carries: size, mark flag, and links for the all-blocks list
// and the free list.
struct GcBlock;
struct GcBlock {
	size   i64,
	marked i64,
	next   *GcBlock,
	free   *GcBlock,
}

var gc_blocks *GcBlock;
var gc_freelist *GcBlock;
var gc_cur i64 = 0;
var gc_end i64 = 0;
var gc_lo i64 = 0;
var gc_hi i64 = 0;
var gc_stack_base i64 = 0;
var gc_live i64 = 0;
var gc_ready bool = false;

fn gc_init() {
	if (gc_ready) { return; }
	gc_ready = true;
	var anchor i64 = 0;
	gc_stack_base = &anchor as i64;
}

fn gc_chunk(need i64) bool {
	var want i64 = GC_CHUNK;
	while (want < need) { want = want * 2; }
	var p i64 = sys_mmap_anon(want);
	if (p < 0 && p > -4096) { return false; }
	gc_cur = p;
	gc_end = p + want;
	if (gc_lo == 0 || p < gc_lo) { gc_lo = p; }
	if (p + want > gc_hi) { gc_hi = p + want; }
	return true;
}

fn gc_take(size i64) *u8 {
	var total i64 = GC_HEADER + ((size + 7) & ~7);
	if (gc_end - gc_cur < total) {
		if (!gc_chunk(total)) { return 0 as *u8; }
	}
	var b *GcBlock = gc_cur as *GcBlock;
	gc_cur = gc_cur + total;
	b.size = total;
	b.marked = 0;
	b.next = gc_blocks;
	b.free = 0 as *GcBlock;
	gc_blocks = b;
	gc_live = gc_live + total;
	return (b as i64 + GC_HEADER) as *u8;
}

fn gc_reuse(size i64) *u8 {
	var total i64 = GC_HEADER + ((size + 7) & ~7);
	var prev *GcBlock = 0 as *GcBlock;
	var b *GcBlock = gc_freelist;
	while (b as i64 != 0) {
		if (b.size >= total) {
			if (prev as i64 == 0) { gc_freelist = b.free; }
			else { prev.free = b.free; }
			b.free = 0 as *GcBlock;
			b.marked = 0;
			gc_live = gc_live + b.size;
			return (b as i64 + GC_HEADER) as *u8;
		}
		prev = b;
		b = b.free;
	}
	return 0 as *u8;
}

fn gc_alloc(size i64) *u8 {
	gc_init();
	if (size <= 0) { size = 1; }
	var p *u8 = gc_reuse(size);
	if (p as i64 != 0) { return p; }
	return gc_take(size);
}

// A word is a candidate only if it lands inside a mapped chunk and points
// exactly at a block's payload.
fn gc_block_at(addr i64) *GcBlock {
	if (addr < gc_lo + GC_HEADER || addr >= gc_hi) { return 0 as *GcBlock; }
	if ((addr & 7) != 0) { return 0 as *GcBlock; }
	var b *GcBlock = gc_blocks;
	while (b as i64 != 0) {
		if ((b as i64) + GC_HEADER == addr) { return b; }
		b = b.next;
	}
	return 0 as *GcBlock;
}

fn gc_mark_word(w i64) {
	var b *GcBlock = gc_block_at(w);
	if (b as i64 == 0) { return; }
	if (b.marked != 0) { return; }
	b.marked = 1;

	// The block's own payload can hold pointers too.
	var p *i64 = ((b as i64) + GC_HEADER) as *i64;
	var words i64 = (b.size - GC_HEADER) / 8;
	var i i64 = 0;
	while (i < words) {
		gc_mark_word(p[i]);
		i = i + 1;
	}
}

fn gc_mark_range(lo i64, hi i64) {
	var p i64 = (lo + 7) & ~7;
	while (p + 8 <= hi) {
		var w *i64 = p as *i64;
		gc_mark_word(*w);
		p = p + 8;
	}
}

// marked: 0 = live but unreached this cycle, 1 = reached, -1 = on the free
// list. The third state keeps a second sweep from linking a block twice.
fn gc_sweep() {
	gc_live = 0;
	var b *GcBlock = gc_blocks;
	while (b as i64 != 0) {
		if (b.marked == 1) {
			b.marked = 0;
			gc_live = gc_live + b.size;
		} else if (b.marked == 0) {
			b.marked = -1;
			b.free = gc_freelist;
			gc_freelist = b;
		}
		b = b.next;
	}
}

fn gc_collect() {
	gc_init();
	var regs [6]i64;
	gc_save_regs(&regs[0]);
	gc_mark_range(&regs[0] as i64, (&regs[0] as i64) + 48);

	var here i64 = 0;
	var sp i64 = &here as i64;
	gc_mark_range(sp, gc_stack_base + 8);
	gc_mark_range(gc_data_base(), gc_data_end());

	gc_sweep();
}

fn gc_live_bytes() i64 { return gc_live; }
