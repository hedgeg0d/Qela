import "coro.qela";
import "arena.qela";
import "sys.qela";

// Buffered channels over the cooperative scheduler; `ch <- v` and `<-ch`
// desugar to chan_send/chan_recv. cap 0 is a rendezvous: buf[0] is the
// handoff slot. Waiting polls, so the scheduler keeps everyone running.
// Deadlock is everyone parked while the epoch — bumped by every channel
// change — stands still; a sender may be blocked while its receiver is
// busy, so waits alone do not prove it.

struct Chan(T) {
	buf     *T,
	cap     i64,
	n       i64,
	head    i64,
	closed  bool,
	waiting bool,
	// A spinlock guards every field above: a channel may now be shared
	// between real OS threads, not just coroutines on one. It is never
	// held across a chan_block -- that yields or spins, and a lock held
	// across that would starve whichever side needs it to make progress.
	lock    i64,
}

// The stall/deadlock heuristic below only means anything measured against
// a single scheduler: coro_live() counts one thread's own coroutines, so
// the blocked-count and stall counter comparing against it have to be
// per-thread too, or one pool thread's blocked coroutines look like
// deadlock through the lens of another thread's much smaller coro_live().
// The epoch stays global and shared: progress made by any thread on any
// channel is real progress, and every field it is compared against here
// is scoped to the same thread that reads it.
tvar chan_nblocked int = 0;
var chan_epoch i64 = 0;
tvar chan_stall int = 0;
tvar chan_stall_epoch i64 = -1;

/// Initializes a channel with the given capacity.
fn chan_init(comptime T: type, c *Chan(T), cap i64) {
	if (cap < 1) { cap = 0; }
	var alloc i64 = cap;
	if (alloc < 1) { alloc = 1; }
	c.buf = arena_alloc(alloc * sizeof(T), 8) as *T;
	c.cap = cap;
	c.n = 0;
	c.head = 0;
	c.closed = false;
	c.waiting = false;
	c.lock = 0;
}

/// Acquires the channel's internal lock.
fn chan_lock(comptime T: type, c *Chan(T)) {
	while (!atomic_cas(&c.lock, 0, 1)) { sys_sched_yield(); }
}

/// Releases the channel's internal lock.
fn chan_unlock(comptime T: type, c *Chan(T)) {
	atomic_store(&c.lock, 0);
}

/// Returns the number of buffered values.
fn chan_len(comptime T: type, c *Chan(T)) i64 { return c.n; }

/// Reports whether the channel is closed.
fn chan_is_closed(comptime T: type, c *Chan(T)) bool { return c.closed; }

/// Marks the channel closed for sending.
fn chan_close(comptime T: type, c *Chan(T)) {
	chan_lock(c);
	c.closed = true;
	chan_unlock(c);
	atomic_add(&chan_epoch, 1);
}

// Set to false once a real thread pool exists (thread_pool_init does
// this). The epoch-stall heuristic below assumes that if nothing on this
// thread's own scheduler can make progress, nothing anywhere can -- true
// for one cooperative scheduler, false the moment other OS threads are
// also running coroutines against the same channel: another thread being
// slow to get scheduled looks identical to real deadlock from here.
// With the pool, the stall instead consults the cross-thread registry
// below: it is a real deadlock only when every registered thread is
// parked inside chan_block (or idle).
var chan_deadlock_check bool = true;

var chan_dying i64 = 0;

/// Reports deadlock and exits the process.
fn chan_die(what str) {
	// Two threads can reach the verdict at once; only one prints, the
	// rest wait quietly -- a loser exiting with exit_group would cut
	// the winner's message off mid-print.
	if (!atomic_cas(&chan_dying, 0, 1)) {
		while (true) { sys_sched_yield(); }
	}
	eprint("qela: deadlock, every coroutine is blocked on a channel ");
	eprint(what);
	eprint("\n");
	sys_exit(1);
}

// ── cross-thread deadlock detection ──
//
// Registration is the contract, exactly like gc_thread_enter: pool
// workers register automatically (thread_pool_init's worker loop), and
// the first chan_block on a thread with a scheduler registers that
// thread too. A raw clone thread that exchanges values with a pool
// through channels or go() must call chan_thread_enter itself -- an
// unregistered thread is invisible to detection, so a stalled world
// with one still running is reported as deadlock. The contract is
// load-bearing, the same way it is for gc roots.

struct ChanWaiter {
	active i64,
	parked i64,
}

var chan_threads [64]ChanWaiter;
var chan_pool_threads i64 = 0;
tvar chan_my_slot i64 = -1;

/// Registers the calling thread for cross-thread deadlock detection.
fn chan_thread_enter() {
	if (chan_my_slot >= 0) { return; }
	var i i64 = 0;
	while (i < 64) {
		if (atomic_cas(&chan_threads[i].active, 0, 1)) {
			chan_my_slot = i;
			return;
		}
		i = i + 1;
	}
}

/// Deregisters the calling thread.
fn chan_thread_exit() {
	var i i64 = chan_my_slot;
	if (i < 0) { return; }
	atomic_store(&chan_threads[i].parked, 0);
	atomic_store(&chan_threads[i].active, 0);
	chan_my_slot = -1;
}

// The stall verdict for a pool world: park this thread, then look for
// anyone else who could still make progress. One active, unparked
// thread means this is a slow sibling, not a deadlock -- reset the
// stall and keep waiting. Fewer than chan_pool_threads registered
// threads means a pool worker has not even started yet (registration is
// its first act), so no verdict either. Only when every registered
// thread is parked can nothing anywhere touch a channel again: report
// it.
fn chan_stall_global(what str) {
	var i i64 = chan_my_slot;
	if (i < 0) { chan_die(what); }
	atomic_store(&chan_threads[i].parked, 1);
	fence();
	var nactive i64 = 0;
	var alive i64 = 0;
	var j i64 = 0;
	while (j < 64) {
		if (atomic_load(&chan_threads[j].active) != 0) {
			nactive = nactive + 1;
			if (atomic_load(&chan_threads[j].parked) == 0) { alive = alive + 1; }
		}
		j = j + 1;
	}
	if (alive != 0 || nactive < chan_pool_threads) {
		atomic_store(&chan_threads[i].parked, 0);
		fence();
		chan_stall_epoch = -1;
		chan_stall = 0;
		return;
	}
	chan_die(what);
}

// coro_live()/coro_yield() only see this thread's own coroutines: on a
// thread with no spawned coroutines at all (the common case for a bare OS
// thread exchanging values over a channel), the stall/deadlock heuristic
// is meaningless -- there is nothing on this thread for it to count, and
// the caller's own retry loop is the wait. A registered thread (it ran
// go() or chan_thread_enter, so its tls block exists) marks itself parked
// while it spins, or a pool world would read it as alive forever.
/// Blocks the caller until the channel makes progress.
fn chan_block(what str) {
	if (coro_live() == 0) {
		if (chan_my_slot >= 0) {
			atomic_store(&chan_threads[chan_my_slot].parked, 1);
			fence();
			if (!coro_yield()) { fence(); }
			atomic_store(&chan_threads[chan_my_slot].parked, 0);
			return;
		}
		if (!coro_yield()) { fence(); }
		return;
	}
	if (chan_my_slot < 0) { chan_thread_enter(); }
	chan_nblocked = chan_nblocked + 1;
	if (chan_nblocked >= coro_live()) {
		if (chan_epoch == chan_stall_epoch) {
			chan_stall = chan_stall + 1;
			if (chan_stall > coro_live() + 1) {
				if (!chan_deadlock_check) { chan_stall_global(what); }
				else { chan_die(what); }
			}
		} else {
			chan_stall_epoch = chan_epoch;
			chan_stall = 1;
		}
	}
	coro_set_blocked(true);
	if (!chan_deadlock_check) {
		// With a pool, a false coro_yield means this thread's own
		// scheduler has nothing left to run -- a slow sibling may still
		// deliver, which chan_stall_global decided above.
		coro_yield();
	} else if (!coro_yield()) {
		chan_die(what);
	}
	coro_set_blocked(false);
	chan_nblocked = chan_nblocked - 1;
}

/// Sends a value into the channel, blocking when full.
fn chan_send(comptime T: type, c *Chan(T), v T) {
	while (true) {
		chan_lock(c);
		if (c.closed) {
			chan_unlock(c);
			eprint("qela: send on a closed channel\n");
			sys_exit(1);
		}
		if (c.cap == 0) {
			if (c.waiting) { chan_unlock(c); chan_block("send"); continue; }
			c.buf[0] = v;
			c.waiting = true;
			chan_unlock(c);
			atomic_add(&chan_epoch, 1);
			break;
		}
		if (c.n == c.cap) { chan_unlock(c); chan_block("send"); continue; }
		var slot i64 = c.head + c.n;
		if (slot >= c.cap) { slot = slot - c.cap; }
		c.buf[slot] = v;
		c.n = c.n + 1;
		chan_unlock(c);
		atomic_add(&chan_epoch, 1);
		return;
	}
	// Rendezvous: the value is handed off, but send does not return until
	// the receiver has actually taken it out of the slot.
	while (true) {
		chan_lock(c);
		var w bool = c.waiting;
		chan_unlock(c);
		if (!w) { return; }
		chan_block("send");
	}
}

// Returns a zeroed element once a closed channel has drained; pair it with
// chan_is_closed when the zero value is also a valid one.
/// Receives a value from the channel, blocking when empty.
fn chan_recv(comptime T: type, c *Chan(T)) T {
	var zero T;
	while (true) {
		chan_lock(c);
		if (c.cap == 0) {
			if (c.waiting) {
				var v T = c.buf[0];
				c.waiting = false;
				chan_unlock(c);
				atomic_add(&chan_epoch, 1);
				return v;
			}
			if (c.closed) { chan_unlock(c); return zero; }
			chan_unlock(c);
			chan_block("receive");
			continue;
		}
		if (c.n != 0) {
			var v T = c.buf[c.head];
			c.head = c.head + 1;
			if (c.head >= c.cap) { c.head = 0; }
			c.n = c.n - 1;
			chan_unlock(c);
			atomic_add(&chan_epoch, 1);
			return v;
		}
		if (c.closed) { chan_unlock(c); return zero; }
		chan_unlock(c);
		chan_block("receive");
	}
}

// The receive half of `for x in ch`: blocks exactly like chan_recv, but
// reports through *ok whether a real value was taken. A closed, drained
// channel answers ok=false (with a zeroed value) instead of looping, so a
// range loop can stop without losing the last buffered value or running its
// body on a zero. While the channel is open and empty it blocks like any
// other receive, so the loop simply waits for the next value.
/// Receives for a range loop, reporting success through ok.
fn chan_recv_range(comptime T: type, c *Chan(T), ok *bool) T {
	var zero T;
	*ok = false;
	while (true) {
		chan_lock(c);
		if (c.cap == 0) {
			if (c.waiting) {
				var v T = c.buf[0];
				c.waiting = false;
				chan_unlock(c);
				atomic_add(&chan_epoch, 1);
				*ok = true;
				return v;
			}
			if (c.closed) { chan_unlock(c); return zero; }
			chan_unlock(c);
			chan_block("receive");
			continue;
		}
		if (c.n != 0) {
			var v T = c.buf[c.head];
			c.head = c.head + 1;
			if (c.head >= c.cap) { c.head = 0; }
			c.n = c.n - 1;
			chan_unlock(c);
			atomic_add(&chan_epoch, 1);
			*ok = true;
			return v;
		}
		if (c.closed) { chan_unlock(c); return zero; }
		chan_unlock(c);
		chan_block("receive");
	}
}

// Non-blocking receive for `select`. Returns the value and sets *ok only
// when one is immediately available; a closed channel counts as ready with
// a zeroed value (the same value chan_recv would return), matching select's
// contract that a closed channel never blocks a case.
/// Non-blockingly receives a value, reporting availability through ok.
fn chan_try_recv(comptime T: type, c *Chan(T), ok *bool) T {
	var zero T;
	*ok = false;
	chan_lock(c);
	if (c.cap == 0) {
		if (c.waiting) {
			var v T = c.buf[0];
			c.waiting = false;
			chan_unlock(c);
			atomic_add(&chan_epoch, 1);
			*ok = true;
			return v;
		}
		if (c.closed) { chan_unlock(c); *ok = true; return zero; }
		chan_unlock(c);
		return zero;
	}
	if (c.n != 0) {
		var v T = c.buf[c.head];
		c.head = c.head + 1;
		if (c.head >= c.cap) { c.head = 0; }
		c.n = c.n - 1;
		chan_unlock(c);
		atomic_add(&chan_epoch, 1);
		*ok = true;
		return v;
	}
	if (c.closed) { chan_unlock(c); *ok = true; return zero; }
	chan_unlock(c);
	return zero;
}

// Non-blocking send for `select`: returns true only when the value was
// placed without waiting. A rendezvous (cap 0) send completes the handoff
// slot and returns immediately -- unlike chan_send it does not wait for the
// receiver to take the value out.
/// Non-blockingly sends a value, reporting whether it fit.
fn chan_try_send(comptime T: type, c *Chan(T), v T) bool {
	chan_lock(c);
	if (c.closed) {
		chan_unlock(c);
		eprint("qela: send on a closed channel\n");
		sys_exit(1);
	}
	if (c.cap == 0) {
		if (c.waiting) { chan_unlock(c); return false; }
		c.buf[0] = v;
		c.waiting = true;
		chan_unlock(c);
		atomic_add(&chan_epoch, 1);
		return true;
	}
	if (c.n == c.cap) { chan_unlock(c); return false; }
	var slot i64 = c.head + c.n;
	if (slot >= c.cap) { slot = slot - c.cap; }
	c.buf[slot] = v;
	c.n = c.n + 1;
	chan_unlock(c);
	atomic_add(&chan_epoch, 1);
	return true;
}

// The wait a `select` with no ready case and no default falls into. Same
// deadlock heuristic as a blocking send/receive: every coroutine parked
// here while the epoch stands still is reported.
/// Blocks waiting inside a select with no ready case.
fn chan_select_block() {
	chan_block("select");
}
