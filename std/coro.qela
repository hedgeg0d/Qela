import "sys.qela";
import "arena.qela";

// Cooperative coroutines on their own stacks. Slot 0 is the main context,
// so switching back to the program is the same operation as switching
// between coroutines. coro_switch and coro_entry_addr are compiler
// intrinsics: the first is the stack swap, the second is the address of
// the trampoline a fresh coroutine returns into.

let CORO_STACK = 65536;
let CORO_SLOTS = 256;
let CORO_HANDOFF_MAX = 32;

struct Coro {
	sp    i64,
	top   i64,
	done  bool,
	alive bool,
	// A parked context may move only after an ordinary coro_yield. Directed
	// generator switches and channel waits retain thread-local references.
	parked bool,
	blocked bool,
	pinned bool,
	moved bool,
}

// Per-thread: two OS threads must never see or touch each other's
// coroutines. A thread that spawns or runs coroutines has to have called
// tls_init once already -- the main thread gets that for free from the
// entry stub, any thread started through thread_clone has to call it
// itself before touching any of this.
tvar coros [256]Coro;
tvar ncoros int = 0;
tvar cur_coro int = 0;

let HANDOFF_EMPTY = 0;
let HANDOFF_REQUEST = 1;
let HANDOFF_BUSY = 2;
let HANDOFF_READY = 3;

struct CoroHandoff {
	state i64,
	sp    i64,
	top   i64,
}

// Thread.qela enables this for pool workers. The mailbox is process-global;
// the scheduler table remains private to each worker.
var coro_pool_n i64 = 0;
tvar coro_pool_id i64 = -1;
var coro_handoff [32]CoroHandoff;

// arena_alloc is bump-pointer state shared by every thread (it stays out
// of the bootstrap subset's reach, so it cannot use atomics itself -- see
// std/arena.qela); this lock is the only thing standing between two
// coroutines on two different OS threads getting overlapping stacks out
// of the same bump pointer.
var coro_stack_lock i64 = 0;

/// Allocates a fresh stack for a new coroutine.
fn coro_alloc_stack() *u8 {
	while (!atomic_cas(&coro_stack_lock, 0, 1)) { sys_sched_yield(); }
	var p *u8 = arena_alloc(CORO_STACK, 16);
	atomic_store(&coro_stack_lock, 0);
	return p;
}

// Under `qela irun` a coroutine cannot be a machine-stack image: there is
// no machine code to park on one, and `target` is a *Func rather than an
// address. INTERP is defined only by the interpreter, which owns the stack
// switching and hands this module back the two operations it cannot do
// itself. Everything else here -- the slot table, coro_next, the alive/done
// bookkeeping -- is unchanged and stays interpreted, so std/chan.qela and
// std/gc.qela keep reading the state they already read.
// Returns the new coroutine's id, or 0 when the slot table is full (the
// same silent rejection a void coro_spawn used to give -- a generator sets
// its Gen.coro from this, and gen_resume treats 0 as "never spawned").
/// Spawns a new coroutine and returns its identifier.
fn coro_spawn(target i64, a0 i64, a1 i64, a2 i64, a3 i64, a4 i64) int {
	var id int = 0;
	var scan int = 1;
	while (scan <= ncoros) {
		if (coros[scan].done || coros[scan].moved) { id = scan; break; }
		scan = scan + 1;
	}
	if (id == 0) {
		if (ncoros + 1 >= CORO_SLOTS) { return 0; }
		ncoros = ncoros + 1;
		id = ncoros;
	}

	$if (INTERP == "1") {
		interp_coro_spawn(id, target, a0, a1, a2, a3, a4);
		coros[id].sp = 0;
		coros[id].top = 0;
		coros[id].done = false;
		coros[id].alive = true;
		coros[id].parked = false;
		coros[id].blocked = false;
		coros[id].pinned = false;
		coros[id].moved = false;
		return id;
	}

	var stack *u8 = coro_alloc_stack();
	var top i64 = ((stack as i64) + CORO_STACK) & ~15;

	// Eighteen words on arm64/riscv64: twelve callee-saved slots (the
	// first LDP pair populating x29/x30 with zero and the trampoline
	// address on arm64, so the switch stub's ret lands inside it; riscv
	// puts the trampoline in the ra slot, p[11]), five arguments and the
	// target. No padding word and no alignment fixup needed: top is
	// 16-aligned and 18*8 is a multiple of 16, so sp0 always comes out
	// 16-aligned already -- unlike x86, BL doesn't push a return address,
	// so there is no leftover 8-byte offset to compensate for (see
	// gen_coro_switch_stub_arm64/riscv in srcql/).
	$if (TARGET != "x86_64") {
		var sp0 i64 = top - 18 * 8;

		var p *i64 = sp0 as *i64;
		var i i64 = 0;
		while (i < 12) { p[i] = 0; i = i + 1; }
		$if (TARGET == "arm64") {
			p[1] = coro_entry_addr();
		} $else {
			p[11] = coro_entry_addr();
		}
		p[12] = a0;
		p[13] = a1;
		p[14] = a2;
		p[15] = a3;
		p[16] = a4;
		p[17] = target;

		coros[id].sp = sp0;
	} $else {
		// Thirteen words: six callee-saved, the trampoline address, five
		// arguments and the target. Landing on sp % 16 == 8 leaves the target
		// with the alignment a call would have given it.
		var sp0 i64 = top - 13 * 8;
		if ((sp0 & 15) != 8) { sp0 = sp0 - 8; }

		var p *i64 = sp0 as *i64;
		var i i64 = 0;
		while (i < 6) { p[i] = 0; i = i + 1; }
		p[6] = coro_entry_addr();
		p[7] = a0;
		p[8] = a1;
		p[9] = a2;
		p[10] = a3;
		p[11] = a4;
		p[12] = target;

		coros[id].sp = sp0;
	}
	coros[id].top = top;
	coros[id].done = false;
	coros[id].alive = true;
	coros[id].parked = false;
	coros[id].blocked = false;
	coros[id].pinned = false;
	coros[id].moved = false;
	return id;
}

// Imports a parked context handed off by another pool worker. The stack image
// holds all continuation state; the destination gets a fresh local slot.
/// Imports a parked coroutine context.
fn coro_import(sp i64, top i64) bool {
	var id int = 0;
	var scan int = 1;
	while (scan <= ncoros) {
		if (coros[scan].done || coros[scan].moved) { id = scan; break; }
		scan = scan + 1;
	}
	if (id == 0) {
		if (ncoros + 1 >= CORO_SLOTS) { return false; }
		ncoros = ncoros + 1;
		id = ncoros;
	}
	coros[id].sp = sp;
	coros[id].top = top;
	coros[id].done = false;
	coros[id].alive = true;
	coros[id].parked = true;
	coros[id].blocked = false;
	coros[id].pinned = false;
	coros[id].moved = false;
	return true;
}

// Prevents directed coroutine protocols such as generators from moving.
/// Pins current coroutine to its worker.
fn coro_pin() {
	if (cur_coro != 0) { coros[cur_coro].pinned = true; }
}

// Channel waits are addressed through this worker's scheduler state, so they
// are never migration candidates while parked.
/// Marks current coroutine blocked or runnable.
fn coro_set_blocked(v bool) {
	if (cur_coro != 0) { coros[cur_coro].blocked = v; }
}

/// Marks current OS thread as a pool worker.
fn coro_pool_enter(id i64) { coro_pool_id = id; }

/// Sets the number of pool workers.
fn coro_pool_set_n(n i64) { atomic_store(&coro_pool_n, n); }

// A yielding coroutine may safely donate another already parked context. Its
// own stack is still executing until the switch stub saves it, so it is never
// selected here.
fn coro_offer_handoff() {
	if (coro_pool_id < 0) { return; }
	var pool_n i64 = atomic_load(&coro_pool_n);
	var dst i64 = 0;
	while (dst < pool_n) {
		if (dst != coro_pool_id && atomic_cas(&coro_handoff[dst].state, HANDOFF_REQUEST, HANDOFF_BUSY)) {
			var ci int = 1;
			while (ci <= coro_slots()) {
				if (ci != cur_coro && coros[ci].alive && !coros[ci].done && coros[ci].parked && !coros[ci].blocked && !coros[ci].pinned && !coros[ci].moved) {
					coros[ci].moved = true;
					coro_handoff[dst].sp = coros[ci].sp;
					coro_handoff[dst].top = coros[ci].top;
					fence();
					atomic_store(&coro_handoff[dst].state, HANDOFF_READY);
					return;
				}
				ci = ci + 1;
			}
			atomic_store(&coro_handoff[dst].state, HANDOFF_EMPTY);
		}
		dst = dst + 1;
	}
}

// An idle worker leaves a request, then imports a ready context on a later
// scheduler turn. No other worker writes its coro table.
/// Imports one donated coroutine when available.
fn coro_take_handoff() bool {
	var id i64 = coro_pool_id;
	if (id < 0) { return false; }
	if (atomic_load(&coro_handoff[id].state) == HANDOFF_READY) {
		fence();
		var sp i64 = coro_handoff[id].sp;
		var top i64 = coro_handoff[id].top;
		atomic_store(&coro_handoff[id].state, HANDOFF_EMPTY);
		return coro_import(sp, top);
	}
	atomic_cas(&coro_handoff[id].state, HANDOFF_EMPTY, HANDOFF_REQUEST);
	return false;
}

// Local queue work means this worker is no longer idle. READY is retained:
// its context already belongs to this worker and will be imported later.
/// Cancels this worker's unserved idle request.
fn coro_cancel_handoff_request() {
	if (coro_pool_id >= 0) {
		atomic_cas(&coro_handoff[coro_pool_id].state, HANDOFF_REQUEST, HANDOFF_EMPTY);
	}
}

/// Returns the next runnable coroutine after the given one.
fn coro_next(from int) int {
	var i int = from + 1;
	var seen int = 0;
	while (seen <= ncoros) {
		if (i > ncoros) { i = 0; }
		if (i == 0 || (coros[i].alive && !coros[i].done && !coros[i].moved)) { return i; }
		i = i + 1;
		seen = seen + 1;
	}
	return 0;
}

/// Reports whether any coroutine is still runnable.
fn coro_pending() bool {
	var i int = 1;
	while (i <= ncoros) {
		if (coros[i].alive && !coros[i].done && !coros[i].moved) { return true; }
		i = i + 1;
	}
	return false;
}

/// Returns the total number of spawned coroutines.
fn coro_slots() int { return ncoros; }

// How many coroutines could still run. A channel wait compares this against
// the number of coroutines parked inside one.
/// Counts coroutines that could still run.
fn coro_live() int {
	var n int = 0;
	var i int = 1;
	while (i <= ncoros) {
		if (coros[i].alive && !coros[i].done && !coros[i].moved) { n = n + 1; }
		i = i + 1;
	}
	return n;
}

// Returns false when nothing else could run, which lets a blocked channel
// operation tell waiting apart from deadlock.
/// Yields to another coroutine, reporting if one ran.
fn coro_yield() bool {
	var from int = cur_coro;
	coro_offer_handoff();
	var to int = coro_next(from);
	if (to == from) { return false; }
	cur_coro = to;
	$if (INTERP == "1") {
		interp_coro_switch(from, to);
		return true;
	}
	if (from != 0) { coros[from].parked = true; }
	coro_switch(&coros[from].sp as *u8, &coros[to].sp as *u8);
	// `from` lives in this continuation and names its old worker's slot after
	// migration. Leave parked set: a running context is excluded by cur_coro;
	// every other parked context has its complete state in its own stack.
	return true;
}

// Runs on the finishing coroutine's stack and never returns: the switch
// away from a done slot is one-way.
/// Marks the current coroutine finished and switches away.
fn coro_finish() {
	var from int = cur_coro;
	coros[from].done = true;
	var to int = coro_next(from);
	cur_coro = to;
	$if (INTERP == "1") {
		interp_coro_switch(from, to);
		return;
	}
	coro_switch(&coros[from].sp as *u8, &coros[to].sp as *u8);
}

/// Runs all coroutines until none remain runnable.
fn coro_run_all() {
	while (coro_pending()) { coro_yield(); }
}
