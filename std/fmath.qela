// Float math, stage1-only: f64 needs floats, which stage0 does not have.

/// Returns the square root of a float.
fn sqrt(x f64) f64 {
	if (x <= 0.0) { return 0.0; }
	// A magic-constant initial guess (the same trick fast inverse square
	// root uses), then seven Newton steps: y = (y + x/y) / 2.
	var bits i64 = *(&x as *i64);
	var guess i64 = 0x1ff7a3bea91d9b1b + (bits >> 1);
	var y f64 = *(&guess as *f64);
	var i int = 0;
	while (i < 7) {
		y = (y + x / y) * 0.5;
		i = i + 1;
	}
	return y;
}

let PI = 3.141592653589793;
let TWOPI = 6.283185307179586;
let HALFPI = 1.5707963267948966;

// sin(x) for any finite x: fold into [-2pi, 2pi] by integer division,
// then into [-pi/2, pi/2] by symmetry, then a five-term Taylor series.
/// Returns the sine of an angle in radians.
fn sin(x f64) f64 {
	var r f64 = x - (x / TWOPI) as i64 as f64 * TWOPI;
	if (r > PI) { r = r - TWOPI; }
	if (r < -PI) { r = r + TWOPI; }
	if (r > HALFPI) { r = PI - r; }
	if (r < -HALFPI) { r = -PI - r; }
	var r2 f64 = r * r;
	var p f64 = 1.0 - r2 / 6.0 + r2 * r2 / 120.0 - r2 * r2 * r2 / 5040.0
	          + r2 * r2 * r2 * r2 / 362880.0;
	return r * p;
}

/// Returns the cosine of an angle in radians.
fn cos(x f64) f64 {
	return sin(x + HALFPI);
}
