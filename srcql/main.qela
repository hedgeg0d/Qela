import "comp.qela";
import "diag.qela";
import "absorb.qela";
import "lex.qela";
import "parse.qela";
import "type.qela";
import "codegen.qela";
import "linker.qela";
import "elf.qela";
import "fmt.qela";
import "fmtgen.qela";
import "jmgen.qela";
import "lsp.qela";
import "doc.qela";
import "../std/io.qela";

// The interpreter is the one part of srcql/ that stage0 does not compile: it
// needs floats, match and coro_switch, none of which stage0 has. tools/
// bootstrap.sh passes -D BOOTSTRAP=1 to the stage0 step alone, so S1a comes
// out without `irun` and every compiler from S2 on has it. See
// docs/BOOTSTRAP.md.
$if (BOOTSTRAP != "1") {
import "interp.qela";
import "../std/abiwire.qela";
}

fn default_output(path str) str {
	var end i64 = path.len;
	if (end > 5 && path.ptr[end - 5] == '.' && path.ptr[end - 4] == 'q' &&
	    path.ptr[end - 3] == 'e' && path.ptr[end - 2] == 'l' && path.ptr[end - 1] == 'a') {
		end = end - 5;
	}
	var start i64 = 0;
	var i i64 = 0;
	while (i < end) {
		if (path.ptr[i] == '/') { start = i + 1; }
		i = i + 1;
	}
	if (start == end) { return "a.out"; }
	return str_slice(path, start, end);
}

// Prints an embedded module, so the shipped library stays readable without
// a copy on disk. Accepts "fmt", "fmt.qela" or "std/fmt.qela".
fn dump_std(name str) int {
	// tools/genblob.py bakes every std/ module as the path "std/<name>.qela";
	// the 4 and 5 are len("std/") and len(".qela"), and must move in lockstep
	// with the prefix and suffix there.
	var i int = 0;
	var n int = std_blob_count();
	while (i < n) {
		var full str = std_blob_name(i);
		var bare str = str_slice(full, 4, full.len - 5);
		if (str_eq(full, name) || str_eq(bare, name) ||
		    str_eq(str_slice(full, 4, full.len), name)) {
			write_str(STDOUT, std_blob_src(i));
			return 0;
		}
		i = i + 1;
	}
	eprint("error: no embedded module named ");
	eprint(name);
	eprint("\n");
	return 1;
}

// The compiler is designed around one compilation per process, and the
// per-pass reset (reset_code) only covers what changes between branch
// relaxation passes. Everything module-global that accumulates over a
// compile — file table, string table, functions, types, templates, the
// code/rodata/data buffers, DWARF — is cleared here so one process can
// compile any number of programs (qela test runs a whole corpus).
//
// Contract: every `var` in srcql/ that survives a single codegen pass
// must be reset either here (between compiles) or in reset_code (between
// relaxation passes). The lists that grow with each emitted function —
// call/string/data fixups, the bounds trampoline targets, the panic-stub
// sites, the backtrace references, the GC roots, the per-function line
// rows — are reset by reset_code at the start of every pass, so they
// never need clearing here. Code/rodata/data buffers are cleared in both:
// reset_code at every pass boundary (per-branch relaxation), and here
// for a clean slate before the first pass of the next compile.
fn reset_compile() {
	nfiles = 0;
	nstrs = 0;
	strlist_head = null;
	strlist_tail = null;
	o_nsyms = 0;
	global_vars = null;
	global_vars_tail = null;
	scope_root = null;
	cur_func = null;
	ntype_vars = 0;
	all_funcs = null;
	funcs_tail = null;
	fmtgen_reset();
	jmgen_reset();
	macro_list = null;
	macro_tail = null;
	top_asm_head = null;
	top_asm_tail = null;
	entry_name = "";
	named_types = null;
	tmpls = null;
	ct_stack = null;
	ct_returning = false;
	ct_broke = false;
	ct_continued = false;
	code.n = 0;
	rodata.n = 0;
	gdata.n = 0;
	bss_size = 0;
	// Branch ids restart at zero every compile; the short-branch marks from
	// the previous compile must not leak into the new one. This list is the
	// one per-pass state reset_code must NOT clear — marks survive between
	// relaxation passes of a single compile.
	br_short.n = 0;
	lex_keep_comments = false;
	need_fmt = false;
	need_dyn = false;
	ty_dynval_cache = null;
	dyn_types_head = null;
	dyn_types_n = 0;
	depth = 0;
	overflow_pushed = 0;
	cur_loop = null;
	cur_defers = null;
	defer_depth = 0;
	gen_unit = null;
	dw_line.n = 0;
	dw_info.n = 0;
	dw_abbrev.n = 0;
	dw_sym.n = 0;
	dw_strtab.n = 0;
	// Diagnostic state: secondary span and macro backtrace must not leak
	// between compiles. The colour decision is re-evaluated at the top of
	// compile_src (so multi-compile processes like `qela test` see the right
	// tty state for each compile).
	sec_set = false;
	sec_pos = -1;
	macro_top = null;
	diag_setup_done = false;
	diag_colored = false;
	// Keyword list for "did you mean" suggestions is built once and the
	// str slots point into rodata, so no reset needed across compiles.
}

fn compile_src(name str, src str, output str) {
	reset_compile();
	// Resolve colour once per compile, after reset cleared the cached value.
	// Cheap: one isatty + two env reads, never on the hot path.
	diag_setup();
	var file int = diag_add_file(name, src);
	set_module_dir(name);
	var unit *Unit = parse(lex(src, (file as i64) << FILE_SHIFT));
	// $flag directives inside the source applied during the parse above;
	// re-validate the flag combinations now that they are final.
	pie_check();
	base_check();
	var img Image;
	codegen(unit, &img);
	// Soft errors kept the compile alive to find more of them; now that
	// every pass finished, fail without writing a binary.
	diag_fail_if_errors();
	if (opt_object) { write_object(output, &img); }
	else { write_elf(output, &img); }
}

fn compile_file(input str, output str) {
	compile_src(input, read_file(input), output);
}

// ── qela . : a directory builds as one project ──
//
// Every .qela file under the directory, recursively (dot-directories like
// .git skipped), becomes part of one program: the entry file (a top-level
// main.qela, or the sole file at any depth) is merged last, everything else
// first in sorted order (by path, so a subdirectory's files sort together),
// so functions call across files without imports. Imports inside the files
// still work; one already merged by path is skipped. Types used in a
// signature must come from a file that sorts before its user, or from the
// entry file itself.

fn str_lt(a str, b str) bool {
	var i i64 = 0;
	while (i < a.len && i < b.len) {
		if (a.ptr[i] != b.ptr[i]) { return a.ptr[i] < b.ptr[i]; }
		i = i + 1;
	}
	return a.len < b.len;
}

// Lexes a file and splices its tokens after tail, returning the new tail.
fn merge_file(path str, tail *Token, head **Token) *Token {
	var src str = read_file(path);
	var file int = diag_add_file(path, src);
	var toks *Token = lex(src, (file as i64) << FILE_SHIFT);
	if (*head as i64 == 0) { *head = toks; }
	if (tail as i64 != 0) { tail.next = toks; }
	var t *Token = toks;
	while (t.next as i64 != 0 && t.next.kind != TK_EOF) { t = t.next; }
	return t;
}

var g_dir_names [1024]str;
var g_dir_n int = 0;

// A per-process counter for /tmp/qela-* paths. The pid alone collides on
// reuse; a counter differentiates parallel invocations and reused pids.
var qela_tmp_seq int = 0;

fn qela_mktmp(prefix str) str {
	qela_tmp_seq = qela_tmp_seq + 1;
	var b Buf;
	fmt_str(&b, "/tmp/");
	fmt_str(&b, prefix);
	fmt_i64(&b, sys_getpid() as i64);
	buf_u8(&b, '-');
	fmt_i64(&b, qela_tmp_seq as i64);
	return buf_str(&b);
}

// Lists a directory's .qela files into g_dir_names, sorted by name.
fn dir_list(dir str) {
	var list Buf;
	read_dir(dir, &list);
	g_dir_n = 0;
	var i i64 = 0;
	var start i64 = 0;
	while (i < list.n) {
		if (list.p[i] == '\n') {
			if (g_dir_n >= 1024) { die("error: too many .qela files in the directory"); }
			g_dir_names[g_dir_n].ptr = list.p + start;
			g_dir_names[g_dir_n].len = i - start;
			g_dir_n = g_dir_n + 1;
			start = i + 1;
		}
		i = i + 1;
	}
	if (g_dir_n == 0) { die("error: no .qela files in the directory"); }

	var k int = 0;
	while (k < g_dir_n) {
		var j int = k;
		while (j > 0 && str_lt(g_dir_names[j], g_dir_names[j - 1])) {
			var tmp str = g_dir_names[j];
			g_dir_names[j] = g_dir_names[j - 1];
			g_dir_names[j - 1] = tmp;
			j = j - 1;
		}
		k = k + 1;
	}
}

// The entry file of a directory: main.qela, or the sole file. Prints an
// error and returns "" when there is nothing to build.
fn dir_entry_path(dir str) str {
	dir_list(dir);
	var ei int = -1;
	var i int = 0;
	while (i < g_dir_n) {
		if (str_eq(g_dir_names[i], "main.qela")) { ei = i; }
		i = i + 1;
	}
	if (ei < 0 && g_dir_n == 1) { ei = 0; }
	if (ei < 0) {
		eprint("error: no main.qela in the directory\n");
		return "";
	}
	var ep Buf;
	fmt_str(&ep, dir);
	if (ep.n == 0 || ep.p[ep.n - 1] != '/') { buf_u8(&ep, '/'); }
	fmt_str(&ep, g_dir_names[ei]);
	return buf_str(&ep);
}

// Merges every .qela file in the directory into one program: the entry file
// (main.qela, or the sole file) comes last, everything else first in sorted
// order, so functions call across files without imports.
// The token merge behind `qela .`: every file under the directory spliced
// into one stream with the entry file last, then parsed as one unit. Split
// out of cmd_build_dir so `qela irun <dir>` reaches the same unit without
// going near codegen.
fn parse_dir(dir str) *Unit {
	var epath str = dir_entry_path(dir);
	if (epath.len == 0) { sys_exit(1); }

	var dp Buf;
	fmt_str(&dp, dir);
	if (dp.n == 0 || dp.p[dp.n - 1] != '/') { buf_u8(&dp, '/'); }

	var head *Token = null;
	var tail *Token = null;
	var idx int = 0;
	while (idx < g_dir_n) {
		var fp Buf;
		fmt_str(&fp, buf_str(&dp));
		fmt_str(&fp, g_dir_names[idx]);
		if (str_eq(buf_str(&fp), epath)) { idx = idx + 1; continue; }
		tail = merge_file(buf_str(&fp), tail, &head);
		idx = idx + 1;
	}
	tail = merge_file(epath, tail, &head);

	set_module_dir(epath);
	return parse(head);
}

fn cmd_build_dir(dir str, output str) {
	var unit *Unit = parse_dir(dir);
	var img Image;
	codegen(unit, &img);
	write_elf(output, &img);
}

// Compiles to a temporary file, runs it with the remaining arguments, then
// removes it and reports the child's exit status as its own.
fn cmd_run(argc int, argv **u8) int {
	if (argc >= 3 && (str_eq(str_from_cstr(argv[2]), "-h") ||
	    str_eq(str_from_cstr(argv[2]), "--help"))) {
		return cmd_help();
	}
	if (argc < 3) {
		eprint("usage: qela run <file.qela> [args]\n");
		return 2;
	}
	var input str = str_from_cstr(argv[2]);

	// A backtrace on panic is the point of `qela run`; plain compiles stay
	// deterministic for the bootstrap gate, which never sets this flag.
	opt_backtrace = true;

	var tmp str = qela_mktmp("qela-run-");
	var tmpc *u8 = cstr(tmp);

	if (str_eq(input, "-")) { compile_src("<stdin>", read_stdin(), tmp); }
	else if (is_dir(input)) { cmd_build_dir(input, tmp); }
	else { compile_file(input, tmp); }

	var nargs int = argc - 2;
	var cargv *i64 = arena_alloc((nargs as i64 + 1) * 8, 8) as *i64;
	cargv[0] = tmpc as i64;
	var i int = 1;
	while (i < nargs) {
		cargv[i] = argv[i + 2] as i64;
		i = i + 1;
	}
	cargv[nargs] = 0;

	var envp *i64 = arena_alloc(8, 8) as *i64;
	envp[0] = 0;

	var pid i64 = sys_fork();
	if (pid == 0) {
		sys_execve(tmpc, cargv as *u8, envp as *u8);
		sys_exit(127);
	}
	var status [1]i64;
	sys_wait4(pid, &status[0] as *u8);
	sys_unlink(tmpc);
	return ((status[0] >> 8) & 255) as int;
}

// ── qela test: the compiler is also the test runner ──
//
// Reads the expectations from the source's leading comments:
//
//   // expect-exit: 42          the program must exit 42 (default 0)
//   // expect-out: text         each line the output must contain, in order
//   // expect-compile-error     the compiler must reject the file
//   // expect-warn: text        each line must appear, in order, in the
//                               compiler's diagnostic output (stderr) --
//                               works with or without expect-compile-error
//
// then compiles (a directory input merges like `qela .`), runs the binary
// with any remaining arguments, captures stdout+stderr into a temp file
// and compares. Prints one `ok name` / `FAIL name: detail` line per test
// and exits with the number of failures.

fn expect_has(src str, mark str) bool {
	var i i64 = 0;
	while (i + 2 < src.len) {
		if (src.ptr[i] == '/' && src.ptr[i + 1] == '/' &&
		    str_eq(str_slice(src, i + 3, i + 3 + mark.len), mark)) { return true; }
		i = i + 1;
	}
	return false;
}

// Whether the file's reject expectation applies to the current target. A
// bare `// expect-compile-error` rejects everywhere; a suffixed one --
// `// expect-compile-error x86` or `arm64` -- only on that target, and on
// the other the file must compile and run (carrying its own expect-exit).
fn expect_reject_target(src str) bool {
	var mark str = "expect-compile-error";
	var i i64 = 0;
	while (i + 2 < src.len) {
		if (src.ptr[i] == '/' && src.ptr[i + 1] == '/' &&
		    str_eq(str_slice(src, i + 3, i + 3 + mark.len), mark)) {
			var j i64 = i + 3 + mark.len;
			while (j < src.len && src.ptr[j] == ' ') { j = j + 1; }
			if (j + 3 < src.len && src.ptr[j] == 'x') { return opt_target == TARGET_X86_64; }
			if (j + 4 < src.len && src.ptr[j] == 'a') { return opt_target == TARGET_ARM64; }
			if (j + 6 < src.len && src.ptr[j] == 'r') { return opt_target == TARGET_RISCV64; }
			return true;
		}
		i = i + 1;
	}
	return false;
}

// Appends the text after the marker of every matching comment line, one
// per line, to out. Returns whether any line matched.
fn expect_lines(src str, mark str, out *Buf, n *int) bool {
	var found bool = false;
	var i i64 = 0;
	while (i + 2 < src.len) {
		if (src.ptr[i] == '/' && src.ptr[i + 1] == '/' &&
		    str_eq(str_slice(src, i + 3, i + 3 + mark.len), mark)) {
			found = true;
			var j i64 = i + 3 + mark.len;
			while (j < src.len && src.ptr[j] == ' ') { j = j + 1; }
			var e i64 = j;
			while (e < src.len && src.ptr[e] != '\n') { e = e + 1; }
			if (*n > 0) { buf_u8(out, '\n'); }
			var k i64 = j;
			while (k < e) { buf_u8(out, src.ptr[k]); k = k + 1; }
			*n = *n + 1;
		}
		i = i + 1;
	}
	return found;
}

// Index of the first occurrence of needle in haystack at or after `from`,
// or -1. Used to check expect-warn lines appear in order in captured stderr.
fn str_find_sub(haystack str, needle str, from i64) i64 {
	if (needle.len == 0) { return from; }
	var i i64 = from;
	while (i + needle.len <= haystack.len) {
		var j i64 = 0;
		while (j < needle.len && haystack.ptr[i + j] == needle.ptr[j]) { j = j + 1; }
		if (j == needle.len) { return i; }
		i = i + 1;
	}
	return -1;
}

// True if every `// expect-warn: text` line in src appears, in order, as a
// substring of captured (text is stderr diagnostic output, so this checks
// warnings, hints and "did you mean" / secondary-location notes alike).
fn expect_warn_ok(src str, captured str) bool {
	var wanted Buf;
	var wn int = 0;
	if (!expect_lines(src, "expect-warn:", &wanted, &wn)) { return true; }
	var lines str = buf_str(&wanted);
	var li i64 = 0;
	var cur i64 = 0;
	var at i64 = 0;
	var ok bool = true;
	while (li <= lines.len) {
		if (li == lines.len || lines.ptr[li] == '\n') {
			var one str = str_slice(lines, cur, li);
			if (one.len > 0) {
				at = str_find_sub(captured, one, at);
				if (at < 0) { ok = false; } else { at = at + one.len; }
			}
			cur = li + 1;
		}
		li = li + 1;
	}
	return ok;
}

fn parse_i64(s str) i64 {
	var i i64 = 0;
	var neg bool = false;
	if (s.len > 0 && s.ptr[0] == '-') { neg = true; i = 1; }
	var v i64 = 0;
	while (i < s.len && s.ptr[i] >= '0' && s.ptr[i] <= '9') {
		v = v * 10 + (s.ptr[i] as i64 - '0');
		i = i + 1;
	}
	if (neg) { v = -v; }
	return v;
}

fn test_ok(name str) {
	write_str(STDOUT, "ok   ");
	write_str(STDOUT, name);
	write_str(STDOUT, "\n");
}

fn test_fail(name str, msg str) {
	write_str(STDOUT, "FAIL ");
	write_str(STDOUT, name);
	write_str(STDOUT, ": ");
	write_str(STDOUT, msg);
	write_str(STDOUT, "\n");
}

// One test: compile `input` (already read into src), run it with the
// program arguments prog_argv[0..nprog), compare against the expectations
// in src's comments. Returns the failure count (0 or 1).
fn test_one(input str, src str, prog_argv **u8, nprog int) int {
	// The compile itself may be the test.
	if (expect_reject_target(src)) {
		var warn_path str = qela_mktmp("qela-test-warn-");
		var warn_c *u8 = cstr(warn_path);
		var warn_fd i64 = sys_open_exec(warn_c);
		if (warn_fd < 0) { die("error: cannot create the warning capture file"); }
		var pid i64 = sys_fork();
		if (pid == 0) {
			sys_dup2(warn_fd, STDERR);
			compile_file(input, qela_mktmp("qela-test-reject-"));
			sys_exit(0);
		}
		var status [1]i64;
		sys_wait4(pid, &status[0] as *u8);
		sys_close(warn_fd);
		var warn_out str = read_file(warn_path);
		sys_unlink(warn_c);
		if (warn_out.len > 0) { sys_write(STDERR, warn_out.ptr, warn_out.len); }
		var code i64 = (status[0] >> 8) & 255;
		if (code == 0) {
			test_fail(input, "compiled, but was expected to be rejected");
			return 1;
		}
		if (!expect_warn_ok(src, warn_out)) {
			test_fail(input, "diagnostics do not match expect-warn");
			return 1;
		}
		test_ok(input);
		return 0;
	}

	var tmp str = qela_mktmp("qela-test-");
	var tmpc *u8 = cstr(tmp);
	var ob Buf;
	fmt_str(&ob, tmp);
	fmt_str(&ob, ".out");
	var outc *u8 = cstr(buf_str(&ob));

	// Compile in a fork with stderr redirected to a temp file, so any
	// diagnostics (warnings) can be checked against `expect-warn:` lines.
	// The captured text is echoed to the real stderr afterward, so a
	// test run without expect-warn still shows warnings as before.
	var warn_path str = qela_mktmp("qela-test-warn-");
	var warn_c *u8 = cstr(warn_path);
	var warn_fd i64 = sys_open_exec(warn_c);
	if (warn_fd < 0) { die("error: cannot create the warning capture file"); }
	var cpid i64 = sys_fork();
	if (cpid == 0) {
		sys_dup2(warn_fd, STDERR);
		compile_file(input, tmp);
		sys_exit(0);
	}
	var cstatus [1]i64;
	sys_wait4(cpid, &cstatus[0] as *u8);
	sys_close(warn_fd);
	var warn_out str = read_file(warn_path);
	sys_unlink(warn_c);
	if (warn_out.len > 0) { sys_write(STDERR, warn_out.ptr, warn_out.len); }
	var ccode i64 = (cstatus[0] >> 8) & 255;
	if (ccode != 0) {
		test_fail(input, "compile failed");
		return 1;
	}

	if (!expect_warn_ok(src, warn_out)) {
		test_fail(input, "warnings do not match expect-warn");
		return 1;
	}

	var out_fd i64 = sys_open_exec(outc);
	if (out_fd < 0) { die("error: cannot create the test output file"); }

	var nargs int = nprog + 1;
	var cargv *i64 = arena_alloc((nargs as i64 + 1) * 8, 8) as *i64;
	cargv[0] = tmpc as i64;
	var i int = 1;
	while (i < nargs) {
		cargv[i] = prog_argv[i - 1] as i64;
		i = i + 1;
	}
	cargv[nargs] = 0;
	var envp *i64 = arena_alloc(8, 8) as *i64;
	envp[0] = 0;

	var pid i64 = sys_fork();
	if (pid == 0) {
		sys_dup2(out_fd, 1);
		sys_dup2(out_fd, 2);
		sys_execve(tmpc, cargv as *u8, envp as *u8);
		sys_exit(127);
	}
	var status [1]i64;
	sys_wait4(pid, &status[0] as *u8);
	sys_close(out_fd);

	var got_out str = read_file(buf_str(&ob));
	var got_exit i64 = (status[0] >> 8) & 255;
	sys_unlink(tmpc);
	sys_unlink(outc);

	var want_exit i64 = 0;
	var eb Buf;
	var en int = 0;
	if (expect_lines(src, "expect-exit:", &eb, &en)) {
		want_exit = parse_i64(buf_str(&eb));
	}
	var fail_count int = 0;
	var msg Buf;
	if (got_exit != want_exit) {
		fmt_str(&msg, "exit ");
		fmt_i64(&msg, got_exit);
		fmt_str(&msg, ", want ");
		fmt_i64(&msg, want_exit);
		test_fail(input, buf_str(&msg));
		fail_count = fail_count + 1;
	} else {
		var wb Buf;
		var wn int = 0;
		expect_lines(src, "expect-out:", &wb, &wn);
		if (wn > 0) {
			var out_len i64 = got_out.len;
			while (out_len > 0 && (got_out.ptr[out_len - 1] == '\n' ||
			    got_out.ptr[out_len - 1] == 0)) { out_len = out_len - 1; }
			if (!str_eq(str_slice(got_out, 0, out_len), buf_str(&wb))) {
				test_fail(input, "output does not match expect-out");
				fail_count = fail_count + 1;
			}
		}
	}
	if (fail_count == 0) { test_ok(input); }
	return fail_count;
}

// qela test <file|dir> [args] — with several files, `--` separates the
// program arguments: qela test a.qela b.qela -- 5 6. A directory input
// merges like `qela .` and takes its expectations from the entry file.
fn cmd_test(argc int, argv **u8) int {
	if (argc < 3) {
		eprint("usage: qela test <file.qela|dir> [files...] [-- args]\n");
		return 2;
	}
	var first str = str_from_cstr(argv[2]);
	if (is_dir(first)) {
		var entry str = dir_entry_path(first);
		if (entry.len == 0) { return 1; }
		return test_one(first, read_file(entry), argv + 3, argc - 3);
	}

	var inputs [64]str;
	var n_in int = 0;
	var prog_start int = argc;
	var i int = 2;
	while (i < argc) {
		var a str = str_from_cstr(argv[i]);
		if (str_eq(a, "--")) { prog_start = i + 1; break; }
		if (n_in >= 64) { die("error: too many test files"); }
		inputs[n_in] = a;
		n_in = n_in + 1;
		i = i + 1;
	}
	var fails int = 0;
	var k int = 0;
	while (k < n_in) {
		fails = fails + test_one(inputs[k], read_file(inputs[k]),
		    argv + prog_start, argc - prog_start);
		k = k + 1;
	}
	return fails;
}

$if (BOOTSTRAP != "1") {

let REPL_FRAME_SIZE = 1 * 1024 * 1024;
let REPL_DATA_SIZE = 16 * 1024 * 1024;

let REPL_PATH_A = 1;
let REPL_PATH_STMT = 2;
let REPL_PATH_EXPR = 3;

var repl_fn *Func;
var repl_unit *Unit;
var repl_off i64 = 0;
var repl_locals_done *Var = null;
var repl_globals_done *Var = null;
var repl_strs_done *StrLit = null;
var repl_bootstrap_funcs *Func = null;
var repl_line_seq int = 0;

fn repl_skip_ws(s str, i i64) i64 {
	while (i < s.len && (s.ptr[i] == ' ' || s.ptr[i] == '\t')) { i = i + 1; }
	return i;
}

fn repl_blank(s str) bool {
	return repl_skip_ws(s, 0) == s.len;
}

fn repl_leading_word(s str) str {
	var i i64 = repl_skip_ws(s, 0);
	var start i64 = i;
	if (i < s.len && is_letter(s.ptr[i])) {
		while (i < s.len && is_ident_char(s.ptr[i])) { i = i + 1; }
	}
	return str_slice(s, start, i);
}

fn repl_colon_word(s str, rest *str) str {
	var i i64 = repl_skip_ws(s, 0) + 1;
	var start i64 = i;
	while (i < s.len && is_ident_char(s.ptr[i])) { i = i + 1; }
	var w str = str_slice(s, start, i);
	i = repl_skip_ws(s, i);
	*rest = str_slice(s, i, s.len);
	return w;
}

fn repl_classify(line str) int {
	var w str = repl_leading_word(line);
	if (str_eq(w, "fn") || str_eq(w, "struct") || str_eq(w, "enum") ||
	    str_eq(w, "import") || str_eq(w, "macro") || str_eq(w, "extern") ||
	    str_eq(w, "asm") || str_eq(w, "entry")) {
		return REPL_PATH_A;
	}
	if (str_eq(w, "var") || str_eq(w, "let") || str_eq(w, "if") ||
	    str_eq(w, "while") || str_eq(w, "for") || str_eq(w, "match") ||
	    str_eq(w, "return") || str_eq(w, "super") || str_eq(w, "break") ||
	    str_eq(w, "continue") || str_eq(w, "defer") || str_eq(w, "spawn") ||
	    str_eq(w, "go")) {
		return REPL_PATH_STMT;
	}
	var i i64 = repl_skip_ws(line, 0);
	if (i < line.len && line.ptr[i] == '{') { return REPL_PATH_STMT; }
	return REPL_PATH_EXPR;
}

fn repl_strip_trailing_semi(s str) str {
	var end i64 = s.len;
	while (end > 0 && (s.ptr[end - 1] == ' ' || s.ptr[end - 1] == '\t')) { end = end - 1; }
	if (end > 0 && s.ptr[end - 1] == ';') { end = end - 1; }
	return str_slice(s, 0, end);
}

fn repl_wrap_expr(line str) str {
	var b Buf;
	fmt_str(&b, "write_str(STDOUT, \"");
	buf_u8(&b, '$');
	buf_u8(&b, '{');
	fmt_str(&b, repl_strip_trailing_semi(line));
	buf_u8(&b, '}');
	fmt_str(&b, "\");\n");
	return buf_str(&b);
}

fn repl_unshadow(name str) {
	var vs *VarScope = scope_root.vars;
	var prev *VarScope = null;
	while (vs as i64 != 0) {
		if (str_eq(vs.name, name)) {
			if (prev as i64 == 0) { scope_root.vars = vs.next; }
			else { prev.next = vs.next; }
			return;
		}
		prev = vs;
		vs = vs.next;
	}
}

fn repl_maybe_unshadow(line str, word str) {
	if (!str_eq(word, "var") && !str_eq(word, "let")) { return; }
	var i i64 = repl_skip_ws(line, 0) + word.len;
	i = repl_skip_ws(line, i);
	if (i < line.len && line.ptr[i] == '~') { i = i + 1; }
	var start i64 = i;
	while (i < line.len && is_ident_char(line.ptr[i])) { i = i + 1; }
	if (i > start) { repl_unshadow(str_slice(line, start, i)); }
}

fn repl_depth_delta(line str) i64 {
	var d i64 = 0;
	var i i64 = 0;
	var in_str bool = false;
	while (i < line.len) {
		var c u8 = line.ptr[i];
		if (in_str) {
			if (c == '\\') { i = i + 1; }
			else if (c == '"') { in_str = false; }
		} else if (c == '"') {
			in_str = true;
		} else if (c == '/' && i + 1 < line.len && line.ptr[i + 1] == '/') {
			return d;
		} else if (c == '{' || c == '(' || c == '[') {
			d = d + 1;
		} else if (c == '}' || c == ')' || c == ']') {
			d = d - 1;
		}
		i = i + 1;
	}
	return d;
}

fn repl_offset_var(v *Var) {
	if (v.has_reg || v.arg_stack) { return; }
	var size i64 = v.ty.size as i64;
	var al i64 = v.ty.align as i64;
	if (v.by_ref) { size = 8; al = 8; }
	else if (size < 8) { size = 8; }
	repl_off = (repl_off + size + al - 1) & ~(al - 1);
	v.offset = repl_off as int;
}

fn repl_assign_offsets(head *Var, stop *Var) {
	if (head as i64 == 0 || head as i64 == stop as i64) { return; }
	repl_assign_offsets(head.next, stop);
	repl_offset_var(head);
}

fn repl_sync() {
	repl_assign_offsets(repl_fn.locals, repl_locals_done);
	repl_locals_done = repl_fn.locals;

	var gstart *Var = global_vars;
	if (repl_globals_done as i64 != 0) { gstart = repl_globals_done.next; }
	ip_repl_layout_globals(gstart, null);
	repl_globals_done = global_vars_tail;

	var s *StrLit = strlist_head;
	if (repl_strs_done as i64 != 0) { s = repl_strs_done.next; }
	ip_repl_layout_strs(s);
	repl_strs_done = strlist_tail;

	repl_unit.funcs = all_funcs;
	repl_unit.globals = global_vars;
	repl_unit.strs = strlist_head;
	repl_unit.nstrs = nstrs;
	ip_unit = repl_unit;
}

fn repl_run_source(src str, name str, path_a bool) {
	var file int = diag_add_file(name, src);
	var toks *Token = lex(src, (file as i64) << FILE_SHIFT);
	if (path_a) {
		cur_func = null;
		type_set_fn(null);
		parse(toks);
		cur_func = repl_fn;
		type_set_fn(repl_fn);
		repl_sync();
		return;
	}
	var t *Token = toks;
	resolve_comptime(&t);
	while (t.kind != TK_EOF) {
		var n *Node = parse_stmt(&t);
		while (n as i64 != 0) {
			add_type(n);
			repl_sync();
			ip_stmt(n);
			n = n.next;
		}
		resolve_comptime(&t);
	}
}

fn repl_process(src str, name str, path_a bool) {
	var pid i64 = sys_fork();
	if (pid == 0) {
		var devnull i64 = sys_open_append(cstr("/dev/null"));
		sys_dup2(devnull, STDOUT);
		repl_run_source(src, name, path_a);
		sys_exit(0);
	}
	var status [1]i64;
	sys_wait4(pid, &status[0] as *u8);
	if (((status[0] >> 8) & 255) != 0 || (status[0] & 127) != 0) { return; }
	repl_run_source(src, name, path_a);
}

fn repl_hidden_name(s str) bool {
	return s.len == 0 || (s.len >= 2 && s.ptr[0] == '_' && s.ptr[1] == '$');
}

fn repl_print_vars() {
	var v *Var = repl_fn.locals;
	var any bool = false;
	while (v as i64 != 0) {
		if (!repl_hidden_name(v.name)) {
			var newer *Var = repl_fn.locals;
			var shadowed bool = false;
			while (newer as i64 != 0 && newer as i64 != v as i64) {
				if (str_eq(newer.name, v.name)) { shadowed = true; break; }
				newer = newer.next;
			}
			if (!shadowed) {
				write_str(STDOUT, v.name);
				write_str(STDOUT, ": ");
				write_str(STDOUT, type_name(v.ty));
				write_str(STDOUT, "\n");
				any = true;
			}
		}
		v = v.next;
	}
	if (!any) { write_str(STDOUT, "(no locals)\n"); }
}

fn repl_print_funcs() {
	var f *Func = all_funcs;
	if (repl_bootstrap_funcs as i64 != 0) { f = repl_bootstrap_funcs.next; }
	var any bool = false;
	while (f as i64 != 0) {
		if (!repl_hidden_name(f.name)) {
			write_str(STDOUT, f.name);
			write_str(STDOUT, "\n");
			any = true;
		}
		f = f.next;
	}
	if (!any) { write_str(STDOUT, "(no functions)\n"); }
}

fn repl_print_type(expr str) {
	if (repl_blank(expr)) { write_str(STDOUT, "usage: :type <expr>\n"); return; }
	var pid i64 = sys_fork();
	if (pid == 0) {
		var file int = diag_add_file("<repl :type>", expr);
		var t *Token = lex(expr, (file as i64) << FILE_SHIFT);
		var n *Node = parse_assign(&t);
		add_type(n);
		write_str(STDOUT, type_name(n.ty));
		write_str(STDOUT, "\n");
		sys_exit(0);
	}
	var status [1]i64;
	sys_wait4(pid, &status[0] as *u8);
}

fn repl_print_help() {
	write_str(STDOUT, "qela repl commands:\n  :help, :h        this text\n  :quit, :q, :exit exit the session\n  :reset           discard all session state and start over\n  :clear           clear the terminal (session state untouched)\n  :vars            list declared locals and their types\n  :funcs           list functions defined this session\n  :type <expr>     print an expression's type without running it\n\na line starting with fn/struct/enum/import/macro/extern declares a name\nfor the rest of the session; var/let bind a local that survives to later\nlines (retyping the same name rebinds it); anything else runs as a\nstatement, and a bare expression prints its value.\n");
}

fn repl_command(line str) {
	var rest str;
	var cmd str = repl_colon_word(line, &rest);
	if (str_eq(cmd, "help") || str_eq(cmd, "h")) { repl_print_help(); return; }
	if (str_eq(cmd, "quit") || str_eq(cmd, "q") || str_eq(cmd, "exit")) { sys_exit(0); }
	if (str_eq(cmd, "reset")) { repl_init(); write_str(STDOUT, "session reset\n"); return; }
	if (str_eq(cmd, "clear")) {
		var b Buf;
		buf_u8(&b, 27);
		fmt_str(&b, "[2J");
		buf_u8(&b, 27);
		fmt_str(&b, "[H");
		write_str(STDOUT, buf_str(&b));
		return;
	}
	if (str_eq(cmd, "vars")) { repl_print_vars(); return; }
	if (str_eq(cmd, "funcs")) { repl_print_funcs(); return; }
	if (str_eq(cmd, "type")) { repl_print_type(rest); return; }
	write_str(STDOUT, "unknown command '");
	write_str(STDOUT, cmd);
	write_str(STDOUT, "', try :help\n");
}

fn repl_init() {
	ip_reset();
	reset_compile();
	opt_interp = true;
	comptime_set("INTERP", "1");
	diag_setup();
	cur_func = null;
	type_set_fn(null);
	enter_scope();

	var boot str = "import \"std/io.qela\";\nimport \"std/fmt.qela\";\nimport \"std/rand.qela\";\n";
	var file int = diag_add_file("<repl bootstrap>", boot);
	set_module_dir("<repl>");
	parse(lex(boot, (file as i64) << FILE_SHIFT));
	repl_bootstrap_funcs = funcs_tail;

	repl_off = 0;
	repl_locals_done = null;
	repl_globals_done = null;
	repl_strs_done = null;
	repl_unit = arena_alloc(sizeof(Unit), 8) as *Unit;

	type_init();
	repl_fn = arena_alloc(sizeof(Func), 8) as *Func;
	repl_fn.name = "<repl>";
	// i64, not void: the repl frame is where a `return` in an eval'd line
	// or a parse_ast sequence lands (ip_ret carries its value), and the
	// value channel is the `__abi_result` i64 either way.
	repl_fn.ret = ty_i64;
	repl_fn.stack_size = REPL_FRAME_SIZE as int;

	var d i64 = sys_mmap_anon(REPL_DATA_SIZE);
	if (d < 0 && d > -4096) { die("error: interpreter cannot map the data segment"); }
	ip_data = d;
	ip_data_end = d + REPL_DATA_SIZE;

	var s i64 = sys_mmap_anon(IP_STACK);
	if (s < 0 && s > -4096) { die("error: interpreter cannot map the frame stack"); }
	ip_stack_lo = s;
	ip_sp = s + IP_STACK;
	ip_defers = arena_alloc(IP_MAX_DEFERS * 8, 8) as **Node;
	ip_cur = 0;
	ip_coro[0].live = true;
	ip_coro[0].flo = s;
	ip_coro[0].fhi = s + IP_STACK;
	if (!ip_dispatch_ready) { ip_dispatch_init(); }

	repl_sync();

	ip_fp = ip_enter(repl_fn);
	ip_fn = repl_fn;
	ip_retdst = 0;
	ip_returning = false;
	ip_broke = false;
	ip_continued = false;

	cur_func = repl_fn;
	type_set_fn(repl_fn);
}

fn cmd_repl(_argc int, _argv **u8) int {
	repl_init();
	var tty bool = sys_isatty() == 0;
	if (tty) {
		write_str(STDOUT, "qela ");
		write_str(STDOUT, qela_version());
		write_str(STDOUT, " repl: statements and expressions, state kept across lines; :help for commands, Ctrl-D to quit\n");
	}
	while (true) {
		if (tty) { write_str(STDOUT, "qela> "); }
		var line str = read_line();
		if (line.len == 0) { return 0; }
		if (line.ptr[line.len - 1] == '\n') { line.len = line.len - 1; }

		var buf Buf;
		fmt_str(&buf, line);
		var depth i64 = repl_depth_delta(line);
		var eof bool = false;
		while (depth > 0) {
			if (tty) { write_str(STDOUT, "  ... "); }
			var more str = read_line();
			if (more.len == 0) { eof = true; break; }
			if (more.ptr[more.len - 1] == '\n') { more.len = more.len - 1; }
			buf_u8(&buf, '\n');
			fmt_str(&buf, more);
			depth = depth + repl_depth_delta(more);
		}
		var full str = buf_str(&buf);
		if (repl_blank(full)) { if (eof) { return 0; } continue; }

		if (full.ptr[0] == ':') {
			repl_command(full);
			if (eof) { return 0; }
			continue;
		}

		repl_line_seq = repl_line_seq + 1;
		var nameb Buf;
		fmt_str(&nameb, "<repl:");
		fmt_i64(&nameb, repl_line_seq as i64);
		buf_u8(&nameb, '>');
		var name str = buf_str(&nameb);

		var cls int = repl_classify(full);
		if (cls == REPL_PATH_EXPR) {
			repl_process(repl_wrap_expr(full), name, false);
		} else {
			if (cls == REPL_PATH_STMT) { repl_maybe_unshadow(full, repl_leading_word(full)); }
			var srcb Buf;
			fmt_str(&srcb, full);
			buf_u8(&srcb, '\n');
			repl_process(buf_str(&srcb), name, cls == REPL_PATH_A);
		}
		if (eof) { return 0; }
	}
}

let ABI_REQ_RUN = 1;
let ABI_REQ_CALL = 2;
let ABI_REQ_JIT = 6;
let ABI_REQ_PARSE = 7;
let ABI_REQ_RUN_AST = 8;
let ABI_REQ_AST_INFO = 9;
let ABI_REQ_AST_CHILD = 10;
let ABI_REQ_AST_NEXT = 11;
let ABI_REQ_AST_SET = 12;
let ABI_REQ_TARGET = 13;
let ABI_RESP_OK = 1;

struct AstEntry;
struct AstEntry {
	id   i64,
	node *Node,
	next *AstEntry,
}
var ast_table *AstEntry = null;
var ast_next_id i64 = 1;

fn ast_store(node *Node) i64 {
	var e *AstEntry = arena_alloc(sizeof(AstEntry), 8) as *AstEntry;
	e.id = ast_next_id;
	ast_next_id = ast_next_id + 1;
	e.node = node;
	e.next = ast_table;
	ast_table = e;
	return e.id;
}

fn ast_find(id i64) *Node {
	var e *AstEntry = ast_table;
	while (e as i64 != 0) {
		if (e.id == id) { return e.node; }
		e = e.next;
	}
	return null;
}

// ── marshalled calls ──
//
// A marshalled-signature call (any str/float/struct/array parameter or
// return) arrives as a type-directed byte payload. Each parameter is
// decoded into a hidden global (`__mm<seq>_<i>`, declared on the first
// call and cached per function), and the argument nodes are plain ND_VAR
// references to those slots -- the callee's frame copy then works exactly
// as it does for any other interpreted call. The return value is
// marshalled back from the call's destination slot.

struct Marshalled;
struct Marshalled {
	next  *Marshalled,
	fname str,
	n     int,
	vars  [14]*Var,
}
var marshalled_cache *Marshalled = null;
var marshalled_seq i64 = 0;

fn abi_find_global(name str) *Var {
	var v *Var = global_vars;
	while (v as i64 != 0) {
		if (str_eq(v.name, name)) { return v; }
		v = v.next;
	}
	return null;
}

fn abi_declare_global(name str, ty *Type) *Var {
	var saved *Func = cur_func;
	cur_func = null;
	type_set_fn(null);
	var v *Var = declare_var(name, ty, 0);
	cur_func = saved;
	type_set_fn(saved);
	repl_sync();
	return v;
}

fn abi_marshalled_get(f *Func) *Marshalled {
	var m *Marshalled = marshalled_cache;
	while (m as i64 != 0) {
		if (str_eq(m.fname, f.name)) { return m; }
		m = m.next;
	}
	var prefixb Buf;
	fmt_str(&prefixb, "__mm");
	fmt_i64(&prefixb, marshalled_seq as i64);
	fmt_str(&prefixb, "_");
	var prefix str = buf_str(&prefixb);
	marshalled_seq = marshalled_seq + 1;
	var m2 *Marshalled = arena_alloc(sizeof(Marshalled), 8) as *Marshalled;
	m2.fname = f.name;
	m2.n = f.nparams;
	var i int = 0;
	while (i < f.nparams) {
		var nb Buf;
		fmt_str(&nb, prefix);
		fmt_i64(&nb, i as i64);
		m2.vars[i] = abi_declare_global(buf_str(&nb), func_param(f, i).ty);
		i = i + 1;
	}
	m2.next = marshalled_cache;
	marshalled_cache = m2;
	return m2;
}

fn abi_build_var_args(mv *Marshalled, n int) *Node {
	var head Node;
	var tail *Node = &head;
	var i int = 0;
	while (i < n) {
		var nd *Node = node_alloc();
		nd.kind = ND_VAR;
		nd.varp = mv.vars[i];
		nd.ty = nd.varp.ty;
		tail.next = nd;
		tail = nd;
		i = i + 1;
	}
	return head.next;
}

// Decodes one value from the wire into `addr`, returning the new cursor.
// The layout is the mirror of what interp_gen_marshal emits on the host:
// scalars as 8-byte slots, strs length-prefixed, POD aggregates as raw
// images, everything else field by field in member order.
fn abi_try_call_nodes(f *Func, arghead *Node) bool {
	var pid i64 = sys_fork();
	if (pid == 0) {
		var devnull i64 = sys_open_append(cstr("/dev/null"));
		sys_dup2(devnull, STDOUT);
		ip_abi_validating = true;
		ip_call(f, arghead, 0, f.pos);
		sys_exit(0);
	}
	var status [1]i64;
	sys_wait4(pid, &status[0] as *u8);
	return ((status[0] >> 8) & 255) == 0 && (status[0] & 127) == 0;
}

fn abi_marshalled_call(f *Func, vp *u8) {
	var mv *Marshalled = abi_marshalled_get(f);
	var cur *u8 = vp;
	var i int = 0;
	while (i < f.nparams) {
		var pv *Var = func_param(f, i);
		cur = abi_unmarshal_value(cur, ip_var_addr(mv.vars[i]), pv.ty);
		i = i + 1;
	}
	var nodes *Node = abi_build_var_args(mv, f.nparams);
	if (!abi_try_call_nodes(f, nodes)) {
		var msg str = "interpreted: runtime error";
		abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
		return;
	}
	var dst i64 = 0;
	if (is_aggregate(f.ret)) { dst = ip_temp(f.ret.size as i64); }
	var rv i64 = ip_call(f, nodes, dst, f.pos);
	var rb Buf;
	if (is_aggregate(f.ret)) { abi_marshal_value(&rb, dst, f.ret); }
	else { buf_u64(&rb, rv); }
	abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_OK as u8, rb.p, rb.n);
}

// ── ast inspection ──

// The kind of a node as a name, for the host's ast_info. The order here
// does not matter; the mapping is one branch per ND_* constant.
fn ast_kind_name(kind int) str {
	if (kind == ND_NUM) { return "num"; }
	if (kind == ND_STRLIT) { return "strlit"; }
	if (kind == ND_VAR) { return "var"; }
	if (kind == ND_CALL) { return "call"; }
	if (kind == ND_SYSCALL) { return "syscall"; }
	if (kind == ND_ADDR) { return "addr"; }
	if (kind == ND_DEREF) { return "deref"; }
	if (kind == ND_MEMBER) { return "member"; }
	if (kind == ND_INDEX) { return "index"; }
	if (kind == ND_SLICE) { return "slice"; }
	if (kind == ND_ENUMLIT) { return "enumlit"; }
	if (kind == ND_STRUCTLIT) { return "structlit"; }
	if (kind == ND_FIELD) { return "field"; }
	if (kind == ND_MATCH) { return "match"; }
	if (kind == ND_ARM) { return "arm"; }
	if (kind == ND_DEFER) { return "defer"; }
	if (kind == ND_CAST) { return "cast"; }
	if (kind == ND_ADD) { return "add"; }
	if (kind == ND_SUB) { return "sub"; }
	if (kind == ND_MUL) { return "mul"; }
	if (kind == ND_DIV) { return "div"; }
	if (kind == ND_MOD) { return "mod"; }
	if (kind == ND_NEG) { return "neg"; }
	if (kind == ND_NOT) { return "not"; }
	if (kind == ND_BITAND) { return "bitand"; }
	if (kind == ND_BITOR) { return "bitor"; }
	if (kind == ND_BITXOR) { return "bitxor"; }
	if (kind == ND_BITNOT) { return "bitnot"; }
	if (kind == ND_SHL) { return "shl"; }
	if (kind == ND_SHR) { return "shr"; }
	if (kind == ND_EQ) { return "eq"; }
	if (kind == ND_NE) { return "ne"; }
	if (kind == ND_LT) { return "lt"; }
	if (kind == ND_LE) { return "le"; }
	if (kind == ND_AND) { return "and"; }
	if (kind == ND_OR) { return "or"; }
	if (kind == ND_ASSIGN) { return "assign"; }
	if (kind == ND_OPASSIGN) { return "opassign"; }
	if (kind == ND_COMMA) { return "comma"; }
	if (kind == ND_IF) { return "if"; }
	if (kind == ND_FOR) { return "for"; }
	if (kind == ND_BREAK) { return "break"; }
	if (kind == ND_CONT) { return "cont"; }
	if (kind == ND_RET) { return "ret"; }
	if (kind == ND_BLOCK) { return "block"; }
	if (kind == ND_EXPRSTMT) { return "exprstmt"; }
	if (kind == ND_COMPTIME) { return "comptime"; }
	if (kind == ND_TYPEEXPR) { return "typeexpr"; }
	if (kind == ND_SIZEOF) { return "sizeof"; }
	if (kind == ND_ZERO) { return "zero"; }
	if (kind == ND_FUNCADDR) { return "funcaddr"; }
	if (kind == ND_ASM) { return "asm"; }
	if (kind == ND_ASSERT) { return "assert"; }
	if (kind == ND_INTERP) { return "interp"; }
	if (kind == ND_STRPART) { return "strpart"; }
	if (kind == ND_ASMREF) { return "asmref"; }
	if (kind == ND_ASMLE) { return "asmle"; }
	return "?";
}

// The i-th child of `n` in a fixed order: lhs, rhs, cond, then, els,
// init, step, body, then the call arguments. 0 for none. The same walk
// with a write replaces a child, so index i means the same node in both.
fn ast_child_at(n *Node, i i64) *Node {
	var slots [8]*Node;
	slots[0] = n.lhs;
	slots[1] = n.rhs;
	slots[2] = n.cond;
	slots[3] = n.then;
	slots[4] = n.els;
	slots[5] = n.init;
	slots[6] = n.step;
	slots[7] = n.body;
	var idx i64 = 0;
	var k int = 0;
	while (k < 8) {
		if (slots[k] as i64 != 0) {
			if (idx == i) { return slots[k]; }
			idx = idx + 1;
		}
		k = k + 1;
	}
	var a *Node = n.args;
	while (a as i64 != 0) {
		if (idx == i) { return a; }
		idx = idx + 1;
		a = a.next;
	}
	return null;
}

fn ast_count(n *Node) i64 {
	var c i64 = 0;
	var k int = 0;
	var s *Node = n.lhs;
	while (k < 8) {
		if (s as i64 != 0) { c = c + 1; }
		k = k + 1;
		if (k == 1) { s = n.rhs; }
		else if (k == 2) { s = n.cond; }
		else if (k == 3) { s = n.then; }
		else if (k == 4) { s = n.els; }
		else if (k == 5) { s = n.init; }
		else if (k == 6) { s = n.step; }
		else if (k == 7) { s = n.body; }
	}
	var a *Node = n.args;
	while (a as i64 != 0) { c = c + 1; a = a.next; }
	return c;
}

// Replaces the i-th child of `n` with `c`, whose type must match the
// replaced node's (identity, so both must come from this child's own
// compile). The statement chain is left alone; the replacement must be a
// single node, not a chain.
fn ast_replace_child(n *Node, i i64, c *Node) bool {
	var slots [8]*Node;
	slots[0] = n.lhs;
	slots[1] = n.rhs;
	slots[2] = n.cond;
	slots[3] = n.then;
	slots[4] = n.els;
	slots[5] = n.init;
	slots[6] = n.step;
	slots[7] = n.body;
	var idx i64 = 0;
	var k int = 0;
	while (k < 8) {
		if (slots[k] as i64 != 0) {
			if (idx == i) {
				if (!same_type(slots[k].ty, c.ty)) { return false; }
				if (k == 0) { n.lhs = c; }
				else if (k == 1) { n.rhs = c; }
				else if (k == 2) { n.cond = c; }
				else if (k == 3) { n.then = c; }
				else if (k == 4) { n.els = c; }
				else if (k == 5) { n.init = c; }
				else if (k == 6) { n.step = c; }
				else { n.body = c; }
				return true;
			}
			idx = idx + 1;
		}
		k = k + 1;
	}
	var prev *Node = null;
	var a *Node = n.args;
	while (a as i64 != 0) {
		if (idx == i) {
			if (!same_type(a.ty, c.ty)) { return false; }
			if (prev as i64 == 0) { n.args = c; }
			else { prev.next = c; }
			c.next = a.next;
			return true;
		}
		idx = idx + 1;
		prev = a;
		a = a.next;
	}
	return false;
}

// ── jit signature rewrite ──
//
// A marshalled-signature `dynamic` function cannot be called through the
// host's scalar function-pointer shape, so the jit request compiles a
// rewritten version: a hidden `___dynret *u8` out-parameter is appended to the
// signature, the return type becomes i64, and every `return <expr>;` in
// the body becomes `*(___dynret as *<ret>) = <expr>; return 0;`. The result is
// a self-contained scalar function the host can call with packed words.
// The rewrite is token-level: string contents and comments are invisible,
// and a lambda body's returns belong to the lambda, so lambda bodies are
// copied whole. Any failure degrades to the interpreted path -- the
// isolated fork re-parses the output, and a parse error fails the whole
// request rather than shipping a wrong answer.

fn jit_identish(c u8) bool {
	if (c >= 'a' && c <= 'z') { return true; }
	if (c >= 'A' && c <= 'Z') { return true; }
	if (c >= '0' && c <= '9') { return true; }
	return c == '_' || c == '$';
}

// The last emitted character and the function name being rewritten. The
// rewrite helpers share them instead of carrying them as parameters (the
// bootstrap subset caps a function at six parameters).
var jit_last u8 = 0;
var jit_self_name str;

fn jit_emit(b *Buf, t *Token) {
	if (jit_last != 0 && jit_identish(jit_last) && jit_identish(t.text.ptr[0])) {
		buf_u8(b, ' ');
	}
	buf_bytes(b, t.text.ptr, t.text.len);
	jit_last = t.text.ptr[t.text.len - 1];
}

fn jit_punct(t *Token, s str) bool {
	return t.kind == TK_PUNCT && str_eq(t.text, s);
}

// Is the `fn` token at `t` a lambda (it has a body) rather than a function
// type? Scan the parameter list, then the return type: a `{` at depth 0
// means the body, hence a lambda; a statement/declaration-ending punct
// means a bare function type.
fn jit_is_lambda(t *Token) bool {
	var j *Token = t.next;
	if (j as i64 == 0 || j.kind != TK_PUNCT || !str_eq(j.text, "(")) { return false; }
	var depth i64 = 1;
	j = j.next;
	while (j as i64 != 0 && depth > 0) {
		if (j.kind == TK_PUNCT) {
			if (str_eq(j.text, "(")) { depth = depth + 1; }
			else if (str_eq(j.text, ")")) { depth = depth - 1; }
		}
		j = j.next;
	}
	depth = 0;
	while (j as i64 != 0) {
		if (j.kind == TK_PUNCT) {
			if (str_eq(j.text, "(") || str_eq(j.text, "[")) { depth = depth + 1; }
			else if (str_eq(j.text, ")") || str_eq(j.text, "]")) { depth = depth - 1; }
			else if (depth == 0) {
				if (str_eq(j.text, "{")) { return true; }
				if (str_eq(j.text, ";") || str_eq(j.text, ",") || str_eq(j.text, "=")) { return false; }
			}
		}
		j = j.next;
	}
	return false;
}

// The matching `)` of the call that starts at `t` (t = `name`, t.next is
// the `(`). Returned, not skipped past, so callers copy the arguments as
// everything strictly inside it.
fn jit_skip_call(t *Token) *Token {
	var depth i64 = 1;
	var j *Token = t.next.next;
	while (j as i64 != 0 && depth > 0) {
		if (j.kind == TK_PUNCT) {
			if (str_eq(j.text, "(")) { depth = depth + 1; }
			else if (str_eq(j.text, ")")) { depth = depth - 1; }
		}
		if (depth > 0) { j = j.next; }
	}
	return j;
}

// The closing `}` of the lambda that starts at `t`, copying its tokens
// verbatim on the way (returns included: a lambda has its own return
// convention, untouched by the rewrite).
fn jit_copy_lambda(b *Buf, t *Token) *Token {
	var in_body bool = false;
	var bd i64 = 0;
	while (t.kind != TK_EOF) {
		jit_emit(b, t);
		if (jit_punct(t, "{")) {
			if (!in_body) { in_body = true; }
			bd = bd + 1;
		} else if (jit_punct(t, "}")) {
			bd = bd - 1;
			if (in_body && bd == 0) { return t; }
		}
		t = t.next;
	}
	return t;
}

// The closing `}` of the lambda that starts at `t`, without emitting.
fn jit_skip_lambda(t *Token) *Token {
	var in_body bool = false;
	var bd i64 = 0;
	while (t.kind != TK_EOF) {
		if (jit_punct(t, "{")) {
			if (!in_body) { in_body = true; }
			bd = bd + 1;
		} else if (jit_punct(t, "}")) {
			bd = bd - 1;
			if (in_body && bd == 0) { return t; }
		}
		t = t.next;
	}
	return t;
}

// Counts the self-calls between `start` (inclusive) and `end` (exclusive).
fn jit_count_selfcalls(start *Token, end *Token, name str) i64 {
	var n i64 = 0;
	var t *Token = start;
	while (t as i64 != 0 && t != end) {
		if (t.kind == TK_KW && str_eq(t.text, "fn") && jit_is_lambda(t)) { t = jit_skip_lambda(t); }
		else if (t.kind == TK_IDENT && str_eq(t.text, name) && jit_punct(t.next, "(")) { n = n + 1; }
		t = t.next;
	}
	return n;
}

// Counts every temp the emit pass will need over the whole body.
fn jit_count_all(t *Token, name str, ret *Type) i64 {
	var n i64 = 0;
	var s *Token = t;
	while (s.kind != TK_EOF) {
		if (s.kind == TK_KW && str_eq(s.text, "fn") && jit_is_lambda(s)) {
			s = jit_skip_lambda(s);
		} else if (s.kind == TK_KW && str_eq(s.text, "return") && ret.kind != TY_VOID) {
			var depth i64 = 0;
			var j *Token = s.next;
			while (j as i64 != 0 && !(depth == 0 && jit_punct(j, ";"))) {
				if (j.kind == TK_PUNCT) {
					if (str_eq(j.text, "(") || str_eq(j.text, "[") || str_eq(j.text, "{")) { depth = depth + 1; }
					else if (str_eq(j.text, ")") || str_eq(j.text, "]") || str_eq(j.text, "}")) { depth = depth - 1; }
				}
				j = j.next;
			}
			var first *Token = s.next;
			if (first.kind == TK_IDENT && str_eq(first.text, name) && jit_punct(first.next, "(") &&
			    jit_skip_call(first).next == j) {
				// a bare tail self-call takes no temp; its arguments may
				n = n + jit_count_selfcalls(first.next.next, j, name);
			} else {
				n = n + jit_count_selfcalls(first, j, name);
			}
			s = j.next;
		} else {
			s = s.next;
		}
	}
	return n;
}

// Copies tokens from `start` (inclusive) to `end` (exclusive), rewriting
// every self-call into the temp form.
fn jit_copy_expr(b *Buf, start *Token, end *Token, ret *Type, tempno *i64) {
	var t *Token = start;
	while (t as i64 != 0 && t != end) {
		if (t.kind == TK_KW && str_eq(t.text, "fn") && jit_is_lambda(t)) {
			t = jit_copy_lambda(b, t);
		} else if (t.kind == TK_IDENT && str_eq(t.text, jit_self_name) && jit_punct(t.next, "(")) {
			t = jit_rewrite_selfcall(b, t, ret, tempno, false);
		} else {
			jit_emit(b, t);
		}
		t = t.next;
	}
}

// Rewrites one self-call. tail: the call's value is the enclosing return's
// value, so the callee writes into our own out-parameter and no store or
// temp is needed; non-tail, the value comes back through a fresh temp
// slot of the return type: (name(args, &_rN as *u8), _rN). Returns the
// call's closing `)`.
fn jit_rewrite_selfcall(b *Buf, t *Token, ret *Type, tempno *i64, tail bool) *Token {
	var rparen *Token = jit_skip_call(t);
	var tn i64 = 0;
	if (!tail) {
		tn = *tempno;
		*tempno = tn + 1;
		fmt_str(b, " (");
		jit_last = ' ';
	}
	jit_emit(b, t);
	jit_emit(b, t.next);
	jit_copy_expr(b, t.next.next, rparen, ret, tempno);
	if (!tail) {
		fmt_str(b, ", &_r");
		fmt_i64(b, tn);
		fmt_str(b, " as *u8), _r");
		fmt_i64(b, tn);
		fmt_str(b, ")");
	} else {
		fmt_str(b, ", ___dynret)");
	}
	jit_last = ')';
	return rparen;
}

// Rewrites the returns of `body` (which includes its own braces) and every
// self-call inside it. A call to the function itself would hit the
// rewritten signature (the hidden out-parameter) and fail the isolated
// compile, so it is rewritten along with the returns: a tail call passes
// the out-parameter on directly, any other call goes through a fresh
// per-site temp. A void return type needs no rewrite -- there is no value
// to carry.
fn abi_jit_rewrite(body str, name str, ret *Type) str {
	var t *Token = lex(body, 0);
	var b Buf;
	jit_last = 0;
	jit_self_name = name;

	// Count the temps first: a `var` cannot appear mid-expression, so the
	// declarations are injected right after the opening brace. The count
	// and the emit pass share the same rules, so every temp is declared
	// exactly once and used exactly once.
	var temps i64 = jit_count_all(t, name, ret);
	if (temps > 0) {
		jit_emit(&b, t);
		var k i64 = 0;
		while (k < temps) {
			fmt_str(&b, " var _r");
			fmt_i64(&b, k);
			fmt_str(&b, " ");
			fmt_str(&b, type_name(ret));
			fmt_str(&b, ";");
			k = k + 1;
		}
		jit_last = ';';
		t = t.next;
	}
	var tempno i64 = 0;
	while (t.kind != TK_EOF) {
		if (t.kind == TK_KW && str_eq(t.text, "fn") && jit_is_lambda(t)) {
			// a self-call inside a lambda stays a plain call: the lambda
			// cannot see the body's temps (no closures), so the isolated
			// compile rejects it and the interpreted fallback takes over
			t = jit_copy_lambda(&b, t);
			t = t.next;
			continue;
		}
		if (t.kind == TK_KW && str_eq(t.text, "return") && ret.kind != TY_VOID) {
			var depth i64 = 0;
			var j *Token = t.next;
			while (j as i64 != 0 && !(depth == 0 && jit_punct(j, ";"))) {
				if (j.kind == TK_PUNCT) {
					if (str_eq(j.text, "(") || str_eq(j.text, "[") || str_eq(j.text, "{")) { depth = depth + 1; }
					else if (str_eq(j.text, ")") || str_eq(j.text, "]") || str_eq(j.text, "}")) { depth = depth - 1; }
				}
				j = j.next;
			}
			var first *Token = t.next;
			if (first.kind == TK_IDENT && str_eq(first.text, name) && jit_punct(first.next, "(") &&
			    jit_skip_call(first).next == j) {
				jit_rewrite_selfcall(&b, first, ret, &tempno, true);
			} else {
				fmt_str(&b, "*(___dynret as *");
				fmt_str(&b, type_name(ret));
				fmt_str(&b, ") = ");
				jit_last = ' ';
				jit_copy_expr(&b, first, j, ret, &tempno);
			}
			fmt_str(&b, "; return 0; ");
			jit_last = ' ';
			t = j.next;
			continue;
		}
		if (t.kind == TK_IDENT && str_eq(t.text, name) && jit_punct(t.next, "(")) {
			t = jit_rewrite_selfcall(&b, t, ret, &tempno, false);
			t = t.next;
			continue;
		}
		jit_emit(&b, t);
		t = t.next;
	}
	return buf_str(&b);
}

// The registration bundle carries every type the host program defined,
// including std types the child's own repl bootstrap already parsed (the
// child imports std/io, fmt and rand at startup) and std types the child
// will parse itself when the bundle's trampoline synthesis splices in
// std/interpcall.qela and its imports. Redefining those would error, so
// the first request -- which is always the bundle, sent right after the
// pipes come up -- drops declarations whose name already resolves or is
// known to come from the interp support chain. A later eval() line
// declaring the same name still errors normally.
struct StrNode;
struct StrNode { next *StrNode, s str, }
var abi_chain_types *StrNode = null;

fn abi_chain_has(name str) bool {
	var s *StrNode = abi_chain_types;
	while (s as i64 != 0) {
		if (str_eq(s.s, name)) { return true; }
		s = s.next;
	}
	return false;
}

fn abi_chain_collect(path str, depth i64) {
	if (depth > 8) { return; }
	var bi int = blob_find(path);
	if (bi < 0) { return; }
	var src str = std_blob_src(bi);
	var t *Token = lex(src, 0);
	while (t.kind != TK_EOF) {
		if ((t.kind == TK_KW && str_eq(t.text, "struct")) ||
		    (t.kind == TK_KW && str_eq(t.text, "enum"))) {
			var nxt *Token = t.next;
			if (nxt as i64 != 0 && nxt.kind == TK_IDENT && !abi_chain_has(nxt.text)) {
				var sn *StrNode = arena_alloc(sizeof(StrNode), 8) as *StrNode;
				sn.s = str_dup(nxt.text);
				sn.next = abi_chain_types;
				abi_chain_types = sn;
			}
		} else if (t.kind == TK_KW && str_eq(t.text, "import")) {
			var j *Token = t.next;
			if (j as i64 != 0 && j.kind == TK_STR && j.sval.len > 0 &&
			    j.sval.ptr[0] != '/') {
				var pb Buf;
				fmt_str(&pb, "std/");
				fmt_str(&pb, j.sval);
				abi_chain_collect(buf_str(&pb), depth + 1);
			}
		}
		t = t.next;
	}
}

fn abi_bundle_dedup(src str) str {
	var t *Token = lex(src, 0);
	var b Buf;
	jit_last = 0;
	while (t.kind != TK_EOF) {
		if ((t.kind == TK_KW && str_eq(t.text, "struct")) ||
		    (t.kind == TK_KW && str_eq(t.text, "enum"))) {
			var nxt *Token = t.next;
			if (nxt as i64 != 0 && nxt.kind == TK_IDENT) {
				var dup bool = type_lookup(nxt.text) as i64 != 0;
				if (!dup) { dup = abi_chain_has(nxt.text); }
				if (dup) {
					var depth i64 = 0;
					t = t.next.next;
					while (t.kind != TK_EOF) {
						if (jit_punct(t, "{")) { depth = depth + 1; }
						else if (jit_punct(t, "}")) {
							depth = depth - 1;
							if (depth == 0) { t = t.next; break; }
						}
						t = t.next;
					}
					continue;
				}
			}
		}
		jit_emit(&b, t);
		t = t.next;
	}
	return buf_str(&b);
}

fn abi_try_parse_expr(src str, name str) bool {
	var pid i64 = sys_fork();
	if (pid == 0) {
		var devnull i64 = sys_open_append(cstr("/dev/null"));
		sys_dup2(devnull, STDOUT);
		var file2 int = diag_add_file(name, src);
		var t *Token = lex(src, (file2 as i64) << FILE_SHIFT);
		resolve_comptime(&t);
		var pn *Node = parse_stmt(&t);
		add_type(pn);
		sys_exit(0);
	}
	var status [1]i64;
	sys_wait4(pid, &status[0] as *u8);
	return ((status[0] >> 8) & 255) == 0 && (status[0] & 127) == 0;
}

fn abi_try_run_ast(node *Node) bool {
	var pid i64 = sys_fork();
	if (pid == 0) {
		var devnull i64 = sys_open_append(cstr("/dev/null"));
		sys_dup2(devnull, STDOUT);
		ip_abi_validating = true;
		var vn *Node = node;
		while (vn as i64 != 0) {
			ip_stmt(vn);
			vn = vn.next;
		}
		sys_exit(0);
	}
	var status [1]i64;
	sys_wait4(pid, &status[0] as *u8);
	return ((status[0] >> 8) & 255) == 0 && (status[0] & 127) == 0;
}

fn abi_build_call_args(vals *i64, n int) *Node {
	var head Node;
	var tail *Node = &head;
	var i int = 0;
	while (i < n) {
		var nd *Node = num_node(vals[i], 0);
		nd.ty = ty_i64;
		tail.next = nd;
		tail = nd;
		i = i + 1;
	}
	return head.next;
}

fn abi_try_call(f *Func, vals *i64, n int) bool {
	var pid i64 = sys_fork();
	if (pid == 0) {
		var devnull i64 = sys_open_append(cstr("/dev/null"));
		sys_dup2(devnull, STDOUT);
		ip_abi_validating = true;
		ip_call(f, abi_build_call_args(vals, n), 0, f.pos);
		sys_exit(0);
	}
	var status [1]i64;
	sys_wait4(pid, &status[0] as *u8);
	return ((status[0] >> 8) & 255) == 0 && (status[0] & 127) == 0;
}

fn abi_wrap_expr(src str) str {
	var b Buf;
	fmt_str(&b, "__abi_result = (");
	fmt_str(&b, repl_strip_trailing_semi(src));
	// The result channel is the `__abi_result` i64; a float expression
	// would fail the implicit assignment, so cast explicitly (int- and
	// pointer-typed expressions make the cast a no-op, a float truncates,
	// and anything unmarshallable stays a type error as before).
	fmt_str(&b, ") as i64;\n");
	return buf_str(&b);
}

// A top-level `;` anywhere in `src` (after the trailing one is stripped
// by the caller): a bare expression never contains one, so its presence
// means a statement sequence.
fn abi_has_stmt_semi(src str) bool {
	var t *Token = lex(src, 0);
	var depth i64 = 0;
	while (t.kind != TK_EOF) {
		if (jit_punct(t, "{")) { depth = depth + 1; }
		else if (jit_punct(t, "}")) { depth = depth - 1; }
		else if (depth == 0 && jit_punct(t, ";")) { return true; }
		t = t.next;
	}
	return false;
}

// The statement-sequence wrapper for parse_ast: reset the result channel
// first, then run the statements as they are. The value of the last
// expression statement is captured by the parse_ast handler itself (the
// AST-based `ast_take_tail_expr`), which rewires the parsed chain; a
// `return` in the sequence stops it, and run_ast takes its value instead.
fn abi_wrap_stmts(src str) str {
	var b Buf;
	fmt_str(&b, "__abi_result = 0;\n");
	fmt_str(&b, src);
	if (src.len > 0 && src.ptr[src.len - 1] != ';' && src.ptr[src.len - 1] != '}') {
		fmt_str(&b, ";");
	}
	fmt_str(&b, "\n");
	return buf_str(&b);
}

// Cuts the trailing expression statement out of a parsed statement chain
// and returns its expression: the value of a parse_ast sequence is the
// last expression statement's value. A chain ending in a bare block
// captures the block's own trailing expression statement; a chain ending
// in anything else (a control-flow statement, a `return`) contributes no
// capture and the chain keeps the `__abi_result = 0;` reset the wrapper
// prepended. The cut is real, not a copy: the expression is not run
// twice, so a trailing call's side effects happen once.
fn ast_take_tail_expr(head **Node) *Node {
	var prev *Node = null;
	var cur *Node = *head;
	if (cur as i64 == 0) { return null; }
	while (cur.next as i64 != 0) { prev = cur; cur = cur.next; }
	if (cur.kind == ND_EXPRSTMT) {
		var expr *Node = cur.lhs;
		if (prev as i64 == 0) { *head = null; }
		else { prev.next = null; }
		return expr;
	}
	if (cur.kind == ND_BLOCK && cur.body as i64 != 0) {
		var bprev *Node = null;
		var bcur *Node = cur.body;
		while (bcur.next as i64 != 0) { bprev = bcur; bcur = bcur.next; }
		if (bcur.kind == ND_EXPRSTMT) {
			var bexpr *Node = bcur.lhs;
			if (bprev as i64 == 0) { cur.body = null; }
			else { bprev.next = null; }
			return bexpr;
		}
	}
	return null;
}

fn abi_try_run(src str, name str, path_a bool) bool {
	var pid i64 = sys_fork();
	if (pid == 0) {
		var devnull i64 = sys_open_append(cstr("/dev/null"));
		sys_dup2(devnull, STDOUT);
		ip_abi_validating = true;
		repl_run_source(src, name, path_a);
		sys_exit(0);
	}
	var status [1]i64;
	sys_wait4(pid, &status[0] as *u8);
	return ((status[0] >> 8) & 255) == 0 && (status[0] & 127) == 0;
}

fn abi_handle_jit(f *Func) {
	var pid i64 = sys_fork();
	if (pid == 0) {
		var devnull i64 = sys_open_append(cstr("/dev/null"));
		sys_dup2(devnull, STDOUT);
		// A rejected jit attempt (the body calls a std function, reads a
		// global, ...) is a normal control-flow outcome, not a bug: the
		// reparse legitimately fails on names outside the isolated unit.
		// Its compile error would be pure noise on the user's terminal,
		// so stderr goes to /dev/null too -- the fallback to interpreted
		// is silent by design.
		sys_dup2(devnull, STDERR);
		type_abi_mode = false;

		var fid int = diag_file_of(f.pos);
		var fsrc str = diag_src_of(fid);
		var body_only str = str_slice(fsrc, diag_offset_of(f.body_start), diag_offset_of(f.src_end));

		var sigb Buf;
		// The fork reset the compile: only builtin types survive, so the
		// types the signature and body can mention have to come along,
		// exactly as they do in the registration bundle.
		interp_emit_types(&sigb);
		fmt_str(&sigb, "fn ");
		fmt_str(&sigb, f.name);
		fmt_str(&sigb, "(");
		var pi int = 0;
		while (pi < f.nparams) {
			if (pi > 0) { fmt_str(&sigb, ", "); }
			var pv *Var = func_param(f, pi);
			fmt_str(&sigb, pv.name);
			fmt_str(&sigb, " ");
			fmt_str(&sigb, type_name(pv.ty));
			pi = pi + 1;
		}
		var rewrite bool = false;
		if (interp_marshalled(f) && f.ret.kind != TY_VOID) {
			if (interp_jit_budget(f)) {
				rewrite = true;
				fmt_str(&sigb, ", ___dynret *u8) i64 ");
				fmt_str(&sigb, abi_jit_rewrite(body_only, f.name, f.ret));
			} else {
				var msg str = "dynamic: this signature is too wide for the jit call path (more than six register words)";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				sys_exit(0);
			}
		}
		if (!rewrite) {
			fmt_str(&sigb, ") ");
			if (f.ret.kind != TY_VOID) {
				fmt_str(&sigb, type_name(f.ret));
				fmt_str(&sigb, " ");
			}
			fmt_str(&sigb, body_only);
		}
		var body_src str = buf_str(&sigb);

		reset_compile();
		opt_object = true;
		var jfile int = diag_add_file("<jit>", body_src);
		var junit *Unit = parse(lex(body_src, (jfile as i64) << FILE_SHIFT));
		var img Image;
		codegen(junit, &img);

		// Self-contained means: no relocation at all, or nothing but calls
		// to the function itself. The host can patch those locally -- it
		// knows the unit's mapped address, so a self-call's rel32 is
		// -(slot + 4) -- no second round trip. Everything else (a call to
		// another function, a global, a string literal) is a clean
		// rejection and the interpreted fallback.
		var ok bool = true;
		var slotb Buf;
		var nslots i64 = 0;
		var r *Reloc = img.relocs;
		while (r as i64 != 0) {
			if (r.kind == REL_PCREL32_PLT && r.name.len > 0 && str_eq(r.name, f.name)) {
				buf_u32(&slotb, r.at as u32);
				nslots = nslots + 1;
			} else {
				ok = false;
			}
			r = r.next;
		}
		if (!ok) {
			var msg str = "dynamic: not self-contained yet -- calls to other functions, globals and string literals inside a dynamic function are not supported by the jit path (see docs/INTERPRETED.md)";
			abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
			sys_exit(0);
		}
		// Payload: [u32 slot count][u32 slot offsets][code]. The host
		// patches each slot with the self-call's rel32 and calls the unit.
		var sendb Buf;
		buf_u32(&sendb, nslots);
		buf_bytes(&sendb, slotb.p, slotb.n);
		buf_bytes(&sendb, img.code.p, img.code.n);
		abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_OK as u8, sendb.p, sendb.n);
		sys_exit(0);
	}
	var status [1]i64;
	sys_wait4(pid, &status[0] as *u8);
	if (((status[0] >> 8) & 255) != 0 || (status[0] & 127) != 0) {
		var msg str = "dynamic: the compiler crashed while jit-compiling";
		abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
	}
}

fn cmd_abi_server(_argc int, _argv **u8) int {
	repl_init();
	type_abi_mode = true;
	abi_chain_collect("std/interpcall.qela", 0);
	repl_run_source("var __abi_result i64 = 0;\n", "<abi:init>", false);
	var result_var *Var = repl_fn.locals;

	var buf *u8 = arena_alloc(ABI_MAX_MSG, 8) as *u8;
	var seq int = 0;
	var abi_first_req bool = true;
	while (true) {
		var kind u8 = 0;
		var n i64 = abi_recv_frame(ABI_FD_HOST_TO_CHILD, &kind, buf, ABI_MAX_MSG);
		if (n < 0) { return 0; }

		if (kind == ABI_REQ_CALL as u8) {
			if (n < 1) { return 0; }
			var nlen i64 = buf[0] as i64;
			if (n < 1 + nlen) { return 0; }
			var fname str;
			fname.ptr = buf + 1;
			fname.len = nlen;
			fname = str_dup(fname);
			var f *Func = find_func(fname);
			if (f as i64 == 0) {
				var msg str = "interpreted: unknown function";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				continue;
			}
			var vp *u8 = buf + 1 + nlen;
			if (interp_marshalled(f)) {
				abi_marshalled_call(f, vp);
				continue;
			}
			if (n < 1 + nlen + 8 * f.nparams) { return 0; }
			var vals [14]i64;
			var vi int = 0;
			while (vi < f.nparams) {
				vals[vi] = abi_decode_u64(vp + vi * 8);
				vi = vi + 1;
			}
			if (!abi_try_call(f, &vals[0], f.nparams)) {
				var msg str = "interpreted: runtime error";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				continue;
			}
			var cval i64 = ip_call(f, abi_build_call_args(&vals[0], f.nparams), 0, f.pos);
			var cvb [8]u8;
			*(&cvb[0] as *i64) = cval;
			abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_OK as u8, &cvb[0], 8);
			continue;
		}
		if (kind == ABI_REQ_JIT as u8) {
			var jname str;
			jname.ptr = buf;
			jname.len = n;
			jname = str_dup(jname);
			var jf *Func = find_func(jname);
			if (jf as i64 == 0) {
				var msg str = "dynamic: unknown function";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				continue;
			}
			abi_handle_jit(jf);
			continue;
		}
		if (kind == ABI_REQ_PARSE as u8) {
			var araw str;
			araw.ptr = buf;
			araw.len = n;
			araw = str_dup(araw);
			var acls int = repl_classify(araw);
			// A sequence whose first statement is not a statement keyword
			// classifies as an expression; a top-level `;` after the
			// trailing one means there is more than one statement.
			if (acls == REPL_PATH_EXPR && abi_has_stmt_semi(repl_strip_trailing_semi(araw))) {
				acls = REPL_PATH_STMT;
			}
			if (acls != REPL_PATH_EXPR && acls != REPL_PATH_STMT) {
				var msg str = "parse_ast: only expressions and statements are supported (see docs/INTERPRETED.md)";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				continue;
			}
			var to_parse str;
			if (acls == REPL_PATH_EXPR) {
				to_parse = abi_wrap_expr(araw);
			} else {
				repl_maybe_unshadow(araw, repl_leading_word(araw));
				to_parse = abi_wrap_stmts(araw);
			}

			seq = seq + 1;
			var pnameb Buf;
			fmt_str(&pnameb, "<ast:");
			fmt_i64(&pnameb, seq as i64);
			buf_u8(&pnameb, '>');
			var pname str = buf_str(&pnameb);

			if (!abi_try_parse_expr(to_parse, pname)) {
				var msg str = "parse_ast: compile error";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				continue;
			}
			var afile int = diag_add_file(pname, to_parse);
			var at *Token = lex(to_parse, (afile as i64) << FILE_SHIFT);
			resolve_comptime(&at);
			var anode *Node = null;
			var atail *Node = null;
			while (at.kind != TK_EOF) {
				var sn *Node = parse_stmt(&at);
				while (sn as i64 != 0) {
					add_type(sn);
					if (atail as i64 == 0) { anode = sn; }
					else { atail.next = sn; }
					atail = sn;
					sn = sn.next;
				}
				resolve_comptime(&at);
			}
			// The value of a statement sequence is its last expression
			// statement, captured through the `__abi_result` channel; `as
			// i64` so a float tail truncates instead of failing the
			// assignment. The expression path wraps its own assignment
			// and skips this.
			if (acls == REPL_PATH_STMT) {
				var cap *Node = ast_take_tail_expr(&anode);
				if (cap as i64 != 0) {
					var tvn *Node = new_node(ND_VAR, 0);
					tvn.varp = result_var;
					var capasg *Node = bin_node(ND_ASSIGN, tvn, cap, 0);
					var capcast *Node = new_node(ND_CAST, 0);
					capcast.ty = ty_i64;
					capcast.lhs = capasg;
					add_type(capcast);
					if (anode as i64 == 0) { anode = capcast; }
					else {
						var tn *Node = anode;
						while (tn.next as i64 != 0) { tn = tn.next; }
						tn.next = capcast;
					}
				}
			}
			repl_sync();
			var hid i64 = ast_store(anode);
			var hb [8]u8;
			*(&hb[0] as *i64) = hid;
			abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_OK as u8, &hb[0], 8);
			continue;
		}
		if (kind == ABI_REQ_RUN_AST as u8) {
			if (n < 8) { return 0; }
			var hid2 i64 = abi_decode_u64(buf);
			var anode2 *Node = ast_find(hid2);
			if (anode2 as i64 == 0) {
				var msg str = "run_ast: unknown handle";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				continue;
			}
			// A run may stop at a `return`; the flags must not leak into
			// the validation fork or the next run, or every later
			// statement would silently skip itself.
			ip_returning = false;
			ip_broke = false;
			ip_continued = false;
			ip_ret = 0;
			if (!abi_try_run_ast(anode2)) {
				var msg str = "run_ast: runtime error";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				continue;
			}
			ip_returning = false;
			ip_broke = false;
			ip_continued = false;
			ip_ret = 0;
			var cn *Node = anode2;
			while (cn as i64 != 0) {
				ip_stmt(cn);
				cn = cn.next;
			}
			var rv i64 = ip_load(ip_var_addr(result_var), result_var.ty);
			if (ip_returning) { rv = ip_ret; }
			var rvb [8]u8;
			*(&rvb[0] as *i64) = rv;
			abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_OK as u8, &rvb[0], 8);
			continue;
		}
		if (kind == ABI_REQ_AST_INFO as u8) {
			if (n < 8) { return 0; }
			var anode *Node = ast_find(abi_decode_u64(buf));
			if (anode as i64 == 0) {
				var msg str = "ast_info: unknown handle";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				continue;
			}
			var kn str = ast_kind_name(anode.kind);
			var bb Buf;
			buf_u64(&bb, kn.len);
			buf_bytes(&bb, kn.ptr, kn.len);
			buf_u64(&bb, anode.val);
			buf_u64(&bb, ast_count(anode));
			abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_OK as u8, bb.p, bb.n);
			continue;
		}
		if (kind == ABI_REQ_AST_CHILD as u8) {
			if (n < 16) { return 0; }
			var cnode *Node = ast_find(abi_decode_u64(buf));
			var ci i64 = abi_decode_u64(buf + 8);
			if (cnode as i64 == 0) {
				var msg str = "ast_child: unknown handle";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				continue;
			}
			var ch *Node = ast_child_at(cnode, ci);
			var cb [8]u8;
			if (ch as i64 != 0) { *(&cb[0] as *i64) = ast_store(ch); }
			abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_OK as u8, &cb[0], 8);
			continue;
		}
		if (kind == ABI_REQ_AST_NEXT as u8) {
			if (n < 8) { return 0; }
			var nnode *Node = ast_find(abi_decode_u64(buf));
			if (nnode as i64 == 0) {
				var msg str = "ast_next: unknown handle";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				continue;
			}
			var nb [8]u8;
			if (nnode.next as i64 != 0) { *(&nb[0] as *i64) = ast_store(nnode.next); }
			abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_OK as u8, &nb[0], 8);
			continue;
		}
		if (kind == ABI_REQ_AST_SET as u8) {
			if (n < 24) { return 0; }
			var snode *Node = ast_find(abi_decode_u64(buf));
			var si i64 = abi_decode_u64(buf + 8);
			var sc *Node = ast_find(abi_decode_u64(buf + 16));
			if (snode as i64 == 0 || sc as i64 == 0) {
				var msg str = "ast_set: unknown handle";
				abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
				continue;
			}
			var okb [8]u8;
			if (ast_replace_child(snode, si, sc)) { *(&okb[0] as *i64) = 1; }
			abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_OK as u8, &okb[0], 8);
			continue;
		}
		if (kind == ABI_REQ_TARGET as u8) {
			// The parent's compile target: the bundle it sends next must be
			// parsed (and dynamic functions jit-compiled) with it, not with
			// this child's host architecture -- under qemu the host is x86
			// while the parent may run arm64/riscv64 code.
			if (n >= 1) {
				if (buf[0] == 1) { opt_target = TARGET_ARM64; comptime_set("TARGET", "arm64"); }
				else if (buf[0] == 2) { opt_target = TARGET_RISCV64; comptime_set("TARGET", "riscv64"); }
				else { opt_target = TARGET_X86_64; comptime_set("TARGET", "x86_64"); }
			}
			continue;
		}
		if (kind != ABI_REQ_RUN as u8) { return 0; }
		var raw str;
		raw.ptr = buf;
		raw.len = n;
		raw = str_dup(raw);

		seq = seq + 1;
		var nameb Buf;
		fmt_str(&nameb, "<eval:");
		fmt_i64(&nameb, seq as i64);
		buf_u8(&nameb, '>');
		var name str = buf_str(&nameb);

		var cls int = repl_classify(raw);
		var to_run str = raw;
		var path_a bool = false;
		if (abi_first_req) {
			abi_first_req = false;
			if (cls == REPL_PATH_A) { to_run = abi_bundle_dedup(raw); }
		}
		if (cls == REPL_PATH_EXPR) {
			to_run = abi_wrap_expr(raw);
		} else if (cls == REPL_PATH_A) {
			path_a = true;
		} else {
			repl_maybe_unshadow(raw, repl_leading_word(raw));
		}

		if (!abi_try_run(to_run, name, path_a)) {
			var msg str = "eval: compile or runtime error";
			abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_ERR as u8, msg.ptr, msg.len);
			continue;
		}
		repl_run_source(to_run, name, path_a);
		var val i64 = ip_load(ip_var_addr(result_var), result_var.ty);
		// A `return`/`break`/`continue` in the eval'd source must not leak
		// into the next line, or every later statement would silently
		// skip itself.
		ip_returning = false;
		ip_broke = false;
		ip_continued = false;
		var vb [8]u8;
		*(&vb[0] as *i64) = val;
		abi_send_frame(ABI_FD_CHILD_TO_HOST, ABI_RESP_OK as u8, &vb[0], 8);
	}
	return 0;
}

} $else {

fn cmd_repl(_argc int, _argv **u8) int {
	var tty bool = sys_isatty() == 0;
	if (tty) { write_str(STDOUT, "qela repl: expressions in, values out; Ctrl-D to quit\n"); }
	while (true) {
		if (tty) { write_str(STDOUT, "qela> "); }
		var line str = read_line();
		if (line.len == 0) { return 0; }
		if (line.ptr[line.len - 1] == '\n') { line.len = line.len - 1; }
		if (line.len == 0) { continue; }

		var tmp str = qela_mktmp("qela-repl-");
		var tmpc *u8 = cstr(tmp);
		var src Buf;
		fmt_str(&src, "import \"std/io.qela\";\nimport \"std/rand.qela\";\nfn main() int {\n\twrite_str(STDOUT, \"");
		buf_u8(&src, '$');
		buf_u8(&src, '{');
		fmt_str(&src, line);
		buf_u8(&src, '}');
		fmt_str(&src, "\");\n\treturn 0;\n}\n");

		var status [1]i64;
		var pid i64 = sys_fork();
		if (pid == 0) {
			compile_src("<repl>", buf_str(&src), tmp);
			sys_exit(0);
		}
		sys_wait4(pid, &status[0] as *u8);
		var code i64 = (status[0] >> 8) & 255;
		if (code != 0) { continue; }

		var cargv *i64 = arena_alloc(16, 8) as *i64;
		cargv[0] = tmpc as i64;
		cargv[1] = 0;
		var envp *i64 = arena_alloc(8, 8) as *i64;
		envp[0] = 0;
		var pid2 i64 = sys_fork();
		if (pid2 == 0) {
			sys_execve(tmpc, cargv as *u8, envp as *u8);
			sys_exit(127);
		}
		sys_wait4(pid2, &status[0] as *u8);
		sys_unlink(tmpc);
	}
}

}

fn base_check() {
	if (!base_is_wide()) { return; }
	if (opt_backtrace) {
		die("error: --backtrace and a --base above 4 GiB do not work together");
	}
}

fn pie_check() {
	if (!opt_pie) { return; }
	if (opt_object) {
		die("error: --pie and -c do not combine (an object is already relocatable)");
	}
	if (opt_base != ELF_BASE) {
		die("error: --pie and --base do not combine");
	}
}

fn parse_addr(s str) i64 {
	var v i64 = 0;
	var i i64 = 0;
	if (s.len > 2 && s.ptr[0] == '0' && (s.ptr[1] == 'x' || s.ptr[1] == 'X')) {
		i = 2;
		while (i < s.len) {
			var c u8 = s.ptr[i];
			var d i64 = -1;
			if (c >= '0' && c <= '9') { d = c as i64 - '0' as i64; }
			else if (c >= 'a' && c <= 'f') { d = c as i64 - 'a' as i64 + 10; }
			else if (c >= 'A' && c <= 'F') { d = c as i64 - 'A' as i64 + 10; }
			if (d < 0) { die("error: --base needs a hex or decimal address"); }
			v = (v << 4) | d;
			i = i + 1;
		}
		return v;
	}
	while (i < s.len) {
		if (s.ptr[i] < '0' || s.ptr[i] > '9') { die("error: --base needs a hex or decimal address"); }
		v = v * 10 + (s.ptr[i] as i64 - '0' as i64);
		i = i + 1;
	}
	return v;
}

fn cmd_version() int {
	write_str(STDOUT, "qela ");
	write_str(STDOUT, qela_version());
	write_str(STDOUT, "\n");
	return 0;
}

fn cmd_help() int {
	write_str(STDOUT, "qela ");
	write_str(STDOUT, qela_version());
	write_str(STDOUT, " -- a self-hosting compiled language\n\n");
	write_str(STDOUT, "packages: qela absorb <file|dir> [-o qela]\n          qela absorbed [drop [package]]\n\n");
	write_str(STDOUT, "usage: qela <file.qela> [-o output] [options]\n       qela . [dir]   build a project from a directory\n       qela run <file.qela> [args]\n       qela irun <file.qela|dir> [args]\n       qela test <file.qela|dir> [files...] [-- args]\n       qela fmt <file.qela>\n       qela doc std [name]\n       qela doc <file.qela> [name]\n       qela repl\n       qela --lsp\n       qela --dump-std <module>\n\ncompile a Qela program to a static binary; '-' reads the source\nfrom stdin. A directory merges every .qela file under it,\nrecursively, into one program (entry: main.qela, or the sole file) --\nno imports needed between project files. 'run' compiles to a temp file and executes\nit, and panics print a backtrace there. 'irun' interprets the\nprogram in this process instead of compiling it -- no binary is\nwritten, and asm, naked functions and 'entry' are ignored with a\nwarning. 'test' runs the program and\nchecks its leading comments: // expect-exit: N, // expect-out: text\n(one line each, compared in order) and // expect-compile-error;\nseveral files can be tested in one run -- '--' separates the\nprogram arguments, e.g. qela test a.qela b.qela -- 5 6. 'repl'\ncompiles each line as an expression and prints its value. 'doc'\nlooks up functions by /// doc comment: 'doc std name' searches the\nembedded standard library (a module name lists its functions),\n'doc file.qela name' any source file.\n\nstrings interpolate, so n = ${40 + 2} prints 42 and pointers\nrender as hex; the expression is evaluated at runtime.\n\noptions:\n  -o <file>        output path (default: input name without .qela)\n  -c               emit a relocatable object (.o) for an external linker\n  --target, -t <t> x86_64 (default: the host architecture), arm64 or riscv64\n  -g               DWARF line info and symbols for gdb\n  --backtrace         print function frames on panic\n  --no-bounds-checks  disable index checks\n  --no-warn           suppress warnings\n  --interpreted       treat every function of your own as 'interpreted'\n  --jit               treat every function of your own as 'dynamic'\n  --color=auto|always|never  control coloured diagnostics (auto: tty + NO_COLOR)\n  --version         print the compiler version\n  -h, --help          this text\n");
	return 0;
}

// The host's architecture from uname(2)'s machine field, or 0 when it
// is not one of the supported ones (or uname failed). The field is the
// fourth of six 65-byte NUL-terminated strings.
fn host_arch() int {
	var ut [390]u8;
	if (sys_uname(&ut[0]) != 0) { return 0; }
	// utsname: sysname, nodename, release, version, machine, domainname,
	// 65 bytes each -- the machine field starts at 4 * 65.
	var m *u8 = &ut[0] + 260;
	var n i64 = 0;
	while (n < 64 && m[n] != 0) { n = n + 1; }
	var ms str;
	ms.ptr = m;
	ms.len = n;
	if (str_eq(ms, "aarch64")) { return TARGET_ARM64; }
	if (str_eq(ms, "riscv64")) { return TARGET_RISCV64; }
	return 0;
}

fn main(argc int, argv **u8) int {
	comptime_set("TARGET", "x86_64");
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "-h")) {
		return cmd_help();
	}
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "--help")) {
		return cmd_help();
	}
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "--version")) {
		return cmd_version();
	}
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "run")) {
		return cmd_run(argc, argv);
	}
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "absorb")) {
		return cmd_absorb(argc, argv);
	}
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "absorbed")) {
		return cmd_absorbed(argc, argv);
	}
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "test")) {
		return cmd_test(argc, argv);
	}
	$if (BOOTSTRAP != "1") {
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "irun")) {
		return cmd_irun(argc, argv);
	}
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "--abi-server")) {
		return cmd_abi_server(argc, argv);
	}
	}
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "fmt")) {
		return cmd_fmt(argc, argv);
	}
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "doc")) {
		return cmd_doc(argc, argv);
	}
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "repl")) {
		return cmd_repl(argc, argv);
	}
	if (argc >= 2 && str_eq(str_from_cstr(argv[1]), "--lsp")) {
		return lsp_run();
	}
	var input str;
	var output str;
	var have_input bool = false;
	var have_output bool = false;
	var target_set bool = false;

	var i int = 1;
	while (i < argc) {
		var a str = str_from_cstr(argv[i]);
		if (str_eq(a, "-o")) {
			i = i + 1;
			if (i == argc) { die("error: -o needs an argument"); }
			output = str_from_cstr(argv[i]);
			have_output = true;
		} else if (str_eq(a, "--dump-std")) {
			i = i + 1;
			if (i == argc) { die("error: --dump-std needs a module name"); }
			return dump_std(str_from_cstr(argv[i]));
		} else if (str_eq(a, "-g")) {
			opt_debug = true;
		} else if (str_eq(a, "-c")) {
			opt_object = true;
		} else 		if (str_eq(a, "--target") || str_eq(a, "-t")) {
			i = i + 1;
			if (i == argc) { die("error: --target needs x86_64, arm64 or riscv64"); }
			var t str = str_from_cstr(argv[i]);
			if (str_eq(t, "x86_64")) { opt_target = TARGET_X86_64; }
			else if (str_eq(t, "arm64")) { opt_target = TARGET_ARM64; }
			else if (str_eq(t, "riscv64")) { opt_target = TARGET_RISCV64; }
			else { die("error: --target must be x86_64, arm64 or riscv64"); }
			target_set = true;
			base_check();
		} else if (str_eq(a, "-D")) {
			i = i + 1;
			if (i == argc) { die("error: -D needs NAME=VALUE"); }
			var d str = str_from_cstr(argv[i]);
			var eq i64 = str_find(d, '=');
			if (eq < 0) { die("error: -D needs NAME=VALUE"); }
			comptime_set(str_slice(d, 0, eq), str_slice(d, eq + 1, d.len));
		} else if (str_eq(a, "--base")) {
			i = i + 1;
			if (i == argc) { die("error: --base needs an address"); }
			opt_base = parse_addr(str_from_cstr(argv[i]));
			if ((opt_base & 4095) != 0) { die("error: --base must be page aligned"); }
			flag_base_cli = true;
			base_check();
		} else if (str_eq(a, "--pie")) {
			opt_pie = true;
			flag_pie_cli = true;
		} else if (str_eq(a, "--no-bounds-checks")) {
			opt_no_bounds = true;
			flag_nobc_cli = true;
		} else if (str_eq(a, "--backtrace")) {
			opt_backtrace = true;
			flag_backtrace_cli = true;
			base_check();
		} else if (str_eq(a, "--no-warn")) {
			opt_warn = false;
		} else if (str_eq(a, "--interpreted")) {
			if (opt_global_jit) { die("error: --interpreted and --jit are mutually exclusive"); }
			opt_global_interpreted = true;
		} else if (str_eq(a, "--jit")) {
			if (opt_global_interpreted) { die("error: --interpreted and --jit are mutually exclusive"); }
			opt_global_jit = true;
		} else if (a.len > 7 && str_eq(str_slice(a, 0, 7), "--color")) {
			// --color=auto | always | never. The "=" is at offset 7.
			if (a.len < 9 || a.ptr[7] != '=') { die("error: --color needs =auto|always|never"); }
			var v str = str_slice(a, 8, a.len);
			if (str_eq(v, "auto")) { opt_color = 0; }
			else if (str_eq(v, "always")) { opt_color = 1; }
			else if (str_eq(v, "never")) { opt_color = 2; }
			else { die("error: --color must be auto, always, or never"); }
		} else if (str_eq(a, "-h") || str_eq(a, "--help")) {
			return cmd_help();
		} else if (str_eq(a, "--version")) {
			return cmd_version();
		} else if (str_eq(a, "-")) {
			input = a;
			have_input = true;
		} else if (a.len > 0 && a.ptr[0] == '-') {
			die("error: unknown option");
		} else if (!have_input) {
			input = a;
			have_input = true;
		} else if (link_npaths < 32 &&
		           ((a.len > 2 && str_eq(str_slice(a, a.len - 2, a.len), ".o")) ||
		            (a.len > 2 && str_eq(str_slice(a, a.len - 2, a.len), ".a")))) {
			// `qela main.qela libfoo.o libbar.a -o app`: statically link
			// relocatable objects into the image (see linker.qela).
			link_paths[link_npaths] = a;
			link_npaths = link_npaths + 1;
		} else {
			die("error: more than one input file");
		}
		i = i + 1;
	}

	// No explicit --target: compile for the host architecture, so a
	// native arm64/riscv64 build of the compiler does the right thing
	// without flags (under qemu user-mode the host is x86, which is
	// also right: the emitted binary runs on the same kernel).
	if (!target_set) {
		var ha int = host_arch();
		if (ha != 0) { opt_target = ha; }
	}
	if (opt_target == TARGET_RISCV64) { comptime_set("TARGET", "riscv64"); }
	if (opt_target == TARGET_ARM64) { comptime_set("TARGET", "arm64"); }
	pie_check();
	if (opt_pie && link_npaths > 0) {
		die("error: --pie cannot statically link objects yet (absolute relocations need a fixed base)");
	}
	if (opt_object && link_npaths > 0) {
		die("error: -c emits a relocatable object; drop the linked objects and link with your own ld");
	}

	if (!have_input) {
		eprint("usage: qela <file.qela> [-o output]\n");
		eprint("try 'qela -h' for the full help\n");
		return 2;
	}
	if (!have_output) {
		if (is_dir(input)) { output = "a.out"; }
		else { output = default_output(input); }
	}

	if (str_eq(input, "-")) { compile_src("<stdin>", read_stdin(), output); }
	else if (is_dir(input)) { cmd_build_dir(input, output); }
	else { compile_file(input, output); }
	return 0;
}
