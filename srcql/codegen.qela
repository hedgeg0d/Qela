import "comp.qela";
import "diag.qela";
import "type.qela";
import "regalloc.qela";
import "ir.qela";
import "x86_emit.qela";
import "arm64_emit.qela";
import "riscv_emit.qela";
import "../std/io.qela";


// The integer argument register for rank i on the current target -- the
// register-mapping half of the ABI, mirrored by abi_n_arg_regs() in
// comp.qela. SysV AMD64 order is rdi, rsi, rdx, rcx, r8, r9; AAPCS64 is
// simply x0..x7; RISC-V's LP64 is a0..a7, whose encodings are 10..17. A
// rank past the target's register count is unreachable: parse.qela spills
// parameters beyond abi_n_arg_regs().
fn call_reg(i int) int {
	if (opt_target == TARGET_RISCV64) { return A0 + i; }
	if (opt_target == TARGET_ARM64) { return i; }
	if (i == 0) { return RDI; }
	if (i == 1) { return RSI; }
	if (i == 2) { return RDX; }
	if (i == 3) { return RCX; }
	if (i == 4) { return R8; }
	return R9;
}


fn sys_reg(i int) int {
	if (opt_target == TARGET_RISCV64) { return call_reg(i); }
	if (opt_target == TARGET_ARM64) { return call_reg(i); }
	if (i == 3) { return R10; }
	return call_reg(i);
}


// The frontend stages a binop's right operand into one fixed register per
// target (gen_expr's two-operand preamble). The IR carries the rank, not the
// register; this is the rank->register map, the mirror of call_reg. x86 uses
// rdi (rank 0); ARM64 uses x1 and RISC-V a1, so neither collides with the
// accumulator (x0/a0).
fn op2_reg(_rank int) int {
	if (opt_target == TARGET_RISCV64) { return A1; }
	if (opt_target == TARGET_ARM64) { return 1; }
	return RDI;
}


struct Loop;
struct Loop { prev *Loop, brk i64, cont i64, depth int, }


struct DeferScope;
struct DeferScope { prev *DeferScope, list *Node, depth int, }

// Total 8-byte slots gen_args pushed for the current call's stack-spilled
// arguments, padding included -- gen_call reads this to clean up exactly
// what went on the stack, without re-deriving the padding decision.
var overflow_pushed i64;

var cur_loop *Loop;

var gen_fn *Func;

var cur_defers *DeferScope;

var defer_depth int;


var opt_no_bounds bool = false;

var gen_unit *Unit;


fn by_ref_ty(ty *Type) bool {
	return is_aggregate(ty) && abi_by_ref(ty.size);
}


// A local scalar of machine width lives at a known rbp offset, so it can be
// read or written with one instruction instead of materialising its address.
fn direct_local(n *Node) bool {
	if (n.kind != ND_VAR) { return false; }
	var v *Var = n.varp;
	if (v.is_global || v.by_ref || v.arg_stack) { return false; }
	if (is_aggregate(n.ty)) { return false; }
	return n.ty.size == 8;
}


fn gen_addr(n *Node) {
	var k int = n.kind;
	if (k == ND_VAR) {
		if (n.varp.has_reg) { error_at(n.pos, "internal: address of a promoted local"); }
		if (n.varp.is_tls) { ir_tlsaddr(n.varp, n.pos); }
		else if (n.varp.is_global) { ir_mov_acc_global(n.varp, n.pos); }
		else if (n.varp.arg_stack) {
			// A stack-passed parameter's offset is a positive rbp
			// displacement already, unlike every other local: the wrappers
			// negate it back to the frame convention the lowering expects.
			if (n.varp.by_ref) { ir_load_arg_acc(n.varp.offset as i64, n.pos); }
			else { ir_lea_arg_acc(n.varp.offset as i64, n.pos); }
		}
		else if (n.varp.by_ref) { ir_load_var(n.varp, type_ptr(ty_i64), n.pos); }
		else { ir_lea_slot_acc(n.varp.offset as i64, n.pos); }
		return;
	}
	if (k == ND_DEREF) { gen_expr(n.lhs); return; }
	if (k == ND_MEMBER) {
		if (n.lhs.ty.kind == TY_PTR) { gen_expr(n.lhs); } else { gen_addr(n.lhs); }
		ir_add_acc_imm(n.member.offset as i64, n.pos);
		return;
	}
	if (k == ND_INDEX) {
		var lt *Type = n.lhs.ty;
		if (lt.kind == TY_SLICE) {
			gen_addr(n.lhs);
			ir_push_at_acc(0, n.pos);
			ir_push_at_acc(8, n.pos);
			gen_expr(n.rhs);
			ir_pop_op2(n.pos);
			if (!opt_no_bounds) {
				ir_cmp_op2_acc(n.pos);
				ir_bounds(CC_UGE, n.pos);
			}
			ir_pop_op2(n.pos);
			ir_lea_acc(operand_op2(0), operand_acc(), lt.base.size, 0, n.pos);
			return;
		}

		if (lt.kind == TY_ARRAY) { gen_addr(n.lhs); } else { gen_expr(n.lhs); }
		// A constant index into an array is checked here, so no code is
		// emitted for it and the offset folds into the address.
		if (n.rhs.kind == ND_NUM &&
		    (lt.kind != TY_ARRAY || (n.rhs.val >= 0 && n.rhs.val < lt.len))) {
			ir_lea_acc(operand_acc(), operand_none(), 1,
			           n.rhs.val * (lt.base.size as i64), n.pos);
			return;
		}
		if (direct_local(n.rhs)) {
			// A promoted index needs no copy: it can be the lea index directly.
			if (n.rhs.varp.has_reg && lea_scale_ok(lt.base.size)) {
				if (lt.kind == TY_ARRAY && !opt_no_bounds && !n.nobounds) {
					ir_cmp_rm_imm32(n.rhs, lt.len, n.pos);
					ir_bounds(CC_UGE, n.pos);
				}
				ir_lea_acc(operand_acc(), operand_index(n.rhs.varp.reg),
				           lt.base.size, 0, n.pos);
				return;
			}
			ir_load_op2_var(n.rhs.varp, n.ty, n.pos);
			if (lt.kind == TY_ARRAY && !opt_no_bounds && !n.nobounds) {
				ir_cmp_op2_imm32(lt.len, n.pos);
				ir_bounds(CC_UGE, n.pos);
			}
			ir_lea_acc(operand_acc(), operand_op2(0), lt.base.size, 0, n.pos);
			return;
		}
		ir_push_acc(n.pos);
		gen_expr(n.rhs);
		if (lt.kind == TY_ARRAY && !opt_no_bounds && !n.nobounds) {
			ir_cmp_acc_imm32(lt.len, n.pos);
			ir_bounds(CC_UGE, n.pos);
		}
		ir_mov_acc_op2(n.pos);
		ir_pop_acc(n.pos);
		ir_lea_acc(operand_acc(), operand_op2(0), lt.base.size, 0, n.pos);
		return;
	}
	if (k == ND_SLICE) {
		var lt *Type = n.lhs.ty;
		var off i64 = n.tmp.offset as i64;
		var elem int = lt.base.size;

		gen_addr(n.lhs);
		if (lt.kind == TY_SLICE) {
			ir_load_at_acc_op2(0, n.pos);
			ir_store_op2_slot(off, n.pos);
			ir_load_at_acc_op2(8, n.pos);
			ir_store_op2_slot(off - 8, n.pos);
		} else {
			ir_store_stackslot_acc(off, n.ty, n.pos);
			ir_mov_op2_imm(lt.len, n.pos);
			ir_store_op2_slot(off - 8, n.pos);
		}

		if (n.rhs as i64 != 0) { gen_expr(n.rhs); } else { ir_mov_acc_imm(0, n.pos); }
		ir_push_acc(n.pos);

		if (n.then as i64 != 0) { gen_expr(n.then); } else { ir_load_slot_acc(off - 8, type_ptr(ty_i64), n.pos); }
		ir_pop_op2(n.pos);

		if (!opt_no_bounds) {
			ir_cmp_acc_rm(operand_stackslot(off - 8, null), n.pos);
			ir_bounds(CC_UGT, n.pos);
			ir_cmp_op2_acc_rev(n.pos);
			ir_bounds(CC_UGT, n.pos);
		}

		ir_alu_acc(ALU_SUB, n.ty, n.pos);
		ir_store_stackslot_acc(off - 8, n.ty, n.pos);

		ir_mov_op2_acc(n.pos);
		ir_alu_acc_imm(ALU_SCALE, type_ptr(ty_i64), elem as i64, n.pos);
		ir_alu_acc_rm(ALU_ADD, n.ty, operand_stackslot(off, null), n.pos);
		ir_store_stackslot_acc(off, n.ty, n.pos);

		ir_lea_slot_acc(off, n.pos);
		return;
	}
	if (is_aggregate(n.ty)) { gen_expr(n); return; }
	error_at(n.pos, "not an addressable expression");
}


fn gen_lvalue(n *Node) {
	gen_addr(n);
	if (!is_aggregate(n.ty)) { ir_load_acc(n.ty, n.pos); }
}


// An argument with no side effects can be loaded straight into its register
// instead of going through the stack, but only if every argument after it is
// side-effect free too: moving it later would otherwise reorder the effects.
fn arg_leaf_ok(a *Node) bool {
	if (a.kind == ND_NUM) { return fits_imm32(a.val); }
	if (!direct_local(a)) { return false; }
	if (!a.varp.has_reg) { return true; }
	// The source must survive until the argument registers are filled, so it
	// cannot itself be one of them.
	return a.varp.reg == 3 || a.varp.reg >= 12;
}


fn arg_direct_ok(a *Node) bool {
	if (arg_leaf_ok(a)) { return true; }
	var k int = a.kind;
	if (k != ND_ADD && k != ND_SUB && k != ND_BITAND && k != ND_BITOR && k != ND_BITXOR) {
		return false;
	}
	if (a.ty.size != 8 || a.ty.kind == TY_PTR) { return false; }
	if (a.lhs.ty.kind == TY_PTR || a.rhs.ty.kind == TY_PTR) { return false; }
	return arg_leaf_ok(a.lhs) && arg_leaf_ok(a.rhs);
}


// marshall is set for a call to an extern-marked function (SysV on the
// other side): scalar float arguments land in xmm registers with their own
// counter, and the integer arguments are packed into the GPR registers by
// their own counter, exactly as SysV classifies them.
fn gen_args(n *Node, sys bool, first_in_rax bool, hidden i64, marshall bool) int {
	var dest [14]int;
	var src [14]i64;
	var fmm [14]int;
	var fsz [14]int;
	var nd int = 0;
	var ri int = 0;
	var xi int = 0;
	{
		var fi int = 0;
		while (fi < 14) { fmm[fi] = -1; fsz[fi] = 0; fi = fi + 1; }
	}

	var av [14]i64;
	var an int = 0;
	var has_overflow bool = false;
	var scan *Node = n.args;
	while (scan as i64 != 0 && an < 14) {
		av[an] = scan as i64;
		if (scan.stack_tmp as i64 != 0) { has_overflow = true; }
		an = an + 1;
		scan = scan.next;
	}
	var direct_from int = an;
	// The direct-argument fast path assumes every argument lands in a
	// register; a call with stack-spilled arguments always takes the slow,
	// evaluate-then-place path instead. A marshalled float argument can never
	// take the fast path: its value has to move into an xmm register, and
	// gen_into does not know about those.
	while (!has_overflow && direct_from > 0 &&
	       !(marshall && is_float((av[direct_from - 1] as *Node).ty)) &&
	       arg_direct_ok(av[direct_from - 1] as *Node)) {
		direct_from = direct_from - 1;
	}
	var ai int = 0;

	if (hidden >= 0) {
		ir_lea_slot_acc(hidden, n.pos);
		ir_push_acc(n.pos);
		if (marshall && opt_target == TARGET_ARM64) {
			// AAPCS64 carries the sret pointer in x8, off the integer
			// argument sequence, so it does not consume an x-register.
			dest[nd] = X8;
		} else if (marshall && opt_target == TARGET_RISCV64) {
			// RISC-V's LP64D puts the sret pointer in a0, the first
			// argument register.
			dest[nd] = call_reg(ri);
			ri = ri + 1;
		} else {
			if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
			ri = ri + 1;
		}
		src[nd] = 0;
		nd = nd + 1;
	}

	var a *Node = n.args;
	while (a as i64 != 0) {
		if (ai >= direct_from) {
			if (first_in_rax && nd == 0) {
				// A syscall's number is x86's rax, but ARM64's SVC reads it
				// from x8 and RISC-V's ecall from a7 -- unlike x86, neither
				// accumulator (x0/a0) is also the first real argument
				// register, so the number can't share it the way rax does.
				if (opt_target == TARGET_ARM64) { dest[nd] = X8; }
				else if (opt_target == TARGET_RISCV64) { dest[nd] = A7; }
				else { dest[nd] = RAX; }
			} else {
				if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
				ri = ri + 1;
			}
			src[nd] = a as i64;
			nd = nd + 1;
			ai = ai + 1;
			a = a.next;
			continue;
		}
		ai = ai + 1;
		gen_expr(a);
		if (by_ref_ty(a.ty)) {
			ir_memcpy_dst(a.tmp.offset as i64, a.ty.size as i64, a.pos);
			if (a.stack_tmp as i64 != 0) {
				ir_store_stackslot_acc(a.stack_tmp.offset as i64, type_ptr(ty_i64), a.pos);
				a = a.next;
				continue;
			}
			ir_push_acc(a.pos);
			if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
			src[nd] = 0;
			nd = nd + 1;
			ri = ri + 1;
		} else if (is_aggregate(a.ty)) {
			// v1 never spills a >8-byte, <=16-byte (2-word) aggregate --
			// parse.qela rejects that -- so a spilled aggregate here is
			// always a single word.
			if (a.stack_tmp as i64 != 0) {
				if (opt_target == TARGET_ARM64) {
					arm64_ld_at(X9, X0, 0);
					arm64_st_local(a.stack_tmp.offset as i64, X9);
					a = a.next;
					continue;
				}
				if (opt_target == TARGET_RISCV64) {
					riscv_ld_at(T0, A0, 0);
					riscv_st_local(a.stack_tmp.offset as i64, T0);
					a = a.next;
					continue;
				}
				ld_at_rax(RCX, 0);
				st_local(a.stack_tmp.offset as i64, RCX);
				a = a.next;
				continue;
			}
			ir_push_at_acc(0, a.pos);
			if (first_in_rax && nd == 0) {
				if (opt_target == TARGET_ARM64) { dest[nd] = X8; }
				else if (opt_target == TARGET_RISCV64) { dest[nd] = A7; }
				else { dest[nd] = RAX; }
			} else {
				if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
				ri = ri + 1;
			}
			src[nd] = 0;
			nd = nd + 1;
			if (a.ty.size > 8) {
				ir_push_at_acc(8, a.pos);
				if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
				src[nd] = 0;
				nd = nd + 1;
				ri = ri + 1;
			}
		} else {
			if (a.stack_tmp as i64 != 0) {
				ir_store_stackslot_acc(a.stack_tmp.offset as i64, a.ty, a.pos);
				a = a.next;
				continue;
			}
			ir_push_acc(a.pos);
			if (marshall && is_float(a.ty)) {
				fmm[nd] = xi;
				fsz[nd] = a.ty.size;
				xi = xi + 1;
				dest[nd] = RAX;
			} else if (first_in_rax && nd == 0) {
				if (opt_target == TARGET_ARM64) { dest[nd] = X8; }
				else if (opt_target == TARGET_RISCV64) { dest[nd] = A7; }
				else { dest[nd] = RAX; }
			} else {
				if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
				ri = ri + 1;
			}
			src[nd] = 0;
			nd = nd + 1;
		}
		a = a.next;
	}
	while (nd > 0) {
		nd = nd - 1;
		if (fmm[nd] >= 0) {
			ir_pop_acc(n.pos);
			if (opt_target == TARGET_ARM64) { arm64_fmov_from_gpr(fmm[nd], X0, fsz[nd]); }
			else if (opt_target == TARGET_RISCV64) { riscv_fmv_wx_to_f(FA0 + fmm[nd], A0, fsz[nd]); }
			else { gpr_to_xmm(fmm[nd], RAX, fsz[nd]); }
		} else if (src[nd] == 0) {
			ir_pop_reg(dest[nd], n.pos);
		} else {
			var sn *Node = src[nd] as *Node;
			if (!gen_into(sn, dest[nd])) {
				gen_expr(sn);
				// Same bytes as mov_reg_reg(dest[nd], RAX) on x86 (IR_STORE
				// dst=VREG src0=ACC), routed through IR so ARM64 gets it too.
				ir_store_vreg_acc(dest[nd], null, n.pos);
			}
		}
	}

	// Stack-spilled arguments go on last, in reverse source order, so the
	// first overflow argument ends up nearest rsp (rbp+16 in the callee)
	// once the call's return address lands on top of them.
	var m i64 = 0;
	var ci int = 0;
	while (ci < an) {
		if ((av[ci] as *Node).stack_tmp as i64 != 0) { m = m + 1; }
		ci = ci + 1;
	}
	// gen_call's own 16-byte alignment check runs after this, on whatever
	// depth is left -- if padding would be needed, it must go *below* the
	// spilled arguments (pushed first here), not between them and the
	// return address, or every rbp+16/+24/... offset in the callee shifts
	// by 8. Front-loading it here keeps depth even by the time gen_call
	// looks, so its own check stays a no-op for this call.
	var pad i64 = 0;
	if (m > 0) {
		if (opt_target == TARGET_RISCV64) {
			// LP64 hands stack arguments to the callee as [sp, #0], [sp,
			// #8], ... at the call instruction, the same block allocation
			// as AAPCS64. The callee's s0 = entry-SP - 16, so its read of
			// parameter slot i at s0 + 16 + 8i resolves back to exactly
			// [entry-SP + 8i].
			var alloc i64 = m * 8;
			if ((alloc & 15) != 0) { alloc = alloc + 8; }
			riscv_sub_imm(STK, STK, alloc);
			var si2 i64 = 0;
			var oi int = 0;
			while (oi < an) {
				var oa *Node = av[oi] as *Node;
				if (oa.stack_tmp as i64 != 0) {
					// The accumulator is a0 here, already holding the first
					// argument -- never touch it. T0 is scratch and safe
					// until the JAL.
					riscv_ld_local(T0, oa.stack_tmp.offset as i64);
					riscv_str_off(T0, STK, 8 * si2);
					si2 = si2 + 1;
				}
				oi = oi + 1;
			}
		} else if (opt_target == TARGET_ARM64) {
			// AAPCS64 hands stack arguments to the callee as [SP, #0], [SP,
			// #8], ... at the call instruction. Allocate the words in one
			// 16-byte-aligned block (SP must stay aligned at the BL), store
			// each in source order, and let gen_call undo the allocation.
			// The callee's x29 = entry-SP - 16, so its read of parameter
			// slot i at x29 + 16 + 8i (parse.qela's 16 + 8*stack_slot)
			// resolves back to exactly [entry-SP + 8i].
			var alloc i64 = m * 8;
			if ((alloc & 15) != 0) { alloc = alloc + 8; }
			arm64_sub_imm(SP, SP, alloc);
			var si2 i64 = 0;
			var oi int = 0;
			while (oi < an) {
				var oa *Node = av[oi] as *Node;
				if (oa.stack_tmp as i64 != 0) {
					// The accumulator is x0 here, already holding the first
					// argument -- never touch it. X9 is scratch and safe
					// until the BL (gen_call's alignment pad is x86-only).
					arm64_ld_local(X9, oa.stack_tmp.offset as i64);
					arm64_str_off(X9, SP, 8 * si2);
					si2 = si2 + 1;
				}
				oi = oi + 1;
			}
		} else {
			if (((depth as i64 + m) & 1) != 0) {
				alu_rax_imm_reg(5, RSP, 8);
				depth = depth + 1;
				pad = 1;
			}
			var oi int = an;
			while (oi > 0) {
				oi = oi - 1;
				var oa *Node = av[oi] as *Node;
				if (oa.stack_tmp as i64 != 0) {
					ir_load_var(oa.stack_tmp, type_ptr(ty_i64), oa.pos);
					ir_push_acc(oa.pos);
				}
			}
		}
	}
	overflow_pushed = m + pad;
	return ri;
}


// Unsigned-integer cc codes double as float cc codes: ucomisd sets CF/ZF/PF
// exactly like an unsigned integer compare (NaN aside, which this does not
// try to get right -- a hobby compiler, not a libc).
// The neutral form of a float comparison: what a branch or setcc should
// carry after ucomisd. The x86 lowering folds it back into the exact byte
// table above, so callers that branch on a float comparison stay byte-
// identical.
fn float_cc_neutral(n *Node) i64 {
	if (n.kind == ND_EQ) { return CC_EQ; }
	if (n.kind == ND_NE) { return CC_NE; }
	if (n.kind == ND_LT) { return CC_ULT; }
	return CC_ULE;
}


fn gen_binop_float(n *Node) {
	var k int = n.kind;
	if (k == ND_ADD) { ir_alu_acc(ALU_FADD, n.ty, n.pos); return; }
	if (k == ND_SUB) { ir_alu_acc(ALU_FSUB, n.ty, n.pos); return; }
	if (k == ND_MUL) { ir_alu_acc(ALU_FMUL, n.ty, n.pos); return; }
	if (k == ND_DIV) { ir_alu_acc(ALU_FDIV, n.ty, n.pos); return; }
	if (k == ND_EQ || k == ND_NE || k == ND_LT || k == ND_LE) {
		ir_cmp_op2_acc_float(n.lhs.ty, n.pos);
		ir_setcc_acc(float_cc_neutral(n), n.pos);
		return;
	}
	error_at(n.pos, "operator not defined for floats");
}


fn gen_neg_float(sz int, pos i64) {
	var mask i64 = 0x8000000000000000;
	if (sz == 4) { mask = 0x80000000; }
	ir_mov_op2_imm(mask, pos);
	ir_alu_acc(ALU_XOR, type_ptr(ty_i64), pos);
}


// RAX holds n.lhs's bits on entry (n.lhs already generated); leaves the
// converted bits in RAX.
fn gen_cast_float(n *Node) {
	var st *Type = n.lhs.ty;
	var dt *Type = n.ty;
	if (is_float(st) && is_float(dt)) {
		if (st.size == dt.size) { return; }
		if (st.size == 4) { ir_cast_float(CAST_FEXT, st, dt, n.pos); }
		else { ir_cast_float(CAST_FTRUNC, st, dt, n.pos); }
		return;
	}
	if (is_float(dt)) { ir_cast_float(CAST_ITOF, st, dt, n.pos); return; }
	ir_cast_float(CAST_FTOI, st, dt, n.pos);
}


fn cc_for_compare(n *Node) i64 {
	var uns bool = n.lhs.ty.is_unsigned || n.lhs.ty.kind == TY_PTR;
	if (n.kind == ND_EQ) { return CC_EQ; }
	if (n.kind == ND_NE) { return CC_NE; }
	if (n.kind == ND_LT) { if (uns) { return CC_ULT; } return CC_LT; }
	if (uns) { return CC_ULE; }
	return CC_LE;
}


fn gen_binop(n *Node) {
	var t *Type = n.ty;
	var k int = n.kind;

	if (is_float(n.lhs.ty)) { gen_binop_float(n); return; }
	if (k == ND_ADD) { ir_alu_acc(ALU_ADD, t, n.pos); return; }
	if (k == ND_SUB) { ir_alu_acc(ALU_SUB, t, n.pos); return; }
	if (k == ND_MUL) { ir_alu_acc(ALU_MUL, t, n.pos); return; }
	if (k == ND_DIV) { ir_alu_acc(ALU_DIV, t, n.pos); return; }
	if (k == ND_MOD) { ir_alu_acc(ALU_MOD, t, n.pos); return; }
	if (k == ND_BITAND) { ir_alu_acc(ALU_AND, t, n.pos); return; }
	if (k == ND_BITOR)  { ir_alu_acc(ALU_OR, t, n.pos); return; }
	if (k == ND_BITXOR) { ir_alu_acc(ALU_XOR, t, n.pos); return; }
	if (k == ND_SHL) { ir_alu_acc(ALU_SHL, t, n.pos); return; }
	if (k == ND_SHR) { ir_alu_acc(ALU_SHR, t, n.pos); return; }
	if (k == ND_EQ || k == ND_NE || k == ND_LT || k == ND_LE) {
		ir_compare_acc(cc_for_compare(n), n.pos);
		return;
	}
	error_at(n.pos, "invalid expression");
}


fn gen_enumlit(n *Node) {
	var off i64 = n.tmp.offset as i64;
	ir_mov_acc_imm(n.variant.tag as i64, n.pos);
	ir_store_stackslot_acc(off, ty_i64, n.pos);

	var f *Member = n.variant.fields;
	var a *Node = n.args;
	while (a as i64 != 0) {
		ir_lea_op2_slot(off - (f.offset as i64), n.pos);
		ir_push_op2(n.pos);
		gen_expr(a);
		if (is_aggregate(f.ty)) { ir_memcpy_stage(f.ty.size as i64, n.pos); }
		else { ir_pop_op2(n.pos); ir_store_op2_acc(f.ty, n.pos); }
		f = f.next;
		a = a.next;
	}
	ir_lea_slot_acc(off, n.pos);
}


fn gen_structlit(n *Node) {
	var off i64 = n.tmp.offset as i64;
	var nmembers int = 0;
	var m *Member = n.ty.members;
	while (m as i64 != 0) { nmembers = nmembers + 1; m = m.next; }

	if (n.nargs < nmembers) {
		ir_memset_stackslot(off, n.ty.size as i64, n.pos);
	}
	var a *Node = n.args;
	while (a as i64 != 0) {
		ir_lea_op2_slot(off - (a.member.offset as i64), n.pos);
		ir_push_op2(n.pos);
		gen_expr(a.lhs);
		if (is_aggregate(a.member.ty)) {
			ir_memcpy_stage(a.member.ty.size as i64, n.pos);
		} else {
			ir_pop_op2(n.pos);
			ir_store_op2_acc(a.member.ty, n.pos);
		}
		a = a.next;
	}
	ir_lea_slot_acc(off, n.pos);
}


fn gen_call(n *Node) {
	if (n.varp as i64 != 0) { gen_indirect_call(n); return; }
	var cf *Func = find_func(n.name);
	var marshall bool = false;
	if (cf as i64 != 0) { marshall = cf.extern; }
	var ret_mem bool = is_aggregate(n.ty) && abi_sret(n.ty.size);
	var hidden i64 = -1;
	if (ret_mem) { hidden = n.tmp.offset as i64; }
	gen_args(n, false, false, hidden, marshall);

	// The 16-byte-alignment pad below is an x86 concern only: its push is
	// 8 bytes, so an odd depth needs 8 more before a call. ARM64's push
	// (arm64_push in arm64_emit.qela) and RISC-V's (riscv_push) always move
	// SP by 16, so SP never drifts out of alignment and no padding is ever
	// needed.
	var odd bool = opt_target == TARGET_X86_64 && (depth & 1) != 0;
	if (odd) {
		b1(0x48); b1(0x83); modrm(3, 5, RSP); b1(8);
	}
	ir_call(cf, n.pos);
	if (odd) {
		b1(0x48); b1(0x83); modrm(3, 0, RSP); b1(8);
	}
	if (overflow_pushed > 0) {
		if (opt_target == TARGET_RISCV64) {
			var alloc i64 = overflow_pushed * 8;
			if ((alloc & 15) != 0) { alloc = alloc + 8; }
			riscv_add_imm(STK, STK, alloc);
		} else if (opt_target == TARGET_ARM64) {
			var alloc i64 = overflow_pushed * 8;
			if ((alloc & 15) != 0) { alloc = alloc + 8; }
			arm64_add_imm(SP, SP, alloc);
		} else {
			alu_rax_imm_reg(0, RSP, 8 * overflow_pushed);
			depth = depth - (overflow_pushed as int);
		}
	}
	// A marshalled call's float result comes back in xmm0 (SysV) / d0 or s0
	// (AAPCS64) / fa0 (LP64D), but Qela reads its own results from the
	// accumulator.
	if (marshall && is_float(n.ty)) {
		if (opt_target == TARGET_ARM64) { arm64_fmov_to_gpr(X0, 0, n.ty.size); }
		else if (opt_target == TARGET_RISCV64) { riscv_fmv_f_to_wx(A0, FA0, n.ty.size); }
		else { xmm_to_gpr(RAX, 0, n.ty.size); }
	}
	// A marshalled sret callee writes through the hidden pointer and leaves
	// the accumulator dead; Qela's own ABI hands the buffer address back in
	// the accumulator, and the consumer reads it from there. Reload the
	// hidden buffer's address so that consumer stays unchanged.
	if (marshall && ret_mem && opt_target == TARGET_ARM64) {
		ir_lea_slot_acc(hidden, n.pos);
	}
	if (marshall && ret_mem && opt_target == TARGET_RISCV64) {
		// LP64D's sret pointer is a0 itself, which the call's result also
		// travels in -- it survives the call untouched, so no reload.
	}
	if (is_aggregate(n.ty) && !ret_mem) {
		ir_store2(n.tmp.offset as i64, n.ty.size as i64, n.pos);
	}
}


// A call through a function-typed variable. The signature check already ran
// in type_indirect_call, so here it is only the mechanics. The address goes
// in R10 (never an argument register) and is loaded after the arguments are
// set up: a call inside the argument list would clobber R10, and a promoted
// target can only live in a callee-saved register (an indirect call makes
// the function non-leaf, so the free caller-saved pool is out).
fn gen_indirect_call(n *Node) {
	var ret_mem bool = is_aggregate(n.ty) && abi_sret(n.ty.size);
	var hidden i64 = -1;
	if (ret_mem) { hidden = n.tmp.offset as i64; }

	var closured bool = n.clo_code as i64 != 0 && n.clo_env as i64 != 0;
	if (closured) {
		ir_load_var(n.varp, ty_i64, n.pos);
		ir_alu_acc_imm(ALU_AND, ty_i64, 1, n.pos);
		ir_cmp_acc_imm(0, n.pos);
		var plain i64 = ir_new_label();
		var done i64 = ir_new_label();
		ir_branch(CC_EQ, plain, n.pos);
		ir_load_var(n.varp, ty_i64, n.pos);
		ir_add_acc_imm(-1, n.pos);
		ir_store_stackslot_acc(n.clo_env.offset as i64, ty_i64, n.pos);
		ir_load_acc(ty_i64, n.pos);
		ir_store_stackslot_acc(n.clo_code.offset as i64, ty_i64, n.pos);
		ir_branch(CC_ALWAYS, done, n.pos);
		ir_label(plain, n.pos);
		ir_load_var(n.varp, ty_i64, n.pos);
		ir_store_stackslot_acc(n.clo_code.offset as i64, ty_i64, n.pos);
		ir_mov_acc_imm(0, n.pos);
		ir_store_stackslot_acc(n.clo_env.offset as i64, ty_i64, n.pos);
		ir_label(done, n.pos);
	}

	var nregs int = gen_args(n, false, false, hidden, false);
	if (closured && nregs < abi_n_arg_regs()) {
		ir_load_vreg_var(call_reg(nregs), n.clo_env, ty_i64, n.pos);
	}

	var odd bool = opt_target == TARGET_X86_64 && (depth & 1) != 0;
	if (odd) {
		b1(0x48); b1(0x83); modrm(3, 5, RSP); b1(8);
	}
	var target IrOperand;
	if (closured) {
		target = operand_stackslot(n.clo_code.offset as i64, ty_i64);
	} else if (n.varp.has_reg) {
		target = operand_vreg(n.varp.reg, n.varp.ty);
	} else if (n.varp.is_global) {
		target = operand_global(n.varp);
	} else {
		target = operand_stackslot(n.varp.offset as i64, n.varp.ty);
	}
	ir_call_ind(target, n.pos);
	if (odd) {
		b1(0x48); b1(0x83); modrm(3, 0, RSP); b1(8);
	}
	if (overflow_pushed > 0) {
		if (opt_target == TARGET_RISCV64) {
			var alloc i64 = overflow_pushed * 8;
			if ((alloc & 15) != 0) { alloc = alloc + 8; }
			riscv_add_imm(STK, STK, alloc);
		} else if (opt_target == TARGET_ARM64) {
			var alloc i64 = overflow_pushed * 8;
			if ((alloc & 15) != 0) { alloc = alloc + 8; }
			arm64_add_imm(SP, SP, alloc);
		} else {
			alu_rax_imm_reg(0, RSP, 8 * overflow_pushed);
			depth = depth - (overflow_pushed as int);
		}
	}
	if (is_aggregate(n.ty) && !ret_mem) {
		ir_store2(n.tmp.offset as i64, n.ty.size as i64, n.pos);
	}
}


fn gen_logical(n *Node) {
	gen_expr(n.lhs);
	if (opt_target == TARGET_ARM64 || opt_target == TARGET_RISCV64) { ir_cmp_acc_imm(0, n.pos); } else { test_rax(); }
	// Skip the whole materialised value when one side decides the result:
	// an OR is 1 as soon as either side is true, an AND is 0 as soon as
	// either side is false.
	var skip_cc i64 = CC_NE;
	if (n.kind == ND_AND) { skip_cc = CC_EQ; }
	var mid i64 = ir_new_label();
	ir_branch(skip_cc, mid, n.pos);
	gen_expr(n.rhs);
	if (opt_target == TARGET_ARM64 || opt_target == TARGET_RISCV64) { ir_cmp_acc_imm(0, n.pos); } else { test_rax(); }
	ir_branch(skip_cc, mid, n.pos);
	if (n.kind == ND_AND) { ir_mov_acc_imm(1, n.pos); } else { ir_mov_acc_imm(0, n.pos); }
	var end i64 = ir_new_label();
	ir_branch(CC_ALWAYS, end, n.pos);
	ir_label(mid, n.pos);
	if (n.kind == ND_AND) { ir_mov_acc_imm(0, n.pos); } else { ir_mov_acc_imm(1, n.pos); }
	ir_label(end, n.pos);
}


fn gen_opassign(n *Node) {
	if (n.lhs.kind == ND_VAR && n.lhs.varp.has_reg) {
		ir_load_var(n.lhs.varp, n.lhs.ty, n.pos);
		ir_push_acc(n.pos);
		gen_expr(n.rhs);
		if (n.lhs.ty.kind == TY_PTR) {
			if (n.lhs.ty.base.size != 1) { ir_alu_acc_imm(ALU_SCALE, n.lhs.ty, n.lhs.ty.base.size as i64, n.pos); }
		}
		ir_mov_acc_op2(n.pos);
		ir_pop_acc(n.pos);

		var rop Node;
		rop.kind = n.val as int;
		rop.ty = n.lhs.ty;
		rop.lhs = n.lhs;
		rop.pos = n.pos;
		gen_binop(&rop);

		ir_cast_acc(CAST_TRUNC, n.lhs.ty, n.pos);
		ir_store_vreg_acc(n.lhs.varp.reg, n.lhs.ty, n.pos);
		return;
	}
	gen_addr(n.lhs);
	ir_push_acc(n.pos);
	ir_load_acc(n.lhs.ty, n.pos);
	ir_push_acc(n.pos);
	gen_expr(n.rhs);
	if (n.lhs.ty.kind == TY_PTR) {
		if (n.lhs.ty.base.size != 1) { ir_alu_acc_imm(ALU_SCALE, n.lhs.ty, n.lhs.ty.base.size as i64, n.pos); }
	}
	ir_mov_acc_op2(n.pos);
	ir_pop_acc(n.pos);

	var op Node;
	op.kind = n.val as int;
	op.ty = n.lhs.ty;
	op.lhs = n.lhs;
	op.pos = n.pos;
	gen_binop(&op);

	ir_cast_acc(CAST_TRUNC, n.lhs.ty, n.pos);
	ir_pop_op2(n.pos);
	ir_store_op2_acc(n.lhs.ty, n.pos);
}


// An assignment written as a statement discards its result, so it can write
// straight to the slot without routing the value through rax.
// mov [rax], imm: a constant store needs no round trip through rax and no
// temporary for the address.
fn store_imm(ty *Type, v i64) {
	if (ty.size == 1) { b1(0xc6); modrm(0, 0, RAX); b1(v); return; }
	if (ty.size == 2) { b1(0x66); b1(0xc7); modrm(0, 0, RAX); b1(v); b1(v >> 8); return; }
	if (ty.size == 4) { b1(0xc7); modrm(0, 0, RAX); b4(v); return; }
	b1(0x48); b1(0xc7); modrm(0, 0, RAX); b4(v);
}


fn stmt_assign(n *Node) bool {
	if (!direct_local(n.lhs)) { return stmt_store_imm(n); }
	if (n.lhs.varp.has_reg && !in_reg(n.rhs, n.lhs.varp.reg) &&
	    gen_into(n.rhs, n.lhs.varp.reg)) {
		return true;
	}
	if (n.lhs.varp.has_reg && spine_ok(n.rhs, n.lhs.varp)) {
		emit_spine(n.rhs, n.lhs);
		return true;
	}
	var r *Node = n.rhs;
	if (r.lhs as i64 != 0 && r.lhs.kind == ND_VAR &&
	    r.lhs.varp as i64 == n.lhs.varp as i64 && r.rhs as i64 != 0) {
		if (stmt_update(n.lhs, r.kind, r.rhs)) { return true; }
	}
	// Below this point every path is a native x86 instruction issued straight
	// from the frontend, not through IR (mov_reg_imm/rbp_mem+b4) -- ARM64 and
	// RISC-V fall through to the general codegen path instead, which does go
	// through IR_MOV/IR_STORE.
	if (opt_target == TARGET_ARM64 || opt_target == TARGET_RISCV64) { return false; }
	if (n.rhs.kind != ND_NUM || !fits_imm32(n.rhs.val)) { return false; }
	if (n.rhs.val == 0 && !n.lhs.varp.has_reg) { return false; }
	if (n.lhs.varp.has_reg) {
		mov_reg_imm(n.lhs.varp.reg, n.rhs.val);
		return true;
	}
	rbp_mem(0xc7, 0, -(n.lhs.varp.offset as i64));
	b4(n.rhs.val);
	return true;
}


fn stmt_store_imm(n *Node) bool {
	if (n.rhs.kind != ND_NUM) { return false; }
	var ty *Type = n.lhs.ty;
	if (is_aggregate(ty)) { return false; }
	if (ty.size == 8 && !fits_imm32(n.rhs.val)) { return false; }
	if (n.lhs.kind == ND_VAR && n.lhs.varp.has_reg) { return false; }
	gen_addr(n.lhs);
	ir_store_acc_imm(ty, n.rhs.val, n.pos);
	return true;
}


// v op= e as a statement: fold the update into one instruction against the
// slot or register holding v, instead of loading it and storing it back.
// Only promoted locals take a computed operand: a local still in the frame may
// be aliased, and the slow path reads it before evaluating the right side.
fn stmt_update(v *Node, k int, e *Node) bool {
	if (!direct_local(v)) { return false; }
	if (v.ty.kind == TY_PTR) { return false; }
	if (is_float(v.ty)) { return false; }
	if (k != ND_ADD && k != ND_SUB && k != ND_BITAND && k != ND_BITOR && k != ND_BITXOR) {
		return false;
	}
	var dst IrOperand;
	if (v.varp.has_reg) { dst = operand_vreg(v.varp.reg, v.ty); }
	else { dst = operand_stackslot(v.varp.offset as i64, v.ty); }
	if (e.kind == ND_NUM && fits_imm32(e.val)) {
		ir_alu_rm_imm(alu_ir_for(k), dst, e.val, e.pos);
		return true;
	}
	if (direct_local(e) && e.varp.has_reg) {
		ir_alu_rm_reg(alu_ir_for(k), dst, operand_vreg(e.varp.reg, e.ty), e.pos);
		return true;
	}
	if (!v.varp.has_reg) { return false; }
	gen_expr(e);
	ir_alu_vreg_acc(alu_ir_for(k), v.varp.reg, v.varp.ty, e.pos);
	return true;
}


fn stmt_opassign(n *Node) bool {
	return stmt_update(n.lhs, n.val as int, n.rhs);
}


fn refs_var(e *Node, v *Var) bool {
	if (e as i64 == 0) { return false; }
	if (e.kind == ND_VAR && e.varp as i64 == v as i64) { return true; }
	if (refs_var(e.lhs, v) || refs_var(e.rhs, v)) { return true; }
	if (refs_var(e.cond, v) || refs_var(e.then, v) || refs_var(e.els, v)) { return true; }
	var a *Node = e.args;
	while (a as i64 != 0) {
		if (refs_var(a, v)) { return true; }
		a = a.next;
	}
	return false;
}


// v = ((v op a) op b) is v op= a; v op= b. Each step updates the register in
// place, so nothing is copied back at the end. Only promoted locals qualify:
// they cannot be aliased, and no operand may read v, or the rewrite would see
// a value the original expression had not produced yet.
fn spine_ok(e *Node, v *Var) bool {
	if (e.kind == ND_VAR) { return e.varp as i64 == v as i64; }
	var k int = e.kind;
	if (k != ND_ADD && k != ND_SUB && k != ND_BITAND && k != ND_BITOR && k != ND_BITXOR) {
		return false;
	}
	if (e.ty.size != 8 || e.ty.kind == TY_PTR) { return false; }
	if (is_float(e.ty)) { return false; }
	if (e.lhs.ty.kind == TY_PTR || e.rhs.ty.kind == TY_PTR) { return false; }
	if (refs_var(e.rhs, v)) { return false; }
	return spine_ok(e.lhs, v);
}


fn emit_spine(e *Node, dst *Node) {
	if (e.kind == ND_VAR) { return; }
	emit_spine(e.lhs, dst);
	gen_expr(e.rhs);
	ir_alu_vreg_acc(alu_ir_for(e.kind), dst.varp.reg, dst.varp.ty, e.pos);
}


fn gen_exprstmt(n *Node) {
	if (n.kind == ND_ASSIGN && stmt_assign(n)) { return; }
	if (n.kind == ND_OPASSIGN && stmt_opassign(n)) { return; }
	gen_expr(n);
}


// Folds a constant right operand into the instruction, which removes the
// materialise/push/pop sequence the stack machine would otherwise emit.
fn gen_binop_imm(n *Node, v i64) bool {
	var k int = n.kind;
	if (k == ND_ADD || k == ND_SUB || k == ND_BITAND || k == ND_BITOR ||
	    k == ND_BITXOR) {
		gen_expr(n.lhs);
		// Masking to a byte or a halfword is a zero-extending move; the
		// lowering picks it for a 255/65535 AND (see IR_ALU, src1 OP_IMM).
		ir_alu_acc_imm(alu_ir_for(k), n.ty, v, n.pos);
		return true;
	}
	if (k == ND_EQ || k == ND_NE || k == ND_LT || k == ND_LE) {
		gen_expr(n.lhs);
		ir_cmp_acc_imm(v, n.pos);
		ir_setcc_acc(cc_for_compare(n), n.pos);
		return true;
	}
	if (k == ND_SHL || k == ND_SHR) {
		if (v < 0 || v > 63) { return false; }
		gen_expr(n.lhs);
		var aop int = ALU_SHL;
		if (k == ND_SHR) { aop = ALU_SHR; }
		ir_alu_acc_imm(aop, n.ty, v, n.pos);
		return true;
	}
	if (k == ND_MUL) {
		gen_expr(n.lhs);
		ir_alu_acc_imm(ALU_MUL, n.ty, v, n.pos);
		return true;
	}
	return false;
}


fn simple_operand(n *Node) bool {
	if (n.kind == ND_NUM) { return fits_imm32(n.val); }
	return direct_local(n);
}


fn in_reg(n *Node, reg int) bool {
	return n.kind == ND_VAR && n.varp.has_reg && n.varp.reg == reg;
}


// Evaluate n straight into dst instead of through rax. Only side-effect-free
// operands qualify, and the right side must not live in dst, since the left
// side lands there first.
fn gen_into(n *Node, dst int) bool {
	if (n.kind == ND_NUM && fits_imm32(n.val)) { ir_mov_vreg_imm(dst, n.val, n.pos); return true; }
	if (direct_local(n)) {
		if (!in_reg(n, dst)) { ir_load_vreg_var(dst, n.varp, n.ty, n.pos); }
		return true;
	}
	var k int = n.kind;
	if (k != ND_ADD && k != ND_SUB && k != ND_BITAND && k != ND_BITOR && k != ND_BITXOR) {
		return false;
	}
	if (n.ty.kind == TY_PTR || n.lhs.ty.kind == TY_PTR || n.rhs.ty.kind == TY_PTR) {
		return false;
	}
	if (is_float(n.ty)) { return false; }
	if (!simple_operand(n.lhs) || !simple_operand(n.rhs)) { return false; }
	if (in_reg(n.rhs, dst)) { return false; }
	if (!gen_into(n.lhs, dst)) { return false; }
	if (n.rhs.kind == ND_NUM) {
		ir_alu_vreg_imm(alu_ir_for(k), dst, n.rhs.val, n.pos);
		return true;
	}
	ir_alu_vreg_rm(alu_ir_for(k), dst, n.rhs, n.pos);
	return true;
}


fn gen_binop_mem(n *Node, val *Node, rm *Node) bool {
	var k int = n.kind;
	var rop IrOperand = direct_operand(rm);
	gen_expr(val);
	if (k == ND_ADD)    { ir_alu_acc_rm(ALU_ADD, n.ty, rop, n.pos); return true; }
	if (k == ND_SUB)    { ir_alu_acc_rm(ALU_SUB, n.ty, rop, n.pos); return true; }
	if (k == ND_BITAND) { ir_alu_acc_rm(ALU_AND, n.ty, rop, n.pos); return true; }
	if (k == ND_BITOR)  { ir_alu_acc_rm(ALU_OR, n.ty, rop, n.pos); return true; }
	if (k == ND_BITXOR) { ir_alu_acc_rm(ALU_XOR, n.ty, rop, n.pos); return true; }
	if (k == ND_MUL)    { ir_alu_acc_rm(ALU_MUL, n.ty, rop, n.pos); return true; }
	ir_cmp_acc_rm(rop, n.pos);
	ir_setcc_acc(cc_for_compare(n), n.pos);
	return true;
}


fn mem_binop_ok(n *Node) bool {
	var k int = n.kind;
	if (k != ND_ADD && k != ND_SUB && k != ND_BITAND && k != ND_BITOR &&
	    k != ND_BITXOR && k != ND_MUL && k != ND_EQ && k != ND_NE &&
	    k != ND_LT && k != ND_LE) {
		return false;
	}
	return direct_local(n.rhs);
}


// For a commutative operator a direct local on the left folds in just as well,
// once the sides are evaluated the other way round.
fn swap_binop_ok(n *Node) bool {
	var k int = n.kind;
	if (k != ND_ADD && k != ND_BITAND && k != ND_BITOR && k != ND_BITXOR &&
	    k != ND_MUL && k != ND_EQ && k != ND_NE) {
		return false;
	}
	return direct_local(n.lhs) && !direct_local(n.rhs);
}


// An lvalue reached through a pointer is loaded only to be compared, so the
// comparison can read memory itself.
fn addressable_load(n *Node) bool {
	var k int = n.kind;
	if (k != ND_INDEX && k != ND_MEMBER && k != ND_DEREF) { return false; }
	return !is_aggregate(n.ty) && n.ty.kind != TY_SLICE;
}


fn fits_width(v i64, ty *Type) bool {
	if (!fits_imm32(v)) { return false; }
	if (ty.size >= 4) { return true; }
	if (ty.size == 2) { return v >= -32768 && v <= 32767; }
	return v >= -128 && v <= 255;
}


fn is_compare(n *Node) bool {
	var k int = n.kind;
	return k == ND_EQ || k == ND_NE || k == ND_LT || k == ND_LE;
}


// Emits the comparison and returns its setcc opcode, without materialising
// a boolean. Callers that only branch on the result skip setcc entirely.
fn gen_compare(n *Node) i64 {
	var lt *Type = n.lhs.ty;
	if (is_float(lt)) {
		gen_expr(n.rhs);
		ir_push_acc(n.pos);
		gen_expr(n.lhs);
		ir_pop_op2(n.pos);
		ir_cmp_op2_acc_float(lt, n.pos);
		return float_cc_neutral(n);
	}
	// Equality survives a widening cast, so the load under it can be compared
	// at its own width. Ordering cannot: the widened type decides the
	// signedness of the condition code.
	var mem *Node = n.lhs;
	if ((n.kind == ND_EQ || n.kind == ND_NE) && mem.kind == ND_CAST &&
	    is_integer(mem.ty) && is_integer(mem.lhs.ty) && mem.lhs.ty.size <= mem.ty.size) {
		mem = mem.lhs;
	}
	if (n.rhs.kind == ND_NUM && (mem.ty.kind != TY_PTR || n.rhs.val == 0) &&
	    fits_width(n.rhs.val, mem.ty) && addressable_load(mem)) {
		gen_addr(mem);
		ir_cmp_at_acc_imm(mem.ty, n.rhs.val, n.pos);
		return cc_for_compare(n);
	}
	if (n.rhs.kind == ND_NUM && fits_imm32(n.rhs.val) &&
	    (lt.kind != TY_PTR || n.rhs.val == 0)) {
		if (direct_local(n.lhs)) {
			ir_cmp_rm_imm(n.lhs, n.rhs.val, n.pos);
			return cc_for_compare(n);
		}
		gen_expr(n.lhs);
		ir_cmp_acc_imm(n.rhs.val, n.pos);
		return cc_for_compare(n);
	}
	if (lt.kind != TY_PTR && direct_local(n.rhs)) {
		gen_expr(n.lhs);
		ir_cmp_acc_rm(direct_operand(n.rhs), n.pos);
		return cc_for_compare(n);
	}
	gen_expr(n.rhs);
	ir_push_acc(n.pos);
	gen_expr(n.lhs);
	ir_pop_op2(n.pos);
	ir_cmp_op2_acc(n.pos);
	return cc_for_compare(n);
}


// The switch has to be a real function: its trailing ret consumes the
// return address that the call pushed onto whichever stack is current,
// which is exactly how control lands back where a coroutine left off.
fn gen_coro_switch(n *Node) {
	gen_args(n, false, false, -1, false);
	if (opt_target == TARGET_RISCV64) {
		b4(0x6f | (RA << 7));  // jal ra placeholder, patched in finalize like a direct call
		ilist_push(&coro_switch_refs, code.n - 4);
		return;
	}
	if (opt_target == TARGET_ARM64) {
		b4(0x94000000);  // bl placeholder, patched in finalize like a direct call
		ilist_push(&coro_switch_refs, code.n - 4);
		return;
	}
	b1(0xe8);
	ilist_push(&coro_switch_refs, code.n);
	b4(0);
}


fn ir_branch(cc i64, label i64, pos i64) {
	var op *IrOp = ir_emit(IR_BR, pos);
	op.dst = operand_imm(label);
	op.aux = cc;
}


fn ir_label(label i64, pos i64) {
	var op *IrOp = ir_emit(IR_LABEL, pos);
	op.dst = operand_imm(label);
}


// The language-level call. Argument staging stays in the frontend (gen_args
// classifies into the ABI's register slots); the IR_CALL carries only the
// target -- OP_FUNC for a direct call, an OP_VREG/OP_GLOBAL/OP_STACKSLOT
// holding the address for an indirect one -- and the backend emits the call
// instruction plus whatever target load its own convention requires.
fn ir_call(f *Func, pos i64) {
	var op *IrOp = ir_emit(IR_CALL, pos);
	op.src0 = operand_func(f);
}


fn ir_call_ind(target IrOperand, pos i64) {
	var op *IrOp = ir_emit(IR_CALL, pos);
	op.src0 = target;
}


fn ir_funcaddr(f *Func, pos i64) {
	var op *IrOp = ir_emit(IR_FUNCADDR, pos);
	op.dst = operand_acc();
	op.src0 = operand_func(f);
}


fn ir_ret(pos i64) {
	ir_emit(IR_RET, pos);
}


fn ir_setcc_acc(cc i64, pos i64) {
	var op *IrOp = ir_emit(IR_SETCC, pos);
	op.dst = operand_acc();
	op.aux = cc;
}


fn ir_syscall(pos i64) {
	ir_emit(IR_SYSCALL, pos);
}


fn ir_mov_acc_imm(v i64, pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_acc();
	op.src0 = operand_imm(v);
}


fn ir_mov_acc_str(id int, pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_acc();
	op.src0 = operand_str(id);
}


fn ir_mov_acc_global(v *Var, pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_acc();
	op.src0 = operand_global(v);
}


// The accumulator holds an address (gen_addr's job); load through it into the
// accumulator, widening per ty.
fn ir_load_acc(ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_LOAD, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_acc();
}


// A direct scalar local: load its home (register or frame slot) into the
// accumulator, exactly as ld_rm did.
fn ir_load_var(v *Var, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_LOAD, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	if (v.has_reg) { op.src0 = operand_vreg(v.reg, ty); }
	else { op.src0 = operand_stackslot(v.offset as i64, ty); }
}


// rax = base + index*scale + disp, the INDEX address form. base is OP_ACC
// (array) or OP_OP2 (slice); index is OP_ACC/OP_OP2/OP_VREG, or OP_NONE for a
// plain constant fold. aux carries the element scale, dst.off the fixed
// displacement.
fn ir_lea_acc(base IrOperand, index IrOperand, scale int, disp i64, pos i64) {
	var op *IrOp = ir_emit(IR_LEA, pos);
	op.dst = operand_acc();
	op.dst.off = disp;
	op.src0 = base;
	op.src1 = index;
	op.aux = scale as i64;
}


// The INDEX path's index register is the OP2 staging slot, or a promoted
// local that can be the lea index directly.
fn operand_index(reg int) IrOperand {
	if (reg == op2_reg(0)) { return operand_op2(0); }
	return operand_vreg(reg, null);
}


fn ir_unary_acc(uop int, pos i64) {
	var op *IrOp = ir_emit(IR_UNARY, pos);
	op.dst = operand_acc();
	op.src0 = operand_acc();
	op.aux = uop as i64;
}


// A cast applied to the value already sitting in the accumulator, in place.
fn ir_cast_acc(ck int, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_CAST, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_acc();
	op.aux = ck as i64;
}


// The left operand is already in the accumulator and the right in the
// target's OP2 staging register (x86: rdi), per gen_expr's binop preamble
// (spine emission / gen_binop_mem's operand setup) -- this just records that
// shape as IR and lowers it immediately.
fn ir_alu_acc(aop int, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_ALU, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_acc();
	op.src1 = operand_op2(0);
	op.aux = aop as i64;
}


fn ir_compare_acc(cc i64, pos i64) {
	var c *IrOp = ir_emit(IR_CMP, pos);
	c.src0 = operand_acc();
	c.src1 = operand_op2(0);
	var s *IrOp = ir_emit(IR_SETCC, pos);
	s.dst = operand_acc();
	s.aux = cc;
}


fn ir_mov_vreg_imm(reg int, v i64, pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_vreg(reg, null);
	op.src0 = operand_imm(v);
}


// Load a direct local into a fixed register instead of through the
// accumulator -- gen_into's register-targeted evaluation, ld_rm's bytes.
fn ir_load_vreg_var(dst int, v *Var, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_LOAD, pos);
	op.dst = operand_vreg(dst, ty);
	if (v.has_reg) { op.src0 = operand_vreg(v.reg, ty); }
	else { op.src0 = operand_stackslot(v.offset as i64, ty); }
}


// reg op= imm, gen_into's immediate arm.
fn ir_alu_vreg_imm(aop int, reg int, v i64, pos i64) {
	var op *IrOp = ir_emit(IR_ALU, pos);
	op.dst = operand_vreg(reg, null);
	op.src0 = operand_vreg(reg, null);
	op.src1 = operand_imm(v);
	op.aux = aop;
}


// reg op= <rhs as r/m>, gen_into's register-rm arm; rhs is a direct local.
fn ir_alu_vreg_rm(aop int, reg int, n *Node, pos i64) {
	var op *IrOp = ir_emit(IR_ALU, pos);
	op.dst = operand_vreg(reg, null);
	op.src0 = operand_vreg(reg, null);
	if (n.varp.has_reg) { op.src1 = operand_vreg(n.varp.reg, n.ty); }
	else { op.src1 = operand_stackslot(n.varp.offset as i64, n.ty); }
	op.aux = aop;
}


// The accumulator already holds the store's target address (gen_addr's
// job), matching how store()/store_imm() already dereference RAX today.
fn ir_store_acc_imm(ty *Type, v i64, pos i64) {
	var op *IrOp = ir_emit(IR_STORE, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_imm(v);
}


fn ir_store_stackslot_acc(off i64, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_STORE, pos);
	op.dst = operand_stackslot(off, ty);
	op.src0 = operand_acc();
}


fn ir_store_vreg_acc(reg int, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_STORE, pos);
	op.dst = operand_vreg(reg, ty);
	op.src0 = operand_acc();
}


// Zero <size> bytes at a frame slot (ND_ZERO's aggregate path).
fn ir_memset_stackslot(off i64, size i64, pos i64) {
	var op *IrOp = ir_emit(IR_MEMSET, pos);
	op.dst = operand_stackslot(off, null);
	op.aux = size;
}


// The stack-machine staging: push the accumulator, pop into the OP2 register
// (a binop's right side). depth tracks the 16-byte call alignment exactly as
// push_reg/pop_reg did, so gen_call's odd-depth fixup is unaffected while the
// frontend still emits bytes; once it does not, the backend derives the same
// count by walking IR_PUSH/IR_POP itself.
fn ir_push_acc(pos i64) {
	var op *IrOp = ir_emit(IR_PUSH, pos);
	op.src0 = operand_acc();
	depth = depth + 1;
}


fn ir_pop_op2(pos i64) {
	var op *IrOp = ir_emit(IR_POP, pos);
	op.dst = operand_op2(0);
	depth = depth - 1;
}


fn ir_pop_acc(pos i64) {
	var op *IrOp = ir_emit(IR_POP, pos);
	op.dst = operand_acc();
	depth = depth - 1;
}


// lea <op2_reg>, [rbp - off]: a field address in the staging register.
fn ir_lea_op2_slot(off i64, pos i64) {
	var op *IrOp = ir_emit(IR_LEA, pos);
	op.dst = operand_op2(0);
	op.src0 = operand_stackslot(off, null);
	op.src1 = operand_none();
	op.aux = 1;
}


// lea rax, [rbp - off]: an aggregate literal's own address.
fn ir_lea_slot_acc(off i64, pos i64) {
	var op *IrOp = ir_emit(IR_LEA, pos);
	op.dst = operand_acc();
	op.src0 = operand_stackslot(off, null);
	op.src1 = operand_none();
	op.aux = 1;
}


fn ir_tlsaddr(v *Var, pos i64) {
	var op *IrOp = ir_emit(IR_TLSADDR, pos);
	op.dst = operand_acc();
	op.src0 = operand_tlsvar(v);
}


// A stack-passed parameter's slot: off is a positive rbp displacement, stored
// negated so the STACKSLOT lowering reproduces it as written.
fn ir_lea_arg_acc(off i64, pos i64) {
	var op *IrOp = ir_emit(IR_LEA, pos);
	op.dst = operand_acc();
	op.src0 = operand_stackslot(-off, null);
	op.src1 = operand_none();
	op.aux = 0;
}


// A by-ref stack-passed parameter: load the pointer value from its slot.
fn ir_load_arg_acc(off i64, pos i64) {
	var op *IrOp = ir_emit(IR_LOAD, pos);
	op.dst = operand_acc();
	op.dst.ty = type_ptr(ty_i64);
	op.src0 = operand_stackslot(-off, null);
}


fn ir_push_op2(pos i64) {
	var op *IrOp = ir_emit(IR_PUSH, pos);
	op.src0 = operand_op2(0);
	depth = depth + 1;
}


// push [rax + off] -- a two-word aggregate argument's word, staged whole.
fn ir_push_at_acc(off i64, pos i64) {
	var op *IrOp = ir_emit(IR_PUSH, pos);
	op.src0 = operand_mem(off, null);
	depth = depth + 1;
}


// gen_args' by-ref argument staging: copy <size> bytes from the address in the
// accumulator to the frame slot at <off>, leaving the slot's address in the
// accumulator (the by-value pointer argument).
fn ir_memcpy_dst(off i64, size i64, pos i64) {
	var op *IrOp = ir_emit(IR_MEMCPYDST, pos);
	op.dst = operand_stackslot(off, null);
	op.src0 = operand_acc();
	op.aux = size;
}


// copy <size> bytes from the address in the accumulator to the destination
// address pushed on the staging stack; the destination address is left in the
// accumulator. Consumes one staging entry.
fn ir_memcpy_stage(size i64, pos i64) {
	var op *IrOp = ir_emit(IR_MEMCPY, pos);
	op.src0 = operand_acc();
	op.aux = size;
	depth = depth - 1;
}


// gen_ret's sret copy: copy <size> bytes from the address in the accumulator
// to the pointer stored in the frame slot at <off>, leaving the slot's pointer
// in the accumulator. No staging traffic.
fn ir_memcpy_slot(off i64, size i64, pos i64) {
	var op *IrOp = ir_emit(IR_MEMCPY, pos);
	op.dst = operand_stackslot(off, null);
	op.src0 = operand_acc();
	op.aux = size;
}


// gen_ret's register-returned aggregate: the address in the accumulator, the
// two words pulled into the accumulator and the second-value register.
fn ir_load2(size i64, pos i64) {
	var op *IrOp = ir_emit(IR_LOAD2, pos);
	op.aux = size;
}


// gen_call's aggregate-result staging: spill the two words to the temp slot
// at <off> and hand back its address.
fn ir_store2(off i64, size i64, pos i64) {
	var op *IrOp = ir_emit(IR_STORE2, pos);
	op.dst = operand_stackslot(off, null);
	op.aux = size;
}


fn ir_push_reg(reg int, pos i64) {
	var op *IrOp = ir_emit(IR_PUSH, pos);
	op.src0 = operand_reg(reg);
	depth = depth + 1;
}


fn ir_pop_reg(reg int, pos i64) {
	var op *IrOp = ir_emit(IR_POP, pos);
	op.dst = operand_reg(reg);
	depth = depth - 1;
}


// acc += v, the address-form small add (IR_LEA acc,acc,0).
fn ir_add_acc_imm(v i64, pos i64) {
	var op *IrOp = ir_emit(IR_LEA, pos);
	op.dst = operand_acc();
	op.dst.off = v;
	op.src0 = operand_acc();
	op.src1 = operand_none();
	op.aux = 1;
}


// mov <op2_reg>, rax -- the frontend's "evaluate into the staging register".
fn ir_mov_acc_op2(pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_op2(0);
	op.src0 = operand_acc();
}


// The right operand is an immediate folded into the instruction (a constant
// binop, gen_binop_imm's fast path).
fn ir_alu_acc_imm(aop int, ty *Type, v i64, pos i64) {
	var op *IrOp = ir_emit(IR_ALU, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_acc();
	op.src1 = operand_imm(v);
	op.aux = aop as i64;
}


// The right operand is a direct local (promoted register or frame slot),
// read as one r/m operand -- gen_binop_mem's fast path.
fn ir_alu_acc_rm(aop int, ty *Type, src IrOperand, pos i64) {
	var op *IrOp = ir_emit(IR_ALU, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_acc();
	op.src1 = src;
	op.aux = aop as i64;
}


fn ir_alu_rm_imm(aop int, dst IrOperand, v i64, pos i64) {
	var op *IrOp = ir_emit(IR_ALU, pos);
	op.dst = dst;
	op.src0 = dst;
	op.src1 = operand_imm(v);
	op.aux = aop as i64;
}


fn ir_alu_rm_reg(aop int, dst IrOperand, src IrOperand, pos i64) {
	var op *IrOp = ir_emit(IR_ALU, pos);
	op.dst = dst;
	op.src0 = dst;
	op.src1 = src;
	op.aux = aop as i64;
}


// stmt_update: <v.reg> op= rax, after gen_expr left the right side in the
// accumulator.
fn ir_alu_vreg_acc(aop int, reg int, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_ALU, pos);
	op.dst = operand_vreg(reg, ty);
	op.src0 = op.dst;
	op.src1 = operand_acc();
	op.aux = aop as i64;
}


fn ir_cmp_acc_imm(v i64, pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = operand_acc();
	op.src1 = operand_imm(v);
}


fn ir_cmp_acc_rm(src IrOperand, pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = operand_acc();
	op.src1 = src;
}


fn ir_cmp_rm_imm(n *Node, v i64, pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = direct_operand(n);
	op.src1 = operand_imm(v);
}


// cmp <width> [rax], imm -- gen_compare's addressable_load path; gen_addr put
// the address in the accumulator.
fn ir_cmp_at_acc_imm(ty *Type, v i64, pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = operand_mem(0, ty);
	op.src1 = operand_imm(v);
}


// cmp <op2_reg>, rax -- gen_compare's generic staging: rhs pushed, then popped
// into op2 after lhs landed in the accumulator.
fn ir_cmp_op2_acc(pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = operand_acc();
	op.src1 = operand_op2(0);
}


// ucomisd's compare -- the float version of the generic staging above; the
// operand's float type makes the lowering pick the SSE path.
fn ir_cmp_op2_acc_float(ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = operand_acc();
	op.src0.ty = ty;
	op.src1 = operand_op2(0);
}


// mov <op2_reg>, v -- a float negation's sign mask, staged.
fn ir_mov_op2_imm(v i64, pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_op2(0);
	op.src0 = operand_imm(v);
}


// A float conversion on the accumulator's bits: st (the source type) rides in
// op.src0.ty, dt (the destination type) in op.dst.ty.
fn ir_cast_float(ck int, st *Type, dt *Type, pos i64) {
	var op *IrOp = ir_emit(IR_CAST, pos);
	op.dst = operand_acc();
	op.dst.ty = dt;
	op.src0 = operand_acc();
	op.src0.ty = st;
	op.aux = ck as i64;
}


// A bounds-check trip: the condition code that jumps to the function-end
// bounds trampoline.
fn ir_bounds(cc i64, pos i64) {
	var op *IrOp = ir_emit(IR_BOUNDS, pos);
	op.aux = cc;
}


// assert's site: the message string-literal id rides in aux.
fn ir_assert(msg i64, pos i64) {
	var op *IrOp = ir_emit(IR_ASSERT, pos);
	op.aux = msg;
}


// mov <op2>, [rax + off] -- a slice field, copied to the staging register.
fn ir_load_at_acc_op2(off i64, pos i64) {
	var op *IrOp = ir_emit(IR_LOAD, pos);
	op.dst = operand_op2(0);
	op.src0 = operand_acc();
	op.src0.off = off;
}


// mov <op2>, <direct local> -- ND_INDEX's staged index.
fn ir_load_op2_var(v *Var, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_LOAD, pos);
	op.dst = operand_op2(0);
	if (v.has_reg) { op.src0 = operand_vreg(v.reg, ty); }
	else { op.src0 = operand_stackslot(v.offset as i64, ty); }
}


// mov [rbp - off], <op2> -- a slice's field landed in the staging register.
fn ir_store_op2_slot(off i64, pos i64) {
	var op *IrOp = ir_emit(IR_STORE, pos);
	op.dst = operand_stackslot(off, null);
	op.src0 = operand_op2(0);
}


// cmp <op2_reg>, rax -- ND_SLICE's start-vs-end bounds check, the reverse
// of the acc-vs-op2 staging form above.
fn ir_cmp_op2_acc_rev(pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = operand_op2(0);
	op.src1 = operand_acc();
}


// mov rax, <op2> -- ND_SLICE restores the start index before scaling.
fn ir_mov_op2_acc(pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_acc();
	op.src0 = operand_op2(0);
}


// A direct local into the accumulator from its frame slot.
fn ir_load_slot_acc(off i64, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_LOAD, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_stackslot(off, ty);
}


// cmp rax, imm32 with the accumulator's forced 32-bit form (48 3d) -- the
// bounds checks emit it unconditionally, unlike the imm8-choosing fast path.
fn ir_cmp_acc_imm32(v i64, pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = operand_acc();
	op.src1 = operand_imm(v);
	op.aux = 1;
}


fn ir_cmp_op2_imm32(v i64, pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = operand_op2(0);
	op.src1 = operand_imm(v);
	op.aux = 1;
}


fn ir_cmp_rm_imm32(n *Node, v i64, pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = direct_operand(n);
	op.src1 = operand_imm(v);
	op.aux = 1;
}


// store [op2_reg], rax at ty's width (the value is in the accumulator).
fn ir_store_op2_acc(ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_STORE, pos);
	op.dst = operand_op2(0);
	op.dst.ty = ty;
	op.src0 = operand_acc();
}


fn gen_expr(n *Node) {
	var k int = n.kind;

	if (k == ND_NUM) { ir_mov_acc_imm(n.val, n.pos); return; }
	if (k == ND_STRLIT) { ir_mov_acc_str(n.val as int, n.pos); return; }
	if (k == ND_COMPTIME) { ir_mov_acc_imm(n.val, n.pos); return; }
	if (k == ND_SIZEOF) { ir_mov_acc_imm(n.typeval.size as i64, n.pos); return; }
	if (k == ND_VAR) {
		if (direct_local(n)) { ir_load_var(n.varp, n.ty, n.pos); return; }
		gen_lvalue(n);
		return;
	}
	if (k == ND_MEMBER || k == ND_INDEX || k == ND_SLICE) {
		gen_lvalue(n);
		return;
	}
	if (k == ND_ADDR) { gen_addr(n.lhs); return; }
	if (k == ND_DEREF) {
		gen_expr(n.lhs);
		if (!is_aggregate(n.ty)) { ir_load_acc(n.ty, n.pos); }
		return;
	}
	if (k == ND_CAST) {
		gen_expr(n.lhs);
		// An enum expression is an address (an enum is an aggregate), so
		// a numeric or boolean cast must mean the tag -- the first word
		// of its memory -- not the address itself. A pointer target keeps
		// the address (it points at the value).
		if (n.lhs.ty.kind == TY_ENUM && n.ty.kind != TY_PTR) {
			ir_load_acc(ty_i64, n.pos);
		}
		if (n.val == 1) {
			// A bit-reinterpret, not a numeric conversion: the raw bits
			// already sit in RAX exactly as they should (see type_interp).
		} else if (n.ty.kind == TY_BOOL) {
			ir_cast_acc(CAST_BOOL, n.ty, n.pos);
		} else if (is_float(n.ty) || is_float(n.lhs.ty)) {
			gen_cast_float(n);
		} else {
			ir_cast_acc(CAST_TRUNC, n.ty, n.pos);
		}
		return;
	}
	if (k == ND_ASSIGN) {
		if (direct_local(n.lhs)) {
			gen_expr(n.rhs);
			if (n.lhs.varp.has_reg) {
				ir_store_vreg_acc(n.lhs.varp.reg, n.lhs.ty, n.pos);
			} else {
				ir_store_stackslot_acc(n.lhs.varp.offset as i64, n.lhs.ty, n.pos);
			}
			return;
		}
		gen_addr(n.lhs);
		ir_push_acc(n.pos);
		gen_expr(n.rhs);
		if (is_aggregate(n.lhs.ty)) {
			ir_memcpy_stage(n.lhs.ty.size as i64, n.pos);
		} else {
			ir_pop_op2(n.pos);
			ir_store_op2_acc(n.lhs.ty, n.pos);
		}
		return;
	}
	if (k == ND_OPASSIGN) { gen_opassign(n); return; }
	if (k == ND_ENUMLIT) { gen_enumlit(n); return; }
	if (k == ND_STRUCTLIT) { gen_structlit(n); return; }
	if (k == ND_ZERO) {
		if (n.varp.has_reg) { ir_mov_vreg_imm(n.varp.reg, 0, n.pos); return; }
		var off i64 = n.varp.offset as i64;
		var size int = n.varp.ty.size;
		if (size <= 8 && !is_aggregate(n.varp.ty)) {
			ir_mov_acc_imm(0, n.pos);
			ir_store_stackslot_acc(off, n.varp.ty, n.pos);
		} else {
			ir_memset_stackslot(off, size as i64, n.pos);
		}
		return;
	}
	if (k == ND_COMMA) { gen_expr(n.lhs); gen_expr(n.rhs); return; }
	if (k == ND_NEG) {
		gen_expr(n.lhs);
		if (is_float(n.ty)) { gen_neg_float(n.ty.size, n.pos); return; }
		ir_unary_acc(UOP_NEG, n.pos);
		return;
	}
	if (k == ND_BITNOT) {
		gen_expr(n.lhs);
		ir_unary_acc(UOP_BITNOT, n.pos);
		return;
	}
	if (k == ND_NOT) {
		gen_expr(n.lhs);
		ir_unary_acc(UOP_LNOT, n.pos);
		return;
	}
	if (k == ND_SYSCALL) {
		gen_args(n, true, true, -1, false);
		ir_syscall(n.pos);
		return;
	}
	if (k == ND_ASM) {
		gen_asm_operands(n.args);
		return;
	}
	if (k == ND_ASSERT) { gen_assert(n); return; }
	if (k == ND_FUNCADDR) {
		// add_type resolved the name to a real function (or errored), so
		// this is a straight address; the fallback keeps an odd case from
		// crashing where the type checker let something through.
		var ff *Func = find_func(n.name);
		if (ff as i64 != 0) { ir_funcaddr(ff, n.pos); }
		else { add_funcaddr(n.name, n.pos); }
		return;
	}
	if (k == ND_CALL) {
		if (str_eq(n.name, "coro_switch")) { gen_coro_switch(n); return; }
		if (str_eq(n.name, "gc_data_base") || str_eq(n.name, "gc_data_end")) {
			if (opt_target == TARGET_RISCV64) { riscv_gen_gc_bound(n, str_eq(n.name, "gc_data_base")); return; }
			if (opt_target == TARGET_ARM64) { gen_gc_bound(n, str_eq(n.name, "gc_data_base")); return; }
			rex_w(0, RAX);
			b1(0xb8);
			if (str_eq(n.name, "gc_data_base")) { ilist_push(&gc_base_refs, code.n); }
			else { ilist_push(&gc_end_refs, code.n); }
			buf_u64(&code, 0);
			return;
		}
		if (str_eq(n.name, "gc_save_regs")) {
			if (opt_target == TARGET_RISCV64) { riscv_gen_gc_save_regs(n); return; }
			if (opt_target == TARGET_ARM64) { gen_gc_save_regs(n); return; }
			gen_args(n, false, false, -1, false);
			b1(0x48); b1(0x89); b1(0x1f);            // mov [rdi], rbx
			b1(0x48); b1(0x89); b1(0x6f); b1(0x08);  // mov [rdi+8], rbp
			b1(0x4c); b1(0x89); b1(0x67); b1(0x10);  // mov [rdi+16], r12
			b1(0x4c); b1(0x89); b1(0x6f); b1(0x18);  // mov [rdi+24], r13
			b1(0x4c); b1(0x89); b1(0x77); b1(0x20);  // mov [rdi+32], r14
			b1(0x4c); b1(0x89); b1(0x7f); b1(0x28);  // mov [rdi+40], r15
			return;
		}
		if (str_eq(n.name, "coro_entry_addr")) {
			if (opt_target == TARGET_RISCV64) { riscv_gen_coro_entry_addr(); return; }
			if (opt_target == TARGET_ARM64) { gen_coro_entry_addr(); return; }
			rex_w(0, RAX);
			b1(0xb8);
			ilist_push(&coro_stub_refs, code.n);
			buf_u64(&code, 0);
			return;
		}
		if (str_eq(n.name, "cli") || str_eq(n.name, "sti") || str_eq(n.name, "hlt") ||
		    str_eq(n.name, "outb") || str_eq(n.name, "outw") || str_eq(n.name, "outl") ||
		    str_eq(n.name, "inb") || str_eq(n.name, "inw") || str_eq(n.name, "inl") ||
		    str_eq(n.name, "lgdt") || str_eq(n.name, "lidt") || str_eq(n.name, "invlpg") ||
		    str_eq(n.name, "write_cr3") || str_eq(n.name, "read_cr2") ||
		    str_eq(n.name, "read_cr3") || str_eq(n.name, "rdmsr") || str_eq(n.name, "wrmsr")) {
			gen_machine(n);
			return;
		}
		if (str_eq(n.name, "atomic_cas")) {
			if (opt_target == TARGET_RISCV64) { riscv_gen_atomic_cas(n); return; }
			if (opt_target == TARGET_ARM64) { gen_atomic_cas(n); return; }
			gen_args(n, false, false, -1, false);
			mov_reg_reg(RAX, RSI);       // rax = expected
			b1(0xf0);                    // lock
			rex_w(RDX, RDI);
			b1(0x0f); b1(0xb1);
			modrm(0, RDX, RDI);          // cmpxchg [rdi], rdx
			setcc(0x94);                 // rax = (old == expected)
			return;
		}
		if (str_eq(n.name, "atomic_add")) {
			if (opt_target == TARGET_RISCV64) { riscv_gen_atomic_add(n); return; }
			if (opt_target == TARGET_ARM64) { gen_atomic_add(n); return; }
			gen_args(n, false, false, -1, false);
			b1(0xf0);                    // lock
			rex_w(RSI, RDI);
			b1(0x0f); b1(0xc1);
			modrm(0, RSI, RDI);          // xadd [rdi], rsi
			mov_reg_reg(RAX, RSI);       // rax = old value
			return;
		}
		if (str_eq(n.name, "atomic_load")) {
			if (opt_target == TARGET_RISCV64) {
				gen_args(n, false, false, -1, false);
				riscv_ld_at(A0, A0, 0);      // ld a0, 0(a0)
				return;
			}
			if (opt_target == TARGET_ARM64) {
				gen_args(n, false, false, -1, false);
				arm64_ldar(X0, X0);      // ldar x0, [x0]
				return;
			}
			gen_args(n, false, false, -1, false);
			rex_w(RAX, RDI);
			b1(0x8b);
			modrm(0, RAX, RDI);          // mov rax, [rdi]
			return;
		}
		if (str_eq(n.name, "atomic_store")) {
			if (opt_target == TARGET_RISCV64) {
				gen_args(n, false, false, -1, false);
				riscv_str_off(A1, A0, 0);    // sd a1, 0(a0)
				return;
			}
			if (opt_target == TARGET_ARM64) {
				gen_args(n, false, false, -1, false);
				arm64_stlr(X1, X0);      // stlr x1, [x0]
				return;
			}
			gen_args(n, false, false, -1, false);
			rex_w(RSI, RDI);
			b1(0x89);
			modrm(0, RSI, RDI);          // mov [rdi], rsi
			return;
		}
		if (str_eq(n.name, "fence")) {
			if (opt_target == TARGET_RISCV64) { riscv_fence(); return; }
			if (opt_target == TARGET_ARM64) { arm64_dmb(); return; }
			b1(0x0f); b1(0xae); b1(0xf0); // mfence
			return;
		}
		if (str_eq(n.name, "thread_clone")) {
			if (opt_target == TARGET_RISCV64) { gen_thread_clone_riscv(n); return; }
			if (opt_target == TARGET_ARM64) { gen_thread_clone_arm64(n); return; }
			gen_thread_clone(n);
			return;
		}
		if (str_eq(n.name, "tls_init")) {
			// The placeholder site must be captured after any pending IR
			// flushes: b4() flushes before appending, so a ref pushed with
			// the pre-flush code.n would patch the wrong word (an earlier
			// statement's promoted-local moves) and the real placeholder
			// would keep its zero displacement -- a bl to itself, pinned
			// by tests/tlsreg.qela under qemu-aarch64.
			ir_flush();
			if (opt_target == TARGET_RISCV64) {
				ilist_push(&tls_init_refs, code.n);
				b4(0x6f | (RA << 7));        // jal ra, <tls init stub>
				return;
			}
			if (opt_target == TARGET_ARM64) {
				ilist_push(&tls_init_refs, code.n);
				b4(0x94000000);          // bl <tls init stub>
				return;
			}
			b1(0xe8);
			ilist_push(&tls_init_refs, code.n);
			b4(0);
			return;
		}
		gen_call(n);
		return;
	}
	if (k == ND_AND || k == ND_OR) { gen_logical(n); return; }
	if (k == ND_IN || k == ND_ARRCOMP) {
		// The hidden chain (hoisted collection, scan or collection loop)
		// runs first; `.lhs` is the value expression that follows it.
		if (n.init as i64 != 0) {
			var si *Node = n.init;
			while (si as i64 != 0) { gen_stmt(si); si = si.next; }
		}
		gen_expr(n.lhs);
		return;
	}
	if (k == ND_IFEXPR) {
		// `a if c else b`: a branch in expression position, both sides
		// one machine word.
		var els i64 = ir_new_label();
		branch_false(n.cond, els);
		gen_expr(n.then);
		var end i64 = ir_new_label();
		ir_branch(CC_ALWAYS, end, n.pos);
		ir_label(els, n.pos);
		gen_expr(n.els);
		ir_label(end, n.pos);
		return;
	}

	var lt *Type = n.lhs.ty;
	var rt *Type = n.rhs.ty;
	var ptr_diff bool = k == ND_SUB && lt.kind == TY_PTR && rt.kind == TY_PTR;

	var k2 int = n.kind;
	if (!is_float(lt) && n.rhs.kind == ND_NUM && !ptr_diff && !(lt.kind == TY_PTR && k2 != ND_ADD && k2 != ND_SUB && n.rhs.val != 0)) {
		var v i64 = n.rhs.val;
		if (lt.kind == TY_PTR) {
			if (k2 != ND_ADD && k2 != ND_SUB) { v = v; }
			else { v = v * (lt.base.size as i64); }
		}
		if (fits_imm32(v) && gen_binop_imm(n, v)) { return; }
	}

	if (!is_float(lt) && !ptr_diff && lt.kind != TY_PTR && mem_binop_ok(n)) {
		if (gen_binop_mem(n, n.lhs, n.rhs)) { return; }
	}
	if (!is_float(lt) && !ptr_diff && lt.kind != TY_PTR && rt.kind != TY_PTR && swap_binop_ok(n)) {
		if (gen_binop_mem(n, n.rhs, n.lhs)) { return; }
	}

	gen_expr(n.rhs);
	if (!ptr_diff && lt.kind == TY_PTR && rt.kind != TY_PTR) {
		if (lt.base.size != 1) { ir_alu_acc_imm(ALU_SCALE, n.ty, lt.base.size as i64, n.pos); }
	}
	ir_push_acc(n.pos);
	gen_expr(n.lhs);
	ir_pop_op2(n.pos);
	gen_binop(n);

	if (ptr_diff) {
		ir_alu_acc_imm(ALU_DIV, n.ty, lt.base.size as i64, n.pos);
	}
}


fn run_defers(ds *DeferScope) {
	var d *Node = ds.list;
	while (d as i64 != 0) {
		gen_stmt(d.lhs);
		d = d.els;
	}
}


fn any_defers() bool {
	var ds *DeferScope = cur_defers;
	while (ds as i64 != 0) {
		if (ds.list as i64 != 0) { return true; }
		ds = ds.prev;
	}
	return false;
}


fn unwind_to(target int) {
	var ds *DeferScope = cur_defers;
	while (ds as i64 != 0 && ds.depth > target) {
		run_defers(ds);
		ds = ds.prev;
	}
}


fn gen_match(n *Node) {
	var soff i64 = n.tmp.offset as i64;
	gen_addr(n.cond);
	ir_store_stackslot_acc(soff, type_ptr(ty_i64), n.pos);

	var end i64 = ir_new_label();
	var arm *Node = n.body;
	while (arm as i64 != 0) {
		var miss i64 = -1;
		if (arm.name.len != 0) {
			if (opt_target == TARGET_ARM64 || opt_target == TARGET_RISCV64) {
				ir_load_slot_acc(soff, type_ptr(ty_i64), arm.pos);
				ir_load_acc(ty_i64, arm.pos);
				ir_cmp_acc_imm(arm.variant.tag as i64, arm.pos);
			} else {
				ld_local(RAX, soff);
				b1(0x48); b1(0x83);
				modrm(0, 7, RAX);
				b1(arm.variant.tag as i64);
			}
			miss = ir_new_label();
			ir_branch(CC_NE, miss, arm.pos);
		}

		var f *Member = null;
		if (arm.variant as i64 != 0) { f = arm.variant.fields; }
		var b *Node = arm.args;
		while (b as i64 != 0) {
			ir_lea_op2_slot(b.varp.offset as i64, b.pos);
			ir_push_op2(b.pos);
			ir_load_var(n.tmp, type_ptr(ty_i64), b.pos);
			ir_add_acc_imm(f.offset as i64, b.pos);
			if (is_aggregate(f.ty)) {
				ir_memcpy_stage(f.ty.size as i64, b.pos);
			} else {
				ir_load_acc(f.ty, b.pos);
				ir_pop_op2(b.pos);
				ir_store_op2_acc(f.ty, b.pos);
			}
			f = f.next;
			b = b.next;
		}

		gen_stmt(arm.body);
		if (arm.next as i64 != 0) { ir_branch(CC_ALWAYS, end, arm.pos); }
		if (miss >= 0) { ir_label(miss, arm.pos); }
		arm = arm.next;
	}
	ir_label(end, n.pos);
}


fn gen_block(n *Node) {
	var ds DeferScope;
	defer_depth = defer_depth + 1;
	ds.prev = cur_defers;
	ds.depth = defer_depth;
	cur_defers = &ds;

	var s *Node = n.body;
	while (s as i64 != 0) { gen_stmt(s); s = s.next; }

	run_defers(&ds);
	cur_defers = ds.prev;
	defer_depth = defer_depth - 1;
}


fn gen_ret(n *Node) {
	if (n.lhs as i64 != 0) {
		gen_expr(n.lhs);
		if (is_aggregate(n.lhs.ty)) {
			if (gen_fn.ret_slot as i64 != 0) {
				ir_memcpy_slot(gen_fn.ret_slot.offset as i64, n.lhs.ty.size as i64, n.pos);
			} else {
				ir_load2(n.lhs.ty.size as i64, n.pos);
			}
		}
	} else {
		ir_mov_acc_imm(0, n.pos);
	}
	if (any_defers()) {
		var wide bool = false;
		if (n.lhs as i64 != 0 && is_aggregate(n.lhs.ty)) {
			wide = n.lhs.ty.size > 8 && n.lhs.ty.size <= 16;
		}
		ir_push_acc(n.pos);
		if (wide) { ir_push_reg(RDX, n.pos); }
		unwind_to(0);
		if (wide) { ir_pop_reg(RDX, n.pos); }
		ir_pop_acc(n.pos);
	}
	gen_epilogue(n.pos);
}


fn gen_for(n *Node) {
	// The init may be a chain (the for-in desugar hoists the collection
	// into a hidden variable before the index init).
	if (n.init as i64 != 0) {
		var si *Node = n.init;
		while (si as i64 != 0) { gen_stmt(si); si = si.next; }
	}

	var lp Loop;
	lp.prev = cur_loop;
	lp.depth = defer_depth;
	lp.cont = ir_new_label();
	lp.brk = ir_new_label();
	cur_loop = &lp;

	// The back edge is a backward branch: ir_label(top) records the loop
	// head's address, and the IR_BR to it at the bottom lowers straight to
	// jump_back. The cond-exit is a forward branch to lp.brk, patched when
	// ir_label(lp.brk) lands below the loop.
	var top i64 = ir_new_label();
	ir_label(top, n.pos);
	if (n.cond as i64 != 0) {
		branch_false(n.cond, lp.brk);
	}
	gen_stmt(n.body);

	// A `continue` lands here (before the step), a `break` below the loop.
	ir_label(lp.cont, n.pos);
	if (n.step as i64 != 0) { gen_expr(n.step); }
	ir_branch(CC_ALWAYS, top, n.pos);

	ir_label(lp.brk, n.pos);
	cur_loop = lp.prev;
}


struct LineRow;
struct LineRow { next *LineRow, addr i64, file int, line int, }


var lines_head *LineRow;

var lines_tail *LineRow;

var opt_debug bool = false;


// One row per statement start. Consecutive statements on the same line, and
// statements that emitted no code, collapse into the previous row.
fn line_mark(pos i64) {
	if (!opt_debug) { return; }
	// The row address must be the real byte position, so pending IR ops that
	// belong to the previous statement are flushed first.
	ir_flush();
	var f int = diag_file_of(pos);
	var l int = diag_line_for(f, diag_offset_of(pos));
	if (lines_tail as i64 != 0) {
		if (lines_tail.file == f && lines_tail.line == l) { return; }
		if (lines_tail.addr == code.n) {
			lines_tail.file = f;
			lines_tail.line = l;
			return;
		}
	}
	var r *LineRow = arena_alloc(sizeof(LineRow), 8) as *LineRow;
	r.addr = code.n;
	r.file = f;
	r.line = l;
	if (lines_tail as i64 == 0) { lines_head = r; } else { lines_tail.next = r; }
	lines_tail = r;
}


fn gen_stmt(n *Node) {
	line_mark(n.pos);
	var k int = n.kind;

	if (k == ND_BLOCK) { gen_block(n); return; }
	if (k == ND_DEFER) {
		if (cur_defers as i64 == 0) { error_at(n.pos, "'defer' outside of a block"); }
		n.els = cur_defers.list;
		cur_defers.list = n;
		return;
	}
	if (k == ND_MATCH) { gen_match(n); return; }
	if (k == ND_EXPRSTMT) {
		if (n.lhs as i64 != 0) { gen_exprstmt(n.lhs); }
		return;
	}
	if (k == ND_RET) { gen_ret(n); return; }
	if (k == ND_IF) {
		var els i64 = ir_new_label();
		branch_false(n.cond, els);
		gen_stmt(n.then);
		if (n.els as i64 != 0) {
			var end i64 = ir_new_label();
			ir_branch(CC_ALWAYS, end, n.pos);
			ir_label(els, n.pos);
			gen_stmt(n.els);
			ir_label(end, n.pos);
		} else {
			ir_label(els, n.pos);
		}
		return;
	}
	if (k == ND_FOR) { gen_for(n); return; }
	if (k == ND_BREAK) {
		if (cur_loop as i64 == 0) { error_at(n.pos, "'break' outside of a loop"); }
		unwind_to(cur_loop.depth);
		ir_branch(CC_ALWAYS, cur_loop.brk, n.pos);
		return;
	}
	if (k == ND_CONT) {
		if (cur_loop as i64 == 0) { error_at(n.pos, "'continue' outside of a loop"); }
		unwind_to(cur_loop.depth);
		ir_branch(CC_ALWAYS, cur_loop.cont, n.pos);
		return;
	}
	gen_expr(n);
}


// Control cannot fall out of a block whose last statement returns, so the
// implicit "return 0" tail is dead.
fn always_returns(n *Node) bool {
	if (n as i64 == 0) { return false; }
	if (n.kind == ND_RET) { return true; }
	if (n.kind == ND_BLOCK) {
		var last *Node = null;
		var s *Node = n.body;
		while (s as i64 != 0) { last = s; s = s.next; }
		return always_returns(last);
	}
	if (n.kind == ND_IF) {
		return always_returns(n.then) && always_returns(n.els);
	}
	if (n.kind == ND_MATCH) {
		// type_match already guarantees exhaustiveness (every variant
		// covered, or a default arm), so all arms returning is enough.
		var arm *Node = n.body;
		while (arm as i64 != 0) {
			if (!always_returns(arm.body)) { return false; }
			arm = arm.next;
		}
		return true;
	}
	if (n.kind == ND_FOR && n.cond.kind == ND_NUM && n.cond.val != 0) {
		// A `while true` never falls through its condition; the only way
		// out is a return (good) or a break (bad). Conservative: any break
		// anywhere in the body means the loop might fall out.
		return !loop_has_break(n.body);
	}
	return false;
}

// Subtree scan for a break statement (a `while true` with any break in its
// body may fall out of the function without returning). A break inside a
// nested loop belongs to that loop, so the scan stops at any ND_FOR.
fn loop_has_break(n *Node) bool {
	if (n as i64 == 0) { return false; }
	if (n.kind == ND_BREAK) { return true; }
	if (n.kind == ND_FOR) { return false; }
	if (n.kind == ND_IF) {
		return loop_has_break(n.then) || loop_has_break(n.els);
	}
	return loop_has_break(n.next) || loop_has_break(n.body) ||
	       loop_has_break(n.lhs) || loop_has_break(n.rhs) ||
	       loop_has_break(n.args) || loop_has_break(n.init) ||
	       loop_has_break(n.step);
}


// Promoted locals live in callee-saved registers, so each function saves the
// ones it uses into reserved slots at the top of its own frame.
fn reg_used(f *Func, reg int) bool {
	if (opt_target == TARGET_RISCV64) {
		if (reg != 9 && (reg < 18 || reg > 26)) { return false; }
	} else if (reg < 12 && reg != 3) { return false; }
	var v *Var = f.locals;
	while (v as i64 != 0) {
		if (v.has_reg && v.reg == reg) { return true; }
		v = v.next;
	}
	return false;
}


fn saved_slot(f *Func, reg int) i64 {
	var k i64 = 0;
	var i int = 0;
	while (i < ra_nsaved()) {
		var r int = ra_saved(i);
		if (reg_used(f, r)) {
			k = k + 1;
			if (r == reg) { return k * 8; }
		}
		i = i + 1;
	}
	return 0;
}


var gen_frameless bool;


// ── ARM64 intrinsic builtins (gc/atomic/thread/tls) ──
//
// The x86 versions of these are native bytes in the ND_CALL block above.
// Each ARM64 twin mirrors its register contract: gen_args stages the
// arguments into X0..Xn (call_reg ranks), and the function emits the A64
// sequence that honours it.

// atomic_cas(ptr, expected, new) -> bool. LDXR/STXR loop; the branch on
// STXR's status register keeps the CMP's EQ flag alive for the result.
fn gen_atomic_cas(n *Node) {
	gen_args(n, false, false, -1, false);    // ptr->X0, expected->X1, new->X2
	// gen_args only appends IR; code.n has to reflect the actually-flushed
	// byte position before it's captured as the retry loop's target, or a
	// STXR failure retries into whatever code happened to follow instead of
	// back to the LDXR (found by a spurious STXR failure on real hardware --
	// architecturally permitted even with no real contention, but something
	// qemu-aarch64's user-mode emulation never produces, so this was
	// invisible under qemu).
	ir_flush();
	var top i64 = code.n;
	arm64_ldxr(X9, X0);                      // x9 = old
	arm64_cmp_reg(X9, X1);
	var done i64 = arm64_jump(arm64_cc(CC_NE));        // old != expected -> done (result 0)
	arm64_stxr(X10, X2, X0);                 // stxr w10, x2, [x0]
	arm64_cbnz_back(X10, top);               // store lost the race -> retry
	arm64_patch_here(done);
	arm64_cset(X0, CC_EQ);                   // x0 = (old == expected)
}

// atomic_add(ptr, val) -> old value.
fn gen_atomic_add(n *Node) {
	gen_args(n, false, false, -1, false);    // ptr->X0, val->X1
	ir_flush();
	var top i64 = code.n;
	arm64_ldxr(X9, X0);                      // x9 = old
	arm64_alu_reg(ALU_ADD, X10, X9, X1);     // x10 = old + val
	arm64_stxr(X11, X10, X0);
	arm64_cbnz_back(X11, top);
	arm64_mov_reg(X0, X9);                   // return old
}

// thread_clone(fn, arg, stack, flags) -> child tid (0 in the child).
// clone()'s child resumes at the instruction after the SVC on a fresh
// stack, so fn/arg ride callee-saved X19/X20 (saved around the call for the
// parent, which never reaches the child's exit).
fn gen_thread_clone_arm64(n *Node) {
	gen_args(n, false, false, -1, false);    // fn->X0, arg->X1, stack->X2, flags->X3
	arm64_push(X19);
	arm64_push(X20);
	arm64_mov_reg(X19, X0);                  // x19 = fn
	arm64_mov_reg(X20, X1);                  // x20 = arg
	arm64_mov_reg(X0, X3);                   // x0 = flags
	arm64_mov_reg(X1, X2);                   // x1 = child stack
	arm64_movz(X2, 0, 0);                    // x2 = parent tid (null)
	arm64_movz(X3, 0, 0);                    // x3 = child tid (null)
	arm64_movz(X4, 0, 0);                    // x4 = tls (null)
	arm64_mov_imm64(X8, 220);                // SYS_CLONE
	arm64_svc();
	arm64_cmp_imm(X0, 0);
	var parent i64 = arm64_jump(arm64_cc(CC_NE));      // x0 != 0 -> parent
	// Child: call fn(arg), then exit the thread.
	arm64_mov_reg(X0, X20);
	arm64_blr(X19);
	arm64_mov_imm64(X8, 93);                 // SYS_EXIT (this thread)
	arm64_svc();
	arm64_patch_here(parent);
	arm64_pop(X20);
	arm64_pop(X19);
}

// gc_data_base()/gc_data_end(): the .data bounds the GC scans. Same
// MOVZ+MOVK placeholder pair every absolute-address site uses, recorded in
// the same gc_*_refs lists and patched at finalize to the real dbase.
fn gen_gc_bound(_n *Node, is_base bool) {
	var at i64 = arm64_addr_slot(X0);
	if (is_base) { ilist_push(&gc_base_refs, at); }
	else { ilist_push(&gc_end_refs, at); }
}

// gc_save_regs(ptr): spill the callee-saved registers the GC must scan --
// AAPCS64's x19-x28 (x29/x30 are the frame and return addresses, already
// reachable through the saved x29 chain). ptr is in X0.
fn gen_gc_save_regs(n *Node) {
	gen_args(n, false, false, -1, false);
	var r int = X19;
	var off i64 = 0;
	while (r <= X28) {
		arm64_str_off(r, X0, off);
		off = off + 8;
		r = r + 1;
	}
}

// coro_entry_addr(): the coroutine trampoline's address.
fn gen_coro_entry_addr() {
	ilist_push(&coro_stub_refs, arm64_addr_slot(X0));
}


// Emits one asm operand chain: bytes (a value wider than a byte is a byte
// string in hex, most significant byte first -- the order a disassembler
// prints) or a symbol slot: `$name` absolute, `$rel name` relative. On
// ARM64 `$name` is the same 8-byte absolute slot, but `$rel name` patches
// the IMM26 of the 4-byte instruction that precedes it (a `b`/`bl` with a
// zero immediate) instead of appending a rel32 -- A64 branches carry their
// displacement inside the word.
fn gen_asm_operands(a *Node) {
	while (a as i64 != 0) {
		if (a.kind == ND_ASMLE) {
			// `$le N v`: exactly N bytes, little-endian, no truncation.
			var n i64 = a.nargs as i64;
			var s i64 = 0;
			while (s < n) {
				b1(((a.val >> (s * 8)) & 255) as u8);
				s = s + 1;
			}
		} else if (a.kind == ND_ASMREF) {
			if (a.val == 2) {
				if (opt_target != TARGET_X86_64) {
					error_at(a.pos, "$abs exists only on x86_64");
				}
				add_absref32(a.name, a.pos);
			} else if (a.val != 0) {
				if (opt_target == TARGET_RISCV64) { add_callref_riscv(a.name, a.pos); }
				else if (opt_target == TARGET_ARM64) { add_callref_arm64(a.name, a.pos); }
				else { add_callref(a.name, a.pos); }
			} else {
				if (opt_target == TARGET_RISCV64) { add_absref_riscv(a.name, a.pos); }
				else if (opt_target == TARGET_ARM64) { add_absref_arm64(a.name, a.pos); }
				else { add_absref(a.name, a.pos); }
			}
		} else {
			var v i64 = a.val;
			var n i64 = 1;
			var t i64 = v;
			while (t > 255) { n = n + 1; t = t >> 8; }
			var s i64 = (n - 1) * 8;
			while (s >= 0) {
				b1(((v >> s) & 255) as u8);
				s = s - 8;
			}
		}
		a = a.next;
	}
}

// `$rel name` inside an ARM64 asm block: emits a `bl` with a zero IMM26
// and records the word's position so the calls chain patches it -- the
// A64 branch is the whole instruction, unlike x86's trailing rel32.
fn add_callref_arm64(name str, pos i64) {
	b4(0x94000000);
	var f *CallFixup = arena_alloc(sizeof(CallFixup), 8) as *CallFixup;
	f.at = code.n - 4;
	f.name = name;
	f.pos = pos;
	if (calls_tail as i64 == 0) { calls_head = f; } else { calls_tail.next = f; }
	calls_tail = f;
	if (opt_object) { push_reloc(f.at, name, REL_ARM64_CALL26); }
}

// `$name` inside an ARM64 asm block: loads the symbol's address into X0 as
// a MOVZ+MOVK pair (exe) or ADRP+ADD_LO12 (object) instead of x86's
// trailing 8-byte absolute slot -- A64 has no single mov-immediate, and a
// LDR-literal slot confuses qemu's linear block decoder.
fn add_absref_arm64(name str, pos i64) {
	var f *CallFixup = arena_alloc(sizeof(CallFixup), 8) as *CallFixup;
	f.name = name;
	f.pos = pos;
	if (opt_object) {
		f.at = code.n;
		arm64_adrp(X0);
		var at1 i64 = code.n;
		arm64_add_lo12(X0);
		push_reloc(f.at, name, REL_ARM64_ADRP);
		push_reloc(at1, name, REL_ARM64_ADD_LO12);
	} else {
		arm64_movz(X0, 0, 0);
		arm64_movk(X0, 0, 1);
		f.at = code.n - 8;
	}
	if (asmrefs_tail as i64 == 0) { asmrefs_head = f; } else { asmrefs_tail.next = f; }
	asmrefs_tail = f;
}


fn gen_isr_save() {
	// The CPU pushed RIP/CS/RFLAGS for a ring-0 entry and
	// RIP/CS/RFLAGS/RSP/SS for a ring-3 one; iretq pops exactly as many
	// words as the target CS:CPL asks for, so the handler only has to
	// save the registers below the frame -- no padding, no stack drift.
	push_reg(RAX); push_reg(RCX); push_reg(RDX); push_reg(RBX);
	push_reg(RSI); push_reg(RDI);
	var r int = 8;
	while (r < 16) { push_reg(r); r = r + 1; }
}

fn gen_isr_restore() {
	var r int = 15;
	while (r >= 8) { pop_reg(r); r = r - 1; }
	pop_reg(RDI); pop_reg(RSI);
	pop_reg(RBX); pop_reg(RDX); pop_reg(RCX); pop_reg(RAX);
}

fn gen_epilogue(pos i64) {
	gen_restore();
	// An exported extern function returns a float in xmm0 (SysV) / d0 or s0
	// (AAPCS64) / fa0 (LP64D), where the body left it in the accumulator.
	if (gen_fn.extern && gen_fn.ret as i64 != 0 && is_float(gen_fn.ret)) {
		if (opt_target == TARGET_RISCV64) { riscv_fmv_wx_to_f(FA0, A0, gen_fn.ret.size); }
		else if (opt_target == TARGET_ARM64) { arm64_fmov_from_gpr(0, X0, gen_fn.ret.size); }
		else { gpr_to_xmm(0, RAX, gen_fn.ret.size); }
	}
	if (!gen_frameless && opt_target == TARGET_RISCV64) { riscv_leave_frame(); }
	else if (!gen_frameless && opt_target == TARGET_ARM64) { arm64_leave_frame(); }
	else if (!gen_frameless) { b1(0xc9); }
	if (gen_fn.interrupt) {
		ir_flush();
		gen_isr_restore();
		b1(0x48); b1(0xcf);
		return;
	}
	ir_ret(pos);
}


fn gen_restore() {
	var i int = 0;
	while (i < ra_nsaved()) {
		var r int = ra_saved(i);
		if (reg_used(gen_fn, r)) {
			if (opt_target == TARGET_RISCV64) { riscv_ld_local(r, saved_slot(gen_fn, r)); }
			else if (opt_target == TARGET_ARM64) { arm64_ld_local(r, saved_slot(gen_fn, r)); }
			else { ld_local(r, saved_slot(gen_fn, r)); }
		}
		i = i + 1;
	}
}


// A C caller passes an exported extern function's arguments the SysV way:
// the non-float words packed into the integer registers on their own count,
// the floats in xmm registers on theirs. Qela reads each parameter from a
// fixed word position, so the incoming integer registers are staged on the
// stack first -- loading a parameter into its home (register or frame slot)
// could otherwise clobber an argument register a later parameter is still
// sitting in. The xmm registers are never written, so the floats just wait.
fn gen_extern_params(f *Func) {
	var nreg int = 0;
	if (f.ret_slot as i64 != 0) { nreg = nreg + 1; }
	var i int = 0;
	while (i < f.nparams) {
		var v *Var = func_param(f, i);
		if (v.arg_stack) { i = i + 1; continue; }
		if (is_float(v.ty)) { i = i + 1; continue; }
		if (is_aggregate(v.ty) && !v.by_ref && v.ty.size > 8) { nreg = nreg + 2; }
		else { nreg = nreg + 1; }
		i = i + 1;
	}
	var k int = nreg - 1;
	while (k >= 0) { push_reg(call_reg(k)); k = k - 1; }

	if (f.ret_slot as i64 != 0) {
		pop_reg(RAX);
		st_local(f.ret_slot.offset as i64, RAX);
	}
	var xi int = 0;
	i = 0;
	while (i < f.nparams) {
		var v *Var = func_param(f, i);
		if (v.arg_stack) { i = i + 1; continue; }
		if (is_float(v.ty)) {
			xmm_to_gpr(RAX, xi, v.ty.size);
			xi = xi + 1;
			if (v.has_reg) { mov_reg_reg(v.reg, RAX); }
			else { st_local(v.offset as i64, RAX); }
		} else if (is_aggregate(v.ty) && !v.by_ref && v.ty.size > 8) {
			pop_reg(RAX);
			pop_reg(RDX);
			if (v.has_reg) { mov_reg_reg(v.reg, RAX); }
			else { st_local(v.offset as i64, RAX); }
			st_local((v.offset as i64) - 8, RDX);
		} else {
			pop_reg(RAX);
			if (v.has_reg) { mov_reg_reg(v.reg, RAX); }
			else { st_local(v.offset as i64, RAX); }
		}
		i = i + 1;
	}
}


// AAPCS64, the ARM64 half of the same marshalling. A C caller hands the
// exported extern its integer words in x0..x7 and its scalar floats in
// s0..s7/d0..d7 on *separate* counters; Qela stages parameters internally
// into the same x0..x7 (floats ride the GPRs), so the integer half needs no
// work at all -- only the floats move out of the FP register file into
// their frame slots, and an sret pointer arrives in x8 rather than the
// first argument register. No re-staging pass is needed (unlike x86):
// loading one integer parameter's register can never clobber a later one,
// and the FP file is never written. Aggregate floats (a struct of floats,
// AAPCS64's HFA) are not marshalled.
fn gen_extern_params_arm64(f *Func) {
	var ri int = 0;
	var fi int = 0;
	if (f.ret_slot as i64 != 0) {
		arm64_st_local(f.ret_slot.offset as i64, X8);
	}
	var i int = 0;
	while (i < f.nparams) {
		var v *Var = func_param(f, i);
		if (v.arg_stack) { i = i + 1; continue; }
		if (is_float(v.ty)) {
			arm64_fmov_to_gpr(X0, fi, v.ty.size);
			fi = fi + 1;
			if (v.has_reg) { arm64_mov_reg(v.reg, X0); }
			else { arm64_st_local(v.offset as i64, X0); }
		} else if (is_aggregate(v.ty) && !v.by_ref && v.ty.size > 8) {
			arm64_st_local(v.offset as i64, call_reg(ri));
			arm64_st_local((v.offset as i64) - 8, call_reg(ri + 1));
			ri = ri + 2;
		} else {
			if (v.has_reg) { arm64_mov_reg(v.reg, call_reg(ri)); }
			else { arm64_st_local(v.offset as i64, call_reg(ri)); }
			ri = ri + 1;
		}
		i = i + 1;
	}
}


fn gen_machine(n *Node) {
	if (opt_target != TARGET_X86_64) {
		error_at(n.pos, "this instruction exists only on x86_64");
	}
	if (n.nargs > 0) { gen_args(n, false, false, -1, false); }
	ir_flush();
	if (str_eq(n.name, "cli")) { b1(0xfa); return; }
	if (str_eq(n.name, "sti")) { b1(0xfb); return; }
	if (str_eq(n.name, "hlt")) { b1(0xf4); return; }
	if (str_eq(n.name, "outb") || str_eq(n.name, "outw") || str_eq(n.name, "outl")) {
		b1(0x89); modrm(3, RDI, RDX);
		b1(0x89); modrm(3, RSI, RAX);
		if (str_eq(n.name, "outb")) { b1(0xee); return; }
		if (str_eq(n.name, "outw")) { b1(0x66); }
		b1(0xef);
		return;
	}
	if (str_eq(n.name, "inb") || str_eq(n.name, "inw") || str_eq(n.name, "inl")) {
		b1(0x89); modrm(3, RDI, RDX);
		b1(0x31); modrm(3, RAX, RAX);
		if (str_eq(n.name, "inb")) { b1(0xec); return; }
		if (str_eq(n.name, "inw")) { b1(0x66); }
		b1(0xed);
		return;
	}
	if (str_eq(n.name, "lgdt")) {
		b1(0x0f); b1(0x01); modrm(0, 2, RDI);
		return;
	}
	if (str_eq(n.name, "lidt")) {
		b1(0x0f); b1(0x01); modrm(0, 3, RDI);
		return;
	}
	if (str_eq(n.name, "invlpg")) {
		b1(0x0f); b1(0x01); modrm(0, 7, RDI);
		return;
	}
	if (str_eq(n.name, "write_cr3")) {
		b1(0x0f); b1(0x22); modrm(3, 3, RDI);
		return;
	}
	if (str_eq(n.name, "read_cr2")) {
		b1(0x0f); b1(0x20); modrm(3, 2, RAX);
		return;
	}
	if (str_eq(n.name, "read_cr3")) {
		b1(0x0f); b1(0x20); modrm(3, 3, RAX);
		return;
	}
	if (str_eq(n.name, "rdmsr")) {
		b1(0x89); modrm(3, RDI, RCX);
		b1(0x0f); b1(0x32);
		b1(0x48); b1(0xc1); modrm(3, 4, RDX); b1(32);
		b1(0x48); b1(0x09); modrm(3, RDX, RAX);
		return;
	}
	b1(0x89); modrm(3, RDI, RCX);
	b1(0x89); modrm(3, RSI, RAX);
	b1(0x48); b1(0x89); modrm(3, RSI, RDX);
	b1(0x48); b1(0xc1); modrm(3, 5, RDX); b1(32);
	b1(0x0f); b1(0x30);
}

fn patch64(b *Buf, at i64, v i64) {
	var k i64 = 0;
	while (k < 8) {
		b.p[at + k] = ((v >> (k * 8)) & 255) as u8;
		k = k + 1;
	}
}

fn gen_func(f *Func) {
	// An extern declaration has no body; the symbol comes from the linker
	// (only valid under -c, which skips this whole path).
	if (f.body as i64 == 0) { return; }
	if (f.ret.kind != TY_VOID && f.ret.kind != TY_TYPE && !f.naked && !always_returns(f.body)) {
		error_at(f.pos, "control reaches the end of a non-void function");
	}
	if (opt_target == TARGET_X86_64 && (code.n & 1) != 0) { b1(0x90); }
	f.addr = code.n;
	line_mark(f.pos);
	if (f.interrupt) {
		if (opt_target != TARGET_X86_64) {
			error_at(f.pos, "an interrupt handler exists only on x86_64");
		}
		if (f.ret.kind != TY_VOID) {
			error_at(f.pos, "an interrupt handler returns nothing");
		}
		gen_isr_save();
	}
	depth = 0;
	gen_fn = f;
	cur_loop = null;
	cur_defers = null;
	defer_depth = 0;
	// Label ids restart for every function so an IR_BR from one function can
	// never reference another's IR_LABEL; the chain lists re-grow from empty.
	ir_label_n = 0;
	ir_label_br.n = 0;
	ir_br_next.n = 0;
	ir_label_pos.n = 0;

	// A leaf function with nothing in its frame needs no frame: every local it
	// has is in a register and nothing below rsp is ever addressed.
	// A stack-passed parameter's addressing depends on rbp actually being
	// this frame's own base (rbp+8 = return address, rbp+16 = the first
	// spilled param) -- never drop the frame just because the function
	// otherwise looks callable frameless.
	// A naked function has no frame by definition, and its body ends with
	// its own ret or iretq: nothing may be emitted before or after it.
	gen_frameless = f.naked || (f.leaf && f.stack_size == 0 && f.n_stack_args == 0);
	if (!gen_frameless && opt_target == TARGET_RISCV64) {
		riscv_enter_frame(f.stack_size as i64);
	} else if (!gen_frameless && opt_target == TARGET_ARM64) {
		arm64_enter_frame(f.stack_size as i64);
	} else if (!gen_frameless) {
		push_reg(RBP);
		depth = depth - 1;
		mov_reg_reg(RBP, RSP);
		if (f.stack_size != 0) {
			alu_rax_imm_reg(5, RSP, f.stack_size as i64);
		}
	}

	if (!f.naked) {
		var si int = 0;
		while (si < ra_nsaved()) {
			var sr int = ra_saved(si);
			if (reg_used(f, sr)) {
				if (opt_target == TARGET_RISCV64) { riscv_st_local(saved_slot(f, sr), sr); }
				else if (opt_target == TARGET_ARM64) { arm64_st_local(saved_slot(f, sr), sr); }
				else { st_local(saved_slot(f, sr), sr); }
			}
			si = si + 1;
		}

		var ri int = 0;
		if (f.extern) {
			if (opt_target == TARGET_RISCV64) { gen_extern_params_riscv(f); }
			else if (opt_target == TARGET_ARM64) { gen_extern_params_arm64(f); }
			else { gen_extern_params(f); }
		} else {
			if (f.ret_slot as i64 != 0) {
				if (opt_target == TARGET_RISCV64) { riscv_st_local(f.ret_slot.offset as i64, call_reg(ri)); }
				else if (opt_target == TARGET_ARM64) { arm64_st_local(f.ret_slot.offset as i64, call_reg(ri)); }
				else { st_local(f.ret_slot.offset as i64, call_reg(ri)); }
				ri = ri + 1;
			}
			var i int = 0;
			while (i < f.nparams) {
				var v *Var = func_param(f, i);
				if (v.arg_stack) {
					// Already sitting at the right s0-relative offset from the
					// caller's pushes -- nothing to move, and ri must not advance.
					i = i + 1;
					continue;
				}
				if (v.has_reg) {
					if (opt_target == TARGET_RISCV64) { riscv_mov_reg(v.reg, call_reg(ri)); }
					else if (opt_target == TARGET_ARM64) { arm64_mov_reg(v.reg, call_reg(ri)); }
					else { mov_reg_reg(v.reg, call_reg(ri)); }
				}
				else if (opt_target == TARGET_RISCV64) { riscv_st_local(v.offset as i64, call_reg(ri)); }
				else if (opt_target == TARGET_ARM64) { arm64_st_local(v.offset as i64, call_reg(ri)); }
				else { st_local(v.offset as i64, call_reg(ri)); }
				ri = ri + 1;
				if (is_aggregate(v.ty) && !v.by_ref && v.ty.size > 8) {
					if (opt_target == TARGET_RISCV64) { riscv_st_local((v.offset as i64) - 8, call_reg(ri)); }
					else if (opt_target == TARGET_ARM64) { arm64_st_local((v.offset as i64) - 8, call_reg(ri)); }
					else { st_local((v.offset as i64) - 8, call_reg(ri)); }
					ri = ri + 1;
				}
				i = i + 1;
			}
		}
	}

	fn_bounds.n = 0;
	gen_stmt(f.body);

	if (!f.naked && !always_returns(f.body)) {
		// ir_mov_acc_imm lowers to the exact same mov_reg_imm(RAX, 0) on x86
		// (IR_MOV dst=ACC src0=IMM), so this costs x86 nothing and gets
		// ARM64 the IR dispatch it needs -- mov_reg_imm itself is native x86.
		ir_mov_acc_imm(0, f.pos);
		gen_epilogue(f.pos);
	}
	// A trailing bounds check can still be sitting unlowered in the IR
	// buffer, so fn_bounds is only complete once every op has been lowered;
	// flush before gen_bounds_trampoline reads fn_bounds.n, or the check's
	// jump patches to nothing and falls through into whatever comes next.
	ir_flush();
	gen_bounds_trampoline();
	// Function boundary: nothing IR may leak past it. The next gen_func reads
	// code.n for f.addr and line_mark, both of which must see every byte of
	// this function.
	ir_flush();
}


// f64 bit pattern -> f32 bit pattern, in pure integer math: the bootstrap
// subset has no float, so this must never use one. Truncating, not
// round-to-nearest. Subnormal doubles are below the f32 range anyway, so
// they underflow to zero here.
fn f64_to_f32_bits(b i64) i64 {
	var sign i64 = (b >> 63) & 1;
	var exp i64 = (b >> 52) & 0x7ff;
	var man i64 = b & 0xfffffffffffff;
	if (exp == 0x7ff) {
		if (man == 0) { return (sign << 31) | 0x7f800000; }
		return (sign << 31) | 0x7fc00000;
	}
	if (exp == 0) { return sign << 31; }
	var e32 i64 = exp - 1023 + 127;
	if (e32 <= 0) { return sign << 31; }
	if (e32 >= 255) { return (sign << 31) | 0x7f800000; }
	return (sign << 31) | (e32 << 23) | ((man >> 29) & 0x7fffff);
}


// A call of tls_init anywhere in the tree? The template has to exist for
// the stub to copy, even when no tvar is declared -- the no-tvar case
// needs the lone self-pointer slot (see layout_tls).
fn tree_calls_tls_init(n *Node) bool {
	while (n as i64 != 0) {
		if (n.kind == ND_CALL && str_eq(n.name, "tls_init")) { return true; }
		if (tree_calls_tls_init(n.lhs)) { return true; }
		if (tree_calls_tls_init(n.rhs)) { return true; }
		if (tree_calls_tls_init(n.cond)) { return true; }
		if (tree_calls_tls_init(n.then)) { return true; }
		if (tree_calls_tls_init(n.els)) { return true; }
		if (tree_calls_tls_init(n.init)) { return true; }
		if (tree_calls_tls_init(n.step)) { return true; }
		if (tree_calls_tls_init(n.body)) { return true; }
		if (tree_calls_tls_init(n.args)) { return true; }
		n = n.next;
	}
	return false;
}

// tvar bytes never live in .data/.bss: they're a template copied into a
// fresh mmap'd block per thread. Offset 0 is reserved for the self-pointer
// tls_init writes at runtime; real tvars start at 8.
fn layout_tls(globals *Var, funcs *Func) {
	var any bool = false;
	var v0 *Var = globals;
	while (v0 as i64 != 0) {
		if (v0.is_tls && (v0.reachable || opt_object)) { any = true; }
		v0 = v0.next;
	}
	// A program with no tvar at all must cost nothing: no template bytes
	// in the data segment, no second LOAD segment for the RW section to
	// need at all (that's a whole extra program header, 56 bytes, for
	// zero benefit). tls_block_size stays at its default 8 and tls_init
	// is never emitted -- see the tls_block_size > 8 check in emit_code.
	// The one exception is a program that calls tls_init anyway: the stub
	// copies tls_block_size bytes from the template, so the lone
	// self-pointer word has to exist or the copy reads past the mapped
	// image.
	if (!any) {
		var has_call bool = false;
		var f *Func = funcs;
		while (f as i64 != 0 && !has_call) {
			if (f.body as i64 != 0 && tree_calls_tls_init(f.body)) { has_call = true; }
			f = f.next;
		}
		if (!has_call) { return; }
		var align8 i64 = (gdata.n + 7) & ~7;
		while (gdata.n < align8) { buf_u8(&gdata, 0); }
		tls_template_off = gdata.n;
		buf_u64(&gdata, 0);
		return;
	}

	var tmpl Buf;
	buf_u64(&tmpl, 0);
	var v *Var = globals;
	while (v as i64 != 0) {
		if (v.is_tls) {
			if (v.reachable || opt_object) {
				var align i64 = v.ty.align as i64;
				var off i64 = (tmpl.n + align - 1) & ~(align - 1);
				while (tmpl.n < off) { buf_u8(&tmpl, 0); }
				v.tls_off = tmpl.n;
				var i int = 0;
				while (i < v.ty.size) {
					buf_u8(&tmpl, ((v.init >> (i * 8)) & 255) as u8);
					i = i + 1;
				}
			}
		}
		v = v.next;
	}
	while ((tmpl.n & 7) != 0) { buf_u8(&tmpl, 0); }
	tls_block_size = tmpl.n;
	var align8 i64 = (gdata.n + 7) & ~7;
	while (gdata.n < align8) { buf_u8(&gdata, 0); }
	tls_template_off = gdata.n;
	buf_bytes(&gdata, tmpl.p, tmpl.n);
}


// ── embedded compiler copy ──
//
// A program that pulls in the runtime ABI (std/abiconn.qela declares the
// two `__qela_embedded*` globals) gets the compiler's own image embedded
// into its data segment, so the runtime child can materialize itself via
// memfd+fexecve without qela installed. The length global's init is set
// before layout so the real size lands in .data; the pointer global's
// init is forced nonzero so it gets a .data slot too, and the slot is
// patched with the blob's runtime address once the image geometry is
// known. The blob sits after the bss region (the file carries bss-size
// zero padding up to it), so the conservative GC scan, which ends at the
// bss, never walks the compiler's bytes. Object mode skips the embed --
// the blob has no relocation story there -- and the runtime falls back
// to $QELAPATH/$PATH when the length is zero.

var embed_lenv *Var;
var embed_ptrv *Var;
var embed_blob str;
var embed_blob_off i64 = -1;

fn find_global_var(name str) *Var {
	var v *Var = global_vars;
	while (v as i64 != 0) {
		if (str_eq(v.name, name)) { return v; }
		v = v.next;
	}
	return null;
}

fn embed_prepare() {
	embed_lenv = find_global_var("__qela_embedded_len");
	embed_ptrv = find_global_var("__qela_embedded");
	if (embed_lenv as i64 == 0 || embed_ptrv as i64 == 0) { return; }
	if (!embed_lenv.reachable && !opt_object) { return; }
	if (opt_object) { return; }
	// The embed is this compiler's own image: it can only run where this
	// compiler itself runs. A cross-compiled output would embed an ELF the
	// target kernel refuses to exec (the child is not emulated), so the
	// runtime falls back to $QELAPATH/$PATH instead.
	$if (TARGET == "x86_64") {
		if (opt_target != TARGET_X86_64) { return; }
	} $else {
		$if (TARGET == "arm64") {
			if (opt_target != TARGET_ARM64) { return; }
		} $else {
			if (opt_target != TARGET_RISCV64) { return; }
		}
	}
	var self_path [4096]u8;
	var plen i64 = sys_readlink(cstr("/proc/self/exe"), &self_path[0], 4096);
	if (plen <= 0 || plen >= 4096) { return; }
	var sp str;
	sp.ptr = &self_path[0];
	sp.len = plen;
	var blob str = read_file(sp);
	embed_blob = blob;
	embed_lenv.init = blob.len;
	// Forces a .data slot (init 0 would put the pointer in bss); the real
	// value is patched in embed_patch.
	embed_ptrv.init = 1;
}

fn embed_append() {
	if (embed_blob.len == 0) { return; }
	var off i64 = gdata.n + bss_size;
	var align8 i64 = (off + 7) & ~7;
	while (gdata.n < align8) { buf_u8(&gdata, 0); }
	embed_blob_off = gdata.n;
	buf_bytes(&gdata, embed_blob.ptr, embed_blob.len);
}

fn embed_patch(dbase i64) {
	if (embed_blob_off < 0) { return; }
	var addr i64 = dbase + embed_blob_off;
	var k i64 = 0;
	while (k < 8) {
		gdata.p[embed_ptrv.data_off + k] = ((addr >> (k * 8)) & 255) as u8;
		k = k + 1;
	}
}

fn layout_globals(globals *Var, funcs *Func) {
	layout_tls(globals, funcs);
	var v *Var = globals;
	while (v as i64 != 0) {
		if (v.is_tls || (!v.reachable && !opt_object)) { v = v.next; continue; }
		if (v.init != 0) {
			// A float literal stores f64 bits; an f32 slot is 4 bytes, so
			// the bits must be narrowed here or the low half (zero for any
			// double with an exponent above 0x3ff) lands in the slot.
			if (v.ty.kind == TY_FLOAT && v.ty.size == 4) {
				v.init = f64_to_f32_bits(v.init);
			}
			var align i64 = v.ty.align as i64;
			var off i64 = (gdata.n + align - 1) & ~(align - 1);
			while (gdata.n < off) { buf_u8(&gdata, 0); }
			v.data_off = gdata.n;
			var i int = 0;
			while (i < v.ty.size) {
				buf_u8(&gdata, ((v.init >> (i * 8)) & 255) as u8);
				i = i + 1;
			}
		}
		v = v.next;
	}
	var bss i64 = gdata.n;
	v = globals;
	while (v as i64 != 0) {
		if (!v.is_tls && v.init == 0 && !(v.extern && !v.has_init) && (v.reachable || opt_object)) {
			// An imported extern is allocated by the C side; it must not
			// take a .bss slot here.
			var align i64 = v.ty.align as i64;
			bss = (bss + align - 1) & ~(align - 1);
			v.data_off = bss;
			bss = bss + (v.ty.size as i64);
		}
		v = v.next;
	}
	bss_size = bss - gdata.n;
}


// The message pointer points at the string bytes, not at the {ptr, len}
// header add_strref would hand out, so these carry their own fixup list,
// patched with bytes_off after layout. With backtraces on, the stub jumps
// to the walker instead of exiting, so the caller of the trampoline call
// below is still on the stack when the walker reads it.
fn gen_panic_stub(msg_id int, msg_len i64) {
	if (opt_target == TARGET_RISCV64) {
		riscv_gen_panic_stub(msg_id, msg_len);
		return;
	}
	if (opt_target == TARGET_ARM64) {
		arm64_gen_panic_stub(msg_id, msg_len);
		return;
	}
	if (opt_object) {
		// The message bytes get a `.Lstrd<id>` symbol; a RIP-relative lea
		// with a PC32 reloc survives PIE (an absolute slot would be TEXTREL).
		rip_ref(0x8d, RSI);
		var at i64 = code.n;
		b4(0);
		var nb Buf;
		fmt_str(&nb, ".Lstrd");
		fmt_i64(&nb, msg_id as i64);
		push_reloc(at, buf_str(&nb), REL_PCREL32);
	} else if (base_is_wide()) {
		b1(0x48); b1(0xbe);
		ilist_push(&panic_msg_at, code.n);
		ilist_push(&panic_msg_ids, msg_id as i64);
		buf_u64(&code, 0);
	} else {
		b1(0xbe);
		ilist_push(&panic_msg_at, code.n);
		ilist_push(&panic_msg_ids, msg_id as i64);
		b4(0);
	}
	mov_reg_imm(RAX, 1);
	mov_reg_imm(RDI, 2);
	mov_reg_imm(RDX, msg_len);
	b1(0x0f); b1(0x05);
	if (opt_backtrace) {
		b1(0xe9);
		ilist_push(&bt_jmps, code.n);
		b4(0);
	} else {
		mov_reg_imm(RAX, 231);   // exit_group: a crash kills every thread, not just this one
		mov_reg_imm(RDI, 134);
		b1(0x0f); b1(0x05);
	}
}


fn reset_code() {
	code.n = 0;
	br_n = 0;
	br_at.n = 0;
	br_grew = false;
	arm64_br_n = 0;
	arm64_br_at.n = 0;
	arm64_op2_ov = -1;
	riscv_br_n = 0;
	riscv_br_at.n = 0;
	bounds_checks.n = 0;
	assert_sites.n = 0;
	assert_msgs.n = 0;
	panic_msg_at.n = 0;
	panic_msg_ids.n = 0;
	bt_base_refs.n = 0;
	bt_jmps.n = 0;
	coro_switch_refs.n = 0;
	coro_switch_at = -1;
	coro_stub_refs.n = 0;
	coro_stub_at = -1;
	gc_base_refs.n = 0;
	gc_end_refs.n = 0;
	tls_init_refs.n = 0;
	tls_stub_at = -1;
	tls_stub_src_at = -1;
	tls_src_refs.n = 0;
	calls_head = null;
	calls_tail = null;
	asmrefs_head = null;
	asmrefs_tail = null;
	strrefs_head = null;
	strrefs_tail = null;
	datarefs_head = null;
	datarefs_tail = null;
	funcaddrs_head = null;
	funcaddrs_tail = null;
	relocs_head = null;
	relocs_tail = null;
	rodata_relocs_head = null;
	rodata_relocs_tail = null;
	lines_head = null;
	lines_tail = null;
}


// Reachability: only functions reachable from the entry point are emitted.
// Roots are main (or `entry name;`), naked/interrupt handlers (they do
// their own setup and are entered from outside the program), and whatever
// top-level asm references by symbol. A function's call graph is walked
// through direct calls (ND_CALL with a name), function addresses
// (ND_FUNCADDR) and asm symbol references (ND_ASMREF). Everything else is
// dead code and is skipped by codegen, DWARF and the backtrace table.
// Globals get the same treatment: one referenced from a reachable body (or
// a top-level asm operand) is kept, the rest are dropped from .data/.bss.
// A string literal is kept when a reachable body evaluates it; the whole
// u.strs pool is no longer emitted wholesale, so a dead function's error
// messages no longer ride along.
fn mark_reachable(u *Unit) {
	var f *Func = u.funcs;
	while (f as i64 != 0) {
		f.reachable = false;
		f = f.next;
	}
	var v *Var = u.globals;
	while (v as i64 != 0) {
		v.reachable = false;
		v = v.next;
	}
	var s *StrLit = u.strs;
	while (s as i64 != 0) {
		s.keep = false;
		s = s.next;
	}
	if (entry_name.len != 0) { reach_name(entry_name); }
	else { reach_name("main"); }
	f = u.funcs;
	while (f as i64 != 0) {
		if (f.naked || f.interrupt) { reach_mark(f); }
		f = f.next;
	}
	reach_node(top_asm_head);
}

fn mark_str(id int) {
	var s *StrLit = gen_unit.strs;
	while (s as i64 != 0) {
		if (s.id == id) { s.keep = true; return; }
		s = s.next;
	}
}

fn mark_global(v *Var) {
	if (v as i64 == 0 || v.reachable) { return; }
	v.reachable = true;
}

fn reach_name(name str) {
	if (name.len == 0) { return; }
	var f *Func = find_func(name);
	if (f as i64 != 0) { reach_mark(f); }
}

fn reach_mark(f *Func) {
	if (f as i64 == 0 || f.reachable) { return; }
	f.reachable = true;
	reach_node(f.body);
}

fn reach_node(n *Node) {
	while (n as i64 != 0) {
		if (n.kind == ND_CALL && n.name.len != 0) {
			reach_name(n.name);
			// The coroutine trampoline (emitted machine code, no AST
			// caller) returns into coro_finish whenever any coroutine
			// switches, so a program with coroutines needs it even though
			// no reachable body calls it.
			if (str_eq(n.name, "coro_switch")) { reach_name("coro_finish"); }
		}
		else if (n.kind == ND_FUNCADDR && n.name.len != 0) { reach_name(n.name); }
		else if (n.kind == ND_ASMREF && n.name.len != 0) {
			reach_name(n.name);
			mark_global(find_global(n.name));
		}
		else if (n.kind == ND_VAR && n.varp as i64 != 0 && n.varp.is_global) { mark_global(n.varp); }
		else if (n.kind == ND_STRLIT) { mark_str(n.val as int); }
		reach_node(n.lhs);
		reach_node(n.rhs);
		reach_node(n.cond);
		reach_node(n.then);
		reach_node(n.els);
		reach_node(n.init);
		reach_node(n.step);
		reach_node(n.args);
		reach_node(n.body);
		n = n.next;
	}
}


fn emit_code(u *Unit, main_fn *Func, panic_id int, hdr i64) {
	// Top-level asm blocks are the image's first bytes; `entry name;`
	// suppresses the default stub too, so the entry function (usually
	// naked) does its own setup and its own exit.
	if (top_asm_head as i64 == 0 && entry_name.len == 0 && opt_target == TARGET_RISCV64) {
		// Minimal RISC-V entry stub. main's return value is already in a0,
		// which is also exit_group's first argument on LP64, so unlike x86
		// no move is needed before the syscall. SP is 16-aligned at process
		// entry and the kernel leaves argc/argv at [sp]/[sp+8]. With
		// backtraces on, s0 starts zero: the walker's frame chain stops
		// there (main's prologue stores it as its own chain head).
		if (opt_backtrace) { riscv_mov_reg(S0, ZERO); }
		if (tls_block_size > 8) {
			// The stub clobbers a0-a7, so argc/argv load after the JAL,
			// not before; SP still holds the argument vector untouched.
			ilist_push(&tls_init_refs, code.n);
			b4(0x6f | (RA << 7));                 // jal ra, <tls init stub>
		}
		if (main_fn as i64 != 0 && main_fn.nparams == 2) {
			riscv_ld_at(A0, STK, 0);
			riscv_add_imm(A1, STK, 8);
		}
		riscv_add_call("main", 0);
		riscv_li64(A7, SYS_RISCV_EXIT_GROUP);
		riscv_ecall();
	} else if (top_asm_head as i64 == 0 && entry_name.len == 0 && opt_target == TARGET_ARM64) {
		// Minimal ARM64 entry stub (M9): no backtrace sentinel, no TLS init.
		// main's return value is already in X0, which is also exit_group's
		// first argument on AAPCS64, so unlike x86 no move is needed before
		// the syscall.
		if (opt_backtrace) { die("error: --target arm64 does not support --backtrace yet"); }
		if (tls_block_size > 8) {
			// The stub clobbers X0-X7, so argc/argv load after the BL, not
			// before; SP still holds the argument vector untouched.
			ilist_push(&tls_init_refs, code.n);
			b4(0x94000000);                       // bl <tls init stub>
		}
		if (main_fn as i64 != 0 && main_fn.nparams == 2) {
			arm64_ld_at(X0, SP, 0);
			arm64_add_imm(X1, SP, 8);
		}
		arm64_add_call("main", 0);
		arm64_mov_imm64(X8, SYS_ARM64_EXIT_GROUP);
		arm64_svc();
	} else if (top_asm_head as i64 == 0 && entry_name.len == 0) {
		// rbp is not guaranteed zero at process entry; the backtrace
		// walker needs a sentinel main returns into.
		if (opt_backtrace) {
			b1(0x48); b1(0x31); b1(0xed);     // xor rbp, rbp
		}
		if (tls_block_size > 8) {
			// Runs before argc/argv load into rdi/rsi below -- it clobbers
			// plenty of registers and nothing needs those yet.
			b1(0xe8);
			ilist_push(&tls_init_refs, code.n);
			b4(0);
		}
		if (main_fn as i64 != 0 && main_fn.nparams == 2) {
			b1(0x48); b1(0x8b); b1(0x3c); b1(0x24);
			b1(0x48); b1(0x8d); b1(0x74); b1(0x24); b1(8);
		}

		add_call("main", 0);
		b1(0x89);
		modrm(3, RAX, RDI);
		mov_reg_imm(RAX, 231);   // exit_group: authoritative over any worker threads still running
		b1(0x0f); b1(0x05);
	} else if (top_asm_head as i64 != 0) {
		gen_asm_operands(top_asm_head);
	}

	var f *Func = u.funcs;
	while (f as i64 != 0) {
		if (f.nct == 0 && f.reachable) { gen_func(f); }
		f = f.next;
	}

	if (bounds_checks.n != 0) {
		var panic_addr i64 = code.n;
		gen_panic_stub(panic_id, 20);
		var i i64 = 0;
		while (i < bounds_checks.n) {
			if (opt_target == TARGET_RISCV64) { riscv_patch_jal(&code, bounds_checks.p[i], panic_addr - bounds_checks.p[i]); }
			else if (opt_target == TARGET_ARM64) { arm64_patch_call(&code, bounds_checks.p[i], panic_addr - bounds_checks.p[i]); }
			else { buf_patch32(&code, bounds_checks.p[i], panic_addr - (bounds_checks.p[i] + 4)); }
			i = i + 1;
		}
	}

	// One stub per distinct assert message, patched at every site that uses
	// it. The message length is looked up here, at emit time.
	if (assert_sites.n != 0) {
		var ai i64 = 0;
		while (ai < assert_sites.n) {
			var msg i64 = assert_msgs.p[ai];
			var dup bool = false;
			var bi i64 = 0;
			while (bi < ai) {
				if (assert_msgs.p[bi] == msg) { dup = true; }
				bi = bi + 1;
			}
			if (!dup) {
				var len i64 = 0;
				var ls *StrLit = u.strs;
				while (ls as i64 != 0) {
					if (ls.id == (msg as int)) { len = ls.s.len; }
					ls = ls.next;
				}
				var sa i64 = code.n;
				gen_panic_stub(msg as int, len);
				var ci i64 = 0;
				while (ci < assert_sites.n) {
					if (assert_msgs.p[ci] == msg) {
						if (opt_target == TARGET_RISCV64) { riscv_patch_jal(&code, assert_sites.p[ci], sa - assert_sites.p[ci]); }
						else if (opt_target == TARGET_ARM64) { arm64_patch_call(&code, assert_sites.p[ci], sa - assert_sites.p[ci]); }
						else { buf_patch32(&code, assert_sites.p[ci], sa - (assert_sites.p[ci] + 4)); }
					}
					ci = ci + 1;
				}
			}
			ai = ai + 1;
		}
	}

	if (opt_backtrace && (bounds_checks.n != 0 || assert_sites.n != 0)) {
		var wa i64 = code.n;
		gen_bt_walker();
		var ji i64 = 0;
		while (ji < bt_jmps.n) {
			if (opt_target == TARGET_RISCV64) { riscv_patch_jal(&code, bt_jmps.p[ji], wa - bt_jmps.p[ji]); }
			else { buf_patch32(&code, bt_jmps.p[ji], wa - (bt_jmps.p[ji] + 4)); }
			ji = ji + 1;
		}
	}

	if (coro_switch_refs.n != 0) {
		if (opt_target == TARGET_RISCV64) { gen_coro_switch_stub_riscv(); }
		else if (opt_target == TARGET_ARM64) { gen_coro_switch_stub_arm64(); }
		else { gen_coro_switch_stub(); }
		var wi i64 = 0;
		while (wi < coro_switch_refs.n) {
			var site i64 = coro_switch_refs.p[wi];
			if (opt_target == TARGET_RISCV64) { riscv_patch_jal(&code, site, coro_switch_at - site); }
			else if (opt_target == TARGET_ARM64) { arm64_patch_call(&code, site, coro_switch_at - site); }
			else { buf_patch32(&code, site, coro_switch_at - (site + 4)); }
			wi = wi + 1;
		}
	}

	if (coro_stub_refs.n != 0) {
		if (opt_target == TARGET_RISCV64) { gen_coro_stub_riscv(); }
		else if (opt_target == TARGET_ARM64) { gen_coro_stub_arm64(); }
		else { gen_coro_stub(); }
		var si i64 = 0;
		while (si < coro_stub_refs.n) {
			var abs i64 = opt_base + hdr + coro_stub_at;
			if (opt_target == TARGET_RISCV64) { riscv_patch_auipc_addi(coro_stub_refs.p[si], abs); }
			else if (opt_target == TARGET_ARM64) { arm64_patch_movz_movk_addr(coro_stub_refs.p[si], abs); }
			else {
				var kk i64 = 0;
				while (kk < 8) {
					code.p[coro_stub_refs.p[si] + kk] = ((abs >> (kk * 8)) & 255) as u8;
					kk = kk + 1;
				}
			}
			si = si + 1;
		}
	}

	if (tls_init_refs.n != 0) {
		if (opt_target == TARGET_RISCV64) { gen_tls_init_stub_riscv(); }
		else if (opt_target == TARGET_ARM64) { gen_tls_init_stub_arm64(); }
		else { gen_tls_init_stub(); }
		var ti i64 = 0;
		while (ti < tls_init_refs.n) {
			var site i64 = tls_init_refs.p[ti];
			if (opt_target == TARGET_RISCV64) { riscv_patch_jal(&code, site, tls_stub_at - site); }
			else if (opt_target == TARGET_ARM64) { arm64_patch_call(&code, site, tls_stub_at - site); }
			else { buf_patch32(&code, site, tls_stub_at - (site + 4)); }
			ti = ti + 1;
		}
	}

	// The data segment sits right after code and rodata, so the code has to
	// end on a word boundary or every global lands misaligned. RISC-V words
	// are 4 bytes; the data segment needs 8, so a 4-mod-8 code length pads
	// one more instruction.
	if (opt_target == TARGET_RISCV64) {
		// Compressed instructions leave code.n on 2-byte boundaries: pad
		// with 2-byte c.nop words (0x0001 = c.addi x0, 0), not 4-byte nops
		// that would never change the alignment.
		while ((code.n & 3) != 0) { c16(0x0001); }
		if ((code.n & 7) == 4) { c16(0x0001); c16(0x0001); }
	} else {
		while ((code.n & 7) != 0) { b1(0x90); }
	}
}


fn codegen(u *Unit, img *Image) {
	gen_unit = u;
	var panic_id int = u.nstrs;
	if (opt_object) {
		// The object's panic stub references the message through a `.Lstrd`
		// symbol, so the bounds message has to be a real string in u.strs
		// (the exe path appends it as raw bytes after the pass loop instead).
		// Reserved here only in object mode: an exe without arrays carries no
		// panic machinery at all.
		panic_id = add_str("index out of bounds\n");
		u.strs = strlist_head;
		u.nstrs = nstrs;
	}
	// Exe mode drops what nothing reachable touches; object mode ships
	// everything (a linker decides what it needs). Marking runs before
	// rodata and .data layout, since those skip unmarked entries.
	if (!opt_object) { mark_reachable(u); }
	var bytes_off *i64 = arena_alloc((u.nstrs as i64 + 1) * 8, 8) as *i64;
	str_off = arena_alloc((u.nstrs as i64 + 1) * 8, 8) as *i64;

	var s *StrLit = u.strs;
	while (s as i64 != 0) {
		if (!s.keep && !opt_object) { s = s.next; continue; }
		bytes_off[s.id] = rodata.n;
		buf_bytes(&rodata, s.s.ptr, s.s.len);
		buf_u8(&rodata, 0);
		s = s.next;
	}
	while ((rodata.n & 7) != 0) { buf_u8(&rodata, 0); }

	s = u.strs;
	while (s as i64 != 0) {
		if (!s.keep && !opt_object) { s = s.next; continue; }
		str_off[s.id] = rodata.n;
		buf_u64(&rodata, 0);
		buf_u64(&rodata, s.s.len);
		s = s.next;
	}

	embed_prepare();
	layout_globals(u.globals, u.funcs);
	embed_append();
	if (opt_object) {
		// `-c`: no entry, no panic stub, no gc roots. Code plus the
		// relocation list is all the object needs; the exe patching below
		// is skipped entirely.
		var pass int = 0;
		while (true) {
			reset_code();
			var f *Func = u.funcs;
			while (f as i64 != 0) {
				if (f.nct == 0 && f.body as i64 != 0) { gen_func(f); }
				f = f.next;
			}
			if (!br_grew || pass >= 8) { break; }
			pass = pass + 1;
		}
		// The bounds trampolines and the panic/assert stubs are appended
		// after the last pass (reset_code clears the lists per pass). Their
		// rel32 jumps are intra-image, patched the same way the exe path
		// does; the stub message pointers carry real relocations.
		if (bounds_checks.n != 0) {
			var panic_addr i64 = code.n;
			gen_panic_stub(panic_id, 20);
			var i i64 = 0;
			while (i < bounds_checks.n) {
				if (opt_target == TARGET_RISCV64) { riscv_patch_jal(&code, bounds_checks.p[i], panic_addr - bounds_checks.p[i]); }
				else if (opt_target == TARGET_ARM64) { arm64_patch_call(&code, bounds_checks.p[i], panic_addr - bounds_checks.p[i]); }
			else { buf_patch32(&code, bounds_checks.p[i], panic_addr - (bounds_checks.p[i] + 4)); }
				i = i + 1;
			}
		}
		if (assert_sites.n != 0) {
			var ai i64 = 0;
			while (ai < assert_sites.n) {
				var msg i64 = assert_msgs.p[ai];
				var dup bool = false;
				var bi i64 = 0;
				while (bi < ai) {
					if (assert_msgs.p[bi] == msg) { dup = true; }
					bi = bi + 1;
				}
				if (!dup) {
					var len i64 = 0;
					var ls *StrLit = u.strs;
					while (ls as i64 != 0) {
						if (ls.id == (msg as int)) { len = ls.s.len; }
						ls = ls.next;
					}
					var sa i64 = code.n;
					gen_panic_stub(msg as int, len);
					var ci i64 = 0;
					while (ci < assert_sites.n) {
						if (assert_msgs.p[ci] == msg) {
							if (opt_target == TARGET_RISCV64) { riscv_patch_jal(&code, assert_sites.p[ci], sa - assert_sites.p[ci]); }
							else if (opt_target == TARGET_ARM64) { arm64_patch_call(&code, assert_sites.p[ci], sa - assert_sites.p[ci]); }
							else { buf_patch32(&code, assert_sites.p[ci], sa - (assert_sites.p[ci] + 4)); }
						}
						ci = ci + 1;
					}
				}
				ai = ai + 1;
			}
		}
		img.code = code;
		img.rodata = rodata;
		img.data = gdata;
		img.bss_size = bss_size;
		img.nph = 1;
		img.funcs = u.funcs;
		img.globals = u.globals;
		img.strs = u.strs;
		img.nstrs = u.nstrs;
		img.str_off = str_off;
		img.bytes_off = bytes_off;
		img.relocs = relocs_head;
		// The string headers in .rodata carry their own relocation (the ptr
		// field points at the bytes), collected after the pass loop because
		// reset_code clears the relocation lists at every pass boundary.
		var sr *StrLit = u.strs;
		while (sr as i64 != 0) {
			if (sr.nullhdr || (!sr.keep && !opt_object)) { sr = sr.next; continue; }
			var fr *Reloc = arena_alloc(sizeof(Reloc), 8) as *Reloc;
			fr.at = str_off[sr.id];
			fr.id = sr.id as i64;
			fr.kind = REL_ABS64;
			if (rodata_relocs_tail as i64 == 0) { rodata_relocs_head = fr; }
			else { rodata_relocs_tail.next = fr; }
			rodata_relocs_tail = fr;
			sr = sr.next;
		}
		img.rodata_relocs = rodata_relocs_head;
		return;
	}
	var nph int = 1;
	if (gdata.n + bss_size > 0) { nph = 2; }
	var hdr i64 = EHDR_SZ + PHDR_SZ * (nph as i64);
	riscv_image_hdr = hdr;

	var main_fn *Func = find_func("main");
	if (main_fn as i64 == 0 && top_asm_head as i64 == 0 && entry_name.len == 0) {
		die("error: no 'main' function");
	}
	if (main_fn as i64 != 0 && main_fn.nparams != 0 && main_fn.nparams != 2) {
		die("error: 'main' takes no parameters or (argc, argv)");
	}
	var pass int = 0;
	while (true) {
		reset_code();
		emit_code(u, main_fn, panic_id, hdr);
		if (!br_grew || pass >= 8) { break; }
		pass = pass + 1;
	}

	// The backtrace's function table: u64 count, then one {u32 delta from
	// opt_base, u32 name_off} per function in source order, then the
	// NUL-terminated names. The walker resolves an address with a linear
	// scan, so the table is deliberately unsorted.
	var bt_table_off i64 = -1;
	if (opt_backtrace && (bounds_checks.n != 0 || assert_sites.n != 0)) {
		var cnt i64 = 0;
		var ft *Func = u.funcs;
		while (ft as i64 != 0) {
			if (ft.nct == 0 && ft.reachable) { cnt = cnt + 1; }
			ft = ft.next;
		}
		bt_table_off = rodata.n;
		buf_u64(&rodata, cnt);
		var entries_off i64 = rodata.n;
		var zi i64 = 0;
		while (zi < cnt) { buf_u64(&rodata, 0); zi = zi + 1; }
		var name_off i64 = 0;
		var ei i64 = 0;
		ft = u.funcs;
		while (ft as i64 != 0) {
			if (ft.nct == 0 && ft.reachable) {
				var eo i64 = entries_off + ei * 8;
				var delta i64 = hdr + ft.addr;
				var k3 i64 = 0;
				while (k3 < 4) {
					rodata.p[eo + k3] = ((delta >> (k3 * 8)) & 255) as u8;
					rodata.p[eo + 4 + k3] = ((name_off >> (k3 * 8)) & 255) as u8;
					k3 = k3 + 1;
				}
				buf_bytes(&rodata, ft.name.ptr, ft.name.len);
				buf_u8(&rodata, 0);
				name_off = name_off + ft.name.len + 1;
				ei = ei + 1;
			}
			ft = ft.next;
		}
	}

	// The bounds-check panic message goes here, after the pass loop, and
	// only when a bounds check actually exists: a program without arrays
	// carries no panic machinery at all. It has to stay inside the aligned
	// rodata, or the data segment (and every GC word read in it) would be
	// misaligned. The stub's length must match: 20.
	if (bounds_checks.n != 0) {
		var pmsg str = "index out of bounds\n";
		bytes_off[panic_id] = rodata.n;
		buf_bytes(&rodata, pmsg.ptr, pmsg.len);
	}
	while ((rodata.n & 7) != 0) { buf_u8(&rodata, 0); }

	var dbase i64 = opt_base + SEG_GAP + hdr + code.n + rodata.n;
	embed_patch(dbase);
	if (opt_target == TARGET_RISCV64) {
		var bi i64 = 0;
		while (bi < gc_base_refs.n) {
			riscv_patch_auipc_addi(gc_base_refs.p[bi], dbase);
			bi = bi + 1;
		}
		var ei i64 = 0;
		while (ei < gc_end_refs.n) {
			riscv_patch_auipc_addi(gc_end_refs.p[ei], dbase + gdata.n + bss_size);
			ei = ei + 1;
		}
	} else if (opt_target == TARGET_ARM64) {
		var bi i64 = 0;
		while (bi < gc_base_refs.n) {
			arm64_patch_movz_movk_addr(gc_base_refs.p[bi], dbase);
			bi = bi + 1;
		}
		var ei i64 = 0;
		while (ei < gc_end_refs.n) {
			arm64_patch_movz_movk_addr(gc_end_refs.p[ei], dbase + gdata.n + bss_size);
			ei = ei + 1;
		}
	} else {
		patch_abs(&gc_base_refs, dbase);
		patch_abs(&gc_end_refs, dbase + gdata.n + bss_size);
	}
	if (tls_stub_at != -1 && opt_target == TARGET_RISCV64) {
		var tabs2 i64 = dbase + tls_template_off;
		var tsk i64 = 0;
		while (tsk < tls_src_refs.n) {
			riscv_patch_auipc_addi(tls_src_refs.p[tsk], tabs2);
			tsk = tsk + 1;
		}
	} else if (tls_stub_at != -1 && opt_target == TARGET_ARM64) {
		var tabs2 i64 = dbase + tls_template_off;
		var tsk i64 = 0;
		while (tsk < tls_src_refs.n) {
			arm64_patch_movz_movk_addr(tls_src_refs.p[tsk], tabs2);
			tsk = tsk + 1;
		}
	} else if (tls_stub_at != -1) {
		var tabs i64 = dbase + tls_template_off;
		var tkk i64 = 0;
		while (tkk < 8) {
			code.p[tls_stub_src_at + tkk] = ((tabs >> (tkk * 8)) & 255) as u8;
			tkk = tkk + 1;
		}
	}

	var af *CallFixup = funcaddrs_head;
	while (af as i64 != 0) {
		var at *Func = find_func(af.name);
		if (at as i64 == 0) {
			emsg("undefined function '"); emsg(af.name); emsg("'"); efail(af.pos);
		}
		if (at.body as i64 == 0) {
			emsg("extern '"); emsg(af.name);
			emsg("' is not linked (extern needs -c and the linker)"); efail(af.pos);
		}
		var abs2 i64 = opt_base + hdr + at.addr;
		if (opt_target == TARGET_RISCV64) { riscv_patch_auipc_addi(af.at, abs2); }
		else if (opt_target == TARGET_ARM64) { arm64_patch_movz_movk_addr(af.at, abs2); }
		else {
			var j i64 = 0;
			while (j < 8) {
				code.p[af.at + j] = ((abs2 >> (j * 8)) & 255) as u8;
				j = j + 1;
			}
		}
		af = af.next;
	}

	var cf *CallFixup = calls_head;
	while (cf as i64 != 0) {
		var target *Func = find_func(cf.name);
		if (target as i64 == 0) {
			emsg("undefined function '"); emsg(cf.name); emsg("'"); efail(cf.pos);
		}
		if (target.body as i64 == 0) {
			emsg("extern '"); emsg(cf.name);
			emsg("' is not linked (extern needs -c and the linker)"); efail(cf.pos);
		}
		if (opt_target == TARGET_RISCV64) { riscv_patch_jal(&code, cf.at, target.addr - cf.at); }
		else if (opt_target == TARGET_ARM64) { arm64_patch_call(&code, cf.at, target.addr - cf.at); }
		else { buf_patch32(&code, cf.at, target.addr - (cf.at + 4)); }
		cf = cf.next;
	}

	var ar *CallFixup = asmrefs_head;
	while (ar as i64 != 0) {
		var afn *Func = find_func(ar.name);
		var aval i64 = 0;
		if (afn as i64 != 0) {
			aval = opt_base + hdr + afn.addr;
		} else {
			var gv *Var = find_global(ar.name);
			if (gv as i64 == 0) {
				emsg("undefined symbol '"); emsg(ar.name); emsg("'"); efail(ar.pos);
			}
			aval = dbase + gv.data_off;
		}
		if (opt_target == TARGET_RISCV64) { riscv_patch_auipc_addi(ar.at, aval); }
		else if (opt_target == TARGET_ARM64) { arm64_patch_movz_movk_addr(ar.at, aval); }
		else if (ar.abs32) { buf_patch32(&code, ar.at, aval); }
		else {
			var j5 i64 = 0;
			while (j5 < 8) {
				code.p[ar.at + j5] = ((aval >> (j5 * 8)) & 255) as u8;
				j5 = j5 + 1;
			}
		}
		ar = ar.next;
	}

	var sf *StrFixup = strrefs_head;
	while (sf as i64 != 0) {
		var sf_addr i64 = opt_base + hdr + code.n + str_off[sf.id];
		if (opt_target == TARGET_RISCV64) { riscv_patch_auipc_addi(sf.at, sf_addr); }
		else if (opt_target == TARGET_ARM64) { arm64_patch_movz_movk_addr(sf.at, sf_addr); }
		else if (base_is_wide()) { patch64(&code, sf.at, sf_addr); }
		else { buf_patch32(&code, sf.at, sf_addr); }
		sf = sf.next;
	}

	var rodata_vaddr i64 = opt_base + hdr + code.n;
	var pm i64 = 0;
	while (pm < panic_msg_at.n) {
		var pm_addr i64 = rodata_vaddr + bytes_off[panic_msg_ids.p[pm]];
		if (opt_target == TARGET_RISCV64) { riscv_patch_auipc_addi(panic_msg_at.p[pm], pm_addr); }
		else if (opt_target == TARGET_ARM64) { arm64_patch_movz_movk_addr(panic_msg_at.p[pm], pm_addr); }
		else if (base_is_wide()) { patch64(&code, panic_msg_at.p[pm], pm_addr); }
		else { buf_patch32(&code, panic_msg_at.p[pm], pm_addr); }
		pm = pm + 1;
	}
	if (bt_table_off >= 0) {
		if (opt_target == TARGET_RISCV64) {
			riscv_patch_auipc_addi(bt_auipc_at, rodata_vaddr + bt_table_off);
		}
		var bi2 i64 = 0;
		while (bi2 < bt_base_refs.n) {
			buf_patch32(&code, bt_base_refs.p[bi2], rodata_vaddr + bt_table_off);
			bi2 = bi2 + 1;
		}
	}
	s = u.strs;
	while (s as i64 != 0) {
		var abs i64 = rodata_vaddr + bytes_off[s.id];
		if (s.nullhdr || (!s.keep && !opt_object)) { s = s.next; continue; }
		var k i64 = 0;
		while (k < 8) {
			rodata.p[str_off[s.id] + k] = ((abs >> (k * 8)) & 255) as u8;
			k = k + 1;
		}
		s = s.next;
	}

	var df *DataFixup = datarefs_head;
	while (df as i64 != 0) {
		if (opt_target == TARGET_RISCV64) {
			riscv_patch_auipc_addi(df.at, dbase + df.varp.data_off);
		}
		else if (opt_target == TARGET_ARM64) { arm64_patch_movz_movk_addr(df.at, dbase + df.varp.data_off); }
		else if (base_is_wide()) { patch64(&code, df.at, dbase + df.varp.data_off); }
		else { buf_patch32(&code, df.at, dbase + df.varp.data_off); }
		df = df.next;
	}

	img.code = code;
	img.rodata = rodata;
	img.data = gdata;
	img.bss_size = bss_size;
	if (entry_name.len != 0) {
		var ef *Func = find_func(entry_name);
		if (ef as i64 == 0) {
			emsg("unknown entry function '"); emsg(entry_name); emsg("'"); efail(0);
		}
		img.entry = ef.addr;
	} else {
		img.entry = 0;
	}
	img.nph = nph;
}
