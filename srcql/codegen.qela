import "comp.qela";
import "diag.qela";
import "type.qela";
import "regalloc.qela";
import "ir.qela";

let RAX = 0;
let RCX = 1;
let RDX = 2;
let RSP = 4;
let RBP = 5;
let RSI = 6;
let RDI = 7;

// The integer argument register for rank i on the current target -- the
// register-mapping half of the ABI, mirrored by abi_n_arg_regs() in
// comp.qela. SysV AMD64 order is rdi, rsi, rdx, rcx, r8, r9; AAPCS64 is
// simply x0..x7, whose encodings are 0..7. A rank past the target's register
// count is unreachable: parse.qela spills parameters beyond abi_n_arg_regs().
fn call_reg(i int) int {
	if (opt_target == TARGET_ARM64) { return i; }
	if (i == 0) { return RDI; }
	if (i == 1) { return RSI; }
	if (i == 2) { return RDX; }
	if (i == 3) { return RCX; }
	if (i == 4) { return R8; }
	return R9;
}

fn sys_reg(i int) int {
	if (opt_target == TARGET_ARM64) { return call_reg(i); }
	if (i == 3) { return R10; }
	return call_reg(i);
}

// The frontend stages a binop's right operand into one fixed register per
// target (gen_expr's two-operand preamble). The IR carries the rank, not the
// register; this is the rank->register map, the mirror of call_reg. x86 uses
// rdi (rank 0); ARM64 will use x1 so it never collides with the accumulator.
fn op2_reg(rank int) int {
	if (opt_target == TARGET_ARM64) { return 1; }
	return RDI;
}

struct I64List { p *i64, n i64, cap i64, }

fn ilist_push(l *I64List, v i64) {
	if (l.n == l.cap) {
		var cap i64 = 8;
		if (l.cap != 0) { cap = l.cap * 2; }
		var q *i64 = arena_alloc(cap * 8, 8) as *i64;
		var i i64 = 0;
		while (i < l.n) { q[i] = l.p[i]; i = i + 1; }
		l.p = q;
		l.cap = cap;
	}
	l.p[l.n] = v;
	l.n = l.n + 1;
}

fn ilist_set(l *I64List, i i64, v i64) {
	while (l.n <= i) { ilist_push(l, 0); }
	l.p[i] = v;
}

struct CallFixup;
struct CallFixup { next *CallFixup, at i64, name str, pos i64, }

struct StrFixup;
struct StrFixup { next *StrFixup, at i64, id int, }

struct DataFixup;
struct DataFixup { next *DataFixup, at i64, varp *Var, }

// `qela -c` output: every fixup the exe path would patch is kept as a
// relocation instead. at is the byte offset inside its section; kind is the
// x86-64 relocation type; name resolves through the object's symbol table
// (functions, globals and the generated `.Lstr` symbols).
var relocs_head *Reloc;
var relocs_tail *Reloc;
var rodata_relocs_head *Reloc;
var rodata_relocs_tail *Reloc;

// String relocations carry the string's id in Reloc.id (name is empty);
// every other relocation names its symbol. The object writer turns the id
// into the generated `.Lstr<N>` symbol.
fn push_reloc(at i64, name str, kind int) {
	var f *Reloc = arena_alloc(sizeof(Reloc), 8) as *Reloc;
	f.at = at;
	f.name = name;
	f.kind = kind;
	if (relocs_tail as i64 == 0) { relocs_head = f; } else { relocs_tail.next = f; }
	relocs_tail = f;
}

fn push_reloc_id(at i64, id i64, kind int) {
	var f *Reloc = arena_alloc(sizeof(Reloc), 8) as *Reloc;
	f.at = at;
	f.id = id;
	f.kind = kind;
	if (relocs_tail as i64 == 0) { relocs_head = f; } else { relocs_tail.next = f; }
	relocs_tail = f;
}

struct Loop;
struct Loop { prev *Loop, brk i64, cont i64, depth int, }

struct DeferScope;
struct DeferScope { prev *DeferScope, list *Node, depth int, }

var code Buf;
var rodata Buf;
var gdata Buf;
var bss_size i64;
var depth int;
// Total 8-byte slots gen_args pushed for the current call's stack-spilled
// arguments, padding included -- gen_call reads this to clean up exactly
// what went on the stack, without re-deriving the padding decision.
var overflow_pushed i64;
var cur_loop *Loop;
var gen_fn *Func;
var cur_defers *DeferScope;
var defer_depth int;

var calls_head *CallFixup;
var calls_tail *CallFixup;
var asmrefs_head *CallFixup;
var asmrefs_tail *CallFixup;
var strrefs_head *StrFixup;
var strrefs_tail *StrFixup;
var datarefs_head *DataFixup;
var datarefs_tail *DataFixup;
var str_off *i64;
var bounds_checks I64List;
var fn_bounds I64List;
var assert_sites I64List;
var assert_msgs I64List;
var panic_msg_at I64List;
var panic_msg_ids I64List;
var bt_base_refs I64List;
var bt_jmps I64List;
var funcaddrs_head *CallFixup;
var funcaddrs_tail *CallFixup;
var coro_stub_at i64 = -1;
var coro_stub_refs I64List;
var gc_base_refs I64List;
var gc_end_refs I64List;

// tvar (thread-local) support: a flat, compiler-private %fs:offset block,
// not the ELF PT_TLS ABI -- there is no dynamic linker here to need it.
// Offset 0 in the block is a self-pointer (the ABI convention every real
// TLS implementation also uses, since LEA cannot read a segment base).
var tls_template_off i64 = 0;
var tls_block_size i64 = 8;
var tls_init_refs I64List;
var tls_stub_at i64 = -1;
var tls_stub_src_at i64 = -1;

var opt_no_bounds bool = false;
var opt_backtrace bool = false;
// `qela -c`: emit a relocatable object instead of a static binary. The
// relocation list replaces the address patching, and the ELF writer's
// object path builds a .o the system linker can consume.
var opt_object bool = false;
var gen_unit *Unit;

fn b1(v i64) { buf_u8(&code, (v & 255) as u8); }
fn b4(v i64) { buf_u32(&code, v); }

fn rex_w(reg int, rm int) {
	var v i64 = 0x48;
	if (reg >= 8) { v = v | 4; }
	if (rm >= 8) { v = v | 1; }
	b1(v);
}

fn modrm(mod int, reg int, rm int) {
	b1(((mod as i64) << 6) | (((reg as i64) & 7) << 3) | ((rm as i64) & 7));
}

fn push_reg(r int) {
	if (r >= 8) { b1(0x41); }
	b1(0x50 + ((r as i64) & 7));
	depth = depth + 1;
}

fn pop_reg(r int) {
	if (r >= 8) { b1(0x41); }
	b1(0x58 + ((r as i64) & 7));
	depth = depth - 1;
}

fn mov_reg_imm(r int, v i64) {
	if (v == 0) {
		if (r >= 8) { b1(0x45); }
		b1(0x31);
		modrm(3, r, r);
		return;
	}
	if (v > 0 && v <= 0xffffffff) {
		if (r >= 8) { b1(0x41); }
		b1(0xb8 + ((r as i64) & 7));
		b4(v);
		return;
	}
	if (v >= -2147483648 && v <= 2147483647) {
		rex_w(0, r);
		b1(0xc7);
		modrm(3, 0, r);
		b4(v);
		return;
	}
	rex_w(0, r);
	b1(0xb8 + ((r as i64) & 7));
	buf_u64(&code, v);
}

fn mov_reg_reg(dst int, src int) {
	if (dst == src) { return; }
	rex_w(src, dst);
	b1(0x89);
	modrm(3, src, dst);
}

fn rbp_mem(op i64, reg int, disp i64) {
	rex_w(reg, RBP);
	b1(op);
	if (disp >= -128 && disp <= 127) {
		modrm(1, reg, RBP);
		b1(disp);
	} else {
		modrm(2, reg, RBP);
		b4(disp);
	}
}

fn lea_local(reg int, off i64) { rbp_mem(0x8d, reg, -off); }
fn ld_local(reg int, off i64) { rbp_mem(0x8b, reg, -off); }
fn st_local(off i64, reg int) { rbp_mem(0x89, reg, -off); }

fn ld_at_rax(reg int, disp i64) {
	rex_w(reg, RAX);
	b1(0x8b);
	if (disp == 0) {
		modrm(0, reg, RAX);
	} else {
		modrm(1, reg, RAX);
		b1(disp);
	}
}

fn push_at_rax(disp i64) {
	b1(0xff);
	if (disp == 0) {
		modrm(0, 6, RAX);
	} else {
		modrm(1, 6, RAX);
		b1(disp);
	}
	depth = depth + 1;
}

fn load(ty *Type) {
	if (ty.size == 1) {
		b1(0x48); b1(0x0f);
		if (ty.is_unsigned || ty.kind == TY_BOOL) { b1(0xb6); } else { b1(0xbe); }
		modrm(0, RAX, RAX);
		return;
	}
	if (ty.size == 2) {
		b1(0x48); b1(0x0f);
		if (ty.is_unsigned) { b1(0xb7); } else { b1(0xbf); }
		modrm(0, RAX, RAX);
		return;
	}
	if (ty.size == 4) {
		if (ty.is_unsigned || ty.kind == TY_FLOAT) { b1(0x8b); } else { b1(0x48); b1(0x63); }
		modrm(0, RAX, RAX);
		return;
	}
	b1(0x48); b1(0x8b);
	modrm(0, RAX, RAX);
}

fn store(ty *Type) {
	pop_reg(RDI);
	if (ty.size == 1) { b1(0x88); modrm(0, RAX, RDI); return; }
	if (ty.size == 2) { b1(0x66); b1(0x89); modrm(0, RAX, RDI); return; }
	if (ty.size == 4) { b1(0x89); modrm(0, RAX, RDI); return; }
	b1(0x48); b1(0x89); modrm(0, RAX, RDI);
}

fn truncate_to(ty *Type) {
	if (ty.size == 1) {
		b1(0x48); b1(0x0f);
		if (ty.is_unsigned || ty.kind == TY_BOOL) { b1(0xb6); } else { b1(0xbe); }
		modrm(3, RAX, RAX);
		return;
	}
	if (ty.size == 2) {
		b1(0x48); b1(0x0f);
		if (ty.is_unsigned) { b1(0xb7); } else { b1(0xbf); }
		modrm(3, RAX, RAX);
		return;
	}
	if (ty.size == 4) {
		if (ty.is_unsigned || ty.kind == TY_FLOAT) {
			b1(0x89); modrm(3, RAX, RAX);
		} else {
			b1(0x48); b1(0x63); modrm(3, RAX, RAX);
		}
	}
}

fn test_rax() {
	b1(0x48); b1(0x85);
	modrm(3, RAX, RAX);
}

fn setcc(cc i64) {
	b1(0x0f);
	b1(cc);
	modrm(3, 0, RAX);
	b1(0x0f); b1(0xb6);
	modrm(3, RAX, RAX);
}

// Branches are emitted long, then the whole unit is emitted again with the
// ones that turned out to be within a byte encoded short. Branch ids come from
// the walk order of the tree, so they name the same branch in every pass, and
// shortening only ever brings targets closer, so the choice never has to be
// taken back.
var br_at I64List;
var br_short I64List;
var br_n i64;
var br_grew bool;

fn br_is_short(id i64) bool {
	return id < br_short.n && br_short.p[id] != 0;
}

fn jump(opcode2 i64) i64 {
	var id i64 = br_n;
	br_n = br_n + 1;
	if (br_is_short(id)) {
		if (opcode2 != 0) { b1(opcode2 - 0x10); } else { b1(0xeb); }
		ilist_set(&br_at, id, code.n);
		b1(0);
	} else {
		if (opcode2 != 0) { b1(0x0f); b1(opcode2); } else { b1(0xe9); }
		ilist_set(&br_at, id, code.n);
		b4(0);
	}
	return id;
}

// A backward branch to a target already emitted: unlike jump()/patch_here(),
// which patch a placeholder once the far end is known, both ends are known
// up front here, so the short-vs-near choice is made in one pass.
fn jump_back(target i64) {
	var back i64 = target - (code.n + 2);
	if (back >= -128 && back <= 127) {
		b1(0xeb); b1(back);
	} else {
		b1(0xe9);
		b4(target - (code.n + 4));
	}
}

fn patch_here(id i64) {
	var at i64 = br_at.p[id];
	if (br_is_short(id)) {
		var d8 i64 = code.n - (at + 1);
		if (d8 < -128 || d8 > 127) { die("internal: short branch out of range"); }
		code.p[at] = (d8 & 255) as u8;
		return;
	}
	var d i64 = code.n - (at + 4);
	buf_patch32(&code, at, d);
	if (d >= -128 && d <= 127) {
		ilist_set(&br_short, id, 1);
		br_grew = true;
	}
}

fn add_call(name str, pos i64) {
	b1(0xe8);
	var f *CallFixup = arena_alloc(sizeof(CallFixup), 8) as *CallFixup;
	f.at = code.n;
	f.name = name;
	f.pos = pos;
	if (calls_tail as i64 == 0) { calls_head = f; } else { calls_tail.next = f; }
	calls_tail = f;
	b4(0);
	if (opt_object) { push_reloc(f.at, name, REL_PCREL32_PLT); }
}

// `$rel name` in asm operands: a rel32 slot patched like a call target.
fn add_callref(name str, pos i64) {
	b4(0);
	var f *CallFixup = arena_alloc(sizeof(CallFixup), 8) as *CallFixup;
	f.at = code.n - 4;
	f.name = name;
	f.pos = pos;
	if (calls_tail as i64 == 0) { calls_head = f; } else { calls_tail.next = f; }
	calls_tail = f;
	if (opt_object) { push_reloc(f.at, name, REL_PCREL32); }
}

// `$name` in asm operands: an 8-byte absolute address slot.
fn add_absref(name str, pos i64) {
	var k i64 = 0;
	while (k < 8) { b1(0); k = k + 1; }
	var f *CallFixup = arena_alloc(sizeof(CallFixup), 8) as *CallFixup;
	f.at = code.n - 8;
	f.name = name;
	f.pos = pos;
	if (asmrefs_tail as i64 == 0) { asmrefs_head = f; } else { asmrefs_tail.next = f; }
	asmrefs_tail = f;
	if (opt_object) { push_reloc(f.at, name, REL_ABS64); }
}

fn add_strref(reg int, id int) {
	if (opt_object) {
		// RIP-relative slot the linker resolves: the address of the string
		// header is S + A - P from the slot, so it works at any load base
		// (PIE included). The absolute mov below would only fit a -no-pie
		// image, and R_X86_64_32S forces DT_TEXTREL there.
		rip_ref(0x8d, reg);
		var f *StrFixup = arena_alloc(sizeof(StrFixup), 8) as *StrFixup;
		f.at = code.n;
		f.id = id;
		if (strrefs_tail as i64 == 0) { strrefs_head = f; } else { strrefs_tail.next = f; }
		strrefs_tail = f;
		b4(0);
		push_reloc_id(f.at, id as i64, REL_PCREL32);
		return;
	}
	if (reg >= 8) { b1(0x41); }
	b1(0xb8 + ((reg as i64) & 7));
	var f *StrFixup = arena_alloc(sizeof(StrFixup), 8) as *StrFixup;
	f.at = code.n;
	f.id = id;
	if (strrefs_tail as i64 == 0) { strrefs_head = f; } else { strrefs_tail.next = f; }
	strrefs_tail = f;
	b4(0);
}

fn add_dataref(v *Var) {
	if (opt_object) {
		// Every global is a RIP-relative lea here: own symbols and exported
		// externs live in this image, and an imported extern resolves at
		// static link (gcc -fno-pic uses the same PC32 references). The
		// GOT path would be needed only for DSO data, and binutils 2.46
		// aborts on our GOTPCREL objects -- so externs must be statically
		// linked, no shared-library data.
		rip_ref(0x8d, RAX);
		var at i64 = code.n;
		b4(0);
		push_reloc(at, v.name, REL_PCREL32);
		return;
	}
	if (v.extern && !v.has_init) {
		var sb Buf;
		fmt_str(&sb, "extern '");
		fmt_str(&sb, v.name);
		fmt_str(&sb, "' is not linked (extern needs -c and the linker)");
		error_at(v.pos, buf_str(&sb));
	}
	b1(0xb8);
	var f *DataFixup = arena_alloc(sizeof(DataFixup), 8) as *DataFixup;
	f.at = code.n;
	f.varp = v;
	if (datarefs_tail as i64 == 0) { datarefs_head = f; } else { datarefs_tail.next = f; }
	datarefs_tail = f;
	b4(0);
}

// `lea reg, [rip + disp32]` / `mov reg, [rip + disp32]` in object mode: the
// disp is a relocation the linker fills, so a reference works at any load
// base. op 0x8d is a lea (own symbol), 0x8b a GOT load (imported extern).
fn rip_ref(op int, reg int) {
	if ((reg as i64) >= 8) { b1(0x49); } else { b1(0x48); }
	b1(op);
	b1(0x05 | (((reg as i64) & 7) << 3));
}

fn add_funcaddr(name str, pos i64) {
	rex_w(0, RAX);
	b1(0xb8);
	var f *CallFixup = arena_alloc(sizeof(CallFixup), 8) as *CallFixup;
	f.at = code.n;
	f.name = name;
	f.pos = pos;
	if (funcaddrs_tail as i64 == 0) { funcaddrs_head = f; }
	else { funcaddrs_tail.next = f; }
	funcaddrs_tail = f;
	buf_u64(&code, 0);
	if (opt_object) { push_reloc(f.at, name, REL_ABS64); }
}

fn add_rax_imm(v i64) {
	if (v == 0) { return; }
	b1(0x48);
	if (v >= -128 && v <= 127) {
		b1(0x83);
		modrm(3, 0, RAX);
		b1(v);
	} else {
		b1(0x81);
		modrm(3, 0, RAX);
		b4(v);
	}
}

fn scale_by(size int) {
	if (size == 1) { return; }
	mov_reg_imm(RCX, size as i64);
	b1(0x48); b1(0x0f); b1(0xaf);
	modrm(3, RAX, RCX);
}

// A bounds check jumps to a trampoline at the end of its own function rather
// than to the panic stub at the end of the image, so branch relaxation can
// bring it down to two bytes.
fn jump_bounds(cc i64) {
	ilist_push(&fn_bounds, jump(cc));
}

fn gen_bounds_trampoline() {
	if (fn_bounds.n == 0) { return; }
	patch_all(&fn_bounds);
	// With backtraces on this becomes a call, so the return address left on
	// the stack names the function that tripped the check.
	if (opt_backtrace) { b1(0xe8); } else { b1(0xe9); }
	ilist_push(&bounds_checks, code.n);
	b4(0);
	fn_bounds.n = 0;
}

// assert(cond, "msg") emits test; jnz over a direct call to the message's
// stub. The call is a fixed five bytes, so the jnz is always in short range
// and nothing here needs branch relaxation.
fn gen_assert(n *Node) {
	gen_expr(n.cond);
	test_rax();
	var id i64 = jump(0x85);
	b1(0xe8);
	ilist_push(&assert_sites, code.n);
	ilist_push(&assert_msgs, n.args.val);
	b4(0);
	patch_here(id);
}

// ── the backtrace walker ──
//
// Entry: the panic stub's jmp left [rsp] = the return address of the call
// that reached it, i.e. an address inside the panicking function, and rbp =
// that function's frame base (or the nearest ancestor's, for a frameless
// leaf). The walker prints the function containing [rsp], then walks the
// rbp chain printing every caller, then exits 134.
//
// r8  = function table base (patched absolute)
// rbx = address being resolved
// r9  = frames left to walk -- rcx and r11 are clobbered by syscalls
fn gen_bt_walker() {
	b1(0x41); b1(0xb8);                       // mov r8d, imm32
	ilist_push(&bt_base_refs, code.n);
	b4(0);
	b1(0x48); b1(0x8b); b1(0x1c); b1(0x24);   // mov rbx, [rsp]
	b1(0xe8);
	var c1 i64 = code.n;                      // call bt_print (rel32 field)
	b4(0);
	b1(0x49); b1(0xc7); b1(0xc1); b4(32);     // mov r9, 32 (REX.W|REX.B)
	var loop_at i64 = code.n;
	b1(0x48); b1(0x85); b1(0xed);             // test rbp, rbp
	var jz_exit i64 = code.n;
	b1(0x74); b1(0);                          // jz exit
	b1(0x48); b1(0x8b); b1(0x5d); b1(0x08);   // mov rbx, [rbp+8]
	b1(0xe8);
	var c2 i64 = code.n;                      // call bt_print (rel32 field)
	b4(0);
	b1(0x48); b1(0x8b); b1(0x6d); b1(0x00);   // mov rbp, [rbp]
	b1(0x49); b1(0xff); b1(0xc9);             // dec r9
	var jnz_loop i64 = code.n;
	b1(0x75); b1(0);                          // jnz loop
	var exit_at i64 = code.n;
	mov_reg_imm(RAX, 231);   // exit_group: a crash kills every thread, not just this one
	mov_reg_imm(RDI, 134);
	b1(0x0f); b1(0x05);
	var print_at i64 = code.n;

	// bt_print: entries are sorted by function start address, so the last
	// entry whose start is <= rbx contains rbx. The scan keeps the best
	// candidate in r11 (safe from the write syscall, which clobbers rcx
	// and r11 only after the name is located).
	b1(0x49); b1(0x8b); b1(0x00);             // mov rax, [r8]  (count)
	b1(0x48); b1(0x85); b1(0xc0);             // test rax, rax
	var jz_nf i64 = code.n;
	b1(0x74); b1(0);                          // jz notfound
	b1(0x48); b1(0x89); b1(0xc1);             // mov rcx, rax
	b1(0x49); b1(0x8d); b1(0x50); b1(0x08);   // lea rdx, [r8+8]
	mov_reg_imm(R11, 0);                      // best = 0
	b1(0x49); b1(0xc7); b1(0xc2); b4(0);      // mov r10, 0
	var scan_at i64 = code.n;
	b1(0x8b); b1(0x02);                       // mov eax, [rdx]
	alu_rax_imm(0, ELF_BASE);                 // add rax, ELF_BASE
	b1(0x48); b1(0x39); b1(0xd8);             // cmp rax, rbx
	var ja_end i64 = code.n;
	b1(0x77); b1(0);                          // ja endscan
	b1(0x49); b1(0x89); b1(0xd3);             // mov r11, rdx
	b1(0x48); b1(0x83); b1(0xc2); b1(0x08);   // add rdx, 8
	b1(0x49); b1(0xff); b1(0xc2);             // inc r10
	b1(0x49); b1(0x39); b1(0xca);             // cmp r10, rcx
	var jb_scan i64 = code.n;
	b1(0x72); b1(0);                          // jb scan
	var endscan_at i64 = code.n;
	b1(0x4d); b1(0x85); b1(0xdb);             // test r11, r11
	var jz_nf2 i64 = code.n;
	b1(0x74); b1(0);                          // jz notfound
	mov_reg_reg(RDX, R11);                    // rdx = best entry
	b1(0x8b); b1(0x72); b1(0x04);             // mov esi, [rdx+4]
	b1(0x48); b1(0xc1); b1(0xe1); b1(0x03);   // shl rcx, 3
	b1(0x48); b1(0x01); b1(0xce);             // add rsi, rcx
	rex_w(R8, RSI); b1(0x01); modrm(3, R8, RSI); // add rsi, r8
	b1(0x48); b1(0x83); b1(0xc6); b1(0x08);   // add rsi, 8
	b1(0x48); b1(0x89); b1(0xf7);             // mov rdi, rsi
	b1(0x31); b1(0xc0);                       // xor eax, eax
	b1(0x48); b1(0xc7); b1(0xc1); b4(-1);     // mov rcx, -1
	b1(0xf2); b1(0xae);                       // repne scasb
	b1(0x48); b1(0xf7); b1(0xd1);             // not rcx
	b1(0x48); b1(0xff); b1(0xc9);             // dec rcx  (length)
	mov_reg_imm(RAX, 1);
	mov_reg_imm(RDI, 2);
	mov_reg_reg(RDX, RCX);
	b1(0x0f); b1(0x05);
	var notfound_at i64 = code.n;
	b1(0xc3);                                 // ret

	code.p[jz_exit + 1] = (exit_at - (jz_exit + 2)) as u8;
	code.p[jnz_loop + 1] = (loop_at - (jnz_loop + 2)) as u8;
	code.p[jz_nf + 1] = (notfound_at - (jz_nf + 2)) as u8;
	code.p[jz_nf2 + 1] = (notfound_at - (jz_nf2 + 2)) as u8;
	code.p[ja_end + 1] = (endscan_at - (ja_end + 2)) as u8;
	code.p[jb_scan + 1] = (scan_at - (jb_scan + 2)) as u8;
	buf_patch32(&code, c1, print_at - (c1 + 4));
	buf_patch32(&code, c2, print_at - (c2 + 4));
}

fn by_ref_ty(ty *Type) bool {
	return is_aggregate(ty) && abi_by_ref(ty.size);
}

fn copy_rsi_rdi(size int) {
	mov_reg_imm(RCX, size as i64);
	b1(0xf3); b1(0xa4);
}

fn copy_aggregate(size int) {
	pop_reg(RDI);
	mov_reg_reg(RSI, RAX);
	push_reg(RDI);
	mov_reg_imm(RCX, size as i64);
	b1(0xf3); b1(0xa4);
	pop_reg(RAX);
}

// A local scalar of machine width lives at a known rbp offset, so it can be
// read or written with one instruction instead of materialising its address.
fn direct_local(n *Node) bool {
	if (n.kind != ND_VAR) { return false; }
	var v *Var = n.varp;
	if (v.is_global || v.by_ref || v.arg_stack) { return false; }
	if (is_aggregate(n.ty)) { return false; }
	return n.ty.size == 8;
}

// rax = base + idx*scale. A power-of-two element size folds the scaling and
// the addition into a single lea.
fn lea_scale_ok(scale int) bool {
	return scale == 1 || scale == 2 || scale == 4 || scale == 8;
}

fn lea_index(scale int, base int, idx int) bool {
	if (!lea_scale_ok(scale)) { return false; }
	var sh i64 = 0;
	if (scale == 2) { sh = 1; }
	if (scale == 4) { sh = 2; }
	if (scale == 8) { sh = 3; }
	var rex i64 = 0x48;
	if (idx >= 8) { rex = rex | 2; }
	if (base >= 8) { rex = rex | 1; }
	b1(rex); b1(0x8d);
	modrm(0, RAX, 4);
	b1((sh << 6) | (((idx as i64) & 7) << 3) | ((base as i64) & 7));
	return true;
}

// mov reg, fs:[0] -- the thread's self-pointer, the base of its own TLS
// block. LEA cannot read a segment base, so a tvar's address always starts
// here before adding its offset within the block.
fn ld_fs_self(reg int) {
	b1(0x64);                              // fs segment override
	rex_w(reg, 0);
	b1(0x8b);
	b1(0x04 | (((reg as i64) & 7) << 3));  // ModRM: mod=00, rm=100 (SIB follows)
	b1(0x25);                              // SIB: no index, no base -> disp32 only
	b4(0);
}

fn gen_addr(n *Node) {
	var k int = n.kind;
	if (k == ND_VAR) {
		if (n.varp.has_reg) { error_at(n.pos, "internal: address of a promoted local"); }
		if (n.varp.is_tls) {
			ld_fs_self(RAX);
			add_rax_imm(n.varp.tls_off);
		}
		else if (n.varp.is_global) { ir_mov_acc_global(n.varp, n.pos); }
		else if (n.varp.arg_stack) {
			// A stack-passed parameter's offset is a positive rbp
			// displacement already, unlike every other local: rbp_mem is
			// called directly, bypassing lea_local/ld_local's negation.
			if (n.varp.by_ref) { rbp_mem(0x8b, RAX, n.varp.offset as i64); }
			else { rbp_mem(0x8d, RAX, n.varp.offset as i64); }
		}
		else if (n.varp.by_ref) { ld_local(RAX, n.varp.offset as i64); }
		else { lea_local(RAX, n.varp.offset as i64); }
		return;
	}
	if (k == ND_DEREF) { gen_expr(n.lhs); return; }
	if (k == ND_MEMBER) {
		if (n.lhs.ty.kind == TY_PTR) { gen_expr(n.lhs); } else { gen_addr(n.lhs); }
		add_rax_imm(n.member.offset as i64);
		return;
	}
	if (k == ND_INDEX) {
		var lt *Type = n.lhs.ty;
		if (lt.kind == TY_SLICE) {
			gen_addr(n.lhs);
			push_at_rax(0);
			push_at_rax(8);
			gen_expr(n.rhs);
			pop_reg(RDI);
			if (!opt_no_bounds) {
				rex_w(RDI, RAX);
				b1(0x39);
				modrm(3, RDI, RAX);
				jump_bounds(0x83);
			}
			pop_reg(RDI);
			ir_lea_acc(operand_op2(0), operand_acc(), lt.base.size, 0, n.pos);
			return;
		}

		if (lt.kind == TY_ARRAY) { gen_addr(n.lhs); } else { gen_expr(n.lhs); }
		// A constant index into an array is checked here, so no code is
		// emitted for it and the offset folds into the address.
		if (n.rhs.kind == ND_NUM &&
		    (lt.kind != TY_ARRAY || (n.rhs.val >= 0 && n.rhs.val < lt.len))) {
			ir_lea_acc(operand_acc(), operand_none(), 1,
			           n.rhs.val * (lt.base.size as i64), n.pos);
			return;
		}
		var idx int = RDI;
		if (direct_local(n.rhs)) {
			// A promoted index needs no copy: it can be the lea index directly.
			if (n.rhs.varp.has_reg && lea_scale_ok(lt.base.size)) {
				idx = n.rhs.varp.reg;
			} else {
				ld_rm(RDI, n.rhs);
			}
			if (lt.kind == TY_ARRAY && !opt_no_bounds && !n.nobounds) {
				rex_w(0, idx);
				b1(0x81);
				modrm(3, 7, idx);
				b4(lt.len);
				jump_bounds(0x83);
			}
		} else {
			push_reg(RAX);
			gen_expr(n.rhs);
			if (lt.kind == TY_ARRAY && !opt_no_bounds && !n.nobounds) {
				b1(0x48); b1(0x3d);
				b4(lt.len);
				jump_bounds(0x83);
			}
			mov_reg_reg(RDI, RAX);
			pop_reg(RAX);
		}
		ir_lea_acc(operand_acc(), operand_index(idx), lt.base.size, 0, n.pos);
		return;
	}
	if (k == ND_SLICE) {
		var lt *Type = n.lhs.ty;
		var off i64 = n.tmp.offset as i64;
		var elem int = lt.base.size;

		gen_addr(n.lhs);
		if (lt.kind == TY_SLICE) {
			ld_at_rax(RDI, 0);
			st_local(off, RDI);
			ld_at_rax(RDI, 8);
			st_local(off - 8, RDI);
		} else {
			st_local(off, RAX);
			mov_reg_imm(RDI, lt.len);
			st_local(off - 8, RDI);
		}

		if (n.rhs as i64 != 0) { gen_expr(n.rhs); } else { ir_mov_acc_imm(0, n.pos); }
		push_reg(RAX);

		if (n.then as i64 != 0) { gen_expr(n.then); } else { ld_local(RAX, off - 8); }
		pop_reg(RDI);

		if (!opt_no_bounds) {
			rbp_mem(0x3b, RAX, -(off - 8));
			jump_bounds(0x87);
			rex_w(RAX, RDI);
			b1(0x39);
			modrm(3, RAX, RDI);
			jump_bounds(0x87);
		}

		rex_w(RDI, RAX);
		b1(0x29);
		modrm(3, RDI, RAX);
		st_local(off - 8, RAX);

		mov_reg_reg(RAX, RDI);
		scale_by(elem);
		rbp_mem(0x03, RAX, -off);
		st_local(off, RAX);

		lea_local(RAX, off);
		return;
	}
	if (is_aggregate(n.ty)) { gen_expr(n); return; }
	error_at(n.pos, "not an addressable expression");
}

fn gen_lvalue(n *Node) {
	gen_addr(n);
	if (!is_aggregate(n.ty)) { ir_load_acc(n.ty, n.pos); }
}

// An argument with no side effects can be loaded straight into its register
// instead of going through the stack, but only if every argument after it is
// side-effect free too: moving it later would otherwise reorder the effects.
fn arg_leaf_ok(a *Node) bool {
	if (a.kind == ND_NUM) { return fits_imm32(a.val); }
	if (!direct_local(a)) { return false; }
	if (!a.varp.has_reg) { return true; }
	// The source must survive until the argument registers are filled, so it
	// cannot itself be one of them.
	return a.varp.reg == 3 || a.varp.reg >= 12;
}

fn arg_direct_ok(a *Node) bool {
	if (arg_leaf_ok(a)) { return true; }
	var k int = a.kind;
	if (k != ND_ADD && k != ND_SUB && k != ND_BITAND && k != ND_BITOR && k != ND_BITXOR) {
		return false;
	}
	if (a.ty.size != 8 || a.ty.kind == TY_PTR) { return false; }
	if (a.lhs.ty.kind == TY_PTR || a.rhs.ty.kind == TY_PTR) { return false; }
	return arg_leaf_ok(a.lhs) && arg_leaf_ok(a.rhs);
}

// marshall is set for a call to an extern-marked function (SysV on the
// other side): scalar float arguments land in xmm registers with their own
// counter, and the integer arguments are packed into the GPR registers by
// their own counter, exactly as SysV classifies them.
fn gen_args(n *Node, sys bool, first_in_rax bool, hidden i64, marshall bool) {
	var dest [14]int;
	var src [14]i64;
	var fmm [14]int;
	var fsz [14]int;
	var nd int = 0;
	var ri int = 0;
	var xi int = 0;
	{
		var fi int = 0;
		while (fi < 14) { fmm[fi] = -1; fsz[fi] = 0; fi = fi + 1; }
	}

	var av [14]i64;
	var an int = 0;
	var has_overflow bool = false;
	var scan *Node = n.args;
	while (scan as i64 != 0 && an < 14) {
		av[an] = scan as i64;
		if (scan.stack_tmp as i64 != 0) { has_overflow = true; }
		an = an + 1;
		scan = scan.next;
	}
	var direct_from int = an;
	// The direct-argument fast path assumes every argument lands in a
	// register; a call with stack-spilled arguments always takes the slow,
	// evaluate-then-place path instead. A marshalled float argument can never
	// take the fast path: its value has to move into an xmm register, and
	// gen_into does not know about those.
	while (!has_overflow && direct_from > 0 &&
	       !(marshall && is_float((av[direct_from - 1] as *Node).ty)) &&
	       arg_direct_ok(av[direct_from - 1] as *Node)) {
		direct_from = direct_from - 1;
	}
	var ai int = 0;

	if (hidden >= 0) {
		lea_local(RAX, hidden);
		push_reg(RAX);
		if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
		src[nd] = 0;
		nd = nd + 1;
		ri = ri + 1;
	}

	var a *Node = n.args;
	while (a as i64 != 0) {
		if (ai >= direct_from) {
			if (first_in_rax && nd == 0) {
				dest[nd] = RAX;
			} else {
				if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
				ri = ri + 1;
			}
			src[nd] = a as i64;
			nd = nd + 1;
			ai = ai + 1;
			a = a.next;
			continue;
		}
		ai = ai + 1;
		gen_expr(a);
		if (by_ref_ty(a.ty)) {
			mov_reg_reg(RSI, RAX);
			lea_local(RDI, a.tmp.offset as i64);
			copy_rsi_rdi(a.ty.size);
			lea_local(RAX, a.tmp.offset as i64);
			if (a.stack_tmp as i64 != 0) {
				st_local(a.stack_tmp.offset as i64, RAX);
				a = a.next;
				continue;
			}
			push_reg(RAX);
			if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
			src[nd] = 0;
			nd = nd + 1;
			ri = ri + 1;
		} else if (is_aggregate(a.ty)) {
			// v1 never spills a >8-byte, <=16-byte (2-word) aggregate --
			// parse.qela rejects that -- so a spilled aggregate here is
			// always a single word.
			if (a.stack_tmp as i64 != 0) {
				ld_at_rax(RCX, 0);
				st_local(a.stack_tmp.offset as i64, RCX);
				a = a.next;
				continue;
			}
			push_at_rax(0);
			if (first_in_rax && nd == 0) {
				dest[nd] = RAX;
			} else {
				if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
				ri = ri + 1;
			}
			src[nd] = 0;
			nd = nd + 1;
			if (a.ty.size > 8) {
				push_at_rax(8);
				if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
				src[nd] = 0;
				nd = nd + 1;
				ri = ri + 1;
			}
		} else {
			if (a.stack_tmp as i64 != 0) {
				st_local(a.stack_tmp.offset as i64, RAX);
				a = a.next;
				continue;
			}
			push_reg(RAX);
			if (marshall && is_float(a.ty)) {
				fmm[nd] = xi;
				fsz[nd] = a.ty.size;
				xi = xi + 1;
				dest[nd] = RAX;
			} else if (first_in_rax && nd == 0) {
				dest[nd] = RAX;
			} else {
				if (sys) { dest[nd] = sys_reg(ri); } else { dest[nd] = call_reg(ri); }
				ri = ri + 1;
			}
			src[nd] = 0;
			nd = nd + 1;
		}
		a = a.next;
	}
	while (nd > 0) {
		nd = nd - 1;
		if (fmm[nd] >= 0) {
			pop_reg(RAX);
			gpr_to_xmm(fmm[nd], RAX, fsz[nd]);
		} else if (src[nd] == 0) {
			pop_reg(dest[nd]);
		} else {
			var sn *Node = src[nd] as *Node;
			if (!gen_into(sn, dest[nd])) {
				gen_expr(sn);
				mov_reg_reg(dest[nd], RAX);
			}
		}
	}

	// Stack-spilled arguments go on last, in reverse source order, so the
	// first overflow argument ends up nearest rsp (rbp+16 in the callee)
	// once the call's return address lands on top of them.
	var m i64 = 0;
	var ci int = 0;
	while (ci < an) {
		if ((av[ci] as *Node).stack_tmp as i64 != 0) { m = m + 1; }
		ci = ci + 1;
	}
	// gen_call's own 16-byte alignment check runs after this, on whatever
	// depth is left -- if padding would be needed, it must go *below* the
	// spilled arguments (pushed first here), not between them and the
	// return address, or every rbp+16/+24/... offset in the callee shifts
	// by 8. Front-loading it here keeps depth even by the time gen_call
	// looks, so its own check stays a no-op for this call.
	var pad i64 = 0;
	if (m > 0) {
		if (((depth as i64 + m) & 1) != 0) {
			alu_rax_imm_reg(5, RSP, 8);
			depth = depth + 1;
			pad = 1;
		}
		var oi int = an;
		while (oi > 0) {
			oi = oi - 1;
			var oa *Node = av[oi] as *Node;
			if (oa.stack_tmp as i64 != 0) {
				ld_local(RAX, oa.stack_tmp.offset as i64);
				push_reg(RAX);
			}
		}
	}
	overflow_pushed = m + pad;
}

// ── floats ──
//
// A float never gets its own register class: it lives in a GPR/stack slot as
// a raw bit pattern everywhere except the instant an SSE instruction needs
// it, bounced through xmm0/xmm1 via movd/movq. This means the whole calling
// convention, spilling and regalloc machinery is unchanged -- only the ops
// that actually compute on a float know it is one.
let XMM0 = 0;
let XMM1 = 1;

fn xmm_from_gpr(xmm int, gpr int, sz int) {
	b1(0x66);
	if (sz == 8) { rex_w(gpr, xmm); }
	b1(0x0f); b1(0x6e);
	modrm(3, xmm, gpr);
}

fn gpr_from_xmm(gpr int, xmm int, sz int) {
	b1(0x66);
	if (sz == 8) { rex_w(xmm, gpr); }
	b1(0x0f); b1(0x7e);
	modrm(3, xmm, gpr);
}

// SysV marshalling at the extern boundary: floats cross in xmm registers
// while Qela's own convention keeps them in integer registers. Unlike the
// helpers above, the REX fields here are right for r8/r9 -- the originals
// never see a register >= 8, so they get away with swapping the two.

fn gpr_to_xmm(xmm int, gpr int, sz int) {
	b1(0x66);
	var rex i64 = 0;
	if (sz == 8) {
		rex = 0x48;
		if (xmm >= 8) { rex = rex | 4; }
		if (gpr >= 8) { rex = rex | 1; }
		b1(rex);
	}
	b1(0x0f); b1(0x6e);
	modrm(3, xmm, gpr);
}

fn xmm_to_gpr(gpr int, xmm int, sz int) {
	b1(0x66);
	var rex i64 = 0;
	if (sz == 8) {
		rex = 0x48;
		if (xmm >= 8) { rex = rex | 4; }
		if (gpr >= 8) { rex = rex | 1; }
		b1(rex);
	}
	b1(0x0f); b1(0x7e);
	modrm(3, xmm, gpr);
}

fn sse2(prefix i64, opcode i64, dst int, src int) {
	if (prefix != 0) { b1(prefix); }
	b1(0x0f); b1(opcode);
	modrm(3, dst, src);
}

// Unsigned-integer cc codes double as float cc codes: ucomisd sets CF/ZF/PF
// exactly like an unsigned integer compare (NaN aside, which this does not
// try to get right -- a hobby compiler, not a libc).
// The neutral form of a float comparison: what a branch or setcc should
// carry after ucomisd. The x86 lowering folds it back into the exact byte
// table above, so callers that branch on a float comparison stay byte-
// identical.
fn float_cc_neutral(n *Node) i64 {
	if (n.kind == ND_EQ) { return CC_EQ; }
	if (n.kind == ND_NE) { return CC_NE; }
	if (n.kind == ND_LT) { return CC_ULT; }
	return CC_ULE;
}

fn gen_binop_float(n *Node) {
	var sz int = n.lhs.ty.size;
	var dprefix i64 = 0xf2;
	if (sz == 4) { dprefix = 0xf3; }
	xmm_from_gpr(XMM0, RAX, sz);
	xmm_from_gpr(XMM1, RDI, sz);
	var k int = n.kind;
	if (k == ND_ADD) { sse2(dprefix, 0x58, XMM0, XMM1); gpr_from_xmm(RAX, XMM0, sz); return; }
	if (k == ND_SUB) { sse2(dprefix, 0x5c, XMM0, XMM1); gpr_from_xmm(RAX, XMM0, sz); return; }
	if (k == ND_MUL) { sse2(dprefix, 0x59, XMM0, XMM1); gpr_from_xmm(RAX, XMM0, sz); return; }
	if (k == ND_DIV) { sse2(dprefix, 0x5e, XMM0, XMM1); gpr_from_xmm(RAX, XMM0, sz); return; }
	if (k == ND_EQ || k == ND_NE || k == ND_LT || k == ND_LE) {
		var cprefix i64 = 0x66;
		if (sz == 4) { cprefix = 0; }
		sse2(cprefix, 0x2e, XMM0, XMM1);
		ir_setcc_acc(float_cc_neutral(n), n.pos);
		return;
	}
	error_at(n.pos, "operator not defined for floats");
}

fn gen_neg_float(sz int) {
	var mask i64 = 0x8000000000000000;
	if (sz == 4) { mask = 0x80000000; }
	mov_reg_imm(RDI, mask);
	rex_w(RDI, RAX); b1(0x31); modrm(3, RDI, RAX);
}

fn cvt2(prefix i64, opcode i64, dst int, src int, w bool) {
	b1(prefix);
	if (w) { rex_w(dst, src); }
	b1(0x0f); b1(opcode);
	modrm(3, dst, src);
}

// RAX holds n.lhs's bits on entry (n.lhs already generated); leaves the
// converted bits in RAX.
fn gen_cast_float(n *Node) {
	var st *Type = n.lhs.ty;
	var dt *Type = n.ty;
	if (is_float(st) && is_float(dt)) {
		if (st.size == dt.size) { return; }
		xmm_from_gpr(XMM0, RAX, st.size);
		if (st.size == 4) { cvt2(0xf3, 0x5a, XMM0, XMM0, false); }
		else { cvt2(0xf2, 0x5a, XMM0, XMM0, false); }
		gpr_from_xmm(RAX, XMM0, dt.size);
		return;
	}
	if (is_float(dt)) {
		var prefix i64 = 0xf2;
		if (dt.size == 4) { prefix = 0xf3; }
		cvt2(prefix, 0x2a, XMM0, RAX, true);
		gpr_from_xmm(RAX, XMM0, dt.size);
		return;
	}
	var prefix2 i64 = 0xf2;
	if (st.size == 4) { prefix2 = 0xf3; }
	xmm_from_gpr(XMM0, RAX, st.size);
	cvt2(prefix2, 0x2c, RAX, XMM0, true);
	if (dt.size < 8) { truncate_to(dt); }
}

fn cc_for_compare(n *Node) i64 {
	var uns bool = n.lhs.ty.is_unsigned || n.lhs.ty.kind == TY_PTR;
	if (n.kind == ND_EQ) { return CC_EQ; }
	if (n.kind == ND_NE) { return CC_NE; }
	if (n.kind == ND_LT) { if (uns) { return CC_ULT; } return CC_LT; }
	if (uns) { return CC_ULE; }
	return CC_LE;
}

fn gen_binop(n *Node) {
	var t *Type = n.ty;
	var k int = n.kind;

	if (is_float(n.lhs.ty)) { gen_binop_float(n); return; }
	if (k == ND_ADD) { ir_alu_acc(ALU_ADD, t, n.pos); return; }
	if (k == ND_SUB) { ir_alu_acc(ALU_SUB, t, n.pos); return; }
	if (k == ND_MUL) { ir_alu_acc(ALU_MUL, t, n.pos); return; }
	if (k == ND_DIV) { ir_alu_acc(ALU_DIV, t, n.pos); return; }
	if (k == ND_MOD) { ir_alu_acc(ALU_MOD, t, n.pos); return; }
	if (k == ND_BITAND) { ir_alu_acc(ALU_AND, t, n.pos); return; }
	if (k == ND_BITOR)  { ir_alu_acc(ALU_OR, t, n.pos); return; }
	if (k == ND_BITXOR) { ir_alu_acc(ALU_XOR, t, n.pos); return; }
	if (k == ND_SHL) { ir_alu_acc(ALU_SHL, t, n.pos); return; }
	if (k == ND_SHR) { ir_alu_acc(ALU_SHR, t, n.pos); return; }
	if (k == ND_EQ || k == ND_NE || k == ND_LT || k == ND_LE) {
		ir_compare_acc(cc_for_compare(n), n.pos);
		return;
	}
	error_at(n.pos, "invalid expression");
}

fn gen_enumlit(n *Node) {
	var off i64 = n.tmp.offset as i64;
	ir_mov_acc_imm(n.variant.tag as i64, n.pos);
	ir_store_stackslot_acc(off, ty_i64, n.pos);

	var f *Member = n.variant.fields;
	var a *Node = n.args;
	while (a as i64 != 0) {
		ir_lea_op2_slot(off - (f.offset as i64), n.pos);
		ir_push_op2(n.pos);
		gen_expr(a);
		if (is_aggregate(f.ty)) { ir_memcpy_stage(f.ty.size as i64, n.pos); }
		else { ir_pop_op2(n.pos); ir_store_op2_acc(f.ty, n.pos); }
		f = f.next;
		a = a.next;
	}
	ir_lea_slot_acc(off, n.pos);
}

fn gen_structlit(n *Node) {
	var off i64 = n.tmp.offset as i64;
	var nmembers int = 0;
	var m *Member = n.ty.members;
	while (m as i64 != 0) { nmembers = nmembers + 1; m = m.next; }

	if (n.nargs < nmembers) {
		ir_memset_stackslot(off, n.ty.size as i64, n.pos);
	}
	var a *Node = n.args;
	while (a as i64 != 0) {
		ir_lea_op2_slot(off - (a.member.offset as i64), n.pos);
		ir_push_op2(n.pos);
		gen_expr(a.lhs);
		if (is_aggregate(a.member.ty)) {
			ir_memcpy_stage(a.member.ty.size as i64, n.pos);
		} else {
			ir_pop_op2(n.pos);
			ir_store_op2_acc(a.member.ty, n.pos);
		}
		a = a.next;
	}
	ir_lea_slot_acc(off, n.pos);
}

fn gen_call(n *Node) {
	if (n.varp as i64 != 0) { gen_indirect_call(n); return; }
	var cf *Func = find_func(n.name);
	var marshall bool = false;
	if (cf as i64 != 0) { marshall = cf.extern; }
	var ret_mem bool = is_aggregate(n.ty) && abi_sret(n.ty.size);
	var hidden i64 = -1;
	if (ret_mem) { hidden = n.tmp.offset as i64; }
	gen_args(n, false, false, hidden, marshall);

	var odd bool = (depth & 1) != 0;
	if (odd) {
		b1(0x48); b1(0x83); modrm(3, 5, RSP); b1(8);
	}
	ir_call(cf, n.pos);
	if (odd) {
		b1(0x48); b1(0x83); modrm(3, 0, RSP); b1(8);
	}
	if (overflow_pushed > 0) {
		alu_rax_imm_reg(0, RSP, 8 * overflow_pushed);
		depth = depth - (overflow_pushed as int);
	}
	// A marshalled call's float result comes back in xmm0 (SysV), but Qela
	// reads its own results from rax.
	if (marshall && is_float(n.ty)) {
		xmm_to_gpr(RAX, 0, n.ty.size);
	}
	if (is_aggregate(n.ty) && !ret_mem) {
		var off i64 = n.tmp.offset as i64;
		st_local(off, RAX);
		if (n.ty.size > 8) { st_local(off - 8, RDX); }
		lea_local(RAX, off);
	}
}

// A call through a function-typed variable. The signature check already ran
// in type_indirect_call, so here it is only the mechanics. The address goes
// in R10 (never an argument register) and is loaded after the arguments are
// set up: a call inside the argument list would clobber R10, and a promoted
// target can only live in a callee-saved register (an indirect call makes
// the function non-leaf, so the free caller-saved pool is out).
fn gen_indirect_call(n *Node) {
	var ret_mem bool = is_aggregate(n.ty) && abi_sret(n.ty.size);
	var hidden i64 = -1;
	if (ret_mem) { hidden = n.tmp.offset as i64; }
	gen_args(n, false, false, hidden, false);

	var odd bool = (depth & 1) != 0;
	if (odd) {
		b1(0x48); b1(0x83); modrm(3, 5, RSP); b1(8);
	}
	var target IrOperand;
	if (n.varp.has_reg) {
		target = operand_vreg(n.varp.reg, n.varp.ty);
	} else if (n.varp.is_global) {
		target = operand_global(n.varp);
	} else {
		target = operand_stackslot(n.varp.offset as i64, n.varp.ty);
	}
	ir_call_ind(target, n.pos);
	if (odd) {
		b1(0x48); b1(0x83); modrm(3, 0, RSP); b1(8);
	}
	if (overflow_pushed > 0) {
		alu_rax_imm_reg(0, RSP, 8 * overflow_pushed);
		depth = depth - (overflow_pushed as int);
	}
	if (is_aggregate(n.ty) && !ret_mem) {
		var off i64 = n.tmp.offset as i64;
		st_local(off, RAX);
		if (n.ty.size > 8) { st_local(off - 8, RDX); }
		lea_local(RAX, off);
	}
}

fn gen_logical(n *Node) {
	gen_expr(n.lhs);
	test_rax();
	// Skip the whole materialised value when one side decides the result:
	// an OR is 1 as soon as either side is true, an AND is 0 as soon as
	// either side is false.
	var skip_cc i64 = CC_NE;
	if (n.kind == ND_AND) { skip_cc = CC_EQ; }
	var mid i64 = ir_new_label();
	ir_branch(skip_cc, mid, n.pos);
	gen_expr(n.rhs);
	test_rax();
	ir_branch(skip_cc, mid, n.pos);
	if (n.kind == ND_AND) { ir_mov_acc_imm(1, n.pos); } else { ir_mov_acc_imm(0, n.pos); }
	var end i64 = ir_new_label();
	ir_branch(CC_ALWAYS, end, n.pos);
	ir_label(mid, n.pos);
	if (n.kind == ND_AND) { ir_mov_acc_imm(0, n.pos); } else { ir_mov_acc_imm(1, n.pos); }
	ir_label(end, n.pos);
}

fn gen_opassign(n *Node) {
	if (n.lhs.kind == ND_VAR && n.lhs.varp.has_reg) {
		ir_load_var(n.lhs.varp, n.lhs.ty, n.pos);
		ir_push_acc(n.pos);
		gen_expr(n.rhs);
		if (n.lhs.ty.kind == TY_PTR) {
			if (n.lhs.ty.base.size != 1) { ir_alu_acc_imm(ALU_SCALE, n.lhs.ty, n.lhs.ty.base.size as i64, n.pos); }
		}
		ir_mov_acc_op2(n.pos);
		ir_pop_acc(n.pos);

		var rop Node;
		rop.kind = n.val as int;
		rop.ty = n.lhs.ty;
		rop.lhs = n.lhs;
		rop.pos = n.pos;
		gen_binop(&rop);

		ir_cast_acc(CAST_TRUNC, n.lhs.ty, n.pos);
		ir_store_vreg_acc(n.lhs.varp.reg, n.lhs.ty, n.pos);
		return;
	}
	gen_addr(n.lhs);
	ir_push_acc(n.pos);
	ir_load_acc(n.lhs.ty, n.pos);
	ir_push_acc(n.pos);
	gen_expr(n.rhs);
	if (n.lhs.ty.kind == TY_PTR) {
		if (n.lhs.ty.base.size != 1) { ir_alu_acc_imm(ALU_SCALE, n.lhs.ty, n.lhs.ty.base.size as i64, n.pos); }
	}
	ir_mov_acc_op2(n.pos);
	ir_pop_acc(n.pos);

	var op Node;
	op.kind = n.val as int;
	op.ty = n.lhs.ty;
	op.lhs = n.lhs;
	op.pos = n.pos;
	gen_binop(&op);

	ir_cast_acc(CAST_TRUNC, n.lhs.ty, n.pos);
	ir_pop_op2(n.pos);
	ir_store_op2_acc(n.lhs.ty, n.pos);
}

// An assignment written as a statement discards its result, so it can write
// straight to the slot without routing the value through rax.
// mov [rax], imm: a constant store needs no round trip through rax and no
// temporary for the address.
fn store_imm(ty *Type, v i64) {
	if (ty.size == 1) { b1(0xc6); modrm(0, 0, RAX); b1(v); return; }
	if (ty.size == 2) { b1(0x66); b1(0xc7); modrm(0, 0, RAX); b1(v); b1(v >> 8); return; }
	if (ty.size == 4) { b1(0xc7); modrm(0, 0, RAX); b4(v); return; }
	b1(0x48); b1(0xc7); modrm(0, 0, RAX); b4(v);
}

fn stmt_assign(n *Node) bool {
	if (!direct_local(n.lhs)) { return stmt_store_imm(n); }
	if (n.lhs.varp.has_reg && !in_reg(n.rhs, n.lhs.varp.reg) &&
	    gen_into(n.rhs, n.lhs.varp.reg)) {
		return true;
	}
	if (n.lhs.varp.has_reg && spine_ok(n.rhs, n.lhs.varp)) {
		emit_spine(n.rhs, n.lhs);
		return true;
	}
	var r *Node = n.rhs;
	if (r.lhs as i64 != 0 && r.lhs.kind == ND_VAR &&
	    r.lhs.varp as i64 == n.lhs.varp as i64 && r.rhs as i64 != 0) {
		if (stmt_update(n.lhs, r.kind, r.rhs)) { return true; }
	}
	if (n.rhs.kind != ND_NUM || !fits_imm32(n.rhs.val)) { return false; }
	if (n.rhs.val == 0 && !n.lhs.varp.has_reg) { return false; }
	if (n.lhs.varp.has_reg) {
		mov_reg_imm(n.lhs.varp.reg, n.rhs.val);
		return true;
	}
	rbp_mem(0xc7, 0, -(n.lhs.varp.offset as i64));
	b4(n.rhs.val);
	return true;
}

fn stmt_store_imm(n *Node) bool {
	if (n.rhs.kind != ND_NUM) { return false; }
	var ty *Type = n.lhs.ty;
	if (is_aggregate(ty)) { return false; }
	if (ty.size == 8 && !fits_imm32(n.rhs.val)) { return false; }
	if (n.lhs.kind == ND_VAR && n.lhs.varp.has_reg) { return false; }
	gen_addr(n.lhs);
	ir_store_acc_imm(ty, n.rhs.val, n.pos);
	return true;
}

fn alu_op_for(kind int) i64 {
	if (kind == ND_ADD)    { return 0x01; }
	if (kind == ND_SUB)    { return 0x29; }
	if (kind == ND_BITAND) { return 0x21; }
	if (kind == ND_BITOR)  { return 0x09; }
	return 0x31;
}

fn alu_rm_reg(op i64, n *Node, reg int) {
	rm_rex(reg, n);
	b1(op);
	rm_modrm(reg, n);
}

// v op= e as a statement: fold the update into one instruction against the
// slot or register holding v, instead of loading it and storing it back.
// Only promoted locals take a computed operand: a local still in the frame may
// be aliased, and the slow path reads it before evaluating the right side.
fn stmt_update(v *Node, k int, e *Node) bool {
	if (!direct_local(v)) { return false; }
	if (v.ty.kind == TY_PTR) { return false; }
	if (is_float(v.ty)) { return false; }
	if (k != ND_ADD && k != ND_SUB && k != ND_BITAND && k != ND_BITOR && k != ND_BITXOR) {
		return false;
	}
	if (e.kind == ND_NUM && fits_imm32(e.val)) {
		alu_rm_imm(alu_ext_for(k), v, e.val);
		return true;
	}
	if (direct_local(e) && e.varp.has_reg) {
		alu_rm_reg(alu_op_for(k), v, e.varp.reg);
		return true;
	}
	if (!v.varp.has_reg) { return false; }
	gen_expr(e);
	alu_rm_reg(alu_op_for(k), v, RAX);
	return true;
}

fn stmt_opassign(n *Node) bool {
	return stmt_update(n.lhs, n.val as int, n.rhs);
}

fn refs_var(e *Node, v *Var) bool {
	if (e as i64 == 0) { return false; }
	if (e.kind == ND_VAR && e.varp as i64 == v as i64) { return true; }
	if (refs_var(e.lhs, v) || refs_var(e.rhs, v)) { return true; }
	if (refs_var(e.cond, v) || refs_var(e.then, v) || refs_var(e.els, v)) { return true; }
	var a *Node = e.args;
	while (a as i64 != 0) {
		if (refs_var(a, v)) { return true; }
		a = a.next;
	}
	return false;
}

// v = ((v op a) op b) is v op= a; v op= b. Each step updates the register in
// place, so nothing is copied back at the end. Only promoted locals qualify:
// they cannot be aliased, and no operand may read v, or the rewrite would see
// a value the original expression had not produced yet.
fn spine_ok(e *Node, v *Var) bool {
	if (e.kind == ND_VAR) { return e.varp as i64 == v as i64; }
	var k int = e.kind;
	if (k != ND_ADD && k != ND_SUB && k != ND_BITAND && k != ND_BITOR && k != ND_BITXOR) {
		return false;
	}
	if (e.ty.size != 8 || e.ty.kind == TY_PTR) { return false; }
	if (is_float(e.ty)) { return false; }
	if (e.lhs.ty.kind == TY_PTR || e.rhs.ty.kind == TY_PTR) { return false; }
	if (refs_var(e.rhs, v)) { return false; }
	return spine_ok(e.lhs, v);
}

fn emit_spine(e *Node, dst *Node) {
	if (e.kind == ND_VAR) { return; }
	emit_spine(e.lhs, dst);
	gen_expr(e.rhs);
	alu_rm_reg(alu_op_for(e.kind), dst, RAX);
}

fn gen_exprstmt(n *Node) {
	if (n.kind == ND_ASSIGN && stmt_assign(n)) { return; }
	if (n.kind == ND_OPASSIGN && stmt_opassign(n)) { return; }
	gen_expr(n);
}

fn fits_imm32(v i64) bool {
	return v >= -2147483648 && v <= 2147483647;
}

// group-1 ALU op on rax with an immediate: 48 83 /ext ib or 48 81 /ext id
fn alu_rax_imm(ext int, v i64) {
	b1(0x48);
	if (v >= -128 && v <= 127) {
		b1(0x83);
		modrm(3, ext, RAX);
		b1(v);
		return;
	}
	// The accumulator has a one-byte-shorter form with a full immediate.
	b1(0x05 | ((ext as i64) << 3));
	b4(v);
}

fn alu_rax_imm_reg(ext int, reg int, v i64) {
	rex_w(0, reg);
	if (v >= -128 && v <= 127) {
		b1(0x83);
		modrm(3, ext, reg);
		b1(v);
	} else {
		b1(0x81);
		modrm(3, ext, reg);
		b4(v);
	}
}

fn alu_ext_for(kind int) int {
	if (kind == ND_ADD) { return 0; }
	if (kind == ND_BITOR) { return 1; }
	if (kind == ND_BITAND) { return 4; }
	if (kind == ND_SUB) { return 5; }
	if (kind == ND_BITXOR) { return 6; }
	return 7;
}

fn alu_ir_for(kind int) int {
	if (kind == ND_ADD) { return ALU_ADD; }
	if (kind == ND_SUB) { return ALU_SUB; }
	if (kind == ND_BITAND) { return ALU_AND; }
	if (kind == ND_BITOR) { return ALU_OR; }
	return ALU_XOR;
}

// Folds a constant right operand into the instruction, which removes the
// materialise/push/pop sequence the stack machine would otherwise emit.
fn gen_binop_imm(n *Node, v i64) bool {
	var k int = n.kind;
	if (k == ND_ADD || k == ND_SUB || k == ND_BITAND || k == ND_BITOR ||
	    k == ND_BITXOR) {
		gen_expr(n.lhs);
		// Masking to a byte or a halfword is a zero-extending move; the
		// lowering picks it for a 255/65535 AND (see IR_ALU, src1 OP_IMM).
		ir_alu_acc_imm(alu_ir_for(k), n.ty, v, n.pos);
		return true;
	}
	if (k == ND_EQ || k == ND_NE || k == ND_LT || k == ND_LE) {
		gen_expr(n.lhs);
		ir_cmp_acc_imm(v, n.pos);
		ir_setcc_acc(cc_for_compare(n), n.pos);
		return true;
	}
	if (k == ND_SHL || k == ND_SHR) {
		if (v < 0 || v > 63) { return false; }
		gen_expr(n.lhs);
		var aop int = ALU_SHL;
		if (k == ND_SHR) { aop = ALU_SHR; }
		ir_alu_acc_imm(aop, n.ty, v, n.pos);
		return true;
	}
	if (k == ND_MUL) {
		gen_expr(n.lhs);
		ir_alu_acc_imm(ALU_MUL, n.ty, v, n.pos);
		return true;
	}
	return false;
}

// A direct local is one r/m operand: either the register it was promoted to or
// its frame slot. Both encode the same instruction forms, so every fast path
// below works unchanged whichever one it is.
fn rm_rex(reg int, n *Node) {
	if (n.varp.has_reg) { rex_w(reg, n.varp.reg); } else { rex_w(reg, RBP); }
}

fn rm_modrm(reg int, n *Node) {
	if (n.varp.has_reg) {
		modrm(3, reg, n.varp.reg);
		return;
	}
	var disp i64 = -(n.varp.offset as i64);
	if (disp >= -128 && disp <= 127) {
		modrm(1, reg, RBP);
		b1(disp);
	} else {
		modrm(2, reg, RBP);
		b4(disp);
	}
}

fn ld_rm(reg int, n *Node) { rm_rex(reg, n); b1(0x8b); rm_modrm(reg, n); }
fn st_rm(n *Node, reg int) { rm_rex(reg, n); b1(0x89); rm_modrm(reg, n); }

fn alu_rax_rm(op0 i64, op1 i64, n *Node) {
	alu_reg_rm(op0, op1, RAX, n);
}

// The IR_ALU/IR_CMP r/m forms: rax op= a direct local, replaying
// alu_reg_rm(.., RAX, ..) with the same rex/reg-rm roles so the REX.B/REX.R
// bits come out as the node-driven path would have written them.
fn x86_alu_acc_rm(op0 i64, op1 i64, src IrOperand) {
	if (src.kind == OP_VREG) {
		rex_w(RAX, src.reg);
		if (op0 != 0) { b1(op0); }
		b1(op1);
		modrm(3, RAX, src.reg);
		return;
	}
	if (src.kind == OP_STACKSLOT) {
		rex_w(RAX, RBP);
		if (op0 != 0) { b1(op0); }
		b1(op1);
		var disp i64 = -(src.off);
		if (disp >= -128 && disp <= 127) {
			modrm(1, RAX, RBP);
			b1(disp);
		} else {
			modrm(2, RAX, RBP);
			b4(disp);
		}
		return;
	}
	die("internal: x86_alu_acc_rm: unhandled operand");
}

fn alu_reg_rm(op0 i64, op1 i64, reg int, n *Node) {
	rm_rex(reg, n);
	if (op0 != 0) { b1(op0); }
	b1(op1);
	rm_modrm(reg, n);
}

fn alu_reg_imm(ext int, reg int, v i64) {
	rex_w(0, reg);
	if (v >= -128 && v <= 127) {
		b1(0x83);
		modrm(3, ext, reg);
		b1(v);
	} else {
		b1(0x81);
		modrm(3, ext, reg);
		b4(v);
	}
}

fn rm_op_for(kind int) i64 {
	if (kind == ND_ADD)    { return 0x03; }
	if (kind == ND_SUB)    { return 0x2b; }
	if (kind == ND_BITAND) { return 0x23; }
	if (kind == ND_BITOR)  { return 0x0b; }
	return 0x33;
}

fn simple_operand(n *Node) bool {
	if (n.kind == ND_NUM) { return fits_imm32(n.val); }
	return direct_local(n);
}

fn in_reg(n *Node, reg int) bool {
	return n.kind == ND_VAR && n.varp.has_reg && n.varp.reg == reg;
}

// Evaluate n straight into dst instead of through rax. Only side-effect-free
// operands qualify, and the right side must not live in dst, since the left
// side lands there first.
fn gen_into(n *Node, dst int) bool {
	if (n.kind == ND_NUM && fits_imm32(n.val)) { mov_reg_imm(dst, n.val); return true; }
	if (direct_local(n)) {
		if (!in_reg(n, dst)) { ld_rm(dst, n); }
		return true;
	}
	var k int = n.kind;
	if (k != ND_ADD && k != ND_SUB && k != ND_BITAND && k != ND_BITOR && k != ND_BITXOR) {
		return false;
	}
	if (n.ty.kind == TY_PTR || n.lhs.ty.kind == TY_PTR || n.rhs.ty.kind == TY_PTR) {
		return false;
	}
	if (is_float(n.ty)) { return false; }
	if (!simple_operand(n.lhs) || !simple_operand(n.rhs)) { return false; }
	if (in_reg(n.rhs, dst)) { return false; }
	if (!gen_into(n.lhs, dst)) { return false; }
	if (n.rhs.kind == ND_NUM) {
		alu_reg_imm(alu_ext_for(k), dst, n.rhs.val);
		return true;
	}
	alu_reg_rm(0, rm_op_for(k), dst, n.rhs);
	return true;
}

fn alu_rm_imm(ext int, n *Node, v i64) {
	rm_rex(0, n);
	if (v >= -128 && v <= 127) {
		b1(0x83);
		rm_modrm(ext, n);
		b1(v);
	} else {
		b1(0x81);
		rm_modrm(ext, n);
		b4(v);
	}
}

fn gen_binop_mem(n *Node, val *Node, rm *Node) bool {
	var k int = n.kind;
	var rop IrOperand;
	if (rm.varp.has_reg) { rop = operand_vreg(rm.varp.reg, rm.ty); }
	else { rop = operand_stackslot(rm.varp.offset as i64, rm.ty); }
	gen_expr(val);
	if (k == ND_ADD)    { ir_alu_acc_rm(ALU_ADD, n.ty, rop, n.pos); return true; }
	if (k == ND_SUB)    { ir_alu_acc_rm(ALU_SUB, n.ty, rop, n.pos); return true; }
	if (k == ND_BITAND) { ir_alu_acc_rm(ALU_AND, n.ty, rop, n.pos); return true; }
	if (k == ND_BITOR)  { ir_alu_acc_rm(ALU_OR, n.ty, rop, n.pos); return true; }
	if (k == ND_BITXOR) { ir_alu_acc_rm(ALU_XOR, n.ty, rop, n.pos); return true; }
	if (k == ND_MUL)    { ir_alu_acc_rm(ALU_MUL, n.ty, rop, n.pos); return true; }
	ir_cmp_acc_rm(rop, n.pos);
	ir_setcc_acc(cc_for_compare(n), n.pos);
	return true;
}

fn mem_binop_ok(n *Node) bool {
	var k int = n.kind;
	if (k != ND_ADD && k != ND_SUB && k != ND_BITAND && k != ND_BITOR &&
	    k != ND_BITXOR && k != ND_MUL && k != ND_EQ && k != ND_NE &&
	    k != ND_LT && k != ND_LE) {
		return false;
	}
	return direct_local(n.rhs);
}

// For a commutative operator a direct local on the left folds in just as well,
// once the sides are evaluated the other way round.
fn swap_binop_ok(n *Node) bool {
	var k int = n.kind;
	if (k != ND_ADD && k != ND_BITAND && k != ND_BITOR && k != ND_BITXOR &&
	    k != ND_MUL && k != ND_EQ && k != ND_NE) {
		return false;
	}
	return direct_local(n.lhs) && !direct_local(n.rhs);
}

// An lvalue reached through a pointer is loaded only to be compared, so the
// comparison can read memory itself.
fn addressable_load(n *Node) bool {
	var k int = n.kind;
	if (k != ND_INDEX && k != ND_MEMBER && k != ND_DEREF) { return false; }
	return !is_aggregate(n.ty) && n.ty.kind != TY_SLICE;
}

fn fits_width(v i64, ty *Type) bool {
	if (!fits_imm32(v)) { return false; }
	if (ty.size >= 4) { return true; }
	if (ty.size == 2) { return v >= -32768 && v <= 32767; }
	return v >= -128 && v <= 255;
}

fn cmp_at_rax_imm(ty *Type, v i64) {
	if (ty.size == 1) { b1(0x80); modrm(0, 7, RAX); b1(v); return; }
	if (ty.size == 2) { b1(0x66); b1(0x81); modrm(0, 7, RAX); b1(v); b1(v >> 8); return; }
	if (ty.size == 4) { b1(0x81); modrm(0, 7, RAX); b4(v); return; }
	b1(0x48); b1(0x81); modrm(0, 7, RAX); b4(v);
}

fn is_compare(n *Node) bool {
	var k int = n.kind;
	return k == ND_EQ || k == ND_NE || k == ND_LT || k == ND_LE;
}

// Emits the comparison and returns its setcc opcode, without materialising
// a boolean. Callers that only branch on the result skip setcc entirely.
fn gen_compare(n *Node) i64 {
	var lt *Type = n.lhs.ty;
	if (is_float(lt)) {
		gen_expr(n.rhs);
		push_reg(RAX);
		gen_expr(n.lhs);
		pop_reg(RDI);
		var sz int = lt.size;
		xmm_from_gpr(XMM0, RAX, sz);
		xmm_from_gpr(XMM1, RDI, sz);
		var cprefix i64 = 0x66;
		if (sz == 4) { cprefix = 0; }
		sse2(cprefix, 0x2e, XMM0, XMM1);
		return float_cc_neutral(n);
	}
	// Equality survives a widening cast, so the load under it can be compared
	// at its own width. Ordering cannot: the widened type decides the
	// signedness of the condition code.
	var mem *Node = n.lhs;
	if ((n.kind == ND_EQ || n.kind == ND_NE) && mem.kind == ND_CAST &&
	    is_integer(mem.ty) && is_integer(mem.lhs.ty) && mem.lhs.ty.size <= mem.ty.size) {
		mem = mem.lhs;
	}
	if (n.rhs.kind == ND_NUM && (mem.ty.kind != TY_PTR || n.rhs.val == 0) &&
	    fits_width(n.rhs.val, mem.ty) && addressable_load(mem)) {
		gen_addr(mem);
		cmp_at_rax_imm(mem.ty, n.rhs.val);
		return cc_for_compare(n);
	}
	if (n.rhs.kind == ND_NUM && fits_imm32(n.rhs.val) &&
	    (lt.kind != TY_PTR || n.rhs.val == 0)) {
		if (direct_local(n.lhs)) {
			alu_rm_imm(7, n.lhs, n.rhs.val);
			return cc_for_compare(n);
		}
		gen_expr(n.lhs);
		alu_rax_imm(7, n.rhs.val);
		return cc_for_compare(n);
	}
	if (lt.kind != TY_PTR && direct_local(n.rhs)) {
		gen_expr(n.lhs);
		alu_rax_rm(0, 0x3b, n.rhs);
		return cc_for_compare(n);
	}
	gen_expr(n.rhs);
	push_reg(RAX);
	gen_expr(n.lhs);
	pop_reg(RDI);
	rex_w(RDI, RAX);
	b1(0x39);
	modrm(3, RDI, RAX);
	return cc_for_compare(n);
}

fn patch_all(l *I64List) {
	var i i64 = 0;
	while (i < l.n) { patch_here(l.p[i]); i = i + 1; }
}

// Short-circuit conditions become branches instead of a materialised 0/1.
// The label is the code point that is jumped to when the condition is false;
// the frontend emits its IR_LABEL (ir_label) where that point actually is.
fn branch_false(n *Node, label i64) {
	var k int = n.kind;
	if (k == ND_AND) {
		branch_false(n.lhs, label);
		branch_false(n.rhs, label);
		return;
	}
	if (k == ND_OR) {
		var taken i64 = ir_new_label();
		branch_true(n.lhs, taken);
		branch_false(n.rhs, label);
		ir_label(taken, n.pos);
		return;
	}
	if (k == ND_NOT) { branch_true(n.lhs, label); return; }
	if (is_compare(n)) {
		var cc i64 = gen_compare(n);
		ir_branch(cc_invert(cc), label, n.pos);
		return;
	}
	gen_expr(n);
	test_rax();
	ir_branch(CC_EQ, label, n.pos);
}

fn branch_true(n *Node, label i64) {
	var k int = n.kind;
	if (k == ND_OR) {
		branch_true(n.lhs, label);
		branch_true(n.rhs, label);
		return;
	}
	if (k == ND_AND) {
		var missed i64 = ir_new_label();
		branch_false(n.lhs, missed);
		branch_true(n.rhs, label);
		ir_label(missed, n.pos);
		return;
	}
	if (k == ND_NOT) { branch_false(n.lhs, label); return; }
	if (is_compare(n)) {
		var cc i64 = gen_compare(n);
		ir_branch(cc, label, n.pos);
		return;
	}
	gen_expr(n);
	test_rax();
	ir_branch(CC_NE, label, n.pos);
}

var coro_switch_at i64 = -1;
var coro_switch_refs I64List;

// The switch has to be a real function: its trailing ret consumes the
// return address that the call pushed onto whichever stack is current,
// which is exactly how control lands back where a coroutine left off.
fn gen_coro_switch(n *Node) {
	gen_args(n, false, false, -1, false);
	b1(0xe8);
	ilist_push(&coro_switch_refs, code.n);
	b4(0);
}

fn gen_coro_switch_stub() {
	coro_switch_at = code.n;
	b1(0x53);                            // push rbx
	b1(0x55);                            // push rbp
	b1(0x41); b1(0x54);                  // push r12
	b1(0x41); b1(0x55);                  // push r13
	b1(0x41); b1(0x56);                  // push r14
	b1(0x41); b1(0x57);                  // push r15
	b1(0x48); b1(0x89); b1(0x27);        // mov [rdi], rsp
	b1(0x48); b1(0x8b); b1(0x26);        // mov rsp, [rsi]
	b1(0x41); b1(0x5f);                  // pop r15
	b1(0x41); b1(0x5e);                  // pop r14
	b1(0x41); b1(0x5d);                  // pop r13
	b1(0x41); b1(0x5c);                  // pop r12
	b1(0x5d);                            // pop rbp
	b1(0x5b);                            // pop rbx
	b1(0xc3);                            // ret
}

// Emitted once. A new coroutine's stack holds its arguments above the
// return address, so the trampoline pops them into place and calls through.
fn patch_abs(sites *I64List, value i64) {
	var i i64 = 0;
	while (i < sites.n) {
		var k i64 = 0;
		while (k < 8) {
			code.p[sites.p[i] + k] = ((value >> (k * 8)) & 255) as u8;
			k = k + 1;
		}
		i = i + 1;
	}
}

fn gen_coro_stub() {
	coro_stub_at = code.n;
	b1(0x5f);                            // pop rdi
	b1(0x5e);                            // pop rsi
	b1(0x5a);                            // pop rdx
	b1(0x59);                            // pop rcx
	b1(0x41); b1(0x58);                  // pop r8
	b1(0x58);                            // pop rax  (target)
	b1(0xff); b1(0xd0);                  // call rax
	add_call("coro_finish", 0);
	b1(0x0f); b1(0x0b);                  // ud2: coro_finish never returns
}

// clone()'s child resumes at the very next instruction after the syscall,
// on a brand-new stack that holds none of the caller's frames -- an
// ordinary compiled function epilogue's `ret` would pop garbage off it. So
// this never lets compiled code run on that path: fn/arg are carried across
// the syscall in r12/r13 (syscall only clobbers rcx/r11), and the child
// branch calls fn directly and exits without ever executing a `ret`.
//
// r12/r13 are callee-saved: the register allocator may be keeping a
// caller's local live in either across this call, so their old values are
// saved on the parent's own stack and restored before falling through --
// the child never reaches that path, it exits instead.
fn gen_thread_clone(n *Node) {
	gen_args(n, false, false, -1, false);   // fn->rdi, arg->rsi, stack->rdx, flags->rcx
	push_reg(12);
	push_reg(13);
	mov_reg_reg(12, RDI);                   // r12 = fn
	mov_reg_reg(13, RSI);                   // r13 = arg
	mov_reg_reg(RSI, RDX);                  // rsi = child stack
	mov_reg_reg(RDI, RCX);                  // rdi = flags
	mov_reg_imm(RDX, 0);                    // rdx = parent tid ptr
	mov_reg_imm(10, 0);                     // r10 = child tid ptr
	mov_reg_imm(R8, 0);                     // r8  = tls
	mov_reg_imm(RAX, 56);                   // SYS_CLONE
	b1(0x0f); b1(0x05);                     // syscall

	test_rax();
	b1(0x0f); b1(0x85);                     // jnz rel32 (rax != 0 -> parent)
	var jnz_at i64 = code.n;
	b4(0);

	// Child: call fn(arg), then exit with its return value.
	mov_reg_reg(RDI, 13);
	b1(0x41); b1(0xff); modrm(3, 2, 12);    // call r12
	mov_reg_reg(RDI, RAX);
	mov_reg_imm(RAX, 60);                   // SYS_EXIT
	b1(0x0f); b1(0x05);
	b1(0x0f); b1(0x0b);                     // ud2: sys_exit never returns

	var rel i64 = code.n - (jnz_at + 4);
	code.p[jnz_at] = (rel & 255) as u8;
	code.p[jnz_at + 1] = ((rel >> 8) & 255) as u8;
	code.p[jnz_at + 2] = ((rel >> 16) & 255) as u8;
	code.p[jnz_at + 3] = ((rel >> 24) & 255) as u8;
	// Parent lands here with rax still holding clone()'s result.
	pop_reg(13);
	pop_reg(12);
}

// Builds a fresh per-thread TLS block: mmap it, copy the template in,
// write the self-pointer at offset 0, then point %fs at it. Called once
// for the main thread (from the entry stub, only when the program
// declared a tvar) and once per spawned OS thread.
fn gen_tls_init_stub() {
	tls_stub_at = code.n;
	// mmap(0, tls_block_size, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
	mov_reg_imm(RDI, 0);
	mov_reg_imm(RSI, tls_block_size);
	mov_reg_imm(RDX, 3);
	mov_reg_imm(10, 34);
	mov_reg_imm(R8, -1);
	mov_reg_imm(R9, 0);
	mov_reg_imm(RAX, 9);
	b1(0x0f); b1(0x05);

	mov_reg_reg(12, RAX);          // r12 = the new block, kept live across the copy

	// Copy the template in, 8 bytes at a time -- tls_block_size is always
	// a multiple of 8.
	rex_w(0, RSI);
	b1(0xbe);
	tls_stub_src_at = code.n;      // patched below to the template's runtime address
	buf_u64(&code, 0);
	mov_reg_reg(RDI, 12);
	mov_reg_imm(RCX, tls_block_size / 8);
	b1(0xfc);                      // cld
	b1(0xf3); b1(0x48); b1(0xa5);  // rep movsq

	b1(0x4d); b1(0x89); b1(0x24); b1(0x24);  // mov [r12], r12 -- self-pointer

	// arch_prctl(ARCH_SET_FS, r12)
	mov_reg_reg(RSI, 12);
	mov_reg_imm(RDI, 0x1002);
	mov_reg_imm(RAX, 158);
	b1(0x0f); b1(0x05);
	b1(0xc3);                      // ret
}

// Control flow: an IR_BR carries a label id and is patched the same way
// jump()/patch_here() patch a forward branch today, just one indirection
// later. Label ids are a per-function counter; a backend lowers one op at a
// time (x86_lower_all below), so the pending branches of each label have to
// live in lists keyed by label id rather than in the byte stream.
var ir_label_n i64;       // per-function label id counter
var ir_label_br I64List;  // [label] -> head of its pending-branch chain, or -1
var ir_br_next I64List;   // [branch id] -> next branch in its label's chain, or -1
var ir_label_pos I64List; // [label] -> code.n once its IR_LABEL is lowered, or -1

// A fresh label id. Every slot a label can ever own is pre-initialized to
// -1 here, so a label that no branch references can never be mistaken for
// one holding a real (non-negative) pending branch.
fn ir_new_label() i64 {
	var id i64 = ir_label_n;
	ilist_set(&ir_label_br, id, -1);
	ilist_set(&ir_label_pos, id, -1);
	ir_label_n = ir_label_n + 1;
	return id;
}

// Turns one IrOp into x86 bytes. Temporary home: once codegen.qela stops
// emitting bytes directly and always goes through the IR, this becomes
// x86_emit.qela's x86_lower walking a whole function's op list at once;
// today it is called right after building each op, one at a time, as the
// IR vocabulary is proven out case by case.
fn x86_setcc_byte(cc i64) i64 {
	if (cc == CC_EQ) { return 0x94; }
	if (cc == CC_NE) { return 0x95; }
	if (cc == CC_LT) { return 0x9c; }
	if (cc == CC_LE) { return 0x9e; }
	if (cc == CC_GT) { return 0x9f; }
	if (cc == CC_GE) { return 0x9d; }
	if (cc == CC_ULT) { return 0x92; }
	if (cc == CC_ULE) { return 0x96; }
	if (cc == CC_UGT) { return 0x97; }
	if (cc == CC_UGE) { return 0x93; }
	die("internal: x86_setcc_byte: unhandled cc");
	return 0;
}

fn x86_lower_op(op *IrOp) {
	if (op.kind == IR_MOV && op.dst.kind == OP_ACC && op.src0.kind == OP_IMM) {
		mov_reg_imm(RAX, op.src0.off);
		return;
	}
	if (op.kind == IR_MOV && op.dst.kind == OP_ACC && op.src0.kind == OP_STR) {
		// The string fixup is a side effect of the lowering, not of IR
		// emission: the byte offset it records only exists once bytes are out.
		add_strref(RAX, op.src0.off as int);
		return;
	}
	if (op.kind == IR_MOV && op.dst.kind == OP_ACC && op.src0.kind == OP_GLOBAL) {
		add_dataref(op.src0.off as *Var);
		return;
	}
	if (op.kind == IR_MOV && op.dst.kind == OP_VREG && op.src0.kind == OP_IMM) {
		mov_reg_imm(op.dst.reg, op.src0.off);
		return;
	}
	if (op.kind == IR_MOV && op.dst.kind == OP_OP2 && op.src0.kind == OP_ACC) {
		mov_reg_reg(op2_reg(op.dst.reg), RAX);
		return;
	}
	if (op.kind == IR_LOAD && op.dst.kind == OP_ACC && op.src0.kind == OP_STACKSLOT) {
		// Same bytes as ld_rm's frame-slot path: an unconditional 8-byte
		// mov from the local's home (direct_local guarantees machine width).
		rbp_mem(0x8b, RAX, -(op.src0.off));
		return;
	}
	if (op.kind == IR_LOAD && op.dst.kind == OP_ACC && op.src0.kind == OP_VREG) {
		// ld_rm's register path, replayed with the same reg/rm roles --
		// mov_reg_reg would emit the same instruction with the REX.B and
		// REX.R bits swapped, different bytes.
		rex_w(RAX, op.src0.reg);
		b1(0x8b);
		modrm(3, RAX, op.src0.reg);
		return;
	}
	if (op.kind == IR_LOAD && op.dst.kind == OP_ACC && op.src0.kind == OP_ACC) {
		// The address is already in the accumulator (gen_addr's job);
		// load() dereferences it in place, widening by dst.ty.
		load(op.dst.ty);
		return;
	}
	if (op.kind == IR_CAST && op.dst.kind == OP_ACC && op.src0.kind == OP_ACC) {
		if (op.aux == CAST_BOOL) { test_rax(); setcc(0x95); return; }
		if (op.aux == CAST_TRUNC) { truncate_to(op.dst.ty); return; }
	}
	if (op.kind == IR_STORE && op.dst.kind == OP_ACC && op.src0.kind == OP_IMM) {
		store_imm(op.dst.ty, op.src0.off);
		return;
	}
	if (op.kind == IR_STORE && op.dst.kind == OP_STACKSLOT && op.src0.kind == OP_ACC) {
		st_local(op.dst.off, RAX);
		return;
	}
	if (op.kind == IR_STORE && op.dst.kind == OP_VREG && op.src0.kind == OP_ACC) {
		// mov <dst.reg>, rax -- st_rm's promoted-local path, replayed with
		// the same reg/rm roles so the REX.B/REX.R bits match.
		rex_w(RAX, op.dst.reg);
		b1(0x89);
		modrm(3, RAX, op.dst.reg);
		return;
	}
	if (op.kind == IR_STORE && op.dst.kind == OP_OP2 && op.src0.kind == OP_ACC) {
		// store [op2_reg], rax at width -- store()'s memory path, the
		// address in the staging register instead of freshly popped.
		var op2 int = op2_reg(op.dst.reg);
		var sz int = op.dst.ty.size;
		if (sz == 1) { b1(0x88); modrm(0, RAX, op2); return; }
		if (sz == 2) { b1(0x66); b1(0x89); modrm(0, RAX, op2); return; }
		if (sz == 4) { b1(0x89); modrm(0, RAX, op2); return; }
		b1(0x48); b1(0x89); modrm(0, RAX, op2);
		return;
	}
	if (op.kind == IR_UNARY && op.dst.kind == OP_ACC && op.src0.kind == OP_ACC) {
		if (op.aux == UOP_NEG) { b1(0x48); b1(0xf7); modrm(3, 3, RAX); return; }
		if (op.aux == UOP_BITNOT) { b1(0x48); b1(0xf7); modrm(3, 2, RAX); return; }
		if (op.aux == UOP_LNOT) { test_rax(); setcc(0x94); return; }
	}
	if (op.kind == IR_PUSH && op.src0.kind == OP_ACC) {
		b1(0x50);
		return;
	}
	if (op.kind == IR_PUSH && op.src0.kind == OP_OP2) {
		var r int = op2_reg(op.src0.reg);
		if (r >= 8) { b1(0x41); }
		b1(0x50 + ((r as i64) & 7));
		return;
	}
	if (op.kind == IR_MEMCPY) {
		// copy_aggregate's protocol, replayed byte for byte: pop the
		// destination from the staging stack, copy aux bytes from [rax] to
		// it, leave the destination address in the accumulator. Emitted raw
		// so the staging depth stays the frontend's bookkeeping.
		b1(0x5f);                       // pop rdi (destination)
		mov_reg_reg(RSI, RAX);          // mov rsi, rax (source)
		b1(0x57);                       // push rdi
		mov_reg_imm(RCX, op.aux);
		b1(0xf3); b1(0xa4);             // rep movsb
		b1(0x58);                       // pop rax (result = destination)
		return;
	}
	if (op.kind == IR_POP && op.dst.kind == OP_ACC) {
		b1(0x58);
		return;
	}
	if (op.kind == IR_POP && op.dst.kind == OP_OP2) {
		// pop <op2_reg>: the binop staging register. Emitted raw, not via
		// pop_reg, so the staging depth stays the frontend's bookkeeping.
		var r int = op2_reg(op.dst.reg);
		if (r >= 8) { b1(0x41); }
		b1(0x58 + ((r as i64) & 7));
		return;
	}
	if (op.kind == IR_MEMSET && op.dst.kind == OP_STACKSLOT) {
		// lea rdi, [rbp-off]; xor eax, eax; mov rcx, size; rep stosb --
		// ND_ZERO's aggregate path, replayed with the same bytes.
		lea_local(RDI, op.dst.off);
		mov_reg_imm(RAX, 0);
		mov_reg_imm(RCX, op.aux);
		b1(0xf3); b1(0xaa);
		return;
	}
	if (op.kind == IR_ALU && op.dst.kind == OP_ACC && op.src0.kind == OP_ACC && op.src1.kind == OP_OP2) {
		var uns bool = op.dst.ty.is_unsigned;
		var op2 int = op2_reg(op.src1.reg);
		if (op.aux == ALU_ADD) { rex_w(op2, RAX); b1(0x01); modrm(3, op2, RAX); return; }
		if (op.aux == ALU_SUB) { rex_w(op2, RAX); b1(0x29); modrm(3, op2, RAX); return; }
		if (op.aux == ALU_MUL) { b1(0x48); b1(0x0f); b1(0xaf); modrm(3, RAX, op2); return; }
		if (op.aux == ALU_DIV || op.aux == ALU_MOD) {
			if (uns) {
				b1(0x31); modrm(3, RDX, RDX);
				b1(0x48); b1(0xf7); modrm(3, 6, op2);
			} else {
				b1(0x48); b1(0x99);
				b1(0x48); b1(0xf7); modrm(3, 7, op2);
			}
			if (op.aux == ALU_MOD) { mov_reg_reg(RAX, RDX); }
			return;
		}
		if (op.aux == ALU_AND) { rex_w(op2, RAX); b1(0x21); modrm(3, op2, RAX); return; }
		if (op.aux == ALU_OR)  { rex_w(op2, RAX); b1(0x09); modrm(3, op2, RAX); return; }
		if (op.aux == ALU_XOR) { rex_w(op2, RAX); b1(0x31); modrm(3, op2, RAX); return; }
		if (op.aux == ALU_SHL || op.aux == ALU_SHR) {
			mov_reg_reg(RCX, op2);
			b1(0x48); b1(0xd3);
			var ext int = 7;
			if (op.aux == ALU_SHL) { ext = 4; } else if (uns) { ext = 5; }
			modrm(3, ext, RAX);
			return;
		}
	}
	if (op.kind == IR_ALU && op.dst.kind == OP_ACC && op.src0.kind == OP_ACC && op.src1.kind == OP_IMM) {
		var v i64 = op.src1.off;
		if (op.aux == ALU_ADD) { alu_rax_imm(0, v); return; }
		if (op.aux == ALU_SUB) { alu_rax_imm(5, v); return; }
		if (op.aux == ALU_AND) {
			// A mask to a byte or a halfword is a zero-extending move
			// (gen_binop_imm's fast path, replayed with the same bytes).
			if (v == 255) { b1(0x0f); b1(0xb6); modrm(3, RAX, RAX); return; }
			if (v == 65535) { b1(0x0f); b1(0xb7); modrm(3, RAX, RAX); return; }
			alu_rax_imm(4, v);
			return;
		}
		if (op.aux == ALU_OR)  { alu_rax_imm(1, v); return; }
		if (op.aux == ALU_XOR) { alu_rax_imm(6, v); return; }
		if (op.aux == ALU_MUL) {
			b1(0x48);
			if (v >= -128 && v <= 127) {
				b1(0x6b);
				modrm(3, RAX, RAX);
				b1(v);
			} else {
				b1(0x69);
				modrm(3, RAX, RAX);
				b4(v);
			}
			return;
		}
		if (op.aux == ALU_SCALE) {
			// scale_by: mov rcx, size; imul rax, rcx -- a distinct byte
			// sequence from the folded imul-by-imm above.
			mov_reg_imm(RCX, v);
			b1(0x48); b1(0x0f); b1(0xaf);
			modrm(3, RAX, RCX);
			return;
		}
		if (op.aux == ALU_DIV || op.aux == ALU_MOD) {
			// ptr_diff: materialise the divisor in the OP2 staging register,
			// then cqo; idiv (signed). Clobbers OP2, which the frontend
			// guarantees is dead at this point.
			var d int = op2_reg(0);
			mov_reg_imm(d, v);
			b1(0x48); b1(0x99);
			b1(0x48); b1(0xf7); modrm(3, 7, d);
			if (op.aux == ALU_MOD) { mov_reg_reg(RAX, RDX); }
			return;
		}
		if (op.aux == ALU_SHL || op.aux == ALU_SHR) {
			b1(0x48); b1(0xc1);
			var ext int = 7;
			if (op.aux == ALU_SHL) { ext = 4; } else if (op.dst.ty.is_unsigned) { ext = 5; }
			modrm(3, ext, RAX);
			b1(v);
			return;
		}
	}
	if (op.kind == IR_ALU && op.dst.kind == OP_ACC && op.src0.kind == OP_ACC &&
	    (op.src1.kind == OP_VREG || op.src1.kind == OP_STACKSLOT)) {
		if (op.aux == ALU_ADD) { x86_alu_acc_rm(0, 0x03, op.src1); return; }
		if (op.aux == ALU_SUB) { x86_alu_acc_rm(0, 0x2b, op.src1); return; }
		if (op.aux == ALU_AND) { x86_alu_acc_rm(0, 0x23, op.src1); return; }
		if (op.aux == ALU_OR)  { x86_alu_acc_rm(0, 0x0b, op.src1); return; }
		if (op.aux == ALU_XOR) { x86_alu_acc_rm(0, 0x33, op.src1); return; }
		if (op.aux == ALU_MUL) { x86_alu_acc_rm(0x0f, 0xaf, op.src1); return; }
	}
	if (op.kind == IR_CMP && op.src0.kind == OP_ACC && op.src1.kind == OP_OP2) {
		var op2 int = op2_reg(op.src1.reg);
		rex_w(op2, RAX);
		b1(0x39);
		modrm(3, op2, RAX);
		return;
	}
	if (op.kind == IR_CMP && op.src0.kind == OP_ACC && op.src1.kind == OP_IMM) {
		alu_rax_imm(7, op.src1.off);
		return;
	}
	if (op.kind == IR_CMP && op.src0.kind == OP_ACC &&
	    (op.src1.kind == OP_VREG || op.src1.kind == OP_STACKSLOT)) {
		x86_alu_acc_rm(0, 0x3b, op.src1);
		return;
	}
	if (op.kind == IR_SETCC && op.dst.kind == OP_ACC) {
		setcc(x86_setcc_byte(op.aux));
		return;
	}
	if (op.kind == IR_LEA && op.dst.kind == OP_ACC) {
		var scale int = op.aux as int;
		if (op.src0.kind == OP_ACC && op.src1.kind == OP_NONE) {
			// A constant index folded into the address: rax += disp.
			add_rax_imm(op.dst.off);
			return;
		}
		if (op.src0.kind == OP_STACKSLOT && op.src1.kind == OP_NONE) {
			// A local's address (lea_local's slot form).
			lea_local(RAX, op.src0.off);
			return;
		}
		if (op.src0.kind == OP_ACC && (op.src1.kind == OP_OP2 || op.src1.kind == OP_VREG)) {
			// Array element: rax = base + idx*scale. base is the accumulator,
			// the index a staging register (OP2) or a promoted local.
			var idx int;
			if (op.src1.kind == OP_OP2) { idx = op2_reg(op.src1.reg); } else { idx = op.src1.reg; }
			if (lea_scale_ok(scale)) {
				lea_index(scale, RAX, idx);
			} else {
				// The imul-with-rcx fallback. A non-power-of-two scale skips
				// the promoted-index fast path, so idx is always the OP2 reg.
				mov_reg_imm(RCX, scale as i64);
				b1(0x48); b1(0x0f); b1(0xaf);
				modrm(3, idx, RCX);
				rex_w(idx, RAX); b1(0x01); modrm(3, idx, RAX);
			}
			if (op.dst.off != 0) { add_rax_imm(op.dst.off); }
			return;
		}
		if (op.src0.kind == OP_OP2 && op.src1.kind == OP_ACC) {
			// Slice element: rax = base + idx*scale, base in the OP2 staging
			// register and the index in the accumulator.
			var base int = op2_reg(op.src0.reg);
			if (lea_scale_ok(scale)) {
				lea_index(scale, base, RAX);
			} else {
				scale_by(scale);
				rex_w(base, RAX); b1(0x01); modrm(3, base, RAX);
			}
			if (op.dst.off != 0) { add_rax_imm(op.dst.off); }
			return;
		}
	}
	if (op.kind == IR_LEA && op.dst.kind == OP_OP2 && op.src0.kind == OP_STACKSLOT && op.src1.kind == OP_NONE) {
		lea_local(op2_reg(op.dst.reg), op.src0.off);
		return;
	}
	if (op.kind == IR_BR) {
		var label i64 = op.dst.off;
		if (ir_label_pos.p[label] >= 0) {
			// Backward branch: the label is already lowered, so both ends
			// are known and the short-vs-near choice is made in one pass,
			// exactly as jump_back did for a loop's back edge.
			jump_back(ir_label_pos.p[label]);
			return;
		}
		// Forward branch: emit a placeholder and hang it on the label's
		// pending chain; its IR_LABEL patches every id in the chain.
		var jcc i64 = 0;
		if (op.aux != CC_ALWAYS) { jcc = x86_setcc_byte(op.aux) - 0x10; }
		var id i64 = jump(jcc);
		ilist_set(&ir_br_next, id, ir_label_br.p[label]);
		ilist_set(&ir_label_br, label, id);
		return;
	}
	if (op.kind == IR_LABEL) {
		ilist_set(&ir_label_pos, op.dst.off, code.n);
		var id i64 = ir_label_br.p[op.dst.off];
		while (id >= 0) {
			patch_here(id);
			id = ir_br_next.p[id];
		}
		return;
	}
	if (op.kind == IR_CALL) {
		if (op.src0.kind == OP_FUNC) {
			add_call((op.src0.off as *Func).name, op.pos);
			return;
		}
		// An indirect target goes in r10 (never an argument register) and
		// is loaded after the arguments are set up, exactly as
		// gen_indirect_call staged it by hand.
		if (op.src0.kind == OP_VREG) {
			mov_reg_reg(R10, op.src0.reg);
		} else if (op.src0.kind == OP_GLOBAL) {
			rex_w(0, R10);
			b1(0xba);
			add_dataref(op.src0.off as *Var);
		} else if (op.src0.kind == OP_STACKSLOT) {
			rbp_mem(0x8b, R10, -(op.src0.off));
		} else {
			die("internal: x86_lower_op: IR_CALL: unhandled target");
		}
		b1(0x41); b1(0xff); b1(0xd2);
		return;
	}
	if (op.kind == IR_FUNCADDR && op.dst.kind == OP_ACC && op.src0.kind == OP_FUNC) {
		add_funcaddr((op.src0.off as *Func).name, op.pos);
		return;
	}
	if (op.kind == IR_RET) {
		b1(0xc3);
		return;
	}
	if (op.kind == IR_SYSCALL) {
		// The number and arguments were already staged by gen_args into the
		// backend's syscall registers; only the trapping instruction is IR.
		b1(0x0f); b1(0x05);
		return;
	}
	die("internal: x86_lower_op: unhandled IR shape");
}

fn x86_lower_all() {
	var op *IrOp = ir_head;
	while (op as i64 != 0) {
		x86_lower_op(op);
		op = op.next;
	}
	ir_reset();
}

fn ir_branch(cc i64, label i64, pos i64) {
	var op *IrOp = ir_emit(IR_BR, pos);
	op.dst = operand_imm(label);
	op.aux = cc;
	x86_lower_all();
}

fn ir_label(label i64, pos i64) {
	var op *IrOp = ir_emit(IR_LABEL, pos);
	op.dst = operand_imm(label);
	x86_lower_all();
}

// The language-level call. Argument staging stays in the frontend (gen_args
// classifies into the ABI's register slots); the IR_CALL carries only the
// target -- OP_FUNC for a direct call, an OP_VREG/OP_GLOBAL/OP_STACKSLOT
// holding the address for an indirect one -- and the backend emits the call
// instruction plus whatever target load its own convention requires.
fn ir_call(f *Func, pos i64) {
	var op *IrOp = ir_emit(IR_CALL, pos);
	op.src0 = operand_func(f);
	x86_lower_all();
}

fn ir_call_ind(target IrOperand, pos i64) {
	var op *IrOp = ir_emit(IR_CALL, pos);
	op.src0 = target;
	x86_lower_all();
}

fn ir_funcaddr(f *Func, pos i64) {
	var op *IrOp = ir_emit(IR_FUNCADDR, pos);
	op.dst = operand_acc();
	op.src0 = operand_func(f);
	x86_lower_all();
}

fn ir_ret(pos i64) {
	var op *IrOp = ir_emit(IR_RET, pos);
	x86_lower_all();
}

fn ir_setcc_acc(cc i64, pos i64) {
	var op *IrOp = ir_emit(IR_SETCC, pos);
	op.dst = operand_acc();
	op.aux = cc;
	x86_lower_all();
}

fn ir_syscall(pos i64) {
	var op *IrOp = ir_emit(IR_SYSCALL, pos);
	x86_lower_all();
}

fn ir_mov_acc_imm(v i64, pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_acc();
	op.src0 = operand_imm(v);
	x86_lower_all();
}

fn ir_mov_acc_str(id int, pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_acc();
	op.src0 = operand_str(id);
	x86_lower_all();
}

fn ir_mov_acc_global(v *Var, pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_acc();
	op.src0 = operand_global(v);
	x86_lower_all();
}

// The accumulator holds an address (gen_addr's job); load through it into the
// accumulator, widening per ty.
fn ir_load_acc(ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_LOAD, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_acc();
	x86_lower_all();
}

// A direct scalar local: load its home (register or frame slot) into the
// accumulator, exactly as ld_rm did.
fn ir_load_var(v *Var, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_LOAD, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	if (v.has_reg) { op.src0 = operand_vreg(v.reg, ty); }
	else { op.src0 = operand_stackslot(v.offset as i64, ty); }
	x86_lower_all();
}

// rax = base + index*scale + disp, the INDEX address form. base is OP_ACC
// (array) or OP_OP2 (slice); index is OP_ACC/OP_OP2/OP_VREG, or OP_NONE for a
// plain constant fold. aux carries the element scale, dst.off the fixed
// displacement.
fn ir_lea_acc(base IrOperand, index IrOperand, scale int, disp i64, pos i64) {
	var op *IrOp = ir_emit(IR_LEA, pos);
	op.dst = operand_acc();
	op.dst.off = disp;
	op.src0 = base;
	op.src1 = index;
	op.aux = scale as i64;
	x86_lower_all();
}

// The INDEX path's index register is the OP2 staging slot, or a promoted
// local that can be the lea index directly.
fn operand_index(reg int) IrOperand {
	if (reg == op2_reg(0)) { return operand_op2(0); }
	return operand_vreg(reg, 0 as *Type);
}

fn ir_unary_acc(uop int, pos i64) {
	var op *IrOp = ir_emit(IR_UNARY, pos);
	op.dst = operand_acc();
	op.src0 = operand_acc();
	op.aux = uop as i64;
	x86_lower_all();
}

// A cast applied to the value already sitting in the accumulator, in place.
fn ir_cast_acc(ck int, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_CAST, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_acc();
	op.aux = ck as i64;
	x86_lower_all();
}

// The left operand is already in the accumulator and the right in the
// target's OP2 staging register (x86: rdi), per gen_expr's binop preamble
// (spine emission / gen_binop_mem's operand setup) -- this just records that
// shape as IR and lowers it immediately.
fn ir_alu_acc(aop int, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_ALU, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_acc();
	op.src1 = operand_op2(0);
	op.aux = aop as i64;
	x86_lower_all();
}

fn ir_compare_acc(cc i64, pos i64) {
	var c *IrOp = ir_emit(IR_CMP, pos);
	c.src0 = operand_acc();
	c.src1 = operand_op2(0);
	var s *IrOp = ir_emit(IR_SETCC, pos);
	s.dst = operand_acc();
	s.aux = cc;
	x86_lower_all();
}

fn ir_mov_vreg_imm(reg int, v i64, pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_vreg(reg, 0 as *Type);
	op.src0 = operand_imm(v);
	x86_lower_all();
}

// The accumulator already holds the store's target address (gen_addr's
// job), matching how store()/store_imm() already dereference RAX today.
fn ir_store_acc_imm(ty *Type, v i64, pos i64) {
	var op *IrOp = ir_emit(IR_STORE, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_imm(v);
	x86_lower_all();
}

fn ir_store_stackslot_acc(off i64, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_STORE, pos);
	op.dst = operand_stackslot(off, ty);
	op.src0 = operand_acc();
	x86_lower_all();
}

fn ir_store_vreg_acc(reg int, ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_STORE, pos);
	op.dst = operand_vreg(reg, ty);
	op.src0 = operand_acc();
	x86_lower_all();
}

// Zero <size> bytes at a frame slot (ND_ZERO's aggregate path).
fn ir_memset_stackslot(off i64, size i64, pos i64) {
	var op *IrOp = ir_emit(IR_MEMSET, pos);
	op.dst = operand_stackslot(off, 0 as *Type);
	op.aux = size;
	x86_lower_all();
}

// The stack-machine staging: push the accumulator, pop into the OP2 register
// (a binop's right side). depth tracks the 16-byte call alignment exactly as
// push_reg/pop_reg did, so gen_call's odd-depth fixup is unaffected while the
// frontend still emits bytes; once it does not, the backend derives the same
// count by walking IR_PUSH/IR_POP itself.
fn ir_push_acc(pos i64) {
	var op *IrOp = ir_emit(IR_PUSH, pos);
	op.src0 = operand_acc();
	depth = depth + 1;
	x86_lower_all();
}

fn ir_pop_op2(pos i64) {
	var op *IrOp = ir_emit(IR_POP, pos);
	op.dst = operand_op2(0);
	depth = depth - 1;
	x86_lower_all();
}

fn ir_pop_acc(pos i64) {
	var op *IrOp = ir_emit(IR_POP, pos);
	op.dst = operand_acc();
	depth = depth - 1;
	x86_lower_all();
}

// lea <op2_reg>, [rbp - off]: a field address in the staging register.
fn ir_lea_op2_slot(off i64, pos i64) {
	var op *IrOp = ir_emit(IR_LEA, pos);
	op.dst = operand_op2(0);
	op.src0 = operand_stackslot(off, 0 as *Type);
	op.src1 = operand_none();
	op.aux = 1;
	x86_lower_all();
}

// lea rax, [rbp - off]: an aggregate literal's own address.
fn ir_lea_slot_acc(off i64, pos i64) {
	var op *IrOp = ir_emit(IR_LEA, pos);
	op.dst = operand_acc();
	op.src0 = operand_stackslot(off, 0 as *Type);
	op.src1 = operand_none();
	op.aux = 1;
	x86_lower_all();
}

fn ir_push_op2(pos i64) {
	var op *IrOp = ir_emit(IR_PUSH, pos);
	op.src0 = operand_op2(0);
	depth = depth + 1;
	x86_lower_all();
}

// copy <size> bytes from the address in the accumulator to the destination
// address pushed on the staging stack; the destination address is left in the
// accumulator. Consumes one staging entry.
fn ir_memcpy_stage(size i64, pos i64) {
	var op *IrOp = ir_emit(IR_MEMCPY, pos);
	op.src0 = operand_acc();
	op.aux = size;
	depth = depth - 1;
	x86_lower_all();
}

// mov <op2_reg>, rax -- the frontend's "evaluate into the staging register".
fn ir_mov_acc_op2(pos i64) {
	var op *IrOp = ir_emit(IR_MOV, pos);
	op.dst = operand_op2(0);
	op.src0 = operand_acc();
	x86_lower_all();
}

// The right operand is an immediate folded into the instruction (a constant
// binop, gen_binop_imm's fast path).
fn ir_alu_acc_imm(aop int, ty *Type, v i64, pos i64) {
	var op *IrOp = ir_emit(IR_ALU, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_acc();
	op.src1 = operand_imm(v);
	op.aux = aop as i64;
	x86_lower_all();
}

// The right operand is a direct local (promoted register or frame slot),
// read as one r/m operand -- gen_binop_mem's fast path.
fn ir_alu_acc_rm(aop int, ty *Type, src IrOperand, pos i64) {
	var op *IrOp = ir_emit(IR_ALU, pos);
	op.dst = operand_acc();
	op.dst.ty = ty;
	op.src0 = operand_acc();
	op.src1 = src;
	op.aux = aop as i64;
	x86_lower_all();
}

fn ir_cmp_acc_imm(v i64, pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = operand_acc();
	op.src1 = operand_imm(v);
	x86_lower_all();
}

fn ir_cmp_acc_rm(src IrOperand, pos i64) {
	var op *IrOp = ir_emit(IR_CMP, pos);
	op.src0 = operand_acc();
	op.src1 = src;
	x86_lower_all();
}

// store [op2_reg], rax at ty's width (the value is in the accumulator).
fn ir_store_op2_acc(ty *Type, pos i64) {
	var op *IrOp = ir_emit(IR_STORE, pos);
	op.dst = operand_op2(0);
	op.dst.ty = ty;
	op.src0 = operand_acc();
	x86_lower_all();
}

fn gen_expr(n *Node) {
	var k int = n.kind;

	if (k == ND_NUM) { ir_mov_acc_imm(n.val, n.pos); return; }
	if (k == ND_STRLIT) { ir_mov_acc_str(n.val as int, n.pos); return; }
	if (k == ND_COMPTIME) { ir_mov_acc_imm(n.val, n.pos); return; }
	if (k == ND_SIZEOF) { ir_mov_acc_imm(n.typeval.size as i64, n.pos); return; }
	if (k == ND_VAR) {
		if (direct_local(n)) { ir_load_var(n.varp, n.ty, n.pos); return; }
		gen_lvalue(n);
		return;
	}
	if (k == ND_MEMBER || k == ND_INDEX || k == ND_SLICE) {
		gen_lvalue(n);
		return;
	}
	if (k == ND_ADDR) { gen_addr(n.lhs); return; }
	if (k == ND_DEREF) {
		gen_expr(n.lhs);
		if (!is_aggregate(n.ty)) { ir_load_acc(n.ty, n.pos); }
		return;
	}
	if (k == ND_CAST) {
		gen_expr(n.lhs);
		if (n.val == 1) {
			// A bit-reinterpret, not a numeric conversion: the raw bits
			// already sit in RAX exactly as they should (see type_interp).
		} else if (n.ty.kind == TY_BOOL) {
			ir_cast_acc(CAST_BOOL, n.ty, n.pos);
		} else if (is_float(n.ty) || is_float(n.lhs.ty)) {
			gen_cast_float(n);
		} else {
			ir_cast_acc(CAST_TRUNC, n.ty, n.pos);
		}
		return;
	}
	if (k == ND_ASSIGN) {
		if (direct_local(n.lhs)) {
			gen_expr(n.rhs);
			if (n.lhs.varp.has_reg) {
				ir_store_vreg_acc(n.lhs.varp.reg, n.lhs.ty, n.pos);
			} else {
				ir_store_stackslot_acc(n.lhs.varp.offset as i64, n.lhs.ty, n.pos);
			}
			return;
		}
		gen_addr(n.lhs);
		ir_push_acc(n.pos);
		gen_expr(n.rhs);
		if (is_aggregate(n.lhs.ty)) {
			ir_memcpy_stage(n.lhs.ty.size as i64, n.pos);
		} else {
			ir_pop_op2(n.pos);
			ir_store_op2_acc(n.lhs.ty, n.pos);
		}
		return;
	}
	if (k == ND_OPASSIGN) { gen_opassign(n); return; }
	if (k == ND_ENUMLIT) { gen_enumlit(n); return; }
	if (k == ND_STRUCTLIT) { gen_structlit(n); return; }
	if (k == ND_ZERO) {
		if (n.varp.has_reg) { ir_mov_vreg_imm(n.varp.reg, 0, n.pos); return; }
		var off i64 = n.varp.offset as i64;
		var size int = n.varp.ty.size;
		if (size <= 8 && !is_aggregate(n.varp.ty)) {
			ir_mov_acc_imm(0, n.pos);
			ir_store_stackslot_acc(off, n.varp.ty, n.pos);
		} else {
			ir_memset_stackslot(off, size as i64, n.pos);
		}
		return;
	}
	if (k == ND_COMMA) { gen_expr(n.lhs); gen_expr(n.rhs); return; }
	if (k == ND_NEG) {
		gen_expr(n.lhs);
		if (is_float(n.ty)) { gen_neg_float(n.ty.size); return; }
		ir_unary_acc(UOP_NEG, n.pos);
		return;
	}
	if (k == ND_BITNOT) {
		gen_expr(n.lhs);
		ir_unary_acc(UOP_BITNOT, n.pos);
		return;
	}
	if (k == ND_NOT) {
		gen_expr(n.lhs);
		ir_unary_acc(UOP_LNOT, n.pos);
		return;
	}
	if (k == ND_SYSCALL) {
		gen_args(n, true, true, -1, false);
		ir_syscall(n.pos);
		return;
	}
	if (k == ND_ASM) {
		gen_asm_operands(n.args);
		return;
	}
	if (k == ND_ASSERT) { gen_assert(n); return; }
	if (k == ND_FUNCADDR) {
		// add_type resolved the name to a real function (or errored), so
		// this is a straight address; the fallback keeps an odd case from
		// crashing where the type checker let something through.
		var ff *Func = find_func(n.name);
		if (ff as i64 != 0) { ir_funcaddr(ff, n.pos); }
		else { add_funcaddr(n.name, n.pos); }
		return;
	}
	if (k == ND_CALL) {
		if (str_eq(n.name, "coro_switch")) { gen_coro_switch(n); return; }
		if (str_eq(n.name, "gc_data_base") || str_eq(n.name, "gc_data_end")) {
			rex_w(0, RAX);
			b1(0xb8);
			if (str_eq(n.name, "gc_data_base")) { ilist_push(&gc_base_refs, code.n); }
			else { ilist_push(&gc_end_refs, code.n); }
			buf_u64(&code, 0);
			return;
		}
		if (str_eq(n.name, "gc_save_regs")) {
			gen_args(n, false, false, -1, false);
			b1(0x48); b1(0x89); b1(0x1f);            // mov [rdi], rbx
			b1(0x48); b1(0x89); b1(0x6f); b1(0x08);  // mov [rdi+8], rbp
			b1(0x4c); b1(0x89); b1(0x67); b1(0x10);  // mov [rdi+16], r12
			b1(0x4c); b1(0x89); b1(0x6f); b1(0x18);  // mov [rdi+24], r13
			b1(0x4c); b1(0x89); b1(0x77); b1(0x20);  // mov [rdi+32], r14
			b1(0x4c); b1(0x89); b1(0x7f); b1(0x28);  // mov [rdi+40], r15
			return;
		}
		if (str_eq(n.name, "coro_entry_addr")) {
			rex_w(0, RAX);
			b1(0xb8);
			ilist_push(&coro_stub_refs, code.n);
			buf_u64(&code, 0);
			return;
		}
		if (str_eq(n.name, "atomic_cas")) {
			gen_args(n, false, false, -1, false);
			mov_reg_reg(RAX, RSI);       // rax = expected
			b1(0xf0);                    // lock
			rex_w(RDX, RDI);
			b1(0x0f); b1(0xb1);
			modrm(0, RDX, RDI);          // cmpxchg [rdi], rdx
			setcc(0x94);                 // rax = (old == expected)
			return;
		}
		if (str_eq(n.name, "atomic_add")) {
			gen_args(n, false, false, -1, false);
			b1(0xf0);                    // lock
			rex_w(RSI, RDI);
			b1(0x0f); b1(0xc1);
			modrm(0, RSI, RDI);          // xadd [rdi], rsi
			mov_reg_reg(RAX, RSI);       // rax = old value
			return;
		}
		if (str_eq(n.name, "atomic_load")) {
			gen_args(n, false, false, -1, false);
			rex_w(RAX, RDI);
			b1(0x8b);
			modrm(0, RAX, RDI);          // mov rax, [rdi]
			return;
		}
		if (str_eq(n.name, "atomic_store")) {
			gen_args(n, false, false, -1, false);
			rex_w(RSI, RDI);
			b1(0x89);
			modrm(0, RSI, RDI);          // mov [rdi], rsi
			return;
		}
		if (str_eq(n.name, "fence")) {
			b1(0x0f); b1(0xae); b1(0xf0); // mfence
			return;
		}
		if (str_eq(n.name, "thread_clone")) {
			gen_thread_clone(n);
			return;
		}
		if (str_eq(n.name, "tls_init")) {
			b1(0xe8);
			ilist_push(&tls_init_refs, code.n);
			b4(0);
			return;
		}
		gen_call(n);
		return;
	}
	if (k == ND_AND || k == ND_OR) { gen_logical(n); return; }

	var lt *Type = n.lhs.ty;
	var rt *Type = n.rhs.ty;
	var ptr_diff bool = k == ND_SUB && lt.kind == TY_PTR && rt.kind == TY_PTR;

	var k2 int = n.kind;
	if (!is_float(lt) && n.rhs.kind == ND_NUM && !ptr_diff && !(lt.kind == TY_PTR && k2 != ND_ADD && k2 != ND_SUB && n.rhs.val != 0)) {
		var v i64 = n.rhs.val;
		if (lt.kind == TY_PTR) {
			if (k2 != ND_ADD && k2 != ND_SUB) { v = v; }
			else { v = v * (lt.base.size as i64); }
		}
		if (fits_imm32(v) && gen_binop_imm(n, v)) { return; }
	}

	if (!is_float(lt) && !ptr_diff && lt.kind != TY_PTR && mem_binop_ok(n)) {
		if (gen_binop_mem(n, n.lhs, n.rhs)) { return; }
	}
	if (!is_float(lt) && !ptr_diff && lt.kind != TY_PTR && rt.kind != TY_PTR && swap_binop_ok(n)) {
		if (gen_binop_mem(n, n.rhs, n.lhs)) { return; }
	}

	gen_expr(n.rhs);
	if (!ptr_diff && lt.kind == TY_PTR && rt.kind != TY_PTR) {
		if (lt.base.size != 1) { ir_alu_acc_imm(ALU_SCALE, n.ty, lt.base.size as i64, n.pos); }
	}
	ir_push_acc(n.pos);
	gen_expr(n.lhs);
	ir_pop_op2(n.pos);
	gen_binop(n);

	if (ptr_diff) {
		ir_alu_acc_imm(ALU_DIV, n.ty, lt.base.size as i64, n.pos);
	}
}

fn run_defers(ds *DeferScope) {
	var d *Node = ds.list;
	while (d as i64 != 0) {
		gen_stmt(d.lhs);
		d = d.els;
	}
}

fn any_defers() bool {
	var ds *DeferScope = cur_defers;
	while (ds as i64 != 0) {
		if (ds.list as i64 != 0) { return true; }
		ds = ds.prev;
	}
	return false;
}

fn unwind_to(target int) {
	var ds *DeferScope = cur_defers;
	while (ds as i64 != 0 && ds.depth > target) {
		run_defers(ds);
		ds = ds.prev;
	}
}

fn gen_match(n *Node) {
	var soff i64 = n.tmp.offset as i64;
	gen_addr(n.cond);
	st_local(soff, RAX);

	var end i64 = ir_new_label();
	var arm *Node = n.body;
	while (arm as i64 != 0) {
		var miss i64 = -1;
		if (arm.name.len != 0) {
			ld_local(RAX, soff);
			b1(0x48); b1(0x83);
			modrm(0, 7, RAX);
			b1(arm.variant.tag as i64);
			miss = ir_new_label();
			ir_branch(CC_NE, miss, arm.pos);
		}

		var f *Member = 0 as *Member;
		if (arm.variant as i64 != 0) { f = arm.variant.fields; }
		var b *Node = arm.args;
		while (b as i64 != 0) {
			lea_local(RDI, b.varp.offset as i64);
			push_reg(RDI);
			ld_local(RAX, soff);
			add_rax_imm(f.offset as i64);
			if (is_aggregate(f.ty)) {
				copy_aggregate(f.ty.size);
			} else {
				load(f.ty);
				store(f.ty);
			}
			f = f.next;
			b = b.next;
		}

		gen_stmt(arm.body);
		if (arm.next as i64 != 0) { ir_branch(CC_ALWAYS, end, arm.pos); }
		if (miss >= 0) { ir_label(miss, arm.pos); }
		arm = arm.next;
	}
	ir_label(end, n.pos);
}

fn gen_block(n *Node) {
	var ds DeferScope;
	defer_depth = defer_depth + 1;
	ds.prev = cur_defers;
	ds.depth = defer_depth;
	cur_defers = &ds;

	var s *Node = n.body;
	while (s as i64 != 0) { gen_stmt(s); s = s.next; }

	run_defers(&ds);
	cur_defers = ds.prev;
	defer_depth = defer_depth - 1;
}

fn gen_ret(n *Node) {
	if (n.lhs as i64 != 0) {
		gen_expr(n.lhs);
		if (is_aggregate(n.lhs.ty)) {
			if (gen_fn.ret_slot as i64 != 0) {
				mov_reg_reg(RSI, RAX);
				ld_local(RDI, gen_fn.ret_slot.offset as i64);
				copy_rsi_rdi(n.lhs.ty.size);
				ld_local(RAX, gen_fn.ret_slot.offset as i64);
			} else {
				if (n.lhs.ty.size > 8) { ld_at_rax(RDX, 8); }
				ld_at_rax(RAX, 0);
			}
		}
	} else {
		ir_mov_acc_imm(0, n.pos);
	}
	if (any_defers()) {
		var wide bool = false;
		if (n.lhs as i64 != 0 && is_aggregate(n.lhs.ty)) {
			wide = n.lhs.ty.size > 8 && n.lhs.ty.size <= 16;
		}
		push_reg(RAX);
		if (wide) { push_reg(RDX); }
		unwind_to(0);
		if (wide) { pop_reg(RDX); }
		pop_reg(RAX);
	}
	gen_epilogue(n.pos);
}

fn gen_for(n *Node) {
	// The init may be a chain (the for-in desugar hoists the collection
	// into a hidden variable before the index init).
	if (n.init as i64 != 0) {
		var si *Node = n.init;
		while (si as i64 != 0) { gen_stmt(si); si = si.next; }
	}

	var lp Loop;
	lp.prev = cur_loop;
	lp.depth = defer_depth;
	lp.cont = ir_new_label();
	lp.brk = ir_new_label();
	cur_loop = &lp;

	// The back edge is a backward branch: ir_label(top) records the loop
	// head's address, and the IR_BR to it at the bottom lowers straight to
	// jump_back. The cond-exit is a forward branch to lp.brk, patched when
	// ir_label(lp.brk) lands below the loop.
	var top i64 = ir_new_label();
	ir_label(top, n.pos);
	if (n.cond as i64 != 0) {
		branch_false(n.cond, lp.brk);
	}
	gen_stmt(n.body);

	// A `continue` lands here (before the step), a `break` below the loop.
	ir_label(lp.cont, n.pos);
	if (n.step as i64 != 0) { gen_expr(n.step); }
	ir_branch(CC_ALWAYS, top, n.pos);

	ir_label(lp.brk, n.pos);
	cur_loop = lp.prev;
}

struct LineRow;
struct LineRow { next *LineRow, addr i64, file int, line int, }

var lines_head *LineRow;
var lines_tail *LineRow;
var opt_debug bool = false;

// One row per statement start. Consecutive statements on the same line, and
// statements that emitted no code, collapse into the previous row.
fn line_mark(pos i64) {
	if (!opt_debug) { return; }
	var f int = diag_file_of(pos);
	var l int = diag_line_for(f, diag_offset_of(pos));
	if (lines_tail as i64 != 0) {
		if (lines_tail.file == f && lines_tail.line == l) { return; }
		if (lines_tail.addr == code.n) {
			lines_tail.file = f;
			lines_tail.line = l;
			return;
		}
	}
	var r *LineRow = arena_alloc(sizeof(LineRow), 8) as *LineRow;
	r.addr = code.n;
	r.file = f;
	r.line = l;
	if (lines_tail as i64 == 0) { lines_head = r; } else { lines_tail.next = r; }
	lines_tail = r;
}

fn gen_stmt(n *Node) {
	line_mark(n.pos);
	var k int = n.kind;

	if (k == ND_BLOCK) { gen_block(n); return; }
	if (k == ND_DEFER) {
		if (cur_defers as i64 == 0) { error_at(n.pos, "'defer' outside of a block"); }
		n.els = cur_defers.list;
		cur_defers.list = n;
		return;
	}
	if (k == ND_MATCH) { gen_match(n); return; }
	if (k == ND_EXPRSTMT) {
		if (n.lhs as i64 != 0) { gen_exprstmt(n.lhs); }
		return;
	}
	if (k == ND_RET) { gen_ret(n); return; }
	if (k == ND_IF) {
		var els i64 = ir_new_label();
		branch_false(n.cond, els);
		gen_stmt(n.then);
		if (n.els as i64 != 0) {
			var end i64 = ir_new_label();
			ir_branch(CC_ALWAYS, end, n.pos);
			ir_label(els, n.pos);
			gen_stmt(n.els);
			ir_label(end, n.pos);
		} else {
			ir_label(els, n.pos);
		}
		return;
	}
	if (k == ND_FOR) { gen_for(n); return; }
	if (k == ND_BREAK) {
		if (cur_loop as i64 == 0) { error_at(n.pos, "'break' outside of a loop"); }
		unwind_to(cur_loop.depth);
		ir_branch(CC_ALWAYS, cur_loop.brk, n.pos);
		return;
	}
	if (k == ND_CONT) {
		if (cur_loop as i64 == 0) { error_at(n.pos, "'continue' outside of a loop"); }
		unwind_to(cur_loop.depth);
		ir_branch(CC_ALWAYS, cur_loop.cont, n.pos);
		return;
	}
	gen_expr(n);
}

// Control cannot fall out of a block whose last statement returns, so the
// implicit "return 0" tail is dead.
fn always_returns(n *Node) bool {
	if (n as i64 == 0) { return false; }
	if (n.kind == ND_RET) { return true; }
	if (n.kind == ND_BLOCK) {
		var last *Node = 0 as *Node;
		var s *Node = n.body;
		while (s as i64 != 0) { last = s; s = s.next; }
		return always_returns(last);
	}
	if (n.kind == ND_IF) {
		return always_returns(n.then) && always_returns(n.els);
	}
	return false;
}

// Promoted locals live in callee-saved registers, so each function saves the
// ones it uses into reserved slots at the top of its own frame.
fn reg_used(f *Func, reg int) bool {
	if (reg < 12 && reg != 3) { return false; }
	var v *Var = f.locals;
	while (v as i64 != 0) {
		if (v.has_reg && v.reg == reg) { return true; }
		v = v.next;
	}
	return false;
}

fn saved_slot(f *Func, reg int) i64 {
	var k i64 = 0;
	var i int = 0;
	while (i < RA_NSAVED) {
		var r int = ra_saved(i);
		if (reg_used(f, r)) {
			k = k + 1;
			if (r == reg) { return k * 8; }
		}
		i = i + 1;
	}
	return 0;
}

var gen_frameless bool;

// Emits one asm operand chain: bytes (a value wider than a byte is a byte
// string in hex, most significant byte first -- the order a disassembler
// prints) or a symbol slot: `$name` absolute, `$rel name` relative.
fn gen_asm_operands(a *Node) {
	while (a as i64 != 0) {
		if (a.kind == ND_ASMREF) {
			if (a.val != 0) { add_callref(a.name, a.pos); }
			else { add_absref(a.name, a.pos); }
		} else {
			var v i64 = a.val;
			var n i64 = 1;
			var t i64 = v;
			while (t > 255) { n = n + 1; t = t >> 8; }
			var s i64 = (n - 1) * 8;
			while (s >= 0) {
				b1(((v >> s) & 255) as u8);
				s = s - 8;
			}
		}
		a = a.next;
	}
}

fn gen_epilogue(pos i64) {
	gen_restore();
	// An exported extern function returns a float in xmm0 (SysV), where the
	// body left it in rax.
	if (gen_fn.extern && gen_fn.ret as i64 != 0 && is_float(gen_fn.ret)) {
		gpr_to_xmm(0, RAX, gen_fn.ret.size);
	}
	if (!gen_frameless) { b1(0xc9); }
	ir_ret(pos);
}

fn gen_restore() {
	var i int = 0;
	while (i < RA_NSAVED) {
		var r int = ra_saved(i);
		if (reg_used(gen_fn, r)) { ld_local(r, saved_slot(gen_fn, r)); }
		i = i + 1;
	}
}

// A C caller passes an exported extern function's arguments the SysV way:
// the non-float words packed into the integer registers on their own count,
// the floats in xmm registers on theirs. Qela reads each parameter from a
// fixed word position, so the incoming integer registers are staged on the
// stack first -- loading a parameter into its home (register or frame slot)
// could otherwise clobber an argument register a later parameter is still
// sitting in. The xmm registers are never written, so the floats just wait.
fn gen_extern_params(f *Func) {
	var nreg int = 0;
	if (f.ret_slot as i64 != 0) { nreg = nreg + 1; }
	var i int = 0;
	while (i < f.nparams) {
		var v *Var = func_param(f, i);
		if (v.arg_stack) { i = i + 1; continue; }
		if (is_float(v.ty)) { i = i + 1; continue; }
		if (is_aggregate(v.ty) && !v.by_ref && v.ty.size > 8) { nreg = nreg + 2; }
		else { nreg = nreg + 1; }
		i = i + 1;
	}
	var k int = nreg - 1;
	while (k >= 0) { push_reg(call_reg(k)); k = k - 1; }

	if (f.ret_slot as i64 != 0) {
		pop_reg(RAX);
		st_local(f.ret_slot.offset as i64, RAX);
	}
	var xi int = 0;
	i = 0;
	while (i < f.nparams) {
		var v *Var = func_param(f, i);
		if (v.arg_stack) { i = i + 1; continue; }
		if (is_float(v.ty)) {
			xmm_to_gpr(RAX, xi, v.ty.size);
			xi = xi + 1;
			if (v.has_reg) { mov_reg_reg(v.reg, RAX); }
			else { st_local(v.offset as i64, RAX); }
		} else if (is_aggregate(v.ty) && !v.by_ref && v.ty.size > 8) {
			pop_reg(RAX);
			pop_reg(RDX);
			if (v.has_reg) { mov_reg_reg(v.reg, RAX); }
			else { st_local(v.offset as i64, RAX); }
			st_local((v.offset as i64) - 8, RDX);
		} else {
			pop_reg(RAX);
			if (v.has_reg) { mov_reg_reg(v.reg, RAX); }
			else { st_local(v.offset as i64, RAX); }
		}
		i = i + 1;
	}
}

fn gen_func(f *Func) {
	// An extern declaration has no body; the symbol comes from the linker
	// (only valid under -c, which skips this whole path).
	if (f.body as i64 == 0) { return; }
	f.addr = code.n;
	line_mark(f.pos);
	depth = 0;
	gen_fn = f;
	cur_loop = 0 as *Loop;
	cur_defers = 0 as *DeferScope;
	defer_depth = 0;
	// Label ids restart for every function so an IR_BR from one function can
	// never reference another's IR_LABEL; the chain lists re-grow from empty.
	ir_label_n = 0;
	ir_label_br.n = 0;
	ir_br_next.n = 0;
	ir_label_pos.n = 0;

	// A leaf function with nothing in its frame needs no frame: every local it
	// has is in a register and nothing below rsp is ever addressed.
	// A stack-passed parameter's addressing depends on rbp actually being
	// this frame's own base (rbp+8 = return address, rbp+16 = the first
	// spilled param) -- never drop the frame just because the function
	// otherwise looks callable frameless.
	// A naked function has no frame by definition, and its body ends with
	// its own ret or iretq: nothing may be emitted before or after it.
	gen_frameless = f.naked || (f.leaf && f.stack_size == 0 && f.n_stack_args == 0);
	if (!gen_frameless) {
		push_reg(RBP);
		depth = depth - 1;
		mov_reg_reg(RBP, RSP);
		if (f.stack_size != 0) {
			alu_rax_imm_reg(5, RSP, f.stack_size as i64);
		}
	}

	if (!f.naked) {
		var si int = 0;
		while (si < RA_NSAVED) {
			var sr int = ra_saved(si);
			if (reg_used(f, sr)) { st_local(saved_slot(f, sr), sr); }
			si = si + 1;
		}

		var ri int = 0;
		if (f.extern) {
			gen_extern_params(f);
		} else {
			if (f.ret_slot as i64 != 0) {
				st_local(f.ret_slot.offset as i64, call_reg(ri));
				ri = ri + 1;
			}
			var i int = 0;
			while (i < f.nparams) {
				var v *Var = func_param(f, i);
				if (v.arg_stack) {
					// Already sitting at the right rbp-relative offset from the
					// caller's pushes -- nothing to move, and ri must not advance.
					i = i + 1;
					continue;
				}
				if (v.has_reg) { mov_reg_reg(v.reg, call_reg(ri)); }
				else { st_local(v.offset as i64, call_reg(ri)); }
				ri = ri + 1;
				if (is_aggregate(v.ty) && !v.by_ref && v.ty.size > 8) {
					st_local((v.offset as i64) - 8, call_reg(ri));
					ri = ri + 1;
				}
				i = i + 1;
			}
		}
	}

	fn_bounds.n = 0;
	gen_stmt(f.body);

	if (!f.naked && !always_returns(f.body)) {
		mov_reg_imm(RAX, 0);
		gen_epilogue(f.pos);
	}
	gen_bounds_trampoline();
}

// f64 bit pattern -> f32 bit pattern, in pure integer math: the bootstrap
// subset has no float, so this must never use one. Truncating, not
// round-to-nearest. Subnormal doubles are below the f32 range anyway, so
// they underflow to zero here.
fn f64_to_f32_bits(b i64) i64 {
	var sign i64 = (b >> 63) & 1;
	var exp i64 = (b >> 52) & 0x7ff;
	var man i64 = b & 0xfffffffffffff;
	if (exp == 0x7ff) {
		if (man == 0) { return (sign << 31) | 0x7f800000; }
		return (sign << 31) | 0x7fc00000;
	}
	if (exp == 0) { return sign << 31; }
	var e32 i64 = exp - 1023 + 127;
	if (e32 <= 0) { return sign << 31; }
	if (e32 >= 255) { return (sign << 31) | 0x7f800000; }
	return (sign << 31) | (e32 << 23) | ((man >> 29) & 0x7fffff);
}

// tvar bytes never live in .data/.bss: they're a template copied into a
// fresh mmap'd block per thread. Offset 0 is reserved for the self-pointer
// tls_init writes at runtime; real tvars start at 8.
fn layout_tls(globals *Var) {
	var any bool = false;
	var v0 *Var = globals;
	while (v0 as i64 != 0) {
		if (v0.is_tls) { any = true; }
		v0 = v0.next;
	}
	// A program with no tvar at all must cost nothing: no template bytes
	// in the data segment, no second LOAD segment for the RW section to
	// need at all (that's a whole extra program header, 56 bytes, for
	// zero benefit). tls_block_size stays at its default 8 and tls_init
	// is never emitted -- see the tls_block_size > 8 check in emit_code.
	if (!any) { return; }

	var tmpl Buf;
	buf_u64(&tmpl, 0);
	var v *Var = globals;
	while (v as i64 != 0) {
		if (v.is_tls) {
			var align i64 = v.ty.align as i64;
			var off i64 = (tmpl.n + align - 1) & ~(align - 1);
			while (tmpl.n < off) { buf_u8(&tmpl, 0); }
			v.tls_off = tmpl.n;
			var i int = 0;
			while (i < v.ty.size) {
				buf_u8(&tmpl, ((v.init >> (i * 8)) & 255) as u8);
				i = i + 1;
			}
		}
		v = v.next;
	}
	while ((tmpl.n & 7) != 0) { buf_u8(&tmpl, 0); }
	tls_block_size = tmpl.n;
	var align8 i64 = (gdata.n + 7) & ~7;
	while (gdata.n < align8) { buf_u8(&gdata, 0); }
	tls_template_off = gdata.n;
	buf_bytes(&gdata, tmpl.p, tmpl.n);
}

fn layout_globals(globals *Var) {
	layout_tls(globals);
	var v *Var = globals;
	while (v as i64 != 0) {
		if (v.is_tls) { v = v.next; continue; }
		if (v.init != 0) {
			// A float literal stores f64 bits; an f32 slot is 4 bytes, so
			// the bits must be narrowed here or the low half (zero for any
			// double with an exponent above 0x3ff) lands in the slot.
			if (v.ty.kind == TY_FLOAT && v.ty.size == 4) {
				v.init = f64_to_f32_bits(v.init);
			}
			var align i64 = v.ty.align as i64;
			var off i64 = (gdata.n + align - 1) & ~(align - 1);
			while (gdata.n < off) { buf_u8(&gdata, 0); }
			v.data_off = gdata.n;
			var i int = 0;
			while (i < v.ty.size) {
				buf_u8(&gdata, ((v.init >> (i * 8)) & 255) as u8);
				i = i + 1;
			}
		}
		v = v.next;
	}
	var bss i64 = gdata.n;
	v = globals;
	while (v as i64 != 0) {
		if (!v.is_tls && v.init == 0 && !(v.extern && !v.has_init)) {
			// An imported extern is allocated by the C side; it must not
			// take a .bss slot here.
			var align i64 = v.ty.align as i64;
			bss = (bss + align - 1) & ~(align - 1);
			v.data_off = bss;
			bss = bss + (v.ty.size as i64);
		}
		v = v.next;
	}
	bss_size = bss - gdata.n;
}

// The message pointer points at the string bytes, not at the {ptr, len}
// header add_strref would hand out, so these carry their own fixup list,
// patched with bytes_off after layout. With backtraces on, the stub jumps
// to the walker instead of exiting, so the caller of the trampoline call
// below is still on the stack when the walker reads it.
fn gen_panic_stub(msg_id int, msg_len i64) {
	if (opt_object) {
		// The message bytes get a `.Lstrd<id>` symbol; a RIP-relative lea
		// with a PC32 reloc survives PIE (an absolute slot would be TEXTREL).
		rip_ref(0x8d, RSI);
		var at i64 = code.n;
		b4(0);
		var nb Buf;
		fmt_str(&nb, ".Lstrd");
		fmt_i64(&nb, msg_id as i64);
		push_reloc(at, buf_str(&nb), REL_PCREL32);
	} else {
		b1(0xbe);
		ilist_push(&panic_msg_at, code.n);
		ilist_push(&panic_msg_ids, msg_id as i64);
		b4(0);
	}
	mov_reg_imm(RAX, 1);
	mov_reg_imm(RDI, 2);
	mov_reg_imm(RDX, msg_len);
	b1(0x0f); b1(0x05);
	if (opt_backtrace) {
		b1(0xe9);
		ilist_push(&bt_jmps, code.n);
		b4(0);
	} else {
		mov_reg_imm(RAX, 231);   // exit_group: a crash kills every thread, not just this one
		mov_reg_imm(RDI, 134);
		b1(0x0f); b1(0x05);
	}
}

fn reset_code() {
	code.n = 0;
	br_n = 0;
	br_at.n = 0;
	br_grew = false;
	bounds_checks.n = 0;
	assert_sites.n = 0;
	assert_msgs.n = 0;
	panic_msg_at.n = 0;
	panic_msg_ids.n = 0;
	bt_base_refs.n = 0;
	bt_jmps.n = 0;
	coro_switch_refs.n = 0;
	coro_switch_at = -1;
	coro_stub_refs.n = 0;
	coro_stub_at = -1;
	gc_base_refs.n = 0;
	gc_end_refs.n = 0;
	tls_init_refs.n = 0;
	tls_stub_at = -1;
	tls_stub_src_at = -1;
	calls_head = 0 as *CallFixup;
	calls_tail = 0 as *CallFixup;
	asmrefs_head = 0 as *CallFixup;
	asmrefs_tail = 0 as *CallFixup;
	strrefs_head = 0 as *StrFixup;
	strrefs_tail = 0 as *StrFixup;
	datarefs_head = 0 as *DataFixup;
	datarefs_tail = 0 as *DataFixup;
	funcaddrs_head = 0 as *CallFixup;
	funcaddrs_tail = 0 as *CallFixup;
	relocs_head = 0 as *Reloc;
	relocs_tail = 0 as *Reloc;
	rodata_relocs_head = 0 as *Reloc;
	rodata_relocs_tail = 0 as *Reloc;
	lines_head = 0 as *LineRow;
	lines_tail = 0 as *LineRow;
}

fn emit_code(u *Unit, main_fn *Func, panic_id int, hdr i64) {
	// Top-level asm blocks are the image's first bytes; `entry name;`
	// suppresses the default stub too, so the entry function (usually
	// naked) does its own setup and its own exit.
	if (top_asm_head as i64 == 0 && entry_name.len == 0) {
		// rbp is not guaranteed zero at process entry; the backtrace
		// walker needs a sentinel main returns into.
		if (opt_backtrace) {
			b1(0x48); b1(0x31); b1(0xed);     // xor rbp, rbp
		}
		if (tls_block_size > 8) {
			// Runs before argc/argv load into rdi/rsi below -- it clobbers
			// plenty of registers and nothing needs those yet.
			b1(0xe8);
			ilist_push(&tls_init_refs, code.n);
			b4(0);
		}
		if (main_fn as i64 != 0 && main_fn.nparams == 2) {
			b1(0x48); b1(0x8b); b1(0x3c); b1(0x24);
			b1(0x48); b1(0x8d); b1(0x74); b1(0x24); b1(8);
		}

		add_call("main", 0);
		b1(0x89);
		modrm(3, RAX, RDI);
		mov_reg_imm(RAX, 231);   // exit_group: authoritative over any worker threads still running
		b1(0x0f); b1(0x05);
	} else if (top_asm_head as i64 != 0) {
		gen_asm_operands(top_asm_head);
	}

	var f *Func = u.funcs;
	while (f as i64 != 0) {
		if (f.nct == 0) { gen_func(f); }
		f = f.next;
	}

	if (bounds_checks.n != 0) {
		var panic_addr i64 = code.n;
		gen_panic_stub(panic_id, 20);
		var i i64 = 0;
		while (i < bounds_checks.n) {
			buf_patch32(&code, bounds_checks.p[i], panic_addr - (bounds_checks.p[i] + 4));
			i = i + 1;
		}
	}

	// One stub per distinct assert message, patched at every site that uses
	// it. The message length is looked up here, at emit time.
	if (assert_sites.n != 0) {
		var ai i64 = 0;
		while (ai < assert_sites.n) {
			var msg i64 = assert_msgs.p[ai];
			var dup bool = false;
			var bi i64 = 0;
			while (bi < ai) {
				if (assert_msgs.p[bi] == msg) { dup = true; }
				bi = bi + 1;
			}
			if (!dup) {
				var len i64 = 0;
				var ls *StrLit = u.strs;
				while (ls as i64 != 0) {
					if (ls.id == (msg as int)) { len = ls.s.len; }
					ls = ls.next;
				}
				var sa i64 = code.n;
				gen_panic_stub(msg as int, len);
				var ci i64 = 0;
				while (ci < assert_sites.n) {
					if (assert_msgs.p[ci] == msg) {
						buf_patch32(&code, assert_sites.p[ci], sa - (assert_sites.p[ci] + 4));
					}
					ci = ci + 1;
				}
			}
			ai = ai + 1;
		}
	}

	if (opt_backtrace && (bounds_checks.n != 0 || assert_sites.n != 0)) {
		var wa i64 = code.n;
		gen_bt_walker();
		var ji i64 = 0;
		while (ji < bt_jmps.n) {
			buf_patch32(&code, bt_jmps.p[ji], wa - (bt_jmps.p[ji] + 4));
			ji = ji + 1;
		}
	}

	if (coro_switch_refs.n != 0) {
		gen_coro_switch_stub();
		var wi i64 = 0;
		while (wi < coro_switch_refs.n) {
			var site i64 = coro_switch_refs.p[wi];
			buf_patch32(&code, site, coro_switch_at - (site + 4));
			wi = wi + 1;
		}
	}

	if (coro_stub_refs.n != 0) {
		gen_coro_stub();
		var si i64 = 0;
		while (si < coro_stub_refs.n) {
			var abs i64 = ELF_BASE + hdr + coro_stub_at;
			var kk i64 = 0;
			while (kk < 8) {
				code.p[coro_stub_refs.p[si] + kk] = ((abs >> (kk * 8)) & 255) as u8;
				kk = kk + 1;
			}
			si = si + 1;
		}
	}

	if (tls_init_refs.n != 0) {
		gen_tls_init_stub();
		var ti i64 = 0;
		while (ti < tls_init_refs.n) {
			var site i64 = tls_init_refs.p[ti];
			buf_patch32(&code, site, tls_stub_at - (site + 4));
			ti = ti + 1;
		}
	}

	// The data segment sits right after code and rodata, so the code has to
	// end on a word boundary or every global lands misaligned.
	while ((code.n & 7) != 0) { b1(0x90); }
}

fn codegen(u *Unit, img *Image) {
	gen_unit = u;
	var panic_id int = u.nstrs;
	if (opt_object) {
		// The object's panic stub references the message through a `.Lstrd`
		// symbol, so the bounds message has to be a real string in u.strs
		// (the exe path appends it as raw bytes after the pass loop instead).
		// Reserved here only in object mode: an exe without arrays carries no
		// panic machinery at all.
		panic_id = add_str("index out of bounds\n");
		u.strs = strlist_head;
		u.nstrs = nstrs;
	}
	var bytes_off *i64 = arena_alloc((u.nstrs as i64 + 1) * 8, 8) as *i64;
	str_off = arena_alloc((u.nstrs as i64 + 1) * 8, 8) as *i64;

	var s *StrLit = u.strs;
	while (s as i64 != 0) {
		bytes_off[s.id] = rodata.n;
		buf_bytes(&rodata, s.s.ptr, s.s.len);
		buf_u8(&rodata, 0);
		s = s.next;
	}
	while ((rodata.n & 7) != 0) { buf_u8(&rodata, 0); }

	s = u.strs;
	while (s as i64 != 0) {
		str_off[s.id] = rodata.n;
		buf_u64(&rodata, 0);
		buf_u64(&rodata, s.s.len);
		s = s.next;
	}

	layout_globals(u.globals);
	if (opt_object) {
		// `-c`: no entry, no panic stub, no gc roots. Code plus the
		// relocation list is all the object needs; the exe patching below
		// is skipped entirely.
		var pass int = 0;
		while (true) {
			reset_code();
			var f *Func = u.funcs;
			while (f as i64 != 0) {
				if (f.nct == 0 && f.body as i64 != 0) { gen_func(f); }
				f = f.next;
			}
			if (!br_grew || pass >= 8) { break; }
			pass = pass + 1;
		}
		// The bounds trampolines and the panic/assert stubs are appended
		// after the last pass (reset_code clears the lists per pass). Their
		// rel32 jumps are intra-image, patched the same way the exe path
		// does; the stub message pointers carry real relocations.
		if (bounds_checks.n != 0) {
			var panic_addr i64 = code.n;
			gen_panic_stub(panic_id, 20);
			var i i64 = 0;
			while (i < bounds_checks.n) {
				buf_patch32(&code, bounds_checks.p[i], panic_addr - (bounds_checks.p[i] + 4));
				i = i + 1;
			}
		}
		if (assert_sites.n != 0) {
			var ai i64 = 0;
			while (ai < assert_sites.n) {
				var msg i64 = assert_msgs.p[ai];
				var dup bool = false;
				var bi i64 = 0;
				while (bi < ai) {
					if (assert_msgs.p[bi] == msg) { dup = true; }
					bi = bi + 1;
				}
				if (!dup) {
					var len i64 = 0;
					var ls *StrLit = u.strs;
					while (ls as i64 != 0) {
						if (ls.id == (msg as int)) { len = ls.s.len; }
						ls = ls.next;
					}
					var sa i64 = code.n;
					gen_panic_stub(msg as int, len);
					var ci i64 = 0;
					while (ci < assert_sites.n) {
						if (assert_msgs.p[ci] == msg) {
							buf_patch32(&code, assert_sites.p[ci], sa - (assert_sites.p[ci] + 4));
						}
						ci = ci + 1;
					}
				}
				ai = ai + 1;
			}
		}
		img.code = code;
		img.rodata = rodata;
		img.data = gdata;
		img.bss_size = bss_size;
		img.nph = 1;
		img.funcs = u.funcs;
		img.globals = u.globals;
		img.strs = u.strs;
		img.nstrs = u.nstrs;
		img.str_off = str_off;
		img.bytes_off = bytes_off;
		img.relocs = relocs_head;
		// The string headers in .rodata carry their own relocation (the ptr
		// field points at the bytes), collected after the pass loop because
		// reset_code clears the relocation lists at every pass boundary.
		var sr *StrLit = u.strs;
		while (sr as i64 != 0) {
			var fr *Reloc = arena_alloc(sizeof(Reloc), 8) as *Reloc;
			fr.at = str_off[sr.id];
			fr.id = sr.id as i64;
			fr.kind = REL_ABS64;
			if (rodata_relocs_tail as i64 == 0) { rodata_relocs_head = fr; }
			else { rodata_relocs_tail.next = fr; }
			rodata_relocs_tail = fr;
			sr = sr.next;
		}
		img.rodata_relocs = rodata_relocs_head;
		return;
	}
	var nph int = 1;
	if (gdata.n + bss_size > 0) { nph = 2; }
	var hdr i64 = EHDR_SZ + PHDR_SZ * (nph as i64);

	var main_fn *Func = find_func("main");
	if (main_fn as i64 == 0 && top_asm_head as i64 == 0 && entry_name.len == 0) {
		die("error: no 'main' function");
	}
	if (main_fn as i64 != 0 && main_fn.nparams != 0 && main_fn.nparams != 2) {
		die("error: 'main' takes no parameters or (argc, argv)");
	}
	var pass int = 0;
	while (true) {
		reset_code();
		emit_code(u, main_fn, panic_id, hdr);
		if (!br_grew || pass >= 8) { break; }
		pass = pass + 1;
	}

	// The backtrace's function table: u64 count, then one {u32 delta from
	// ELF_BASE, u32 name_off} per function in source order, then the
	// NUL-terminated names. The walker resolves an address with a linear
	// scan, so the table is deliberately unsorted.
	var bt_table_off i64 = -1;
	if (opt_backtrace && (bounds_checks.n != 0 || assert_sites.n != 0)) {
		var cnt i64 = 0;
		var ft *Func = u.funcs;
		while (ft as i64 != 0) {
			if (ft.nct == 0) { cnt = cnt + 1; }
			ft = ft.next;
		}
		bt_table_off = rodata.n;
		buf_u64(&rodata, cnt);
		var entries_off i64 = rodata.n;
		var zi i64 = 0;
		while (zi < cnt) { buf_u64(&rodata, 0); zi = zi + 1; }
		var name_off i64 = 0;
		var ei i64 = 0;
		ft = u.funcs;
		while (ft as i64 != 0) {
			if (ft.nct == 0) {
				var eo i64 = entries_off + ei * 8;
				var delta i64 = hdr + ft.addr;
				var k3 i64 = 0;
				while (k3 < 4) {
					rodata.p[eo + k3] = ((delta >> (k3 * 8)) & 255) as u8;
					rodata.p[eo + 4 + k3] = ((name_off >> (k3 * 8)) & 255) as u8;
					k3 = k3 + 1;
				}
				buf_bytes(&rodata, ft.name.ptr, ft.name.len);
				buf_u8(&rodata, 0);
				name_off = name_off + ft.name.len + 1;
				ei = ei + 1;
			}
			ft = ft.next;
		}
	}

	// The bounds-check panic message goes here, after the pass loop, and
	// only when a bounds check actually exists: a program without arrays
	// carries no panic machinery at all. It has to stay inside the aligned
	// rodata, or the data segment (and every GC word read in it) would be
	// misaligned. The stub's length must match: 20.
	if (bounds_checks.n != 0) {
		var pmsg str = "index out of bounds\n";
		bytes_off[panic_id] = rodata.n;
		buf_bytes(&rodata, pmsg.ptr, pmsg.len);
	}
	while ((rodata.n & 7) != 0) { buf_u8(&rodata, 0); }

	var dbase i64 = ELF_BASE + SEG_GAP + hdr + code.n + rodata.n;
	patch_abs(&gc_base_refs, dbase);
	patch_abs(&gc_end_refs, dbase + gdata.n + bss_size);
	if (tls_stub_at != -1) {
		var tabs i64 = dbase + tls_template_off;
		var tkk i64 = 0;
		while (tkk < 8) {
			code.p[tls_stub_src_at + tkk] = ((tabs >> (tkk * 8)) & 255) as u8;
			tkk = tkk + 1;
		}
	}

	var af *CallFixup = funcaddrs_head;
	while (af as i64 != 0) {
		var at *Func = find_func(af.name);
		if (at as i64 == 0) {
			emsg("undefined function '"); emsg(af.name); emsg("'"); efail(af.pos);
		}
		if (at.body as i64 == 0) {
			emsg("extern '"); emsg(af.name);
			emsg("' is not linked (extern needs -c and the linker)"); efail(af.pos);
		}
		var abs2 i64 = ELF_BASE + hdr + at.addr;
		var j i64 = 0;
		while (j < 8) {
			code.p[af.at + j] = ((abs2 >> (j * 8)) & 255) as u8;
			j = j + 1;
		}
		af = af.next;
	}

	var cf *CallFixup = calls_head;
	while (cf as i64 != 0) {
		var target *Func = find_func(cf.name);
		if (target as i64 == 0) {
			emsg("undefined function '"); emsg(cf.name); emsg("'"); efail(cf.pos);
		}
		if (target.body as i64 == 0) {
			emsg("extern '"); emsg(cf.name);
			emsg("' is not linked (extern needs -c and the linker)"); efail(cf.pos);
		}
		buf_patch32(&code, cf.at, target.addr - (cf.at + 4));
		cf = cf.next;
	}

	var ar *CallFixup = asmrefs_head;
	while (ar as i64 != 0) {
		var afn *Func = find_func(ar.name);
		var aval i64 = 0;
		if (afn as i64 != 0) {
			aval = ELF_BASE + hdr + afn.addr;
		} else {
			var gv *Var = find_global(ar.name);
			if (gv as i64 == 0) {
				emsg("undefined symbol '"); emsg(ar.name); emsg("'"); efail(ar.pos);
			}
			aval = dbase + gv.data_off;
		}
		var j5 i64 = 0;
		while (j5 < 8) {
			code.p[ar.at + j5] = ((aval >> (j5 * 8)) & 255) as u8;
			j5 = j5 + 1;
		}
		ar = ar.next;
	}

	var sf *StrFixup = strrefs_head;
	while (sf as i64 != 0) {
		buf_patch32(&code, sf.at, ELF_BASE + hdr + code.n + str_off[sf.id]);
		sf = sf.next;
	}

	var rodata_vaddr i64 = ELF_BASE + hdr + code.n;
	var pm i64 = 0;
	while (pm < panic_msg_at.n) {
		buf_patch32(&code, panic_msg_at.p[pm], rodata_vaddr + bytes_off[panic_msg_ids.p[pm]]);
		pm = pm + 1;
	}
	if (bt_table_off >= 0) {
		var bi2 i64 = 0;
		while (bi2 < bt_base_refs.n) {
			buf_patch32(&code, bt_base_refs.p[bi2], rodata_vaddr + bt_table_off);
			bi2 = bi2 + 1;
		}
	}
	s = u.strs;
	while (s as i64 != 0) {
		var abs i64 = rodata_vaddr + bytes_off[s.id];
		var k i64 = 0;
		while (k < 8) {
			rodata.p[str_off[s.id] + k] = ((abs >> (k * 8)) & 255) as u8;
			k = k + 1;
		}
		s = s.next;
	}

	var df *DataFixup = datarefs_head;
	while (df as i64 != 0) {
		buf_patch32(&code, df.at, dbase + df.varp.data_off);
		df = df.next;
	}

	img.code = code;
	img.rodata = rodata;
	img.data = gdata;
	img.bss_size = bss_size;
	if (entry_name.len != 0) {
		var ef *Func = find_func(entry_name);
		if (ef as i64 == 0) {
			emsg("unknown entry function '"); emsg(entry_name); emsg("'"); efail(0);
		}
		img.entry = ef.addr;
	} else {
		img.entry = 0;
	}
	img.nph = nph;
}
