import "comp.qela";
import "type.qela";
import "diag.qela";
import "../std/fmt.qela";

// Monomorphized clones fold the same constants again; their warnings were
// already reported for the original body.
var opt_inst bool = false;

let OV_MAX = 9223372036854775807;

fn ovf_add(a i64, b i64) bool {
	if (b > 0 && a > OV_MAX - b) { return true; }
	if (b < 0 && a < -OV_MAX - 1 - b) { return true; }
	return false;
}

fn ovf_sub(a i64, b i64) bool {
	if (b < 0 && a > OV_MAX + b) { return true; }
	if (b > 0 && a < -OV_MAX - 1 + b) { return true; }
	return false;
}

fn ovf_mul(a i64, b i64) bool {
	if (a == 0 || b == 0) { return false; }
	if ((a == -1 && b == -OV_MAX - 1) || (b == -1 && a == -OV_MAX - 1)) { return true; }
	if (a > 0) {
		if (b > 0) { return a > OV_MAX / b; }
		return b < (-OV_MAX - 1) / a;
	}
	if (b > 0) { return a < (-OV_MAX - 1) / b; }
	return b < OV_MAX / a;
}

fn warn_ovf(pos i64) {
	if (opt_inst) { return; }
	warn_at(pos, "signed integer overflow in a constant expression");
}

fn ovf_unsigned(n *Node) bool {
	return n.lhs.ty as i64 != 0 && n.lhs.ty.is_unsigned;
}

fn trunc_val(v i64, t *Type) i64 {
	if (t.size == 1) {
		if (t.is_unsigned || t.kind == TY_BOOL) { return v & 0xff; }
		if ((v & 0x80) != 0) { return (v & 0xff) | 0xffffffffffffff00; }
		return v & 0xff;
	}
	if (t.size == 2) {
		if (t.is_unsigned) { return v & 0xffff; }
		if ((v & 0x8000) != 0) { return (v & 0xffff) | 0xffffffffffff0000; }
		return v & 0xffff;
	}
	if (t.size == 4) {
		if (t.is_unsigned) { return v & 0xffffffff; }
		if ((v & 0x80000000) != 0) { return (v & 0xffffffff) | 0xffffffff00000000; }
		return v & 0xffffffff;
	}
	return v;
}

fn const_fold(n *Node) {
	if (n.kind == ND_NUM || n.kind == ND_STRLIT || n.kind == ND_VAR || n.kind == ND_COMPTIME) { return; }

	if (n.kind == ND_CAST) {
		const_fold(n.lhs);
		if (n.lhs.kind == ND_NUM && n.lhs.ty as i64 != 0 &&
		    (is_float(n.ty) || is_float(n.lhs.ty))) {
			return;
		}
		if (n.lhs.kind == ND_NUM) {
			var v i64 = n.lhs.val;
			if (n.ty.kind == TY_BOOL) { n.val = (v != 0) as i64; }
			else { n.val = trunc_val(v, n.ty); }
			n.kind = ND_NUM;
		}
		return;
	}

	if (n.kind == ND_NEG) {
		const_fold(n.lhs);
		if (n.lhs.kind == ND_NUM) {
			if (n.lhs.ty as i64 != 0 && is_float(n.lhs.ty)) {
				var mask i64 = 0x8000000000000000;
				if (n.lhs.ty.size == 4) { mask = 0x80000000; }
				n.val = n.lhs.val ^ mask;
			} else {
				if (!ovf_unsigned(n) && n.lhs.val == -OV_MAX - 1) { warn_ovf(n.pos); }
				n.val = -n.lhs.val;
			}
			n.kind = ND_NUM;
		}
		return;
	}
	if (n.kind == ND_BITNOT) {
		const_fold(n.lhs);
		if (n.lhs.kind == ND_NUM) { n.val = ~n.lhs.val; n.kind = ND_NUM; }
		return;
	}
	if (n.kind == ND_NOT) {
		const_fold(n.lhs);
		if (n.lhs.kind == ND_NUM) { n.val = (n.lhs.val == 0) as i64; n.kind = ND_NUM; }
		return;
	}

	if (n.kind == ND_ADD || n.kind == ND_SUB || n.kind == ND_MUL || n.kind == ND_DIV ||
	    n.kind == ND_MOD || n.kind == ND_BITAND || n.kind == ND_BITOR || n.kind == ND_BITXOR ||
	    n.kind == ND_SHL || n.kind == ND_SHR || n.kind == ND_EQ || n.kind == ND_NE ||
	    n.kind == ND_LT || n.kind == ND_LE || n.kind == ND_AND || n.kind == ND_OR) {
		// A float's bits are not an integer: folding two float literals
		// through this integer arithmetic would corrupt them. Leave them
		// for codegen, which knows the real operation.
		if (n.lhs as i64 != 0 && n.lhs.ty as i64 != 0 && is_float(n.lhs.ty)) {
			const_fold(n.lhs);
			const_fold(n.rhs);
			return;
		}
		const_fold(n.lhs);
		// Short-circuit: once the left side decides an && or ||, the right
		// side never runs at runtime, so folding it would both be wrong and
		// (with a constant division by zero in it) reject valid programs.
		if (n.kind == ND_AND && n.lhs.kind == ND_NUM && n.lhs.val == 0) { n.val = 0; n.kind = ND_NUM; return; }
		if (n.kind == ND_OR && n.lhs.kind == ND_NUM && n.lhs.val != 0)  { n.val = 1; n.kind = ND_NUM; return; }
		const_fold(n.rhs);
		if (n.lhs.kind == ND_NUM && n.rhs.kind == ND_NUM) {
			var a i64 = n.lhs.val; var b i64 = n.rhs.val;
			if (n.kind == ND_ADD)    { if (!ovf_unsigned(n) && ovf_add(a, b)) { warn_ovf(n.pos); } n.val = a + b; }
			else if (n.kind == ND_SUB)    { if (!ovf_unsigned(n) && ovf_sub(a, b)) { warn_ovf(n.pos); } n.val = a - b; }
			else if (n.kind == ND_MUL)    { if (!ovf_unsigned(n) && ovf_mul(a, b)) { warn_ovf(n.pos); } n.val = a * b; }
			else if (n.kind == ND_DIV)    { if (b == 0) { error_at(n.pos, "division by zero in a constant expression"); } n.val = a / b; }
			else if (n.kind == ND_MOD)    { if (b == 0) { error_at(n.pos, "division by zero in a constant expression"); } n.val = a % b; }
			else if (n.kind == ND_BITAND) { n.val = a & b; }
			else if (n.kind == ND_BITOR)  { n.val = a | b; }
			else if (n.kind == ND_BITXOR) { n.val = a ^ b; }
			else if (n.kind == ND_SHL)    { n.val = a << b; }
			else if (n.kind == ND_SHR)    { n.val = a >> b; }
			else if (n.kind == ND_EQ)     { n.val = (a == b) as i64; }
			else if (n.kind == ND_NE)     { n.val = (a != b) as i64; }
			else if (n.kind == ND_LT)     { n.val = (a < b) as i64; }
			else if (n.kind == ND_LE)     { n.val = (a <= b) as i64; }
			else if (n.kind == ND_AND)    { n.val = ((a != 0) && (b != 0)) as i64; }
			else if (n.kind == ND_OR)     { n.val = ((a != 0) || (b != 0)) as i64; }
			n.kind = ND_NUM;
		}
		if (n.kind == ND_AND && n.rhs.kind == ND_NUM && n.rhs.val == 0) { n.val = 0; n.kind = ND_NUM; }
		if (n.kind == ND_OR && n.rhs.kind == ND_NUM && n.rhs.val != 0)  { n.val = 1; n.kind = ND_NUM; }
		return;
	}
}

fn fold_body(n *Node) {
	if (n as i64 == 0) { return; }
	const_fold(n);
	// A folded node is a literal now: its children were consumed (or, for
	// a short-circuited && / ||, never evaluated) and must not be visited.
	if (n.kind == ND_NUM) { return; }
	fold_body(n.lhs);
	fold_body(n.rhs);
	fold_body(n.cond);
	fold_body(n.then);
	fold_body(n.els);
	fold_body(n.init);
	fold_body(n.step);
	fold_body(n.body);
	var a *Node = n.args;
	while (a as i64 != 0) { fold_body(a); a = a.next; }
	fold_body(n.next);
}

fn opt_func(f *Func) {
	if (f.body as i64 == 0) { return; }
	opt_inst = f.instantiated;
	const_fold(f.body);
	fold_body(f.body);
}
