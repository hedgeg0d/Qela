import "comp.qela";
import "type.qela";
import "funcs.qela";

// A local whose address is never taken can live in a callee-saved register for
// its whole live range instead of a frame slot. Live ranges come from a linear
// walk of the AST in emission order. A loop stretches every range that touches
// it to the end of the loop, so a value carried across iterations stays live;
// a defer body stretches its ranges to the end of the function, because it is
// emitted out of order at every exit.

let RA_FOREVER = 0x7fffffffffffff;

// Callee-saved registers cost a save and a restore. A function that makes no
// calls pays nothing for r8-r11 (x86) / x16-x17 (ARM64), so those come first
// there. r10 and r11 are never argument registers; r8 and r9 are free only
// when this function's own parameters do not reach them, or the prologue
// would overwrite an incoming argument before reading it.
fn ra_free(i int) int {
	// t3..t6 (x28..x31): the t0/t1/t2 scratch set is off limits -- the
	// lowering's own memcpy/staging protocol pops into T1 and the
	// compare paths use T0, so a promoted local in those registers would
	// be silently overwritten (the swap-with-struct crash).
	if (opt_target == TARGET_RISCV64) { return 28 + i; }
	if (opt_target == TARGET_ARM64) {
		if (i == 0) { return X16; }
		return X17;
	}
	if (i == 0) { return R10; }
	if (i == 1) { return R11; }
	if (i == 2) { return R9; }
	return R8;
}

fn ra_argregs(f *Func) int {
	var ri int = 0;
	if (f.ret_slot as i64 != 0) { ri = ri + 1; }
	var i int = 0;
	while (i < f.nparams) {
		var v *Var = func_param(f, i);
		ri = ri + 1;
		if (is_aggregate(v.ty) && !v.by_ref && v.ty.size > 8) { ri = ri + 1; }
		i = i + 1;
	}
	return ri;
}

fn ra_nfree(f *Func) int {
	if (!f.leaf) { return 0; }
	if (opt_target == TARGET_RISCV64) { return 4; }
	if (opt_target == TARGET_ARM64) { return 2; }
	var nin int = ra_argregs(f);
	if (nin <= 4) { return 4; }
	if (nin <= 5) { return 3; }
	return 2;
}

fn ra_saved(i int) int {
	if (opt_target == TARGET_RISCV64) {
		if (i == 0) { return 9; }
		return 18 + i - 1;
	}
	if (opt_target == TARGET_ARM64) {
		return X19 + i;
	}
	if (i == 0) { return RBX; }
	if (i == 1) { return R12; }
	if (i == 2) { return R13; }
	if (i == 3) { return R14; }
	return R15;
}

fn ra_nsaved() int {
	if (opt_target == TARGET_ARM64 || opt_target == TARGET_RISCV64) { return 10; }
	return 5;
}

fn ra_nreg(f *Func) int {
	// The interpreter reads every local out of its frame slot, and a
	// promoted local has none.
	if (opt_interp) { return 0; }
	if (opt_target == TARGET_RISCV64) {
		// Promotion cost more than it saved on RV64C: every promoted local
		// in a non-leaf function pays a prologue/epilogue spill pair, and
		// those 8+ bytes dwarf the register win. Keep it off until the
		// frame save/restore pairs are 2-byte c.ldsp/c.sdsp.
		return 0;
	}
	return ra_nsaved() + ra_nfree(f);
}

fn ra_pool(f *Func, i int) int {
	var nf int = ra_nfree(f);
	if (i < nf) { return ra_free(i); }
	return ra_saved(i - nf);
}

var ra_pos i64;
var ra_loop int;
var ra_fn *Func;
var ra_calls bool;

fn ra_weight() i64 {
	var w i64 = 1;
	var i int = 0;
	while (i < ra_loop && i < 4) { w = w * 8; i = i + 1; }
	return w;
}

fn ra_use(v *Var) {
	if (v as i64 == 0) { return; }
	if (v.is_global) { return; }
	if (v.lo == 0) { v.lo = ra_pos; }
	if (ra_pos > v.hi) { v.hi = ra_pos; }
	v.uses = v.uses + ra_weight();
}

fn ra_deny(n *Node) {
	if (n as i64 == 0) { return; }
	if (n.kind == ND_VAR) { n.varp.no_reg = true; }
}

// Opaque bytes can clobber any register, so a function with any asm(...)
// anywhere in it keeps every local in its frame slot, not just the ones
// live across the asm point.
fn ra_deny_all() {
	var v *Var = ra_fn.locals;
	while (v as i64 != 0) {
		v.no_reg = true;
		v = v.next;
	}
}

fn ra_extend(from i64, to i64) {
	var v *Var = ra_fn.locals;
	while (v as i64 != 0) {
		if (v.hi > from && v.hi < to) { v.hi = to; }
		v = v.next;
	}
}

fn ra_list(n *Node) {
	var p *Node = n;
	while (p as i64 != 0) {
		ra_walk(p);
		p = p.next;
	}
}

fn ra_walk(n *Node) {
	if (n as i64 == 0) { return; }
	ra_pos = ra_pos + 1;
	var k int = n.kind;

	// Temporaries are always addressed through the frame.
	if (n.tmp as i64 != 0) { n.tmp.no_reg = true; }

	// The panic path never returns, but the register file is clobbered across
	// the stub call just the same, so an asserting function is not a leaf.
	if (k == ND_CALL || k == ND_SYSCALL || k == ND_ASM || k == ND_ASSERT) { ra_calls = true; }
	// A call through a function-typed variable reads the variable itself.
	if (k == ND_CALL && n.varp as i64 != 0) { ra_use(n.varp); }
	if (k == ND_ASM) { ra_deny_all(); return; }
	if (k == ND_VAR || k == ND_ZERO) { ra_use(n.varp); return; }
	if (k == ND_ADDR) { ra_deny(n.lhs); ra_walk(n.lhs); return; }
	if (k == ND_MATCH) {
		ra_deny(n.cond);
		ra_walk(n.cond);
		var arm *Node = n.body;
		while (arm as i64 != 0) {
			ra_pos = ra_pos + 1;
			var b *Node = arm.args;
			while (b as i64 != 0) {
				ra_deny(b);
				ra_use(b.varp);
				b = b.next;
			}
			ra_walk(arm.body);
			arm = arm.next;
		}
		return;
	}
	if (k == ND_FOR) {
		ra_walk(n.init);
		var top i64 = ra_pos;
		ra_loop = ra_loop + 1;
		ra_walk(n.cond);
		ra_walk(n.body);
		ra_walk(n.step);
		ra_loop = ra_loop - 1;
		ra_extend(top, ra_pos);
		return;
	}
	if (k == ND_DEFER) {
		var top i64 = ra_pos;
		ra_walk(n.lhs);
		ra_extend(top, RA_FOREVER);
		return;
	}

	ra_walk(n.lhs);
	ra_walk(n.rhs);
	ra_walk(n.cond);
	ra_walk(n.init);
	ra_walk(n.step);
	ra_walk(n.then);
	ra_walk(n.els);
	ra_list(n.body);
	ra_list(n.args);
}

fn ra_eligible(v *Var) bool {
	if (v.no_reg || v.is_global || v.by_ref) { return false; }
	if (v.uses == 0) { return false; }
	if (is_aggregate(v.ty)) { return false; }
	return v.ty.size == 8;
}

// Vars are taken most-used first rather than in range order: a register spent
// on a loop variable buys more than one spent on a long-lived cold value.
fn ra_pick(reg int) bool {
	var best *Var = 0 as *Var;
	var v *Var = ra_fn.locals;
	while (v as i64 != 0) {
		if (!v.has_reg && ra_eligible(v)) {
			var ok bool = true;
			var o *Var = ra_fn.locals;
			while (o as i64 != 0) {
				if (o.has_reg && o.reg == reg && o.lo <= v.hi && v.lo <= o.hi) {
					ok = false;
				}
				o = o.next;
			}
			if (ok && (best as i64 == 0 || v.uses > best.uses)) { best = v; }
		}
		v = v.next;
	}
	if (best as i64 == 0) { return false; }
	best.has_reg = true;
	best.reg = reg;
	return true;
}

fn regalloc(f *Func) {
	if (f.body as i64 == 0) { return; }
	ra_fn = f;
	ra_pos = 0;
	ra_loop = 0;
	ra_calls = false;
	f.leaf = false;
	if (f.ret_slot as i64 != 0) { f.ret_slot.no_reg = true; }

	var i int = 0;
	while (i < f.nparams) {
		ra_pos = ra_pos + 1;
		ra_use(func_param(f, i));
		i = i + 1;
	}
	ra_walk(f.body);
	f.leaf = !ra_calls;

	var n int = ra_nreg(f);
	i = 0;
	while (i < n) {
		while (ra_pick(ra_pool(f, i))) { }
		i = i + 1;
	}

	f.nsaved = 0;
	i = 0;
	while (i < ra_nsaved()) {
		var used bool = false;
		var v *Var = f.locals;
		while (v as i64 != 0) {
			if (v.has_reg && v.reg == ra_saved(i)) { used = true; }
			v = v.next;
		}
		if (used) { f.nsaved = f.nsaved + 1; }
		i = i + 1;
	}
}

// Reads are tracked separately from regalloc's `uses` because `uses`
// counts writes too (for register promotion). The unused warning
// wants only reads: a variable that is only written and never read is
// dead. This pass walks the body once, incrementing `reads` for every
// ND_VAR / ND_DEREF / ND_ADDR / ND_INDEX where the underlying Var is
// being observed, and leaves writes alone. Same shape as ra_walk so
// the path coverage matches the regalloc pass.
fn count_reads(f *Func) {
	if (f as i64 == 0) { return; }
	// An interpreted/dynamic function's real body is what codegen never
	// compiles: count reads there too, or every local it uses warns
	// unused. The synthetic body still needs its own pass for its hidden
	// variables.
	if (f.interp_body as i64 != 0) {
		reads_list(f.interp_body);
		reads_list(f.body);
		return;
	}
	reads_list(f.body);
}

fn reads_walk(n *Node) {
	if (n as i64 == 0) { return; }
	var k int = n.kind;
	if (k == ND_VAR) {
		if (n.varp as i64 != 0) { n.varp.reads = n.varp.reads + 1; }
		// No children to walk for a bare var ref.
		return;
	}
	// A call through a function-typed variable reads the variable itself.
	if (k == ND_CALL && n.varp as i64 != 0) { n.varp.reads = n.varp.reads + 1; }
	if (k == ND_MATCH) {
		reads_walk(n.cond);
		var arm *Node = n.body;
		while (arm as i64 != 0) {
			reads_list(arm.body);
			arm = arm.next;
		}
		return;
	}
	// A plain `x = ...;` does not read x -- only compound targets
	// (a[i] = .., p.f = .., *p = ..) still need their lhs walked, since
	// that reads the base/index, not the assigned-to storage itself.
	if (k == ND_ASSIGN && n.lhs as i64 != 0 && n.lhs.kind == ND_VAR) {
		reads_walk(n.rhs);
		return;
	}
	// Default: walk all children. n.body is a statement list chained
	// via .next (same shape ra_list expects), not a single node -- a
	// bare reads_walk(n.body) here only ever saw the block's first
	// statement.
	reads_walk(n.lhs);
	reads_walk(n.rhs);
	reads_walk(n.cond);
	reads_walk(n.init);
	reads_walk(n.step);
	reads_walk(n.then);
	reads_walk(n.els);
	reads_list(n.body);
	reads_list(n.args);
}

fn reads_list(n *Node) {
	while (n as i64 != 0) {
		reads_walk(n);
		n = n.next;
	}
}

// Walks every local in the function and warns on the ones that have
// zero reads. Globals are skipped: a top-level `var g int;` that no
// function reads is rarely worth pointing out (often it's set up for
// init-time use). Parameters are flagged only when the function body
// has any locals at all, so a function written `fn f(x int) int { return 0; }`
// stays quiet.
fn warn_unused(f *Func) {
	if (f as i64 == 0) { return; }
	// An extern declaration has no body, so its parameters can never be
	// read; the symbol is a promise to the linker, not code.
	if (f.body as i64 == 0) { return; }
	var nl_unused int = 0;
	var np_unused int = 0;
	var v *Var = f.locals;
	while (v as i64 != 0) {
		// Skip temps (no name) and globals. Both are valid patterns
		// that should not warn.
		if (v.reads == 0 && v.name.len > 0 && !v.is_global) { nl_unused = nl_unused + 1; }
		v = v.next;
	}
	if (f.p0 as i64 != 0 && f.p0.reads == 0) { np_unused = np_unused + 1; }
	if (f.p1 as i64 != 0 && f.p1.reads == 0) { np_unused = np_unused + 1; }
	if (f.p2 as i64 != 0 && f.p2.reads == 0) { np_unused = np_unused + 1; }
	if (f.p3 as i64 != 0 && f.p3.reads == 0) { np_unused = np_unused + 1; }
	if (f.p4 as i64 != 0 && f.p4.reads == 0) { np_unused = np_unused + 1; }
	if (f.p5 as i64 != 0 && f.p5.reads == 0) { np_unused = np_unused + 1; }
	if (f.p6 as i64 != 0 && f.p6.reads == 0) { np_unused = np_unused + 1; }
	if (f.p7 as i64 != 0 && f.p7.reads == 0) { np_unused = np_unused + 1; }
	var pe *Var = f.pextra;
	while (pe as i64 != 0) {
		if (pe.reads == 0) { np_unused = np_unused + 1; }
		pe = pe.pnext;
	}
	// Unused locals first — they are the headline category and
	// dominate the warning budget.
	v = f.locals;
	while (v as i64 != 0) {
		if (v.reads == 0 && v.name.len > 0 && !v.is_global) {
			warn_unused_one(v, "variable");
		}
		v = v.next;
	}
	// Unused params only when the function has at least one local. The
	// heuristic is rough but cheap: a function body with no locals and
	// an unused param is most often a stub.
	if (np_unused > 0 && nl_unused > 0) {
		if (f.p0 as i64 != 0 && f.p0.reads == 0) { warn_unused_one(f.p0, "parameter"); }
		if (f.p1 as i64 != 0 && f.p1.reads == 0) { warn_unused_one(f.p1, "parameter"); }
		if (f.p2 as i64 != 0 && f.p2.reads == 0) { warn_unused_one(f.p2, "parameter"); }
		if (f.p3 as i64 != 0 && f.p3.reads == 0) { warn_unused_one(f.p3, "parameter"); }
		if (f.p4 as i64 != 0 && f.p4.reads == 0) { warn_unused_one(f.p4, "parameter"); }
		if (f.p5 as i64 != 0 && f.p5.reads == 0) { warn_unused_one(f.p5, "parameter"); }
		if (f.p6 as i64 != 0 && f.p6.reads == 0) { warn_unused_one(f.p6, "parameter"); }
		if (f.p7 as i64 != 0 && f.p7.reads == 0) { warn_unused_one(f.p7, "parameter"); }
		pe = f.pextra;
		while (pe as i64 != 0) {
			if (pe.reads == 0) { warn_unused_one(pe, "parameter"); }
			pe = pe.pnext;
		}
	}
}

fn warn_unused_one(v *Var, kind str) {
	var b Buf;
	fmt_str(&b, "unused ");
	fmt_str(&b, kind);
	fmt_str(&b, " '");
	fmt_str(&b, v.name);
	fmt_str(&b, "'");
	warn_at(v.pos, buf_str(&b));
}
