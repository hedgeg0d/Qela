	if (i == 21) { return "import \"sys.qela\";\nimport \"coro.qela\";\nimport \"chan.qela\";\n\n// A fixed pool of OS threads, each running its own cooperative coroutine\n// scheduler -- goroutines multiplexed over real parallelism. go() round-\n// robins a spawn request onto one pool thread's queue; that thread's own\n// loop drains it into a local coro_spawn the next time it polls. Channels\n// (chan.qela) are the supported way to hand results back across threads.\n//\n// Work-stealing only covers requests that have not started running yet:\n// an idle thread with nothing of its own to drain tries its neighbors'\n// queues before spinning. A coroutine already coro_spawn'd is pinned to\n// its thread's tvar-scoped coros[] for good -- migrating a *running*\n// coroutine's stack/registers to another OS thread mid-flight is real\n// extra work (a safe migration point that isn't inside a lock or a GC\n// safepoint, plus re-homing it into the target's own coros[] slot) that\n// nothing here has needed yet; this is the cheap win, not that one.\n//\n// A pool thread never calls gc_thread_enter itself -- that would force\n// every user of thread.qela to also pull in gc.qela. A program that wants\n// its pool threads to be GC roots has to register them itself (e.g. by\n// wrapping the function passed to go() to call gc_thread_enter on first\n// entry to that thread, or by using a custom pool loop built the same way\n// this one is).\n\nlet POOL_MAX = 32;\nlet POOL_QUEUE = 64;\nlet POOL_STACK = 262144;\n\nstruct SpawnReq {\n\tfn_ptr i64,\n\ta0     i64,\n\ta1     i64,\n\ta2     i64,\n\ta3     i64,\n\ta4     i64,\n}\n\nvar pool_n i64 = 0;\nvar pool_next i64 = 0;\nvar pool_queue [32][64]SpawnReq;\nvar pool_head [32]i64;\nvar pool_tail [32]i64;\nvar pool_lock [32]i64;\n\n// Pops at most one entry per call, not the whole backlog: holding the\n// lock (or even just re-acquiring it back to back in a tight loop) across\n// every pending coro_spawn starves pool_steal's try-lock for as long as\n// this thread's own backlog lasts, which defeats stealing entirely\n// whenever a queue gets a real burst pushed onto it. pool_worker calls\n// this every iteration, so the backlog still drains, just interleaved\n// with give-someone-else-a-turn spacing instead of all at once.\nfn pool_drain(id i64) {\n\tif (pool_head[id] == pool_tail[id]) { return; }\n\tif (!atomic_cas(&pool_lock[id], 0, 1)) { return; }\n\tif (pool_head[id] == pool_tail[id]) {\n\t\tatomic_store(&pool_lock[id], 0);\n\t\treturn;\n\t}\n\tvar slot i64 = pool_head[id] % POOL_QUEUE;\n\tvar r SpawnReq = pool_queue[id][slot];\n\tpool_head[id] = pool_head[id] + 1;\n\tatomic_store(&pool_lock[id], 0);\n\tcoro_spawn(r.fn_ptr, r.a0, r.a1, r.a2, r.a3, r.a4);\n}\n\n// Tries every other pool thread's queue once, starting just past its own\n// id (so threads don't all pile onto neighbor 0 first). A try-lock, not a\n// blocking one: a busy victim is skipped rather than waited on, since the\n// whole point is to not stall while there might be idle work elsewhere.\nfn pool_steal(id i64) bool {\n\tvar i i64 = 1;\n\twhile (i < pool_n) {\n\t\tvar victim i64 = (id + i) % pool_n;\n\t\tif (pool_head[victim] != pool_tail[victim] && atomic_cas(&pool_lock[victim], 0, 1)) {\n\t\t\tif (pool_head[victim] != pool_tail[victim]) {\n\t\t\t\tvar slot i64 = pool_head[victim] % POOL_QUEUE;\n\t\t\t\tvar r SpawnReq = pool_queue[victim][slot];\n\t\t\t\tpool_head[victim] = pool_head[victim] + 1;\n\t\t\t\tatomic_store(&pool_lock[victim], 0);\n\t\t\t\tcoro_spawn(r.fn_ptr, r.a0, r.a1, r.a2, r.a3, r.a4);\n\t\t\t\treturn true;\n\t\t\t}\n\t\t\tatomic_store(&pool_lock[victim], 0);\n\t\t}\n\t\ti = i + 1;\n\t}\n\treturn false;\n}\n\n// Which pool thread the calling coroutine is actually running on right\n// now -- set once per thread, read by any coroutine scheduled on it.\ntvar pool_worker_id i64 = -1;\n\nfn pool_worker(id i64) i64 {\n\ttls_init();\n\tpool_worker_id = id;\n\twhile (true) {\n\t\tpool_drain(id);\n\t\tif (coro_pending()) {\n\t\t\tcoro_yield();\n\t\t} else if (!pool_steal(id)) {\n\t\t\tfence();\n\t\t\tsys_sched_yield();\n\t\t}\n\t}\n\treturn 0;\n}\n\n// Spawns n OS threads, each running its own coroutine scheduler. Call\n// once; there is no way to grow the pool afterward.\nfn thread_pool_init(n i64) {\n\t// The single-scheduler deadlock heuristic in chan.qela can't tell a\n\t// slow sibling thread from real deadlock; see chan_deadlock_check.\n\tchan_deadlock_check = false;\n\tif (n > POOL_MAX) { n = POOL_MAX; }\n\tvar i i64 = 0;\n\twhile (i < n) {\n\t\tpool_head[i] = 0;\n\t\tpool_tail[i] = 0;\n\t\tpool_lock[i] = 0;\n\t\tvar stack i64 = sys_mmap_anon(POOL_STACK);\n\t\tvar top i64 = (stack + POOL_STACK) & ~15;\n\t\tthread_clone(pool_worker, i, top, CLONE_THREAD_FLAGS);\n\t\ti = i + 1;\n\t}\n\tpool_n = n;\n}\n\n// Round-robins a goroutine onto one of the pool's threads. fn takes up to\n// five i64/pointer-sized arguments, the same convention coro_spawn uses.\nfn go(fn_ptr i64, a0 i64, a1 i64, a2 i64, a3 i64, a4 i64) {\n\tvar id i64 = atomic_add(&pool_next, 1) % pool_n;\n\twhile (!atomic_cas(&pool_lock[id], 0, 1)) { sys_sched_yield(); }\n\twhile (pool_tail[id] - pool_head[id] >= POOL_QUEUE) {\n\t\tatomic_store(&pool_lock[id], 0);\n\t\tfence();\n\t\tsys_sched_yield();\n\t\twhile (!atomic_cas(&pool_lock[id], 0, 1)) { sys_sched_yield(); }\n\t}\n\tvar slot i64 = pool_tail[id] % POOL_QUEUE;\n\tpool_queue[id][slot].fn_ptr = fn_ptr;\n\tpool_queue[id][slot].a0 = a0;\n\tpool_queue[id][slot].a1 = a1;\n\tpool_queue[id][slot].a2 = a2;\n\tpool_queue[id][slot].a3 = a3;\n\tpool_queue[id][slot].a4 = a4;\n\tpool_tail[id] = pool_tail[id] + 1;\n\tatomic_store(&pool_lock[id], 0);\n}\n"; }
	if (i == 22) { return "import \"arena.qela\";\n\n// A growable vector of any element type, on the arena. The slice view is\n// the bridge to the language's checked iteration and slicing:\n//\n//   var v Vec(i64);\n//   vec_init(&v);\n//   vec_push(&v, 7);\n//   for x in vec_view(&v) { ... }   // bounds-checked, like any []i64\n//\n// Elements are copied on push; the backing array doubles through the\n// arena and is never freed, so a vector's lifetime is the program's.\n\nstruct Vec(T) {\n\tdata *T,\n\tlen  i64,\n\tcap  i64,\n}\n\nfn vec_init(comptime T: type, v *Vec(T)) {\n\tv.data = 0 as *T;\n\tv.len = 0;\n\tv.cap = 0;\n}\n\nfn vec_push(comptime T: type, v *Vec(T), x T) {\n\tif (v.len >= v.cap) {\n\t\tvar cap i64 = v.cap;\n\t\tif (cap == 0) { cap = 8; }\n\t\twhile (cap < v.len + 1) { cap = cap * 2; }\n\t\tvar nd *T = arena_alloc(cap * sizeof(T), 8) as *T;\n\t\tvar i i64 = 0;\n\t\twhile (i < v.len) {\n\t\t\t*(nd + i) = *(v.data + i);\n\t\t\ti = i + 1;\n\t\t}\n\t\tv.data = nd;\n\t\tv.cap = cap;\n\t}\n\t*(v.data + v.len) = x;\n\tv.len = v.len + 1;\n}\n\n// Out of range reads return a zeroed element, like list_get.\nfn vec_get(comptime T: type, v *Vec(T), i i64) T {\n\tif (i < 0 || i >= v.len) {\n\t\tvar z T;\n\t\treturn z;\n\t}\n\treturn *(v.data + i);\n}\n\nfn vec_pop(comptime T: type, v *Vec(T)) T {\n\tif (v.len == 0) {\n\t\tvar z T;\n\t\treturn z;\n\t}\n\tv.len = v.len - 1;\n\treturn *(v.data + v.len);\n}\n\nfn vec_clear(comptime T: type, v *Vec(T)) {\n\tv.len = 0;\n}\n\n// The whole vector as a slice: checked indexing, slicing and for-in.\nfn vec_view(comptime T: type, v *Vec(T)) []T {\n\tvar s []T;\n\ts.ptr = v.data;\n\ts.len = v.len;\n\treturn s;\n}\n"; }
