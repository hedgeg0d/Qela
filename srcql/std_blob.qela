	if (i == 5) { return "import \"sys.qela\";\nimport \"arena.qela\";\n\n// Cooperative coroutines on their own stacks. Slot 0 is the main context,\n// so switching back to the program is the same operation as switching\n// between coroutines. coro_switch and coro_entry_addr are compiler\n// intrinsics: the first is the stack swap, the second is the address of\n// the trampoline a fresh coroutine returns into.\n\nlet CORO_STACK = 65536;\nlet CORO_SLOTS = 256;\n\nstruct Coro {\n\tsp    i64,\n\ttop   i64,\n\tdone  bool,\n\talive bool,\n}\n\n// Per-thread: two OS threads must never see or touch each other's\n// coroutines. A thread that spawns or runs coroutines has to have called\n// tls_init once already -- the main thread gets that for free from the\n// entry stub, any thread started through thread_clone has to call it\n// itself before touching any of this.\ntvar coros [256]Coro;\ntvar ncoros int = 0;\ntvar cur_coro int = 0;\n\n// arena_alloc is bump-pointer state shared by every thread (it stays out\n// of the bootstrap subset's reach, so it cannot use atomics itself -- see\n// std/arena.qela); this lock is the only thing standing between two\n// coroutines on two different OS threads getting overlapping stacks out\n// of the same bump pointer.\nvar coro_stack_lock i64 = 0;\n\nfn coro_alloc_stack() *u8 {\n\twhile (!atomic_cas(&coro_stack_lock, 0, 1)) { sys_sched_yield(); }\n\tvar p *u8 = arena_alloc(CORO_STACK, 16);\n\tatomic_store(&coro_stack_lock, 0);\n\treturn p;\n}\n\n// Under `qela irun` a coroutine cannot be a machine-stack image: there is\n// no machine code to park on one, and `target` is a *Func rather than an\n// address. INTERP is defined only by the interpreter, which owns the stack\n// switching and hands this module back the two operations it cannot do\n// itself. Everything else here -- the slot table, coro_next, the alive/done\n// bookkeeping -- is unchanged and stays interpreted, so std/chan.qela and\n// std/gc.qela keep reading the state they already read.\nfn coro_spawn(target i64, a0 i64, a1 i64, a2 i64, a3 i64, a4 i64) {\n\tif (ncoros + 1 >= CORO_SLOTS) { return; }\n\tncoros = ncoros + 1;\n\tvar id int = ncoros;\n\n\t$if (INTERP == \"1\") {\n\t\tinterp_coro_spawn(id, target, a0, a1, a2, a3, a4);\n\t\tcoros[id].sp = 0;\n\t\tcoros[id].top = 0;\n\t\tcoros[id].done = false;\n\t\tcoros[id].alive = true;\n\t\treturn;\n\t}\n\n\tvar stack *u8 = coro_alloc_stack();\n\tvar top i64 = ((stack as i64) + CORO_STACK) & ~15;\n\n\t// Eighteen words on arm64/riscv64: twelve callee-saved slots (the\n\t// first LDP pair populating x29/x30 with zero and the trampoline\n\t// address on arm64, so the switch stub's ret lands inside it; riscv\n\t// puts the trampoline in the ra slot, p[11]), five arguments and the\n\t// target. No padding word and no alignment fixup needed: top is\n\t// 16-aligned and 18*8 is a multiple of 16, so sp0 always comes out\n\t// 16-aligned already -- unlike x86, BL doesn't push a return address,\n\t// so there is no leftover 8-byte offset to compensate for (see\n\t// gen_coro_switch_stub_arm64/riscv in srcql/).\n\t$if (TARGET != \"x86_64\") {\n\t\tvar sp0 i64 = top - 18 * 8;\n\n\t\tvar p *i64 = sp0 as *i64;\n\t\tvar i i64 = 0;\n\t\twhile (i < 12) { p[i] = 0; i = i + 1; }\n\t\t$if (TARGET == \"arm64\") {\n\t\t\tp[1] = coro_entry_addr();\n\t\t} $else {\n\t\t\tp[11] = coro_entry_addr();\n\t\t}\n\t\tp[12] = a0;\n\t\tp[13] = a1;\n\t\tp[14] = a2;\n\t\tp[15] = a3;\n\t\tp[16] = a4;\n\t\tp[17] = target;\n\n\t\tcoros[id].sp = sp0;\n\t} $else {\n\t\t// Thirteen words: six callee-saved, the trampoline address, five\n\t\t// arguments and the target. Landing on sp % 16 == 8 leaves the target\n\t\t// with the alignment a call would have given it.\n\t\tvar sp0 i64 = top - 13 * 8;\n\t\tif ((sp0 & 15) != 8) { sp0 = sp0 - 8; }\n\n\t\tvar p *i64 = sp0 as *i64;\n\t\tvar i i64 = 0;\n\t\twhile (i < 6) { p[i] = 0; i = i + 1; }\n\t\tp[6] = coro_entry_addr();\n\t\tp[7] = a0;\n\t\tp[8] = a1;\n\t\tp[9] = a2;\n\t\tp[10] = a3;\n\t\tp[11] = a4;\n\t\tp[12] = target;\n\n\t\tcoros[id].sp = sp0;\n\t}\n\tcoros[id].top = top;\n\tcoros[id].done = false;\n\tcoros[id].alive = true;\n}\n\nfn coro_next(from int) int {\n\tvar i int = from + 1;\n\tvar n int = ncoros + 1;\n\tvar seen int = 0;\n\twhile (seen <= ncoros) {\n\t\tif (i > ncoros) { i = 0; }\n\t\tif (i == 0 || (coros[i].alive && !coros[i].done)) { return i; }\n\t\ti = i + 1;\n\t\tseen = seen + 1;\n\t}\n\treturn 0;\n}\n\nfn coro_pending() bool {\n\tvar i int = 1;\n\twhile (i <= ncoros) {\n\t\tif (coros[i].alive && !coros[i].done) { return true; }\n\t\ti = i + 1;\n\t}\n\treturn false;\n}\n\nfn coro_slots() int { return ncoros; }\n\n// How many coroutines could still run. A channel wait compares this against\n// the number of coroutines parked inside one.\nfn coro_live() int {\n\tvar n int = 0;\n\tvar i int = 1;\n\twhile (i <= ncoros) {\n\t\tif (coros[i].alive && !coros[i].done) { n = n + 1; }\n\t\ti = i + 1;\n\t}\n\treturn n;\n}\n\n// Returns false when nothing else could run, which lets a blocked channel\n// operation tell waiting apart from deadlock.\nfn coro_yield() bool {\n\tvar from int = cur_coro;\n\tvar to int = coro_next(from);\n\tif (to == from) { return false; }\n\tcur_coro = to;\n\t$if (INTERP == \"1\") {\n\t\tinterp_coro_switch(from, to);\n\t\treturn true;\n\t}\n\tcoro_switch(&coros[from].sp as *u8, &coros[to].sp as *u8);\n\treturn true;\n}\n\n// Runs on the finishing coroutine's stack and never returns: the switch\n// away from a done slot is one-way.\nfn coro_finish() {\n\tvar from int = cur_coro;\n\tcoros[from].done = true;\n\tvar to int = coro_next(from);\n\tcur_coro = to;\n\t$if (INTERP == \"1\") {\n\t\tinterp_coro_switch(from, to);\n\t\treturn;\n\t}\n\tcoro_switch(&coros[from].sp as *u8, &coros[to].sp as *u8);\n}\n\nfn coro_run_all() {\n\twhile (coro_pending()) { coro_yield(); }\n}\n"; }
	if (i == 6) { return "// Runtime support for `~` (opt-in dynamic typing). `DynVal` itself is not\n// declared here: the compiler registers it programmatically (type_dynval in\n// srcql/type.qela) before this file is spliced in, so every `~` site and\n// every call here agree on the exact same Type object.\nimport \"heap.qela\";\n\n// Boxes `size` bytes starting at `src` onto the heap and tags them `id`\n// (a compile-time-assigned integer identifying the source type). Always\n// boxes, even for a scalar: one path for every type keeps this small.\nfn dyn_box(id i64, src *u8, size i64) DynVal {\n\tvar d DynVal;\n\td.type_id = id;\n\tif (size <= 0) { d.ptr = 0 as *u8; return d; }\n\tvar p *u8 = heap_alloc(size);\n\tvar i i64 = 0;\n\twhile (i < size) {\n\t\t*(p + i) = *(src + i);\n\t\ti = i + 1;\n\t}\n\td.ptr = p;\n\treturn d;\n}\n\n// The runtime half of `n as T`: T's compile-time id is compared against the\n// value's tag, and a mismatch panics rather than silently reinterpreting\n// bytes. The caller derefs the returned pointer as T.\nfn dyn_check(d DynVal, id i64) *u8 {\n\tif (d.type_id != id) { panic(\"dynamic cast: type mismatch\"); }\n\treturn d.ptr;\n}\n"; }
