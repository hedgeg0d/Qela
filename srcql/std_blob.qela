	if (i == 6) { return "import \"sys.qela\";\nimport \"buf.qela\";\nimport \"str.qela\";\n\nlet IO_CHUNK = 65536;\n\nfn die(msg str) {\n\teprint(msg);\n\teprint(\"\\n\");\n\tsys_exit(1);\n}\n\nfn file_exists(path str) bool {\n\tvar fd i64 = sys_open_read(cstr(path));\n\tif (fd < 0) { return false; }\n\tsys_close(fd);\n\treturn true;\n}\n\nfn read_file(path str) str {\n\tvar fd i64 = sys_open_read(cstr(path));\n\tif (fd < 0) {\n\t\teprint(\"error: cannot open \");\n\t\teprint(path);\n\t\teprint(\"\\n\");\n\t\tsys_exit(1);\n\t}\n\tvar b Buf;\n\tvar got i64 = 1;\n\twhile (got > 0) {\n\t\tbuf_grow(&b, IO_CHUNK);\n\t\tgot = sys_read(fd, b.p + b.n, IO_CHUNK);\n\t\tif (got > 0) { b.n = b.n + got; }\n\t}\n\tsys_close(fd);\n\treturn buf_str(&b);\n}\n\nfn read_stdin() str {\n\tvar b Buf;\n\tvar got i64 = 1;\n\twhile (got > 0) {\n\t\tbuf_grow(&b, IO_CHUNK);\n\t\tgot = sys_read(0, b.p + b.n, IO_CHUNK);\n\t\tif (got > 0) { b.n = b.n + got; }\n\t}\n\treturn buf_str(&b);\n}\n\n// One line, newline included; \"\" only at end of input. An empty line\n// returns \"\\n\", so a caller can tell the two apart.\nfn read_line() str {\n\tvar b Buf;\n\tvar c u8 = 0;\n\twhile (true) {\n\t\tvar got i64 = sys_read(0, &c, 1);\n\t\tif (got <= 0) { break; }\n\t\tbuf_u8(&b, c);\n\t\tif (c == '\\n') { break; }\n\t}\n\treturn buf_str(&b);\n}\n\nfn write_file(path str, data *u8, n i64) {\n\tvar fd i64 = sys_open_exec(cstr(path));\n\tif (fd < 0) {\n\t\teprint(\"error: cannot write \");\n\t\teprint(path);\n\t\teprint(\"\\n\");\n\t\tsys_exit(1);\n\t}\n\tvar off i64 = 0;\n\twhile (off < n) {\n\t\tvar wrote i64 = sys_write(fd, data + off, n - off);\n\t\tif (wrote <= 0) { die(\"error: short write\"); }\n\t\toff = off + wrote;\n\t}\n\tsys_close(fd);\n}\n\n// The full x86-64 struct stat is 144 bytes; the kernel writes all of it,\n// and a smaller struct would let the syscall clobber the stack frame. The\n// mode field sits at offset 24, and st_blksize (the last word we name) at\n// 56, but the size must stay 144.\nstruct Stat {\n\td0 i64, d1 i64, d2 i64, mode i64, d4 i64, d5 i64, d6 i64,\n\td7 i64, d8 i64, d9 i64, d10 i64, d11 i64, d12 i64, d13 i64,\n\td14 i64, d15 i64, d16 i64, d17 i64,\n}\n\nfn is_dir(path str) bool {\n\tvar st Stat;\n\tif (sys_stat(cstr(path), &st as *u8) != 0) { return false; }\n\treturn (st.mode & 0xf000) == 0x4000;\n}\n\n// Appends the names of the .qela files in a directory, one per line, to\n// out. getdents64 entries are: ino u64, off i64, reclen u16, type u8, name.\n// Entries come in directory order, so the caller sorts before use.\nfn read_dir(path str, out *Buf) {\n\tvar fd i64 = sys_open_read(cstr(path));\n\tif (fd < 0) {\n\t\teprint(\"error: cannot open directory \");\n\t\teprint(path);\n\t\teprint(\"\\n\");\n\t\tsys_exit(1);\n\t}\n\tvar chunk [2048]u8;\n\twhile (true) {\n\t\tvar got i64 = sys_getdents(fd, &chunk[0], 2048);\n\t\tif (got <= 0) { break; }\n\t\tvar off i64 = 0;\n\t\twhile (off < got) {\n\t\t\tvar p i64 = off;\n\t\t\tvar reclen i64 = (chunk[p + 16] as i64) | ((chunk[p + 17] as i64) << 8);\n\t\t\tif (chunk[p + 18] == 8) {  // DT_REG\n\t\t\t\tvar n i64 = 0;\n\t\t\t\twhile (chunk[p + 19 + n] != 0) { n = n + 1; }\n\t\t\t\tif (n > 5 &&\n\t\t\t\t    chunk[p + 19 + n - 5] == '.' && chunk[p + 19 + n - 4] == 'q' &&\n\t\t\t\t    chunk[p + 19 + n - 3] == 'e' && chunk[p + 19 + n - 2] == 'l' &&\n\t\t\t\t    chunk[p + 19 + n - 1] == 'a') {\n\t\t\t\t\tvar k i64 = 0;\n\t\t\t\t\twhile (k < n) { buf_u8(out, chunk[p + 19 + k]); k = k + 1; }\n\t\t\t\t\tbuf_u8(out, '\\n');\n\t\t\t\t}\n\t\t\t}\n\t\t\toff = off + reclen;\n\t\t}\n\t}\n\tsys_close(fd);\n}\n"; }
	if (i == 7) { return "import \"arena.qela\";\nimport \"sys.qela\";\n\n// Growable pointer array. Elements are opaque *u8; the caller casts.\n//Doubles+ when full. Never frees.\nstruct List {\n\tdata *u8,\n\tlen  i64,\n\tcap  i64,\n}\n\nfn list_grow(l *List, need i64) {\n\tif (l.len + need <= l.cap) { return; }\n\tvar cap i64 = l.cap;\n\tif (cap == 0) { cap = 16; }\n\twhile (cap < l.len + need) { cap = cap * 2; }\n\tvar r *u8 = arena_alloc(cap * 8, 8);\n\tif (r as i64 == 0) {\n\t\teprint(\"out of memory\\n\");\n\t\tsys_exit(1);\n\t}\n\tvar i i64 = 0;\n\twhile (i < l.len) {\n\t\t// Copy 8-byte pointers.\n\t\tvar src *i64 = (l.data as *i64) + i;\n\t\tvar dst *i64 = (r as *i64) + i;\n\t\t*dst = *src;\n\t\ti = i + 1;\n\t}\n\tl.data = r;\n\tl.cap = cap;\n}\n\nfn list_push(l *List, p *u8) {\n\tlist_grow(l, 1);\n\tvar slot *i64 = (l.data as *i64) + l.len;\n\t*slot = p as i64;\n\tl.len = l.len + 1;\n}\n\nfn list_get(l *List, i i64) *u8 {\n\tif (i < 0 || i >= l.len) { return 0 as *u8; }\n\tvar slot *i64 = (l.data as *i64) + i;\n\treturn *slot as *u8;\n}\n\nfn list_len(l *List) i64 {\n\treturn l.len;\n}\n"; }
	if (i == 8) { return "import \"arena.qela\";\nimport \"str.qela\";\n\n// str -> *u8 map with insertion-order iteration and O(N) lookup.\n// N is tiny in a compiler, so the array is fine.\n\nstruct MapEntry {\n\tkey  str,\n\tval  *u8,\n}\n\nstruct Map {\n\tentries *MapEntry,\n\tn       i64,\n\tcap     i64,\n}\n\nfn map_grow(m *Map, need i64) {\n\tif (m.n + need <= m.cap) { return; }\n\tvar cap i64 = m.cap;\n\tif (cap == 0) { cap = 16; }\n\twhile (cap < m.n + need) { cap = cap * 2; }\n\tvar r *MapEntry = arena_alloc(cap * 24, 8) as *MapEntry;\n\tvar i i64 = 0;\n\twhile (i < m.n) { *(r + i) = *(m.entries + i); i = i + 1; }\n\tm.entries = r;\n\tm.cap = cap;\n}\n\nfn map_get(m *Map, key str) *u8 {\n\tvar i i64 = 0;\n\twhile (i < m.n) {\n\t\tvar e *MapEntry = m.entries + i;\n\t\tif (str_eq(key, e.key)) { return e.val; }\n\t\ti = i + 1;\n\t}\n\treturn 0 as *u8;\n}\n\nfn map_put(m *Map, key str, val *u8) {\n\t// Update existing key.\n\tvar i i64 = 0;\n\twhile (i < m.n) {\n\t\tvar e *MapEntry = m.entries + i;\n\t\tif (str_eq(key, e.key)) { e.val = val; return; }\n\t\ti = i + 1;\n\t}\n\t// New entry.\n\tmap_grow(m, 1);\n\tvar e *MapEntry = m.entries + m.n;\n\te.key = key;\n\te.val = val;\n\tm.n = m.n + 1;\n}\n\nfn map_len(m *Map) i64 { return m.n; }\n\nfn map_key(m *Map, i i64) str {\n\tif (i < 0 || i >= m.n) {\n\t\tvar s str;\n\t\ts.ptr = 0 as *u8; s.len = 0;\n\t\treturn s;\n\t}\n\tvar e *MapEntry = m.entries + i;\n\treturn e.key;\n}\n\nfn map_val(m *Map, i i64) *u8 {\n\tif (i < 0 || i >= m.n) { return 0 as *u8; }\n\tvar e *MapEntry = m.entries + i;\n\treturn e.val;\n}\n"; }
	if (i == 9) { return "// Scalar helpers, bootstrap-subset-safe.\n\nfn abs(v i64) i64 {\n\tif (v < 0) { return -v; }\n\treturn v;\n}\n\nfn min(a i64, b i64) i64 {\n\tif (a < b) { return a; }\n\treturn b;\n}\n\nfn max(a i64, b i64) i64 {\n\tif (a > b) { return a; }\n\treturn b;\n}\n"; }
	if (i == 10) { return "// Deterministic xorshift64* — a split-mix style generator with 64 bits of\n// state and an output that passes simple statistical eyeballing. The\n// default seed is fixed, so an unseeded program is reproducible; seed once\n// with rand_init for anything that must not be.\n\nvar rand_state i64 = 0x9E3779B97F4A7C15;\n\nfn rand_init(seed i64) {\n\trand_state = seed;\n\tif (rand_state == 0) { rand_state = 0x9E3779B97F4A7C15; }\n}\n\n// A full 64-bit value. The top bit is masked off so the result is never\n// negative, which keeps `%` well-behaved in rand_range.\nfn rand_u64() i64 {\n\tvar x i64 = rand_state;\n\tx = x ^ (x >> 12);\n\tx = x ^ (x << 25);\n\tx = x ^ (x >> 27);\n\trand_state = x;\n\treturn (x * 0x2545F4914F6CDD1D) & 0x7FFFFFFFFFFFFFFF;\n}\n\n// Uniform in [lo, hi); a degenerate range returns lo.\nfn rand_range(lo i64, hi i64) i64 {\n\tif (hi <= lo) { return lo; }\n\treturn lo + rand_u64() % (hi - lo);\n}\n"; }
	if (i == 11) { return "// Hoare quicksort over a slice of i64, bootstrap-subset-safe.\n\nfn sort_i64(s []i64, lo i64, hi i64) {\n\tif (lo >= hi) { return; }\n\tvar pivot i64 = s[(lo + hi) / 2];\n\tvar i i64 = lo;\n\tvar j i64 = hi;\n\twhile (i <= j) {\n\t\twhile (s[i] < pivot) { i = i + 1; }\n\t\twhile (s[j] > pivot) { j = j - 1; }\n\t\tif (i <= j) {\n\t\t\tvar t i64 = s[i];\n\t\t\ts[i] = s[j];\n\t\t\ts[j] = t;\n\t\t\ti = i + 1;\n\t\t\tj = j - 1;\n\t\t}\n\t}\n\tsort_i64(s, lo, j);\n\tsort_i64(s, i, hi);\n}\n"; }
	if (i == 12) { return "import \"arena.qela\";\n\nfn str_eq(a str, b str) bool {\n\tif (a.len != b.len) { return false; }\n\tvar i i64 = 0;\n\twhile (i < a.len) {\n\t\tif (a.ptr[i] != b.ptr[i]) { return false; }\n\t\ti = i + 1;\n\t}\n\treturn true;\n}\n\nfn str_len_cstr(p *u8) i64 {\n\tvar n i64 = 0;\n\twhile (p[n] != 0) { n = n + 1; }\n\treturn n;\n}\n\nfn str_from_cstr(p *u8) str {\n\tvar s str;\n\ts.ptr = p;\n\ts.len = str_len_cstr(p);\n\treturn s;\n}\n\nfn str_slice(s str, lo i64, hi i64) str {\n\tvar r str;\n\tr.ptr = s.ptr + lo;\n\tr.len = hi - lo;\n\treturn r;\n}\n\nfn str_find(s str, c u8) i64 {\n\tvar i i64 = 0;\n\twhile (i < s.len) {\n\t\tif (s.ptr[i] == c) { return i; }\n\t\ti = i + 1;\n\t}\n\treturn -1;\n}\n\nfn str_dup(s str) str {\n\tvar p *u8 = arena_alloc(s.len + 1, 1);\n\tvar i i64 = 0;\n\twhile (i < s.len) { p[i] = s.ptr[i]; i = i + 1; }\n\tp[s.len] = 0;\n\tvar r str;\n\tr.ptr = p;\n\tr.len = s.len;\n\treturn r;\n}\n\n// NUL-terminated copy, for paths handed to a syscall.\nfn cstr(s str) *u8 {\n\treturn str_dup(s).ptr;\n}\n"; }
	if (i == 13) { return "// The only place in stage1 where a raw syscall is allowed.\n\nlet SYS_READ  = 0;\nlet SYS_WRITE = 1;\nlet SYS_OPEN  = 2;\nlet SYS_CLOSE = 3;\nlet SYS_STAT  = 4;\nlet SYS_MMAP  = 9;\nlet SYS_EXIT   = 60;\nlet SYS_FORK   = 57;\nlet SYS_EXECVE = 59;\nlet SYS_WAIT4  = 61;\nlet SYS_UNLINK = 87;\nlet SYS_GETPID = 39;\nlet SYS_GETDENTS = 217;\nlet SYS_DUP2 = 33;\nlet SYS_IOCTL = 16;\n\nlet STDOUT = 1;\nlet STDERR = 2;\n\nlet O_WRITE_NEW   = 577;  // O_WRONLY | O_CREAT | O_TRUNC\nlet O_WRITE_APPEND = 1089; // O_WRONLY | O_CREAT | O_APPEND\n\nfn sys_read(fd i64, buf *u8, n i64) i64 {\n\treturn syscall(SYS_READ, fd, buf as i64, n);\n}\n\nfn sys_write(fd i64, buf *u8, n i64) i64 {\n\treturn syscall(SYS_WRITE, fd, buf as i64, n);\n}\n\nfn sys_open_read(path *u8) i64 {\n\treturn syscall(SYS_OPEN, path as i64, 0, 0);\n}\n\nfn sys_open_exec(path *u8) i64 {\n\treturn syscall(SYS_OPEN, path as i64, O_WRITE_NEW, 493);\n}\n\nfn sys_open_append(path *u8) i64 {\n\treturn syscall(SYS_OPEN, path as i64, O_WRITE_APPEND, 493);\n}\n\nfn sys_close(fd i64) i64 {\n\treturn syscall(SYS_CLOSE, fd, 0, 0);\n}\n\nfn sys_mmap_anon(n i64) i64 {\n\treturn syscall(SYS_MMAP, 0, n, 3, 34, -1, 0);\n}\n\nfn sys_exit(code i64) {\n\tsyscall(SYS_EXIT, code, 0, 0, 0, 0, 0);\n}\n\nfn sys_fork() i64 { return syscall(SYS_FORK, 0, 0, 0); }\n\nfn sys_execve(path *u8, argv *u8, envp *u8) i64 {\n\treturn syscall(SYS_EXECVE, path as i64, argv as i64, envp as i64);\n}\n\nfn sys_wait4(pid i64, status *u8) i64 {\n\treturn syscall(SYS_WAIT4, pid, status as i64, 0, 0);\n}\n\nfn sys_unlink(path *u8) i64 { return syscall(SYS_UNLINK, path as i64, 0, 0); }\n\nfn sys_getpid() i64 { return syscall(SYS_GETPID, 0, 0, 0); }\n\nfn sys_stat(path *u8, buf *u8) i64 {\n\treturn syscall(SYS_STAT, path as i64, buf as i64, 0);\n}\n\nfn sys_getdents(fd i64, buf *u8, n i64) i64 {\n\treturn syscall(SYS_GETDENTS, fd, buf as i64, n);\n}\n\nfn sys_dup2(old i64, new i64) i64 {\n\treturn syscall(SYS_DUP2, old, new, 0);\n}\n\n// TIOCGETS succeeds on a terminal: 0 on a tty, -1 elsewhere.\nfn sys_isatty() i64 {\n\treturn syscall(SYS_IOCTL, 0, 0x5401, 0);\n}\n\nfn write_str(fd i64, s str) {\n\tsys_write(fd, s.ptr, s.len);\n}\n\nfn eprint(s str) {\n\tsys_write(STDERR, s.ptr, s.len);\n}\n"; }
	if (i == 14) { return "import \"arena.qela\";\n\n// A growable vector of any element type, on the arena. The slice view is\n// the bridge to the language's checked iteration and slicing:\n//\n//   var v Vec(i64);\n//   vec_init(&v);\n//   vec_push(&v, 7);\n//   for x in vec_view(&v) { ... }   // bounds-checked, like any []i64\n//\n// Elements are copied on push; the backing array doubles through the\n// arena and is never freed, so a vector's lifetime is the program's.\n\nstruct Vec(T) {\n\tdata *T,\n\tlen  i64,\n\tcap  i64,\n}\n\nfn vec_init(comptime T: type, v *Vec(T)) {\n\tv.data = 0 as *T;\n\tv.len = 0;\n\tv.cap = 0;\n}\n\nfn vec_push(comptime T: type, v *Vec(T), x T) {\n\tif (v.len >= v.cap) {\n\t\tvar cap i64 = v.cap;\n\t\tif (cap == 0) { cap = 8; }\n\t\twhile (cap < v.len + 1) { cap = cap * 2; }\n\t\tvar nd *T = arena_alloc(cap * sizeof(T), 8) as *T;\n\t\tvar i i64 = 0;\n\t\twhile (i < v.len) {\n\t\t\t*(nd + i) = *(v.data + i);\n\t\t\ti = i + 1;\n\t\t}\n\t\tv.data = nd;\n\t\tv.cap = cap;\n\t}\n\t*(v.data + v.len) = x;\n\tv.len = v.len + 1;\n}\n\n// Out of range reads return a zeroed element, like list_get.\nfn vec_get(comptime T: type, v *Vec(T), i i64) T {\n\tif (i < 0 || i >= v.len) {\n\t\tvar z T;\n\t\treturn z;\n\t}\n\treturn *(v.data + i);\n}\n\nfn vec_pop(comptime T: type, v *Vec(T)) T {\n\tif (v.len == 0) {\n\t\tvar z T;\n\t\treturn z;\n\t}\n\tv.len = v.len - 1;\n\treturn *(v.data + v.len);\n}\n\nfn vec_clear(comptime T: type, v *Vec(T)) {\n\tv.len = 0;\n}\n\n// The whole vector as a slice: checked indexing, slicing and for-in.\nfn vec_view(comptime T: type, v *Vec(T)) []T {\n\tvar s []T;\n\ts.ptr = v.data;\n\ts.len = v.len;\n\treturn s;\n}\n"; }
	return "";
