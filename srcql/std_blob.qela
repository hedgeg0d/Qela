	if (i == 9) { return "import \"sys.qela\";\nimport \"coro.qela\";\n\n// A conservative mark-sweep collector, written in Qela like everything else\n// the compiler ships. Arenas stay the default; this is for programs whose\n// lifetimes are not stack-shaped.\n//\n// Conservative means any machine word that looks like a pointer into the\n// heap keeps its block alive. That over-approximates, which is safe, and it\n// needs no cooperation from the type checker.\n//\n// Roots are the callee-saved registers (spilled by gc_save_regs), the stack\n// between the base captured at gc_init and the current frame, and the whole\n// data segment, whose bounds gc_data_base and gc_data_end get from the\n// compiler.\n//\n// Threads: a collecting thread stops the world by cooperative safepoint\n// polling, not signals -- gc_safepoint runs at gc_alloc's own entry, the\n// one call every allocating thread makes often enough to park promptly,\n// and without pulling a gc.qela dependency into coro.qela/chan.qela just\n// to add more polling points. A thread that never allocates and is not\n// registered holds no roots this collector needs to find, so it is never\n// waited on; a registered thread that stops allocating for a long stretch\n// (no allocation, no gc_thread_exit) delays the next collection until it\n// allocates again -- a known limit of polling-only safepoints, not\n// something this collector tries to paper over.\n\nlet GC_CHUNK  = 1048576;\nlet GC_HEADER = 32;\nlet GC_MAX_THREADS = 64;\n\n// gc_save_regs spills every callee-saved register: x86's RBX/R12-R15 (padded\n// to 6), ARM64's x19-x28 (10) -- sized for the larger of the two so one\n// struct layout serves both targets; the unused tail on x86 stays zeroed and\n// gc_mark_range over zero words is a no-op.\nlet GC_NREGS = 10;\n\n// Every block carries: size, mark flag, and links for the all-blocks list\n// and the free list.\nstruct GcBlock;\nstruct GcBlock {\n\tsize   i64,\n\tmarked i64,\n\tnext   *GcBlock,\n\tfree   *GcBlock,\n}\n\nstruct GcThread {\n\tactive       i64,\n\tstack_base   i64,\n\tsp           i64,\n\tregs         [10]i64,\n\tat_safepoint i64,\n}\n\nvar gc_blocks *GcBlock;\nvar gc_freelist *GcBlock;\nvar gc_cur i64 = 0;\nvar gc_end i64 = 0;\nvar gc_lo i64 = 0;\nvar gc_hi i64 = 0;\nvar gc_stack_base i64 = 0;\nvar gc_live i64 = 0;\nvar gc_ready bool = false;\n\nvar gc_alloc_lock i64 = 0;\nvar gc_reg_lock i64 = 0;\nvar gc_stw_requested i64 = 0;\nvar gc_threads [64]GcThread;\ntvar gc_my_slot i64 = -1;\n\nfn gc_lock() { while (!atomic_cas(&gc_alloc_lock, 0, 1)) { sys_sched_yield(); } }\nfn gc_unlock() { atomic_store(&gc_alloc_lock, 0); }\n\nfn gc_init() {\n\tif (gc_ready) { return; }\n\tgc_ready = true;\n\tvar anchor i64 = 0;\n\tgc_stack_base = &anchor as i64;\n}\n\n// Registers the calling thread as a GC root source. Every thread that\n// allocates or holds a live pointer across an allocation must call this\n// once, early -- the stack base recorded here has to sit above every frame\n// that will ever need scanning, the same assumption gc_init makes for the\n// thread that happens to trigger it first.\nfn gc_thread_enter() {\n\tgc_init();\n\twhile (!atomic_cas(&gc_reg_lock, 0, 1)) { sys_sched_yield(); }\n\tvar i int = 0;\n\twhile (i < GC_MAX_THREADS) {\n\t\tif (gc_threads[i].active == 0) {\n\t\t\tvar anchor i64 = 0;\n\t\t\tgc_threads[i].stack_base = &anchor as i64;\n\t\t\tgc_threads[i].at_safepoint = 0;\n\t\t\tgc_threads[i].active = 1;\n\t\t\tgc_my_slot = i as i64;\n\t\t\tatomic_store(&gc_reg_lock, 0);\n\t\t\treturn;\n\t\t}\n\t\ti = i + 1;\n\t}\n\tatomic_store(&gc_reg_lock, 0);\n}\n\nfn gc_thread_exit() {\n\tif (gc_my_slot < 0) { return; }\n\twhile (!atomic_cas(&gc_reg_lock, 0, 1)) { sys_sched_yield(); }\n\tgc_threads[gc_my_slot as int].active = 0;\n\tatomic_store(&gc_reg_lock, 0);\n\tgc_my_slot = -1;\n}\n\n// Called from every point a thread might sit idle for a while: a collector\n// on another thread can only scan roots it has actually parked.\nfn gc_safepoint() {\n\tif (atomic_load(&gc_stw_requested) == 0) { return; }\n\tif (gc_my_slot < 0) { return; }\n\tvar slot int = gc_my_slot as int;\n\tgc_save_regs(&gc_threads[slot].regs[0]);\n\tvar here i64 = 0;\n\tgc_threads[slot].sp = &here as i64;\n\tatomic_store(&gc_threads[slot].at_safepoint, 1);\n\twhile (atomic_load(&gc_stw_requested) != 0) { }\n\tatomic_store(&gc_threads[slot].at_safepoint, 0);\n}\n\nfn gc_chunk(need i64) bool {\n\tvar want i64 = GC_CHUNK;\n\twhile (want < need) { want = want * 2; }\n\tvar p i64 = sys_mmap_anon(want);\n\tif (p < 0 && p > -4096) { return false; }\n\tgc_cur = p;\n\tgc_end = p + want;\n\tif (gc_lo == 0 || p < gc_lo) { gc_lo = p; }\n\tif (p + want > gc_hi) { gc_hi = p + want; }\n\treturn true;\n}\n\nfn gc_take(size i64) *u8 {\n\tvar total i64 = GC_HEADER + ((size + 7) & ~7);\n\tif (gc_end - gc_cur < total) {\n\t\tif (!gc_chunk(total)) { return 0 as *u8; }\n\t}\n\tvar b *GcBlock = gc_cur as *GcBlock;\n\tgc_cur = gc_cur + total;\n\tb.size = total;\n\tb.marked = 0;\n\tb.next = gc_blocks;\n\tb.free = 0 as *GcBlock;\n\tgc_blocks = b;\n\tgc_live = gc_live + total;\n\treturn (b as i64 + GC_HEADER) as *u8;\n}\n\nfn gc_reuse(size i64) *u8 {\n\tvar total i64 = GC_HEADER + ((size + 7) & ~7);\n\tvar prev *GcBlock = 0 as *GcBlock;\n\tvar b *GcBlock = gc_freelist;\n\twhile (b as i64 != 0) {\n\t\tif (b.size >= total) {\n\t\t\tif (prev as i64 == 0) { gc_freelist = b.free; }\n\t\t\telse { prev.free = b.free; }\n\t\t\tb.free = 0 as *GcBlock;\n\t\t\tb.marked = 0;\n\t\t\tgc_live = gc_live + b.size;\n\t\t\treturn (b as i64 + GC_HEADER) as *u8;\n\t\t}\n\t\tprev = b;\n\t\tb = b.free;\n\t}\n\treturn 0 as *u8;\n}\n\nfn gc_alloc(size i64) *u8 {\n\tgc_init();\n\tgc_safepoint();\n\tif (size <= 0) { size = 1; }\n\tgc_lock();\n\tvar p *u8 = gc_reuse(size);\n\tif (p as i64 == 0) { p = gc_take(size); }\n\tgc_unlock();\n\treturn p;\n}\n\n// A word is a candidate only if it lands inside a mapped chunk and points\n// exactly at a block's payload.\nfn gc_block_at(addr i64) *GcBlock {\n\tif (addr < gc_lo + GC_HEADER || addr >= gc_hi) { return 0 as *GcBlock; }\n\tif ((addr & 7) != 0) { return 0 as *GcBlock; }\n\tvar b *GcBlock = gc_blocks;\n\twhile (b as i64 != 0) {\n\t\tif ((b as i64) + GC_HEADER == addr) { return b; }\n\t\tb = b.next;\n\t}\n\treturn 0 as *GcBlock;\n}\n\nfn gc_mark_word(w i64) {\n\tvar b *GcBlock = gc_block_at(w);\n\tif (b as i64 == 0) { return; }\n\tif (b.marked != 0) { return; }\n\tb.marked = 1;\n\n\t// The block's own payload can hold pointers too.\n\tvar p *i64 = ((b as i64) + GC_HEADER) as *i64;\n\tvar words i64 = (b.size - GC_HEADER) / 8;\n\tvar i i64 = 0;\n\twhile (i < words) {\n\t\tgc_mark_word(p[i]);\n\t\ti = i + 1;\n\t}\n}\n\nfn gc_mark_range(lo i64, hi i64) {\n\tvar p i64 = (lo + 7) & ~7;\n\twhile (p + 8 <= hi) {\n\t\tvar w *i64 = p as *i64;\n\t\tgc_mark_word(*w);\n\t\tp = p + 8;\n\t}\n}\n\n// marked: 0 = live but unreached this cycle, 1 = reached, -1 = on the free\n// list. The third state keeps a second sweep from linking a block twice.\nfn gc_sweep() {\n\tgc_live = 0;\n\tvar b *GcBlock = gc_blocks;\n\twhile (b as i64 != 0) {\n\t\tif (b.marked == 1) {\n\t\t\tb.marked = 0;\n\t\t\tgc_live = gc_live + b.size;\n\t\t} else if (b.marked == 0) {\n\t\t\tb.marked = -1;\n\t\t\tb.free = gc_freelist;\n\t\t\tgc_freelist = b;\n\t\t}\n\t\tb = b.next;\n\t}\n}\n\nfn gc_collect() {\n\tgc_init();\n\n\t// Ask every other registered thread to park at its next safepoint,\n\t// and wait for each of them to actually get there -- this has to\n\t// happen before taking gc_alloc_lock, or a thread already inside its\n\t// own allocation (past its safepoint check, waiting on this same\n\t// lock to finish a later one) could never reach the safepoint this\n\t// loop is waiting for.\n\t//\n\t// A thread can also finish and call gc_thread_exit without ever\n\t// hitting another safepoint after the flag above went up (its last\n\t// gc_alloc, if any, already ran before the check saw the request).\n\t// That is a valid way out of the wait too, by contract: a thread must\n\t// stop caring about its own local roots before it deregisters, the\n\t// same discipline any handoff across gc_thread_exit already needs.\n\tatomic_store(&gc_stw_requested, 1);\n\tvar wi int = 0;\n\twhile (wi < GC_MAX_THREADS) {\n\t\tif (gc_threads[wi].active != 0 && (gc_my_slot < 0 || (wi as i64) != gc_my_slot)) {\n\t\t\twhile (gc_threads[wi].active != 0 && atomic_load(&gc_threads[wi].at_safepoint) == 0) { }\n\t\t}\n\t\twi = wi + 1;\n\t}\n\n\tgc_lock();\n\n\tvar regs [10]i64;\n\tgc_save_regs(&regs[0]);\n\tgc_mark_range(&regs[0] as i64, (&regs[0] as i64) + GC_NREGS * 8);\n\n\tvar here i64 = 0;\n\tvar sp i64 = &here as i64;\n\t// Under `qela irun` a coroutine's frames live in a region of the\n\t// interpreter's own, one per context, and gc_stack_base would name\n\t// whichever context happened to allocate first -- a range spanning two\n\t// unrelated mappings. The interpreter knows the right bounds.\n\t$if (INTERP == \"1\") {\n\t\tgc_mark_range(interp_coro_sp(cur_coro), interp_coro_top(cur_coro));\n\t} $else {\n\t\tgc_mark_range(sp, gc_stack_base + 8);\n\t}\n\tgc_mark_range(gc_data_base(), gc_data_end());\n\n\t// Every other parked OS thread's roots, captured when it hit its\n\t// safepoint above.\n\tvar ti int = 0;\n\twhile (ti < GC_MAX_THREADS) {\n\t\tif (gc_threads[ti].active != 0 && (gc_my_slot < 0 || (ti as i64) != gc_my_slot)) {\n\t\t\tgc_mark_range(&gc_threads[ti].regs[0] as i64, (&gc_threads[ti].regs[0] as i64) + GC_NREGS * 8);\n\t\t\tgc_mark_range(gc_threads[ti].sp, gc_threads[ti].stack_base + 8);\n\t\t}\n\t\tti = ti + 1;\n\t}\n\n\t// Other live coroutines on this thread's own scheduler -- the scan\n\t// above only covers the coroutine gc_collect runs on.\n\tvar ci int = 1;\n\twhile (ci <= coro_slots()) {\n\t\tif (ci != cur_coro && coros[ci].alive && !coros[ci].done) {\n\t\t\t$if (INTERP == \"1\") {\n\t\t\t\tgc_mark_range(interp_coro_sp(ci), interp_coro_top(ci));\n\t\t\t} $else {\n\t\t\t\tgc_mark_range(coros[ci].sp, coros[ci].top);\n\t\t\t}\n\t\t}\n\t\tci = ci + 1;\n\t}\n\n\tgc_sweep();\n\tgc_unlock();\n\tatomic_store(&gc_stw_requested, 0);\n}\n\nfn gc_live_bytes() i64 { return gc_live; }\n"; }
	if (i == 10) { return "// K&R free-list malloc/free/realloc. Blocks return to the allocator (unlike\n// the arena) and adjacent frees coalesce. Backed by its own mmap regions,\n// independent of the bump arena. Not thread-safe: qela has no threads.\n\nstruct Header {\n\tsize  i64,     // size in Header-units, including this header\n\tnextf *Header, // next free block in the circular free list\n}\n\nvar heap_base Header;\nvar heap_freep *Header;\n\nfn heap_morecore(nu i64) *Header {\n\tvar n i64 = nu;\n\tif (n < 4096) { n = 4096; }\n\tvar bytes i64 = n * sizeof(Header);\n\tvar r i64 = 0;\n\t$if (TARGET != \"x86_64\") {\n\t\tr = syscall(222, 0, bytes, 3, 34, -1, 0);\n\t} $else {\n\t\tr = syscall(9, 0, bytes, 3, 34, -1, 0);\n\t}\n\tif (r < 0 && r > -4096) { return 0 as *Header; }\n\tvar p *Header = r as *Header;\n\tp.size = n;\n\theap_free((p + 1) as *u8);\n\treturn heap_freep;\n}\n\nfn heap_alloc(nbytes i64) *u8 {\n\tif (nbytes <= 0) { return 0 as *u8; }\n\tvar nunits i64 = (nbytes + sizeof(Header) - 1) / sizeof(Header) + 1;\n\n\tif (heap_freep == (0 as *Header)) {\n\t\theap_base.nextf = &heap_base;\n\t\theap_base.size = 0;\n\t\theap_freep = &heap_base;\n\t}\n\n\tvar prevp *Header = heap_freep;\n\tvar p *Header = prevp.nextf;\n\twhile (true) {\n\t\tif (p.size >= nunits) {\n\t\t\tif (p.size == nunits) {\n\t\t\t\tprevp.nextf = p.nextf;\n\t\t\t} else {\n\t\t\t\tp.size = p.size - nunits;\n\t\t\t\tp = p + p.size;\n\t\t\t\tp.size = nunits;\n\t\t\t}\n\t\t\theap_freep = prevp;\n\t\t\treturn (p + 1) as *u8;\n\t\t}\n\t\tif (p == heap_freep) {\n\t\t\tvar np *Header = heap_morecore(nunits);\n\t\t\tif (np == (0 as *Header)) { return 0 as *u8; }\n\t\t\tp = np;\n\t\t}\n\t\tprevp = p;\n\t\tp = p.nextf;\n\t}\n\treturn 0 as *u8;\n}\n\nfn heap_free(ap *u8) {\n\tif (ap == (0 as *u8)) { return; }\n\tvar bp *Header = (ap as *Header) - 1;\n\tvar p *Header = heap_freep;\n\twhile (true) {\n\t\tif (bp > p && bp < p.nextf) { break; }\n\t\tif (p >= p.nextf && (bp > p || bp < p.nextf)) { break; }\n\t\tp = p.nextf;\n\t}\n\tif (bp + bp.size == p.nextf) {\n\t\tbp.size = bp.size + p.nextf.size;\n\t\tbp.nextf = p.nextf.nextf;\n\t} else {\n\t\tbp.nextf = p.nextf;\n\t}\n\tif (p + p.size == bp) {\n\t\tp.size = p.size + bp.size;\n\t\tp.nextf = bp.nextf;\n\t} else {\n\t\tp.nextf = bp;\n\t}\n\theap_freep = p;\n}\n\nfn heap_realloc(ap *u8, nbytes i64) *u8 {\n\tif (ap == (0 as *u8)) { return heap_alloc(nbytes); }\n\tif (nbytes <= 0) { heap_free(ap); return 0 as *u8; }\n\n\tvar bp *Header = (ap as *Header) - 1;\n\tvar oldbytes i64 = (bp.size - 1) * sizeof(Header);\n\n\tvar r *u8 = heap_alloc(nbytes);\n\tif (r == (0 as *u8)) { return 0 as *u8; }\n\n\tvar n i64 = oldbytes;\n\tif (nbytes < n) { n = nbytes; }\n\tvar i i64 = 0;\n\twhile (i < n) {\n\t\t*(r + i) = *(ap + i);\n\t\ti = i + 1;\n\t}\n\theap_free(ap);\n\treturn r;\n}\n"; }
	if (i == 11) { return "import \"sys.qela\";\nimport \"str.qela\";\nimport \"buf.qela\";\nimport \"arena.qela\";\nimport \"abiwire.qela\";\nimport \"abiconn.qela\";\n\nlet ABI_REQ_RUN = 1;\nlet ABI_REQ_CALL = 2;\nlet ABI_RESP_ERR = 2;\n\nstruct InterpReg;\nstruct InterpReg {\n\tname str,\n\tnext *InterpReg,\n}\nvar interp_registered *InterpReg = 0 as *InterpReg;\n\nfn interp_is_registered(name str) bool {\n\tvar r *InterpReg = interp_registered;\n\twhile (r as i64 != 0) {\n\t\tif (str_eq(r.name, name)) { return true; }\n\t\tr = r.next;\n\t}\n\treturn false;\n}\n\nfn interp_mark_registered(name str) {\n\tvar r *InterpReg = arena_alloc(sizeof(InterpReg), 8) as *InterpReg;\n\tr.name = name;\n\tr.next = interp_registered;\n\tinterp_registered = r;\n}\n\nfn interp_register(def_src str, name str) {\n\tif (interp_is_registered(name)) { return; }\n\tabi_send_frame(abi_in, ABI_REQ_RUN as u8, def_src.ptr, def_src.len);\n\tvar buf [8]u8;\n\tvar kind u8 = 0;\n\tvar n i64 = abi_wait_result(&kind, &buf[0], 8);\n\tif (n < 0) {\n\t\teprint(\"interpreted: the qela subprocess died while registering '\");\n\t\teprint(name);\n\t\teprint(\"'\\n\");\n\t\tsys_exit(1);\n\t}\n\tif (kind == (ABI_RESP_ERR as u8)) {\n\t\teprint(\"interpreted: '\");\n\t\teprint(name);\n\t\teprint(\"' failed to compile in the runtime subprocess\\n\");\n\t\tsys_exit(1);\n\t}\n\tinterp_mark_registered(name);\n}\n\nfn __interp_call_dispatch(def_src str, name str, args *i64) i64 {\n\tabi_spawn();\n\tinterp_register(def_src, name);\n\n\tvar b Buf;\n\tbuf_u8(&b, name.len as u8);\n\tbuf_bytes(&b, name.ptr, name.len);\n\tvar i i64 = 0;\n\twhile (i < 6) {\n\t\tbuf_u64(&b, args[i]);\n\t\ti = i + 1;\n\t}\n\tvar msg str = buf_str(&b);\n\tabi_send_frame(abi_in, ABI_REQ_CALL as u8, msg.ptr, msg.len);\n\n\tvar rbuf [8]u8;\n\tvar kind u8 = 0;\n\tvar n i64 = abi_wait_result(&kind, &rbuf[0], 8);\n\tif (n < 0) {\n\t\teprint(\"interpreted: the qela subprocess died while calling '\");\n\t\teprint(name);\n\t\teprint(\"'\\n\");\n\t\tsys_exit(1);\n\t}\n\tif (kind == (ABI_RESP_ERR as u8)) {\n\t\teprint(\"interpreted: '\");\n\t\teprint(name);\n\t\teprint(\"' raised an error at runtime\\n\");\n\t\tsys_exit(1);\n\t}\n\treturn *(&rbuf[0] as *i64);\n}\n"; }
	if (i == 12) { return "import \"sys.qela\";\nimport \"buf.qela\";\nimport \"str.qela\";\n\nlet IO_CHUNK = 65536;\n\nfn die(msg str) {\n\teprint(msg);\n\teprint(\"\\n\");\n\tsys_exit(1);\n}\n\nfn print(s str) {\n\twrite_str(STDOUT, s);\n}\n\nfn println(s str) {\n\twrite_str(STDOUT, s);\n\twrite_str(STDOUT, \"\\n\");\n}\n\nfn file_exists(path str) bool {\n\tvar fd i64 = sys_open_read(cstr(path));\n\tif (fd < 0) { return false; }\n\tsys_close(fd);\n\treturn true;\n}\n\nfn read_file(path str) str {\n\tvar fd i64 = sys_open_read(cstr(path));\n\tif (fd < 0) {\n\t\teprint(\"error: cannot open \");\n\t\teprint(path);\n\t\teprint(\"\\n\");\n\t\tsys_exit(1);\n\t}\n\tvar b Buf;\n\tvar got i64 = 1;\n\twhile (got > 0) {\n\t\tbuf_grow(&b, IO_CHUNK);\n\t\tgot = sys_read(fd, b.p + b.n, IO_CHUNK);\n\t\tif (got > 0) { b.n = b.n + got; }\n\t}\n\tsys_close(fd);\n\treturn buf_str(&b);\n}\n\nfn read_stdin() str {\n\tvar b Buf;\n\tvar got i64 = 1;\n\twhile (got > 0) {\n\t\tbuf_grow(&b, IO_CHUNK);\n\t\tgot = sys_read(0, b.p + b.n, IO_CHUNK);\n\t\tif (got > 0) { b.n = b.n + got; }\n\t}\n\treturn buf_str(&b);\n}\n\n// One line, newline included; \"\" only at end of input. An empty line\n// returns \"\\n\", so a caller can tell the two apart.\nfn read_line() str {\n\tvar b Buf;\n\tvar c u8 = 0;\n\twhile (true) {\n\t\tvar got i64 = sys_read(0, &c, 1);\n\t\tif (got <= 0) { break; }\n\t\tbuf_u8(&b, c);\n\t\tif (c == '\\n') { break; }\n\t}\n\treturn buf_str(&b);\n}\n\nfn write_file(path str, data *u8, n i64) {\n\tvar fd i64 = sys_open_exec(cstr(path));\n\tif (fd < 0) {\n\t\teprint(\"error: cannot write \");\n\t\teprint(path);\n\t\teprint(\"\\n\");\n\t\tsys_exit(1);\n\t}\n\tvar off i64 = 0;\n\twhile (off < n) {\n\t\tvar wrote i64 = sys_write(fd, data + off, n - off);\n\t\tif (wrote <= 0) { die(\"error: short write\"); }\n\t\toff = off + wrote;\n\t}\n\tsys_close(fd);\n}\n\n// The full x86-64 struct stat is 144 bytes; the kernel writes all of it,\n// and a smaller struct would let the syscall clobber the stack frame. The\n// mode field sits at offset 24, and st_blksize (the last word we name) at\n// 56, but the size must stay 144.\nstruct Stat {\n\td0 i64, d1 i64, d2 i64, mode i64, d4 i64, d5 i64, d6 i64,\n\td7 i64, d8 i64, d9 i64, d10 i64, d11 i64, d12 i64, d13 i64,\n\td14 i64, d15 i64, d16 i64, d17 i64,\n}\n\nfn is_dir(path str) bool {\n\tvar st Stat;\n\tif (sys_stat(cstr(path), &st as *u8) != 0) { return false; }\n\tvar mode i64 = st.mode;\n\t$if (TARGET != \"x86_64\") {\n\t\tmode = st.d2;\n\t}\n\treturn (mode & 0xf000) == 0x4000;\n}\n\n// Appends the names of the .qela files under a directory, one per line, to\n// out -- recursively, so a project's files can live in subdirectories.\n// Names carry their path relative to the top directory (e.g. \"sub/x.qela\").\n// getdents64 entries are: ino u64, off i64, reclen u16, type u8, name.\n// Entries come in directory order, so the caller sorts before use. A\n// dot-directory (\".git\", \".foo\") is skipped, same convention most tools use\n// for \"not part of the project\".\nfn read_dir_rec(path str, prefix str, out *Buf) {\n\tvar fd i64 = sys_open_read(cstr(path));\n\tif (fd < 0) {\n\t\teprint(\"error: cannot open directory \");\n\t\teprint(path);\n\t\teprint(\"\\n\");\n\t\tsys_exit(1);\n\t}\n\tvar chunk [2048]u8;\n\twhile (true) {\n\t\tvar got i64 = sys_getdents(fd, &chunk[0], 2048);\n\t\tif (got <= 0) { break; }\n\t\tvar off i64 = 0;\n\t\twhile (off < got) {\n\t\t\tvar p i64 = off;\n\t\t\tvar reclen i64 = (chunk[p + 16] as i64) | ((chunk[p + 17] as i64) << 8);\n\t\t\tvar typ u8 = chunk[p + 18];\n\t\t\tif (typ == 4 || typ == 8) {  // DT_DIR or DT_REG\n\t\t\t\tvar n i64 = 0;\n\t\t\t\twhile (chunk[p + 19 + n] != 0) { n = n + 1; }\n\t\t\t\tif (typ == 4) {\n\t\t\t\t\tvar dot bool = chunk[p + 19] == '.';\n\t\t\t\t\tif (!dot) {\n\t\t\t\t\t\tvar sub Buf;\n\t\t\t\t\t\tbuf_bytes(&sub, path.ptr, path.len);\n\t\t\t\t\t\tif (sub.n == 0 || sub.p[sub.n - 1] != '/') { buf_u8(&sub, '/'); }\n\t\t\t\t\t\tvar k i64 = 0;\n\t\t\t\t\t\twhile (k < n) { buf_u8(&sub, chunk[p + 19 + k]); k = k + 1; }\n\n\t\t\t\t\t\tvar subprefix Buf;\n\t\t\t\t\t\tbuf_bytes(&subprefix, prefix.ptr, prefix.len);\n\t\t\t\t\t\tk = 0;\n\t\t\t\t\t\twhile (k < n) { buf_u8(&subprefix, chunk[p + 19 + k]); k = k + 1; }\n\t\t\t\t\t\tbuf_u8(&subprefix, '/');\n\n\t\t\t\t\t\tread_dir_rec(buf_str(&sub), buf_str(&subprefix), out);\n\t\t\t\t\t}\n\t\t\t\t} else if (n > 5 &&\n\t\t\t\t    chunk[p + 19 + n - 5] == '.' && chunk[p + 19 + n - 4] == 'q' &&\n\t\t\t\t    chunk[p + 19 + n - 3] == 'e' && chunk[p + 19 + n - 2] == 'l' &&\n\t\t\t\t    chunk[p + 19 + n - 1] == 'a') {\n\t\t\t\t\tbuf_bytes(out, prefix.ptr, prefix.len);\n\t\t\t\t\tvar k i64 = 0;\n\t\t\t\t\twhile (k < n) { buf_u8(out, chunk[p + 19 + k]); k = k + 1; }\n\t\t\t\t\tbuf_u8(out, '\\n');\n\t\t\t\t}\n\t\t\t}\n\t\t\toff = off + reclen;\n\t\t}\n\t}\n\tsys_close(fd);\n}\n\nfn read_dir(path str, out *Buf) { read_dir_rec(path, \"\", out); }\n"; }
	if (i == 13) { return "import \"arena.qela\";\nimport \"sys.qela\";\n\n// Growable pointer array. Elements are opaque *u8; the caller casts.\nstruct List {\n\tdata *u8,\n\tlen  i64,\n\tcap  i64,\n}\n\nfn list_grow(l *List, need i64) {\n\tif (l.len + need <= l.cap) { return; }\n\tvar cap i64 = l.cap;\n\tif (cap == 0) { cap = 16; }\n\twhile (cap < l.len + need) { cap = cap * 2; }\n\tvar r *u8 = arena_alloc(cap * 8, 8);\n\tif (r as i64 == 0) {\n\t\teprint(\"out of memory\\n\");\n\t\tsys_exit(1);\n\t}\n\tvar i i64 = 0;\n\twhile (i < l.len) {\n\t\tvar src *i64 = (l.data as *i64) + i;\n\t\tvar dst *i64 = (r as *i64) + i;\n\t\t*dst = *src;\n\t\ti = i + 1;\n\t}\n\tl.data = r;\n\tl.cap = cap;\n}\n\nfn list_push(l *List, p *u8) {\n\tlist_grow(l, 1);\n\tvar slot *i64 = (l.data as *i64) + l.len;\n\t*slot = p as i64;\n\tl.len = l.len + 1;\n}\n\nfn list_get(l *List, i i64) *u8 {\n\tif (i < 0 || i >= l.len) { return 0 as *u8; }\n\tvar slot *i64 = (l.data as *i64) + i;\n\treturn *slot as *u8;\n}\n\nfn list_len(l *List) i64 {\n\treturn l.len;\n}\n"; }
	if (i == 14) { return "import \"arena.qela\";\nimport \"str.qela\";\n\n// str -> *u8 map with insertion-order iteration and O(N) lookup.\n// N is tiny in a compiler, so the array is fine.\n\nstruct MapEntry {\n\tkey  str,\n\tval  *u8,\n}\n\nstruct Map {\n\tentries *MapEntry,\n\tn       i64,\n\tcap     i64,\n}\n\nfn map_grow(m *Map, need i64) {\n\tif (m.n + need <= m.cap) { return; }\n\tvar cap i64 = m.cap;\n\tif (cap == 0) { cap = 16; }\n\twhile (cap < m.n + need) { cap = cap * 2; }\n\tvar r *MapEntry = arena_alloc(cap * 24, 8) as *MapEntry;\n\tvar i i64 = 0;\n\twhile (i < m.n) { *(r + i) = *(m.entries + i); i = i + 1; }\n\tm.entries = r;\n\tm.cap = cap;\n}\n\nfn map_get(m *Map, key str) *u8 {\n\tvar i i64 = 0;\n\twhile (i < m.n) {\n\t\tvar e *MapEntry = m.entries + i;\n\t\tif (str_eq(key, e.key)) { return e.val; }\n\t\ti = i + 1;\n\t}\n\treturn 0 as *u8;\n}\n\nfn map_put(m *Map, key str, val *u8) {\n\tvar i i64 = 0;\n\twhile (i < m.n) {\n\t\tvar e *MapEntry = m.entries + i;\n\t\tif (str_eq(key, e.key)) { e.val = val; return; }\n\t\ti = i + 1;\n\t}\n\tmap_grow(m, 1);\n\tvar e *MapEntry = m.entries + m.n;\n\te.key = key;\n\te.val = val;\n\tm.n = m.n + 1;\n}\n\nfn map_len(m *Map) i64 { return m.n; }\n\nfn map_key(m *Map, i i64) str {\n\tif (i < 0 || i >= m.n) {\n\t\tvar s str;\n\t\ts.ptr = 0 as *u8; s.len = 0;\n\t\treturn s;\n\t}\n\tvar e *MapEntry = m.entries + i;\n\treturn e.key;\n}\n\nfn map_val(m *Map, i i64) *u8 {\n\tif (i < 0 || i >= m.n) { return 0 as *u8; }\n\tvar e *MapEntry = m.entries + i;\n\treturn e.val;\n}\n"; }
	if (i == 15) { return "// Scalar helpers, bootstrap-subset-safe.\n\nfn abs(v i64) i64 {\n\tif (v < 0) { return -v; }\n\treturn v;\n}\n\nfn min(a i64, b i64) i64 {\n\tif (a < b) { return a; }\n\treturn b;\n}\n\nfn max(a i64, b i64) i64 {\n\tif (a > b) { return a; }\n\treturn b;\n}\n"; }
	if (i == 16) { return "// Deterministic xorshift64* — a split-mix style generator with 64 bits of\n// state and an output that passes simple statistical eyeballing. The\n// default seed is fixed, so an unseeded program is reproducible; seed once\n// with rand_init for anything that must not be.\n\nvar rand_state i64 = 0x9E3779B97F4A7C15;\n\nfn rand_init(seed i64) {\n\trand_state = seed;\n\tif (rand_state == 0) { rand_state = 0x9E3779B97F4A7C15; }\n}\n\n// A full 64-bit value. The top bit is masked off so the result is never\n// negative, which keeps `%` well-behaved in rand_range.\nfn rand_u64() i64 {\n\tvar x i64 = rand_state;\n\tx = x ^ (x >> 12);\n\tx = x ^ (x << 25);\n\tx = x ^ (x >> 27);\n\trand_state = x;\n\treturn (x * 0x2545F4914F6CDD1D) & 0x7FFFFFFFFFFFFFFF;\n}\n\n// Uniform in [lo, hi); a degenerate range returns lo.\nfn rand_range(lo i64, hi i64) i64 {\n\tif (hi <= lo) { return lo; }\n\treturn lo + rand_u64() % (hi - lo);\n}\n"; }
	if (i == 17) { return "// Hoare quicksort over a slice of i64, bootstrap-subset-safe.\n\nfn sort_i64(s []i64, lo i64, hi i64) {\n\tif (lo >= hi) { return; }\n\tvar pivot i64 = s[(lo + hi) / 2];\n\tvar i i64 = lo;\n\tvar j i64 = hi;\n\twhile (i <= j) {\n\t\twhile (s[i] < pivot) { i = i + 1; }\n\t\twhile (s[j] > pivot) { j = j - 1; }\n\t\tif (i <= j) {\n\t\t\tvar t i64 = s[i];\n\t\t\ts[i] = s[j];\n\t\t\ts[j] = t;\n\t\t\ti = i + 1;\n\t\t\tj = j - 1;\n\t\t}\n\t}\n\tsort_i64(s, lo, j);\n\tsort_i64(s, i, hi);\n}\n"; }
	if (i == 18) { return "import \"sort.qela\";\n\n// Hoare quicksort over []i64 with a caller-supplied comparator function\n// value. Unlike sort_i64 (which the bootstrap subset must be able to\n// compile) this takes a first-class fn parameter, so it is stage1-only:\n// a comparator is `fn (i64, i64) bool` — pass the smaller first.\nfn sort_cmp(s []i64, lo i64, hi i64, cmp fn(i64, i64) bool) {\n\tif (lo >= hi) { return; }\n\tvar pivot i64 = s[(lo + hi) / 2];\n\tvar i i64 = lo;\n\tvar j i64 = hi;\n\twhile (i <= j) {\n\t\twhile (cmp(s[i], pivot)) { i = i + 1; }\n\t\twhile (cmp(pivot, s[j])) { j = j - 1; }\n\t\tif (i <= j) {\n\t\t\tvar t i64 = s[i];\n\t\t\ts[i] = s[j];\n\t\t\ts[j] = t;\n\t\t\ti = i + 1;\n\t\t\tj = j - 1;\n\t\t}\n\t}\n\tsort_cmp(s, lo, j, cmp);\n\tsort_cmp(s, i, hi, cmp);\n}\n"; }
	if (i == 19) { return "import \"arena.qela\";\n\nfn str_eq(a str, b str) bool {\n\tif (a.len != b.len) { return false; }\n\tvar i i64 = 0;\n\twhile (i < a.len) {\n\t\tif (a.ptr[i] != b.ptr[i]) { return false; }\n\t\ti = i + 1;\n\t}\n\treturn true;\n}\n\nfn str_len_cstr(p *u8) i64 {\n\tvar n i64 = 0;\n\twhile (p[n] != 0) { n = n + 1; }\n\treturn n;\n}\n\nfn str_from_cstr(p *u8) str {\n\tvar s str;\n\ts.ptr = p;\n\ts.len = str_len_cstr(p);\n\treturn s;\n}\n\nfn str_slice(s str, lo i64, hi i64) str {\n\tvar r str;\n\tr.ptr = s.ptr + lo;\n\tr.len = hi - lo;\n\treturn r;\n}\n\nfn str_find(s str, c u8) i64 {\n\tvar i i64 = 0;\n\twhile (i < s.len) {\n\t\tif (s.ptr[i] == c) { return i; }\n\t\ti = i + 1;\n\t}\n\treturn -1;\n}\n\nfn str_dup(s str) str {\n\tvar p *u8 = arena_alloc(s.len + 1, 1);\n\tvar i i64 = 0;\n\twhile (i < s.len) { p[i] = s.ptr[i]; i = i + 1; }\n\tp[s.len] = 0;\n\tvar r str;\n\tr.ptr = p;\n\tr.len = s.len;\n\treturn r;\n}\n\n// NUL-terminated copy, for paths handed to a syscall.\nfn cstr(s str) *u8 {\n\treturn str_dup(s).ptr;\n}\n\nfn str_from_char(c u8) str {\n\tvar p *u8 = arena_alloc(1, 1);\n\tp[0] = c;\n\tvar r str;\n\tr.ptr = p;\n\tr.len = 1;\n\treturn r;\n}\n"; }
	if (i == 20) { return "// The only place in stage1 where a raw syscall is allowed.\nimport \"str.qela\";\n\nlet SYS_READ  = 0;\nlet SYS_WRITE = 1;\nlet SYS_OPEN  = 2;\nlet SYS_CLOSE = 3;\nlet SYS_STAT  = 4;\nlet SYS_MMAP  = 9;\nlet SYS_EXIT   = 60;\nlet SYS_EXIT_GROUP = 231;\nlet SYS_FORK   = 57;\nlet SYS_EXECVE = 59;\nlet SYS_WAIT4  = 61;\nlet SYS_UNLINK = 87;\nlet SYS_GETPID = 39;\nlet SYS_GETDENTS = 217;\nlet SYS_DUP2 = 33;\nlet SYS_IOCTL = 16;\nlet SYS_MUNMAP = 11;\nlet SYS_CLONE = 56;\nlet SYS_ARCH_PRCTL = 158;\nlet SYS_FUTEX = 202;\nlet SYS_SCHED_YIELD = 24;\nlet SYS_READLINK = 89;\nlet SYS_MEMFD_CREATE = 319;\nlet SYS_EXECVEAT = 322;\nlet SYS_PIPE2 = 293;\nlet SYS_SOCKETPAIR = 53;\n\n$if (TARGET != \"x86_64\") {\nlet SYS_READ_N  = 63;\nlet SYS_WRITE_N = 64;\nlet SYS_OPENAT_N = 56;\nlet SYS_CLOSE_N = 57;\nlet SYS_NEWFSTATAT_N = 79;\nlet SYS_MMAP_N  = 222;\nlet SYS_EXIT_N   = 93;\nlet SYS_EXIT_GROUP_N = 94;\nlet SYS_EXECVE_N = 221;\nlet SYS_WAIT4_N  = 260;\nlet SYS_UNLINKAT_N = 35;\nlet SYS_GETPID_N = 172;\nlet SYS_GETDENTS_N = 61;\nlet SYS_DUP3_N = 24;\nlet SYS_IOCTL_N = 29;\nlet SYS_MUNMAP_N = 215;\nlet SYS_CLONE_N = 220;\nlet SYS_FUTEX_N = 98;\nlet SYS_SCHED_YIELD_N = 124;\nlet SYS_READLINKAT_N = 78;\nlet SYS_MEMFD_CREATE_N = 279;\nlet SYS_EXECVEAT_N = 281;\nlet SYS_PIPE2_N = 59;\nlet SYS_SOCKETPAIR_N = 199;\nlet AT_FDCWD = -100;\n}\n\nlet AT_EMPTY_PATH = 0x1000;\nlet AF_UNIX = 1;\nlet SOCK_STREAM = 1;\n\nlet ARCH_SET_FS = 0x1002;\nlet ARCH_GET_FS = 0x1003;\n\nlet FUTEX_WAIT = 0;\nlet FUTEX_WAKE = 1;\n\n// CLONE_VM(0x100)|CLONE_FS(0x200)|CLONE_FILES(0x400)|CLONE_SIGHAND(0x800)|\n// CLONE_THREAD(0x10000) -- a real OS thread sharing the parent's address\n// space, not a fork. No CLONE_SETTLS yet: that lands with the tvar/TLS\n// phase, once there's a per-thread block to point %fs at. arm64 adds\n// CLONE_SYSVSEM(0x40000): qemu user-mode rejects the bare thread set with\n// EINVAL, and real kernels accept both forms.\n$if (TARGET != \"x86_64\") {\nlet CLONE_THREAD_FLAGS = 331520;\n} $else {\nlet CLONE_THREAD_FLAGS = 69376;\n}\n\nlet STDOUT = 1;\nlet STDERR = 2;\n\nlet O_WRITE_NEW   = 577;  // O_WRONLY | O_CREAT | O_TRUNC\nlet O_WRITE_APPEND = 1089; // O_WRONLY | O_CREAT | O_APPEND\n\nfn sys_read(fd i64, buf *u8, n i64) i64 {\n\t$if (TARGET != \"x86_64\") {\n\t\treturn syscall(SYS_READ_N, fd, buf as i64, n);\n\t}\n\treturn syscall(SYS_READ, fd, buf as i64, n);\n}\n\nfn sys_write(fd i64, buf *u8, n i64) i64 {\n\t$if (TARGET != \"x86_64\") {\n\t\treturn syscall(SYS_WRITE_N, fd, buf as i64, n);\n\t}\n\treturn syscall(SYS_WRITE, fd, buf as i64, n);\n}\n\nfn sys_open_read(path *u8) i64 {\n\t$if (TARGET != \"x86_64\") {\n\t\treturn syscall(SYS_OPENAT_N, AT_FDCWD, path as i64, 0, 0);\n\t}\n\treturn syscall(SYS_OPEN, path as i64, 0, 0);\n}\n\nfn sys_open_exec(path *u8) i64 {\n\t$if (TARGET != \"x86_64\") {\n\t\treturn syscall(SYS_OPENAT_N, AT_FDCWD, path as i64, O_WRITE_NEW, 493);\n\t}\n\treturn syscall(SYS_OPEN, path as i64, O_WRITE_NEW, 493);\n}\n\nfn sys_open_append(path *u8) i64 {\n\t$if (TARGET != \"x86_64\") {\n\t\treturn syscall(SYS_OPENAT_N, AT_FDCWD, path as i64, O_WRITE_APPEND, 493);\n\t}\n\treturn syscall(SYS_OPEN, path as i64, O_WRITE_APPEND, 493);\n}\n\nfn sys_close(fd i64) i64 {\n\t$if (TARGET != \"x86_64\") {\n\t\treturn syscall(SYS_CLOSE_N, fd, 0, 0);\n\t}\n\treturn syscall(SYS_CLOSE, fd, 0, 0);\n}\n\nfn sys_mmap_anon(n i64) i64 {\n\t$if (TARGET != \"x86_64\") {\n\t\treturn syscall(SYS_MMAP_N, 0, n, 3, 34, -1, 0);\n\t}\n\treturn syscall(SYS_MMAP, 0, n, 3, 34, -1, 0);\n}\n\nfn sys_munmap(addr i64, n i64) i64 {\n\t$if (TARGET != \"x86_64\") {\n\t\treturn syscall(SYS_MUNMAP_N, addr, n, 0);\n\t}\n\treturn syscall(SYS_MUNMAP, addr, n, 0);\n}\n\n// Raw x86-64 clone() argument order: flags, child stack top, parent tid\n// pointer, child tid pointer, tls base. The caller builds the child's\n// initial stack image itself -- there is no libc clone() wrapper to hide\n// that behind. ARM64 clone() takes the same argument order.\nfn sys_clone(flags i64, stack i64, ptid i64, ctid i64, tls i64) i64 {\n\t$if (TARGET != \"x86_64\") {\n\t\treturn syscall(SYS_CLONE_N, flags, stack, ptid, ctid, tls);\n\t}\n\treturn syscall(SYS_CLONE, flags, stack, ptid, ctid, tls);\n}\n\nfn sys_arch_prctl(code i64, addr i64) i64 {\n\treturn syscall(SYS_ARCH_PRCTL, code, addr, 0);\n}\n\nfn sys_futex(uaddr *i64, op i64, val i64, timeout i64) i64 {\n\t$if (TARGET != \"x86_64\") {\n\t\treturn syscall(SYS_FUTEX_N, uaddr as i64, op, val, timeout, 0, 0);\n\t}\n\treturn syscall(SYS_FUTEX, uaddr as i64, op, val, timeout, 0, 0);\n}\n\n// Gives up the rest of this thread's timeslice, so a spin-wait doesn't\n// starve another thread of the core it needs to make progress.\nfn sys_sched_yield() {\n\t$if (TARGET != \"x86_64\") {\n\t\tsyscall(SYS_SCHED_YIELD_N, 0, 0, 0, 0, 0, 0);\n\t\treturn;\n\t}\n\tsyscall(SYS_SCHED_YIELD, 0, 0, 0, 0, 0, 0);\n}\n\n// exit_group, not exit: this ends the whole process, not just the calling\n// thread. A program that has spawned real OS threads (thread_clone,\n// thread_pool_init/go) and then hits any of this module's early-exit paths\n// (die(), a file error, ...) would otherwise only kill the calling thread --\n// every other thread (a pool worker's own infinite loop, in particular)\n// keeps running forever, holding stdout/stderr open and the process alive\n// as far as anything waiting on it (a shell's `$(...)`, `wait4`) can tell.\n// Found by exactly that: a corpus test hung forever under a plain foreground\n// run once its debug-log write hit a permission error and called die(),\n// confirmed with `strace -f` showing a bare exit(1) (not exit_group) while\n// four pool-worker threads kept running.\nfn sys_exit(code i64) {\n\t$if (TARGET != \"x86_64\") {\n\t\tsyscall(SYS_EXIT_GROUP_N, code, 0, 0, 0, 0, 0);\n\t} $else {\n\t\tsyscall(SYS_EXIT_GROUP, code, 0, 0, 0, 0, 0);\n\t}\n}\n\nfn sys_fork() i64 {\n\t$if (TARGET != \"x86_64\") {\n\t\treturn syscall(SYS_CLONE_N, 17, 0, 0, 0, 0);\n\t}\n\tre