	if (i == 6) { return "import \"sys.qela\";\nimport \"buf.qela\";\nimport \"str.qela\";\n\nlet IO_CHUNK = 65536;\n\nfn die(msg str) {\n\teprint(msg);\n\teprint(\"\\n\");\n\tsys_exit(1);\n}\n\nfn file_exists(path str) bool {\n\tvar fd i64 = sys_open_read(cstr(path));\n\tif (fd < 0) { return false; }\n\tsys_close(fd);\n\treturn true;\n}\n\nfn read_file(path str) str {\n\tvar fd i64 = sys_open_read(cstr(path));\n\tif (fd < 0) {\n\t\teprint(\"error: cannot open \");\n\t\teprint(path);\n\t\teprint(\"\\n\");\n\t\tsys_exit(1);\n\t}\n\tvar b Buf;\n\tvar got i64 = 1;\n\twhile (got > 0) {\n\t\tbuf_grow(&b, IO_CHUNK);\n\t\tgot = sys_read(fd, b.p + b.n, IO_CHUNK);\n\t\tif (got > 0) { b.n = b.n + got; }\n\t}\n\tsys_close(fd);\n\treturn buf_str(&b);\n}\n\nfn read_stdin() str {\n\tvar b Buf;\n\tvar got i64 = 1;\n\twhile (got > 0) {\n\t\tbuf_grow(&b, IO_CHUNK);\n\t\tgot = sys_read(0, b.p + b.n, IO_CHUNK);\n\t\tif (got > 0) { b.n = b.n + got; }\n\t}\n\treturn buf_str(&b);\n}\n\nfn write_file(path str, data *u8, n i64) {\n\tvar fd i64 = sys_open_exec(cstr(path));\n\tif (fd < 0) {\n\t\teprint(\"error: cannot write \");\n\t\teprint(path);\n\t\teprint(\"\\n\");\n\t\tsys_exit(1);\n\t}\n\tvar off i64 = 0;\n\twhile (off < n) {\n\t\tvar wrote i64 = sys_write(fd, data + off, n - off);\n\t\tif (wrote <= 0) { die(\"error: short write\"); }\n\t\toff = off + wrote;\n\t}\n\tsys_close(fd);\n}\n"; }
	if (i == 7) { return "import \"arena.qela\";\n\n// Growable pointer array. Elements are opaque *u8; the caller casts.\n//Doubles+ when full. Never frees.\nstruct List {\n\tdata *u8,\n\tlen  i64,\n\tcap  i64,\n}\n\nfn list_grow(l *List, need i64) {\n\tif (l.len + need <= l.cap) { return; }\n\tvar cap i64 = l.cap;\n\tif (cap == 0) { cap = 16; }\n\twhile (cap < l.len + need) { cap = cap * 2; }\n\tvar r *u8 = arena_alloc(cap * 8, 8);\n\tif (r as i64 == 0) { return; }\n\tvar i i64 = 0;\n\twhile (i < l.len) {\n\t\t// Copy 8-byte pointers.\n\t\tvar src *i64 = (l.data as *i64) + i;\n\t\tvar dst *i64 = (r as *i64) + i;\n\t\t*dst = *src;\n\t\ti = i + 1;\n\t}\n\tl.data = r;\n\tl.cap = cap;\n}\n\nfn list_push(l *List, p *u8) {\n\tlist_grow(l, 1);\n\tvar slot *i64 = (l.data as *i64) + l.len;\n\t*slot = p as i64;\n\tl.len = l.len + 1;\n}\n\nfn list_get(l *List, i i64) *u8 {\n\tif (i < 0 || i >= l.len) { return 0 as *u8; }\n\tvar slot *i64 = (l.data as *i64) + i;\n\treturn *slot as *u8;\n}\n\nfn list_len(l *List) i64 {\n\treturn l.len;\n}\n"; }
	if (i == 8) { return "import \"arena.qela\";\nimport \"str.qela\";\n\n// str -> *u8 map with insertion-order iteration and O(N) lookup.\n// N is tiny in a compiler, so the array is fine.\n\nstruct MapEntry {\n\tkey  str,\n\tval  *u8,\n}\n\nstruct Map {\n\tentries *MapEntry,\n\tn       i64,\n\tcap     i64,\n}\n\nfn map_grow(m *Map, need i64) {\n\tif (m.n + need <= m.cap) { return; }\n\tvar cap i64 = m.cap;\n\tif (cap == 0) { cap = 16; }\n\twhile (cap < m.n + need) { cap = cap * 2; }\n\tvar r *MapEntry = arena_alloc(cap * 24, 8) as *MapEntry;\n\tvar i i64 = 0;\n\twhile (i < m.n) { *(r + i) = *(m.entries + i); i = i + 1; }\n\tm.entries = r;\n\tm.cap = cap;\n}\n\nfn map_get(m *Map, key str) *u8 {\n\tvar i i64 = 0;\n\twhile (i < m.n) {\n\t\tvar e *MapEntry = m.entries + i;\n\t\tif (str_eq(key, e.key)) { return e.val; }\n\t\ti = i + 1;\n\t}\n\treturn 0 as *u8;\n}\n\nfn map_put(m *Map, key str, val *u8) {\n\t// Update existing key.\n\tvar i i64 = 0;\n\twhile (i < m.n) {\n\t\tvar e *MapEntry = m.entries + i;\n\t\tif (str_eq(key, e.key)) { e.val = val; return; }\n\t\ti = i + 1;\n\t}\n\t// New entry.\n\tmap_grow(m, 1);\n\tvar e *MapEntry = m.entries + m.n;\n\te.key = key;\n\te.val = val;\n\tm.n = m.n + 1;\n}\n\nfn map_len(m *Map) i64 { return m.n; }\n\nfn map_key(m *Map, i i64) str {\n\tif (i < 0 || i >= m.n) {\n\t\tvar s str;\n\t\ts.ptr = 0 as *u8; s.len = 0;\n\t\treturn s;\n\t}\n\tvar e *MapEntry = m.entries + i;\n\treturn e.key;\n}\n\nfn map_val(m *Map, i i64) *u8 {\n\tif (i < 0 || i >= m.n) { return 0 as *u8; }\n\tvar e *MapEntry = m.entries + i;\n\treturn e.val;\n}\n"; }
	if (i == 9) { return "import \"arena.qela\";\n\nfn str_eq(a str, b str) bool {\n\tif (a.len != b.len) { return false; }\n\tvar i i64 = 0;\n\twhile (i < a.len) {\n\t\tif (a.ptr[i] != b.ptr[i]) { return false; }\n\t\ti = i + 1;\n\t}\n\treturn true;\n}\n\nfn str_len_cstr(p *u8) i64 {\n\tvar n i64 = 0;\n\twhile (p[n] != 0) { n = n + 1; }\n\treturn n;\n}\n\nfn str_from_cstr(p *u8) str {\n\tvar s str;\n\ts.ptr = p;\n\ts.len = str_len_cstr(p);\n\treturn s;\n}\n\nfn str_slice(s str, lo i64, hi i64) str {\n\tvar r str;\n\tr.ptr = s.ptr + lo;\n\tr.len = hi - lo;\n\treturn r;\n}\n\nfn str_find(s str, c u8) i64 {\n\tvar i i64 = 0;\n\twhile (i < s.len) {\n\t\tif (s.ptr[i] == c) { return i; }\n\t\ti = i + 1;\n\t}\n\treturn -1;\n}\n\nfn str_dup(s str) str {\n\tvar p *u8 = arena_alloc(s.len + 1, 1);\n\tvar i i64 = 0;\n\twhile (i < s.len) { p[i] = s.ptr[i]; i = i + 1; }\n\tp[s.len] = 0;\n\tvar r str;\n\tr.ptr = p;\n\tr.len = s.len;\n\treturn r;\n}\n\n// NUL-terminated copy, for paths handed to a syscall.\nfn cstr(s str) *u8 {\n\treturn str_dup(s).ptr;\n}\n"; }
	if (i == 10) { return "// The only place in stage1 where a raw syscall is allowed.\n\nlet SYS_READ  = 0;\nlet SYS_WRITE = 1;\nlet SYS_OPEN  = 2;\nlet SYS_CLOSE = 3;\nlet SYS_MMAP  = 9;\nlet SYS_EXIT   = 60;\nlet SYS_FORK   = 57;\nlet SYS_EXECVE = 59;\nlet SYS_WAIT4  = 61;\nlet SYS_UNLINK = 87;\nlet SYS_GETPID = 39;\n\nlet STDOUT = 1;\nlet STDERR = 2;\n\nlet O_WRITE_NEW   = 577;  // O_WRONLY | O_CREAT | O_TRUNC\nlet O_WRITE_APPEND = 1089; // O_WRONLY | O_CREAT | O_APPEND\n\nfn sys_read(fd i64, buf *u8, n i64) i64 {\n\treturn syscall(SYS_READ, fd, buf as i64, n);\n}\n\nfn sys_write(fd i64, buf *u8, n i64) i64 {\n\treturn syscall(SYS_WRITE, fd, buf as i64, n);\n}\n\nfn sys_open_read(path *u8) i64 {\n\treturn syscall(SYS_OPEN, path as i64, 0, 0);\n}\n\nfn sys_open_exec(path *u8) i64 {\n\treturn syscall(SYS_OPEN, path as i64, O_WRITE_NEW, 493);\n}\n\nfn sys_open_append(path *u8) i64 {\n\treturn syscall(SYS_OPEN, path as i64, O_WRITE_APPEND, 493);\n}\n\nfn sys_close(fd i64) i64 {\n\treturn syscall(SYS_CLOSE, fd, 0, 0);\n}\n\nfn sys_mmap_anon(n i64) i64 {\n\treturn syscall(SYS_MMAP, 0, n, 3, 34, -1, 0);\n}\n\nfn sys_exit(code i64) {\n\tsyscall(SYS_EXIT, code, 0, 0, 0, 0, 0);\n}\n\nfn sys_fork() i64 { return syscall(SYS_FORK, 0, 0, 0); }\n\nfn sys_execve(path *u8, argv *u8, envp *u8) i64 {\n\treturn syscall(SYS_EXECVE, path as i64, argv as i64, envp as i64);\n}\n\nfn sys_wait4(pid i64, status *u8) i64 {\n\treturn syscall(SYS_WAIT4, pid, status as i64, 0, 0);\n}\n\nfn sys_unlink(path *u8) i64 { return syscall(SYS_UNLINK, path as i64, 0, 0); }\n\nfn sys_getpid() i64 { return syscall(SYS_GETPID, 0, 0, 0); }\n\nfn write_str(fd i64, s str) {\n\tsys_write(fd, s.ptr, s.len);\n}\n\nfn eprint(s str) {\n\tsys_write(STDERR, s.ptr, s.len);\n}\n"; }
	return "";
}
