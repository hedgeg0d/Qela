	if (i == 8) { return "import \"arena.qela\";\nimport \"buf.qela\";\nimport \"str.qela\";\nimport \"sys.qela\";\n\nfn fmt_i64(b *Buf, v i64) {\n\tvar neg bool = v < 0;\n\tif (neg) { v = -v; }\n\tvar rev [24]u8;\n\tvar n i64 = 0;\n\tif (v == 0) { rev[0] = '0'; n = 1; }\n\twhile (v > 0) {\n\t\trev[n] = ('0' as i64 + v % 10) as u8;\n\t\tv = v / 10;\n\t\tn = n + 1;\n\t}\n\tif (neg) { rev[n] = '-'; n = n + 1; }\n\twhile (n > 0) { n = n - 1; buf_u8(b, rev[n]); }\n}\n\n// Same as fmt_i64 but writes directly to a file descriptor: no Buf\n// allocation, no copy. Used by diagnostics on stderr.\nfn fmt_i64_to_fd(fd i64, v i64) {\n\tvar neg bool = v < 0;\n\tif (neg) { v = -v; }\n\tvar rev [24]u8;\n\tvar n i64 = 0;\n\tif (v == 0) { rev[0] = '0'; n = 1; }\n\twhile (v > 0) {\n\t\trev[n] = ('0' as i64 + v % 10) as u8;\n\t\tv = v / 10;\n\t\tn = n + 1;\n\t}\n\tif (neg) { rev[n] = '-'; n = n + 1; }\n\twhile (n > 0) { n = n - 1; sys_write(fd, &rev[n], 1); }\n}\n\nfn fmt_hex(b *Buf, v i64) {\n\tvar hex [16]u8;\n\thex[0] = '0'; hex[1] = '1'; hex[2] = '2'; hex[3] = '3';\n\thex[4] = '4'; hex[5] = '5'; hex[6] = '6'; hex[7] = '7';\n\thex[8] = '8'; hex[9] = '9'; hex[10] = 'a'; hex[11] = 'b';\n\thex[12] = 'c'; hex[13] = 'd'; hex[14] = 'e'; hex[15] = 'f';\n\tvar i i64 = 60;\n\twhile (i >= 0) {\n\t\tvar d i64 = (v >> i) & 15;\n\t\tbuf_u8(b, hex[d]);\n\t\ti = i - 4;\n\t}\n}\n\nfn fmt_str(b *Buf, s str) {\n\tbuf_bytes(b, s.ptr, s.len);\n}\n\n// The by-value chain behind \"...\" string interpolation: the compiler\n// rewrites an interpolated string into fmt_result(fmt_put_*(...,\n// fmt_begin())). Each chain allocates its own buffer, so two interpolated\n// strings alive at once never alias. Note for maintainers: this module's\n// text is embedded in the compiler as a string literal, so the two\n// characters that start an interpolation must never appear here.\nfn fmt_begin() Buf {\n\tvar b Buf;\n\treturn b;\n}\n\nfn fmt_put_str(b Buf, s str) Buf {\n\tbuf_bytes(&b, s.ptr, s.len);\n\treturn b;\n}\n\nfn fmt_put_i64(b Buf, v i64) Buf {\n\tfmt_i64(&b, v);\n\treturn b;\n}\n\nfn fmt_put_hex(b Buf, v i64) Buf {\n\tfmt_hex(&b, v);\n\treturn b;\n}\n\nfn fmt_result(b Buf) str {\n\tvar s str;\n\ts.ptr = b.p;\n\ts.len = b.n;\n\treturn s;\n}\n\n// Float printing, pure integer arithmetic: stage0 compiles this module with\n// no float support, so a float never appears here as a value — the caller\n// passes the raw IEEE754 bit pattern as an i64, converted digit-by-digit on\n// a binary big-number array.\nlet FDIG_CAP = 1200;\n\n// Divides the MSB-first bit array by 10 in place; returns the remainder,\n// the next decimal digit from the low end (used to print an exact integer).\nfn fdig_div10(a *u8, start i64, end i64) i64 {\n\tvar rem i64 = 0;\n\tvar i i64 = start;\n\twhile (i < end) {\n\t\tvar cur i64 = rem * 2 + (a[i] as i64);\n\t\ta[i] = (cur / 10) as u8;\n\t\trem = cur % 10;\n\t\ti = i + 1;\n\t}\n\treturn rem;\n}\n\n// Multiplies the MSB-first bit array by 10 in place; the overflow past the\n// array's own width is the next decimal digit (used to print a fraction).\nfn fdig_mul10(a *u8, start i64, end i64) i64 {\n\tvar carry i64 = 0;\n\tvar i i64 = end - 1;\n\twhile (i >= start) {\n\t\tvar v i64 = (a[i] as i64) * 10 + carry;\n\t\ta[i] = (v % 2) as u8;\n\t\tcarry = v / 2;\n\t\ti = i - 1;\n\t}\n\treturn carry;\n}\n\nfn fdig_allzero(a *u8, start i64, end i64) bool {\n\tvar i i64 = start;\n\twhile (i < end) {\n\t\tif (a[i] != 0) { return false; }\n\t\ti = i + 1;\n\t}\n\treturn true;\n}\n\n// bits: the raw IEEE754 double bit pattern. Ties round half-up rather than\n// half-to-even and denormals print as 0 -- acceptable for a hobby compiler,\n// not for a libc (dec_to_f64_bits carries the same limitations).\nfn fmt_f64_bits(b *Buf, bits i64) {\n\tvar sign i64 = (bits >> 63) & 1;\n\tvar expf i64 = (bits >> 52) & 0x7ff;\n\tvar mant i64 = bits & 0xfffffffffffff;\n\n\tif (sign != 0) { buf_u8(b, '-'); }\n\n\tif (expf == 0x7ff) {\n\t\tif (mant == 0) { fmt_str(b, \"inf\"); } else { fmt_str(b, \"nan\"); }\n\t\treturn;\n\t}\n\tif (expf == 0 && mant == 0) { fmt_str(b, \"0\"); return; }\n\n\tvar m i64 = mant;\n\tvar e i64 = 0;\n\tif (expf == 0) {\n\t\te = 1 - 1023 - 52;\n\t} else {\n\t\tm = mant | 0x10000000000000;\n\t\te = expf - 1023 - 52;\n\t}\n\n\t// m's 53 significant bits, MSB first.\n\tvar mbits [53]u8;\n\tvar i i64 = 0;\n\twhile (i < 53) {\n\t\tmbits[i] = ((m >> (52 - i)) & 1) as u8;\n\t\ti = i + 1;\n\t}\n\n\tif (e >= 0) {\n\t\t// An exact integer: pad m with e zero bits and read decimal digits\n\t\t// off the low end.\n\t\tvar n i64 = 53 + e;\n\t\tvar arr *u8 = arena_alloc(n, 1);\n\t\ti = 0;\n\t\twhile (i < 53) { arr[i] = mbits[i]; i = i + 1; }\n\t\ti = 53;\n\t\twhile (i < n) { arr[i] = 0; i = i + 1; }\n\n\t\tvar digs *u8 = arena_alloc(n, 1);\n\t\tvar nd i64 = 0;\n\t\twhile (!fdig_allzero(arr, 0, n) && nd < FDIG_CAP) {\n\t\t\tdigs[nd] = fdig_div10(arr, 0, n) as u8;\n\t\t\tnd = nd + 1;\n\t\t}\n\t\tif (nd == 0) { buf_u8(b, '0'); }\n\t\telse {\n\t\t\ti = nd;\n\t\t\twhile (i > 0) { i = i - 1; buf_u8(b, ('0' as i64 + (digs[i] as i64)) as u8); }\n\t\t}\n\t\treturn;\n\t}\n\n\tvar w i64 = -e;\n\tif (w >= 53) { buf_u8(b, '0'); }\n\telse { fmt_i64(b, m >> w); }\n\tbuf_u8(b, '.');\n\n\tvar frac *u8 = arena_alloc(w, 1);\n\tif (w > 53) {\n\t\ti = 0;\n\t\twhile (i < w - 53) { frac[i] = 0; i = i + 1; }\n\t\tvar j i64 = 0;\n\t\twhile (j < 53) { frac[w - 53 + j] = mbits[j]; j = j + 1; }\n\t} else {\n\t\ti = 0;\n\t\twhile (i < w) { frac[i] = mbits[53 - w + i]; i = i + 1; }\n\t}\n\n\t// A double carries at most ~17 significant decimal digits; past that the\n\t// exact binary-to-decimal expansion is just noise. Leading zeros before\n\t// the first nonzero digit do not count against the cap.\n\tvar printed i64 = 0;\n\tvar any bool = false;\n\tvar sig i64 = 0;\n\twhile (printed < w && sig < 17) {\n\t\tif (fdig_allzero(frac, 0, w)) { break; }\n\t\tvar d i64 = fdig_mul10(frac, 0, w);\n\t\tbuf_u8(b, ('0' as i64 + d) as u8);\n\t\tany = true;\n\t\tprinted = printed