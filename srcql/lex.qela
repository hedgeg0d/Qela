import "comp.qela";

var lex_base i64 = 0;

fn str_eq(a str, b str) int {
	if (a.len != b.len) { return 0; }
	var i i64 = 0;
	while (i < a.len) {
		var ca u8 = *(a.ptr as *u8 + i);
		var cb u8 = *(b.ptr as *u8 + i);
		if (ca != cb) { return 0; }
		i = i + 1;
	}
	return 1;
}

fn is_space(c u8) int {
	return (c == 32) | (c == 9) | (c == 13) | (c == 10);
}

fn is_digit(c u8) int {
	return (c >= 48) & (c <= 57);
}

fn is_letter(c u8) int {
	return ((c >= 65) & (c <= 90)) | ((c >= 97) & (c <= 122)) | (c == 95);
}

fn is_keyword(s str) int {
	if (str_eq(s, "fn")) { return 1; }
	if (str_eq(s, "let")) { return 1; }
	if (str_eq(s, "var")) { return 1; }
	if (str_eq(s, "if")) { return 1; }
	if (str_eq(s, "else")) { return 1; }
	if (str_eq(s, "while")) { return 1; }
	if (str_eq(s, "for")) { return 1; }
	if (str_eq(s, "in")) { return 1; }
	if (str_eq(s, "break")) { return 1; }
	if (str_eq(s, "continue")) { return 1; }
	if (str_eq(s, "return")) { return 1; }
	if (str_eq(s, "as")) { return 1; }
	if (str_eq(s, "struct")) { return 1; }
	if (str_eq(s, "enum")) { return 1; }
	if (str_eq(s, "match")) { return 1; }
	if (str_eq(s, "defer")) { return 1; }
	if (str_eq(s, "import")) { return 1; }
	if (str_eq(s, "comptime")) { return 1; }
	if (str_eq(s, "sizeof")) { return 1; }
	return 0;
}

