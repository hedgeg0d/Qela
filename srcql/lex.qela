import "comp.qela";
import "diag.qela";

var lex_base i64 = 0;

// Only the formatter wants comments; the parser never sees them.
var lex_keep_comments bool = false;
var lex_tail *Token;

fn push_token(kind int, pos i64) *Token {
	var t *Token = arena_alloc(sizeof(Token), 8) as *Token;
	t.kind = kind;
	t.pos = pos + lex_base;
	lex_tail.next = t;
	lex_tail = t;
	return t;
}

fn is_space(c u8) bool {
	return c == ' ' || c == '\t' || c == '\r' || c == '\n';
}

fn is_digit(c u8) bool {
	return c >= '0' && c <= '9';
}

fn is_letter(c u8) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

fn is_ident_char(c u8) bool {
	return is_letter(c) || is_digit(c);
}

fn lex_src_eq(src str, hi i64, lit str) bool {
	if (hi - hi != lit.len) { return false; }
	var i i64 = 0;
	while (i < lit.len) {
		if (src.ptr[hi + i] != lit.ptr[i]) { return false; }
		i = i + 1;
	}
	return true;
}

fn is_keyword(src str, start i64, end i64) bool {
	if (end - start == 2) {
		if (src.ptr[start] == 'f' && src.ptr[start + 1] == 'n') { return true; }
		if (src.ptr[start] == 'i' && src.ptr[start + 1] == 'f') { return true; }
		if (src.ptr[start] == 'i' && src.ptr[start + 1] == 'n') { return true; }
		if (src.ptr[start] == 'a' && src.ptr[start + 1] == 's') { return true; }
		return false;
	}
	if (end - start == 3) {
		if (src.ptr[start] == 'l' && src.ptr[start + 1] == 'e' && src.ptr[start + 2] == 't') { return true; }
		if (src.ptr[start] == 'v' && src.ptr[start + 1] == 'a' && src.ptr[start + 2] == 'r') { return true; }
		if (src.ptr[start] == 'f' && src.ptr[start + 1] == 'o' && src.ptr[start + 2] == 'r') { return true; }
		return false;
	}
	if (end - start == 4) {
		if (src.ptr[start] == 'e' && src.ptr[start + 1] == 'l' && src.ptr[start + 2] == 's' && src.ptr[start + 3] == 'e') { return true; }
		if (src.ptr[start] == 'e' && src.ptr[start + 1] == 'n' && src.ptr[start + 2] == 'u' && src.ptr[start + 3] == 'm') { return true; }
		if (src.ptr[start] == 't' && src.ptr[start + 1] == 'r' && src.ptr[start + 2] == 'u' && src.ptr[start + 3] == 'e') { return true; }
		return false;
	}
	if (end - start == 5) {
		if (src.ptr[start] == 'w' && src.ptr[start+1] == 'h' && src.ptr[start+2] == 'i' && src.ptr[start+3] == 'l' && src.ptr[start+4] == 'e') { return true; }
		if (src.ptr[start] == 'b' && src.ptr[start+1] == 'r' && src.ptr[start+2] == 'e' && src.ptr[start+3] == 'a' && src.ptr[start+4] == 'k') { return true; }
		if (src.ptr[start] == 'm' && src.ptr[start+1] == 'a' && src.ptr[start+2] == 'c' && src.ptr[start+3] == 'r' && src.ptr[start+4] == 'o') { return true; }
		if (src.ptr[start] == 'n' && src.ptr[start+1] == 'a' && src.ptr[start+2] == 'k' && src.ptr[start+3] == 'e' && src.ptr[start+4] == 'd') { return true; }
		if (src.ptr[start] == 'm' && src.ptr[start+1] == 'a' && src.ptr[start+2] == 't' && src.ptr[start+3] == 'c' && src.ptr[start+4] == 'h') { return true; }
		if (src.ptr[start] == 'd' && src.ptr[start+1] == 'e' && src.ptr[start+2] == 'f' && src.ptr[start+3] == 'e' && src.ptr[start+4] == 'r') { return true; }
		if (src.ptr[start] == 'f' && src.ptr[start+1] == 'a' && src.ptr[start+2] == 'l' && src.ptr[start+3] == 's' && src.ptr[start+4] == 'e') { return true; }
		return false;
	}
	if (end - start == 6) {
		if (src.ptr[start] == 'r' && src.ptr[start+1] == 'e' && src.ptr[start+2] == 't' && src.ptr[start+3] == 'u' && src.ptr[start+4] == 'r' && src.ptr[start+5] == 'n') { return true; }
		if (src.ptr[start] == 's' && src.ptr[start+1] == 't' && src.ptr[start+2] == 'r' && src.ptr[start+3] == 'u' && src.ptr[start+4] == 'c' && src.ptr[start+5] == 't') { return true; }
		if (src.ptr[start] == 'i' && src.ptr[start+1] == 'm' && src.ptr[start+2] == 'p' && src.ptr[start+3] == 'o' && src.ptr[start+4] == 'r' && src.ptr[start+5] == 't') { return true; }
		if (src.ptr[start] == 's' && src.ptr[start+1] == 'i' && src.ptr[start+2] == 'z' && src.ptr[start+3] == 'e' && src.ptr[start+4] == 'o' && src.ptr[start+5] == 'f') { return true; }
		return false;
	}
	if (end - start == 8) {
		if (src.ptr[start] == 'c' && src.ptr[start+1] == 'o' && src.ptr[start+2] == 'n' && src.ptr[start+3] == 't' && src.ptr[start+4] == 'i' && src.ptr[start+5] == 'n' && src.ptr[start+6] == 'u' && src.ptr[start+7] == 'e') { return true; }
		if (src.ptr[start] == 'v' && src.ptr[start+1] == 'o' && src.ptr[start+2] == 'l' && src.ptr[start+3] == 'a' && src.ptr[start+4] == 't' && src.ptr[start+5] == 'i' && src.ptr[start+6] == 'l' && src.ptr[start+7] == 'e') { return true; }
		if (src.ptr[start] == 'c' && src.ptr[start+1] == 'o' && src.ptr[start+2] == 'm' && src.ptr[start+3] == 'p' && src.ptr[start+4] == 't' && src.ptr[start+5] == 'i' && src.ptr[start+6] == 'm' && src.ptr[start+7] == 'e') { return true; }
		return false;
	}
	return false;
}

fn read_escape(src str, i *i64) i64 {
	var c u8 = src.ptr[*i];
	*i = *i + 1;
	if (c == 'n') { return '\n'; }
	if (c == 't') { return '\t'; }
	if (c == 'r') { return '\r'; }
	if (c == '0') { return 0; }
	if (c == '\\') { return '\\'; }
	if (c == '"') { return '"'; }
	if (c == '\'') { return '\''; }
	// unknown escape — caller handles error
	return c as i64;
}

// Scans from just past "${" to the matching "}". Strings, char literals
// and comments inside the expression are skipped so their braces do not
// count. Returns the offset of the closing brace and leaves *i past it.
fn interp_end(src str, i *i64, start i64) i64 {
	var depth i64 = 1;
	while (*i < src.len) {
		var c u8 = src.ptr[*i];
		if (c == '\\' && *i + 1 < src.len) { *i = *i + 2; continue; }
		if (c == '"' || c == '\'') {
			*i = *i + 1;
			while (*i < src.len && src.ptr[*i] != c) {
				if (src.ptr[*i] == '\\') { *i = *i + 2; }
				else { *i = *i + 1; }
			}
			if (*i >= src.len) { error_at(lex_base + start, "unterminated string in interpolation"); }
			*i = *i + 1;
			continue;
		}
		if (c == '/' && *i + 1 < src.len && src.ptr[*i + 1] == '/') {
			while (*i < src.len && src.ptr[*i] != '\n') { *i = *i + 1; }
			continue;
		}
		if (c == '/' && *i + 1 < src.len && src.ptr[*i + 1] == '*') {
			*i = *i + 2;
			while (*i + 1 < src.len && !(src.ptr[*i] == '*' && src.ptr[*i + 1] == '/')) { *i = *i + 1; }
			if (*i + 1 >= src.len) { error_at(lex_base + start, "unterminated comment in interpolation"); }
			*i = *i + 2;
			continue;
		}
		if (c == '{') { depth = depth + 1; }
		if (c == '}') {
			depth = depth - 1;
			if (depth == 0) {
				var end i64 = *i;
				*i = *i + 1;
				return end;
			}
		}
		*i = *i + 1;
	}
	error_at(lex_base + start, "unterminated interpolation");
	return 0;
}

fn punct_len(src str, i i64) i64 {
	var len i64 = src.len;
	if (i + 3 <= len) {
		var c u8 = src.ptr[i];
		if (c == '<' && src.ptr[i+1] == '<' && src.ptr[i+2] == '=') { return 3; }
		if (c == '>' && src.ptr[i+1] == '>' && src.ptr[i+2] == '=') { return 3; }
	}
	if (i + 2 <= len) {
		var c0 u8 = src.ptr[i]; var c1 u8 = src.ptr[i+1];
		if (c0 == '=' && c1 == '=') { return 2; }
		if (c0 == '!' && c1 == '=') { return 2; }
		if (c0 == '<' && c1 == '=') { return 2; }
		if (c0 == '>' && c1 == '=') { return 2; }
		if (c0 == '&' && c1 == '&') { return 2; }
		if (c0 == '|' && c1 == '|') { return 2; }
		if (c0 == '+' && c1 == '=') { return 2; }
		if (c0 == '-' && c1 == '=') { return 2; }
		if (c0 == '*' && c1 == '=') { return 2; }
		if (c0 == '/' && c1 == '=') { return 2; }
		if (c0 == '%' && c1 == '=') { return 2; }
		if (c0 == '&' && c1 == '=') { return 2; }
		if (c0 == '|' && c1 == '=') { return 2; }
		if (c0 == '^' && c1 == '=') { return 2; }
		if (c0 == '<' && c1 == '<') { return 2; }
		if (c0 == '>' && c1 == '>') { return 2; }
		if (c0 == '.' && c1 == '.') { return 2; }
		if (c0 == '=' && c1 == '>') { return 2; }
		if (c0 == '<' && c1 == '-') { return 2; }
	}
	return 1;
}

fn is_punct_single(c u8) bool {
	return c == '+' || c == '-' || c == '*' || c == '/' || c == '%' ||
	       c == '(' || c == ')' || c == '[' || c == ']' || c == '{' || c == '}' ||
	       c == ';' || c == ',' || c == '=' || c == '<' || c == '>' ||
	       c == '!' || c == '&' || c == '|' || c == '^' || c == '~' || c == '.' || c == ':' ||
	       c == '$';
}

fn lex(src str, base i64) *Token {
	lex_base = base;
	var head Token;
	lex_tail = &head;
	var i i64 = 0;

	// A shebang line ("#!...") only makes sense at offset zero; `#` anywhere
	// else stays an error. In fmt mode it is kept as a comment token so the
	// formatter does not silently drop a script's first line.
	if (src.len >= 2 && src.ptr[0] == '#' && src.ptr[1] == '!') {
		var cstart i64 = i;
		while (i < src.len && src.ptr[i] != '\n') { i = i + 1; }
		if (lex_keep_comments) {
			var ct *Token = push_token(TK_COMMENT, cstart);
			var cs str;
			cs.ptr = src.ptr + cstart;
			cs.len = i - cstart;
			ct.text = cs;
		}
	}

	while (i < src.len) {
		if (is_space(src.ptr[i])) { i = i + 1; continue; }

		// line comment
		if (src.ptr[i] == '/' && i + 1 < src.len && src.ptr[i + 1] == '/') {
			var cstart i64 = i;
			while (i < src.len && src.ptr[i] != '\n') { i = i + 1; }
			if (lex_keep_comments) {
				var ct *Token = push_token(TK_COMMENT, cstart);
				var cs str;
				cs.ptr = src.ptr + cstart;
				cs.len = i - cstart;
				ct.text = cs;
			}
			continue;
		}

		// block comment
		if (src.ptr[i] == '/' && i + 1 < src.len && src.ptr[i + 1] == '*') {
			var start i64 = i;
			i = i + 2;
			while (i + 1 < src.len && !(src.ptr[i] == '*' && src.ptr[i + 1] == '/')) { i = i + 1; }
			if (i + 1 >= src.len) { error_at(lex_base + start, "unterminated block comment"); }
			i = i + 2;
			if (lex_keep_comments) {
				var bt *Token = push_token(TK_COMMENT, start);
				var bs str;
				bs.ptr = src.ptr + start;
				bs.len = i - start;
				bt.text = bs;
			}
			continue;
		}

		// number (decimal or hex)
		if (is_digit(src.ptr[i])) {
			var start i64 = i;
			var val i64 = 0;
			if (src.ptr[i] == '0' && i + 1 < src.len && (src.ptr[i+1] == 'x' || src.ptr[i+1] == 'X')) {
				i = i + 2;
				while (i < src.len) {
					var c u8 = src.ptr[i];
					var d i64 = 0;
					if (c >= '0' && c <= '9') { d = c as i64 - '0'; }
					else if (c >= 'a' && c <= 'f') { d = c as i64 - 'a' + 10; }
					else if (c >= 'A' && c <= 'F') { d = c as i64 - 'A' + 10; }
					else { break; }
					val = val * 16 + d;
					i = i + 1;
				}
			} else {
				while (i < src.len && is_digit(src.ptr[i])) {
					val = val * 10 + (src.ptr[i] as i64 - '0');
					i = i + 1;
				}
			}
			var t *Token = push_token(TK_NUM, start);
			t.val = val;
			var s str;
			s.ptr = src.ptr + start;
			s.len = i - start;
			t.text = s;
			continue;
		}

		// identifier or keyword
		if (is_letter(src.ptr[i])) {
			var start i64 = i;
			while (i < src.len && is_ident_char(src.ptr[i])) { i = i + 1; }
			var kind int = TK_IDENT;
			if (is_keyword(src, start, i)) { kind = TK_KW; }
			var t *Token = push_token(kind, start);
			var s str;
			s.ptr = src.ptr + start;
			s.len = i - start;
			t.text = s;
			continue;
		}

		// character literal
		if (src.ptr[i] == '\'') {
			var start i64 = i;
			i = i + 1;
			var val i64 = 0;
			if (src.ptr[i] == '\\') {
				i = i + 1;
				val = read_escape(src, &i);
			} else {
				val = src.ptr[i] as i64;
				i = i + 1;
			}
			if (i >= src.len || src.ptr[i] != '\'') {
				error_at(lex_base + start, "unterminated character literal");
			}
			i = i + 1;
			var t *Token = push_token(TK_NUM, start);
			t.val = val;
			var s str;
			s.ptr = src.ptr + start;
			s.len = i - start;
			t.text = s;
			continue;
		}

		// string literal, possibly interpolated: "a=${x}b" lexes as the
		// parts TK_STR("a") "$" "{" <expr tokens> "}" TK_STR("b"), so the
		// parser sees one node shape and the formatter can round-trip the
		// source from the token texts. An escaped `\$` stays a literal
		// dollar; the `$` of an interpolation can never be written that way.
		if (src.ptr[i] == '"') {
			var start i64 = i;
			i = i + 1;
			var part_start i64 = start;
			var buf *u8 = arena_alloc(src.len - i + 2, 1);
			var n i64 = 0;
			while (true) {
				if (i >= src.len || src.ptr[i] == '\n') {
					error_at(lex_base + start, "unterminated string literal");
				}
				if (src.ptr[i] == '"') {
					buf[n] = 0;
					var t *Token = push_token(TK_STR, part_start);
					var sv str;
					sv.ptr = buf;
					sv.len = n;
					t.sval = sv;
					var raw str;
					raw.ptr = src.ptr + part_start;
					raw.len = i - part_start + 1;
					t.text = raw;
					i = i + 1;
					break;
				}
				if (src.ptr[i] == '\\') {
					i = i + 1;
					buf[n] = read_escape(src, &i) as u8;
					n = n + 1;
					continue;
				}
				if (src.ptr[i] == '$' && i + 1 < src.len && src.ptr[i + 1] == '{') {
					var t *Token = push_token(TK_STR, part_start);
					var sv str;
					sv.ptr = buf;
					sv.len = n;
					t.sval = sv;
					var raw str;
					raw.ptr = src.ptr + part_start;
					raw.len = i - part_start;
					t.text = raw;
					var d *Token = push_token(TK_PUNCT, i);
					var ds str;
					ds.ptr = src.ptr + i;
					ds.len = 1;
					d.text = ds;
					var ob *Token = push_token(TK_PUNCT, i + 1);
					var os str;
					os.ptr = src.ptr + i + 1;
					os.len = 1;
					ob.text = os;
					i = i + 2;
					var open i64 = i;
					var end i64 = interp_end(src, &i, start);
					var inner str;
					inner.ptr = src.ptr + open;
					inner.len = end - open;
					// The expression inside lexes with its own head and is
					// spliced after the opening braces; the globals are the
					// outer list's state and must survive the recursion.
					var saved_base i64 = lex_base;
					var saved_tail *Token = lex_tail;
					var ih *Token = lex(inner, lex_base + open);
					var it *Token = ih;
					while (it.next.kind != TK_EOF) { it = it.next; }
					saved_tail.next = ih;
					lex_tail = it;
					lex_base = saved_base;
					var cb *Token = push_token(TK_PUNCT, i - 1);
					var cs str;
					cs.ptr = src.ptr + i - 1;
					cs.len = 1;
					cb.text = cs;
					buf = arena_alloc(src.len - i + 2, 1);
					part_start = i;
					n = 0;
					continue;
				}
				buf[n] = src.ptr[i];
				n = n + 1;
				i = i + 1;
			}
			continue;
		}

		// punctuation
		var plen i64 = punct_len(src, i);
		if (plen == 1 && !is_punct_single(src.ptr[i])) {
			error_at(lex_base + i, "unexpected character");
		}
		var t *Token = push_token(TK_PUNCT, i);
		var s str;
		s.ptr = src.ptr + i;
		s.len = plen;
		t.text = s;
		i = i + plen;
	}

	push_token(TK_EOF, src.len);
	return head.next;
}
