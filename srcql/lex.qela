import "comp.qela";
import "diag.qela";

var lex_base i64 = 0;

// Only the formatter wants comments; the parser never sees them.
var lex_keep_comments bool = false;
var lex_tail *Token;

fn push_token(kind int, pos i64) *Token {
	var t *Token = arena_alloc(sizeof(Token), 8) as *Token;
	t.kind = kind;
	t.pos = pos + lex_base;
	lex_tail.next = t;
	lex_tail = t;
	return t;
}

fn is_space(c u8) bool {
	return c == ' ' || c == '\t' || c == '\r' || c == '\n';
}

fn is_digit(c u8) bool {
	return c >= '0' && c <= '9';
}

fn is_letter(c u8) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

fn is_ident_char(c u8) bool {
	return is_letter(c) || is_digit(c);
}

fn is_keyword(src str, start i64, end i64) bool {
	if (end - start == 2) {
		if (src.ptr[start] == 'f' && src.ptr[start + 1] == 'n') { return true; }
		if (src.ptr[start] == 'i' && src.ptr[start + 1] == 'f') { return true; }
		if (src.ptr[start] == 'i' && src.ptr[start + 1] == 'n') { return true; }
		if (src.ptr[start] == 'a' && src.ptr[start + 1] == 's') { return true; }
		return false;
	}
	if (end - start == 3) {
		if (src.ptr[start] == 'l' && src.ptr[start + 1] == 'e' && src.ptr[start + 2] == 't') { return true; }
		if (src.ptr[start] == 'v' && src.ptr[start + 1] == 'a' && src.ptr[start + 2] == 'r') { return true; }
		if (src.ptr[start] == 'f' && src.ptr[start + 1] == 'o' && src.ptr[start + 2] == 'r') { return true; }
		return false;
	}
	if (end - start == 4) {
		if (src.ptr[start] == 'e' && src.ptr[start + 1] == 'l' && src.ptr[start + 2] == 's' && src.ptr[start + 3] == 'e') { return true; }
		if (src.ptr[start] == 'e' && src.ptr[start + 1] == 'n' && src.ptr[start + 2] == 'u' && src.ptr[start + 3] == 'm') { return true; }
		if (src.ptr[start] == 't' && src.ptr[start + 1] == 'r' && src.ptr[start + 2] == 'u' && src.ptr[start + 3] == 'e') { return true; }
		return false;
	}
	if (end - start == 5) {
		if (src.ptr[start] == 'w' && src.ptr[start+1] == 'h' && src.ptr[start+2] == 'i' && src.ptr[start+3] == 'l' && src.ptr[start+4] == 'e') { return true; }
		if (src.ptr[start] == 'b' && src.ptr[start+1] == 'r' && src.ptr[start+2] == 'e' && src.ptr[start+3] == 'a' && src.ptr[start+4] == 'k') { return true; }
		if (src.ptr[start] == 'm' && src.ptr[start+1] == 'a' && src.ptr[start+2] == 'c' && src.ptr[start+3] == 'r' && src.ptr[start+4] == 'o') { return true; }
		if (src.ptr[start] == 'n' && src.ptr[start+1] == 'a' && src.ptr[start+2] == 'k' && src.ptr[start+3] == 'e' && src.ptr[start+4] == 'd') { return true; }
		if (src.ptr[start] == 'm' && src.ptr[start+1] == 'a' && src.ptr[start+2] == 't' && src.ptr[start+3] == 'c' && src.ptr[start+4] == 'h') { return true; }
		if (src.ptr[start] == 'd' && src.ptr[start+1] == 'e' && src.ptr[start+2] == 'f' && src.ptr[start+3] == 'e' && src.ptr[start+4] == 'r') { return true; }
		if (src.ptr[start] == 'f' && src.ptr[start+1] == 'a' && src.ptr[start+2] == 'l' && src.ptr[start+3] == 's' && src.ptr[start+4] == 'e') { return true; }
		if (src.ptr[start] == 's' && src.ptr[start+1] == 'u' && src.ptr[start+2] == 'p' && src.ptr[start+3] == 'e' && src.ptr[start+4] == 'r') { return true; }
		return false;
	}
	if (end - start == 6) {
		if (src.ptr[start] == 'r' && src.ptr[start+1] == 'e' && src.ptr[start+2] == 't' && src.ptr[start+3] == 'u' && src.ptr[start+4] == 'r' && src.ptr[start+5] == 'n') { return true; }
		if (src.ptr[start] == 's' && src.ptr[start+1] == 't' && src.ptr[start+2] == 'r' && src.ptr[start+3] == 'u' && src.ptr[start+4] == 'c' && src.ptr[start+5] == 't') { return true; }
		if (src.ptr[start] == 'i' && src.ptr[start+1] == 'm' && src.ptr[start+2] == 'p' && src.ptr[start+3] == 'o' && src.ptr[start+4] == 'r' && src.ptr[start+5] == 't') { return true; }
		if (src.ptr[start] == 's' && src.ptr[start+1] == 'i' && src.ptr[start+2] == 'z' && src.ptr[start+3] == 'e' && src.ptr[start+4] == 'o' && src.ptr[start+5] == 'f') { return true; }
		if (src.ptr[start] == 'e' && src.ptr[start+1] == 'x' && src.ptr[start+2] == 't' && src.ptr[start+3] == 'e' && src.ptr[start+4] == 'r' && src.ptr[start+5] == 'n') { return true; }
		return false;
	}
	if (end - start == 8) {
		if (src.ptr[start] == 'c' && src.ptr[start+1] == 'o' && src.ptr[start+2] == 'n' && src.ptr[start+3] == 't' && src.ptr[start+4] == 'i' && src.ptr[start+5] == 'n' && src.ptr[start+6] == 'u' && src.ptr[start+7] == 'e') { return true; }
		if (src.ptr[start] == 'v' && src.ptr[start+1] == 'o' && src.ptr[start+2] == 'l' && src.ptr[start+3] == 'a' && src.ptr[start+4] == 't' && src.ptr[start+5] == 'i' && src.ptr[start+6] == 'l' && src.ptr[start+7] == 'e') { return true; }
		if (src.ptr[start] == 'c' && src.ptr[start+1] == 'o' && src.ptr[start+2] == 'm' && src.ptr[start+3] == 'p' && src.ptr[start+4] == 't' && src.ptr[start+5] == 'i' && src.ptr[start+6] == 'm' && src.ptr[start+7] == 'e') { return true; }
		return false;
	}
	return false;
}

fn read_escape(src str, i *i64) i64 {
	var c u8 = src.ptr[*i];
	*i = *i + 1;
	if (c == 'n') { return '\n'; }
	if (c == 't') { return '\t'; }
	if (c == 'r') { return '\r'; }
	if (c == '0') { return 0; }
	if (c == '\\') { return '\\'; }
	if (c == '"') { return '"'; }
	if (c == '\'') { return '\''; }
	error_at(lex_base + *i - 1, "unknown escape sequence");
	return c as i64;
}

// Scans from just past "${" to the matching "}". Strings, char literals
// and comments inside the expression are skipped so their braces do not
// count. Returns the offset of the closing brace and leaves *i past it.
fn interp_end(src str, i *i64, start i64) i64 {
	var depth i64 = 1;
	while (*i < src.len) {
		var c u8 = src.ptr[*i];
		if (c == '\\' && *i + 1 < src.len) { *i = *i + 2; continue; }
		if (c == '"' || c == '\'') {
			*i = *i + 1;
			while (*i < src.len && src.ptr[*i] != c) {
				if (src.ptr[*i] == '\\') { *i = *i + 2; }
				else { *i = *i + 1; }
			}
			if (*i >= src.len) { error_at(lex_base + start, "unterminated string in interpolation"); }
			*i = *i + 1;
			continue;
		}
		if (c == '/' && *i + 1 < src.len && src.ptr[*i + 1] == '/') {
			while (*i < src.len && src.ptr[*i] != '\n') { *i = *i + 1; }
			continue;
		}
		if (c == '/' && *i + 1 < src.len && src.ptr[*i + 1] == '*') {
			*i = *i + 2;
			while (*i + 1 < src.len && !(src.ptr[*i] == '*' && src.ptr[*i + 1] == '/')) { *i = *i + 1; }
			if (*i + 1 >= src.len) { error_at(lex_base + start, "unterminated comment in interpolation"); }
			*i = *i + 2;
			continue;
		}
		if (c == '{') { depth = depth + 1; }
		if (c == '}') {
			depth = depth - 1;
			if (depth == 0) {
				var end i64 = *i;
				*i = *i + 1;
				return end;
			}
		}
		*i = *i + 1;
	}
	error_at(lex_base + start, "unterminated interpolation");
	return 0;
}

fn punct_len(src str, i i64) i64 {
	var len i64 = src.len;
	if (i + 3 <= len) {
		var c u8 = src.ptr[i];
		if (c == '<' && src.ptr[i+1] == '<' && src.ptr[i+2] == '=') { return 3; }
		if (c == '>' && src.ptr[i+1] == '>' && src.ptr[i+2] == '=') { return 3; }
	}
	if (i + 2 <= len) {
		var c0 u8 = src.ptr[i]; var c1 u8 = src.ptr[i+1];
		if (c0 == '=' && c1 == '=') { return 2; }
		if (c0 == '!' && c1 == '=') { return 2; }
		if (c0 == '<' && c1 == '=') { return 2; }
		if (c0 == '>' && c1 == '=') { return 2; }
		if (c0 == '&' && c1 == '&') { return 2; }
		if (c0 == '|' && c1 == '|') { return 2; }
		if (c0 == '+' && c1 == '=') { return 2; }
		if (c0 == '-' && c1 == '=') { return 2; }
		if (c0 == '*' && c1 == '=') { return 2; }
		if (c0 == '/' && c1 == '=') { return 2; }
		if (c0 == '%' && c1 == '=') { return 2; }
		if (c0 == '&' && c1 == '=') { return 2; }
		if (c0 == '|' && c1 == '=') { return 2; }
		if (c0 == '^' && c1 == '=') { return 2; }
		if (c0 == '<' && c1 == '<') { return 2; }
		if (c0 == '>' && c1 == '>') { return 2; }
		if (c0 == '.' && c1 == '.') { return 2; }
		if (c0 == '=' && c1 == '>') { return 2; }
		if (c0 == '<' && c1 == '-') { return 2; }
	}
	return 1;
}

fn is_punct_single(c u8) bool {
	return c == '+' || c == '-' || c == '*' || c == '/' || c == '%' ||
	       c == '(' || c == ')' || c == '[' || c == ']' || c == '{' || c == '}' ||
	       c == ';' || c == ',' || c == '=' || c == '<' || c == '>' ||
	       c == '!' || c == '&' || c == '|' || c == '^' || c == '~' || c == '.' || c == ':' ||
	       c == '$';
}

// ── decimal literal -> f64 bits, pure integer arithmetic ──
//
// stage0 has no float support, so this must never use one: it converts a
// decimal digit string to the nearest IEEE754 double using only i64 ops, via
// a big-decimal digit array repeatedly halved/doubled toward [1,2). Skips
// subnormals (flushes to 0) and ties round half-up, not half-to-even -- both
// acceptable for a hobby compiler, not for a libc.
//
// value = sum(buf[i] * 10^(pt-1-(i-start))) for i in [start,end).
let DTOA_CAP = 4300;
let DTOA_MID = 2150;

fn dtoa_trim(buf *u8, start *i64, end i64, pt *i64) {
	while (*start < end - 1 && buf[*start] == '0') {
		*start = *start + 1;
		*pt = *pt - 1;
	}
}

// May prepend one digit at start-1. A prepended digit shifts every existing
// digit's index relative to start, so pt (which is defined relative to
// start) has to move with it or every digit's weight silently changes by a
// factor of 10.
fn dtoa_mul2(buf *u8, start *i64, end i64, pt *i64) {
	var carry i64 = 0;
	var i i64 = end - 1;
	while (i >= *start) {
		var v i64 = (buf[i] as i64 - '0') * 2 + carry;
		buf[i] = (v % 10 + '0') as u8;
		carry = v / 10;
		i = i - 1;
	}
	if (carry != 0) {
		*start = *start - 1;
		buf[*start] = (carry + '0') as u8;
		*pt = *pt + 1;
	}
}

// May append one digit at end.
fn dtoa_div2(buf *u8, start i64, end *i64) {
	var borrow i64 = 0;
	var i i64 = start;
	while (i < *end) {
		var v i64 = borrow * 10 + (buf[i] as i64 - '0');
		buf[i] = (v / 2 + '0') as u8;
		borrow = v % 2;
		i = i + 1;
	}
	if (borrow != 0) {
		buf[*end] = '5';
		*end = *end + 1;
	}
}

fn dtoa_inf_bits() i64 { return 0x7ff0000000000000; }

// digits: significant decimal digits, no sign, no '.', no exponent marker.
// point: digits[0] carries weight 10^(point-1). Returns the unsigned-magnitude
// bit pattern of the nearest f64 (0 or +inf on under/overflow).
fn dec_to_f64_bits(digits *u8, ndigits i64, point i64) i64 {
	var i i64 = 0;
	var allzero bool = true;
	while (i < ndigits) { if (digits[i] != '0') { allzero = false; } i = i + 1; }
	if (allzero) { return 0; }

	var buf *u8 = arena_alloc(DTOA_CAP, 1);
	i = 0;
	while (i < ndigits) { buf[DTOA_MID + i] = digits[i]; i = i + 1; }
	var start i64 = DTOA_MID;
	var end i64 = DTOA_MID + ndigits;
	var pt i64 = point;
	dtoa_trim(buf, &start, end, &pt);

	var e2 i64 = 0;
	var iters i64 = 0;
	while (true) {
		if (pt <= 0) {
			if (iters > 1100) { return 0; }
			dtoa_mul2(buf, &start, end, &pt);
			dtoa_trim(buf, &start, end, &pt);
			e2 = e2 - 1;
			iters = iters + 1;
			continue;
		}
		if (pt >= 2) {
			if (iters > 1100) { return dtoa_inf_bits(); }
			dtoa_div2(buf, start, &end);
			dtoa_trim(buf, &start, end, &pt);
			e2 = e2 + 1;
			iters = iters + 1;
			continue;
		}
		if (buf[start] >= '2') {
			if (iters > 1100) { return dtoa_inf_bits(); }
			dtoa_div2(buf, start, &end);
			dtoa_trim(buf, &start, end, &pt);
			e2 = e2 + 1;
			iters = iters + 1;
			continue;
		}
		break;
	}

	// buf[start] == '1' here: subtract it and extract 52 mantissa bits plus
	// one round bit, doubling the remaining fraction each step.
	buf[start] = '0';
	var mant i64 = 0;
	var bi i64 = 0;
	while (bi < 53) {
		dtoa_mul2(buf, &start, end, &pt);
		var bit i64 = 0;
		if (buf[start] == '1') { bit = 1; buf[start] = '0'; }
		if (bi < 52) {
			mant = (mant << 1) | bit;
		} else if (bit == 1) {
			mant = mant + 1;
		}
		bi = bi + 1;
	}
	if (mant >= 4503599627370496) {
		mant = 0;
		e2 = e2 + 1;
	}

	var expf i64 = e2 + 1023;
	if (expf >= 2047) { return dtoa_inf_bits(); }
	if (expf <= 0) { return 0; }
	return (expf << 52) | mant;
}

fn lex(src str, base i64) *Token {
	lex_base = base;
	var head Token;
	lex_tail = &head;
	var i i64 = 0;

	// A shebang line ("#!...") only makes sense at offset zero; `#` anywhere
	// else stays an error. In fmt mode it is kept as a comment token so the
	// formatter does not silently drop a script's first line.
	if (src.len >= 2 && src.ptr[0] == '#' && src.ptr[1] == '!') {
		var cstart i64 = i;
		while (i < src.len && src.ptr[i] != '\n') { i = i + 1; }
		if (lex_keep_comments) {
			var ct *Token = push_token(TK_COMMENT, cstart);
			var cs str;
			cs.ptr = src.ptr + cstart;
			cs.len = i - cstart;
			ct.text = cs;
		}
	}

	while (i < src.len) {
		if (is_space(src.ptr[i])) { i = i + 1; continue; }

		// line comment
		if (src.ptr[i] == '/' && i + 1 < src.len && src.ptr[i + 1] == '/') {
			var cstart i64 = i;
			while (i < src.len && src.ptr[i] != '\n') { i = i + 1; }
			if (lex_keep_comments) {
				var ct *Token = push_token(TK_COMMENT, cstart);
				var cs str;
				cs.ptr = src.ptr + cstart;
				cs.len = i - cstart;
				ct.text = cs;
			}
			continue;
		}

		// block comment
		if (src.ptr[i] == '/' && i + 1 < src.len && src.ptr[i + 1] == '*') {
			var start i64 = i;
			i = i + 2;
			while (i + 1 < src.len && !(src.ptr[i] == '*' && src.ptr[i + 1] == '/')) { i = i + 1; }
			if (i + 1 >= src.len) { error_at(lex_base + start, "unterminated block comment"); }
			i = i + 2;
			if (lex_keep_comments) {
				var bt *Token = push_token(TK_COMMENT, start);
				var bs str;
				bs.ptr = src.ptr + start;
				bs.len = i - start;
				bt.text = bs;
			}
			continue;
		}

		// number (decimal or hex)
		if (is_digit(src.ptr[i])) {
			var start i64 = i;
			var val i64 = 0;
			var is_hex bool = false;
			if (src.ptr[i] == '0' && i + 1 < src.len && (src.ptr[i+1] == 'x' || src.ptr[i+1] == 'X')) {
				is_hex = true;
				i = i + 2;
				while (i < src.len) {
					var c u8 = src.ptr[i];
					var d i64 = 0;
					if (c >= '0' && c <= '9') { d = c as i64 - '0'; }
					else if (c >= 'a' && c <= 'f') { d = c as i64 - 'a' + 10; }
					else if (c >= 'A' && c <= 'F') { d = c as i64 - 'A' + 10; }
					else { break; }
					val = val * 16 + d;
					i = i + 1;
				}
			} else {
				while (i < src.len && is_digit(src.ptr[i])) {
					val = val * 10 + (src.ptr[i] as i64 - '0');
					i = i + 1;
				}
			}
			var intpart_end i64 = i;

			// A dot needs a digit on each side (no bare "5." or ".5") to
			// stay clear of member access and the range operator.
			var has_dot bool = false;
			var frac_start i64 = i;
			var frac_len i64 = 0;
			if (!is_hex && i < src.len && src.ptr[i] == '.' && i + 1 < src.len && is_digit(src.ptr[i+1])) {
				has_dot = true;
				i = i + 1;
				frac_start = i;
				while (i < src.len && is_digit(src.ptr[i])) { i = i + 1; }
				frac_len = i - frac_start;
			}

			// An exponent alone does not commit a literal to being a float:
			// "1e3" is the integer 1000, matching "for ints too" -- only a
			// negative exponent, a dot or the 'f' suffix does.
			var has_exp bool = false;
			var exp_val i64 = 0;
			if (!is_hex && i < src.len && (src.ptr[i] == 'e' || src.ptr[i] == 'E')) {
				var j i64 = i + 1;
				var eneg bool = false;
				if (j < src.len && (src.ptr[j] == '+' || src.ptr[j] == '-')) {
					eneg = src.ptr[j] == '-';
					j = j + 1;
				}
				if (j < src.len && is_digit(src.ptr[j])) {
					has_exp = true;
					var e i64 = 0;
					while (j < src.len && is_digit(src.ptr[j])) {
						e = e * 10 + (src.ptr[j] as i64 - '0');
						j = j + 1;
					}
					if (eneg) { e = -e; }
					exp_val = e;
					i = j;
				}
			}

			// The explicit 'f' suffix is the third way (with a dot and a
			// negative exponent) to say "this is a float": "5f" == 5.0.
			// Not followed by an identifier char, so "5for" stays illegal
			// rather than silently eating a keyword's first letter.
			var has_suffix bool = false;
			if (!is_hex && i < src.len && (src.ptr[i] == 'f' || src.ptr[i] == 'F') &&
			    (i + 1 >= src.len || !is_ident_char(src.ptr[i+1]))) {
				has_suffix = true;
				i = i + 1;
			}

			var is_float bool = has_dot || has_suffix || (has_exp && exp_val < 0);

			if (is_float) {
				var intlen i64 = intpart_end - start;
				var ndigits i64 = intlen + frac_len;
				var digits *u8 = arena_alloc(ndigits, 1);
				var k i64 = 0;
				while (k < intlen) { digits[k] = src.ptr[start + k]; k = k + 1; }
				k = 0;
				while (k < frac_len) { digits[intlen + k] = src.ptr[frac_start + k]; k = k + 1; }
				var point i64 = intlen + exp_val;
				var ft *Token = push_token(TK_FLOAT, start);
				ft.val = dec_to_f64_bits(digits, ndigits, point);
				var fs str;
				fs.ptr = src.ptr + start;
				fs.len = i - start;
				ft.text = fs;
				continue;
			}

			if (has_exp) {
				var p i64 = exp_val;
				while (p > 0) { val = val * 10; p = p - 1; }
			}

			var t *Token = push_token(TK_NUM, start);
			t.val = val;
			var s str;
			s.ptr = src.ptr + start;
			s.len = i - start;
			t.text = s;
			continue;
		}

		// identifier or keyword
		if (is_letter(src.ptr[i])) {
			var start i64 = i;
			while (i < src.len && is_ident_char(src.ptr[i])) { i = i + 1; }
			var kind int = TK_IDENT;
			if (is_keyword(src, start, i)) { kind = TK_KW; }
			var t *Token = push_token(kind, start);
			var s str;
			s.ptr = src.ptr + start;
			s.len = i - start;
			t.text = s;
			continue;
		}

		// character literal
		if (src.ptr[i] == '\'') {
			var start i64 = i;
			i = i + 1;
			if (i >= src.len) { error_at(lex_base + start, "unterminated character literal"); }
			var val i64 = 0;
			if (src.ptr[i] == '\\') {
				i = i + 1;
				if (i >= src.len) { error_at(lex_base + start, "unterminated character literal"); }
				val = read_escape(src, &i);
			} else {
				val = src.ptr[i] as i64;
				i = i + 1;
			}
			if (i >= src.len || src.ptr[i] != '\'') {
				error_at(lex_base + start, "unterminated character literal");
			}
			i = i + 1;
			var t *Token = push_token(TK_NUM, start);
			t.val = val;
			var s str;
			s.ptr = src.ptr + start;
			s.len = i - start;
			t.text = s;
			continue;
		}

		// string literal, possibly interpolated: "a=${x}b" lexes as the
		// parts TK_STR("a") "$" "{" <expr tokens> "}" TK_STR("b"), so the
		// parser sees one node shape and the formatter can round-trip the
		// source from the token texts. An escaped `\$` stays a literal
		// dollar; the `$` of an interpolation can never be written that way.
		if (src.ptr[i] == '"') {
			var start i64 = i;
			i = i + 1;
			var part_start i64 = start;
			var buf *u8 = arena_alloc(src.len - i + 2, 1);
			var n i64 = 0;
			while (true) {
				if (i >= src.len || src.ptr[i] == '\n') {
					error_at(lex_base + start, "unterminated string literal");
				}
				if (src.ptr[i] == '"') {
					buf[n] = 0;
					var t *Token = push_token(TK_STR, part_start);
					var sv str;
					sv.ptr = buf;
					sv.len = n;
					t.sval = sv;
					var raw str;
					raw.ptr = src.ptr + part_start;
					raw.len = i - part_start + 1;
					t.text = raw;
					i = i + 1;
					break;
				}
				if (src.ptr[i] == '\\') {
					i = i + 1;
					buf[n] = read_escape(src, &i) as u8;
					n = n + 1;
					continue;
				}
				if (src.ptr[i] == '$' && i + 1 < src.len && src.ptr[i + 1] == '{') {
					var t *Token = push_token(TK_STR, part_start);
					var sv str;
					sv.ptr = buf;
					sv.len = n;
					t.sval = sv;
					var raw str;
					raw.ptr = src.ptr + part_start;
					raw.len = i - part_start;
					t.text = raw;
					var d *Token = push_token(TK_PUNCT, i);
					var ds str;
					ds.ptr = src.ptr + i;
					ds.len = 1;
					d.text = ds;
					var ob *Token = push_token(TK_PUNCT, i + 1);
					var os str;
					os.ptr = src.ptr + i + 1;
					os.len = 1;
					ob.text = os;
					i = i + 2;
					var open i64 = i;
					var end i64 = interp_end(src, &i, start);
					var inner str;
					inner.ptr = src.ptr + open;
					inner.len = end - open;
					// The expression inside lexes with its own head and is
					// spliced after the opening braces; the globals are the
					// outer list's state and must survive the recursion.
					var saved_base i64 = lex_base;
					var saved_tail *Token = lex_tail;
					var ih *Token = lex(inner, lex_base + open);
					var it *Token = ih;
					while (it.next.kind != TK_EOF) { it = it.next; }
					saved_tail.next = ih;
					lex_tail = it;
					lex_base = saved_base;
					var cb *Token = push_token(TK_PUNCT, i - 1);
					var cs str;
					cs.ptr = src.ptr + i - 1;
					cs.len = 1;
					cb.text = cs;
					buf = arena_alloc(src.len - i + 2, 1);
					part_start = i;
					n = 0;
					continue;
				}
				buf[n] = src.ptr[i];
				n = n + 1;
				i = i + 1;
			}
			continue;
		}

		// punctuation
		var plen i64 = punct_len(src, i);
		if (plen == 1 && !is_punct_single(src.ptr[i])) {
			error_at(lex_base + i, "unexpected character");
		}
		var t *Token = push_token(TK_PUNCT, i);
		var s str;
		s.ptr = src.ptr + i;
		s.len = plen;
		t.text = s;
		i = i + plen;
	}

	push_token(TK_EOF, src.len);
	return head.next;
}
