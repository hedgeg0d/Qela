import "comp.qela";
import "../std/io.qela";
import "dwarf.qela";

fn elf_phdr(f *Buf, flags i64, off i64, vaddr i64, filesz i64, memsz i64) {
	buf_u32(f, 1);
	buf_u32(f, flags);
	buf_u64(f, off);
	buf_u64(f, vaddr);
	buf_u64(f, vaddr);
	buf_u64(f, filesz);
	buf_u64(f, memsz);
	buf_u64(f, SEG_GAP);
}

let SHT_PROGBITS = 1;
let SHT_STRTAB   = 3;

var shdr_addr i64 = 0;

fn shdr_raw(f *Buf, name i64, kind i64, flags i64, off i64, size i64) {
	buf_u32(f, name);
	buf_u32(f, kind);
	buf_u64(f, flags);
	if (flags == 0) { buf_u64(f, 0); } else { buf_u64(f, opt_base + shdr_addr); }
	buf_u64(f, off);
	buf_u64(f, size);
	buf_u32(f, 0);
	buf_u32(f, 0);
	if (flags == 0) { buf_u64(f, 1); } else { buf_u64(f, 16); }
	buf_u64(f, 0);
}

fn shdr_symtab(f *Buf, name i64, off i64, size i64) {
	buf_u32(f, name);
	buf_u32(f, 2);
	buf_u64(f, 0);
	buf_u64(f, 0);
	buf_u64(f, off);
	buf_u64(f, size);
	buf_u32(f, 6);
	buf_u32(f, 1);
	buf_u64(f, 8);
	buf_u64(f, 24);
}

fn write_elf(path str, img *Image) {
	var text i64 = img.code.n + img.rodata.n;
	var rw i64 = img.data.n + img.bss_size;
	var nph int = img.nph;
	var hdr i64 = EHDR_SZ + PHDR_SZ * (nph as i64);

	var data_off i64 = hdr + text;
	var data_vaddr i64 = opt_base + SEG_GAP + data_off;

	var f Buf;
	buf_grow(&f, data_off + img.data.n);

	buf_u8(&f, 0x7f);
	buf_u8(&f, 'E');
	buf_u8(&f, 'L');
	buf_u8(&f, 'F');
	buf_u8(&f, 2);
	buf_u8(&f, 1);
	buf_u8(&f, 1);
	var i i64 = 7;
	while (i < 16) { buf_u8(&f, 0); i = i + 1; }

	// Debug sections live past the loadable image and need a section table.
	var nsh int = 0;
	var names Buf;
	var n_text i64 = 0;
	var n_line i64 = 0;
	var n_info i64 = 0;
	var n_abbrev i64 = 0;
	var n_sym i64 = 0;
	var n_str i64 = 0;
	var n_shstr i64 = 0;
	if (opt_debug) {
		dwarf_build(opt_base + hdr, img.code.n);
		buf_u8(&names, 0);
		n_text = names.n;   dw_str(&names, ".text");
		n_line = names.n;   dw_str(&names, ".debug_line");
		n_info = names.n;   dw_str(&names, ".debug_info");
		n_abbrev = names.n; dw_str(&names, ".debug_abbrev");
		n_sym = names.n;    dw_str(&names, ".symtab");
		n_str = names.n;    dw_str(&names, ".strtab");
		n_shstr = names.n;  dw_str(&names, ".shstrtab");
		dwarf_symbols(opt_base + hdr, img.code.n);
		nsh = 8;
	}

	buf_u16(&f, 2);
	if (opt_target == TARGET_RISCV64) { buf_u16(&f, EM_RISCV); }
	else if (opt_target == TARGET_ARM64) { buf_u16(&f, EM_AARCH64); }
	else { buf_u16(&f, EM_X86_64); }
	buf_u32(&f, 1);
	buf_u64(&f, opt_base + hdr + img.entry);
	buf_u64(&f, EHDR_SZ);
	var shoff_at i64 = f.n;
	buf_u64(&f, 0);
	// e_flags: RISC-V's LP64D double-float tag (EF_RISCV_FLOAT_ABI_DOUBLE
	// = 4) so the linker accepts our objects against C's; everyone else
	// leaves it zero.
	if (opt_target == TARGET_RISCV64) { buf_u32(&f, 4); } else { buf_u32(&f, 0); }
	buf_u16(&f, EHDR_SZ);
	buf_u16(&f, PHDR_SZ);
	buf_u16(&f, nph as i64);
	if (nsh == 0) {
		buf_u16(&f, 0);
		buf_u16(&f, 0);
		buf_u16(&f, 0);
	} else {
		buf_u16(&f, 64);
		buf_u16(&f, nsh as i64);
		buf_u16(&f, 7);
	}

	elf_phdr(&f, 5, 0, opt_base, hdr + text, hdr + text);
	if (nph == 2) {
		elf_phdr(&f, 6, data_off, data_vaddr, img.data.n, rw);
	}

	buf_bytes(&f, img.code.p, img.code.n);
	buf_bytes(&f, img.rodata.p, img.rodata.n);
	buf_bytes(&f, img.data.p, img.data.n);

	if (nsh != 0) {
		var off_line i64 = f.n;
		buf_bytes(&f, dw_line.p, dw_line.n);
		var off_info i64 = f.n;
		buf_bytes(&f, dw_info.p, dw_info.n);
		var off_abbrev i64 = f.n;
		buf_bytes(&f, dw_abbrev.p, dw_abbrev.n);
		var off_sym i64 = f.n;
		buf_bytes(&f, dw_sym.p, dw_sym.n);
		var off_str i64 = f.n;
		buf_bytes(&f, dw_strtab.p, dw_strtab.n);
		var off_shstr i64 = f.n;
		buf_bytes(&f, names.p, names.n);

		while ((f.n & 7) != 0) { buf_u8(&f, 0); }
		var shoff i64 = f.n;
		var z i64 = 0;
		while (z < 64) { buf_u8(&f, 0); z = z + 1; }
		shdr_addr = hdr;
		shdr_raw(&f, n_text, SHT_PROGBITS, 6, hdr, img.code.n);
		shdr_raw(&f, n_line, SHT_PROGBITS, 0, off_line, dw_line.n);
		shdr_raw(&f, n_info, SHT_PROGBITS, 0, off_info, dw_info.n);
		shdr_raw(&f, n_abbrev, SHT_PROGBITS, 0, off_abbrev, dw_abbrev.n);
		shdr_symtab(&f, n_sym, off_sym, dw_sym.n);
		shdr_raw(&f, n_str, SHT_STRTAB, 0, off_str, dw_strtab.n);
		shdr_raw(&f, n_shstr, SHT_STRTAB, 0, off_shstr, names.n);

		var k i64 = 0;
		while (k < 8) {
			f.p[shoff_at + k] = ((shoff >> (k * 8)) & 255) as u8;
			k = k + 1;
		}
	}

	write_file(path, f.p, f.n);
}

// ── `qela -c`: a relocatable object ──
//
// Builds an ELF64 ET_REL with .text/.rodata/.data/.bss plus a symbol table
// and .rela sections, so the system linker can consume it. Function and
// string relocation lists come from codegen; the exe patching never runs
// in object mode. `extern` declarations appear as GLOBAL UNDEF symbols,
// extern definitions as GLOBAL .text symbols, everything else is LOCAL.

let SHT_SYMTAB   = 2;
let SHT_RELA     = 4;
let SHT_NOBITS   = 8;

let SHF_WRITE    = 1;
let SHF_ALLOC    = 2;
let SHF_EXECINSTR = 4;

let STB_LOCAL  = 0;
let STB_GLOBAL = 1;
let STT_NOTYPE = 0;
let STT_OBJECT = 1;
let STT_FUNC   = 2;

var o_nsyms int = 0;
var o_names [4096]str;
var o_name_off [4096]i64;
var o_info [4096]int;
var o_shndx [4096]int;
var o_value [4096]i64;
var o_size [4096]i64;

fn o_add(name str, info int, shndx int, value i64, size i64) {	if (o_nsyms >= 4096) { die("error: too many symbols for an object file"); }
	o_names[o_nsyms] = name;
	o_info[o_nsyms] = info;
	o_shndx[o_nsyms] = shndx;
	o_value[o_nsyms] = value;
	o_size[o_nsyms] = size;
	o_nsyms = o_nsyms + 1;
}

fn o_str_bytes(b *Buf, s str) {
	var i i64 = 0;
	while (i < s.len) { buf_u8(b, s.ptr[i]); i = i + 1; }
	buf_u8(b, 0);
}

fn o_u64_str(v i64, b *Buf) {
	if (v == 0) { buf_u8(b, '0'); return; }
	var buf [20]u8;
	var n int = 0;
	while (v > 0) {
		buf[n] = ((v % 10) as i64 + '0') as u8;
		n = n + 1;
		v = v / 10;
	}
	var i int = n - 1;
	while (i >= 0) { buf_u8(b, buf[i]); i = i - 1; }
}

// The generated symbol for a string: `.Lstr<N>` is the {ptr, len} header in
// .rodata, `.Lstrd<N>` the bytes themselves. codegen's string relocations
// target the header symbol; the header's own ptr field relocates to the
// bytes symbol.
fn o_str_name(id i64, data_sym bool) str {
	var h Buf;
	buf_u8(&h, '.');
	buf_u8(&h, 'L');
	buf_u8(&h, 's');
	buf_u8(&h, 't');
	buf_u8(&h, 'r');
	if (data_sym) { buf_u8(&h, 'd'); }
	o_u64_str(id, &h);
	return buf_str(&h);
}

// Linear scan; object files are small enough that the string ids dominate
// and a hash table is not worth the bytes. A nameless relocation is a
// string: PC-relative slots (in code) point at the {ptr, len} header,
// REL_ABS64 slots (the header's own ptr, in .rodata) point at the bytes.
fn o_sym_index(r *Reloc) int {
	var want str = r.name;
	if (want.len == 0) {
		if (r.kind == REL_ABS64) { want = o_str_name(r.id, true); }
		else { want = o_str_name(r.id, false); }
	}
	var i int = 0;
	while (i < o_nsyms) {
		if (str_eq(o_names[i], want)) { return i; }
		i = i + 1;
	}
	var dmsg Buf;
	fmt_str(&dmsg, "error: internal: unresolved symbol: ");
	fmt_str(&dmsg, want);
	die(buf_str(&dmsg));
	return -1;
}

fn o_build_syms(img *Image, sec_text int, sec_rodata int, sec_drro int, sec_data int, sec_bss int) {
	o_add("", STB_LOCAL << 4 | STT_NOTYPE, 0, 0, 0);

	// Locals first, then the globals: the linker reads the boundary at
	// sh_info, so no STB_GLOBAL may precede the first STB_LOCAL. Imports are
	// UNDEF globals the linker must fill, extern definitions export.
	var f *Func = img.funcs;
	while (f as i64 != 0) {
		if (f.nct != 0) { f = f.next; continue; }
		if (f.body as i64 != 0 && !f.extern) {
			var n2 *Func = f.next;
			while (n2 as i64 != 0 && (n2.nct != 0 || n2.body as i64 == 0)) { n2 = n2.next; }
			var sz i64 = img.code.n - f.addr;
			if (n2 as i64 != 0) { sz = n2.addr - f.addr; }
			o_add(f.name, STB_LOCAL << 4 | STT_FUNC, sec_text, f.addr, sz);
		}
		f = f.next;
	}

	var v *Var = img.globals;
	while (v as i64 != 0) {
		if (v.extern) { v = v.next; continue; }
		var sec int = sec_bss;
		var val i64 = v.data_off - img.data.n;
		if (v.init as i64 != 0) { sec = sec_data; val = v.data_off; }
		o_add(v.name, STB_LOCAL << 4 | STT_OBJECT, sec, val, v.ty.size as i64);
		v = v.next;
	}

	var s *StrLit = img.strs;
	var hdr_off i64 = 0;
	if (s as i64 != 0) { hdr_off = img.str_off[s.id]; }
	while (s as i64 != 0) {
		o_add(o_str_name(s.id as i64, false), STB_LOCAL << 4 | STT_OBJECT, sec_drro, img.str_off[s.id] - hdr_off, 16);
		o_add(o_str_name(s.id as i64, true), STB_LOCAL << 4 | STT_OBJECT, sec_rodata, img.bytes_off[s.id], s.s.len);
		s = s.next;
	}

	v = img.globals;
	while (v as i64 != 0) {
		if (!v.extern) { v = v.next; continue; }
		if (!v.has_init) {
			// An imported extern: an UNDEF the linker must fill from the
			// C side. No section, no size.
			o_add(v.name, STB_GLOBAL << 4 | STT_OBJECT, 0, 0, 0);
			v = v.next;
			continue;
		}
		var sec2 int = sec_bss;
		var val2 i64 = v.data_off - img.data.n;
		if (v.init as i64 != 0) { sec2 = sec_data; val2 = v.data_off; }
		// An extern with an initializer exports the symbol for the C side.
		o_add(v.name, STB_GLOBAL << 4 | STT_OBJECT, sec2, val2, v.ty.size as i64);
		v = v.next;
	}

	f = img.funcs;
	while (f as i64 != 0) {
		if (f.nct != 0) { f = f.next; continue; }
		if (f.body as i64 == 0) {
			o_add(f.name, STB_GLOBAL << 4 | STT_FUNC, 0, 0, 0);
		} else if (f.extern || str_eq(f.name, "main")) {
			// main is always exported: the C runtime's _start calls it by
			// name, so the symbol has to cross the object boundary.
			var n3 *Func = f.next;
			while (n3 as i64 != 0 && (n3.nct != 0 || n3.body as i64 == 0)) { n3 = n3.next; }
			var sz2 i64 = img.code.n - f.addr;
			if (n3 as i64 != 0) { sz2 = n3.addr - f.addr; }
			o_add(f.name, STB_GLOBAL << 4 | STT_FUNC, sec_text, f.addr, sz2);
		}
		f = f.next;
	}
}

fn o_rela_count(head *Reloc) i64 {
	var n i64 = 0;
	var r *Reloc = head;
	while (r as i64 != 0) { n = n + 1; r = r.next; }
	return n;
}

// The bootstrap subset's parameter budget (six registers, stage0 has no
// stack-spill for its own functions) rules out a ten-parameter shdr
// writer, so the section header fields travel in one struct instead.
struct ShdrArgs {
	name i64, typ i64, flags i64, off i64, size i64,
	link i64, info i64, align i64, entsize i64,
}

fn o_shdr(f *Buf, a *ShdrArgs) {
	buf_u32(f, a.name);
	buf_u32(f, a.typ);
	buf_u64(f, a.flags);
	buf_u64(f, 0);
	buf_u64(f, a.off);
	buf_u64(f, a.size);
	buf_u32(f, a.link);
	buf_u32(f, a.info);
	buf_u64(f, a.align);
	buf_u64(f, a.entsize);
}

fn o_sym_rec(f *Buf, i int) {
	buf_u32(f, o_name_off[i]);
	buf_u8(f, o_info[i] as u8);
	buf_u8(f, 0);
	buf_u16(f, o_shndx[i]);
	buf_u64(f, o_value[i]);
	buf_u64(f, o_size[i]);
}

// The only place that knows REL_* purposes map to the target's relocation
// type numbers: R_X86_64_* here, R_AARCH64_* under --target arm64,
// R_RISCV_* under --target riscv64.
fn elf_reloc_type(kind int) int {
	if (opt_target == TARGET_RISCV64) {
		if (kind == REL_ABS64) { return 2; }         // R_RISCV_64
		if (kind == REL_RISCV_PCREL_HI20) { return 23; }   // R_RISCV_PCREL_HI20
		if (kind == REL_RISCV_PCREL_LO12_I) { return 24; } // R_RISCV_PCREL_LO12_I
		return 17;                                   // R_RISCV_JAL
	}
	if (opt_target == TARGET_ARM64) {
		if (kind == REL_ABS64) { return 257; }          // R_AARCH64_ABS64
		if (kind == REL_ARM64_CALL26) { return 283; }   // R_AARCH64_CALL26
		if (kind == REL_ARM64_ADRP) { return 275; }     // R_AARCH64_ADR_PREL_PG_HI21
		return 277;                                     // R_AARCH64_ADD_ABS_LO12_NC
	}
	if (kind == REL_ABS64) { return 1; }        // R_X86_64_64
	if (kind == REL_PCREL32) { return 2; }      // R_X86_64_PC32
	if (kind == REL_PCREL32_PLT) { return 4; }  // R_X86_64_PLT32
	return 11;                                  // R_X86_64_32S
}

fn o_rela_rec(f *Buf, r *Reloc, base i64) {
	buf_u64(f, r.at - base);
	buf_u64(f, (o_sym_index(r) as i64) << 32 | (elf_reloc_type(r.kind) as i64));
	// x86 PC-relative slots resolve from the *next* instruction; the
	// linker's P is the slot's own address, so a -4 addend aligns the two
	// (gcc emits the same). Absolute relocations carry no addend, and none
	// of the AArch64 or RISC-V kinds need one -- both bake their own
	// immediates into the instruction the relocation names.
	var add i64 = 0;
	if (opt_target == TARGET_X86_64) {
		if (r.kind == REL_PCREL32_PLT || r.kind == REL_PCREL32) { add = -4; }
	}
	buf_u64(f, add);
}

fn write_object(path str, img *Image) {
	var has_rr bool = img.rodata_relocs as i64 != 0;
	// The string headers ({ptr, len}) live in .data.rel.ro, not .rodata: the
	// ptr is a relocation the loader must write, and a reloc in a plain
	// read-only section forces DT_TEXTREL in a PIE. relro turns the section
	// read-only again after relocation.
	var sec_text int = 1;
	var sec_rodata int = 2;
	var sec_drro int = 3;
	var sec_data int = 4;
	var sec_bss int = 5;
	var sec_symtab int = 8;
	var sec_strtab int = 9;
	var sec_shstr int = 10;
	if (!has_rr) { sec_drro = -1; sec_data = 3; sec_bss = 4; sec_symtab = 6; sec_strtab = 7; sec_shstr = 8; }

	o_build_syms(img, sec_text, sec_rodata, sec_drro, sec_data, sec_bss);

	var text_off i64 = 64;
	var rodata_off i64 = (text_off + img.code.n + 7) & ~7;
	var hdr_off i64 = 0;
	if (has_rr) { hdr_off = img.str_off[img.strs.id]; }
	var data_off i64 = (rodata_off + img.rodata.n + 7) & ~7;
	var bss_off i64 = (data_off + img.data.n + 7) & ~7;
	var relatext_off i64 = (bss_off + 7) & ~7;
	var n_rt i64 = o_rela_count(img.relocs);
	var n_rr i64 = 0;
	if (has_rr) { n_rr = o_rela_count(img.rodata_relocs); }
	var reladrro_off i64 = relatext_off + n_rt * 24;
	var symtab_off i64 = reladrro_off + n_rr * 24;

	// strtab and shstrtab first, so the offsets are known.
	var strtab Buf;
	var shstr Buf;
	buf_u8(&strtab, 0);
	buf_u8(&shstr, 0);
	var i int = 0;
	while (i < o_nsyms) {
		o_name_off[i] = strtab.n;
		buf_bytes(&strtab, o_names[i].ptr, o_names[i].len);
		buf_u8(&strtab, 0);
		i = i + 1;
	}
	var n_text = shstr.n;
	o_str_bytes(&shstr, ".text");
	var n_rodata = shstr.n; o_str_bytes(&shstr, ".rodata");
	var n_drro = shstr.n;
	if (has_rr) { o_str_bytes(&shstr, ".data.rel.ro"); }
	var n_data = shstr.n;   o_str_bytes(&shstr, ".data");
	var n_bss = shstr.n;    o_str_bytes(&shstr, ".bss");
	var n_relatext = shstr.n; o_str_bytes(&shstr, ".rela.text");
	var n_reladrro = shstr.n;
	if (has_rr) { o_str_bytes(&shstr, ".rela.data.rel.ro"); }
	var n_symtab = shstr.n; o_str_bytes(&shstr, ".symtab");
	var n_strtab = shstr.n; o_str_bytes(&shstr, ".strtab");
	var n_shstr = shstr.n;  o_str_bytes(&shstr, ".shstrtab");
	var strtab_off i64 = symtab_off + (o_nsyms as i64) * 24;
	var shstr_off i64 = strtab_off + strtab.n;
	var shoff i64 = ((shstr_off + shstr.n) + 7) & ~7;

	var f Buf;
	buf_grow(&f, shoff + 10 * 64);

	buf_u8(&f, 0x7f);
	buf_u8(&f, 'E');
	buf_u8(&f, 'L');
	buf_u8(&f, 'F');
	buf_u8(&f, 2);
	buf_u8(&f, 1);
	buf_u8(&f, 1);
	var k i64 = 7;
	while (k < 16) { buf_u8(&f, 0); k = k + 1; }
	buf_u16(&f, 1);
	if (opt_target == TARGET_RISCV64) { buf_u16(&f, EM_RISCV); }
	else if (opt_target == TARGET_ARM64) { buf_u16(&f, EM_AARCH64); }
	else { buf_u16(&f, EM_X86_64); }
	buf_u32(&f, 1);
	buf_u64(&f, 0);
	buf_u64(&f, 0);
	buf_u64(&f, shoff);
	if (opt_target == TARGET_RISCV64) { buf_u32(&f, 4); } else { buf_u32(&f, 0); }
	buf_u16(&f, 64);
	buf_u16(&f, 0);
	buf_u16(&f, 0);
	buf_u16(&f, 64);
	var nsh int = 11;
	if (!has_rr) { nsh = 9; }
	buf_u16(&f, nsh);
	buf_u16(&f, sec_shstr);

	while (f.n < text_off) { buf_u8(&f, 0); }
	buf_bytes(&f, img.code.p, img.code.n);
	while (f.n < rodata_off) { buf_u8(&f, 0); }
	buf_bytes(&f, img.rodata.p, img.rodata.n);
	while (f.n < data_off) { buf_u8(&f, 0); }
	buf_bytes(&f, img.data.p, img.data.n);
	while (f.n < relatext_off) { buf_u8(&f, 0); }

	var r *Reloc = img.relocs;
	while (r as i64 != 0) { o_rela_rec(&f, r, 0); r = r.next; }
	while (f.n < reladrro_off) { buf_u8(&f, 0); }
	r = img.rodata_relocs;
	while (r as i64 != 0) { o_rela_rec(&f, r, hdr_off); r = r.next; }
	while (f.n < symtab_off) { buf_u8(&f, 0); }
	var si int = 0;
	while (si < o_nsyms) { o_sym_rec(&f, si); si = si + 1; }
	buf_bytes(&f, strtab.p, strtab.n);
	buf_bytes(&f, shstr.p, shstr.n);
	while (f.n < shoff) { buf_u8(&f, 0); }

	// First global symbol: the index .symtab's sh_info wants.
	var first_global int = o_nsyms;
	si = 0;
	while (si < o_nsyms) {
		if (o_info[si] >> 4 == STB_GLOBAL) { first_global = si; break; }
		si = si + 1;
	}

	var a ShdrArgs;
	a.typ = 0;
	a.name = 0; a.flags = 0; a.off = 0; a.size = 0; a.link = 0; a.info = 0; a.align = 0; a.entsize = 0;
	o_shdr(&f, &a);
	a.typ = SHT_PROGBITS; a.flags = SHF_ALLOC | SHF_EXECINSTR;
	a.name = n_text; a.off = text_off; a.size = img.code.n; a.align = 16;
	o_shdr(&f, &a);
	a.typ = SHT_PROGBITS; a.flags = SHF_ALLOC;
	a.name = n_rodata; a.off = rodata_off; a.size = hdr_off; a.align = 8;
	o_shdr(&f, &a);
	if (has_rr) {
		a.typ = SHT_PROGBITS; a.flags = SHF_ALLOC | SHF_WRITE;
		a.name = n_drro; a.off = rodata_off + hdr_off; a.size = img.rodata.n - hdr_off; a.align = 8;
		o_shdr(&f, &a);
	}
	a.typ = SHT_PROGBITS; a.flags = SHF_ALLOC | SHF_WRITE;
	a.name = n_data; a.off = data_off; a.size = img.data.n; a.align = 8;
	o_shdr(&f, &a);
	a.typ = SHT_NOBITS; a.flags = SHF_ALLOC | SHF_WRITE;
	a.name = n_bss; a.off = bss_off; a.size = img.bss_size; a.align = 8;
	o_shdr(&f, &a);
	a.typ = SHT_RELA; a.flags = 0;
	a.name = n_relatext; a.off = relatext_off; a.size = n_rt * 24; a.link = sec_symtab; a.info = sec_text; a.align = 8; a.entsize = 24;
	o_shdr(&f, &a);
	if (has_rr) {
		a.typ = SHT_RELA;
		a.name = n_reladrro; a.off = reladrro_off; a.size = n_rr * 24; a.link = sec_symtab; a.info = sec_drro;
		o_shdr(&f, &a);
	}
	a.typ = SHT_SYMTAB; a.flags = 0;
	a.name = n_symtab; a.off = symtab_off; a.size = (o_nsyms as i64) * 24; a.link = sec_strtab; a.info = first_global; a.align = 8; a.entsize = 24;
	o_shdr(&f, &a);
	a.typ = SHT_STRTAB;
	a.name = n_strtab; a.off = strtab_off; a.size = strtab.n; a.link = 0; a.info = 0; a.align = 1; a.entsize = 0;
	o_shdr(&f, &a);
	a.typ = SHT_STRTAB;
	a.name = n_shstr; a.off = shstr_off; a.size = shstr.n; a.align = 1;
	o_shdr(&f, &a);

	write_file(path, f.p, f.n);
}
