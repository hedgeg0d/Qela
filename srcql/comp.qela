// The stage1 contract: types, kind constants, and the inter-module API.
// Definitions only. Changing this file changes the contract.
// Kinds are `let` constants rather than enums because stage1 sources may not
// use `match` (see docs/BOOTSTRAP.md).

import "../std/sys.qela";
import "../std/arena.qela";
import "../std/buf.qela";
import "../std/str.qela";

let TK_EOF   = 0;
let TK_IDENT = 1;
let TK_KW    = 2;
let TK_NUM   = 3;
let TK_STR   = 4;
let TK_PUNCT = 5;
let TK_COMMENT = 6;
let TK_FLOAT = 7;

// Positions of every file share one i64: file_id << FILE_SHIFT | offset.
let FILE_SHIFT = 40;

struct Token;
struct Token {
	kind int,
	next *Token,
	text str,
	sval str,
	val  i64,
	pos  i64,
}

let TY_VOID    = 0;
let TY_BOOL    = 1;
let TY_INT     = 2;
let TY_PTR     = 3;
let TY_ARRAY   = 4;
let TY_STRUCT  = 5;
let TY_SLICE   = 6;
let TY_ENUM    = 7;
let TY_TYPE    = 8;
let TY_TYPEVAR = 9;
let TY_GENERIC = 10;
let TY_FLOAT   = 11;
let TY_FUNC    = 12;

struct Type;
struct Member;
struct Variant;
struct Tmpl;

// A parameterized type. `proto` is the body parsed once with the parameters
// bound to type variables; instantiating clones it with them substituted.
struct Tmpl {
	next    *Tmpl,
	name    str,
	nparams int,
	tv0     *Type,
	tv1     *Type,
	proto   *Type,
}

struct Member {
	next   *Member,
	name   str,
	ty     *Type,
	offset int,
	pos    i64,
}

struct Variant {
	next    *Variant,
	name    str,
	tag     int,
	nfields int,
	fields  *Member,
	pos     i64,
}

struct Type {
	kind        int,
	size        int,
	align       int,
	is_unsigned bool,
	is_volatile bool,
	base        *Type,
	len         i64,
	name        str,
	members     *Member,
	variants    *Variant,
	// TY_GENERIC only: the template and the arguments it is waiting on.
	tmpl        *Tmpl,
	ga0         *Type,
	ga1         *Type,
}

let ND_NUM       = 0;
let ND_STRLIT    = 1;
let ND_VAR       = 2;
let ND_CALL      = 3;
let ND_SYSCALL   = 4;
let ND_ADDR      = 5;
let ND_DEREF     = 6;
let ND_MEMBER    = 7;
let ND_INDEX     = 8;
let ND_SLICE     = 9;
let ND_ENUMLIT   = 10;
let ND_STRUCTLIT = 11;
let ND_FIELD     = 12;
let ND_MATCH     = 13;
let ND_ARM       = 14;
let ND_DEFER     = 15;
let ND_CAST      = 16;
let ND_ADD       = 17;
let ND_SUB       = 18;
let ND_MUL       = 19;
let ND_DIV       = 20;
let ND_MOD       = 21;
let ND_NEG       = 22;
let ND_NOT       = 23;
let ND_BITAND    = 24;
let ND_BITOR     = 25;
let ND_BITXOR    = 26;
let ND_BITNOT    = 27;
let ND_SHL       = 28;
let ND_SHR       = 29;
let ND_EQ        = 30;
let ND_NE        = 31;
let ND_LT        = 32;
let ND_LE        = 33;
let ND_AND       = 34;
let ND_OR        = 35;
let ND_ASSIGN    = 36;
let ND_OPASSIGN  = 37;
let ND_COMMA     = 38;
let ND_IF        = 39;
let ND_FOR       = 40;
let ND_BREAK     = 41;
let ND_CONT      = 42;
let ND_RET       = 43;
let ND_BLOCK     = 44;
let ND_EXPRSTMT  = 45;
let ND_COMPTIME  = 46;
let ND_TYPEEXPR  = 47;
let ND_SIZEOF    = 48;
let ND_ZERO      = 49;
let ND_FUNCADDR  = 50;
let ND_ASM       = 51;
let ND_ASSERT    = 52;
let ND_INTERP    = 53;
let ND_STRPART   = 54;
