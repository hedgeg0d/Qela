struct Var;
struct Node;

struct Var {
	name      str,
	ty        *Type,
	next      *Var,
	offset    int,
	is_global bool,
	is_tls    bool,
	tls_off   i64,
	extern    bool,
	has_init  bool,
	by_ref    bool,
	data_off  i64,
	init      i64,
	has_reg   bool,
	no_reg    bool,
	reg       int,
	lo        i64,
	hi        i64,
	uses      i64,
	pos       i64,
	arg_stack bool,
	pnext     *Var,
	reads     i64,
	// A parameter's default value expression, `fn f(a=0 i32)`. Null for
	// every non-parameter Var and for a parameter with no default.
	default   *Node,
}

struct Node {
	kind    int,
	ty      *Type,
	typed   bool,
	nobounds bool,
	dotcall bool,
	next    *Node,
	lhs     *Node,
	rhs     *Node,
	cond    *Node,
	then    *Node,
	els     *Node,
	init    *Node,
	step    *Node,
	body    *Node,
	args    *Node,
	nargs   int,
	val     i64,
	varp    *Var,
	tmp     *Var,
	member  *Member,
	variant *Variant,
	typeval *Type,
	name    str,
	pos     i64,
	stack_tmp *Var,
}

// Parameters are six separate slots: stage0 has no arrays inside structs.
struct Func;
struct Func {
	name       str,
	next       *Func,
	nparams    int,
	nct        int,
	locals     *Var,
	ret        *Type,
	stack_size int,
	nsaved     int,
	leaf       bool,
	naked      bool,
	extern     bool,
	body       *Node,
	ret_slot   *Var,
	addr       i64,
	pos        i64,
	p0         *Var,
	p1         *Var,
	p2         *Var,
	p3         *Var,
	p4         *Var,
	p5         *Var,
	p6         *Var,
	p7         *Var,
	pextra     *Var,
	n_stack_args int,
}

// Source order drives the output bytes; see the determinism rules.
struct StrLit;
struct StrLit {
	next *StrLit,
	s    str,
	id   int,
	off  i64,
}

// A parse-time expression macro: the body is parsed once with the
// parameters as placeholder locals, and every call clones it, substituting
// the argument trees. Parameters are six separate slots like Func's.
struct Macro;
struct Macro {
	next    *Macro,
	name    str,
	nparams int,
	body    *Node,
	pos     i64,
	p0      *Var,
	p1      *Var,
	p2      *Var,
	p3      *Var,
	p4      *Var,
	p5      *Var,
}

struct Unit {
	funcs   *Func,
	globals *Var,
	strs    *StrLit,
	nstrs   int,
}

let ELF_BASE   = 0x400000;
let EHDR_SZ    = 64;
let PHDR_SZ    = 56;
let SEG_GAP    = 0x1000;
let EM_X86_64  = 0x3e;
let EM_AARCH64 = 0xb7;

// Which backend codegen.qela/regalloc.qela/elf.qela emit for. Set once from
// --target/-t, read everywhere; no per-target struct or dispatch table, just
// this global and if/else at the handful of real target-dependent points.
let TARGET_X86_64 = 0;
let TARGET_ARM64  = 1;
var opt_target int = 0;

struct ComptimeDef;
struct ComptimeDef { next *ComptimeDef, name str, val str, }

var comptime_defs *ComptimeDef;

fn comptime_get(name str) str {
	var d *ComptimeDef = comptime_defs;
	while (d as i64 != 0) {
		if (str_eq(d.name, name)) { return d.val; }
		d = d.next;
	}
	var e str;
	return e;
}

fn comptime_set(name str, val str) {
	var d *ComptimeDef = comptime_defs;
	while (d as i64 != 0) {
		if (str_eq(d.name, name)) { d.val = val; return; }
		d = d.next;
	}
	var nd *ComptimeDef = arena_alloc(sizeof(ComptimeDef), 8) as *ComptimeDef;
	nd.name = name;
	nd.val = val;
	nd.next = comptime_defs;
	comptime_defs = nd;
}

// SysV AMD64 and AAPCS64 both pass an aggregate by reference once it is
// bigger than two registers' worth (16 bytes); a future target with a
// different cutoff (e.g. Windows x64's 8) only has to change this function.
fn abi_by_ref(size int) bool {
	return size > 16;
}

// ABI parameters. The two current targets agree on the by-ref cutoff but
// differ in the number of argument registers: six integer registers for
// x86, eight for ARM64. Floats cross in float registers at the extern
// boundary only, and both targets have eight of those. A future target with
// a different shape overrides these numbers; codegen.qela's call_reg() is
// the other half of the ABI, mapping a register rank to the target's
// encoding.
fn abi_n_arg_regs() int {
	if (opt_target == TARGET_ARM64) { return 8; }
	return 6;
}

fn abi_n_float_regs() int {
	return 8;
}

// A result that no longer fits the return registers comes back through a
// hidden pointer argument. Same cutoff as abi_by_ref for the two current
// targets; the caller still checks is_aggregate separately.
fn abi_sret(size int) bool {
	return abi_by_ref(size);
}

// GPR encodings, shared between codegen.qela (which also defines its own
// RAX..R11 for its own use) and regalloc.qela (which does not import
// codegen.qela and needs these for its free/callee-saved register pools).
let RBX = 3;
let R8  = 8;
let R9  = 9;
let R10 = 10;
let R11 = 11;
let R12 = 12;
let R13 = 13;
let R14 = 14;
let R15 = 15;

// AAPCS64's IP0/IP1, the ARM64 counterparts of the caller-saved leaf pool:
// dead between calls, so a leaf function may promote a local into them.
let X16 = 16;
let X17 = 17;
let X19 = 19;   // bottom of the ARM64 callee-saved block (x19-x28)

// Forward: Image below carries the object-mode relocation lists.
struct Reloc;

struct Image {
	code     Buf,
	rodata   Buf,
	data     Buf,
	bss_size i64,
	entry    i64,
	nph      int,
	// Object mode (-c) carries the symbol material here; the exe path
	// leaves these empty.
	funcs     *Func,
	globals   *Var,
	strs      *StrLit,
	nstrs     int,
	str_off   *i64,
	bytes_off *i64,
	relocs    *Reloc,
	rodata_relocs *Reloc,
}

// A relocation for the object writer. at is the offset inside the target
// section; kind is the x86-64 type. name names the symbol, except string
// relocations where name is empty and id selects the generated `.Lstr` pair.
struct Reloc;
struct Reloc { next *Reloc, at i64, name str, kind int, id i64, }

// Purpose, not encoding: what codegen needs the linker to do at this slot.
// elf.qela alone knows these map to R_X86_64_* type numbers.
let REL_ABS64        = 0;
let REL_PCREL32      = 1;
let REL_PCREL32_PLT  = 2;
let REL_ABS32S       = 3;
// ARM64 object-mode kinds: elf.qela maps REL_ABS64 to R_AARCH64_ABS64 (a
// plain 8-byte data-pointer patch, same purpose as the x86 kind, different
// architecture number) and these three to the CALL26/ADRP/ADD_LO12 triple
// every address reference and call site here uses.
let REL_ARM64_CALL26   = 4;
let REL_ARM64_ADRP     = 5;
let REL_ARM64_ADD_LO12 = 6;

struct ComptimeVal {
	kind int,
	num  i64,
	str  str,
	ty   *Type,
}

let CV_INT = 0;
let CV_STR = 1;
let CV_TYPE = 2;
let CV_VOID = 3;

// Inter-module API. Qela has no prototypes: functions are visible across the
// whole spliced token stream, so this list is the agreed contract. Changing a
// signature means editing this file.
//
// std/arena.qela
//   arena_alloc(size i64, align i64) *u8
//
// std/buf.qela
//   buf_grow(b *Buf, need i64)            buf_u8(b *Buf, v u8)
//   buf_u32(b *Buf, v i64)                buf_u64(b *Buf, v i64)
//   buf_bytes(b *Buf, data *u8, n i64)    buf_patch32(b *Buf, at i64, v i64)
//
// std/str.qela
//   str_eq(a str, b str) bool             str_from_cstr(p *u8) str
//   str_slice(s str, lo i64, hi i64) str  str_dup(s str) str
//   str_find(s str, c u8) i64             cstr(s str) *u8
//
// std/fmt.qela
//   fmt_i64(b *Buf, v i64)                fmt_hex(b *Buf, v i64)
//   fmt_str(b *Buf, s str)                fmt_i64_to_fd(fd i64, v i64)
//   fmt_begin() Buf                       fmt_put_str(b Buf, s str) Buf
//   fmt_put_i64(b Buf, v i64) Buf         fmt_put_hex(b Buf, v i64) Buf
//   fmt_result(b Buf) str
//   fmt_f64_bits(b *Buf, bits i64)        fmt_put_f64_bits(b Buf, bits i64) Buf
//     -- bits is a double's raw bit pattern, not a float: this module is
//        part of the bootstrap subset and stage0 has no float support.
//
// std/sys.qela
//   sys_getenv(name str) str              sys_isatty() i64
//
// srcql/diag.qela
//   set_module_dir(path str)
//   diag_add_file(path str, src str) int
//   diag_line_for(file_id int, off i64) int
//   error_at(pos i64, msg str)            does not return
//   warn_at(pos i64, msg str)             note_at(pos i64, msg str)
//   hint_at(pos i64, msg str)             diag_secondary(pos i64, msg str)
//   diag_macro_push(name str, pos i64)    diag_macro_pop()
//   diag_setup()                          diag_reset()
//   opt_warn bool    opt_color int (0=auto 1=always 2=never)
//
// srcql/lex.qela
//   lex(src str, base i64) *Token
//
// srcql/parse.qela
//   parse(tok *Token) *Unit               find_func(name str) *Func
//   splice_import(tok *Token, path str, pos i64) *Token
//
// srcql/type.qela
//   type_unit(u *Unit)                    add_type(n *Node)
//   type_lookup(name str) *Type           type_define(name str, ty *Type)
//   type_ptr(base *Type) *Type            type_array(base *Type, len i64) *Type
//   type_slice(base *Type) *Type          type_str() *Type
//   is_integer(t *Type) bool              is_aggregate(t *Type) bool
//   same_type(a *Type, b *Type) bool      type_name(t *Type) str
//   monomorphize_call(n *Node, f *Func)
//
// srcql/comptime.qela
//   comptime_eval(n *Node) ComptimeVal
//
// srcql/opt.qela
//   opt_func(f *Func)
//
// srcql/codegen.qela
//   codegen(u *Unit, img *Image)
//
// srcql/elf.qela
//   write_elf(path str, img *Image)
