import "comp.qela";

var nfiles int = 0;
var source_strs str;

fn diag_add_file(path str, src str) int {
	var id int = nfiles;
	nfiles = nfiles + 1;
	// source_strs[id] = ... TODO: array of file info
	return id;
}

fn error_at(pos i64, msg str) {
	// write to stderr
	syscall(1, 2, msg.ptr, msg.len);
	syscall(60, 1, 0, 0, 0, 0, 0);
}
