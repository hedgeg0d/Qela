import "comp.qela";
import "../std/fmt.qela";

struct FileInfo {
	path str,
	src  str,
}

var files [64]FileInfo;
var nfiles int = 0;
var module_dir str;

fn set_module_dir(path str) {
	module_dir = path;
}

fn get_module_dir() str {
	return module_dir;
}

fn diag_add_file(path str, src str) int {
	var id int = nfiles;
	files[id].path = path;
	files[id].src = src;
	nfiles = nfiles + 1;
	return id;
}

fn diag_file_of(pos i64) int {
	return (pos >> FILE_SHIFT) as int;
}

fn diag_offset_of(pos i64) i64 {
	return pos & ((1 << FILE_SHIFT) - 1);
}

fn diag_line_for(file_id int, off i64) int {
	var src str = files[file_id].src;
	var line int = 1;
	var i i64 = 0;
	while (i < off && i < src.len) {
		if (src.ptr[i] == '\n') { line = line + 1; }
		i = i + 1;
	}
	return line;
}

fn diag_col_for(file_id int, off i64) int {
	var src str = files[file_id].src;
	var start i64 = off;
	while (start > 0 && src.ptr[start - 1] != '\n') { start = start - 1; }
	return (off - start + 1) as int;
}

fn error_at(pos i64, msg str) {
	var id int = diag_file_of(pos);
	var off i64 = diag_offset_of(pos);
	eprint(files[id].path);
	eprint(":");
	eprint_i64(diag_line_for(id, off) as i64);
	eprint(":");
	eprint_i64(diag_col_for(id, off) as i64);
	eprint(": error: ");
	eprint(msg);
	eprint("\n");
	sys_exit(1);
}
