import "comp.qela";
import "std_blob.qela";

var blob_unpacked *u8;

fn blob_unpack() *u8 {
	if (blob_unpacked as i64 != 0) { return blob_unpacked; }
	var total i64 = std_blob_total();
	var packed str = std_blob_data();
	if (packed.len == 0) {
		blob_unpacked = arena_alloc(1, 1);
		blob_unpacked[0] = 0;
		return blob_unpacked;
	}
	var src *u8 = packed.ptr;
	var out *u8 = arena_alloc(total + 1, 1);
	var si i64 = 0;
	var oi i64 = 0;
	while (oi < total) {
		var flags i64 = src[si] as i64;
		si = si + 1;
		var bit int = 0;
		while (bit < 8 && oi < total) {
			if ((flags & (1 << (bit as i64))) != 0) {
				out[oi] = src[si];
				si = si + 1;
				oi = oi + 1;
			} else {
				var code i64 = ((src[si] as i64) << 8) | (src[si + 1] as i64);
				si = si + 2;
				var dist i64 = (code >> 4) + 1;
				var len i64 = (code & 15) + 3;
				var from i64 = oi - dist;
				var k2 i64 = 0;
				while (k2 < len) {
					out[oi] = out[from + k2];
					oi = oi + 1;
					k2 = k2 + 1;
				}
			}
			bit = bit + 1;
		}
	}
	out[total] = 0;
	blob_unpacked = out;
	return out;
}

// The module directory. Bytes, not a comparison chain: the names are
// NUL-terminated in module order in std.names, and std.index holds one
// (u32 offset, u16 length) record per module, little-endian, which is the
// byte order of every target. Both come from tools/genblob.py.
var STD_INDEX_ENTRY i64 = 6;

fn std_blob_off(i int) i64 {
	if (i < 0 || i >= std_blob_count()) { return -1; }
	var idx str = std_blob_index();
	var at i64 = (i as i64) * STD_INDEX_ENTRY;
	if (at + STD_INDEX_ENTRY > idx.len) { return -1; }
	var p *u8 = idx.ptr + at;
	return (p[0] as i64) | ((p[1] as i64) << 8) |
	       ((p[2] as i64) << 16) | ((p[3] as i64) << 24);
}

fn std_blob_len(i int) i64 {
	if (i < 0 || i >= std_blob_count()) { return 0; }
	var idx str = std_blob_index();
	var at i64 = (i as i64) * STD_INDEX_ENTRY;
	if (at + STD_INDEX_ENTRY > idx.len) { return 0; }
	var p *u8 = idx.ptr + at + 4;
	return (p[0] as i64) | ((p[1] as i64) << 8);
}

fn std_blob_name(i int) str {
	var names str = std_blob_names();
	var p *u8 = names.ptr;
	var k int = 0;
	var start i64 = 0;
	var j i64 = 0;
	while (j < names.len) {
		if (p[j] == 0) {
			if (k == i) {
				var s str;
				s.ptr = p + start;
				s.len = j - start;
				return s;
			}
			k = k + 1;
			start = j + 1;
		}
		j = j + 1;
	}
	var e str;
	return e;
}

fn std_blob_src(i int) str {
	var s str;
	s.ptr = null;
	s.len = 0;
	var off i64 = std_blob_off(i);
	if (off < 0) { return s; }
	s.ptr = blob_unpack() + off;
	s.len = std_blob_len(i);
	return s;
}
