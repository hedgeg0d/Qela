import "comp.qela";
import "type.qela";

// A target-neutral linearization of what gen_expr/gen_stmt already compute:
// one accumulator (OP_ACC, the RAX-equivalent) that most ops read and/or
// write, plus values that live in a promoted register (OP_VREG, carrying
// exactly what regalloc.qela already put in Var.reg) or a frame slot
// (OP_STACKSLOT, carrying Var.offset). This is not SSA and there is no
// basic-block graph: control flow is IR_BR/IR_LABEL records patched the
// same way codegen.qela's br_at/patch_here already work today, just one
// indirection later. A backend (x86_emit.qela, arm64_emit.qela) walks the
// list once and turns each IrOp into machine bytes.

let IR_MOV   = 0;  // dst = src0
let IR_LOAD  = 1;  // dst = *src0 (width/signedness from dst.ty)
let IR_STORE = 2;  // *dst = src0
let IR_ALU   = 3;  // dst = src0 <aux: alu op> src1
let IR_CMP   = 4;  // compare src0, src1; aux is unused, a following IR_BR/IR_SETCC reads the flags
let IR_BR    = 5;  // aux: condition code (CC_ALWAYS for unconditional); dst.off is the target IR_LABEL id
let IR_LABEL = 6;  // dst.off is this label's id
let IR_SETCC = 7;  // dst = (flags satisfy <aux: condition code>) ? 1 : 0
let IR_CALL  = 8;  // src0: the target (OP_FUNC/OP_FUNCADDR slot); args already classified into OP_VREG call-arg slots
let IR_RET   = 9;
let IR_UNARY = 10; // dst = <aux: unary op> src0
let IR_LEA   = 11; // dst = src0 + src1 * <aux: scale code 0..3 = x1,x2,x4,x8> + dst.off
let IR_CAST  = 12; // dst = convert src0 to dst.ty; <aux: cast kind>
let IR_MEMCPY = 13; // copy <aux> bytes from the address in src0 to the address in dst
let IR_SYSCALL = 14; // <aux: syscall number>; arguments already staged
let IR_ASM   = 15; // inline asm; <aux: the asm Node's address>
let IR_ASSERT = 16; // a bounds/assert site; <aux: index into the assert-site list>
let IR_FUNCADDR = 17; // dst = address of the function in src0 (OP_FUNC)
let IR_ATOMIC = 18; // <aux: atomic subop>; dst/src0 carry address and value
let IR_COROSWITCH = 19; // switch coroutine context around the following call
let IR_TLSADDR = 20; // dst = address of the TLS slot in src0 (OP_TLSVAR)
let IR_FENCE = 21; // memory fence; <aux: ordering>
let IR_PUSH  = 22; // push src0 onto the staging stack
let IR_POP   = 23; // pop the staging stack into dst

// IrOp.aux for IR_UNARY.
let UOP_NEG    = 0;
let UOP_BITNOT = 1;
let UOP_LNOT   = 2;

// IrOp.aux for IR_CAST.
let CAST_TRUNC = 0; // narrow an integer (the low bits are the result on both targets)
let CAST_SEXT  = 1;
let CAST_ZEXT  = 2;
let CAST_BOOL  = 3; // nonzero -> 0/1
let CAST_FTOI  = 4; // float -> int (later targets)
let CAST_ITOF  = 5; // int -> float
let CAST_FTRUNC = 6; // f64 -> f32
let CAST_FEXT  = 7; // f32 -> f64

// IrOp.aux for IR_ATOMIC.
let ATOMIC_CAS  = 0;
let ATOMIC_ADD  = 1;
let ATOMIC_SUB  = 2;
let ATOMIC_SWAP = 3;
let ATOMIC_LOAD = 4;
let ATOMIC_STORE = 5;

// IrOp.aux for IR_FENCE.
let FENCE_ACQUIRE = 0;
let FENCE_RELEASE = 1;
let FENCE_SEQCST  = 2;

// IrOperand.kind
let OP_NONE      = 0;
let OP_ACC       = 1;
let OP_VREG      = 2;  // reg is a concrete backend register number (from Var.reg) or a call-arg rank
let OP_STACKSLOT = 3;  // off is a frame offset (from Var.offset)
let OP_IMM       = 4;  // off is the immediate value
let OP_GLOBAL    = 5;  // off is the *Var, reinterpreted as an address
let OP_STR       = 6;  // off is a string-literal id
let OP_REG       = 7;  // reg is a fixed convention register, not tied to any Var
let OP_OP2       = 8;  // the frontend's second-operand staging register (a binop's right side); reg is its rank
let OP_MEM       = 9;  // a memory reference: address in the base operand, displacement in off, element type in ty
let OP_FUNC      = 10; // off is the *Func, reinterpreted as an address
let OP_TLSVAR    = 11; // off is the *Var, reinterpreted as an address; a thread-local slot, not a plain global

// IrOp.aux for IR_ALU.
let ALU_ADD = 0;
let ALU_SUB = 1;
let ALU_MUL = 2;
let ALU_DIV = 3;
let ALU_MOD = 4;
let ALU_AND = 5;
let ALU_OR  = 6;
let ALU_XOR = 7;
let ALU_SHL = 8;
let ALU_SHR = 9;

// Condition codes, neutral: each backend maps these to its own flags/field
// encoding (x86's Jcc/SETcc table, ARM64's 4-bit condition field).
let CC_ALWAYS = 0;
let CC_EQ     = 1;
let CC_NE     = 2;
let CC_LT     = 3;
let CC_LE     = 4;
let CC_GT     = 5;
let CC_GE     = 6;
let CC_ULT    = 7;
let CC_ULE    = 8;
let CC_UGT    = 9;
let CC_UGE    = 10;

// The opposite condition: a backend inverts an IR_BR by mapping to its own
// inverted encoding, never by the frontend materialising a negated predicate.
fn cc_invert(cc i64) i64 {
	if (cc == CC_EQ) { return CC_NE; }
	if (cc == CC_NE) { return CC_EQ; }
	if (cc == CC_LT) { return CC_GE; }
	if (cc == CC_GE) { return CC_LT; }
	if (cc == CC_LE) { return CC_GT; }
	if (cc == CC_GT) { return CC_LE; }
	if (cc == CC_ULT) { return CC_UGE; }
	if (cc == CC_UGE) { return CC_ULT; }
	if (cc == CC_ULE) { return CC_UGT; }
	if (cc == CC_UGT) { return CC_ULE; }
	die("internal: cc_invert: unhandled cc");
	return CC_ALWAYS;
}

struct IrOperand;
struct IrOperand {
	kind int,
	reg  int,
	off  i64,
	ty   *Type,
}

struct IrOp;
struct IrOp {
	kind int,
	next *IrOp,
	dst  IrOperand,
	src0 IrOperand,
	src1 IrOperand,
	aux  i64,
	pos  i64,
}

var ir_head *IrOp;
var ir_tail *IrOp;

// Clears the op list. A backend walks and discards the list once after each
// op it lowers (x86_lower_all today), so an op never survives into the next
// function -- label ids stay the backend's concern, keyed off the frontend's
// ir_new_label below, and are zeroed per function by gen_func.
fn ir_reset() {
	ir_head = 0 as *IrOp;
	ir_tail = 0 as *IrOp;
}

fn operand_none() IrOperand {
	var o IrOperand;
	o.kind = OP_NONE;
	return o;
}

fn operand_acc() IrOperand {
	var o IrOperand;
	o.kind = OP_ACC;
	return o;
}

fn operand_imm(v i64) IrOperand {
	var o IrOperand;
	o.kind = OP_IMM;
	o.off = v;
	return o;
}

fn operand_reg(reg int) IrOperand {
	var o IrOperand;
	o.kind = OP_REG;
	o.reg = reg;
	return o;
}

fn operand_op2(rank int) IrOperand {
	var o IrOperand;
	o.kind = OP_OP2;
	o.reg = rank;
	return o;
}

fn operand_vreg(reg int, ty *Type) IrOperand {
	var o IrOperand;
	o.kind = OP_VREG;
	o.reg = reg;
	o.ty = ty;
	return o;
}

fn operand_stackslot(off i64, ty *Type) IrOperand {
	var o IrOperand;
	o.kind = OP_STACKSLOT;
	o.off = off;
	o.ty = ty;
	return o;
}

// A memory reference whose address lives in the base operand and whose
// element is ty bytes after the base plus off. The base operand is the
// address itself (OP_ACC/OP_VREG/OP_STACKSLOT); only off and ty are new.
fn operand_mem(off i64, ty *Type) IrOperand {
	var o IrOperand;
	o.kind = OP_MEM;
	o.off = off;
	o.ty = ty;
	return o;
}

fn operand_global(v *Var) IrOperand {
	var o IrOperand;
	o.kind = OP_GLOBAL;
	o.off = v as i64;
	return o;
}

fn operand_str(id int) IrOperand {
	var o IrOperand;
	o.kind = OP_STR;
	o.off = id as i64;
	return o;
}

fn operand_func(f *Func) IrOperand {
	var o IrOperand;
	o.kind = OP_FUNC;
	o.off = f as i64;
	return o;
}

fn operand_tlsvar(v *Var) IrOperand {
	var o IrOperand;
	o.kind = OP_TLSVAR;
	o.off = v as i64;
	return o;
}

// Appends a new op to the current function's list and returns it so callers
// can fill in dst/src0/src1/aux after the shape is fixed.
fn ir_emit(kind int, pos i64) *IrOp {
	var op *IrOp = arena_alloc(sizeof(IrOp), 8) as *IrOp;
	op.kind = kind;
	op.pos = pos;
	if (ir_tail as i64 == 0) { ir_head = op; } else { ir_tail.next = op; }
	ir_tail = op;
	return op;
}
