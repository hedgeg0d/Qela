import "comp.qela";
import "diag.qela";
import "type.qela";
import "funcs.qela";
import "regalloc.qela";
import "generic.qela";
import "opt.qela";
import "bounds.qela";
import "../std/io.qela";
import "std_blob.qela";

// ── "did you mean?" suggestions ──
//
// When the user types an unknown identifier that's close to a keyword
// (Levenshtein distance ≤ 2), suggest the keyword as a hint. The list
// mirrors `keywords[]` in src/lex.c; both must agree. The function
// returns the keyword text, or "" if nothing is close enough.

var keywords [22]str;
var keywords_inited bool = false;

fn keywords_setup() {
	if (keywords_inited) { return; }
	keywords_inited = true;
	keywords[0]  = "fn";
	keywords[1]  = "let";
	keywords[2]  = "var";
	keywords[3]  = "if";
	keywords[4]  = "else";
	keywords[5]  = "while";
	keywords[6]  = "for";
	keywords[7]  = "in";
	keywords[8]  = "break";
	keywords[9]  = "continue";
	keywords[10] = "return";
	keywords[11] = "as";
	keywords[12] = "struct";
	keywords[13] = "enum";
	keywords[14] = "match";
	keywords[15] = "defer";
	keywords[16] = "import";
	keywords[17] = "comptime";
	keywords[18] = "sizeof";
	keywords[19] = "true";
	keywords[20] = "false";
	keywords[21] = "asm";
}

fn lev_dist(a str, b str) i64 {
	if (a.len == 0) { return b.len; }
	if (b.len == 0) { return a.len; }
	// Two-row DP. Cost: (a.len+1) * (b.len+1) cells; with short keywords
	// (~10 chars max) this is ~144 ops per candidate, 22 candidates → 3 KiB
	// worth of stack per call. We use a flat int array on the arena.
	var n i64 = a.len + 1;
	var m i64 = b.len + 1;
	var prev *i64 = arena_alloc(m * 8, 8) as *i64;
	var cur  *i64 = arena_alloc(m * 8, 8) as *i64;
	var j i64 = 0;
	while (j < m) { prev[j] = j; j = j + 1; }
	var i i64 = 1;
	while (i <= a.len) {
		cur[0] = i;
		var k i64 = 1;
		while (k <= b.len) {
			var cost i64 = 1;
			if (a.ptr[i - 1] == b.ptr[k - 1]) { cost = 0; }
			var del i64 = prev[k] + 1;
			var ins i64 = cur[k - 1] + 1;
			var sub i64 = prev[k - 1] + cost;
			var v i64 = del;
			if (ins < v) { v = ins; }
			if (sub < v) { v = sub; }
			cur[k] = v;
			k = k + 1;
		}
		var tmp *i64 = prev;
		prev = cur;
		cur = tmp;
		i = i + 1;
	}
	return prev[b.len];
}

fn did_you_mean(name str) str {
	keywords_setup();
	var best str;
	var best_d i64 = 3;   // threshold: only suggest ≤ 2 edits
	var k i64 = 0;
	while (k < 22) {
		var d i64 = lev_dist(name, keywords[k]);
		if (d > 0 && d <= 2 && d < best_d) {
			best = keywords[k];
			best_d = d;
		}
		k = k + 1;
	}
	return best;
}

struct Scope;
struct VarScope;

// ── global state ──

var scope_root *Scope;
var global_vars *Var;

// The innermost lambda's own scope and a counter for its hidden name. Both
// are nonzero/active only while a lambda body is being parsed: a variable
// resolved outside that scope chain but inside the enclosing function is a
// capture, which lambdas do not support.
var lambda_scope *Scope;
var lambda_seq int;

// Typed block expressions (`T { ...; super v; }`) desugar to an
// immediately-called hidden function like a lambda, but unlike a lambda
// they may read outer locals: each one becomes a hidden by-value parameter
// the first time it is referenced, so the block only ever sees a copy
// (readonly by construction, no separate enforcement needed). `capturing`
// gates this behavior onto typed blocks only -- a plain lambda nested
// inside one still rejects captures, same as today.
struct Capture;
struct Capture {
	next   *Capture,
	outer  *Var,
	hidden *Var,
}
var capturing bool;
var cap_head *Capture;
var cap_tail *Capture;
var cap_n int;
var cap_rwords int;
var cap_stack_slot int;

// Finds or creates the hidden parameter that carries `v`'s value into the
// typed block currently being parsed (`cur_func` is that block's hidden
// Func). Mirrors the register-word/stack-spill bookkeeping in parse_func's
// parameter loop -- captures are just parameters discovered incrementally
// instead of all upfront.
fn capture_get_or_add(v *Var, p i64) *Var {
	var c *Capture = cap_head;
	while (c as i64 != 0) {
		if (c.outer as i64 == v as i64) { return c.hidden; }
		c = c.next;
	}
	var b Buf;
	fmt_str(&b, "_$cap");
	fmt_i64(&b, cap_n as i64);
	var hname str = buf_str(&b);
	var hv *Var = declare_var(hname, v.ty, p);
	var is2word bool = is_aggregate(v.ty) && v.ty.size > 8 && v.ty.size <= 16;
	if (is2word) { cap_rwords = cap_rwords + 2; } else { cap_rwords = cap_rwords + 1; }
	hv.by_ref = is_aggregate(v.ty) && abi_by_ref(v.ty.size);
	if (cap_rwords > abi_n_arg_regs() || cap_n >= abi_n_arg_regs()) {
		if (is2word) { error_at(p, "a captured str or struct here would not fit in the argument registers"); }
		hv.arg_stack = true;
		hv.no_reg = true;
		hv.offset = (16 + 8 * cap_stack_slot) as int;
		cap_stack_slot = cap_stack_slot + 1;
		cur_func.n_stack_args = cur_func.n_stack_args + 1;
	}
	set_func_param(cur_func, cap_n, hv);
	var nc *Capture = arena_alloc(sizeof(Capture), 8) as *Capture;
	nc.outer = v;
	nc.hidden = hv;
	if (cap_head as i64 == 0) { cap_head = nc; } else { cap_tail.next = nc; }
	cap_tail = nc;
	cap_n = cap_n + 1;
	if (cap_n > 14) { error_at(p, "too many captured variables (at most 14)"); }
	return hv;
}

// Set while parsing the body of a `defer`: return, break and continue are
// rejected there, because codegen runs defer bodies while unwinding and
// another return would re-enter the same defer forever.
var in_defer_body bool = false;

// The parser recurses on nested parentheses, unary prefixes, assignments
// and blocks; each recursion is counted here and capped, so a hostile
// input overflows the C stack instead of the compiler's heap.
var parse_depth int = 0;

fn parse_enter(t **Token) {
	parse_depth = parse_depth + 1;
	if (parse_depth > 1024) {
		error_at((*t).pos, "code is nested too deeply");
	}
}

fn parse_leave() {
	parse_depth = parse_depth - 1;
}

// Set when an interpolated string is desugared; parse() imports
// std/fmt.qela at the next top-level splice point.
var need_fmt bool = false;

// Set when a `~` dynamic local is parsed; parse() imports std/dyn.qela at
// the next top-level splice point, same as need_fmt.
var need_dyn bool = false;

var need_interp bool = false;
var opt_global_interpreted bool = false;
var opt_global_jit bool = false;

// ── top-level asm and the entry point ──

// `asm { ... }` bytes land at the start of the code segment, before any
// function; `entry name;` picks the ELF entry and suppresses the default
// call-main stub. Neither is OS-specific: the first is raw bytes at a
// known place, the second generalizes "main is the entry".
var top_asm_head *Node;
var top_asm_tail *Node;
var entry_name str;

fn find_global(name str) *Var {
	var v *Var = global_vars;
	while (v as i64 != 0) {
		if (str_eq(v.name, name)) { return v; }
		v = v.next;
	}
	return 0 as *Var;
}

fn parse_top_asm(t **Token) {
	*t = (*t).next;
	tok_expect(t, "{");
	var head Node;
	var tail *Node = &head;
	while (!tok_eq(*t, "}")) {
		if (tail as i64 != &head as i64) { tok_expect(t, ","); }
		var a *Node = parse_assign(t);
		if (a.kind != ND_ASMREF) {
			var cv ComptimeVal = comptime_eval(a);
			if (cv.kind != CV_INT || cv.num < 0) { error_at(a.pos, "top-level asm operand must be a constant"); }
			a.kind = ND_NUM;
			a.val = cv.num;
		}
		tail.next = a;
		tail = a;
	}
	tok_expect(t, "}");
	tok_expect(t, ";");
	if (top_asm_tail as i64 == 0) { top_asm_head = head.next; }
	else { top_asm_tail.next = head.next; }
	top_asm_tail = tail;
}

fn parse_entry(t **Token) {
	var p i64 = (*t).pos;
	*t = (*t).next;
	if ((*t).kind != TK_IDENT) { error_at((*t).pos, "entry needs a function name"); }
	entry_name = (*t).text;
	*t = (*t).next;
	tok_expect(t, ";");
}

// ── macros ──

var macro_list *Macro;
var macro_tail *Macro;

fn macro_find(name str) *Macro {
	var m *Macro = macro_list;
	while (m as i64 != 0) {
		if (str_eq(m.name, name)) { return m; }
		m = m.next;
	}
	return 0 as *Macro;
}

fn macro_param(m *Macro, i int) *Var {
	if (i == 0) { return m.p0; }
	if (i == 1) { return m.p1; }
	if (i == 2) { return m.p2; }
	if (i == 3) { return m.p3; }
	if (i == 4) { return m.p4; }
	return m.p5;
}

// A parameter is a placeholder local: findable by name in the scope while
// the body parses, but never a real local or global (a call replaces every
// reference before typing).
fn macro_decl_param(name str, pos i64) *Var {
	var v *Var = arena_alloc(sizeof(Var), 8) as *Var;
	v.name = name;
	v.ty = 0 as *Type;
	v.pos = pos;
	var vsc *VarScope = arena_alloc(sizeof(VarScope), 8) as *VarScope;
	vsc.next = scope_root.vars;
	vsc.name = name;
	vsc.varp = v;
	vsc.pos = pos;
	scope_root.vars = vsc;
	return v;
}

fn parse_macro(t **Token) {
	var mp i64 = (*t).pos;
	*t = (*t).next;
	if ((*t).kind != TK_IDENT) { error_at((*t).pos, "macro needs a name"); }
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;
	if (macro_find(name) as i64 != 0) { error_at(p, "macro redefinition"); }
	enter_scope();
	var m *Macro = arena_alloc(sizeof(Macro), 8) as *Macro;
	m.name = name;
	m.pos = p;
	tok_expect(t, "(");
	var np int = 0;
	if (!tok_eq(*t, ")")) {
		while (true) {
			if (np >= 6) { error_at((*t).pos, "too many macro parameters"); }
			if ((*t).kind != TK_IDENT) { error_at((*t).pos, "macro parameter must be an identifier"); }
			var pn str = (*t).text;
			var pp i64 = (*t).pos;
			*t = (*t).next;
			var pv *Var = macro_decl_param(pn, pp);
			if (np == 0) { m.p0 = pv; }
			else if (np == 1) { m.p1 = pv; }
			else if (np == 2) { m.p2 = pv; }
			else if (np == 3) { m.p3 = pv; }
			else if (np == 4) { m.p4 = pv; }
			else { m.p5 = pv; }
			np = np + 1;
			if (tok_consume(t, ",")) { continue; }
			break;
		}
	}
	tok_expect(t, ")");
	tok_expect(t, "=");
	m.body = parse_assign(t);
	tok_expect(t, ";");
	leave_scope();
	m.nparams = np;
	if (macro_tail as i64 == 0) { macro_list = m; }
	else { macro_tail.next = m; }
	macro_tail = m;
}

var type_vars [6]*Type;
var ntype_vars int;

struct VarScope {
	next *VarScope,
	name str,
	varp *Var,
	pos  i64,
}

struct Scope {
	next *Scope,
	vars *VarScope,
}

fn enter_scope() {
	var s *Scope = arena_alloc(sizeof(Scope), 8) as *Scope;
	s.next = scope_root;
	scope_root = s;
}

fn leave_scope() { scope_root = scope_root.next; }

fn find_var(name str) *Var {
	var s *Scope = scope_root;
	while (s as i64 != 0) {
		var vs *VarScope = s.vars;
		while (vs as i64 != 0) {
			if (str_eq(vs.name, name)) { return vs.varp; }
			vs = vs.next;
		}
		s = s.next;
	}
	return 0 as *Var;
}

fn declare_var(name str, ty *Type, pos i64) *Var {
	var vs *VarScope = scope_root.vars;
	while (vs as i64 != 0) {
		if (str_eq(vs.name, name)) {
			// Attach the previous declaration's position so the
			// error points at both spots, like Rust/Clang.
			diag_secondary(vs.pos, "previous declaration here");
			var b Buf;
			fmt_str(&b, "redeclaration of '");
			fmt_str(&b, name);
			fmt_str(&b, "'");
			error_at(pos, buf_str(&b));
		}
		vs = vs.next;
	}
	// Shadow check: same name in an outer scope. We only warn when the
	// outer scope is strictly outside the current one — params and locals
	// can reuse the same name, but a local that hides a param is worth
	// pointing out. Globals are exempted: a local that happens to share
	// a global's name is the user's choice, and warning would be noise.
	if (cur_func as i64 != 0) {
		var s *Scope = scope_root.next;
		var shadowed_pos i64 = -1;
		while (s as i64 != 0) {
			var ovs *VarScope = s.vars;
			while (ovs as i64 != 0) {
				if (str_eq(ovs.name, name) && !ovs.varp.is_global) {
					shadowed_pos = ovs.pos;
					break;
				}
				ovs = ovs.next;
			}
			if (shadowed_pos != -1) { break; }
			s = s.next;
		}
		if (shadowed_pos != -1) {
			diag_secondary(shadowed_pos, "previous declaration was here");
			var sb Buf;
			fmt_str(&sb, "variable '");
			fmt_str(&sb, name);
			fmt_str(&sb, "' shadows an outer one");
			warn_at(pos, buf_str(&sb));
		}
	}
	var v *Var = arena_alloc(sizeof(Var), 8) as *Var;
	v.name = name;
	v.ty = ty;
	v.pos = pos;
	if (cur_func as i64 != 0) {
		v.next = cur_func.locals;
		cur_func.locals = v;
	} else {
		v.is_global = true;
		v.next = global_vars;
		global_vars = v;
	}
	var vsc *VarScope = arena_alloc(sizeof(VarScope), 8) as *VarScope;
	vsc.name = name;
	vsc.varp = v;
	vsc.pos = pos;
	if (cur_func as i64 != 0) {
		vsc.next = scope_root.vars;
		scope_root.vars = vsc;
	} else {
		var root *Scope = scope_root;
		while (root.next as i64 != 0) { root = root.next; }
		vsc.next = root.vars;
		root.vars = vsc;
	}
	return v;
}

// ── token helpers ──

fn tok_eq(t *Token, text str) bool {
	return str_eq(t.text, text);
}

fn tok_expect(t **Token, text str) {
	if (!tok_eq(*t, text)) { error_at((*t).pos, "expected something else"); }
	*t = (*t).next;
}

fn tok_consume(t **Token, text str) bool {
	if (!tok_eq(*t, text)) { return false; }
	*t = (*t).next;
	return true;
}

fn skip_balanced(t *Token) *Token {
	var depth int = 1;
	while (depth > 0) {
		if (tok_eq(t, "{")) { depth = depth + 1; }
		else if (tok_eq(t, "}")) {
			depth = depth - 1;
			if (depth == 0) { return t; }
		}
		t = t.next;
	}
	return t;
}

fn comptime_truthy(v str) bool {
	if (v.len == 0) { return false; }
	if (str_eq(v, "0")) { return false; }
	if (str_eq(v, "false")) { return false; }
	return true;
}

fn eval_comptime_cond(t **Token) bool {
	var neg bool = false;
	if (tok_eq(*t, "!")) { neg = true; *t = (*t).next; }
	if ((*t).kind != TK_IDENT) { error_at((*t).pos, "expected a comptime variable name"); }
	var name str = (*t).text;
	*t = (*t).next;
	var val str = comptime_get(name);
	if (tok_eq(*t, "==") || tok_eq(*t, "!=")) {
		if (neg) { error_at((*t).pos, "cannot combine '!' with '==' or '!='"); }
		var want_eq bool = tok_eq(*t, "==");
		*t = (*t).next;
		if ((*t).kind != TK_STR) { error_at((*t).pos, "expected a string after == or !="); }
		var rhs str = (*t).sval;
		*t = (*t).next;
		var eq bool = str_eq(val, rhs);
		if (want_eq) { return eq; }
		return !eq;
	}
	var truthy bool = comptime_truthy(val);
	if (neg) { return !truthy; }
	return truthy;
}

// `$if (COND) { ... } $else { ... }` is a token-stream splice, done before
// the real parser ever sees the untaken branch: it rewires the linked
// token list to skip straight from the taken branch's tokens to whatever
// follows the whole `$if`/`$else`, exactly like splice_import already
// rewires tokens for an import. This is why it works at both top level and
// statement level with no separate AST node -- parse_stmt/parse() just see
// a normal token stream afterward.
fn is_comptime_if(t *Token) bool {
	return tok_eq(t, "$") && tok_eq(t.next, "if");
}

fn parse_comptime_if(t **Token) {
	var tok *Token = (*t).next.next;
	tok_expect(&tok, "(");
	var cond bool = eval_comptime_cond(&tok);
	tok_expect(&tok, ")");
	tok_expect(&tok, "{");
	var a_start *Token = tok;
	var a_close *Token = skip_balanced(tok);
	var after_a *Token = a_close.next;
	var rest *Token = after_a;
	var b_start *Token = 0 as *Token;
	var b_close *Token = 0 as *Token;
	if (tok_eq(after_a, "$") && tok_eq(after_a.next, "else")) {
		var btok *Token = after_a.next.next;
		tok_expect(&btok, "{");
		b_start = btok;
		b_close = skip_balanced(btok);
		rest = b_close.next;
	}
	if (cond) {
		if (a_start as i64 == a_close as i64) { *t = rest; return; }
		var p *Token = a_start;
		while (p.next as i64 != a_close as i64) { p = p.next; }
		p.next = rest;
		*t = a_start;
		return;
	}
	if (b_start as i64 != 0) {
		if (b_start as i64 == b_close as i64) { *t = rest; return; }
		var p *Token = b_start;
		while (p.next as i64 != b_close as i64) { p = p.next; }
		p.next = rest;
		*t = b_start;
		return;
	}
	*t = rest;
}

fn resolve_comptime(t **Token) {
	while (is_comptime_if(*t)) { parse_comptime_if(t); }
}

// ── node constructors ──

fn new_node(kind int, pos i64) *Node {
	var n *Node = arena_alloc(sizeof(Node), 8) as *Node;
	n.kind = kind;
	n.pos = pos;
	return n;
}

fn num_node(v i64, pos i64) *Node {
	var n *Node = new_node(ND_NUM, pos);
	n.val = v;
	return n;
}

fn bin_node(kind int, lhs *Node, rhs *Node, pos i64) *Node {
	var n *Node = new_node(kind, pos);
	n.lhs = lhs;
	n.rhs = rhs;
	return n;
}

// ── strlit table ──

var strlist_head *StrLit;
var strlist_tail *StrLit;
var nstrs int = 0;

fn add_str(s str) int {
	var lit *StrLit = arena_alloc(sizeof(StrLit), 8) as *StrLit;
	lit.s = s;
	lit.id = nstrs;
	nstrs = nstrs + 1;
	if (strlist_tail as i64 == 0) { strlist_head = lit; }
	else { strlist_tail.next = lit; }
	strlist_tail = lit;
	return lit.id;
}

//
// Forward-declared at the top for mutual recursion.
// All functions are mutually visible after the full token stream is parsed.
//
// The ordering below ensures that parse_type comes first (used by everything),
// then expression parsers, then statements, then top-level declarations.>

// ── type parser ──

fn parse_type(t **Token) *Type {
	if (tok_consume(t, "*")) {
		if (tok_consume(t, "volatile")) { return type_ptr_volatile(parse_type(t)); }
		return type_ptr(parse_type(t));
	}
	if (tok_eq(*t, "[")) {
		*t = (*t).next;
		if (tok_consume(t, "]")) {
			var base *Type = parse_type(t);
			return type_slice(base);
		}
		if ((*t).kind != TK_NUM) { error_at((*t).pos, "expected array length"); }
		var lp i64 = (*t).pos;
		var len i64 = (*t).val;
		*t = (*t).next;
		tok_expect(t, "]");
		var base *Type = parse_type(t);
		if (len <= 0) { error_at(lp, "an array length must be positive"); }
		if (base.size != 0 && len > (0x7fffffff as i64) / (base.size as i64)) {
			error_at(lp, "array is too large");
		}
		return type_array(base, len);
	}
	if ((*t).kind != TK_IDENT) {
		if (tok_eq(*t, "fn")) {
			*t = (*t).next;
			tok_expect(t, "(");
			var t0 *Type = fn_type_new(ty_void);
			var head Member;
			var tail *Member = &head;
			var np int = 0;
			while (!tok_eq(*t, ")")) {
				if (np >= 6) { error_at((*t).pos, "a function type takes at most 6 parameters"); }
				var pp i64 = (*t).pos;
				var pt *Type = parse_type(t);
				if (pt.size > 8) {
					error_at(pp, "a function type parameter must fit in one word");
				}
				var m *Member = member_alloc();
				m.ty = pt;
				tail.next = m;
				tail = m;
				np = np + 1;
				if (!tok_eq(*t, ")")) { tok_expect(t, ","); }
			}
			*t = (*t).next;
			t0.members = head.next;
			t0.base = parse_type(t);
			return t0;
		}
		error_at((*t).pos, "expected type name");
	}
	var i int = 0;
	while (i < ntype_vars) {
		if (str_eq(type_vars[i].name, (*t).text)) {
			var tv *Type = type_vars[i];
			*t = (*t).next;
			return tv;
		}
		i = i + 1;
	}
	var tm *Tmpl = tmpl_find((*t).text);
	if (tm as i64 != 0) {
		var tp i64 = (*t).pos;
		*t = (*t).next;
		tok_expect(t, "(");
		var a0 *Type = parse_type(t);
		var a1 *Type = 0 as *Type;
		if (tm.nparams > 1) {
			tok_expect(t, ",");
			a1 = parse_type(t);
		}
		tok_expect(t, ")");
		return generic_instance(tm, a0, a1);
	}
	var ty *Type = type_lookup((*t).text);
	if (ty as i64 == 0) { error_at((*t).pos, "unknown type"); }
	*t = (*t).next;
	return ty;
}

// struct Name(T) / enum Name(T, U): bind the parameters as type variables for
// the duration of the body, and hand back the template to fill in.
fn parse_tmpl_params(t **Token, name str, p i64) *Tmpl {
	if (!tok_eq(*t, "(")) { return 0 as *Tmpl; }
	*t = (*t).next;
	var tm *Tmpl = arena_alloc(sizeof(Tmpl), 8) as *Tmpl;
	tm.name = name;
	while (!tok_eq(*t, ")")) {
		if (tm.nparams > 0) { tok_expect(t, ","); }
		if (tm.nparams == 2) { error_at((*t).pos, "at most two type parameters"); }
		var pn str = (*t).text;
		*t = (*t).next;
		if (ntype_vars == 6) { error_at((*t).pos, "too many type variables in scope"); }
		var tv *Type = type_new_var(pn);
		type_vars[ntype_vars] = tv;
		ntype_vars = ntype_vars + 1;
		if (tm.nparams == 0) { tm.tv0 = tv; } else { tm.tv1 = tv; }
		tm.nparams = tm.nparams + 1;
	}
	tok_expect(t, ")");
	if (tm.nparams == 0) { error_at(p, "a parameterized type needs a parameter"); }
	tm.proto = arena_alloc(sizeof(Type), 8) as *Type;
	tm.proto.name = name;
	tmpl_add(tm);
	return tm;
}

// ── expression parser ──

fn call_args(t **Token, n *Node) *Node {
	tok_expect(t, "(");
	var nargs int = 0;
	while (!tok_eq(*t, ")")) {
		if (nargs > 0) { tok_expect(t, ","); }
		var a *Node = parse_assign(t);
		var tail **Node = &n.args;
		while (*tail as i64 != 0) { tail = &(*tail).next; }
		*tail = a;
		nargs = nargs + 1;
	}
	tok_expect(t, ")");
	n.nargs = nargs;
	return n;
}

fn parse_primary(t **Token) *Node {
	if (tok_consume(t, "(")) {
		var p i64 = (*t).pos;
		var n *Node = parse_expr(t);
		tok_expect(t, ")");
		return n;
	}
	// A symbol reference for asm operands: `$name` embeds the absolute
	// address, `$rel name` a rel32 slot, patched when addresses are known.
	if (tok_consume(t, "$")) {
		var p i64 = (*t).pos;
		if ((*t).kind != TK_IDENT) { error_at((*t).pos, "expected a symbol after '$'"); }
		var sname str = (*t).text;
		*t = (*t).next;
		var n *Node = new_node(ND_ASMREF, p);
		if (str_eq(sname, "rel") && (*t).kind == TK_IDENT) {
			n.val = 1;
			n.name = (*t).text;
			*t = (*t).next;
		} else {
			n.val = 0;
			n.name = sname;
		}
		return n;
	}
	if ((*t).kind == TK_NUM) {
		var v i64 = (*t).val;
		var p i64 = (*t).pos;
		*t = (*t).next;
		return num_node(v, p);
	}
	if ((*t).kind == TK_FLOAT) {
		var v i64 = (*t).val;
		var p i64 = (*t).pos;
		*t = (*t).next;
		var n *Node = num_node(v, p);
		n.ty = type_lookup("f64");
		return n;
	}
	if ((*t).kind == TK_STR) {
		var p i64 = (*t).pos;
		var id int = add_str((*t).sval);
		*t = (*t).next;
		var lit *Node = new_node(ND_STRLIT, p);
		lit.val = id as i64;
		if (!tok_eq(*t, "$")) { return lit; }

		// "a=${x}b": the lexer already split the string into literal parts
		// and "$" "{" <expr> "}" runs. The parts are collected and the
		// whole chain becomes one ND_INTERP node, rewritten to fmt calls
		// when types are known.
		need_fmt = true;
		var n *Node = new_node(ND_INTERP, p);
		var fhead Node;
		var ftail *Node = &fhead;
		while (true) {
			var lp *Node = new_node(ND_STRPART, p);
			lp.val = 1;
			lp.lhs = lit;
			ftail.next = lp;
			ftail = lp;

			tok_expect(t, "$");
			tok_expect(t, "{");
			var ep *Node = new_node(ND_STRPART, (*t).pos);
			ep.val = 0;
			ep.lhs = parse_assign(t);
			ftail.next = ep;
			ftail = ep;
			tok_expect(t, "}");

			if ((*t).kind != TK_STR) { error_at((*t).pos, "expected a string part"); }
			var id2 int = add_str((*t).sval);
			var p2 i64 = (*t).pos;
			*t = (*t).next;
			if (!tok_eq(*t, "$")) {
				var last *Node = new_node(ND_STRLIT, p2);
				last.val = id2 as i64;
				var lp2 *Node = new_node(ND_STRPART, p2);
				lp2.val = 1;
				lp2.lhs = last;
				ftail.next = lp2;
				ftail = lp2;
				break;
			}
			var mlit *Node = new_node(ND_STRLIT, p2);
			mlit.val = id2 as i64;
			lit = mlit;
		}
		n.args = fhead.next;
		return n;
	}
	if (tok_consume(t, "true")) { return num_node(1, (*t).pos); }
	if (tok_consume(t, "false")) { return num_node(0, (*t).pos); }
	if (tok_consume(t, "comptime")) {
		var p i64 = (*t).pos;
		var n *Node = new_node(ND_COMPTIME, p);
		n.body = parse_block(t);
		return n;
	}
	if (tok_consume(t, "sizeof")) {
		var p i64 = (*t).pos;
		tok_expect(t, "(");
		var ty *Type = parse_type(t);
		tok_expect(t, ")");
		var n *Node = new_node(ND_SIZEOF, p);
		n.typeval = ty;
		return n;
	}
	// `fn (params) { body }` as an expression: an anonymous function.
	if (tok_consume(t, "fn")) {
		var p i64 = (*t).pos;
		if (!tok_eq(*t, "(")) { error_at((*t).pos, "expected '(' after 'fn'"); }
		return parse_lambda(t, p);
	}
	if ((*t).kind == TK_IDENT) {
		var name str = (*t).text;
		var p i64 = (*t).pos;
		var start *Token = *t;
		*t = (*t).next;

		var named *Type = type_lookup(name);
		// A template name is followed by its arguments, so the whole
		// application has to be read as a type before the dot or the brace.
		if (named as i64 == 0 && tmpl_find(name) as i64 != 0) {
			*t = start;
			named = parse_type(t);
		}

		// enum literal: Name.Variant(...). Anything else followed by a dot
		// is a member access and belongs to parse_postfix.
		if (named as i64 != 0 && named.kind == TY_ENUM && tok_eq(*t, ".")) {
			*t = (*t).next;
			var vname str = (*t).text;
			*t = (*t).next;
			var n *Node = new_node(ND_ENUMLIT, p);
			n.ty = named;
			n.name = vname;
			if (tok_eq(*t, "(")) { call_args(t, n); }
			return n;
		}

		// struct literal: Name{field: val, ...}
		if (named as i64 != 0 && named.kind == TY_STRUCT && tok_eq(*t, "{")) {
			*t = (*t).next;
			var n *Node = new_node(ND_STRUCTLIT, p);
			n.ty = named;
			var fhead Node;
			var ftail *Node = &fhead;
			while (!tok_eq(*t, "}")) {
				if (ftail as i64 != &fhead as i64) { tok_expect(t, ","); }
				if (tok_eq(*t, "}")) { break; }
				var fnm str = (*t).text;
				var fpos i64 = (*t).pos;
				*t = (*t).next;
				tok_expect(t, ":");
				var fld *Node = new_node(ND_FIELD, fpos);
				fld.name = fnm;
				fld.lhs = parse_assign(t);
				ftail.next = fld;
				ftail = fld;
				n.nargs = n.nargs + 1;
			}
			tok_expect(t, "}");
			n.args = fhead.next;
			return n;
		}
		// typed block expression: `T { ...; super v; }`, an inline
		// value-producing block desugared to an immediately-called hidden
		// function. Excludes TY_STRUCT: `Name{` is already struct-literal
		// syntax and the two cannot be told apart without deeper lookahead.
		if (named as i64 != 0 && named.kind != TY_STRUCT && tok_eq(*t, "{")) {
			return parse_typed_block(t, p, named);
		}
		// also search type vars for comptime param references
		if (named as i64 == 0) {
			var i int = 0;
			while (i < ntype_vars) {
				if (str_eq(type_vars[i].name, name)) { named = type_vars[i]; break; }
				i = i + 1;
			}
		}
		// type-expression (used as generic argument: f(i64, x))
		if (named as i64 != 0 && !tok_eq(*t, "(") && !tok_eq(*t, ".") && !tok_eq(*t, "{")) {
			var n *Node = new_node(ND_TYPEEXPR, p);
			n.typeval = named;
			return n;
		}

		if (tok_eq(*t, "(")) {
			if (cur_func as i64 != 0 && cur_func.naked && !str_eq(name, "asm") && !str_eq(name, "syscall")) {
				error_at(p, "naked functions cannot call other functions");
			}
			var m *Macro = macro_find(name);
			if (m as i64 != 0) { return macro_call(m, t, p); }
			var kind int = ND_CALL;
			if (str_eq(name, "syscall")) { kind = ND_SYSCALL; }
			if (str_eq(name, "asm")) { kind = ND_ASM; }
			if (str_eq(name, "assert") || str_eq(name, "panic")) { kind = ND_ASSERT; }
			var n *Node = new_node(kind, p);
			n.name = name;
			// If a variable (not a function) of that name exists, this is a
			// call through it; type.qela checks its type and turns it into an
			// indirect call. Functions declared later are not in the table
			// yet, so a bare name is left alone for find_func in type_call.
			var f0 *Func = 0 as *Func;
			if (kind == ND_CALL) {
				var v *Var = find_var(name);
				if (v as i64 != 0) { n.varp = v; }
				else {
					f0 = find_func(name);
					if (f0 as i64 != 0 && f0.nct != 0) { f0 = 0 as *Func; }
				}
			}
			if (f0 as i64 != 0) { call_args_named(t, n, f0); }
			else { call_args(t, n); }
			// panic(message) is assert(false, message): the condition is a
			// constant zero prepended here, so the rest of the pipeline sees
			// one shape only.
			if (kind == ND_ASSERT && str_eq(name, "panic")) {
				var z *Node = num_node(0, p);
				z.next = n.args;
				n.args = z;
				n.nargs = n.nargs + 1;
			}
			return n;
		}

		// variable reference; a function name used as a value is a function
		// address. Resolution is deferred to add_type: functions declared
		// below this point are not in the table while we parse, so the node
		// is always an address and type.qela decides.
		var v *Var = find_var(name);
		if (v as i64 == 0) {
			var fa *Node = new_node(ND_FUNCADDR, p);
			fa.name = name;
			return fa;
		}
		// Lambdas carry no environment: a variable from the enclosing
		// function is a capture and must be an error, so resolve it against
		// the lambda's own scope chain (globals and the lambda's own
		// parameters and locals are fine).
		if (lambda_scope as i64 != 0 && !v.is_global) {
			var found bool = false;
			var s *Scope = scope_root;
			while (s as i64 != 0) {
				var vs *VarScope = s.vars;
				while (vs as i64 != 0) {
					if (vs.varp as i64 == v as i64) { found = true; }
					vs = vs.next;
				}
				if (s as i64 == lambda_scope as i64) { break; }
				s = s.next;
			}
			if (!found) {
				if (capturing) {
					v = capture_get_or_add(v, p);
				} else {
					var mb Buf;
					fmt_str(&mb, "a lambda cannot capture '");
					fmt_str(&mb, name);
					fmt_str(&mb, "' (no closures)");
					error_at(p, buf_str(&mb));
				}
			}
		}
		var n *Node = new_node(ND_VAR, p);
		n.varp = v;
		return n;
	}
	error_at((*t).pos, "expected expression");
	return 0 as *Node;
}

fn parse_postfix(t **Token) *Node {
	var n *Node = parse_primary(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "[")) {
			var lo *Node = 0 as *Node;
			if (!tok_eq(*t, "..")) { lo = parse_expr(t); }
			if (tok_consume(t, "..")) {
				var s *Node = new_node(ND_SLICE, p);
				s.lhs = n;
				s.rhs = lo;
				if (!tok_eq(*t, "]")) { s.then = parse_expr(t); }
				tok_expect(t, "]");
				n = s;
				continue;
			}
			tok_expect(t, "]");
			n = bin_node(ND_INDEX, n, lo, p);
			continue;
		}
		if (tok_consume(t, ".")) {
			var mpos i64 = (*t).pos;
			var mname str = (*t).text;
			*t = (*t).next;
			// x.foo(args) is call sugar: foo(x, args). No overloading exists
			// (find_func is a plain name lookup), so this is a pure AST
			// rewrite at parse time -- the ordinary call path (type_call)
			// resolves and type-checks it exactly like foo(x, args) would.
			// The dotcall flag lets type_call match the receiver to a
			// pointer first parameter by taking its address (or derefing
			// a pointer receiver for a by-value first parameter).
			if (tok_eq(*t, "(")) {
				if (cur_func as i64 != 0 && cur_func.naked) {
					error_at(mpos, "naked functions cannot call other functions");
				}
				var c *Node = new_node(ND_CALL, mpos);
				c.name = mname;
				c.dotcall = true;
				var v *Var = find_var(mname);
				if (v as i64 != 0) { c.varp = v; }
				call_args(t, c);
				n.next = c.args;
				c.args = n;
				c.nargs = c.nargs + 1;
				n = c;
				continue;
			}
			var m *Node = new_node(ND_MEMBER, mpos);
			m.lhs = n;
			m.name = mname;
			n = m;
			continue;
		}
		return n;
	}
}

fn chan_call(name str, arg *Node, pos i64) *Node {
	var c *Node = new_node(ND_CALL, pos);
	c.name = name;
	var a *Node = new_node(ND_ADDR, pos);
	a.lhs = arg;
	c.args = a;
	c.nargs = 1;
	return c;
}

fn parse_unary(t **Token) *Node {
	parse_enter(t);
	var n *Node = parse_unary_inner(t);
	parse_leave();
	return n;
}

fn parse_unary_inner(t **Token) *Node {
	if (tok_eq(*t, "<-")) {
		var p i64 = (*t).pos;
		*t = (*t).next;
		return chan_call("chan_recv", parse_unary(t), p);
	}

	var p i64 = (*t).pos;
	if (tok_consume(t, "-")) { var n *Node = new_node(ND_NEG, p); n.lhs = parse_unary(t); return n; }
	if (tok_consume(t, "!")) { var n *Node = new_node(ND_NOT, p); n.lhs = parse_unary(t); return n; }
	if (tok_consume(t, "~")) { var n *Node = new_node(ND_BITNOT, p); n.lhs = parse_unary(t); return n; }
	if (tok_consume(t, "&")) { var n *Node = new_node(ND_ADDR, p); n.lhs = parse_unary(t); return n; }
	if (tok_consume(t, "*")) { var n *Node = new_node(ND_DEREF, p); n.lhs = parse_unary(t); return n; }
	if (tok_consume(t, "+")) { return parse_unary(t); }
	return parse_postfix(t);
}

fn parse_cast(t **Token) *Node {
	var n *Node = parse_unary(t);
	while (tok_consume(t, "as")) {
		var p i64 = (*t).pos;
		var c *Node = new_node(ND_CAST, p);
		c.lhs = n;
		c.ty = parse_type(t);
		n = c;
	}
	return n;
}

fn parse_mul(t **Token) *Node {
	var n *Node = parse_cast(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "*")) { n = bin_node(ND_MUL, n, parse_cast(t), p); }
		else if (tok_consume(t, "/")) { n = bin_node(ND_DIV, n, parse_cast(t), p); }
		else if (tok_consume(t, "%")) { n = bin_node(ND_MOD, n, parse_cast(t), p); }
		else if (tok_consume(t, "<<")) { n = bin_node(ND_SHL, n, parse_cast(t), p); }
		else if (tok_consume(t, ">>")) { n = bin_node(ND_SHR, n, parse_cast(t), p); }
		else if (tok_consume(t, "&")) { n = bin_node(ND_BITAND, n, parse_cast(t), p); }
		else { return n; }
	}
}

fn parse_add(t **Token) *Node {
	var n *Node = parse_mul(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "+")) { n = bin_node(ND_ADD, n, parse_mul(t), p); }
		else if (tok_consume(t, "-")) { n = bin_node(ND_SUB, n, parse_mul(t), p); }
		else if (tok_consume(t, "|")) { n = bin_node(ND_BITOR, n, parse_mul(t), p); }
		else if (tok_consume(t, "^")) { n = bin_node(ND_BITXOR, n, parse_mul(t), p); }
		else { return n; }
	}
}

fn parse_rel(t **Token) *Node {
	var n *Node = parse_add(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "<")) { n = bin_node(ND_LT, n, parse_add(t), p); }
		else if (tok_consume(t, "<=")) { n = bin_node(ND_LE, n, parse_add(t), p); }
		else if (tok_consume(t, ">")) { n = bin_node(ND_LT, parse_add(t), n, p); }
		else if (tok_consume(t, ">=")) { n = bin_node(ND_LE, parse_add(t), n, p); }
		else { return n; }
	}
}

fn parse_eq(t **Token) *Node {
	var n *Node = parse_rel(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "==")) { n = bin_node(ND_EQ, n, parse_rel(t), p); }
		else if (tok_consume(t, "!=")) { n = bin_node(ND_NE, n, parse_rel(t), p); }
		else { return n; }
	}
}

fn parse_logand(t **Token) *Node {
	var n *Node = parse_eq(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "&&")) { n = bin_node(ND_AND, n, parse_eq(t), p); }
		else { return n; }
	}
}

fn parse_logor(t **Token) *Node {
	var n *Node = parse_logand(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "||")) { n = bin_node(ND_OR, n, parse_logand(t), p); }
		else { return n; }
	}
}

fn opassign_node(lhs *Node, rhs *Node, op int, pos i64) *Node {
	var n *Node = bin_node(ND_OPASSIGN, lhs, rhs, pos);
	n.val = op as i64;
	return n;
}

fn parse_assign(t **Token) *Node {
	parse_enter(t);
	var n *Node = parse_assign_inner(t);
	parse_leave();
	return n;
}

fn parse_assign_inner(t **Token) *Node {
	var n *Node = parse_logor(t);
	var p i64 = (*t).pos;
	if (tok_consume(t, "=")) {
		return bin_node(ND_ASSIGN, n, parse_assign(t), p);
	}
	if (tok_eq(*t, "<-")) {
		var sp i64 = (*t).pos;
		*t = (*t).next;
		var send *Node = chan_call("chan_send", n, sp);
		var v *Node = parse_assign(t);
		send.args.next = v;
		send.nargs = 2;
		return send;
	}

	if (tok_consume(t, "+=")) { return opassign_node(n, parse_assign(t), ND_ADD, p); }
	if (tok_consume(t, "-=")) { return opassign_node(n, parse_assign(t), ND_SUB, p); }
	if (tok_consume(t, "*=")) { return opassign_node(n, parse_assign(t), ND_MUL, p); }
	if (tok_consume(t, "/=")) { return opassign_node(n, parse_assign(t), ND_DIV, p); }
	if (tok_consume(t, "%=")) { return opassign_node(n, parse_assign(t), ND_MOD, p); }
	if (tok_consume(t, "&=")) { return opassign_node(n, parse_assign(t), ND_BITAND, p); }
	if (tok_consume(t, "|=")) { return opassign_node(n, parse_assign(t), ND_BITOR, p); }
	if (tok_consume(t, "^=")) { return opassign_node(n, parse_assign(t), ND_BITXOR, p); }
	if (tok_consume(t, "<<=")) { return opassign_node(n, parse_assign(t), ND_SHL, p); }
	if (tok_consume(t, ">>=")) { return opassign_node(n, parse_assign(t), ND_SHR, p); }
	return n;
}

fn parse_expr(t **Token) *Node {
	parse_enter(t);
	var n *Node = parse_expr_inner(t);
	parse_leave();
	return n;
}

fn parse_expr_inner(t **Token) *Node {
	var n *Node = parse_assign(t);
	if (tok_consume(t, ",")) { return bin_node(ND_COMMA, n, parse_expr(t), (*t).pos); }
	return n;
}

// ── statements ──

fn parse_block(t **Token) *Node {
	var n *Node = new_node(ND_BLOCK, (*t).pos);
	tok_expect(t, "{");
	enter_scope();
	var head Node;
	var tail *Node = &head;
	resolve_comptime(t);
	while (!tok_eq(*t, "}")) {
		tail.next = parse_stmt(t);
		resolve_comptime(t);
		// A `var ~n = ...` returns itself chained to a synthetic `defer`
		// via `.next`; walk to the real end so the next statement appends
		// after both instead of silently overwriting the defer.
		while (tail.next.next as i64 != 0) { tail = tail.next; }
		tail = tail.next;
	}
	leave_scope();
	tok_expect(t, "}");
	n.body = head.next;
	return n;
}

// A single-statement body slot (an unbraced if/while/for, a match arm, the
// body of `for x in coll`) holds exactly one node. `parse_decl` normally
// returns exactly one, but a `var ~n = ...` chains a synthetic `defer`
// after itself via `.next` -- safe to fold into a block right here because
// nothing else follows in a single-statement slot.
fn stmt_as_body(n *Node) *Node {
	if (n.next as i64 == 0) { return n; }
	var b *Node = new_node(ND_BLOCK, n.pos);
	b.body = n;
	return b;
}

fn parse_decl(t **Token) *Node {
	var kw str = (*t).text;
	var typed bool = str_eq(kw, "var");
	*t = (*t).next;
	// `~` marks a dynamic local: `var ~n = expr;`. Only `var` may carry it
	// -- a `let` binding never changes type or value, so "dynamic" would be
	// meaningless -- and it needs no declared type of its own; its slot
	// always holds the compiler's DynVal.
	var is_dyn bool = false;
	if (tok_eq(*t, "~")) {
		if (!typed) { error_at((*t).pos, "'let' cannot be dynamic; use 'var ~name'"); }
		is_dyn = true;
		*t = (*t).next;
		type_dynval();
		need_dyn = true;
	}
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;
	var ty *Type = 0 as *Type;
	if (is_dyn) { ty = type_dynval(); }
	else if (typed && !tok_eq(*t, "=")) { ty = parse_type(t); }
	var n *Node = new_node(ND_EXPRSTMT, p);
	var dyn_zero *Node = 0 as *Node;
	if (tok_consume(t, "=")) {
		var rhs *Node = parse_assign(t);
		var v *Var = declare_var(name, ty, p);
		if (is_dyn) {
			// A with-initializer local skips the usual "zeroed at
			// declaration" step -- the initializer overwrites the whole
			// slot anyway, normally. A dynamic local is different: the
			// assign below rewrites into a free-before-rebox
			// (type_assign_dyn) that unconditionally reads the *old*
			// `v.ptr` first, so a fresh `var ~n = expr` needs that old
			// value to be a real null, not whatever garbage this stack
			// slot last held (a prior function's frame, an entry-stub
			// scratch value -- platform- and build-dependent, so this
			// looked fine on x86 by luck of stack contents and only
			// crashed heap_free on ARM64, where the leftover bytes happen
			// to look like a wild pointer).
			dyn_zero = new_node(ND_ZERO, p);
			dyn_zero.varp = v;
		}
		if (ty as i64 == 0) {
			// An interpolation's result type is always str, known without
			// typing it: typing it now would rewrite it into calls on
			// std/fmt.qela, which is only auto-spliced in at the next
			// top-level boundary, still ahead of us here.
			if (rhs.kind == ND_INTERP) { ty = type_str(); }
			else { add_type(rhs); ty = rhs.ty; }
			v.ty = ty;
		}
		var lhs *Node = new_node(ND_VAR, p);
		lhs.varp = v;
		n.lhs = bin_node(ND_ASSIGN, lhs, rhs, p);
		// `var ~n = ...` chains a hidden `defer { heap_free(n.ptr); n.ptr =
		// 0 as *u8; }` right after itself -- built from the same node kinds
		// a hand-written defer would use, so it goes through the ordinary
		// type-check and codegen paths unchanged. This frees whatever box
		// is left in `n` when its declaring block/function exits, which
		// includes every earlier iteration's box for a redeclaration
		// re-executing in a loop (the block's defer runs at the end of
		// every pass through it, not just the last). The nulling matters:
		// without it, `type_assign_dyn`'s own free-before-rebox would read
		// the same now-freed pointer on the next iteration and free it a
		// second time -- a double free that corrupted std/heap.qela's
		// free list and hung the next heap_free in its pointer-chasing
		// search, caught by tests/dyn.qela's loop before this comment was
		// written. A single-statement body slot (if/while/for without
		// braces, a match arm) cannot hold two nodes, so callers that
		// assign into one such slot must route the result through
		// `stmt_as_body` to wrap the pair in a block.
		if (is_dyn) {
			var dv *Node = new_node(ND_VAR, p);
			dv.varp = v;
			var mem *Node = new_node(ND_MEMBER, p);
			mem.lhs = dv; mem.name = "ptr";
			var fc *Node = new_node(ND_CALL, p);
			fc.name = "heap_free"; fc.args = mem; fc.nargs = 1;
			var cstmt *Node = new_node(ND_EXPRSTMT, p);
			cstmt.lhs = fc;

			var dv2 *Node = new_node(ND_VAR, p);
			dv2.varp = v;
			var mem2 *Node = new_node(ND_MEMBER, p);
			mem2.lhs = dv2; mem2.name = "ptr";
			var nilptr *Node = new_node(ND_NUM, p);
			nilptr.val = 0;
			var nilcast *Node = new_node(ND_CAST, p);
			nilcast.lhs = nilptr; nilcast.ty = type_ptr(ty_u8);
			var clr *Node = bin_node(ND_ASSIGN, mem2, nilcast, p);
			var clrstmt *Node = new_node(ND_EXPRSTMT, p);
			clrstmt.lhs = clr;
			cstmt.next = clrstmt;

			var body *Node = new_node(ND_BLOCK, p);
			body.body = cstmt;
			var dstmt *Node = new_node(ND_DEFER, p);
			dstmt.lhs = body;
			n.next = dstmt;
		}
	} else {
		if (is_dyn) { error_at(p, "a dynamic variable needs an initializer"); }
		var z *Node = new_node(ND_ZERO, p);
		z.varp = declare_var(name, ty, p);
		n.lhs = z;
	}
	tok_expect(t, ";");
	if (dyn_zero as i64 != 0) { dyn_zero.next = n; return dyn_zero; }
	return n;
}

// A call site parses the arguments, then clones the body with every
// placeholder replaced by a fresh clone of its argument. The substitution
// is trees, not text: no parentheses, no comma problems, and the expanded
// tree gets the ordinary type check and bounds checks. The clone-per-use
// means an argument evaluates as many times as the body names it.
fn macro_call(m *Macro, t **Token, pos i64) *Node {
	tok_expect(t, "(");
	var args [6]*Node;
	var nargs int = 0;
	while (!tok_eq(*t, ")")) {
		if (nargs > 0) { tok_expect(t, ","); }
		if (nargs >= 6) { error_at((*t).pos, "too many macro arguments"); }
		args[nargs] = parse_assign(t);
		nargs = nargs + 1;
	}
	tok_expect(t, ")");
	if (nargs != m.nparams) { error_at(pos, "macro takes a different number of arguments"); }
	return macro_expand(m.body, m, &args[0], nargs, pos);
}

fn macro_expand(n *Node, m *Macro, args **Node, nargs int, pos i64) *Node {
	if (n as i64 == 0) { return 0 as *Node; }
	if (n.kind == ND_VAR) {
		var i int = 0;
		while (i < nargs) {
			if ((n.varp as i64) == (macro_param(m, i) as i64)) {
				return macro_expand(args[i], m, args, nargs, pos);
			}
			i = i + 1;
		}
	}
	var c *Node = arena_alloc(sizeof(Node), 8) as *Node;
	*c = *n;
	c.pos = pos;
	c.next = macro_expand(n.next, m, args, nargs, pos);
	c.lhs = macro_expand(n.lhs, m, args, nargs, pos);
	c.rhs = macro_expand(n.rhs, m, args, nargs, pos);
	c.cond = macro_expand(n.cond, m, args, nargs, pos);
	c.then = macro_expand(n.then, m, args, nargs, pos);
	c.els = macro_expand(n.els, m, args, nargs, pos);
	c.init = macro_expand(n.init, m, args, nargs, pos);
	c.step = macro_expand(n.step, m, args, nargs, pos);
	c.body = macro_expand(n.body, m, args, nargs, pos);
	c.args = macro_expand(n.args, m, args, nargs, pos);
	return c;
}

fn parse_stmt(t **Token) *Node {
	parse_enter(t);
	var n *Node = parse_stmt_inner(t);
	parse_leave();
	return n;
}

// Shared by `spawn f(...)` and `go f(...)`: both desugar to a call taking
// a function address plus up to five i64-cast arguments, padded to five
// with zeros -- coro_spawn's and go's signatures match exactly.
fn parse_spawn_like(t **Token, p i64, callee str, kw str) *Node {
	*t = (*t).next;
	var fname str = (*t).text;
	var fpos i64 = (*t).pos;
	*t = (*t).next;
	var call *Node = new_node(ND_CALL, p);
	call.name = callee;
	var fa *Node = new_node(ND_FUNCADDR, fpos);
	fa.name = fname;
	call.args = fa;
	var tail *Node = fa;
	var given int = 0;
	tok_expect(t, "(");
	while (!tok_eq(*t, ")")) {
		if (given > 0) { tok_expect(t, ","); }
		var a *Node = new_node(ND_CAST, (*t).pos);
		a.ty = type_lookup("i64");
		a.lhs = parse_assign(t);
		tail.next = a;
		tail = a;
		given = given + 1;
	}
	tok_expect(t, ")");
	if (given > 5) {
		if (str_eq(kw, "go")) { error_at(p, "go takes at most 5 arguments"); }
		error_at(p, "spawn takes at most 5 arguments");
	}
	while (given < 5) {
		tail.next = num_node(0, p);
		tail = tail.next;
		given = given + 1;
	}
	call.nargs = 6;
	var st *Node = new_node(ND_EXPRSTMT, p);
	st.lhs = call;
	tok_expect(t, ";");
	return st;
}

fn parse_stmt_inner(t **Token) *Node {
	var p i64 = (*t).pos;

	if (cur_func as i64 != 0 && cur_func.naked) {
		if (tok_eq(*t, "let") || tok_eq(*t, "var")) {
			error_at(p, "naked functions cannot have locals");
		}
		if (tok_eq(*t, "return")) { error_at(p, "naked functions cannot return a value"); }
		if (tok_eq(*t, "defer")) { error_at(p, "naked functions cannot defer"); }
	}

	if (tok_eq(*t, "{")) { return parse_block(t); }

	if (tok_eq(*t, "spawn") && (*t).next.kind == TK_IDENT) {
		return parse_spawn_like(t, p, "coro_spawn", "spawn");
	}

	if (tok_eq(*t, "go") && (*t).next.kind == TK_IDENT) {
		return parse_spawn_like(t, p, "go", "go");
	}

	if (tok_consume(t, "return")) {
		if (in_defer_body) { error_at(p, "cannot return from inside a defer body"); }
		var n *Node = new_node(ND_RET, p);
		if (!tok_eq(*t, ";")) { n.lhs = parse_expr(t); }
		tok_expect(t, ";");
		return n;
	}

	// `super v;` is the value of the nearest enclosing typed block -- it is
	// `return` inside that block's hidden function, spelled differently so
	// it reads as "the block's value" rather than "exit the function".
	if (tok_consume(t, "super")) {
		if (!capturing) { error_at(p, "'super' is only valid inside a typed block"); }
		if (in_defer_body) { error_at(p, "cannot return from inside a defer body"); }
		var n *Node = new_node(ND_RET, p);
		if (!tok_eq(*t, ";")) { n.lhs = parse_expr(t); }
		tok_expect(t, ";");
		return n;
	}

	if (tok_consume(t, "if")) {
		tok_expect(t, "(");
		var n *Node = new_node(ND_IF, p);
		n.cond = parse_expr(t);
		tok_expect(t, ")");
		n.then = stmt_as_body(parse_stmt(t));
		if (tok_consume(t, "else")) { n.els = stmt_as_body(parse_stmt(t)); }
		return n;
	}

	if (tok_consume(t, "while")) {
		tok_expect(t, "(");
		var n *Node = new_node(ND_FOR, p);
		n.cond = parse_expr(t);
		tok_expect(t, ")");
		n.body = stmt_as_body(parse_stmt(t));
		return n;
	}

	if (tok_consume(t, "break")) {
		if (in_defer_body) { error_at(p, "cannot break from inside a defer body"); }
		tok_expect(t, ";");
		return new_node(ND_BREAK, p);
	}
	if (tok_consume(t, "continue")) {
		if (in_defer_body) { error_at(p, "cannot continue from inside a defer body"); }
		tok_expect(t, ";");
		return new_node(ND_CONT, p);
	}

	if (tok_consume(t, "for")) {
		var n *Node = new_node(ND_FOR, p);
		enter_scope();
		// for i in lo..hi / for x in collection
		if ((*t).kind == TK_IDENT && tok_eq((*t).next, "in")) {
			var name str = (*t).text;
			var np i64 = (*t).pos;
			*t = (*t).next.next;
			var lo *Node = parse_assign(t);
			if (!tok_consume(t, "..")) {
				// for x in a: iterate by value over an array, a slice or a
				// string. The index is a hidden local; a collection that is
				// not a plain variable is evaluated once into a hidden
				// variable, because the node would otherwise be typed and
				// emitted twice. The body is `var x = coll[i]` prepended,
				// which is exactly the shape the bounds elision knows.
				var coll *Node = lo;
				var coll_init *Node = 0 as *Node;
				if (coll.kind != ND_VAR) {
					var cv *Var = declare_var("_$c", 0 as *Type, np);
					add_type(coll);
					cv.ty = coll.ty;
					var clhs *Node = new_node(ND_VAR, np);
					clhs.varp = cv;
					coll_init = new_node(ND_EXPRSTMT, np);
					coll_init.lhs = bin_node(ND_ASSIGN, clhs, coll, np);
					var cr *Node = new_node(ND_VAR, np);
					cr.varp = cv;
					coll = cr;
				}
				var v *Var = declare_var(name, 0 as *Type, np);
				var hv *Var = declare_var("_$i", type_lookup("int"), np);
				var iv *Node = new_node(ND_VAR, np);
				iv.varp = hv;
				var init *Node = new_node(ND_EXPRSTMT, np);
				init.lhs = bin_node(ND_ASSIGN, iv, num_node(0, np), np);
				if (coll_init as i64 != 0) { coll_init.next = init; n.init = coll_init; }
				else { n.init = init; }
				var iv2 *Node = new_node(ND_VAR, np);
				iv2.varp = hv;
				var ml *Node = new_node(ND_MEMBER, np);
				ml.lhs = coll;
				ml.name = "len";
				n.cond = bin_node(ND_LT, iv2, ml, np);
				var iv3 *Node = new_node(ND_VAR, np);
				iv3.varp = hv;
				var step *Node = bin_node(ND_OPASSIGN, iv3, num_node(1, np), np);
				step.val = ND_ADD;
				n.step = step;
				var iv4 *Node = new_node(ND_VAR, np);
				iv4.varp = hv;
				var rhs *Node = bin_node(ND_INDEX, coll, iv4, np);
				add_type(rhs);
				v.ty = rhs.ty;
				var d *Node = new_node(ND_EXPRSTMT, np);
				var lv *Node = new_node(ND_VAR, np);
				lv.varp = v;
				d.lhs = bin_node(ND_ASSIGN, lv, rhs, np);
				var blk *Node = new_node(ND_BLOCK, np);
				blk.body = d;
				d.next = stmt_as_body(parse_stmt(t));
				n.body = blk;
				leave_scope();
				return n;
			}
			var hi *Node = parse_assign(t);
			var v *Var = declare_var(name, type_lookup("int"), np);
			var iv *Node = new_node(ND_VAR, np);
			iv.varp = v;
			var init *Node = new_node(ND_EXPRSTMT, np);
			init.lhs = bin_node(ND_ASSIGN, iv, lo, np);
			n.init = init;
			var iv2 *Node = new_node(ND_VAR, np);
			iv2.varp = v;
			n.cond = bin_node(ND_LT, iv2, hi, np);
			var iv3 *Node = new_node(ND_VAR, np);
			iv3.varp = v;
			var step *Node = bin_node(ND_OPASSIGN, iv3, num_node(1, np), np);
			step.val = ND_ADD;
			n.step = step;
		} else {
			tok_expect(t, "(");
			if (!tok_eq(*t, ";")) {
				if (tok_eq(*t, "let") || tok_eq(*t, "var")) { n.init = parse_decl(t); }
				else {
					var e *Node = new_node(ND_EXPRSTMT, (*t).pos);
					e.lhs = parse_expr(t);
					n.init = e;
					tok_expect(t, ";");
				}
			} else { *t = (*t).next; }
			if (!tok_eq(*t, ";")) { n.cond = parse_expr(t); }
			tok_expect(t, ";");
			if (!tok_eq(*t, ")")) { n.step = parse_expr(t); }
			tok_expect(t, ")");
		}
		n.body = stmt_as_body(parse_stmt(t));
		leave_scope();
		return n;
	}

	if (tok_consume(t, "defer")) {
		var n *Node = new_node(ND_DEFER, p);
		in_defer_body = true;
		n.lhs = stmt_as_body(parse_stmt(t));
		in_defer_body = false;
		return n;
	}

	if (tok_consume(t, "match")) {
		tok_expect(t, "(");
		var n *Node = new_node(ND_MATCH, p);
		n.cond = parse_expr(t);
		tok_expect(t, ")");
		tok_expect(t, "{");
		var head Node;
		var tail *Node = &head;
		while (!tok_eq(*t, "}")) {
			var arm *Node = new_node(ND_ARM, (*t).pos);
			if (tok_consume(t, "_")) { arm.name.len = 0; }
			else {
				arm.name = (*t).text;
				*t = (*t).next;
			}
			enter_scope();
			if (tok_consume(t, "(")) {
				var bh Node;
				var bt *Node = &bh;
				while (!tok_eq(*t, ")")) {
					if (bt != &bh) { tok_expect(t, ","); }
					var b *Node = new_node(ND_VAR, (*t).pos);
					b.varp = declare_var((*t).text, 0 as *Type, (*t).pos);
					*t = (*t).next;
					bt.next = b;
					bt = b;
				}
				tok_expect(t, ")");
				arm.args = bh.next;
			}
			tok_expect(t, "=>");
			arm.body = stmt_as_body(parse_stmt(t));
			leave_scope();
			tail.next = arm;
			tail = arm;
		}
		tok_expect(t, "}");
		n.body = head.next;
		return n;
	}

	if (tok_eq(*t, "let") || tok_eq(*t, "var")) { return parse_decl(t); }

	var n *Node = new_node(ND_EXPRSTMT, p);
	n.lhs = parse_expr(t);
	tok_expect(t, ";");
	return n;
}

// ── top-level ──

// Walks a not-yet-typed default-value expression looking for a reference
// to a parameter that itself carries a default. Only the parameters of
// the function currently being declared can appear here (an identifier
// resolves through the live scope chain, and a defaulted Var is only ever
// a parameter of the function whose declaration is still open), so a hit
// means exactly that: no dependency chain between two defaults.
fn expr_refs_default_param(n *Node) bool {
	if (n as i64 == 0) { return false; }
	if (n.kind == ND_VAR && n.varp as i64 != 0 && n.varp.default as i64 != 0) { return true; }
	if (expr_refs_default_param(n.next)) { return true; }
	if (expr_refs_default_param(n.lhs)) { return true; }
	if (expr_refs_default_param(n.rhs)) { return true; }
	if (expr_refs_default_param(n.cond)) { return true; }
	if (expr_refs_default_param(n.then)) { return true; }
	if (expr_refs_default_param(n.els)) { return true; }
	if (expr_refs_default_param(n.init)) { return true; }
	if (expr_refs_default_param(n.step)) { return true; }
	if (expr_refs_default_param(n.body)) { return true; }
	if (expr_refs_default_param(n.args)) { return true; }
	return false;
}

// Clones a parameter's default expression, substituting any reference to
// one of f's own parameters with the value the caller actually gave for
// it. A default may only name a required (non-defaulted) parameter, so
// `provided` is always filled by the time substitution reaches it -- the
// same clone-per-reference shape as `macro_expand`, keyed by Func params
// instead of Macro params.
fn default_expand(n *Node, f *Func, provided **Node) *Node {
	if (n as i64 == 0) { return 0 as *Node; }
	if (n.kind == ND_VAR) {
		var i int = 0;
		while (i < f.nparams) {
			if ((n.varp as i64) == (func_param(f, i) as i64)) {
				return default_expand(provided[i], f, provided);
			}
			i = i + 1;
		}
	}
	var c *Node = arena_alloc(sizeof(Node), 8) as *Node;
	*c = *n;
	c.next = default_expand(n.next, f, provided);
	c.lhs = default_expand(n.lhs, f, provided);
	c.rhs = default_expand(n.rhs, f, provided);
	c.cond = default_expand(n.cond, f, provided);
	c.then = default_expand(n.then, f, provided);
	c.els = default_expand(n.els, f, provided);
	c.init = default_expand(n.init, f, provided);
	c.step = default_expand(n.step, f, provided);
	c.body = default_expand(n.body, f, provided);
	c.args = default_expand(n.args, f, provided);
	return c;
}

// A named/default call: `sum(a=1, c=3)`. The shape of the first argument
// -- `ident '=' expr` where ident names a real parameter of f -- decides
// the whole call; once decided every further argument must match it.
// Missing parameters fall back to their declared default. `f` is only
// ever non-null here for an already-resolved, non-generic function (one
// declared earlier in the source, or in an already-parsed import), so a
// forward reference to a function declared later in the file cannot use
// named/default arguments -- it falls back to a plain positional call,
// same as if this function had never been consulted.
fn call_args_named(t **Token, n *Node, f *Func) *Node {
	tok_expect(t, "(");
	var provided [14]*Node;
	var have [14]bool;
	var i int = 0;
	while (i < 14) { have[i] = false; i = i + 1; }
	var named_mode bool = false;
	var nseen int = 0;
	while (!tok_eq(*t, ")")) {
		if (nseen > 0) { tok_expect(t, ","); }
		var looks_named bool = (*t).kind == TK_IDENT && tok_eq((*t).next, "=");
		var is_named bool = false;
		var pidx int = -1;
		var ppos i64 = (*t).pos;
		if (nseen == 0) {
			if (looks_named) {
				pidx = func_param_index(f, (*t).text);
				if (pidx >= 0) { named_mode = true; is_named = true; }
			}
		} else if (named_mode) {
			if (!looks_named) { error_at(ppos, "expected a named argument here (this call started with one)"); }
			pidx = func_param_index(f, (*t).text);
			if (pidx < 0) {
				var mb Buf;
				fmt_str(&mb, "'");
				fmt_str(&mb, f.name);
				fmt_str(&mb, "' has no parameter named '");
				fmt_str(&mb, (*t).text);
				fmt_str(&mb, "'");
				error_at(ppos, buf_str(&mb));
			}
			is_named = true;
		} else if (looks_named && func_param_index(f, (*t).text) >= 0) {
			// This call committed to positional mode on its first argument,
			// but a later one looks like a named argument that would match
			// a real parameter -- almost certainly a mixed call, which the
			// design forbids outright rather than guessing the intent.
			error_at(ppos, "cannot mix positional and named arguments in one call");
			is_named = true;
		}
		if (is_named) {
			*t = (*t).next;
			*t = (*t).next;
			var e *Node = parse_assign(t);
			if (have[pidx]) { error_at(ppos, "duplicate named argument"); }
			provided[pidx] = e;
			have[pidx] = true;
		} else {
			var e *Node = parse_assign(t);
			var tail **Node = &n.args;
			while (*tail as i64 != 0) { tail = &(*tail).next; }
			*tail = e;
		}
		nseen = nseen + 1;
	}
	tok_expect(t, ")");
	// An empty call `f()` to a function with parameters has no first
	// argument to read the mode from -- treat it as "everything
	// defaulted" and let the fill loop below either supply every
	// default or fail with "missing required argument".
	if (!named_mode && nseen > 0) {
		n.nargs = nseen;
		return n;
	}
	i = 0;
	while (i < f.nparams) {
		if (!have[i]) {
			var pv *Var = func_param(f, i);
			if (pv.default as i64 == 0) {
				var mb Buf;
				fmt_str(&mb, "missing required argument '");
				fmt_str(&mb, pv.name);
				fmt_str(&mb, "'");
				error_at((*t).pos, buf_str(&mb));
			}
			provided[i] = default_expand(pv.default, f, &provided[0]);
			have[i] = true;
		}
		i = i + 1;
	}
	var head Node;
	var tail *Node = &head;
	i = 0;
	while (i < f.nparams) {
		tail.next = provided[i];
		tail = tail.next;
		i = i + 1;
	}
	tail.next = 0 as *Node;
	n.args = head.next;
	n.nargs = f.nparams;
	return n;
}

fn func_param_index(f *Func, name str) int {
	var i int = 0;
	while (i < f.nparams) {
		if (str_eq(func_param(f, i).name, name)) { return i; }
		i = i + 1;
	}
	return -1;
}

// ── interpreted/dynamic signature classes ──
//
// A function crosses the runtime ABI in one of two shapes. The scalar
// shape (every parameter and the return is a one-word, non-float value:
// integers, bool, pointers, void) packs arguments into an i64 array and
// returns a plain i64. Everything else -- str, floats, structs, arrays,
// payloadless enums -- is the marshalled shape: the trampoline serializes
// each value type-directed into a byte payload, and the return value comes
// back as marshalled bytes (or, under the jit, through a hidden
// out-parameter in a rewritten signature).
//
// A scalar crossing the wire is always 8 bytes; a str is u64 length plus
// the bytes; a POD struct/array (every field a scalar, float or array of
// those) is its raw size-byte image; any other struct is its fields in
// member order (scalars as 8-byte slots, strs as length-prefixed, nested
// structs recursively). Both sides generate from the same parsed types,
// so the conventions can never drift.

fn interp_pod_ok(ty *Type) bool {
	if (ty.kind == TY_ARRAY) { return interp_pod_ok(ty.base); }
	if (ty.kind == TY_ENUM) {
		var v *Variant = ty.variants;
		while (v as i64 != 0) {
			if (v.fields as i64 != 0) { return false; }
			v = v.next;
		}
		return true;
	}
	return is_float(ty) || is_integer(ty);
}

fn interp_struct_pod(ty *Type) bool {
	var m *Member = ty.members;
	while (m as i64 != 0) {
		if (!interp_pod_ok(m.ty)) { return false; }
		m = m.next;
	}
	return true;
}

fn interp_struct_ok(ty *Type) bool {
	var m *Member = ty.members;
	while (m as i64 != 0) {
		var mt *Type = m.ty;
		if (interp_pod_ok(mt)) { m = m.next; continue; }
		if (mt.kind == TY_SLICE && mt.base as i64 == ty_u8 as i64) { m = m.next; continue; }
		if (mt.kind == TY_STRUCT && interp_struct_ok(mt)) { m = m.next; continue; }
		return false;
	}
	return true;
}

fn interp_marshal_ok(ty *Type) bool {
	if (ty.kind == TY_SLICE) { return ty.base as i64 == ty_u8 as i64; }
	if (ty.kind == TY_STRUCT) { return interp_struct_ok(ty); }
	return interp_pod_ok(ty);
}

fn interp_scalar_ok(ty *Type) bool {
	if (is_float(ty)) { return false; }
	if (ty.kind == TY_PTR) { return true; }
	return is_integer(ty);
}

// The marshalled class: at least one parameter or the return is not a
// one-word scalar. Void counts as scalar (there is no value to carry).
fn interp_marshalled(f *Func) bool {
	if (f.ret.kind != TY_VOID && !interp_scalar_ok(f.ret)) { return true; }
	var i int = 0;
	while (i < f.nparams) {
		if (!interp_scalar_ok(func_param(f, i).ty)) { return true; }
		i = i + 1;
	}
	return false;
}

fn interp_sig_reject(ty *Type, pos i64, what str) {
	if (ty.kind == TY_VOID) { return; }
	if (interp_scalar_ok(ty) || interp_marshal_ok(ty)) { return; }
	var b Buf;
	fmt_str(&b, "a '");
	fmt_str(&b, type_name(ty));
	fmt_str(&b, "' ");
	fmt_str(&b, what);
	fmt_str(&b, " cannot cross the interpreted/dynamic ABI: only scalars, str, floats and structs of those are supported (see docs/INTERPRETED.md)");
	error_at(pos, buf_str(&b));
}

// The eval fn/eval var ABI is still scalar-only (phase 2 of the
// marshalling work); kept as the classic aggregate/float rejection.
fn interp_check_scalar(ty *Type, pos i64, what str) {
	if (is_aggregate(ty) || is_float(ty)) {
		var b Buf;
		fmt_str(&b, "an 'eval fn'/'eval var' ");
		fmt_str(&b, what);
		fmt_str(&b, " must be a scalar integer type for now (see docs/INTERPRETED.md)");
		error_at(pos, buf_str(&b));
	}
}

// How many argument registers a value occupies under the compiled ABI: an
// aggregate up to 16 bytes rides raw in words, a bigger one passes by
// pointer in one word. The jit path packs this many slots per parameter.
fn interp_jit_words(ty *Type) int {
	if (is_aggregate(ty) && !abi_by_ref(ty.size)) { return ((ty.size + 7) / 8) as int; }
	return 1;
}

// The rewritten jit signature appends a hidden out-pointer parameter, so
// the total register budget is six words including it.
fn interp_jit_budget(f *Func) bool {
	var w int = 0;
	var i int = 0;
	while (i < f.nparams) {
		w = w + interp_jit_words(func_param(f, i).ty);
		i = i + 1;
	}
	if (f.ret.kind != TY_VOID) { w = w + 1; }
	return w <= 6;
}

// Appends the payload-build code for one parameter value. `expr` is the
// source expression naming the value (a parameter name or dotted path).
fn interp_gen_marshal(b *Buf, expr str, ty *Type) {
	if (ty.kind == TY_SLICE) {
		fmt_str(b, " buf_u64(&__b, ");
		fmt_str(b, expr);
		fmt_str(b, ".len); buf_bytes(&__b, ");
		fmt_str(b, expr);
		fmt_str(b, ".ptr, ");
		fmt_str(b, expr);
		fmt_str(b, ".len);");
		return;
	}
	if (ty.kind == TY_STRUCT && !interp_struct_pod(ty)) {
		interp_gen_marshal_fields(b, expr, ty);
		return;
	}
	if (ty.kind == TY_STRUCT || ty.kind == TY_ARRAY || ty.kind == TY_ENUM) {
		// A POD struct, array or enum is its raw image; `&f` of an
		// aggregate is its memory (never a promoted register), and for a
		// by-ref value `&f` already is the data pointer. An enum is an
		// aggregate here, so `f as i64` would hand over its address.
		fmt_str(b, " buf_bytes(&__b, &");
		fmt_str(b, expr);
		fmt_str(b, " as *u8, ");
		fmt_i64(b, ty.size as i64);
		fmt_str(b, ");");
		return;
	}
	if (is_float(ty)) {
		if (ty.size == 4) {
			fmt_str(b, " { var __st [4]u8; *(&__st[0] as *f32) = ");
			fmt_str(b, expr);
			fmt_str(b, "; buf_u64(&__b, *(&__st[0] as *u32) as i64); }");
		} else {
			fmt_str(b, " { var __st [8]u8; *(&__st[0] as *f64) = ");
			fmt_str(b, expr);
			fmt_str(b, "; buf_u64(&__b, *(&__st[0] as *u64) as i64); }");
		}
		return;
	}
	fmt_str(b, " buf_u64(&__b, ");
	fmt_str(b, expr);
	fmt_str(b, " as i64);");
}

fn interp_gen_pname(b *Buf, idx int) {
	fmt_str(b, "__p");
	fmt_i64(b, idx as i64);
}

// Decodes one marshalled argument into a `__p<i>` local of the generated
// eval dispatcher, advancing the `__cur` cursor. Mirrors the child side's
// abi_unmarshal_value: scalars as 8-byte slots, strs length-prefixed,
// POD aggregates as raw images, everything else field by field.
fn interp_gen_eval_decode(b *Buf, idx int, ty *Type) {
	fmt_str(b, " var ");
	interp_gen_pname(b, idx);
	if (ty.kind == TY_SLICE) {
		fmt_str(b, " str; ");
		interp_gen_pname(b, idx);
		fmt_str(b, ".len = *(__cur as *i64); ");
		interp_gen_pname(b, idx);
		fmt_str(b, ".ptr = __cur + 8; __cur = __cur + 8 + ");
		interp_gen_pname(b, idx);
		fmt_str(b, ".len;");
		return;
	}
	if (ty.kind == TY_STRUCT && !interp_struct_pod(ty)) {
		fmt_str(b, " ");
		fmt_str(b, type_name(ty));
		fmt_str(b, ";");
		var pb Buf;
		interp_gen_pname(&pb, idx);
		interp_gen_wire_fields(b, buf_str(&pb), ty);
		return;
	}
	fmt_str(b, " ");
	fmt_str(b, type_name(ty));
	fmt_str(b, " = *(__cur as *");
	fmt_str(b, type_name(ty));
	fmt_str(b, "); __cur = __cur + ");
	// An enum is an aggregate like a struct: the wire carries its whole
	// raw image, so the cursor advances by its size, not one word.
	if (ty.kind == TY_STRUCT || ty.kind == TY_ARRAY || ty.kind == TY_ENUM) {
		fmt_i64(b, ty.size as i64);
	} else { fmt_str(b, "8"); }
	fmt_str(b, ";");
}

// The body of one eval-fn branch in the generated dispatcher: decode the
// arguments, call the function, marshal the return value into the
// caller-provided Buf (`__b`), which the host side then sends back.
fn interp_gen_eval_body(b *Buf, ef *Func) {
	fmt_str(b, " var __cur *u8 = args;");
	var ei int = 0;
	while (ei < ef.nparams) {
		interp_gen_eval_decode(b, ei, func_param(ef, ei).ty);
		ei = ei + 1;
	}
	fmt_str(b, " ");
	var callb Buf;
	fmt_str(&callb, ef.name);
	fmt_str(&callb, "(");
	ei = 0;
	while (ei < ef.nparams) {
		if (ei > 0) { fmt_str(&callb, ", "); }
		interp_gen_pname(&callb, ei);
		ei = ei + 1;
	}
	fmt_str(&callb, ")");
	var call str = buf_str(&callb);
	if (ef.ret.kind == TY_VOID) {
		fmt_str(b, call);
		fmt_str(b, ";");
		return;
	}
	if (ef.ret.kind == TY_SLICE) {
		fmt_str(b, "var __r0 str = ");
		fmt_str(b, call);
		fmt_str(b, "; buf_u64(__b, __r0.len); buf_bytes(__b, __r0.ptr, __r0.len);");
		return;
	}
	if (is_float(ef.ret)) {
		if (ef.ret.size == 4) {
			fmt_str(b, "{ var __st [4]u8; *(&__st[0] as *f32) = ");
			fmt_str(b, call);
			fmt_str(b, "; buf_u64(__b, *(&__st[0] as *u32) as i64); }");
		} else {
			fmt_str(b, "{ var __st [8]u8; *(&__st[0] as *f64) = ");
			fmt_str(b, call);
			fmt_str(b, "; buf_u64(__b, *(&__st[0] as *u64) as i64); }");
		}
		return;
	}
	if (ef.ret.kind == TY_STRUCT && !interp_struct_pod(ef.ret)) {
		fmt_str(b, "var __r0 ");
		fmt_str(b, type_name(ef.ret));
		fmt_str(b, " = ");
		fmt_str(b, call);
		fmt_str(b, ";");
		interp_gen_marshal_fields(b, "__r0", ef.ret);
		return;
	}
	if (ef.ret.kind == TY_STRUCT || ef.ret.kind == TY_ARRAY || ef.ret.kind == TY_ENUM) {
		fmt_str(b, "var __r0 ");
		fmt_str(b, type_name(ef.ret));
		fmt_str(b, " = ");
		fmt_str(b, call);
		fmt_str(b, "; buf_bytes(__b, &__r0 as *u8, ");
		fmt_i64(b, ef.ret.size as i64);
		fmt_str(b, ");");
		return;
	}
	fmt_str(b, "buf_u64(__b, ");
	fmt_str(b, call);
	fmt_str(b, " as i64);");
}

// Decodes one marshalled value into the named global of the generated set
// dispatcher, advancing the `__cur` cursor. The mirror of
// interp_gen_marshal: scalars as 8-byte slots, strs length-prefixed and
// duplicated (the payload lives in the host's receive buffer, which is
// reused), POD aggregates as raw images, everything else field by field.
fn interp_gen_global_decode(b *Buf, name str, ty *Type) {
	if (ty.kind == TY_SLICE) {
		fmt_str(b, " { var __t str; __t.len = *(__cur as *i64); __t.ptr = __cur + 8; ");
		fmt_str(b, name);
		fmt_str(b, " = str_dup(__t); __cur = __cur + 8 + __t.len; }");
		return;
	}
	if (ty.kind == TY_STRUCT && !interp_struct_pod(ty)) {
		var m *Member = ty.members;
		while (m as i64 != 0) {
			var mb Buf;
			fmt_str(&mb, name);
			fmt_str(&mb, ".");
			fmt_str(&mb, m.name);
			interp_gen_global_decode(b, buf_str(&mb), m.ty);
			m = m.next;
		}
		return;
	}
	if (is_float(ty)) {
		fmt_str(b, " { var __st [8]u8; *(&__st[0] as *i64) = *(__cur as *i64); ");
		fmt_str(b, name);
		fmt_str(b, " = *(&__st[0] as *");
		fmt_str(b, type_name(ty));
		fmt_str(b, "); __cur = __cur + 8; }");
		return;
	}
	if (ty.kind == TY_STRUCT || ty.kind == TY_ARRAY || ty.kind == TY_ENUM) {
		fmt_str(b, " { var __t ");
		fmt_str(b, type_name(ty));
		fmt_str(b, " = *(__cur as *");
		fmt_str(b, type_name(ty));
		fmt_str(b, "); ");
		fmt_str(b, name);
		fmt_str(b, " = __t; __cur = __cur + ");
		fmt_i64(b, ty.size as i64);
		fmt_str(b, "; }");
		return;
	}
	fmt_str(b, " ");
	fmt_str(b, name);
	fmt_str(b, " = *(__cur as *");
	fmt_str(b, type_name(ty));
	fmt_str(b, "); __cur = __cur + 8;");
}

fn interp_gen_marshal_fields(b *Buf, expr str, ty *Type) {
	var m *Member = ty.members;
	while (m as i64 != 0) {
		var pb Buf;
		fmt_str(&pb, expr);
		fmt_str(&pb, ".");
		fmt_str(&pb, m.name);
		var path str = buf_str(&pb);
		var mt *Type = m.ty;
		if (mt.kind == TY_STRUCT && !interp_struct_pod(mt)) {
			interp_gen_marshal_fields(b, path, mt);
		} else if (mt.kind == TY_STRUCT || mt.kind == TY_ARRAY) {
			// A POD struct or array is its raw image; `&f` of an aggregate
			// is its memory (never a promoted register), and for a by-ref
			// value `&f` already is the data pointer.
			fmt_str(b, " buf_bytes(&__b, &");
			fmt_str(b, path);
			fmt_str(b, " as *u8, ");
			fmt_i64(b, mt.size as i64);
			fmt_str(b, ");");
		} else {
			interp_gen_marshal(b, path, mt);
		}
		m = m.next;
	}
}

// Appends the register-word packing for one parameter; returns the next
// free slot index. The staging arrays keep floats out of gen_addr's
// promoted-local trap (a float local can live in a register).
fn interp_gen_slot(b *Buf, expr str, ty *Type, idx int) int {
	if (ty.kind == TY_SLICE) {
		fmt_str(b, " __ia[");
		fmt_i64(b, idx as i64);
		fmt_str(b, "] = ");
		fmt_str(b, expr);
		fmt_str(b, ".ptr as i64; __ia[");
		fmt_i64(b, (idx + 1) as i64);
		fmt_str(b, "] = ");
		fmt_str(b, expr);
		fmt_str(b, ".len;");
		return idx + 2;
	}
	if (is_float(ty)) {
		var st i64 = 4;
		var rt str = "f32";
		var ut str = "*u32";
		if (ty.size == 8) { st = 8; rt = "f64"; ut = "*u64"; }
		fmt_str(b, " { var __st [");
		fmt_i64(b, st);
		fmt_str(b, "]u8; *(&__st[0] as *");
		fmt_str(b, rt);
		fmt_str(b, ") = ");
		fmt_str(b, expr);
		fmt_str(b, "; __ia[");
		fmt_i64(b, idx as i64);
		fmt_str(b, "] = *(&__st[0] as ");
		fmt_str(b, ut);
		fmt_str(b, ") as i64; }");
		return idx + 1;
	}
	if (is_aggregate(ty)) {
		if (abi_by_ref(ty.size)) {
			fmt_str(b, " __ia[");
			fmt_i64(b, idx as i64);
			fmt_str(b, "] = &");
			fmt_str(b, expr);
			fmt_str(b, " as i64;");
			return idx + 1;
		}
		var nw int = ((ty.size + 7) / 8) as int;
		var j int = 0;
		while (j < nw) {
			fmt_str(b, " __ia[");
			fmt_i64(b, (idx + j) as i64);
			fmt_str(b, "] = *((&");
			fmt_str(b, expr);
			fmt_str(b, " as *i64) + ");
			fmt_i64(b, j as i64);
			fmt_str(b, ");");
			j = j + 1;
		}
		return idx + nw;
	}
	fmt_str(b, " __ia[");
	fmt_i64(b, idx as i64);
	fmt_str(b, "] = ");
	fmt_str(b, expr);
	fmt_str(b, " as i64;");
	return idx + 1;
}

// `return *(BASE as *T);` -- the value sits in memory in its real image.
// Covers scalars (the wire carries a full 8-byte slot, the read takes the
// value's own width), floats, and every aggregate including str.
fn interp_gen_mem_ret(b *Buf, base str, ty *Type) {
	fmt_str(b, " return *(");
	fmt_str(b, base);
	fmt_str(b, " as *");
	fmt_str(b, type_name(ty));
	fmt_str(b, ");");
}

// The wire-shaped return decode: str arrives length-prefixed, a non-POD
// struct field by field, everything else as its own-type read.
fn interp_gen_wire_ret(b *Buf, base str, ty *Type) {
	if (ty.kind == TY_SLICE) {
		fmt_str(b, " var __rs str; __rs.len = *(");
		fmt_str(b, base);
		fmt_str(b, " as *i64); __rs.ptr = ");
		fmt_str(b, base);
		fmt_str(b, " + 8; return __rs;");
		return;
	}
	if (ty.kind == TY_STRUCT && !interp_struct_pod(ty)) {
		fmt_str(b, " var __rs ");
		fmt_str(b, type_name(ty));
		fmt_str(b, "; var __cur *u8 = ");
		fmt_str(b, base);
		fmt_str(b, ";");
		interp_gen_wire_fields(b, "__rs", ty);
		fmt_str(b, " return __rs;");
		return;
	}
	interp_gen_mem_ret(b, base, ty);
}

fn interp_gen_wire_fields(b *Buf, path str, ty *Type) {
	var m *Member = ty.members;
	while (m as i64 != 0) {
		var mt *Type = m.ty;
		var pb Buf;
		fmt_str(&pb, path);
		fmt_str(&pb, ".");
		fmt_str(&pb, m.name);
		var fpath str = buf_str(&pb);
		if (mt.kind == TY_SLICE) {
			fmt_str(b, " ");
			fmt_str(b, fpath);
			fmt_str(b, ".len = *(__cur as *i64); ");
			fmt_str(b, fpath);
			fmt_str(b, ".ptr = __cur + 8; __cur = __cur + 8 + ");
			fmt_str(b, fpath);
			fmt_str(b, ".len;");
		} else if (mt.kind == TY_STRUCT && !interp_struct_pod(mt)) {
			interp_gen_wire_fields(b, fpath, mt);
		} else if (mt.kind == TY_STRUCT || mt.kind == TY_ARRAY) {
			fmt_str(b, " ");
			fmt_str(b, fpath);
			fmt_str(b, " = *(__cur as *");
			fmt_str(b, type_name(mt));
			fmt_str(b, "); __cur = __cur + ");
			fmt_i64(b, mt.size as i64);
			fmt_str(b, ";");
		} else {
			fmt_str(b, " ");
			fmt_str(b, fpath);
			fmt_str(b, " = *(__cur as *");
			fmt_str(b, type_name(mt));
			fmt_str(b, "); __cur = __cur + 8;");
		}
		m = m.next;
	}
}

// The child re-parses the bundle from scratch, so every type an
// interpreted/dynamic function can mention has to come along: user structs
// and enums, and the templates the child instantiates on use. Generic
// instances are skipped -- their "Name(Args)" names are not source text.
fn interp_emit_struct_body(b *Buf, ty *Type) {
	fmt_str(b, "{ ");
	var m *Member = ty.members;
	while (m as i64 != 0) {
		fmt_str(b, m.name);
		fmt_str(b, " ");
		fmt_str(b, type_name(m.ty));
		fmt_str(b, ", ");
		m = m.next;
	}
	fmt_str(b, "}\n");
}

fn interp_emit_struct(b *Buf, ty *Type) {
	fmt_str(b, "struct ");
	fmt_str(b, ty.name);
	fmt_str(b, " ");
	interp_emit_struct_body(b, ty);
}

fn interp_emit_enum_body(b *Buf, ty *Type) {
	fmt_str(b, "{ ");
	var v *Variant = ty.variants;
	while (v as i64 != 0) {
		fmt_str(b, v.name);
		if (v.fields as i64 != 0) {
			fmt_str(b, "(");
			var m *Member = v.fields;
			while (m as i64 != 0) {
				fmt_str(b, type_name(m.ty));
				if (m.next as i64 != 0) { fmt_str(b, ", "); }
				m = m.next;
			}
			fmt_str(b, ")");
		}
		fmt_str(b, ", ");
		v = v.next;
	}
	fmt_str(b, "}\n");
}

fn interp_emit_enum(b *Buf, ty *Type) {
	fmt_str(b, "enum ");
	fmt_str(b, ty.name);
	fmt_str(b, " ");
	interp_emit_enum_body(b, ty);
}

fn interp_emit_tmpl(b *Buf, tm *Tmpl) {
	if (tm.proto.kind == TY_STRUCT) { fmt_str(b, "struct "); }
	else { fmt_str(b, "enum "); }
	fmt_str(b, tm.name);
	fmt_str(b, "(");
	fmt_str(b, tm.tv0.name);
	if (tm.nparams == 2) {
		fmt_str(b, ", ");
		fmt_str(b, tm.tv1.name);
	}
	fmt_str(b, ") ");
	if (tm.proto.kind == TY_STRUCT) { interp_emit_struct_body(b, tm.proto); }
	else { interp_emit_enum_body(b, tm.proto); }
}

fn interp_emit_types(b *Buf) {
	var nt *Named = named_types;
	while (nt as i64 != 0) {
		var nty *Type = nt.ty;
		if (str_find(nt.name, '(' as u8) < 0) {
			if (nty.kind == TY_STRUCT && nty.members as i64 != 0) {
				interp_emit_struct(b, nty);
			} else if (nty.kind == TY_ENUM && nty.variants as i64 != 0) {
				interp_emit_enum(b, nty);
			}
		}
		nt = nt.next;
	}
	var tml *Tmpl = tmpls;
	while (tml as i64 != 0) {
		interp_emit_tmpl(b, tml);
		tml = tml.next;
	}
}

fn interp_gen_scalar_body(b *Buf, f *Func) {
	fmt_str(b, "{ var __ia [14]i64;");
	var i int = 0;
	while (i < 14) {
		fmt_str(b, " __ia[");
		fmt_i64(b, i as i64);
		fmt_str(b, "] = ");
		if (i < f.nparams) {
			fmt_str(b, func_param(f, i).name);
			fmt_str(b, " as i64");
		} else { fmt_str(b, "0"); }
		fmt_str(b, ";");
		i = i + 1;
	}
	if (f.ret.kind != TY_VOID) {
		fmt_str(b, " return ");
	} else {
		fmt_str(b, " ");
	}
	// The jit call goes through a six-slot function pointer, so a
	// scalar-signature function with more than six parameters skips it.
	if (f.dynamic && f.nparams <= 6) { fmt_str(b, "__dyn_jit_call(\""); }
	else { fmt_str(b, "__interp_call_dispatch(\""); }
	fmt_str(b, f.name);
	fmt_str(b, "\", &__ia[0])");
	if (f.ret.kind != TY_VOID) {
		fmt_str(b, " as ");
		fmt_str(b, type_name(f.ret));
	}
	fmt_str(b, "; }");
}

fn interp_gen_marshalled_body(b *Buf, f *Func) {
	fmt_str(b, "{ var __b Buf; buf_u8(&__b, ");
	fmt_i64(b, f.name.len as i64);
	fmt_str(b, " as u8); buf_bytes(&__b, (\"");
	fmt_str(b, f.name);
	fmt_str(b, "\").ptr, ");
	fmt_i64(b, f.name.len as i64);
	fmt_str(b, ");");
	var i int = 0;
	while (i < f.nparams) {
		interp_gen_marshal(b, func_param(f, i).name, func_param(f, i).ty);
		i = i + 1;
	}
	if (f.dynamic && interp_jit_budget(f)) {
		fmt_str(b, " var __ia [6]i64;");
		var si int = 0;
		var pi int = 0;
		while (pi < f.nparams) {
			si = interp_gen_slot(b, func_param(f, pi).name, func_param(f, pi).ty, si);
			pi = pi + 1;
		}
		if (f.ret.kind != TY_VOID) {
			fmt_str(b, " var __r [");
			fmt_i64(b, f.ret.size as i64);
			fmt_str(b, "]u8; __ia[");
			fmt_i64(b, si as i64);
			fmt_str(b, "] = &__r[0] as i64;");
		}
		fmt_str(b, " if (__dyn_jit_call_marshalled(\"");
		fmt_str(b, f.name);
		fmt_str(b, "\", &__ia[0]) == 1) {");
		if (f.ret.kind != TY_VOID) {
			interp_gen_mem_ret(b, "&__r[0]", f.ret);
		}
		fmt_str(b, " }");
	}
	fmt_str(b, " var __resp str = __interp_call_marshalled(buf_str(&__b));");
	if (f.ret.kind != TY_VOID) {
		interp_gen_wire_ret(b, "__resp.ptr", f.ret);
	}
	fmt_str(b, " }");
}

fn interp_escape_src(raw str, pos i64) str {
	var b Buf;
	buf_u8(&b, '"');
	var i i64 = 0;
	while (i < raw.len) {
		var c u8 = raw.ptr[i];
		if (c == '$' && i + 1 < raw.len && raw.ptr[i + 1] == '{') {
			error_at(pos, "an interpreted/dynamic function's source cannot contain string interpolation -- it collides with re-embedding the source over the runtime ABI");
		}
		if (c == '\\') { buf_u8(&b, '\\'); buf_u8(&b, '\\'); }
		else if (c == '"') { buf_u8(&b, '\\'); buf_u8(&b, '"'); }
		else if (c == '\n') { buf_u8(&b, '\\'); buf_u8(&b, 'n'); }
		else if (c == '\r') { buf_u8(&b, '\\'); buf_u8(&b, 'r'); }
		else if (c == '\t') { buf_u8(&b, '\\'); buf_u8(&b, 't'); }
		else { buf_u8(&b, c); }
		i = i + 1;
	}
	buf_u8(&b, '"');
	return buf_str(&b);
}

var interp_trampoline_seq int = 0;

// The scalar trampoline body is parsed in place (it references only
// deferred call names). A marshalled body needs the `Buf` type, which
// does not exist until std/interpcall.qela and its imports are spliced
// in -- and the splice happens at the next top-level loop iteration, not
// synchronously here. So the marshalled body is emitted as a real
// top-level function (`__tramp<N>`) whose tokens are injected into the
// main stream right after the function being synthesized: the loop then
// splices the interp modules first, parses the tramp with `Buf` in
// scope, and `f.body` is a thin forwarder that calls it. The tramp is
// `__`-internal, so the --interpreted/--jit flags never touch it.
fn interp_synthesize_trampoline(t **Token, f *Func, fn_start i64, body_start i64, end_pos i64) {
	interp_sig_reject(f.ret, f.pos, "return type");
	var i int = 0;
	while (i < f.nparams) {
		interp_sig_reject(func_param(f, i).ty, f.pos, "parameter type");
		i = i + 1;
	}

	var fid int = diag_file_of(f.pos);
	var src str = diag_src_of(fid);
	var def_src str = str_slice(src, diag_offset_of(fn_start), diag_offset_of(end_pos));
	interp_escape_src(def_src, f.pos);
	f.src_start = fn_start;
	f.src_end = end_pos;
	f.body_start = body_start;

	var b Buf;
	if (interp_marshalled(f)) {
		var mb Buf;
		fmt_str(&mb, "fn __tramp");
		fmt_i64(&mb, interp_trampoline_seq as i64);
		fmt_str(&mb, "(");
		i = 0;
		while (i < f.nparams) {
			if (i > 0) { fmt_str(&mb, ", "); }
			fmt_str(&mb, func_param(f, i).name);
			fmt_str(&mb, " ");
			fmt_str(&mb, type_name(func_param(f, i).ty));
			i = i + 1;
		}
		fmt_str(&mb, ") ");
		if (f.ret.kind != TY_VOID) {
			fmt_str(&mb, type_name(f.ret));
			fmt_str(&mb, " ");
		}
		interp_gen_marshalled_body(&mb, f);
		var tb str = buf_str(&mb);
		var tfile int = diag_add_file("<interp-marshalled>", tb);
		var ttoks *Token = lex(tb, (tfile as i64) << FILE_SHIFT);
		var ttail *Token = ttoks;
		while (ttail.next as i64 != 0 && ttail.next.kind != TK_EOF) { ttail = ttail.next; }
		ttail.next = *t;
		*t = ttoks;

		fmt_str(&b, "{ ");
		if (f.ret.kind != TY_VOID) { fmt_str(&b, "return "); }
		fmt_str(&b, "__tramp");
		fmt_i64(&b, interp_trampoline_seq as i64);
		fmt_str(&b, "(");
		i = 0;
		while (i < f.nparams) {
			if (i > 0) { fmt_str(&b, ", "); }
			fmt_str(&b, func_param(f, i).name);
			i = i + 1;
		}
		fmt_str(&b, "); }");
	} else {
		interp_gen_scalar_body(&b, f);
	}
	interp_trampoline_seq = interp_trampoline_seq + 1;

	var nameb Buf;
	fmt_str(&nameb, "<interp-trampoline:");
	fmt_i64(&nameb, interp_trampoline_seq as i64);
	buf_u8(&nameb, '>');

	var synth_file int = diag_add_file(buf_str(&nameb), buf_str(&b));
	var synth_toks *Token = lex(buf_str(&b), (synth_file as i64) << FILE_SHIFT);
	f.interp_body = f.body;
	add_type(f.interp_body);
	f.body = parse_block(&synth_toks);
	need_interp = true;
}

fn parse_function(t **Token, is_extern bool) *Func {
	var fn_start i64 = (*t).pos;
	tok_expect(t, "fn");
	// A naked function runs without prologue or epilogue: no frame, no
	// implicit ret. The body is asm bytes plus bare stores, so the
	// restrictions below are the frame's absence stated out loud.
	var naked_fn bool = tok_consume(t, "naked");
	var interpreted_fn bool = false;
	var dynamic_fn bool = false;
	var frozen_fn bool = false;
	if (!naked_fn) {
		interpreted_fn = tok_consume(t, "interpreted");
		if (!interpreted_fn) {
			dynamic_fn = tok_consume(t, "dynamic");
			if (!dynamic_fn) { frozen_fn = tok_consume(t, "frozen"); }
		}
	}
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;

	var is_internal bool = name.len > 2 && name.ptr[0] == '_' && name.ptr[1] == '_';
	if (!naked_fn && !interpreted_fn && !dynamic_fn && !frozen_fn &&
	    !is_extern && !is_internal && !is_std_path(diag_path_of(diag_file_of(p)))) {
		if (opt_global_jit) { dynamic_fn = true; }
		else if (opt_global_interpreted) { interpreted_fn = true; }
	}

	var f *Func = arena_alloc(sizeof(Func), 8) as *Func;
	f.name = name;
	f.ret = type_lookup("void");
	f.pos = p;
	f.naked = naked_fn;
	f.interpreted = interpreted_fn;
	f.dynamic = dynamic_fn;
	f.frozen = frozen_fn;
	f.extern = is_extern;
	if (is_extern && (interpreted_fn || dynamic_fn)) {
		error_at(p, "an extern function cannot be 'interpreted' or 'dynamic'");
	}
	cur_func = f;
	type_set_fn(f);

	enter_scope();
	tok_expect(t, "(");
	var nparams int = 0;
	var rwords int = 0;
	var stack_slot int = 0;
	var saved_ntype_vars int = ntype_vars;
	while (!tok_eq(*t, ")")) {
		if (nparams > 0) { tok_expect(t, ","); }
		if (naked_fn) { error_at((*t).pos, "naked functions cannot take parameters"); }

		if (tok_consume(t, "comptime")) {
			var pn str = (*t).text;
			var pp i64 = (*t).pos;
			*t = (*t).next;
			tok_expect(t, ":");
			if (f.nct != nparams) { error_at(pp, "comptime parameters must come first"); }
			if (f.nct == 6) { error_at(pp, "too many comptime parameters"); }
			parse_type(t);
			var tv *Type = type_new_var(pn);
			type_vars[ntype_vars] = tv;
			ntype_vars = ntype_vars + 1;
			// The parameter carries the type variable itself: monomorphization
			// reads it back from here to know what to substitute.
			var v *Var = declare_var(pn, tv, pp);
			f.nct = f.nct + 1;
			set_func_param(f, nparams, v);
			nparams = nparams + 1;
			continue;
		}

		var pn str = (*t).text;
		var pp i64 = (*t).pos;
		*t = (*t).next;
		// `a=expr i32` -- a default value, parsed before the type since
		// that's the declared order. It may name a global freely, or an
		// earlier, non-defaulted parameter of this same function
		// (substituted at the call site); it may not name a defaulted
		// parameter -- there is no dependency order between defaults.
		var pdefault *Node = 0 as *Node;
		if (tok_consume(t, "=")) {
			pdefault = parse_assign(t);
			if (expr_refs_default_param(pdefault)) {
				error_at(pp, "a default value cannot reference another defaulted parameter");
			}
		}
		var pty *Type = parse_type(t);
		var is2word bool = is_aggregate(pty) && pty.size > 8 && pty.size <= 16;
		if (is2word) { rwords = rwords + 2; } else { rwords = rwords + 1; }
		var v *Var = declare_var(pn, pty, pp);
		v.by_ref = is_aggregate(pty) && abi_by_ref(pty.size);
		v.default = pdefault;
		// Comptime parameters occupy p0..p5 by position too, so a run of
		// six of them (f.nct == 6, allowed) leaves no register slot for
		// any regular parameter that follows even if its own word cost is
		// small -- treat that the same as a register-word overflow.
		if (rwords > abi_n_arg_regs() || nparams >= abi_n_arg_regs()) {
			if (is2word) {
				error_at(pp, "a str or struct parameter here would not fit in the argument registers (pass it earlier, or by pointer)");
			}
			if (f.extern) {
				error_at(pp, "an extern function takes at most six register words (SysV marshalling is register-only for now)");
			}
			v.arg_stack = true;
			v.no_reg = true;
			v.offset = (16 + 8 * stack_slot) as int;
			stack_slot = stack_slot + 1;
			f.n_stack_args = f.n_stack_args + 1;
		}
		set_func_param(f, nparams, v);
		nparams = nparams + 1;
		// gen_args carries at most 14 arguments through its placement
		// arrays; beyond that the overflow scan misses the tail and the
		// spill pushes never happen, so the callee reads garbage.
		if (nparams > 14) { error_at(pp, "too many parameters (at most 14)"); }
	}
	f.nparams = nparams;
	tok_expect(t, ")");

	if (!tok_eq(*t, "{")) { f.ret = parse_type(t); }
	if (tok_eq(*t, ";")) {
		// `extern fn f(...) t;` -- a declaration only. A plain function
		// still has to have a body; a bare prototype needs the extern to
		// mean "the linker supplies this symbol".
		if (!f.extern) { error_at((*t).pos, "function declaration without a body needs 'extern'"); }
		f.body = 0 as *Node;
		*t = (*t).next;
	} else {
		var body_start i64 = (*t).pos;
		f.body = parse_block(t);
		if (f.interpreted || f.dynamic) {
			interp_synthesize_trampoline(t, f, fn_start, body_start, (*t).pos);
		}
	}
	leave_scope();
	ntype_vars = saved_ntype_vars;
	cur_func = 0 as *Func;
	type_set_fn(0 as *Func);
	return f;
}

// `fn (params) { body }` in an expression: an anonymous function. It is
// compiled to a hidden function of its own and this node is the address of
// that function, so the value is an ordinary fn value. No captures: a
// variable from an enclosing function is rejected (there is no environment
// to carry), which also means the return type can be inferred from the
// body's returns by type.qela.
fn parse_lambda(t **Token, p i64) *Node {
	var b Buf;
	fmt_str(&b, "_$lambda");
	fmt_i64(&b, lambda_seq as i64);
	lambda_seq = lambda_seq + 1;
	var name str = buf_str(&b);

	var f *Func = arena_alloc(sizeof(Func), 8) as *Func;
	f.name = name;
	f.ret = 0 as *Type;
	f.pos = p;
	var saved_func *Func = cur_func;
	cur_func = f;
	type_set_fn(f);

	enter_scope();
	var saved_lscope *Scope = lambda_scope;
	lambda_scope = scope_root;
	// A typed block may be in progress in an enclosing scope; a plain
	// lambda nested inside one still has no environment of its own.
	var saved_capturing bool = capturing;
	capturing = false;
	tok_expect(t, "(");
	var nparams int = 0;
	var rwords int = 0;
	while (!tok_eq(*t, ")")) {
		if (nparams > 0) { tok_expect(t, ","); }
		var pn str = (*t).text;
		var pp i64 = (*t).pos;
		*t = (*t).next;
		var pty *Type = parse_type(t);
		var is2word bool = is_aggregate(pty) && pty.size > 8 && pty.size <= 16;
		if (is2word) { rwords = rwords + 2; } else { rwords = rwords + 1; }
		var v *Var = declare_var(pn, pty, pp);
		v.by_ref = is_aggregate(pty) && abi_by_ref(pty.size);
		if (rwords > abi_n_arg_regs() || nparams >= abi_n_arg_regs()) {
			error_at(pp, "a lambda takes at most six one-word parameters");
		}
		set_func_param(f, nparams, v);
		nparams = nparams + 1;
	}
	f.nparams = nparams;
	tok_expect(t, ")");

	if (!tok_eq(*t, "{")) { f.ret = parse_type(t); }
	f.body = parse_block(t);
	leave_scope();
	lambda_scope = saved_lscope;
	capturing = saved_capturing;
	cur_func = saved_func;
	type_set_fn(saved_func);

	add_func(f);

	var n *Node = new_node(ND_FUNCADDR, p);
	n.name = name;
	return n;
}

// `T { stmts...; super v; }` as an expression: an inline value-producing
// block. Compiles to a hidden function called immediately in place, like a
// lambda, but reads of outer locals are captures instead of errors --
// `capture_get_or_add` (via the flip in parse_primary's "no closures"
// check) turns each one into a hidden by-value parameter the first time it
// is seen, and the call below passes the outer variables as the matching
// arguments. `super` is `return` inside this hidden function.
fn parse_typed_block(t **Token, p i64, ty *Type) *Node {
	if (cur_func as i64 != 0 && cur_func.naked) {
		error_at(p, "naked functions cannot use a typed block");
	}
	var b Buf;
	fmt_str(&b, "_$tblock");
	fmt_i64(&b, lambda_seq as i64);
	lambda_seq = lambda_seq + 1;
	var name str = buf_str(&b);

	var f *Func = arena_alloc(sizeof(Func), 8) as *Func;
	f.name = name;
	f.ret = ty;
	f.pos = p;
	var saved_func *Func = cur_func;
	cur_func = f;
	type_set_fn(f);

	enter_scope();
	var saved_lscope *Scope = lambda_scope;
	lambda_scope = scope_root;
	var saved_capturing bool = capturing;
	capturing = true;
	var saved_cap_head *Capture = cap_head;
	var saved_cap_tail *Capture = cap_tail;
	var saved_cap_n int = cap_n;
	var saved_cap_rwords int = cap_rwords;
	var saved_cap_stack_slot int = cap_stack_slot;
	cap_head = 0 as *Capture;
	cap_tail = 0 as *Capture;
	cap_n = 0;
	cap_rwords = 0;
	cap_stack_slot = 0;

	f.body = parse_block(t);
	f.nparams = cap_n;
	var call_cap *Capture = cap_head;
	var nargs int = cap_n;

	leave_scope();
	lambda_scope = saved_lscope;
	capturing = saved_capturing;
	cap_head = saved_cap_head;
	cap_tail = saved_cap_tail;
	cap_n = saved_cap_n;
	cap_rwords = saved_cap_rwords;
	cap_stack_slot = saved_cap_stack_slot;
	cur_func = saved_func;
	type_set_fn(saved_func);

	add_func(f);

	var call *Node = new_node(ND_CALL, p);
	call.name = name;
	var ahead Node;
	var atail *Node = &ahead;
	var c *Capture = call_cap;
	while (c as i64 != 0) {
		var an *Node = new_node(ND_VAR, p);
		if (c.outer.is_global || !capturing) {
			an.varp = c.outer;
		} else {
			// The call site sits inside an enclosing typed block whose
			// captures are live again (cap_head and cur_func were restored
			// above). The argument must be that block's own copy of the
			// outer variable -- the only one its frame holds -- not the
			// original. A block that never referenced the variable itself
			// picks it up here, exactly as a body reference would.
			an.varp = capture_get_or_add(c.outer, p);
		}
		atail.next = an;
		atail = an;
		c = c.next;
	}
	call.args = ahead.next;
	call.nargs = nargs;
	return call;
}

fn parse_struct(t **Token) {
	tok_expect(t, "struct");
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;

	if (tok_consume(t, ";")) {
		if (type_lookup(name) as i64 == 0) {
			var ty *Type = arena_alloc(sizeof(Type), 8) as *Type;
			ty.kind = TY_STRUCT; ty.align = 8; ty.size = 8; ty.name = name;
			type_define(name, ty);
		}
		return;
	}

	var saved_tv int = ntype_vars;
	var tm *Tmpl = parse_tmpl_params(t, name, p);
	var ty *Type = 0 as *Type;
	if (tm as i64 != 0) {
		ty = tm.proto;
		ty.kind = TY_STRUCT;
	} else {
		ty = type_lookup(name);
		if (ty as i64 != 0 && ty.members as i64 != 0) { error_at(p, "redefinition"); }
		if (ty as i64 == 0) {
			ty = arena_alloc(sizeof(Type), 8) as *Type;
			ty.kind = TY_STRUCT; ty.name = name;
			type_define(name, ty);
		}
	}

	tok_expect(t, "{");
	var mhead Member;
	var mtail *Member = &mhead;
	var off int = 0; var align int = 1;
	while (!tok_eq(*t, "}")) {
		if (mtail != &mhead) { tok_expect(t, ","); }
		if (tok_eq(*t, "}")) { break; }
		var fnm str = (*t).text;
		var fp i64 = (*t).pos;
		*t = (*t).next;
		var fty *Type = parse_type(t);
		off = (off + fty.align - 1) & ~(fty.align - 1);
		var m *Member = arena_alloc(sizeof(Member), 8) as *Member;
		m.name = fnm; m.ty = fty; m.offset = off; m.pos = fp;
		off = off + fty.size;
		if (fty.align > align) { align = fty.align; }
		mtail.next = m; mtail = m;
	}
	tok_expect(t, "}");
	ty.members = mhead.next;
	ty.align = align;
	ty.size = (off + align - 1) & ~(align - 1);
	ntype_vars = saved_tv;
}

fn parse_enum(t **Token) {
	tok_expect(t, "enum");
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;

	var saved_tv int = ntype_vars;
	var tm *Tmpl = parse_tmpl_params(t, name, p);
	var ty *Type = 0 as *Type;
	if (tm as i64 != 0) {
		ty = tm.proto;
		ty.kind = TY_ENUM; ty.align = 8;
	} else {
		ty = arena_alloc(sizeof(Type), 8) as *Type;
		ty.kind = TY_ENUM; ty.align = 8; ty.name = name;
		type_define(name, ty);
	}

	tok_expect(t, "{");
	var vhead Variant;
	var vtail *Variant = &vhead;
	var tag int = 0;
	var maxpay int = 0;
	while (!tok_eq(*t, "}")) {
		if (vtail != &vhead) { tok_expect(t, ","); }
		if (tok_eq(*t, "}")) { break; }
		var vnm str = (*t).text;
		var vp i64 = (*t).pos;
		*t = (*t).next;
		var dv *Variant = vhead.next;
		while (dv as i64 != 0) {
			if (str_eq(dv.name, vnm)) {
				emsg("duplicate variant '"); emsg(vnm); emsg("'"); efail(vp);
			}
			dv = dv.next;
		}
		// match's arm_seen is a fixed 64-entry table, so an enum cannot
		// have more variants than that.
		if (tag == 64) { error_at(vp, "at most 64 variants are supported"); }
		var v *Variant = arena_alloc(sizeof(Variant), 8) as *Variant;
		v.name = vnm; v.tag = tag; v.pos = vp; tag = tag + 1;

		if (tok_consume(t, "(")) {
			var fhead Member;
			var ftail *Member = &fhead;
			var voff int = 8;
			var nf int = 0;
			while (!tok_eq(*t, ")")) {
				if (ftail != &fhead) { tok_expect(t, ","); }
				var fty *Type = parse_type(t);
				voff = (voff + fty.align - 1) & ~(fty.align - 1);
				var m *Member = arena_alloc(sizeof(Member), 8) as *Member;
				m.ty = fty; m.offset = voff; m.pos = vp;
				voff = voff + fty.size;
				nf = nf + 1;
				ftail.next = m; ftail = m;
			}
			tok_expect(t, ")");
			v.fields = fhead.next;
			v.nfields = nf;
			if (voff - 8 > maxpay) { maxpay = voff - 8; }
		}
		vtail.next = v; vtail = v;
	}
	tok_expect(t, "}");
	ty.variants = vhead.next;
	ty.size = ((8 + maxpay + 7) & ~7) as int;
	ntype_vars = saved_tv;
}

fn trunc_to(v i64, ty *Type) i64 {
	if (ty.size == 1) {
		if (ty.is_unsigned || ty.kind == TY_BOOL) { return v & 255; }
		return ((v & 255) ^ 128) - 128;
	}
	if (ty.size == 2) {
		if (ty.is_unsigned) { return v & 0xffff; }
		return ((v & 0xffff) ^ 0x8000) - 0x8000;
	}
	if (ty.size == 4) {
		if (ty.is_unsigned) { return v & 0xffffffff; }
		return ((v & 0xffffffff) ^ 0x80000000) - 0x80000000;
	}
	return v;
}

fn eval_const(n *Node) i64 {
	var k int = n.kind;
	if (k == ND_NUM) { return n.val; }
	if (k == ND_NEG) {
		// A float constant negates by flipping the IEEE sign bit, not by
		// two's-complementing the stored bits (a literal keeps its f64
		// pattern, so `-x` of that would be garbage).
		var nv i64 = eval_const(n.lhs);
		if (n.lhs.ty as i64 != 0 && is_float(n.lhs.ty)) {
			var mask i64 = 0x8000000000000000;
			if (n.lhs.ty.size == 4) { mask = 0x80000000; }
			return nv ^ mask;
		}
		return -nv;
	}
	if (k == ND_BITNOT) { return ~eval_const(n.lhs); }
	if (k == ND_NOT) { if (eval_const(n.lhs) == 0) { return 1; } return 0; }
	if (k == ND_CAST) {
		var v i64 = eval_const(n.lhs);
		if (n.ty.kind == TY_BOOL) { if (v != 0) { return 1; } return 0; }
		return trunc_to(v, n.ty);
	}
	if (k == ND_COMPTIME) { return n.val; }
	if (k == ND_SIZEOF) { return n.typeval.size as i64; }
	if (k == ND_ADD) { return eval_const(n.lhs) + eval_const(n.rhs); }
	if (k == ND_SUB) { return eval_const(n.lhs) - eval_const(n.rhs); }
	if (k == ND_MUL) { return eval_const(n.lhs) * eval_const(n.rhs); }
	if (k == ND_BITAND) { return eval_const(n.lhs) & eval_const(n.rhs); }
	if (k == ND_BITOR) { return eval_const(n.lhs) | eval_const(n.rhs); }
	if (k == ND_BITXOR) { return eval_const(n.lhs) ^ eval_const(n.rhs); }
	if (k == ND_SHL) { return eval_const(n.lhs) << eval_const(n.rhs); }
	if (k == ND_SHR) { return eval_const(n.lhs) >> eval_const(n.rhs); }
	if (k == ND_EQ) { if (eval_const(n.lhs) == eval_const(n.rhs)) { return 1; } return 0; }
	if (k == ND_NE) { if (eval_const(n.lhs) != eval_const(n.rhs)) { return 1; } return 0; }
	if (k == ND_LT) { if (eval_const(n.lhs) < eval_const(n.rhs)) { return 1; } return 0; }
	if (k == ND_LE) { if (eval_const(n.lhs) <= eval_const(n.rhs)) { return 1; } return 0; }
	if (k == ND_DIV || k == ND_MOD) {
		var d i64 = eval_const(n.rhs);
		if (d == 0) { error_at(n.pos, "division by zero in a constant expression"); }
		if (k == ND_DIV) { return eval_const(n.lhs) / d; }
		return eval_const(n.lhs) % d;
	}
	error_at(n.pos, "initializer must be a constant expression");
	return 0;
}

// "std/..." names the library the compiler carries inside itself. A file of
// the same name on disk wins, so the shipped modules stay editable.
fn is_std_path(s str) bool {
	if (s.len < 4) { return false; }
	return s.ptr[0] == 's' && s.ptr[1] == 't' && s.ptr[2] == 'd' && s.ptr[3] == '/';
}

fn blob_find(name str) int {
	var i int = 0;
	var n int = std_blob_count();
	while (i < n) {
		if (str_eq(std_blob_name(i), name)) { return i; }
		i = i + 1;
	}
	return -1;
}

fn parse_global(t **Token, is_extern bool, is_eval bool) {
	var kw str = (*t).text;
	var is_tls bool = str_eq(kw, "tvar");
	var typed bool = str_eq(kw, "var") || is_tls;
	*t = (*t).next;
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;
	var ty *Type = 0 as *Type;
	if (typed && !tok_eq(*t, "=")) { ty = parse_type(t); }
	var init i64 = 0;
	var has_init bool = false;
	if (tok_consume(t, "=")) {
		has_init = true;
		var rhs *Node = parse_assign(t);
		add_type(rhs);
		if (ty as i64 == 0) { ty = rhs.ty; }
		init = eval_const(rhs);
	}
	if (is_extern && ty as i64 == 0) {
		error_at(p, "extern var needs a type");
	}
	if (is_tls && is_extern) { error_at(p, "tvar cannot be extern"); }
	var gv *Var = declare_var(name, ty, p);
	gv.extern = is_extern;
	gv.has_init = has_init;
	gv.init = init;
	gv.is_tls = is_tls;
	gv.eval_export = is_eval;
	tok_expect(t, ";");
}

fn save_type_vars(vars **Type, n *int) {
	*n = ntype_vars;
}

fn restore_type_vars(vars **Type, n int) {
	ntype_vars = n;
}

// "dir/../std/x.qela" normalizes to "std/x.qela", so the same module
// reached through two relative spellings dedups in the file table.
fn path_norm(p str) str {
	var parts [16]str;
	var n int = 0;
	var i i64 = 0;
	var start i64 = 0;
	while (i <= p.len) {
		if (i == p.len || p.ptr[i] == '/') {
			var part str;
			part.ptr = p.ptr + start;
			part.len = i - start;
			if (part.len == 2 && part.ptr[0] == '.' && part.ptr[1] == '.') {
				if (n > 0) { n = n - 1; }
			} else if (!(part.len == 1 && part.ptr[0] == '.')) {
				parts[n] = part;
				n = n + 1;
			}
			start = i + 1;
		}
		i = i + 1;
	}
	var b Buf;
	var k int = 0;
	while (k < n) {
		if (k > 0) { buf_u8(&b, '/'); }
		buf_bytes(&b, parts[k].ptr, parts[k].len);
		k = k + 1;
	}
	return buf_str(&b);
}

// Loads a module and splices its tokens before `tok`, unless a file of
// that path is already in the table. Returns the new head of the stream.
fn splice_import(tok *Token, path str, pos i64) *Token {
	path = path_norm(path);
	if (diag_already_imported(path)) { return tok; }
	var isrc str;
	if (file_exists(path)) {
		isrc = read_file(path);
	} else {
		var bi int = blob_find(path);
		if (bi < 0) {
			emsg("cannot open "); emsg(path); efail(pos);
		}
		isrc = std_blob_src(bi);
	}
	var fid int = diag_add_file(path, isrc);
	var ihead *Token = lex(isrc, (fid as i64) << FILE_SHIFT);
	var itail *Token = ihead;
	while (itail.next as i64 != 0 && itail.next.kind != TK_EOF) {
		itail = itail.next;
	}
	itail.next = tok;
	return ihead;
}

fn parse(tok *Token) *Unit {
	enter_scope();
	var head Func;
	while (true) {
		// An interpolated string was desugared somewhere in the previous
		// top-level item; the formatting helpers are std/fmt.qela. It is
		// imported here, at top level, so the splice cannot land inside a
		// function body. Checked before the EOF test: a file whose last
		// item used interpolation has no iteration left otherwise. One
		// file of the same path already in the table (an explicit user
		// import) makes this a no-op.
		if (need_fmt) {
			need_fmt = false;
			tok = splice_import(tok, "std/fmt.qela", tok.pos);
		}
		if (need_dyn) {
			need_dyn = false;
			tok = splice_import(tok, "std/dyn.qela", tok.pos);
		}
		if (need_interp) {
			need_interp = false;
			tok = splice_import(tok, "std/interpcall.qela", tok.pos);
		}
		resolve_comptime(&tok);
		if (tok.kind == TK_EOF) { break; }
		if (tok_eq(tok, "asm") && tok.next.kind == TK_PUNCT && tok_eq(tok.next, "{")) {
			parse_top_asm(&tok); continue;
		}
		if (tok_eq(tok, "entry")) { parse_entry(&tok); continue; }
		if (tok_eq(tok, "macro")) { parse_macro(&tok); continue; }
		if (tok_eq(tok, "struct")) { parse_struct(&tok); continue; }
		if (tok_eq(tok, "enum")) { parse_enum(&tok); continue; }
		if (tok_eq(tok, "let") || tok_eq(tok, "var") || tok_eq(tok, "tvar")) { parse_global(&tok, false, false); continue; }
		if (tok_eq(tok, "extern") && tok.next.kind == TK_KW && str_eq(tok.next.text, "var")) {
			// `extern var x i64;` imports the C symbol, `extern var x i64 = K;`
			// exports a Qela global. Same split as extern fn, keyed on the
			// initializer.
			tok = tok.next;
			parse_global(&tok, true, false);
			continue;
		}
		if (tok_eq(tok, "eval") && tok.next.kind == TK_KW && str_eq(tok.next.text, "var")) {
			tok = tok.next;
			parse_global(&tok, false, true);
			continue;
		}
		if (tok_eq(tok, "import")) {
			var ipos i64 = tok.pos;
			tok = tok.next;
			if (tok.kind != TK_STR) { error_at(tok.pos, "import needs a string path"); }
			var raw str = tok.sval;
			tok = tok.next;
			tok_expect(&tok, ";");

			var path str = raw;
			if (!is_std_path(raw)) {
				var pb Buf;
				fmt_str(&pb, diag_file_dir(diag_file_of(ipos)));
				fmt_str(&pb, raw);
				path = buf_str(&pb);
			}
			tok = splice_import(tok, path, ipos);
			continue;
		}
		// `extern fn f(...) t;` -- a declaration without a body -- declares a
		// symbol the linker must provide, and `extern fn f(...) t { ... }`
		// exports the function's symbol for the C side. Both only matter
		// under `-c`; a plain compile cannot resolve the former (no linker).
		var is_ext bool = false;
		if (tok_eq(tok, "extern")) {
			if (tok.next.kind != TK_KW || !str_eq(tok.next.text, "fn")) {
				error_at(tok.pos, "expected 'fn' or 'var' after 'extern'");
			}
			is_ext = true;
			tok = tok.next;
		}
		var is_eval_fn bool = false;
		if (tok_eq(tok, "eval") && tok.next.kind == TK_KW && str_eq(tok.next.text, "fn")) {
			is_eval_fn = true;
			tok = tok.next;
		}
		var nf *Func = parse_function(&tok, is_ext);
		nf.eval_export = is_eval_fn;
		// Appending through funcs_tail keeps mid-parse instantiations
		// (a generic call typed by a var initializer) and lambdas in the
		// list: the local chain alone would orphan them on the next append.
		if (funcs_tail as i64 == 0) { head.next = nf; }
		else { funcs_tail.next = nf; }
		funcs_tail = nf;
		// A lambda parsed inside this function may have seeded the list
		// before head.next was set; anchor the chain on the first entry.
		if (head.next as i64 == 0) { head.next = all_funcs; }
		all_funcs = head.next;
	}

	if (find_func("abi_spawn") as i64 != 0 && find_func("__eval_call_dispatch") as i64 == 0) {
		var db Buf;
		fmt_str(&db, "fn __eval_call_dispatch(name str, args *u8, __b *Buf) bool { if (name.ptr as i64 == args as i64 || __b.p as i64 != __b.p as i64) { return false; }");
		var ef *Func = all_funcs;
		while (ef as i64 != 0) {
			if (ef.eval_export && ef.nct == 0) {
				interp_sig_reject(ef.ret, ef.pos, "return type");
				var ei int = 0;
				while (ei < ef.nparams) {
					interp_sig_reject(func_param(ef, ei).ty, ef.pos, "parameter type");
					ei = ei + 1;
				}
				fmt_str(&db, " if (str_eq(name, \"");
				fmt_str(&db, ef.name);
				fmt_str(&db, "\")) {");
				interp_gen_eval_body(&db, ef);
				fmt_str(&db, " return true; }");
			}
			ef = ef.next;
		}
		fmt_str(&db, " return false; }");

		var dfile int = diag_add_file("<eval-dispatch>", buf_str(&db));
		var dtoks *Token = lex(buf_str(&db), (dfile as i64) << FILE_SHIFT);
		var dnf *Func = parse_function(&dtoks, false);
		if (funcs_tail as i64 == 0) { head.next = dnf; }
		else { funcs_tail.next = dnf; }
		funcs_tail = dnf;
		if (head.next as i64 == 0) { head.next = all_funcs; }
		all_funcs = head.next;
	}

	if (find_func("abi_spawn") as i64 != 0 && find_func("__eval_get_dispatch") as i64 == 0) {
		var gb Buf;
		fmt_str(&gb, "fn __eval_get_dispatch(__name str) str { if (__name.len < 0) { var e str; return e; }");
		var gv *Var = global_vars;
		while (gv as i64 != 0) {
			if (gv.eval_export) {
				interp_sig_reject(gv.ty, gv.pos, "global type");
				fmt_str(&gb, " if (str_eq(__name, \"");
				fmt_str(&gb, gv.name);
				fmt_str(&gb, "\")) { var __b Buf;");
				interp_gen_marshal(&gb, gv.name, gv.ty);
				fmt_str(&gb, " return buf_str(&__b); }");
			}
			gv = gv.next;
		}
		fmt_str(&gb, " var e str; return e; }");

		var gfile int = diag_add_file("<eval-get-dispatch>", buf_str(&gb));
		var gtoks *Token = lex(buf_str(&gb), (gfile as i64) << FILE_SHIFT);
		var gnf *Func = parse_function(&gtoks, false);
		if (funcs_tail as i64 == 0) { head.next = gnf; }
		else { funcs_tail.next = gnf; }
		funcs_tail = gnf;
		if (head.next as i64 == 0) { head.next = all_funcs; }
		all_funcs = head.next;
	}

	if (find_func("abi_spawn") as i64 != 0 && find_func("__eval_set_dispatch") as i64 == 0) {
		var sb Buf;
		fmt_str(&sb, "fn __eval_set_dispatch(__name str, __p *u8) { if (__name.ptr as i64 == __p as i64) { return; }");
		var sv *Var = global_vars;
		while (sv as i64 != 0) {
			if (sv.eval_export) {
				interp_sig_reject(sv.ty, sv.pos, "global type");
				fmt_str(&sb, " if (str_eq(__name, \"");
				fmt_str(&sb, sv.name);
				fmt_str(&sb, "\")) { var __cur *u8 = __p;");
				interp_gen_global_decode(&sb, sv.name, sv.ty);
				fmt_str(&sb, " return; }");
			}
			sv = sv.next;
		}
		fmt_str(&sb, " }");

		var sfile int = diag_add_file("<eval-set-dispatch>", buf_str(&sb));
		var stoks *Token = lex(buf_str(&sb), (sfile as i64) << FILE_SHIFT);
		var snf *Func = parse_function(&stoks, false);
		if (funcs_tail as i64 == 0) { head.next = snf; }
		else { funcs_tail.next = snf; }
		funcs_tail = snf;
		if (head.next as i64 == 0) { head.next = all_funcs; }
		all_funcs = head.next;
	}

	if (find_func("abi_spawn") as i64 != 0 && find_func("__interp_all_src") as i64 == 0) {
		var cb Buf;
		interp_emit_types(&cb);
		// eval fns are host functions; the child gets their signatures as
		// bodyless extern declarations so a call from eval'd or
		// interpreted code types correctly, then routes to the host (see
		// ip_call_node's extern+abi-mode branch).
		var ed *Func = all_funcs;
		while (ed as i64 != 0) {
			if (ed.eval_export && ed.nct == 0) {
				fmt_str(&cb, "extern fn ");
				fmt_str(&cb, ed.name);
				fmt_str(&cb, "(");
				var edi int = 0;
				while (edi < ed.nparams) {
					if (edi > 0) { fmt_str(&cb, ", "); }
					var edv *Var = func_param(ed, edi);
					fmt_str(&cb, edv.name);
					fmt_str(&cb, " ");
					fmt_str(&cb, type_name(edv.ty));
					edi = edi + 1;
				}
				fmt_str(&cb, ") ");
				if (ed.ret.kind != TY_VOID) {
					fmt_str(&cb, type_name(ed.ret));
					fmt_str(&cb, " ");
				}
				fmt_str(&cb, ";\n");
			}
			ed = ed.next;
		}
		// eval vars are host globals; the child gets their declarations as
		// bodyless extern vars so an eval'd read or write types correctly,
		// then routes to the host (see ip_ev_var/ip_assign's extern+abi-mode
		// branches).
		var eg *Var = global_vars;
		while (eg as i64 != 0) {
			if (eg.eval_export) {
				fmt_str(&cb, "extern var ");
				fmt_str(&cb, eg.name);
				fmt_str(&cb, " ");
				fmt_str(&cb, type_name(eg.ty));
				fmt_str(&cb, ";\n");
			}
			eg = eg.next;
		}
		var cf *Func = all_funcs;
		while (cf as i64 != 0) {
			if ((cf.interpreted || cf.dynamic) && cf.nct == 0) {
				var cfid int = diag_file_of(cf.pos);
				var csrc str = diag_src_of(cfid);
				var cbody str = str_slice(csrc, diag_offset_of(cf.body_start), diag_offset_of(cf.src_end));
				fmt_str(&cb, "fn ");
				if (cf.dynamic) { fmt_str(&cb, "dynamic "); } else { fmt_str(&cb, "interpreted "); }
				fmt_str(&cb, cf.name);
				fmt_str(&cb, "(");
				var cpi int = 0;
				while (cpi < cf.nparams) {
					if (cpi > 0) { fmt_str(&cb, ", "); }
					var cpv *Var = func_param(cf, cpi);
					fmt_str(&cb, cpv.name);
					fmt_str(&cb, " ");
					fmt_str(&cb, type_name(cpv.ty));
					cpi = cpi + 1;
				}
				fmt_str(&cb, ") ");
				if (cf.ret.kind != TY_VOID) {
					fmt_str(&cb, type_name(cf.ret));
					fmt_str(&cb, " ");
				}
				fmt_str(&cb, cbody);
				buf_u8(&cb, '\n');
			}
			cf = cf.next;
		}
		var escaped_all str = interp_escape_src(buf_str(&cb), 0);

		var ab Buf;
		fmt_str(&ab, "fn __interp_all_src() str { return ");
		fmt_str(&ab, escaped_all);
		fmt_str(&ab, "; }");

		var afile int = diag_add_file("<interp-all-src>", buf_str(&ab));
		var atoks *Token = lex(buf_str(&ab), (afile as i64) << FILE_SHIFT);
		var anf *Func = parse_function(&atoks, false);
		if (funcs_tail as i64 == 0) { head.next = anf; }
		else { funcs_tail.next = anf; }
		funcs_tail = anf;
		if (head.next as i64 == 0) { head.next = all_funcs; }
		all_funcs = head.next;
	}

	leave_scope();

	var f *Func = head.next;
	while (f as i64 != 0) {
		if (find_func(f.name) as i64 != f as i64) {
			emsg("redefinition of function '"); emsg(f.name); emsg("'"); efail(f.pos);
		}
		if (f.nct == 0) {
			type_func(f);
			opt_func(f);
			elide_bounds(f);
			regalloc(f);
			count_reads(f);
			warn_unused(f);

			var off i64 = (f.nsaved as i64) * 8;
			var v *Var = f.locals;
			while (v as i64 != 0) {
				if (!v.has_reg && !v.arg_stack) {
					var size i64 = v.ty.size as i64;
					var al i64 = v.ty.align as i64;
					if (v.by_ref) { size = 8; al = 8; }
					else if (size < 8) { size = 8; }
					off = (off + size + al - 1) & ~(al - 1);
					v.offset = off as int;
				}
				v = v.next;
			}
			f.stack_size = ((off + 15) & ~15) as int;
		}
		f = f.next;
	}

	var u *Unit = arena_alloc(sizeof(Unit), 8) as *Unit;
	u.funcs = head.next;
	u.globals = global_vars;
	u.strs = strlist_head;
	u.nstrs = nstrs;
	return u;
}
