import "comp.qela";
import "diag.qela";
import "type.qela";
import "funcs.qela";
import "regalloc.qela";
import "generic.qela";
import "opt.qela";
import "bounds.qela";
import "../std/io.qela";
import "blob.qela";

// ── "did you mean?" suggestions ──
//
// When the user types an unknown identifier that's close to a keyword
// (Levenshtein distance ≤ 2), suggest the keyword as a hint. The list
// mirrors `keywords[]` in src/lex.c; both must agree. The function
// returns the keyword text, or "" if nothing is close enough.

struct Scope;
struct VarScope;

var keywords [23]str;
var keywords_inited bool = false;

fn keywords_setup() {
	if (keywords_inited) { return; }
	keywords_inited = true;
	keywords[0]  = "fn";
	keywords[1]  = "let";
	keywords[2]  = "var";
	keywords[3]  = "if";
	keywords[4]  = "else";
	keywords[5]  = "while";
	keywords[6]  = "for";
	keywords[7]  = "in";
	keywords[8]  = "break";
	keywords[9]  = "continue";
	keywords[10] = "return";
	keywords[11] = "as";
	keywords[12] = "struct";
	keywords[13] = "enum";
	keywords[14] = "match";
	keywords[15] = "defer";
	keywords[16] = "import";
	keywords[17] = "comptime";
	keywords[18] = "sizeof";
	keywords[19] = "true";
	keywords[20] = "false";
	keywords[21] = "asm";
	keywords[22] = "null";
}

fn lev_dist(a str, b str) i64 {
	if (a.len == 0) { return b.len; }
	if (b.len == 0) { return a.len; }
	// Two-row DP. Cost: (a.len+1) * (b.len+1) cells; with short keywords
	// (~10 chars max) this is ~144 ops per candidate, 22 candidates → 3 KiB
	// worth of stack per call. We use a flat int array on the arena.
	var m i64 = b.len + 1;
	var prev *i64 = arena_alloc(m * 8, 8) as *i64;
	var cur  *i64 = arena_alloc(m * 8, 8) as *i64;
	var j i64 = 0;
	while (j < m) { prev[j] = j; j = j + 1; }
	var i i64 = 1;
	while (i <= a.len) {
		cur[0] = i;
		var k i64 = 1;
		while (k <= b.len) {
			var cost i64 = 1;
			if (a.ptr[i - 1] == b.ptr[k - 1]) { cost = 0; }
			var del i64 = prev[k] + 1;
			var ins i64 = cur[k - 1] + 1;
			var sub i64 = prev[k - 1] + cost;
			var v i64 = del;
			if (ins < v) { v = ins; }
			if (sub < v) { v = sub; }
			cur[k] = v;
			k = k + 1;
		}
		var tmp *i64 = prev;
		prev = cur;
		cur = tmp;
		i = i + 1;
	}
	return prev[b.len];
}

// A "did you mean?" accumulator shared by every suggestion walk.
struct Sugg {
	best   str,
	best_d i64,
}

fn sugg_try(s *Sugg, name str, cand str) {
	if (cand.len >= 2 && cand.ptr[0] == '_' && cand.ptr[1] == '$') { return; }
	var d i64 = lev_dist(name, cand);
	// One retry case-insensitively: `Int64` for `i64` is a two-edit typo
	// only when case is ignored, and it is the classic spelling mistake.
	if (d > 2) { d = lev_dist(str_lower(name), str_lower(cand)); }
	if (d > 0 && d <= 2 && d < s.best_d) {
		s.best = cand;
		s.best_d = d;
	}
}

fn did_you_mean(name str) str {
	keywords_setup();
	var s Sugg;
	s.best_d = 3;
	var k i64 = 0;
	while (k < 22) {
		sugg_try(&s, name, keywords[k]);
		k = k + 1;
	}
	return s.best;
}

// Builtin scalar names, mirrored from type_lookup so a typo in `i64` or
// `str` gets a suggestion too.
var type_names [19]str;
var type_names_inited bool = false;

fn type_names_setup() {
	if (type_names_inited) { return; }
	type_names_inited = true;
	type_names[0]  = "void";
	type_names[1]  = "bool";
	type_names[2]  = "type";
	type_names[3]  = "i8";
	type_names[4]  = "i16";
	type_names[5]  = "i32";
	type_names[6]  = "i64";
	type_names[7]  = "u8";
	type_names[8]  = "u16";
	type_names[9]  = "u32";
	type_names[10] = "u64";
	type_names[11] = "int";
	type_names[12] = "uint";
	type_names[13] = "usize";
	type_names[14] = "f32";
	type_names[15] = "f64";
	type_names[16] = "float";
	type_names[17] = "double";
	type_names[18] = "str";
}

fn suggest_type(name str) str {
	type_names_setup();
	var s Sugg;
	s.best_d = 3;
	var i i64 = 0;
	while (i < 19) {
		sugg_try(&s, name, type_names[i]);
		i = i + 1;
	}
	var n *Named = named_types;
	while (n as i64 != 0) {
		sugg_try(&s, name, n.name);
		n = n.next;
	}
	var tm *Tmpl = tmpls;
	while (tm as i64 != 0) {
		sugg_try(&s, name, tm.name);
		tm = tm.next;
	}
	return s.best;
}

// Closest field of a struct / enum variant. Called from type.qela, where
// the member lists live.
fn suggest_member(names *Member, name str) str {
	var s Sugg;
	s.best_d = 3;
	while (names as i64 != 0) {
		sugg_try(&s, name, names.name);
		names = names.next;
	}
	return s.best;
}

fn suggest_variant(vs *Variant, name str) str {
	var s Sugg;
	s.best_d = 3;
	while (vs as i64 != 0) {
		sugg_try(&s, name, vs.name);
		vs = vs.next;
	}
	return s.best;
}

// "error: msg" followed by "hint: did you mean 'sug'?" when a candidate is
// close enough; a plain error otherwise.
fn error_suggest(pos i64, msg str, sug str) {
	if (sug.len == 0) { error_at(pos, msg); }
	var b Buf;
	fmt_str(&b, "did you mean '");
	fmt_str(&b, sug);
	fmt_str(&b, "'?");
	error_hint_at(pos, msg, buf_str(&b));
}

// The soft twin: reports and returns, so the caller can poison the node
// and the compile keeps going.
fn err_soft_suggest(pos i64, msg str, sug str) {
	if (sug.len == 0) { err_emit(pos, msg); return; }
	var b Buf;
	fmt_str(&b, "did you mean '");
	fmt_str(&b, sug);
	fmt_str(&b, "'?");
	err_emit_hint(pos, msg, buf_str(&b));
}

// ── global state ──

var scope_root *Scope;
var global_vars *Var;

var global_vars_tail *Var;

// The innermost lambda's own scope and a counter for its hidden name. Both
// are nonzero/active only while a lambda body is being parsed: a variable
// resolved outside that scope chain but inside the enclosing function is a
// capture, which lambdas do not support.
var lambda_scope *Scope;
var lambda_seq int;

// Sequential names for the hidden temps of a multi-assignment (`_$m<N>`).
var multi_assign_seq int = 0;

// Sequential names for select's hidden temps and a generator's hidden
// function (`_$s<N>` / `_$gen<N>`); one counter keeps every hidden name in
// a compilation distinct.
var gen_seq int = 0;
var try_head *Node;
var try_tail *Node;

// A bare unknown name: the closest variable (any enclosing scope, then
// globals) or function. Variables win ties because they are in scope here.
fn suggest_name(name str) str {
	var s Sugg;
	s.best_d = 3;
	var sc *Scope = scope_root;
	while (sc as i64 != 0) {
		var vs *VarScope = sc.vars;
		while (vs as i64 != 0) {
			sugg_try(&s, name, vs.name);
			vs = vs.next;
		}
		sc = sc.next;
	}
	var g *Var = global_vars;
	while (g as i64 != 0) {
		sugg_try(&s, name, g.name);
		g = g.next;
	}
	var f *Func = all_funcs;
	while (f as i64 != 0) {
		sugg_try(&s, name, f.name);
		f = f.next;
	}
	return s.best;
}

struct LamCap {
	next  *LamCap,
	outer *Var,
	off   i64,
}

var lam_cap_head *LamCap;
var lam_cap_tail *LamCap;
var lam_cap_size i64 = 8;
var lam_env *Var;
var lam_capturing bool = false;
var need_arena bool = false;
// Generator rewrite state, live only while one function's body is being
// parsed. cur_gen_ret is the function's return type when it is a generator
// candidate (*Gen(T) -- set before the body so `yield` can be recognized),
// gen_yields_seen records whether the body actually contained a `yield`
// (a Gen-returning function without one is an ordinary factory and is left
// alone), and gen_g_var is the hidden `_$g` parameter the yield rewrites
// reference, created on first use.
var cur_gen_ret *Type;
var gen_yields_seen bool;
var gen_g_var *Var;

// Typed block expressions (`T { ...; super v; }`) desugar to an
// immediately-called hidden function like a lambda, but unlike a lambda
// they may read outer locals: each one becomes a hidden by-value parameter
// the first time it is referenced, so the block only ever sees a copy
// (readonly by construction, no separate enforcement needed). `capturing`
// gates this behavior onto typed blocks only -- a plain lambda nested
// inside one still rejects captures, same as today.
struct Capture;
struct Capture {
	next   *Capture,
	outer  *Var,
	hidden *Var,
}
var capturing bool;
var cap_head *Capture;
var cap_tail *Capture;
var cap_n int;
var cap_rwords int;
var cap_stack_slot int;

// Finds or creates the hidden parameter that carries `v`'s value into the
// typed block currently being parsed (`cur_func` is that block's hidden
// Func). Mirrors the register-word/stack-spill bookkeeping in parse_func's
// parameter loop -- captures are just parameters discovered incrementally
// instead of all upfront.
fn capture_get_or_add(v *Var, p i64) *Var {
	var c *Capture = cap_head;
	while (c as i64 != 0) {
		if (c.outer as i64 == v as i64) { return c.hidden; }
		c = c.next;
	}
	var b Buf;
	fmt_str(&b, "_$cap");
	fmt_i64(&b, cap_n as i64);
	var hname str = buf_str(&b);
	var hv *Var = declare_var(hname, v.ty, p);
	var is2word bool = is_aggregate(v.ty) && v.ty.size > 8 && v.ty.size <= 16;
	if (is2word) { cap_rwords = cap_rwords + 2; } else { cap_rwords = cap_rwords + 1; }
	hv.by_ref = is_aggregate(v.ty) && abi_by_ref(v.ty.size);
	if (cap_rwords > abi_n_arg_regs() || cap_n >= abi_n_arg_regs()) {
		if (is2word) { error_at(p, "a captured str or struct here would not fit in the argument registers"); }
		hv.arg_stack = true;
		hv.no_reg = true;
		hv.offset = (16 + 8 * cap_stack_slot) as int;
		cap_stack_slot = cap_stack_slot + 1;
		cur_func.n_stack_args = cur_func.n_stack_args + 1;
	}
	set_func_param(cur_func, cap_n, hv);
	var nc *Capture = arena_alloc(sizeof(Capture), 8) as *Capture;
	nc.outer = v;
	nc.hidden = hv;
	if (cap_head as i64 == 0) { cap_head = nc; } else { cap_tail.next = nc; }
	cap_tail = nc;
	cap_n = cap_n + 1;
	if (cap_n > 14) { error_at(p, "too many captured variables (at most 14)"); }
	return hv;
}

// Set while parsing the body of a `defer`: return, break and continue are
// rejected there, because codegen runs defer bodies while unwinding and
// another return would re-enter the same defer forever.
var in_defer_body bool = false;

// Set while parsing a comprehension's for-clause: the clause's own `if`
// must not be mistaken for a ternary (`x if y else z`), which would
// swallow `[f(x) for x in xs if cond]`'s condition filter.
var in_comp_clause bool = false;

// Set while parsing an interpolation's expression: a `${x=}` debug part
// lexes a TK_FMTSPEC("=") token after the expression, and parse_assign
// must not consume it as an assignment operator (tok_eq compares text).
var in_interp bool = false;

// The parser recurses on nested parentheses, unary prefixes, assignments
// and blocks; each recursion is counted here and capped, so a hostile
// input overflows the C stack instead of the compiler's heap.
var parse_depth int = 0;

fn parse_enter(t **Token) {
	parse_depth = parse_depth + 1;
	if (parse_depth > 1024) {
		error_at((*t).pos, "code is nested too deeply");
	}
}

fn parse_leave() {
	parse_depth = parse_depth - 1;
}

// Set when an interpolated string is desugared; parse() imports
// std/fmt.qela at the next top-level splice point.
var need_fmt bool = false;

// Set when a `~` dynamic local is parsed; parse() imports std/dyn.qela at
// the next top-level splice point, same as need_fmt.
var need_dyn bool = false;

var need_interp bool = false;
var opt_global_interpreted bool = false;
var opt_global_jit bool = false;

// ── top-level asm and the entry point ──

// `asm { ... }` bytes land at the start of the code segment, before any
// function; `entry name;` picks the ELF entry and suppresses the default
// call-main stub. Neither is OS-specific: the first is raw bytes at a
// known place, the second generalizes "main is the entry".
var top_asm_head *Node;
var top_asm_tail *Node;
var entry_name str;

fn find_global(name str) *Var {
	var v *Var = global_vars;
	while (v as i64 != 0) {
		if (str_eq(v.name, name)) { return v; }
		v = v.next;
	}
	return null;
}

fn parse_top_asm(t **Token) {
	*t = (*t).next;
	tok_expect(t, "{");
	var head Node;
	var tail *Node = &head;
	while (!tok_eq(*t, "}")) {
		if (tail as i64 != &head as i64) { tok_expect(t, ","); }
		var a *Node = parse_assign(t);
		if (a.kind != ND_ASMREF) {
			var cv ComptimeVal = comptime_eval(a);
			if (cv.kind != CV_INT || cv.num < 0) { error_at(a.pos, "top-level asm operand must be a constant"); }
			a.kind = ND_NUM;
			a.val = cv.num;
		}
		tail.next = a;
		tail = a;
	}
	tok_expect(t, "}");
	tok_expect(t, ";");
	if (top_asm_tail as i64 == 0) { top_asm_head = head.next; }
	else { top_asm_tail.next = head.next; }
	top_asm_tail = tail;
}

fn parse_entry(t **Token) {
	*t = (*t).next;
	if ((*t).kind != TK_IDENT) { error_at((*t).pos, "entry needs a function name"); }
	entry_name = (*t).text;
	*t = (*t).next;
	tok_expect(t, ";");
}

// ── macros ──

var macro_list *Macro;
var macro_tail *Macro;

fn macro_find(name str) *Macro {
	var m *Macro = macro_list;
	while (m as i64 != 0) {
		if (str_eq(m.name, name)) { return m; }
		m = m.next;
	}
	return null;
}

fn macro_param(m *Macro, i int) *Var {
	if (i == 0) { return m.p0; }
	if (i == 1) { return m.p1; }
	if (i == 2) { return m.p2; }
	if (i == 3) { return m.p3; }
	if (i == 4) { return m.p4; }
	return m.p5;
}

// A parameter is a placeholder local: findable by name in the scope while
// the body parses, but never a real local or global (a call replaces every
// reference before typing).
fn macro_decl_param(name str, pos i64) *Var {
	var v *Var = arena_alloc(sizeof(Var), 8) as *Var;
	v.name = name;
	v.ty = null;
	v.pos = pos;
	var vsc *VarScope = arena_alloc(sizeof(VarScope), 8) as *VarScope;
	vsc.next = scope_root.vars;
	vsc.name = name;
	vsc.varp = v;
	vsc.pos = pos;
	scope_root.vars = vsc;
	return v;
}

fn parse_macro(t **Token) {
	*t = (*t).next;
	if ((*t).kind != TK_IDENT) { error_at((*t).pos, "macro needs a name"); }
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;
	if (macro_find(name) as i64 != 0) { error_at(p, "macro redefinition"); }
	enter_scope();
	var m *Macro = arena_alloc(sizeof(Macro), 8) as *Macro;
	m.name = name;
	m.pos = p;
	tok_expect(t, "(");
	var np int = 0;
	if (!tok_eq(*t, ")")) {
		while (true) {
			if (np >= 6) { error_at((*t).pos, "too many macro parameters"); }
			if ((*t).kind != TK_IDENT) { error_at((*t).pos, "macro parameter must be an identifier"); }
			var pn str = (*t).text;
			var pp i64 = (*t).pos;
			*t = (*t).next;
			var pv *Var = macro_decl_param(pn, pp);
			if (np == 0) { m.p0 = pv; }
			else if (np == 1) { m.p1 = pv; }
			else if (np == 2) { m.p2 = pv; }
			else if (np == 3) { m.p3 = pv; }
			else if (np == 4) { m.p4 = pv; }
			else { m.p5 = pv; }
			np = np + 1;
			if (tok_consume(t, ",")) { continue; }
			break;
		}
	}
	tok_expect(t, ")");
	tok_expect(t, "=");
	m.body = parse_assign(t);
	tok_expect(t, ";");
	leave_scope();
	m.nparams = np;
	if (macro_tail as i64 == 0) { macro_list = m; }
	else { macro_tail.next = m; }
	macro_tail = m;
}

var type_vars [10]*Type;
var ntype_vars int;

struct VarScope {
	next *VarScope,
	name str,
	varp *Var,
	pos  i64,
}

struct Scope {
	next *Scope,
	vars *VarScope,
}

fn enter_scope() {
	var s *Scope = arena_alloc(sizeof(Scope), 8) as *Scope;
	s.next = scope_root;
	scope_root = s;
}

fn leave_scope() { scope_root = scope_root.next; }

fn find_var(name str) *Var {
	var s *Scope = scope_root;
	while (s as i64 != 0) {
		var vs *VarScope = s.vars;
		while (vs as i64 != 0) {
			if (str_eq(vs.name, name)) { return vs.varp; }
			vs = vs.next;
		}
		s = s.next;
	}
	return null;
}

fn declare_var(name str, ty *Type, pos i64) *Var {
	var vs *VarScope = scope_root.vars;
	while (vs as i64 != 0) {
		if (str_eq(vs.name, name)) {
			// Attach the previous declaration's position so the
			// error points at both spots, like Rust/Clang.
			diag_secondary(vs.pos, "previous declaration here");
			var b Buf;
			fmt_str(&b, "redeclaration of '");
			fmt_str(&b, name);
			fmt_str(&b, "'");
			error_at(pos, buf_str(&b));
		}
		vs = vs.next;
	}
	// Shadow check: same name in an outer scope. We only warn when the
	// outer scope is strictly outside the current one — params and locals
	// can reuse the same name, but a local that hides a param is worth
	// pointing out. Globals are exempted: a local that happens to share
	// a global's name is the user's choice, and warning would be noise.
	if (cur_func as i64 != 0) {
		var s *Scope = scope_root.next;
		var shadowed_pos i64 = -1;
		while (s as i64 != 0) {
			var ovs *VarScope = s.vars;
			while (ovs as i64 != 0) {
				if (str_eq(ovs.name, name) && !ovs.varp.is_global) {
					shadowed_pos = ovs.pos;
					break;
				}
				ovs = ovs.next;
			}
			if (shadowed_pos != -1) { break; }
			s = s.next;
		}
		if (shadowed_pos != -1) {
			diag_secondary(shadowed_pos, "previous declaration was here");
			var sb Buf;
			fmt_str(&sb, "variable '");
			fmt_str(&sb, name);
			fmt_str(&sb, "' shadows an outer one");
			warn_at(pos, buf_str(&sb));
		}
	}
	var v *Var = arena_alloc(sizeof(Var), 8) as *Var;
	v.name = name;
	v.ty = ty;
	v.pos = pos;
	if (cur_func as i64 != 0) {
		v.next = cur_func.locals;
		cur_func.locals = v;
	} else {
		// Globals keep declaration order in the chain: layout_globals
		// walks it to assign .data/.bss slots, and a layout that ran
		// backwards made every global address sit on top of its
		// neighbour's slot from the reader's point of view (kb_tail
		// resolving to kb_head). Declaration order is also what
		// BOOTSTRAP.md promises for output.
		v.is_global = true;
		if (global_vars_tail as i64 == 0) { global_vars = v; }
		else { global_vars_tail.next = v; }
		global_vars_tail = v;
	}
	var vsc *VarScope = arena_alloc(sizeof(VarScope), 8) as *VarScope;
	vsc.name = name;
	vsc.varp = v;
	vsc.pos = pos;
	if (cur_func as i64 != 0) {
		vsc.next = scope_root.vars;
		scope_root.vars = vsc;
	} else {
		var root *Scope = scope_root;
		while (root.next as i64 != 0) { root = root.next; }
		vsc.next = root.vars;
		root.vars = vsc;
	}
	return v;
}

// ── token helpers ──

fn tok_eq(t *Token, text str) bool {
	return str_eq(t.text, text);
}

fn tok_expect(t **Token, text str) {
	if (!tok_eq(*t, text)) {
		var b Buf;
		fmt_str(&b, "expected '");
		fmt_str(&b, text);
		fmt_str(&b, "', found '");
		if ((*t).kind == TK_EOF) { fmt_str(&b, "end of file"); }
		else { fmt_str(&b, (*t).text); }
		fmt_str(&b, "'");
		error_at((*t).pos, buf_str(&b));
	}
	*t = (*t).next;
}

fn tok_consume(t **Token, text str) bool {
	if (!tok_eq(*t, text)) { return false; }
	*t = (*t).next;
	return true;
}

fn skip_balanced(t *Token) *Token {
	var depth int = 1;
	while (depth > 0) {
		if (tok_eq(t, "{")) { depth = depth + 1; }
		else if (tok_eq(t, "}")) {
			depth = depth - 1;
			if (depth == 0) { return t; }
		}
		t = t.next;
	}
	return t;
}

fn comptime_truthy(v str) bool {
	if (v.len == 0) { return false; }
	if (str_eq(v, "0")) { return false; }
	if (str_eq(v, "false")) { return false; }
	return true;
}

fn eval_comptime_cond(t **Token) bool {
	var neg bool = false;
	if (tok_eq(*t, "!")) { neg = true; *t = (*t).next; }
	if ((*t).kind != TK_IDENT) { error_at((*t).pos, "expected a comptime variable name"); }
	var name str = (*t).text;
	*t = (*t).next;
	var val str = comptime_get(name);
	if (tok_eq(*t, "==") || tok_eq(*t, "!=")) {
		if (neg) { error_at((*t).pos, "cannot combine '!' with '==' or '!='"); }
		var want_eq bool = tok_eq(*t, "==");
		*t = (*t).next;
		if ((*t).kind != TK_STR) { error_at((*t).pos, "expected a string after == or !="); }
		var rhs str = (*t).sval;
		*t = (*t).next;
		var eq bool = str_eq(val, rhs);
		if (want_eq) { return eq; }
		return !eq;
	}
	var truthy bool = comptime_truthy(val);
	if (neg) { return !truthy; }
	return truthy;
}

// `$if (COND) { ... } $else { ... }` is a token-stream splice, done before
// the real parser ever sees the untaken branch: it rewires the linked
// token list to skip straight from the taken branch's tokens to whatever
// follows the whole `$if`/`$else`, exactly like splice_import already
// rewires tokens for an import. This is why it works at both top level and
// statement level with no separate AST node -- parse_stmt/parse() just see
// a normal token stream afterward.
fn is_comptime_if(t *Token) bool {
	return tok_eq(t, "$") && tok_eq(t.next, "if");
}

fn parse_comptime_if(t **Token) {
	var tok *Token = (*t).next.next;
	tok_expect(&tok, "(");
	var cond bool = eval_comptime_cond(&tok);
	tok_expect(&tok, ")");
	tok_expect(&tok, "{");
	var a_start *Token = tok;
	var a_close *Token = skip_balanced(tok);
	var after_a *Token = a_close.next;
	var rest *Token = after_a;
	var b_start *Token = null;
	var b_close *Token = null;
	if (tok_eq(after_a, "$") && tok_eq(after_a.next, "else")) {
		var btok *Token = after_a.next.next;
		tok_expect(&btok, "{");
		b_start = btok;
		b_close = skip_balanced(btok);
		rest = b_close.next;
	}
	if (cond) {
		if (a_start as i64 == a_close as i64) { *t = rest; return; }
		var p *Token = a_start;
		while (p.next as i64 != a_close as i64) { p = p.next; }
		p.next = rest;
		*t = a_start;
		return;
	}
	if (b_start as i64 != 0) {
		if (b_start as i64 == b_close as i64) { *t = rest; return; }
		var p *Token = b_start;
		while (p.next as i64 != b_close as i64) { p = p.next; }
		p.next = rest;
		*t = b_start;
		return;
	}
	*t = rest;
}

fn resolve_comptime(t **Token) {
	while (is_comptime_if(*t)) { parse_comptime_if(t); }
}

// ── $flag: compiler flags set in the source ──
//
// `$flag --pie` at the top level (or inside a $if branch, which splices
// its tokens into the same stream) applies the flag to the whole unit --
// the file, its imports and, for `qela .`, every merged project file.
// The directive reads the rest of its line, so it ends at the newline or
// an explicit `;`. An explicit command-line flag wins over the source:
// the source flag is a default the invocation may override.
var flag_pie_cli bool = false;
var flag_backtrace_cli bool = false;
var flag_nobc_cli bool = false;
var flag_base_cli bool = false;

fn parse_source_flag(t **Token) {
	var tok *Token = (*t).next.next;
	var fp i64 = tok.pos;
	var fline int = diag_line_for(diag_file_of(fp), diag_offset_of(fp));
	var b Buf;
	var prev str = "";
	while (tok.kind != TK_EOF && !tok_eq(tok, ";") &&
	    diag_line_for(diag_file_of(tok.pos), diag_offset_of(tok.pos)) == fline) {
		// A lone '-' continues the flag it started: --pie lexes as
		// '-' '-' 'pie', so no space after a dash. Everything else
		// joins with one.
		if (b.n != 0 && !str_eq(prev, "-")) { buf_u8(&b, ' '); }
		fmt_str(&b, tok.text);
		prev = tok.text;
		tok = tok.next;
	}
	if (tok_eq(tok, ";")) { tok = tok.next; }
	*t = tok;
	apply_source_flag(buf_str(&b), fp);
}

fn apply_source_flag(s str, pos i64) {
	if (str_eq(s, "--pie")) {
		if (!flag_pie_cli) { opt_pie = true; }
		return;
	}
	if (str_eq(s, "--backtrace")) {
		if (!flag_backtrace_cli) { opt_backtrace = true; }
		return;
	}
	if (str_eq(s, "--no-bounds-checks")) {
		if (!flag_nobc_cli) { opt_no_bounds = true; }
		return;
	}
	if (s.len > 7 && str_eq(str_slice(s, 0, 7), "--base ")) {
		if (!flag_base_cli) {
			opt_base = parse_addr(str_slice(s, 7, s.len));
			if ((opt_base & 4095) != 0) {
				error_at(pos, "$flag --base must be page aligned");
			}
		}
		return;
	}
	if (s.len > 3 && str_eq(str_slice(s, 0, 2), "-D") && s.ptr[2] == ' ') {
		var rest str = str_slice(s, 3, s.len);
		var i i64 = 0;
		while (i < rest.len && rest.ptr[i] == ' ') { i = i + 1; }
		rest = str_slice(rest, i, rest.len);
		var eq i64 = str_find(rest, ' ');
		if (eq < 0) { eq = rest.len; }
		var eq2 i64 = str_find(rest, '=');
		if (eq2 >= 0 && eq2 < eq) { eq = eq2; }
		var nm str = str_slice(rest, 0, eq);
		var j i64 = eq;
		while (j < rest.len && (rest.ptr[j] == ' ' || rest.ptr[j] == '=')) { j = j + 1; }
		if (j == eq || nm.len == 0) { error_at(pos, "$flag -D needs NAME=VALUE"); }
		comptime_set(nm, str_slice(rest, j, rest.len));
		return;
	}
	error_at(pos, "$flag: unknown flag (allowed: --pie, --backtrace, --no-bounds-checks, --base ADDR, -D NAME=VALUE)");
}

// ── node constructors ──

fn new_node(kind int, pos i64) *Node {
	var n *Node = arena_alloc(sizeof(Node), 8) as *Node;
	n.kind = kind;
	n.pos = pos;
	return n;
}

fn num_node(v i64, pos i64) *Node {
	var n *Node = new_node(ND_NUM, pos);
	n.val = v;
	return n;
}

fn bin_node(kind int, lhs *Node, rhs *Node, pos i64) *Node {
	var n *Node = new_node(kind, pos);
	n.lhs = lhs;
	n.rhs = rhs;
	return n;
}

// ── strlit table ──

var strlist_head *StrLit;
var strlist_tail *StrLit;
var nstrs int = 0;

fn add_str_null() int {
	var lit *StrLit = arena_alloc(sizeof(StrLit), 8) as *StrLit;
	lit.id = nstrs;
	nstrs = nstrs + 1;
	if (strlist_tail as i64 == 0) { strlist_head = lit; }
	else { strlist_tail.next = lit; }
	strlist_tail = lit;
	lit.nullhdr = true;
	return lit.id;
}

fn add_str(s str) int {
	// Identical literals share one pool entry: the bytes and their
	// {ptr, len} header are emitted once and every site references the
	// same id. A missing-$bytes entry never dedups (its null header is
	// site-specific), which is why add_str_null above is its own path.
	var lit *StrLit = strlist_head;
	while (lit as i64 != 0) {
		if (!lit.nullhdr && lit.s.len == s.len && str_eq(lit.s, s)) { return lit.id; }
		lit = lit.next;
	}
	lit = arena_alloc(sizeof(StrLit), 8) as *StrLit;
	lit.s = s;
	lit.id = nstrs;
	nstrs = nstrs + 1;
	if (strlist_tail as i64 == 0) { strlist_head = lit; }
	else { strlist_tail.next = lit; }
	strlist_tail = lit;
	return lit.id;
}

//
// Forward-declared at the top for mutual recursion.
// All functions are mutually visible after the full token stream is parsed.
//
// The ordering below ensures that parse_type comes first (used by everything),
// then expression parsers, then statements, then top-level declarations.>

// ── type parser ──

fn parse_type(t **Token) *Type {
	if (tok_consume(t, "*")) {
		if (tok_consume(t, "volatile")) { return type_ptr_volatile(parse_type(t)); }
		return type_ptr(parse_type(t));
	}
	// `~` names the dynamic type: a parameter, field, return or plain var
	// of this type holds a DynVal and is checked at runtime instead of
	// compile time (see type.qela's `~` section). `var ~n = expr` is the
	// other, older spelling of a dynamic local.
	if (tok_eq(*t, "~")) {
		*t = (*t).next;
		type_dynval();
		need_dyn = true;
		return ty_dynval_cache;
	}
	if (tok_eq(*t, "[")) {
		*t = (*t).next;
		if (tok_consume(t, "]")) {
			var base *Type = parse_type(t);
			return type_slice(base);
		}
		if ((*t).kind != TK_NUM) { error_at((*t).pos, "expected array length"); }
		var lp i64 = (*t).pos;
		var len i64 = (*t).val;
		*t = (*t).next;
		tok_expect(t, "]");
		var base *Type = parse_type(t);
		if (len <= 0) { error_at(lp, "an array length must be positive"); }
		if (base.size != 0 && len > (0x7fffffff as i64) / (base.size as i64)) {
			error_at(lp, "array is too large");
		}
		return type_array(base, len);
	}
	if ((*t).kind != TK_IDENT) {
		if (tok_eq(*t, "fn")) {
			*t = (*t).next;
			tok_expect(t, "(");
			var t0 *Type = fn_type_new(ty_void);
			var head Member;
			var tail *Member = &head;
			var np int = 0;
			while (!tok_eq(*t, ")")) {
				if (np >= 6) { error_at((*t).pos, "a function type takes at most 6 parameters"); }
				var pp i64 = (*t).pos;
				var pt *Type = parse_type(t);
				if (pt.size > 8) {
					error_at(pp, "a function type parameter must fit in one word");
				}
				var m *Member = member_alloc();
				m.ty = pt;
				tail.next = m;
				tail = m;
				np = np + 1;
				if (!tok_eq(*t, ")")) { tok_expect(t, ","); }
			}
			*t = (*t).next;
			t0.members = head.next;
			t0.base = parse_type(t);
			return t0;
		}
		var b Buf;
		fmt_str(&b, "expected a type name, found '");
		if ((*t).kind == TK_EOF) { fmt_str(&b, "end of file"); }
		else { fmt_str(&b, (*t).text); }
		fmt_str(&b, "'");
		error_at((*t).pos, buf_str(&b));
	}
	var i int = 0;
	while (i < ntype_vars) {
		if (str_eq(type_vars[i].name, (*t).text)) {
			var tv *Type = type_vars[i];
			*t = (*t).next;
			return tv;
		}
		i = i + 1;
	}
	var tm *Tmpl = tmpl_find((*t).text);
	if (tm as i64 != 0) {
		*t = (*t).next;
		tok_expect(t, "(");
		gen_errpos = (*t).pos;
		var a0 *Type = parse_type(t);
		var a1 *Type = null;
		var a2 *Type = null;
		var a3 *Type = null;
		if (tm.nparams > 1) { tok_expect(t, ","); a1 = parse_type(t); }
		if (tm.nparams > 2) { tok_expect(t, ","); a2 = parse_type(t); }
		if (tm.nparams > 3) { tok_expect(t, ","); a3 = parse_type(t); }
		tok_expect(t, ")");
		return generic_instance(tm, a0, a1, a2, a3);
	}
	var ty *Type = type_lookup((*t).text);
	if (ty as i64 == 0) {
		var ub Buf;
		fmt_str(&ub, "unknown type '");
		fmt_str(&ub, (*t).text);
		fmt_str(&ub, "'");
		err_soft_suggest((*t).pos, buf_str(&ub), suggest_type((*t).text));
		*t = (*t).next;
		return type_poison();
	}
	*t = (*t).next;
	return ty;
}

// struct Name(T) / enum Name(T, U): bind the parameters as type variables for
// the duration of the body, and hand back the template to fill in. `T: str`
// constrains the argument to that type or an implicit widening of it.
fn parse_tmpl_params(t **Token, name str, p i64) *Tmpl {
	if (!tok_eq(*t, "(")) { return null; }
	*t = (*t).next;
	var tm *Tmpl = arena_alloc(sizeof(Tmpl), 8) as *Tmpl;
	tm.name = name;
	while (!tok_eq(*t, ")")) {
		if (tm.nparams > 0) { tok_expect(t, ","); }
		if (tm.nparams == 4) { error_at((*t).pos, "at most four type parameters"); }
		var pn str = (*t).text;
		*t = (*t).next;
		if (ntype_vars == 10) { error_at((*t).pos, "too many type variables in scope"); }
		var tv *Type = type_new_var(pn);
		type_vars[ntype_vars] = tv;
		ntype_vars = ntype_vars + 1;
		var ct *Type = null;
		if (tok_consume(t, ":")) { ct = parse_type(t); }
		if (tm.nparams == 0) { tm.tv0 = tv; tm.ct0 = ct; }
		else if (tm.nparams == 1) { tm.tv1 = tv; tm.ct1 = ct; }
		else if (tm.nparams == 2) { tm.tv2 = tv; tm.ct2 = ct; }
		else { tm.tv3 = tv; tm.ct3 = ct; }
		tm.nparams = tm.nparams + 1;
	}
	tok_expect(t, ")");
	if (tm.nparams == 0) { error_at(p, "a parameterized type needs a parameter"); }
	tm.proto = arena_alloc(sizeof(Type), 8) as *Type;
	tm.proto.name = name;
	tmpl_add(tm);
	return tm;
}

// ── expression parser ──

fn call_args(t **Token, n *Node) *Node {
	tok_expect(t, "(");
	var nargs int = 0;
	while (!tok_eq(*t, ")")) {
		if (nargs > 0) { tok_expect(t, ","); }
		var a *Node = parse_assign(t);
		var tail **Node = &n.args;
		while (*tail as i64 != 0) { tail = &(*tail).next; }
		*tail = a;
		nargs = nargs + 1;
	}
	tok_expect(t, ")");
	n.nargs = nargs;
	return n;
}

fn parse_bytes(raw str, pos i64) *Node {
	var path str = raw;
	if (raw.len > 0 && raw.ptr[0] != '/') {
		var pb Buf;
		fmt_str(&pb, diag_file_dir(diag_file_of(pos)));
		fmt_str(&pb, raw);
		path = buf_str(&pb);
	}
	var n *Node = new_node(ND_STRLIT, pos);
	if (!file_exists(path)) {
		var wb Buf;
		fmt_str(&wb, "$bytes cannot read '");
		fmt_str(&wb, path);
		fmt_str(&wb, "', embedding an empty slice");
		warn_at(pos, buf_str(&wb));
		n.val = add_str_null() as i64;
		return n;
	}
	n.val = add_str(read_file(path)) as i64;
	return n;
}

// Scans the tokens of a `[...]` literal for a top-level `for` keyword,
// which turns the literal into a comprehension. Brackets, parens and
// braces nest; a `for` inside a lambda body or a nested literal does not
// count. Strings and comments are single tokens already, so they cannot
// fake a keyword.
fn arrlit_has_for(t *Token) *Token {
	var depth i64 = 1;
	while (t.kind != TK_EOF) {
		if (t.kind == TK_PUNCT) {
			if (str_eq(t.text, "[") || str_eq(t.text, "(") || str_eq(t.text, "{")) {
				depth = depth + 1;
			} else if (str_eq(t.text, "]") || str_eq(t.text, ")") || str_eq(t.text, "}")) {
				depth = depth - 1;
				if (depth == 0) { return null; }
			}
		} else if (t.kind == TK_KW && str_eq(t.text, "for") && depth == 1) {
			return t;
		}
		t = t.next;
	}
	return null;
}

// `[<expr> for <var> in <coll> if <cond>]`: the element is parsed last
// (after the loop variable is in scope), then the whole thing becomes an
// ND_ARRCOMP whose `.init` chain zeroes a hidden Vec, hoists the
// collection and runs the collection loop, and whose `.lhs` is
// vec_view(&_$v). The Vec is arena-backed, like every Vec: the result
// lives for the program.
fn parse_comprehension(t **Token, p i64, first *Token, ft *Token) *Node {
	*t = ft;
	*t = (*t).next;
	if ((*t).kind != TK_IDENT) { error_at((*t).pos, "expected a loop variable in a comprehension"); }
	var name str = (*t).text;
	var np i64 = (*t).pos;
	*t = (*t).next;
	tok_expect(t, "in");
	in_comp_clause = true;
	var coll *Node = parse_assign(t);
	var cond_start *Token = null;
	if (tok_consume(t, "if")) { cond_start = *t; }
	in_comp_clause = false;

	add_type(coll);
	var cty *Type = coll.ty;
	if (cty.kind == TY_PTR) { cty = cty.base; }
	var elem *Type = null;
	if (cty.kind == TY_ARRAY || cty.kind == TY_SLICE) { elem = cty.base; }
	else if (cty.kind == TY_STRUCT && cty.tmpl as i64 != 0 && str_eq(cty.tmpl.name, "Gen")) {
		elem = cty.ga0;
	}
	if (elem as i64 == 0) {
		// The <prefix>_iter / <prefix>_view protocol, like for-in.
		var pit *Node = iter_protocol_call(coll, np);
		if (pit as i64 != 0) {
			add_type(pit);
			coll = pit;
			elem = gen_elem_of(coll.ty);
			if (elem as i64 == 0 && coll.ty.kind == TY_SLICE) { elem = coll.ty.base; }
		}
	}
	if (elem as i64 == 0) {
		error_at(np, "a comprehension needs an array, a slice, a string, a Map, or a generator");
	}
	if (elem.kind == TY_VOID) { error_at(np, "a comprehension cannot iterate a void element"); }

	enter_scope();
	var v *Var = declare_var(name, elem, np);
	// The condition filter is parsed now too: it references the loop
	// variable, which is in scope from here on.
	var cond *Node = null;
	if (cond_start as i64 != 0) {
		*t = cond_start;
		cond = parse_assign(t);
	}
	// The element expression: the loop variable is in scope now. Its type
	// fixes the hidden Vec's element type, which must be known at parse
	// time -- so, like for-in's collection, an element that calls a
	// function declared below this point cannot be typed here.
	*t = first;
	var elem_expr *Node = parse_assign(t);
	// `[k: v for ...]`: a map comprehension. The key is a str, the value
	// expression follows the colon; the hidden Map is built instead of a
	// Vec and the expression's value is the Map itself.
	var val_expr *Node = null;
	if (tok_consume(t, ":")) {
		val_expr = parse_assign(t);
	}
	add_type(elem_expr);
	if (elem_expr.ty.kind == TY_VOID) { error_at(np, "a comprehension element cannot be void"); }
	// The for-clause was consumed before the element; re-walk the token
	// stream past it and take the close bracket here: the caller is
	// bypassed entirely. The walk tracks nesting, so a collection that is
	// itself a literal (`[x * 2 for x in [1, 2, 3]]`) stops at the outer
	// bracket, not the inner one.
	*t = ft;
	var wd i64 = 1;
	while (true) {
		var wt *Token = *t;
		if (wt.kind == TK_PUNCT) {
			if (str_eq(wt.text, "]")) {
				wd = wd - 1;
				if (wd == 0) { break; }
			} else if (str_eq(wt.text, "[") || str_eq(wt.text, "(") || str_eq(wt.text, "{")) {
				wd = wd + 1;
			}
		}
		*t = wt.next;
	}
	tok_expect(t, "]");

	// The hidden Vec (or Map) carries the element type.
	var tm *Tmpl = tmpl_find("Vec");
	if (tm as i64 == 0) { error_at(p, "a comprehension needs 'import std/vec.qela'"); }
	var vty *Type = null;
	if (val_expr as i64 == 0) {
		vty = generic_instance(tm, elem_expr.ty, null, null, null);
	} else {
		add_type(val_expr);
		if (elem_expr.ty as i64 != type_str() as i64) {
			error_at(np, "a map comprehension's key must be a string");
		}
		var mt *Tmpl = tmpl_find("Map");
		if (mt as i64 == 0) { error_at(p, "a map comprehension needs 'import std/map.qela'"); }
		vty = generic_instance(mt, val_expr.ty, null, null, null);
	}
	var vv *Var = declare_var(hidden_name("v"), vty, np);

	var chain_head Node;
	var chain_tail *Node = &chain_head;
	var zv *Node = new_node(ND_ZERO, np);
	zv.varp = vv;
	var zs *Node = new_node(ND_EXPRSTMT, np);
	zs.lhs = zv;
	chain_tail.next = zs;
	chain_tail = zs;

	var is_gen bool = false;
	var gty *Type = coll.ty;
	if (gty.kind == TY_PTR) { gty = gty.base; }
	if (gen_elem_of(gty) as i64 != 0) { is_gen = true; }

	var collref *Node = coll;
	if (coll.kind != ND_VAR) {
		var cv *Var = declare_var(hidden_name("c"), coll.ty, np);
		var clhs *Node = new_node(ND_VAR, np);
		clhs.varp = cv;
		var ca *Node = new_node(ND_EXPRSTMT, np);
		ca.lhs = bin_node(ND_ASSIGN, clhs, coll, np);
		chain_tail.next = ca;
		chain_tail = ca;
		var cr *Node = new_node(ND_VAR, np);
		cr.varp = cv;
		collref = cr;
	}

	// The push call: vec_push(&_$v, elem_expr), or map_put(&_$m, k, v)
	// for a map comprehension.
	var pv *Node = new_node(ND_ADDR, np);
	var pvv *Node = new_node(ND_VAR, np);
	pvv.varp = vv;
	pv.lhs = pvv;
	var pc *Node = new_node(ND_CALL, np);
	pc.args = pv;
	if (val_expr as i64 == 0) {
		pc.name = "vec_push";
		pv.next = elem_expr;
		pc.nargs = 2;
	} else {
		pc.name = "map_put";
		pv.next = elem_expr;
		elem_expr.next = val_expr;
		pc.nargs = 3;
	}
	var pstmt *Node = new_node(ND_EXPRSTMT, np);
	pstmt.lhs = pc;

	var f *Node = new_node(ND_FOR, np);
	if (is_gen) {
		// while (gen_next(&g, &x)) { push }
		var xv *Node = new_node(ND_VAR, np);
		xv.varp = v;
		var gn *Node = new_node(ND_CALL, np);
		gn.name = "gen_next";
		var g1 *Node = collref;
		var g2 *Node = new_node(ND_ADDR, np);
		g2.lhs = xv;
		gn.args = g1;
		g1.next = g2;
		gn.nargs = 2;
		f.cond = gn;
		if (cond as i64 != 0) { f.body = stmt_if_expr(cond, pstmt, np); }
		else { f.body = pstmt; }
	} else {
		// for _$i in 0..coll.len { x = coll[_$i]; ... }
		var iv *Var = declare_var(hidden_name("i"), type_lookup("int"), np);
		var i0 *Node = new_node(ND_VAR, np);
		i0.varp = iv;
		var init *Node = new_node(ND_EXPRSTMT, np);
		init.lhs = bin_node(ND_ASSIGN, i0, num_node(0, np), np);
		f.init = init;
		var i1 *Node = new_node(ND_VAR, np);
		i1.varp = iv;
		var ml *Node = new_node(ND_MEMBER, np);
		ml.lhs = collref;
		ml.name = "len";
		f.cond = bin_node(ND_LT, i1, ml, np);
		var i2 *Node = new_node(ND_VAR, np);
		i2.varp = iv;
		var st *Node = bin_node(ND_OPASSIGN, i2, num_node(1, np), np);
		st.val = ND_ADD;
		f.step = st;
		var i3 *Node = new_node(ND_VAR, np);
		i3.varp = iv;
		var idx *Node = bin_node(ND_INDEX, collref, i3, np);
		var xa *Node = new_node(ND_EXPRSTMT, np);
		var xv2 *Node = new_node(ND_VAR, np);
		xv2.varp = v;
		xa.lhs = bin_node(ND_ASSIGN, xv2, idx, np);
		if (cond as i64 != 0) { xa.next = stmt_if_expr(cond, pstmt, np); }
		else { xa.next = pstmt; }
		var b1 *Node = new_node(ND_BLOCK, np);
		b1.body = xa;
		f.body = b1;
	}
	chain_tail.next = f;
	chain_tail = f;

	leave_scope();

	var n *Node = new_node(ND_ARRCOMP, p);
	n.init = chain_head.next;
	if (val_expr as i64 == 0) {
		var vv2 *Node = new_node(ND_VAR, np);
		vv2.varp = vv;
		var av *Node = new_node(ND_ADDR, np);
		av.lhs = vv2;
		var vc *Node = new_node(ND_CALL, np);
		vc.name = "vec_view";
		vc.args = av;
		vc.nargs = 1;
		n.lhs = vc;
		n.ty = type_slice(elem_expr.ty);
	} else {
		// A map comprehension's value is the Map itself (24 bytes, one
		// struct copy).
		var mv *Node = new_node(ND_VAR, np);
		mv.varp = vv;
		n.lhs = mv;
		n.ty = vty;
	}
	return n;
}

// A tiny if-statement builder: if (cond) { body } — used by the
// comprehension desugar, which parses its pieces by hand.
fn stmt_if_expr(cond *Node, body *Node, pos i64) *Node {
	var ifn *Node = new_node(ND_IF, pos);
	ifn.cond = cond;
	var blk *Node = new_node(ND_BLOCK, pos);
	blk.body = body;
	ifn.then = blk;
	return ifn;
}

fn parse_primary(t **Token) *Node {
	if (tok_eq(*t, "[")) {
		var p i64 = (*t).pos;
		*t = (*t).next;
		// A comprehension: `[<expr> for <var> in <coll> if <cond>]`. The
		// element expression comes before the loop variable in source, so
		// the for-clause is found by token scan and parsed first -- the
		// variable is in scope by the time the element parses.
		var comp_for *Token = arrlit_has_for(*t);
		if (comp_for as i64 != 0) { return parse_comprehension(t, p, *t, comp_for); }
		var n *Node = new_node(ND_ARRLIT, p);
		var head Node;
		var tail *Node = &head;
		var cnt int = 0;
		while (!tok_eq(*t, "]")) {
			if (cnt > 0) { tok_expect(t, ","); }
			if (tok_eq(*t, "]")) { break; }
			var e *Node = parse_assign(t);
			if (tok_eq(*t, ":")) {
				*t = (*t).next;
				var pair *Node = new_node(ND_FIELD, e.pos);
				pair.lhs = e;
				pair.rhs = parse_assign(t);
				n.kind = ND_MAPLIT;
				e = pair;
			} else if (n.kind == ND_MAPLIT) {
				error_at(e.pos, "every entry of a map literal needs a key");
			}
			tail.next = e;
			tail = e;
			cnt = cnt + 1;
		}
		tok_expect(t, "]");
		n.args = head.next;
		n.nargs = cnt;
		return n;
	}
	if (tok_consume(t, "(")) {
		var n *Node = parse_expr(t);
		tok_expect(t, ")");
		return n;
	}
	// A symbol reference for asm operands: `$name` embeds the absolute
	// address, `$rel name` a rel32 slot, patched when addresses are known.
	if (tok_eq(*t, "$") && tok_eq((*t).next, "bytes") && tok_eq((*t).next.next, "(")) {
		var bp i64 = (*t).pos;
		*t = (*t).next.next.next;
		if ((*t).kind != TK_STR) { error_at((*t).pos, "$bytes needs a path in quotes"); }
		var raw str = (*t).sval;
		*t = (*t).next;
		tok_expect(t, ")");
		return parse_bytes(raw, bp);
	}
	// `$c("expr")`: a compile-time constant. The string is lexed, parsed
	// and folded by eval_const right here, so arithmetic, bit operations,
	// comparisons, sizeof, casts, ternaries and references to constant
	// globals all resolve now and nothing of the expression ships. The
	// folded grammar is exactly what eval_const knows -- no calls, no
	// locals, no strings (for now).
	if (tok_eq(*t, "$") && tok_eq((*t).next, "c") && tok_eq((*t).next.next, "(")) {
		var cp i64 = (*t).pos;
		*t = (*t).next.next.next;
		if ((*t).kind != TK_STR) { error_at((*t).pos, "$c needs an expression in quotes"); }
		var src str = (*t).sval;
		var sp i64 = (*t).pos;
		*t = (*t).next;
		tok_expect(t, ")");
		// Errors inside the snippet report against the same file, at the
		// $c token (the snippet's own offsets land near it).
		var base i64 = cp & ~((1 as i64 << FILE_SHIFT) - 1);
		var toks *Token = lex(src, base);
		var e *Node = parse_assign(&toks);
		if (toks.kind != TK_EOF) { error_at(sp, "trailing tokens after the $c expression"); }
		add_type(e);
		var v i64 = eval_const(e);
		var n *Node = new_node(ND_NUM, sp);
		n.val = v;
		n.ty = ty_i64;
		n.typed = true;
		return n;
	}
	if (tok_consume(t, "$")) {
		var p i64 = (*t).pos;
		if ((*t).kind != TK_IDENT) { error_at((*t).pos, "expected a symbol after '$'"); }
		var sname str = (*t).text;
		*t = (*t).next;
		var n *Node = new_node(ND_ASMREF, p);
		if (str_eq(sname, "le") && (*t).kind == TK_NUM) {
			// `$le N v`: v as N bytes, little-endian -- the opposite of
			// the print-order byte strings a bare constant emits.
			var width i64 = (*t).val;
			*t = (*t).next;
			if ((*t).kind != TK_NUM) { error_at((*t).pos, "$le needs a width then a value"); }
			if (width < 1 || width > 8) { error_at(p, "$le width must be 1..8 bytes"); }
			n.kind = ND_ASMLE;
			n.nargs = width as int;
			n.val = (*t).val;
			*t = (*t).next;
			return n;
		}
		if (str_eq(sname, "abs") && (*t).kind == TK_IDENT) {
			// `$abs name`: the symbol's address as a 32-bit slot, for
			// 32-bit code where the 8-byte `$name` would not fit.
			n.val = 2;
			n.name = (*t).text;
			*t = (*t).next;
			return n;
		}
		if (str_eq(sname, "rel") && (*t).kind == TK_IDENT) {
			n.val = 1;
			n.name = (*t).text;
			*t = (*t).next;
		} else {
			n.val = 0;
			n.name = sname;
		}
		return n;
	}
	if ((*t).kind == TK_NUM) {
		var v i64 = (*t).val;
		var p i64 = (*t).pos;
		*t = (*t).next;
		return num_node(v, p);
	}
	if ((*t).kind == TK_FLOAT) {
		var v i64 = (*t).val;
		var p i64 = (*t).pos;
		*t = (*t).next;
		var n *Node = num_node(v, p);
		n.ty = type_lookup("f64");
		return n;
	}
	if ((*t).kind == TK_STR) {
		var p i64 = (*t).pos;
		var id int = add_str((*t).sval);
		*t = (*t).next;
		var lit *Node = new_node(ND_STRLIT, p);
		lit.val = id as i64;
		if (!tok_eq(*t, "$")) { return lit; }

		// "a=${x}b": the lexer already split the string into literal parts
		// and "$" "{" <expr> "}" runs. The parts are collected and the
		// whole chain becomes one ND_INTERP node, rewritten to fmt calls
		// when types are known.
		need_fmt = true;
		var n *Node = new_node(ND_INTERP, p);
		var fhead Node;
		var ftail *Node = &fhead;
		while (true) {
			var lp *Node = new_node(ND_STRPART, p);
			lp.val = 1;
			lp.lhs = lit;
			ftail.next = lp;
			ftail = lp;

			tok_expect(t, "$");
			tok_expect(t, "{");
			var ep *Node = new_node(ND_STRPART, (*t).pos);
			ep.val = 0;
			var es i64 = (*t).pos;
			in_interp = true;
			ep.lhs = parse_assign(t);
			in_interp = false;
			if ((*t).kind == TK_FMTSPEC) {
				if (str_eq((*t).text, "=")) {
					// `${x=}`: the expression's source text becomes a
					// literal part before the value, so the output reads
					// "x=5". The span runs from the expression's first
					// token to the '=' token, trimmed of surrounding
					// whitespace.
					var eqpos i64 = (*t).pos;
					var fid int = diag_file_of(es);
					var src str = diag_src_of(fid);
					var a i64 = diag_offset_of(es);
					var b i64 = diag_offset_of(eqpos);
					while (a < b && src.ptr[a] == ' ') { a = a + 1; }
					while (b > a && src.ptr[b - 1] == ' ') { b = b - 1; }
					var nm str;
					nm.ptr = src.ptr + a;
					nm.len = b - a;
					var nb Buf;
					fmt_str(&nb, nm);
					fmt_str(&nb, "=");
					var name_part *Node = new_node(ND_STRPART, (*t).pos);
					name_part.val = 1;
					var nl *Node = new_node(ND_STRLIT, (*t).pos);
					nl.val = add_str(buf_str(&nb)) as i64;
					name_part.lhs = nl;
					ftail.next = name_part;
					ftail = name_part;
				} else {
					ep.name = (*t).text;
				}
				*t = (*t).next;
			}
			ftail.next = ep;
			ftail = ep;
			tok_expect(t, "}");

			if ((*t).kind != TK_STR) { error_at((*t).pos, "expected a string part"); }
			var id2 int = add_str((*t).sval);
			var p2 i64 = (*t).pos;
			*t = (*t).next;
			if (!tok_eq(*t, "$")) {
				var last *Node = new_node(ND_STRLIT, p2);
				last.val = id2 as i64;
				var lp2 *Node = new_node(ND_STRPART, p2);
				lp2.val = 1;
				lp2.lhs = last;
				ftail.next = lp2;
				ftail = lp2;
				break;
			}
			var mlit *Node = new_node(ND_STRLIT, p2);
			mlit.val = id2 as i64;
			lit = mlit;
		}
		n.args = fhead.next;
		return n;
	}
	if (tok_consume(t, "true")) { return num_node(1, (*t).pos); }
	if (tok_consume(t, "false")) { return num_node(0, (*t).pos); }
	if (tok_consume(t, "null")) { return num_node(0, (*t).pos); }
	if (tok_consume(t, "comptime")) {
		var p i64 = (*t).pos;
		var n *Node = new_node(ND_COMPTIME, p);
		n.body = parse_block(t);
		return n;
	}
	if (tok_consume(t, "sizeof")) {
		var p i64 = (*t).pos;
		tok_expect(t, "(");
		var ty *Type = parse_type(t);
		tok_expect(t, ")");
		var n *Node = new_node(ND_SIZEOF, p);
		n.typeval = ty;
		return n;
	}
	// `fn (params) { body }` as an expression: an anonymous function.
	if (tok_consume(t, "fn")) {
		var p i64 = (*t).pos;
		if (!tok_eq(*t, "(")) { error_at((*t).pos, "expected '(' after 'fn'"); }
		return parse_lambda(t, p);
	}
	if ((*t).kind == TK_IDENT) {
		var name str = (*t).text;
		var p i64 = (*t).pos;
		var start *Token = *t;
		*t = (*t).next;

		// vec literal: vec[1, 2, 3]. A real variable named `vec` indexed
		// the ordinary way wins when one resolves at parse time.
		if (str_eq(name, "vec") && tok_eq(*t, "[") && find_var("vec") as i64 == 0) {
			*t = (*t).next;
			var n *Node = new_node(ND_VECLIT, p);
			var ahead Node;
			var atail *Node = &ahead;
			while (!tok_eq(*t, "]")) {
				var e *Node = parse_assign(t);
				atail.next = e;
				atail = e;
				n.nargs = n.nargs + 1;
				if (!tok_consume(t, ",")) { break; }
			}
			tok_expect(t, "]");
			n.args = ahead.next;
			return n;
		}

		var named *Type = type_lookup(name);
		// A template name is followed by its arguments, so the whole
		// application has to be read as a type before the dot or the brace.
		if (named as i64 == 0 && tmpl_find(name) as i64 != 0) {
			*t = start;
			named = parse_type(t);
		}

		// enum literal: Name.Variant(...). Anything else followed by a dot
		// is a member access and belongs to parse_postfix.
		if (named as i64 != 0 && named.kind == TY_ENUM && tok_eq(*t, ".")) {
			*t = (*t).next;
			var vname str = (*t).text;
			*t = (*t).next;
			var n *Node = new_node(ND_ENUMLIT, p);
			n.ty = named;
			n.name = vname;
			if (tok_eq(*t, "(")) { call_args(t, n); }
			return n;
		}

		// struct literal: Name{field: val, ...}
		if (named as i64 != 0 && named.kind == TY_STRUCT && tok_eq(*t, "{")) {
			*t = (*t).next;
			var n *Node = new_node(ND_STRUCTLIT, p);
			n.ty = named;
			var fhead Node;
			var ftail *Node = &fhead;
			while (!tok_eq(*t, "}")) {
				if (ftail as i64 != &fhead as i64) { tok_expect(t, ","); }
				if (tok_eq(*t, "}")) { break; }
				if (tok_consume(t, "...")) {
					// `P{...q, b: 2}`: the spread copies q's fields.
					var fld *Node = new_node(ND_FIELD, (*t).pos);
					fld.name = "...";
					fld.lhs = parse_assign(t);
					ftail.next = fld;
					ftail = fld;
					n.nargs = n.nargs + 1;
					continue;
				}
				var fnm str = (*t).text;
				var fpos i64 = (*t).pos;
				*t = (*t).next;
				tok_expect(t, ":");
				var fld *Node = new_node(ND_FIELD, fpos);
				fld.name = fnm;
				fld.lhs = parse_assign(t);
				ftail.next = fld;
				ftail = fld;
				n.nargs = n.nargs + 1;
			}
			tok_expect(t, "}");
			n.args = fhead.next;
			return n;
		}
		// typed block expression: `T { ...; super v; }`, an inline
		// value-producing block desugared to an immediately-called hidden
		// function. Excludes TY_STRUCT: `Name{` is already struct-literal
		// syntax and the two cannot be told apart without deeper lookahead.
		if (named as i64 != 0 && named.kind != TY_STRUCT && tok_eq(*t, "{")) {
			return parse_typed_block(t, p, named);
		}
		// also search type vars for comptime param references
		if (named as i64 == 0) {
			var i int = 0;
			while (i < ntype_vars) {
				if (str_eq(type_vars[i].name, name)) { named = type_vars[i]; break; }
				i = i + 1;
			}
		}
		// type-expression (used as generic argument: f(i64, x))
		if (named as i64 != 0 && !tok_eq(*t, "(") && !tok_eq(*t, ".") && !tok_eq(*t, "{")) {
			var n *Node = new_node(ND_TYPEEXPR, p);
			n.typeval = named;
			return n;
		}

		if (tok_eq(*t, "(")) {
			if (cur_func as i64 != 0 && cur_func.naked && !str_eq(name, "asm") && !str_eq(name, "syscall")) {
				error_at(p, "naked functions cannot call other functions");
			}
			var m *Macro = macro_find(name);
			if (m as i64 != 0) { return macro_call(m, t, p); }
			var kind int = ND_CALL;
			if (str_eq(name, "syscall")) { kind = ND_SYSCALL; }
			if (str_eq(name, "asm")) { kind = ND_ASM; }
			if (str_eq(name, "assert") || str_eq(name, "panic")) { kind = ND_ASSERT; }
			var n *Node = new_node(kind, p);
			n.name = name;
			// If a variable (not a function) of that name exists, this is a
			// call through it; type.qela checks its type and turns it into an
			// indirect call. Functions declared later are not in the table
			// yet, so a bare name is left alone for find_func in type_call.
			var f0 *Func = null;
			if (kind == ND_CALL) {
				var v *Var = find_var(name);
				if (v as i64 != 0) { n.varp = v; }
				else {
					f0 = find_func(name);
					if (f0 as i64 != 0 && f0.nct != 0) { f0 = null; }
				}
			}
			if (f0 as i64 != 0) { call_args_named(t, n, f0); }
			else { call_args(t, n); }
			// panic(message) is assert(false, message): the condition is a
			// constant zero prepended here, so the rest of the pipeline sees
			// one shape only.
			if (kind == ND_ASSERT && str_eq(name, "panic")) {
				var z *Node = num_node(0, p);
				z.next = n.args;
				n.args = z;
				n.nargs = n.nargs + 1;
			}
			return n;
		}

		// variable reference; a function name used as a value is a function
		// address. Resolution is deferred to add_type: functions declared
		// below this point are not in the table while we parse, so the node
		// is always an address and type.qela decides.
		var v *Var = find_var(name);
		if (v as i64 == 0) {
			var fa *Node = new_node(ND_FUNCADDR, p);
			fa.name = name;
			return fa;
		}
		// Lambdas carry no environment: a variable from the enclosing
		// function is a capture and must be an error, so resolve it against
		// the lambda's own scope chain (globals and the lambda's own
		// parameters and locals are fine).
		if (lambda_scope as i64 != 0 && !v.is_global) {
			var found bool = false;
			var s *Scope = scope_root;
			while (s as i64 != 0) {
				var vs *VarScope = s.vars;
				while (vs as i64 != 0) {
					if (vs.varp as i64 == v as i64) { found = true; }
					vs = vs.next;
				}
				if (s as i64 == lambda_scope as i64) { break; }
				s = s.next;
			}
			if (!found) {
				if (lam_capturing) {
					return lambda_capture_node(v, p);
				} else if (capturing) {
					v = capture_get_or_add(v, p);
				} else {
					var mb Buf;
					fmt_str(&mb, "a lambda cannot capture '");
					fmt_str(&mb, name);
					fmt_str(&mb, "' (no closures)");
					error_at(p, buf_str(&mb));
				}
			}
		}
		var n *Node = new_node(ND_VAR, p);
		n.varp = v;
		return n;
	}
	error_at((*t).pos, "expected expression");
	return null;
}

fn parse_postfix(t **Token) *Node {
	var n *Node = parse_primary(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_eq(*t, "?")) {
			*t = (*t).next;
			n = try_expand(n, p);
			continue;
		}
		if (tok_consume(t, "[")) {
			var lo *Node = null;
			if (!tok_eq(*t, "..")) { lo = parse_expr(t); }
			if (tok_consume(t, "..")) {
				var s *Node = new_node(ND_SLICE, p);
				s.lhs = n;
				s.rhs = lo;
				if (!tok_eq(*t, "]")) { s.then = parse_expr(t); }
				tok_expect(t, "]");
				n = s;
				continue;
			}
			tok_expect(t, "]");
			n = bin_node(ND_INDEX, n, lo, p);
			continue;
		}
		if (tok_consume(t, ".")) {
			var mpos i64 = (*t).pos;
			var mname str = (*t).text;
			*t = (*t).next;
			// x.foo(args) is call sugar: foo(x, args). No overloading exists
			// (find_func is a plain name lookup), so this is a pure AST
			// rewrite at parse time -- the ordinary call path (type_call)
			// resolves and type-checks it exactly like foo(x, args) would.
			// The dotcall flag lets type_call match the receiver to a
			// pointer first parameter by taking its address (or derefing
			// a pointer receiver for a by-value first parameter).
			if (tok_eq(*t, "(")) {
				if (cur_func as i64 != 0 && cur_func.naked) {
					error_at(mpos, "naked functions cannot call other functions");
				}
				var c *Node = new_node(ND_CALL, mpos);
				c.name = mname;
				c.dotcall = true;
				var v *Var = find_var(mname);
				if (v as i64 != 0) { c.varp = v; }
				call_args(t, c);
				n.next = c.args;
				c.args = n;
				c.nargs = c.nargs + 1;
				n = c;
				continue;
			}
			var m *Node = new_node(ND_MEMBER, mpos);
			m.lhs = n;
			m.name = mname;
			n = m;
			continue;
		}
		return n;
	}
}

fn chan_call(name str, arg *Node, pos i64) *Node {
	var c *Node = new_node(ND_CALL, pos);
	c.name = name;
	var a *Node = new_node(ND_ADDR, pos);
	a.lhs = arg;
	c.args = a;
	c.nargs = 1;
	return c;
}

fn parse_unary(t **Token) *Node {
	parse_enter(t);
	var n *Node = parse_unary_inner(t);
	parse_leave();
	return n;
}

fn parse_unary_inner(t **Token) *Node {
	if (tok_eq(*t, "<-")) {
		var p i64 = (*t).pos;
		*t = (*t).next;
		return chan_call("chan_recv", parse_unary(t), p);
	}

	var p i64 = (*t).pos;
	if (tok_consume(t, "-")) { var n *Node = new_node(ND_NEG, p); n.lhs = parse_unary(t); return n; }
	if (tok_consume(t, "!")) { var n *Node = new_node(ND_NOT, p); n.lhs = parse_unary(t); return n; }
	if (tok_consume(t, "~")) { var n *Node = new_node(ND_BITNOT, p); n.lhs = parse_unary(t); return n; }
	if (tok_consume(t, "&")) { var n *Node = new_node(ND_ADDR, p); n.lhs = parse_unary(t); return n; }
	if (tok_consume(t, "*")) { var n *Node = new_node(ND_DEREF, p); n.lhs = parse_unary(t); return n; }
	if (tok_consume(t, "+")) { return parse_unary(t); }
	return parse_postfix(t);
}

fn parse_cast(t **Token) *Node {
	var n *Node = parse_unary(t);
	while (tok_consume(t, "as")) {
		var p i64 = (*t).pos;
		var c *Node = new_node(ND_CAST, p);
		c.lhs = n;
		c.ty = parse_type(t);
		n = c;
	}
	return n;
}

fn parse_mul(t **Token) *Node {
	var n *Node = parse_cast(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "*")) { n = bin_node(ND_MUL, n, parse_cast(t), p); }
		else if (tok_consume(t, "/")) { n = bin_node(ND_DIV, n, parse_cast(t), p); }
		else if (tok_consume(t, "%")) { n = bin_node(ND_MOD, n, parse_cast(t), p); }
		else if (tok_consume(t, "<<")) { n = bin_node(ND_SHL, n, parse_cast(t), p); }
		else if (tok_consume(t, ">>")) { n = bin_node(ND_SHR, n, parse_cast(t), p); }
		else if (tok_consume(t, "&")) { n = bin_node(ND_BITAND, n, parse_cast(t), p); }
		else { return n; }
	}
}

fn parse_add(t **Token) *Node {
	var n *Node = parse_mul(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "+")) { n = bin_node(ND_ADD, n, parse_mul(t), p); }
		else if (tok_consume(t, "-")) { n = bin_node(ND_SUB, n, parse_mul(t), p); }
		else if (tok_consume(t, "|")) { n = bin_node(ND_BITOR, n, parse_mul(t), p); }
		else if (tok_consume(t, "^")) { n = bin_node(ND_BITXOR, n, parse_mul(t), p); }
		else { return n; }
	}
}

fn rel_op_peek(t *Token) int {
	if (tok_eq(t, "<")) { return ND_LT; }
	if (tok_eq(t, "<=")) { return ND_LE; }
	if (tok_eq(t, ">")) { return -ND_LT; }
	if (tok_eq(t, ">=")) { return -ND_LE; }
	return 0;
}

fn rel_op_take(t **Token) int {
	var rv int = rel_op_peek(*t);
	if (rv != 0) { *t = (*t).next; }
	return rv;
}

// a op b with `>`/`>=` folded: a negative op means the operands swap.
fn rel_cmp_node(op int, a *Node, b *Node, pos i64) *Node {
	if (op > 0) { return bin_node(op, a, b, pos); }
	return bin_node(-op, b, a, pos);
}

// A comparison operand that is safe to evaluate twice: a variable read or
// a literal has no side effects, so it needs no hidden temp.
fn chain_mid_plain(n *Node) bool {
	return n.kind == ND_VAR || n.kind == ND_NUM;
}

// A unique `_$`-prefixed name: no identifier can contain `$`, so these can
// never collide with user code, and the gen_seq counter keeps two
// expansions in the same scope apart.
fn hidden_name(prefix str) str {
	var b Buf;
	fmt_str(&b, "_$");
	fmt_str(&b, prefix);
	fmt_i64(&b, gen_seq as i64);
	gen_seq = gen_seq + 1;
	return buf_str(&b);
}

// Hoists a chained-comparison middle operand into a hidden temp: returns
// the value to put in this compare and, via `rd`, the variable read for
// the next one. A plain variable or literal is used twice as itself.
fn chain_hoist_mid(mid *Node, pos i64, rd **Node) *Node {
	if (chain_mid_plain(mid)) {
		*rd = mid;
		return mid;
	}
	add_type(mid);
	var hv *Var = declare_var(hidden_name("h"), mid.ty, pos);
	var lhs *Node = new_node(ND_VAR, pos);
	lhs.varp = hv;
	var asn *Node = bin_node(ND_ASSIGN, lhs, mid, pos);
	var r *Node = new_node(ND_VAR, pos);
	r.varp = hv;
	*rd = r;
	return asn;
}

// Chained comparisons: `a < b <= c` becomes `a < b && b <= c`, with every
// middle operand evaluated exactly once, and only when the comparison
// before it held. The hoist is a plain assignment in the operand's place:
// `a < (t = b) && t <= c` -- the assign stores b once and yields its
// value, so the second compare reads the temp. Evaluation order matches
// the language's own rhs-first compare (a < b() evaluates b() first).
fn parse_chain(t **Token, pos i64, n *Node, op1 int, mid *Node) *Node {
	var oh Node;
	var ot *Node = &oh;
	var mh Node;
	var mt *Node = &mh;
	mt.next = mid;
	mt = mid;
	while (true) {
		var op int = rel_op_take(t);
		if (op == 0) { break; }
		var on *Node = num_node(op as i64, (*t).pos);
		ot.next = on;
		ot = on;
		var rhs *Node = parse_add(t);
		mt.next = rhs;
		mt = rhs;
	}
	var rd *Node = null;
	var midref *Node = chain_hoist_mid(mid, pos, &rd);
	var cur *Node = rel_cmp_node(op1, n, midref, pos);
	var op *Node = oh.next;
	// The operand list is [mid, rhs2, rhs3...]: the first element is the
	// right side of the first compare, already consumed into `mid`.
	var opnd *Node = mh.next;
	opnd = opnd.next;
	while (op as i64 != 0) {
		var nxt *Node = op.next;
		var opnd_next *Node = opnd.next;
		var rd2 *Node = null;
		if (nxt as i64 != 0) {
			opnd = chain_hoist_mid(opnd, pos, &rd2);
			rd = rd2;
		}
		var cmp *Node = rel_cmp_node(op.val as int, rd, opnd, pos);
		var and *Node = bin_node(ND_AND, cur, cmp, pos);
		cur = and;
		opnd = opnd_next;
		op = nxt;
	}
	return cur;
}

// `x in coll` / `x not in coll`. A string membership is str_contains, a
// struct membership is `<prefix>_has` (map_has for a Map), and an array or
// slice scan becomes a hidden loop on an ND_IN node: the chain in `.init`
// zeroes the result, hoists the collection and runs the scan, `.lhs` is
// the result variable.
fn parse_in_expr(t **Token, lhs *Node, coll *Node, pos i64, neg bool) *Node {
	// `x in lo..hi`: range membership, lo <= x < hi. The lhs is hoisted
	// like a chained-comparison middle, so it evaluates exactly once.
	if (tok_consume(t, "..")) {
		var hi *Node = parse_add(t);
		var rd *Node = null;
		var xref *Node = chain_hoist_mid(lhs, pos, &rd);
		var lo_cmp *Node = rel_cmp_node(ND_LE, coll, xref, pos);
		var hi_cmp *Node = rel_cmp_node(ND_LT, rd, hi, pos);
		var and *Node = bin_node(ND_AND, lo_cmp, hi_cmp, pos);
		if (neg) {
			var nn *Node = new_node(ND_NOT, pos);
			nn.lhs = and;
			return nn;
		}
		return and;
	}
	add_type(coll);
	var cty *Type = coll.ty;
	if (cty.kind == TY_PTR) { cty = cty.base; }
	var node *Node = null;
	if (cty.kind == TY_SLICE && cty.base as i64 == ty_u8 as i64) {
		// A str is a []u8: membership is substring, not a byte scan.
		var c *Node = new_node(ND_CALL, pos);
		c.name = "str_contains";
		c.args = coll;
		coll.next = lhs;
		c.nargs = 2;
		node = c;
	} else if (cty.kind == TY_STRUCT && cty.name.len > 0) {
		var pre str = iter_prefix(cty);
		var fb Buf;
		fmt_str(&fb, pre);
		fmt_str(&fb, "_has");
		var fname str = buf_str(&fb);
		var f *Func = find_func(fname);
		if (f as i64 == 0) {
			var mb Buf;
			fmt_str(&mb, "this type has no 'in' support (no ");
			fmt_str(&mb, fname);
			fmt_str(&mb, ")");
			error_at(pos, buf_str(&mb));
		}
		var ch *Node = null;
		var recv *Node = coll;
		if (coll.ty.kind != TY_PTR) {
			if (coll.kind != ND_VAR) {
				var cv *Var = declare_var(hidden_name("c"), coll.ty, pos);
				var clhs *Node = new_node(ND_VAR, pos);
				clhs.varp = cv;
				var ca *Node = new_node(ND_EXPRSTMT, pos);
				ca.lhs = bin_node(ND_ASSIGN, clhs, coll, pos);
				ch = ca;
				var cr *Node = new_node(ND_VAR, pos);
				cr.varp = cv;
				coll = cr;
			}
			var ad *Node = new_node(ND_ADDR, pos);
			ad.lhs = coll;
			recv = ad;
		}
		var c *Node = new_node(ND_CALL, pos);
		c.name = fname;
		c.args = recv;
		recv.next = lhs;
		c.nargs = 2;
		if (ch as i64 != 0) {
			var n *Node = new_node(ND_IN, pos);
			n.init = ch;
			n.lhs = c;
			n.ty = ty_bool;
			node = n;
		} else {
			node = c;
		}
	} else if (cty.kind == TY_ARRAY || cty.kind == TY_SLICE) {
		var fv *Var = declare_var(hidden_name("f"), ty_bool, pos);
		var iv *Var = declare_var(hidden_name("i"), type_lookup("int"), pos);
		var zf *Node = new_node(ND_ZERO, pos);
		zf.varp = fv;
		var zfs *Node = new_node(ND_EXPRSTMT, pos);
		zfs.lhs = zf;
		var ch *Node = zfs;
		var ct *Node = zfs;
		var collref *Node = coll;
		if (coll.kind != ND_VAR) {
			var cv *Var = declare_var(hidden_name("c"), coll.ty, pos);
			var clhs *Node = new_node(ND_VAR, pos);
			clhs.varp = cv;
			var ca *Node = new_node(ND_EXPRSTMT, pos);
			ca.lhs = bin_node(ND_ASSIGN, clhs, coll, pos);
			ct.next = ca;
			ct = ca;
			var cr *Node = new_node(ND_VAR, pos);
			cr.varp = cv;
			collref = cr;
		}
		var lref *Node = lhs;
		if (!chain_mid_plain(lhs)) {
			add_type(lhs);
			var lv *Var = declare_var(hidden_name("in"), lhs.ty, pos);
			var llhs *Node = new_node(ND_VAR, pos);
			llhs.varp = lv;
			var la *Node = new_node(ND_EXPRSTMT, pos);
			la.lhs = bin_node(ND_ASSIGN, llhs, lhs, pos);
			ct.next = la;
			ct = la;
			var lr *Node = new_node(ND_VAR, pos);
			lr.varp = lv;
			lref = lr;
		}
		var f *Node = new_node(ND_FOR, pos);
		var i0 *Node = new_node(ND_VAR, pos);
		i0.varp = iv;
		var init *Node = new_node(ND_EXPRSTMT, pos);
		init.lhs = bin_node(ND_ASSIGN, i0, num_node(0, pos), pos);
		f.init = init;
		var i1 *Node = new_node(ND_VAR, pos);
		i1.varp = iv;
		var ml *Node = new_node(ND_MEMBER, pos);
		ml.lhs = collref;
		ml.name = "len";
		f.cond = bin_node(ND_LT, i1, ml, pos);
		var i2 *Node = new_node(ND_VAR, pos);
		i2.varp = iv;
		var st *Node = bin_node(ND_OPASSIGN, i2, num_node(1, pos), pos);
		st.val = ND_ADD;
		f.step = st;
		var i3 *Node = new_node(ND_VAR, pos);
		i3.varp = iv;
		var idx *Node = bin_node(ND_INDEX, collref, i3, pos);
		var eq *Node = null;
		if (cty.base.kind == TY_SLICE && cty.base.base as i64 == ty_u8 as i64) {
			// A []str element: strings cannot compare with ==, so the
			// scan uses str_eq.
			var c *Node = new_node(ND_CALL, pos);
			c.name = "str_eq";
			c.args = lref;
			lref.next = idx;
			c.nargs = 2;
			eq = c;
		} else if (is_aggregate(cty.base)) {
			error_at(pos, "'in' cannot test membership of aggregate elements");
		} else {
			eq = bin_node(ND_EQ, lref, idx, pos);
		}
		var ifn *Node = new_node(ND_IF, pos);
		ifn.cond = eq;
		var bhead Node;
		var btail *Node = &bhead;
		var fset *Node = new_node(ND_EXPRSTMT, pos);
		var fv2 *Node = new_node(ND_VAR, pos);
		fv2.varp = fv;
		fset.lhs = bin_node(ND_ASSIGN, fv2, num_node(1, pos), pos);
		btail.next = fset;
		btail = fset;
		var brk *Node = new_node(ND_BREAK, pos);
		btail.next = brk;
		btail = brk;
		var blk *Node = new_node(ND_BLOCK, pos);
		blk.body = bhead.next;
		ifn.then = blk;
		var fbody *Node = new_node(ND_BLOCK, pos);
		fbody.body = ifn;
		f.body = fbody;
		ct.next = f;
		ct = f;
		var n *Node = new_node(ND_IN, pos);
		n.init = ch;
		var fr *Node = new_node(ND_VAR, pos);
		fr.varp = fv;
		n.lhs = fr;
		n.ty = ty_bool;
		node = n;
	} else {
		error_at(pos, "'in' needs an array, a slice, a string, or a struct with a <prefix>_has function");
	}
	if (neg) {
		var nn *Node = new_node(ND_NOT, pos);
		nn.lhs = node;
		return nn;
	}
	return node;
}

fn parse_rel(t **Token) *Node {
	var n *Node = parse_add(t);
	var p i64 = (*t).pos;
	var op int = rel_op_take(t);
	if (op == 0) {
		if (tok_consume(t, "in")) { return parse_in_expr(t, n, parse_add(t), p, false); }
		if (tok_eq(*t, "not") && tok_eq((*t).next, "in")) {
			*t = (*t).next.next;
			return parse_in_expr(t, n, parse_add(t), p, true);
		}
		return n;
	}
	var mid *Node = parse_add(t);
	if (rel_op_peek(*t) != 0) { return parse_chain(t, p, n, op, mid); }
	return rel_cmp_node(op, n, mid, p);
}

fn parse_eq(t **Token) *Node {
	var n *Node = parse_rel(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "==")) { n = bin_node(ND_EQ, n, parse_rel(t), p); }
		else if (tok_consume(t, "!=")) { n = bin_node(ND_NE, n, parse_rel(t), p); }
		else { return n; }
	}
}

fn parse_logand(t **Token) *Node {
	var n *Node = parse_eq(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "&&")) { n = bin_node(ND_AND, n, parse_eq(t), p); }
		else { return n; }
	}
}

fn parse_logor(t **Token) *Node {
	var n *Node = parse_logand(t);
	while (true) {
		var p i64 = (*t).pos;
		if (tok_consume(t, "||")) { n = bin_node(ND_OR, n, parse_logand(t), p); }
		else { return n; }
	}
}

fn opassign_node(lhs *Node, rhs *Node, op int, pos i64) *Node {
	var n *Node = bin_node(ND_OPASSIGN, lhs, rhs, pos);
	n.val = op as i64;
	return n;
}

fn parse_assign(t **Token) *Node {
	parse_enter(t);
	var n *Node = parse_assign_inner(t);
	parse_leave();
	return n;
}

fn parse_assign_inner(t **Token) *Node {
	var n *Node = parse_logor(t);
	var p i64 = (*t).pos;
	if (!in_interp && tok_consume(t, "=")) {
		return bin_node(ND_ASSIGN, n, parse_assign(t), p);
	}
	if (tok_eq(*t, "<-")) {
		var sp i64 = (*t).pos;
		*t = (*t).next;
		var send *Node = chan_call("chan_send", n, sp);
		var v *Node = parse_assign(t);
		send.args.next = v;
		send.nargs = 2;
		return send;
	}

	if (tok_consume(t, "+=")) { return opassign_node(n, parse_assign(t), ND_ADD, p); }
	if (tok_consume(t, "-=")) { return opassign_node(n, parse_assign(t), ND_SUB, p); }
	if (tok_consume(t, "*=")) { return opassign_node(n, parse_assign(t), ND_MUL, p); }
	if (tok_consume(t, "/=")) { return opassign_node(n, parse_assign(t), ND_DIV, p); }
	if (tok_consume(t, "%=")) { return opassign_node(n, parse_assign(t), ND_MOD, p); }
	if (tok_consume(t, "&=")) { return opassign_node(n, parse_assign(t), ND_BITAND, p); }
	if (tok_consume(t, "|=")) { return opassign_node(n, parse_assign(t), ND_BITOR, p); }
	if (tok_consume(t, "^=")) { return opassign_node(n, parse_assign(t), ND_BITXOR, p); }
	if (tok_consume(t, "<<=")) { return opassign_node(n, parse_assign(t), ND_SHL, p); }
	if (tok_consume(t, ">>=")) { return opassign_node(n, parse_assign(t), ND_SHR, p); }
	// `a if c else b`: a conditional expression. The condition and the
	// value branches are ordinary expressions; the else branch parses with
	// parse_assign, so `a if c else b if d else e` nests to the right.
	// Suppressed inside a comprehension's for-clause, where `if` is the
	// element filter.
	if (!in_comp_clause && tok_consume(t, "if")) {
		var c *Node = parse_logor(t);
		tok_expect(t, "else");
		var n2 *Node = new_node(ND_IFEXPR, p);
		n2.cond = c;
		n2.then = n;
		n2.els = parse_assign(t);
		return n2;
	}
	return n;
}

fn parse_expr(t **Token) *Node {
	parse_enter(t);
	var n *Node = parse_expr_inner(t);
	parse_leave();
	return n;
}

fn parse_expr_inner(t **Token) *Node {
	var n *Node = parse_assign(t);
	if (tok_consume(t, ",")) { return bin_node(ND_COMMA, n, parse_expr(t), (*t).pos); }
	return n;
}

// ── statements ──

fn parse_block(t **Token) *Node {
	var n *Node = new_node(ND_BLOCK, (*t).pos);
	tok_expect(t, "{");
	enter_scope();
	var head Node;
	var tail *Node = &head;
	resolve_comptime(t);
	var unreachable bool = false;
	while (!tok_eq(*t, "}")) {
		var st *Node = parse_stmt(t);
		resolve_comptime(t);
		tail.next = st;
		// A `var ~n = ...` returns itself chained to a synthetic `defer`
		// via `.next`; walk to the real end so the next statement appends
		// after both instead of silently overwriting the defer.
		while (tail.next.next as i64 != 0) { tail = tail.next; }
		tail = tail.next;
		// Statements after an unconditional jump can never run. A defer
		// still registers (it runs on the way out), so it stays silent.
		if (unreachable && st.kind != ND_DEFER) {
			warn_at(st.pos, "statement is unreachable");
		}
		if (st.kind == ND_RET || st.kind == ND_BREAK || st.kind == ND_CONT) {
			unreachable = true;
		}
	}
	leave_scope();
	tok_expect(t, "}");
	n.body = head.next;
	return n;
}

// A single-statement body slot (an unbraced if/while/for, a match arm, the
// body of `for x in coll`) holds exactly one node. `parse_decl` normally
// returns exactly one, but a `var ~n = ...` chains a synthetic `defer`
// after itself via `.next` -- safe to fold into a block right here because
// nothing else follows in a single-statement slot.
fn stmt_as_body(n *Node) *Node {
	if (n.next as i64 == 0) { return n; }
	var b *Node = new_node(ND_BLOCK, n.pos);
	b.body = n;
	return b;
}

fn parse_decl(t **Token) *Node {
	var kw str = (*t).text;
	var typed bool = str_eq(kw, "var");
	*t = (*t).next;
	// `~` marks a dynamic local: `var ~n = expr;`. Only `var` may carry it
	// -- a `let` binding never changes type or value, so "dynamic" would be
	// meaningless -- and it needs no declared type of its own; its slot
	// always holds the compiler's DynVal.
	var is_dyn bool = false;
	if (tok_eq(*t, "~")) {
		if (!typed) { error_at((*t).pos, "'let' cannot be dynamic; use 'var ~name'"); }
		is_dyn = true;
		*t = (*t).next;
		type_dynval();
		need_dyn = true;
	}
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;
	var ty *Type = null;
	if (is_dyn) { ty = type_dynval(); }
	else if (typed && !tok_eq(*t, "=")) { ty = parse_type(t); }
	var n *Node = new_node(ND_EXPRSTMT, p);
	var dyn_zero *Node = null;
	if (tok_consume(t, "=")) {
		var rhs *Node = parse_assign(t);
		if (rhs.kind == ND_ARRLIT && ty as i64 != 0 && ty.kind == TY_ARRAY) {
			rhs.ty = ty;
		}
		var v *Var = declare_var(name, ty, p);
		if (is_dyn) {
			// A with-initializer local skips the usual "zeroed at
			// declaration" step -- the initializer overwrites the whole
			// slot anyway, normally. A dynamic local is different: the
			// assign below rewrites into a free-before-rebox
			// (type_assign_dyn) that unconditionally reads the *old*
			// `v.ptr` first, so a fresh `var ~n = expr` needs that old
			// value to be a real null, not whatever garbage this stack
			// slot last held (a prior function's frame, an entry-stub
			// scratch value -- platform- and build-dependent, so this
			// looked fine on x86 by luck of stack contents and only
			// crashed heap_free on ARM64, where the leftover bytes happen
			// to look like a wild pointer).
			dyn_zero = new_node(ND_ZERO, p);
			dyn_zero.varp = v;
		}
		if (ty as i64 == 0) {
			// An interpolation's result type is always str, known without
			// typing it: typing it now would rewrite it into calls on
			// std/fmt.qela, which is only auto-spliced in at the next
			// top-level boundary, still ahead of us here.
			if (rhs.kind == ND_INTERP) { ty = type_str(); }
			else { add_type(rhs); ty = rhs.ty; }
			v.ty = ty;
		}
		var lhs *Node = new_node(ND_VAR, p);
		lhs.varp = v;
		n.lhs = bin_node(ND_ASSIGN, lhs, rhs, p);
		// `var ~n = ...` chains a hidden `defer { heap_free(n.ptr); n.ptr =
		// null; }` right after itself -- built from the same node kinds
		// a hand-written defer would use, so it goes through the ordinary
		// type-check and codegen paths unchanged. This frees whatever box
		// is left in `n` when its declaring block/function exits, which
		// includes every earlier iteration's box for a redeclaration
		// re-executing in a loop (the block's defer runs at the end of
		// every pass through it, not just the last). The nulling matters:
		// without it, `type_assign_dyn`'s own free-before-rebox would read
		// the same now-freed pointer on the next iteration and free it a
		// second time -- a double free that corrupted std/heap.qela's
		// free list and hung the next heap_free in its pointer-chasing
		// search, caught by tests/dyn.qela's loop before this comment was
		// written. A single-statement body slot (if/while/for without
		// braces, a match arm) cannot hold two nodes, so callers that
		// assign into one such slot must route the result through
		// `stmt_as_body` to wrap the pair in a block.
		if (is_dyn) {
			var dv *Node = new_node(ND_VAR, p);
			dv.varp = v;
			var mem *Node = new_node(ND_MEMBER, p);
			mem.lhs = dv; mem.name = "ptr";
			var fc *Node = new_node(ND_CALL, p);
			fc.name = "heap_free"; fc.args = mem; fc.nargs = 1;
			var cstmt *Node = new_node(ND_EXPRSTMT, p);
			cstmt.lhs = fc;

			var dv2 *Node = new_node(ND_VAR, p);
			dv2.varp = v;
			var mem2 *Node = new_node(ND_MEMBER, p);
			mem2.lhs = dv2; mem2.name = "ptr";
			var nilptr *Node = new_node(ND_NUM, p);
			nilptr.val = 0;
			var nilcast *Node = new_node(ND_CAST, p);
			nilcast.lhs = nilptr; nilcast.ty = type_ptr(ty_u8);
			var clr *Node = bin_node(ND_ASSIGN, mem2, nilcast, p);
			var clrstmt *Node = new_node(ND_EXPRSTMT, p);
			clrstmt.lhs = clr;
			cstmt.next = clrstmt;

			var body *Node = new_node(ND_BLOCK, p);
			body.body = cstmt;
			var dstmt *Node = new_node(ND_DEFER, p);
			dstmt.lhs = body;
			n.next = dstmt;
		}
	} else {
		if (is_dyn) { error_at(p, "a dynamic variable needs an initializer"); }
		var z *Node = new_node(ND_ZERO, p);
		z.varp = declare_var(name, ty, p);
		n.lhs = z;
	}
	tok_expect(t, ";");
	if (dyn_zero as i64 != 0) { dyn_zero.next = n; return dyn_zero; }
	return n;
}

// A call site parses the arguments, then clones the body with every
// placeholder replaced by a fresh clone of its argument. The substitution
// is trees, not text: no parentheses, no comma problems, and the expanded
// tree gets the ordinary type check and bounds checks. The clone-per-use
// means an argument evaluates as many times as the body names it.
fn macro_call(m *Macro, t **Token, pos i64) *Node {
	tok_expect(t, "(");
	var args [6]*Node;
	var nargs int = 0;
	while (!tok_eq(*t, ")")) {
		if (nargs > 0) { tok_expect(t, ","); }
		if (nargs >= 6) { error_at((*t).pos, "too many macro arguments"); }
		args[nargs] = parse_assign(t);
		nargs = nargs + 1;
	}
	tok_expect(t, ")");
	if (nargs != m.nparams) { error_at(pos, "macro takes a different number of arguments"); }
	return macro_expand(m.body, m, &args[0], nargs, pos);
}

fn macro_expand(n *Node, m *Macro, args **Node, nargs int, pos i64) *Node {
	if (n as i64 == 0) { return null; }
	if (n.kind == ND_VAR) {
		var i int = 0;
		while (i < nargs) {
			if ((n.varp as i64) == (macro_param(m, i) as i64)) {
				return macro_expand(args[i], m, args, nargs, pos);
			}
			i = i + 1;
		}
	}
	var c *Node = arena_alloc(sizeof(Node), 8) as *Node;
	*c = *n;
	c.pos = pos;
	c.next = macro_expand(n.next, m, args, nargs, pos);
	c.lhs = macro_expand(n.lhs, m, args, nargs, pos);
	c.rhs = macro_expand(n.rhs, m, args, nargs, pos);
	c.cond = macro_expand(n.cond, m, args, nargs, pos);
	c.then = macro_expand(n.then, m, args, nargs, pos);
	c.els = macro_expand(n.els, m, args, nargs, pos);
	c.init = macro_expand(n.init, m, args, nargs, pos);
	c.step = macro_expand(n.step, m, args, nargs, pos);
	c.body = macro_expand(n.body, m, args, nargs, pos);
	c.args = macro_expand(n.args, m, args, nargs, pos);
	return c;
}

fn parse_stmt(t **Token) *Node {
	parse_enter(t);
	var saved_head *Node = try_head;
	var saved_tail *Node = try_tail;
	try_head = null;
	try_tail = null;
	var n *Node = parse_stmt_inner(t);
	if (try_head as i64 != 0) {
		if (n.kind == ND_FOR) {
			error_at(n.pos, "'?' cannot be used in a loop header");
		}
		var last *Node = try_tail;
		last.next = n;
		n = try_head;
	}
	try_head = saved_head;
	try_tail = saved_tail;
	parse_leave();
	return n;
}

fn try_push(s *Node) {
	if (try_head as i64 == 0) { try_head = s; }
	else { try_tail.next = s; }
	try_tail = s;
	while (try_tail.next as i64 != 0) { try_tail = try_tail.next; }
}

fn try_call1(name str, v *Var, pos i64) *Node {
	var c *Node = new_node(ND_CALL, pos);
	c.name = name;
	var a *Node = new_node(ND_VAR, pos);
	a.varp = v;
	c.args = a;
	c.nargs = 1;
	return c;
}

fn try_expand(v *Node, pos i64) *Node {
	if (cur_func as i64 == 0) { error_at(pos, "'?' needs a function scope"); }
	add_type(v);
	var ty *Type = v.ty;
	if (ty as i64 == 0 || ty.kind != TY_ENUM || ty.tmpl as i64 == 0) {
		error_at(pos, "'?' needs an Opt(T) or a Res(T, E) value");
	}
	var isopt bool = str_eq(ty.tmpl.name, "Opt");
	if (!isopt && !str_eq(ty.tmpl.name, "Res")) {
		error_at(pos, "'?' needs an Opt(T) or a Res(T, E) value");
	}
	var ret *Type = cur_func.ret;
	if (ret as i64 == 0 || ret.kind != TY_ENUM || ret.tmpl as i64 != ty.tmpl as i64) {
		error_at(pos, "'?' needs the enclosing function to return the same Opt or Res type");
	}
	if (!isopt && !same_type(ret.ga1, ty.ga1)) {
		error_at(pos, "'?' needs the error type of the enclosing function to match");
	}

	var qb Buf;
	fmt_str(&qb, "_$q");
	fmt_i64(&qb, gen_seq as i64);
	gen_seq = gen_seq + 1;
	var qv *Var = declare_var(buf_str(&qb), ty, pos);

	var ql *Node = new_node(ND_VAR, pos);
	ql.varp = qv;
	var qas *Node = new_node(ND_EXPRSTMT, pos);
	qas.lhs = bin_node(ND_ASSIGN, ql, v, pos);
	try_push(qas);

	var okc *Node = try_call1("opt_is_some", qv, pos);
	if (!isopt) { okc.name = "res_is_ok"; }
	var notn *Node = new_node(ND_NOT, pos);
	notn.lhs = okc;

	var bad *Node = new_node(ND_ENUMLIT, pos);
	bad.ty = ret;
	if (isopt) { bad.name = "None"; }
	else {
		bad.name = "Err";
		bad.args = try_call1("res_err", qv, pos);
		bad.nargs = 1;
	}
	var rets *Node = new_node(ND_RET, pos);
	rets.lhs = bad;
	var blk *Node = new_node(ND_BLOCK, pos);
	blk.body = rets;
	var ifn *Node = new_node(ND_IF, pos);
	ifn.cond = notn;
	ifn.then = blk;
	try_push(ifn);

	var val *Node = try_call1("opt_val", qv, pos);
	if (!isopt) { val.name = "res_val"; }
	return val;
}

// Shared by `spawn f(...)` and `go f(...)`: both desugar to a call taking
// a function address plus up to five i64-cast arguments, padded to five
// with zeros -- coro_spawn's and go's signatures match exactly.
fn parse_spawn_like(t **Token, p i64, callee str, kw str) *Node {
	*t = (*t).next;
	var fname str = (*t).text;
	var fpos i64 = (*t).pos;
	*t = (*t).next;
	var call *Node = new_node(ND_CALL, p);
	call.name = callee;
	var fa *Node = new_node(ND_FUNCADDR, fpos);
	fa.name = fname;
	call.args = fa;
	var tail *Node = fa;
	var given int = 0;
	tok_expect(t, "(");
	while (!tok_eq(*t, ")")) {
		if (given > 0) { tok_expect(t, ","); }
		var a *Node = new_node(ND_CAST, (*t).pos);
		a.ty = type_lookup("i64");
		a.lhs = parse_assign(t);
		tail.next = a;
		tail = a;
		given = given + 1;
	}
	tok_expect(t, ")");
	if (given > 5) {
		if (str_eq(kw, "go")) { error_at(p, "go takes at most 5 arguments"); }
		error_at(p, "spawn takes at most 5 arguments");
	}
	while (given < 5) {
		tail.next = num_node(0, p);
		tail = tail.next;
		given = given + 1;
	}
	call.nargs = 6;
	var st *Node = new_node(ND_EXPRSTMT, p);
	st.lhs = call;
	tok_expect(t, ";");
	return st;
}

// ── select ──
//
// `select { case <-ch: ... case x = <-ch: ... case ch <- v: ... default:
// ... }` desugars to a polling loop, because the channel scheduler already
// polls: each case becomes a non-blocking try (in source order, so the
// first ready case wins), the body of the first ready case runs and breaks
// out of the loop, and a select with nothing ready and no default falls
// into chan_select_block -- the same deadlock-detecting wait a blocking
// send/receive uses. `break` inside a case body exits the select (Go's
// rule); `continue` re-enters the polling loop. Send values are
// re-evaluated on every poll, and a `case x = <-ch:` needs x already
// declared -- both documented divergences from Go.
fn parse_select_body(t **Token) *Node {
	enter_scope();
	var head Node;
	var tail *Node = &head;
	while (!tok_eq(*t, "}") && !tok_eq(*t, "case") && !tok_eq(*t, "default")) {
		tail.next = parse_stmt(t);
		// A `var ~n = ...` returns a two-node chain; walk to the real end.
		while (tail.next.next as i64 != 0) { tail = tail.next; }
		tail = tail.next;
	}
	leave_scope();
	return head.next;
}

fn select_name(kind str) str {
	var b Buf;
	fmt_str(&b, "_$s");
	fmt_str(&b, kind);
	fmt_i64(&b, gen_seq as i64);
	gen_seq = gen_seq + 1;
	return buf_str(&b);
}

// `var _$sok<N> bool = false;` -- the readiness flag a case polls.
fn select_ok_decl(okv *Var, p i64) *Node {
	var n *Node = new_node(ND_EXPRSTMT, p);
	var l *Node = new_node(ND_VAR, p);
	l.varp = okv;
	n.lhs = bin_node(ND_ASSIGN, l, num_node(0, p), p);
	return n;
}

// `if (cond) { [assign;] body...; break; }` -- one select case.
fn select_if(cond *Node, assign *Node, body *Node, p i64) *Node {
	var ifn *Node = new_node(ND_IF, p);
	ifn.cond = cond;
	var b *Node = new_node(ND_BLOCK, p);
	var head Node;
	var tail *Node = &head;
	if (assign as i64 != 0) { tail.next = assign; tail = assign; }
	tail.next = body;
	while (tail.next as i64 != 0) { tail = tail.next; }
	var brk *Node = new_node(ND_BREAK, p);
	tail.next = brk;
	b.body = head.next;
	ifn.then = b;
	return ifn;
}

// Whether a subtree contains a `continue` that belongs to the select (a
// continue inside a nested loop belongs to that loop -- the scan stops at
// any ND_FOR). parse_select emits its continue-forwarding flag and trailing
// `if (_$sc) { continue; }` only when a case body actually has one, so a
// plain select never carries the trailing continue (which would be a
// compile error outside any loop).
fn select_count_cont(n *Node) i64 {
	if (n as i64 == 0) { return 0; }
	if (n.kind == ND_CONT) { return 1 + select_count_cont(n.next); }
	if (n.kind == ND_FOR) { return select_count_cont(n.next); }
	return select_count_cont(n.next) + select_count_cont(n.lhs) +
		select_count_cont(n.rhs) + select_count_cont(n.cond) +
		select_count_cont(n.then) + select_count_cont(n.els) +
		select_count_cont(n.init) + select_count_cont(n.step) +
		select_count_cont(n.body) + select_count_cont(n.args);
}

// Rewrites `continue` inside a select's case bodies. Go's rule: a continue
// in a select case continues the loop enclosing the select, not the select
// itself -- so each continue becomes `_$sc<N> = true; break;` (breaking the
// select's internal polling loop), and parse_select appends an
// `if (_$sc<N>) { continue; }` after that loop, where the continue really
// does target the enclosing loop. A continue inside a nested loop belongs
// to that loop and is left alone; the rewrite stops at any ND_FOR.
fn select_rewrite_cont(n *Node, fv *Var) *Node {
	if (n as i64 == 0) { return null; }
	if (n.kind == ND_CONT) {
		var av *Node = new_node(ND_ASSIGN, n.pos);
		var fvn *Node = new_node(ND_VAR, n.pos);
		fvn.varp = fv;
		av.lhs = fvn;
		av.rhs = num_node(1, n.pos);
		var es *Node = new_node(ND_EXPRSTMT, n.pos);
		es.lhs = av;
		var brk *Node = new_node(ND_BREAK, n.pos);
		es.next = brk;
		brk.next = select_rewrite_cont(n.next, fv);
		return es;
	}
	if (n.kind == ND_FOR) {
		n.next = select_rewrite_cont(n.next, fv);
		return n;
	}
	n.next = select_rewrite_cont(n.next, fv);
	n.lhs = select_rewrite_cont(n.lhs, fv);
	n.rhs = select_rewrite_cont(n.rhs, fv);
	n.cond = select_rewrite_cont(n.cond, fv);
	n.then = select_rewrite_cont(n.then, fv);
	n.els = select_rewrite_cont(n.els, fv);
	n.init = select_rewrite_cont(n.init, fv);
	n.step = select_rewrite_cont(n.step, fv);
	n.body = select_rewrite_cont(n.body, fv);
	n.args = select_rewrite_cont(n.args, fv);
	return n;
}

fn select_case(e *Node, body *Node, p i64) *Node {
	// `case <-ch:` -- receive, value discarded.
	if (e.kind == ND_CALL && str_eq(e.name, "chan_recv")) {
		var head Node;
		var tail *Node = &head;
		var okv *Var = declare_var(select_name("ok"), type_lookup("bool"), p);
		tail.next = select_ok_decl(okv, p);
		tail = tail.next;
		var call *Node = new_node(ND_CALL, p);
		call.name = "chan_try_recv";
		var ch *Node = e.args;
		call.args = ch;
		var on *Node = new_node(ND_ADDR, p);
		on.lhs = new_node(ND_VAR, p);
		on.lhs.varp = okv;
		ch.next = on;
		call.nargs = 2;
		var es *Node = new_node(ND_EXPRSTMT, p);
		es.lhs = call;
		tail.next = es;
		tail = es;
		var cv *Node = new_node(ND_VAR, p);
		cv.varp = okv;
		tail.next = select_if(cv, null, body, p);
		return head.next;
	}
	// `case x = <-ch:` -- receive into an already-declared variable. The
	// value temp's type is the channel element type, inferred from the
	// generic call exactly as `var x = f(...)` would.
	if (e.kind == ND_ASSIGN && e.rhs.kind == ND_CALL && str_eq(e.rhs.name, "chan_recv")) {
		var head Node;
		var tail *Node = &head;
		var okv *Var = declare_var(select_name("ok"), type_lookup("bool"), p);
		var vv *Var = declare_var(select_name("val"), null, p);
		tail.next = select_ok_decl(okv, p);
		tail = tail.next;
		var call *Node = new_node(ND_CALL, p);
		call.name = "chan_try_recv";
		var ch *Node = e.rhs.args;
		call.args = ch;
		var on *Node = new_node(ND_ADDR, p);
		on.lhs = new_node(ND_VAR, p);
		on.lhs.varp = okv;
		ch.next = on;
		call.nargs = 2;
		add_type(call);
		vv.ty = call.ty;
		var vdecl *Node = new_node(ND_EXPRSTMT, p);
		var vl *Node = new_node(ND_VAR, p);
		vl.varp = vv;
		vdecl.lhs = bin_node(ND_ASSIGN, vl, call, p);
		tail.next = vdecl;
		tail = vdecl;
		var cv *Node = new_node(ND_VAR, p);
		cv.varp = okv;
		var rv *Node = new_node(ND_VAR, p);
		rv.varp = vv;
		var asg *Node = bin_node(ND_ASSIGN, e.lhs, rv, p);
		tail.next = select_if(cv, asg, body, p);
		return head.next;
	}
	// `case ch <- v:` -- send.
	if (e.kind == ND_CALL && str_eq(e.name, "chan_send")) {
		var call *Node = new_node(ND_CALL, p);
		call.name = "chan_try_send";
		call.args = e.args;
		call.nargs = 2;
		return select_if(call, null, body, p);
	}
	error_at(p, "a select case must be a channel send or receive");
	return null;
}

fn parse_select(t **Token, p i64) *Node {
	tok_expect(t, "select");
	tok_expect(t, "{");
	var n *Node = new_node(ND_FOR, p);
	n.cond = num_node(1, p);
	var bhead Node;
	var btail *Node = &bhead;
	var has_default bool = false;
	var fv *Var = null;
	var fdecl *Node = null;
	while (!tok_eq(*t, "}")) {
		if (tok_consume(t, "default")) {
			if (has_default) { error_at((*t).pos, "a select can have only one 'default'"); }
			has_default = true;
			tok_expect(t, ":");
			var body *Node = parse_select_body(t);
			if (select_count_cont(body) > 0) {
				if (fv as i64 == 0) {
					fv = declare_var(select_name("sc"), type_lookup("bool"), p);
					fdecl = select_ok_decl(fv, p);
				}
				body = select_rewrite_cont(body, fv);
			}
			var brk *Node = new_node(ND_BREAK, p);
			var tail *Node = body;
			if (tail as i64 == 0) { body = brk; }
			else {
				while (tail.next as i64 != 0) { tail = tail.next; }
				tail.next = brk;
			}
			var blk *Node = new_node(ND_BLOCK, p);
			blk.body = body;
			btail.next = blk;
			btail = blk;
			continue;
		}
		tok_expect(t, "case");
		var cp i64 = (*t).pos;
		var e *Node = parse_assign(t);
		tok_expect(t, ":");
		var body *Node = parse_select_body(t);
		if (select_count_cont(body) > 0) {
			if (fv as i64 == 0) {
				fv = declare_var(select_name("sc"), type_lookup("bool"), p);
				fdecl = select_ok_decl(fv, p);
			}
			body = select_rewrite_cont(body, fv);
		}
		btail.next = select_case(e, body, cp);
		while (btail.next.next as i64 != 0) { btail = btail.next; }
		btail = btail.next;
	}
	tok_expect(t, "}");
	if (!has_default) {
		var cb *Node = new_node(ND_EXPRSTMT, p);
		var cc *Node = new_node(ND_CALL, p);
		cc.name = "chan_select_block";
		cc.nargs = 0;
		cb.lhs = cc;
		btail.next = cb;
	}
	var blk *Node = new_node(ND_BLOCK, p);
	blk.body = bhead.next;
	n.body = blk;
	if (fv as i64 == 0) { return n; }
	// The whole select is the chain [var _$sc = false; while (true) {...};
	// if (_$sc) { continue; }]. The trailing continue is the Go semantics
	// for a continue in a case body: it sits outside the select's polling
	// loop, so it continues whatever loop encloses the select. With no
	// enclosing loop it is a compile error, pointing at the select.
	fdecl.next = n;
	var cif *Node = new_node(ND_IF, p);
	var cv *Node = new_node(ND_VAR, p);
	cv.varp = fv;
	cif.cond = cv;
	var cb2 *Node = new_node(ND_BLOCK, p);
	var cn *Node = new_node(ND_CONT, p);
	cb2.body = cn;
	cif.then = cb2;
	n.next = cif;
	return fdecl;
}

// ── generators ──
//
// A function with `yield` in its body is rewritten here, after the body is
// parsed, into a spawner plus a hidden `_$gen<N>` coroutine body. The
// spawner keeps the function's name and signature and now allocates the
// Gen, spawns the body (the hidden function, which takes the same
// parameters plus a Gen pointer), advances it to the first yield and
// returns the pointer; the original body moves to the hidden function with
// parameter references rebound to its own (freshly cloned) parameters and
// every `return` rewritten to gen_finish.
fn gen_elem_of(ty *Type) *Type {
	if (ty as i64 == 0) { return null; }
	var tm *Tmpl = tmpl_find("Gen");
	if (tm as i64 == 0) { return null; }
	if (ty.kind == TY_PTR && ty.base as i64 != 0) {
		if (ty.base.tmpl as i64 == tm as i64) { return ty.base.ga0; }
		return null;
	}
	if (ty.tmpl as i64 == tm as i64) { return ty.ga0; }
	return null;
}

// The element type of a `Chan(T)` or `*Chan(T)` -- the loop variable's type
// for `for x in ch`. Unlike a Gen, a Chan(T) *value* iterates fine: the
// channel is a plain struct, the loop just takes its address.
fn iter_prefix(ty *Type) str {
	var nm str = ty.name;
	var b Buf;
	var i i64 = 0;
	while (i < nm.len && nm.ptr[i] != '(') {
		var c u8 = nm.ptr[i];
		if (c >= 'A' && c <= 'Z') { c = (c as i64 + 32) as u8; }
		buf_u8(&b, c);
		i = i + 1;
	}
	return buf_str(&b);
}

fn iter_protocol_call(coll *Node, pos i64) *Node {
	var ty *Type = coll.ty;
	if (ty as i64 == 0) { return null; }
	if (ty.kind == TY_PTR) { ty = ty.base; }
	if (ty.kind != TY_STRUCT) { return null; }
	if (ty.name.len == 0) { return null; }
	var pre str = iter_prefix(ty);
	if (pre.len == 0) { return null; }

	var ib Buf;
	fmt_str(&ib, pre);
	fmt_str(&ib, "_iter");
	var fname str = buf_str(&ib);
	if (find_func(fname) as i64 == 0) {
		var vb Buf;
		fmt_str(&vb, pre);
		fmt_str(&vb, "_view");
		fname = buf_str(&vb);
		if (find_func(fname) as i64 == 0) { return null; }
	}
	var f *Func = find_func(fname);
	if (f.nparams <= f.nct) { return null; }
	var want *Type = func_param(f, f.nct).ty;
	var recv *Node = coll;
	if (want.kind == TY_PTR && coll.ty.kind != TY_PTR) {
		if (!is_addr_expr(coll)) { return null; }
		var ad *Node = new_node(ND_ADDR, pos);
		ad.lhs = coll;
		recv = ad;
	}
	if (want.kind != TY_PTR && coll.ty.kind == TY_PTR) {
		var dr *Node = new_node(ND_DEREF, pos);
		dr.lhs = coll;
		recv = dr;
	}
	var call *Node = new_node(ND_CALL, pos);
	call.name = fname;
	call.args = recv;
	call.nargs = 1;
	return call;
}

fn chan_elem_of(ty *Type) *Type {
	if (ty as i64 == 0) { return null; }
	var tm *Tmpl = tmpl_find("Chan");
	if (tm as i64 == 0) { return null; }
	if (ty.kind == TY_PTR && ty.base as i64 != 0) {
		if (ty.base.tmpl as i64 == tm as i64) { return ty.base.ga0; }
		return null;
	}
	if (ty.tmpl as i64 == tm as i64) { return ty.ga0; }
	return null;
}

// Rebinds the body's references to the visible function's parameters onto
// the hidden function's clones and rewrites `return;` to gen_finish(_$g)
// (a generator body must never return to the coroutine trampoline -- its
// one-way coro_finish would round-robin away from the consumer). A
// generator cannot return a value: rejected here.
fn gen_rewrite(n *Node, f *Func, hf *Func) *Node {
	if (n as i64 == 0) { return null; }
	if (n.kind == ND_RET) {
		if (n.lhs as i64 != 0) { error_at(n.pos, "a generator cannot return a value"); }
		var c *Node = new_node(ND_CALL, n.pos);
		c.name = "gen_finish";
		var gv *Node = new_node(ND_VAR, n.pos);
		gv.varp = gen_g_var;
		c.args = gv;
		c.nargs = 1;
		var es *Node = new_node(ND_EXPRSTMT, n.pos);
		es.lhs = c;
		es.next = gen_rewrite(n.next, f, hf);
		return es;
	}
	if (n.kind == ND_VAR) {
		var i int = 0;
		while (i < f.nparams) {
			if ((n.varp as i64) == (func_param(f, i) as i64)) {
				n.varp = func_param(hf, i);
				break;
			}
			i = i + 1;
		}
	}
	n.next = gen_rewrite(n.next, f, hf);
	n.lhs = gen_rewrite(n.lhs, f, hf);
	n.rhs = gen_rewrite(n.rhs, f, hf);
	n.cond = gen_rewrite(n.cond, f, hf);
	n.then = gen_rewrite(n.then, f, hf);
	n.els = gen_rewrite(n.els, f, hf);
	n.init = gen_rewrite(n.init, f, hf);
	n.step = gen_rewrite(n.step, f, hf);
	n.body = gen_rewrite(n.body, f, hf);
	n.args = gen_rewrite(n.args, f, hf);
	return n;
}

fn parse_generator_rewrite(f *Func) {
	var elem *Type = gen_elem_of(f.ret);
	if (elem as i64 == 0) { error_at(f.pos, "a function with 'yield' must return *Gen(T)"); }
	if (f.interpreted || f.dynamic) {
		error_at(f.pos, "a generator function cannot be 'interpreted' or 'dynamic'");
	}
	if (f.nparams > 4) { error_at(f.pos, "a generator function takes at most 4 parameters"); }
	var i int = 0;
	while (i < f.nparams) {
		var pv *Var = func_param(f, i);
		if (is_aggregate(pv.ty) && pv.ty.size > 8) {
			error_at(pv.pos, "a generator parameter must fit in one register word (coro_spawn carries five words)");
		}
		i = i + 1;
	}
	// The hidden coroutine body: same parameters (fresh clones -- regalloc
	// and codegen keep per-function state on the Var, so two functions must
	// never share one), then the Gen pointer.
	var nb Buf;
	fmt_str(&nb, "_$gen");
	fmt_i64(&nb, gen_seq as i64);
	gen_seq = gen_seq + 1;
	var hf *Func = arena_alloc(sizeof(Func), 8) as *Func;
	hf.name = buf_str(&nb);
	hf.ret = type_lookup("void");
	hf.pos = f.pos;
	hf.nparams = f.nparams + 1;
	i = 0;
	while (i < f.nparams) {
		var src *Var = func_param(f, i);
		var pv *Var = arena_alloc(sizeof(Var), 8) as *Var;
		*pv = *src;
		pv.next = null;
		pv.pnext = null;
		set_func_param(hf, i, pv);
		i = i + 1;
	}
	set_func_param(hf, f.nparams, gen_g_var);
	hf.body = gen_rewrite(f.body, f, hf);
	// The body must end by switching back to the consumer even when it
	// falls off the end, or the coroutine trampoline's round-robin
	// coro_finish would switch away from the wrong context.
	var fin *Node = new_node(ND_CALL, f.pos);
	fin.name = "gen_finish";
	var fgv *Node = new_node(ND_VAR, f.pos);
	fgv.varp = gen_g_var;
	fin.args = fgv;
	fin.nargs = 1;
	var fes *Node = new_node(ND_EXPRSTMT, f.pos);
	fes.lhs = fin;
	if (hf.body.body as i64 == 0) { hf.body.body = fes; }
	else {
		var tail *Node = hf.body.body;
		while (tail.next as i64 != 0) { tail = tail.next; }
		tail.next = fes;
	}
	// Split the function's locals: the body's own locals move to the
	// hidden function; the parameters (and only they) stay, joined by the
	// spawner's own temp below.
	var keep_head Var;
	var keep_tail *Var = &keep_head;
	var mv_head Var;
	var mv_tail *Var = &mv_head;
	var v *Var = f.locals;
	while (v as i64 != 0) {
		var nxt *Var = v.next;
		v.next = null;
		if ((v as i64) == (gen_g_var as i64)) {
			// Now a hidden-function parameter; in neither locals chain.
		} else {
			var isp bool = false;
			var i2 int = 0;
			while (i2 < f.nparams) {
				if ((v as i64) == (func_param(f, i2) as i64)) { isp = true; break; }
				i2 = i2 + 1;
			}
			if (isp) { keep_tail.next = v; keep_tail = v; }
			else { mv_tail.next = v; mv_tail = v; }
		}
		v = nxt;
	}
	hf.locals = mv_head.next;
	// The hidden function's parameters are frame slots too, and the frame
	// layout pass assigns offsets by walking f.locals. parse_function's own
	// parameters land there via declare_var; these clones and the Gen
	// pointer are built by hand, so they have to be linked in here or they
	// would all sit at offset 0 and clobber each other (and the saved rbp).
	var hl_head Var;
	var hl_tail *Var = &hl_head;
	var hi int = 0;
	while (hi <= f.nparams) {
		hl_tail.next = func_param(hf, hi);
		hl_tail = hl_tail.next;
		hi = hi + 1;
	}
	hl_tail.next = hf.locals;
	hf.locals = hl_head.next;
	var gv *Var = arena_alloc(sizeof(Var), 8) as *Var;
	gv.name = "_$g";
	gv.ty = f.ret;
	gv.next = keep_head.next;
	f.locals = gv;
	f.body = gen_spawner(f, hf, gv);
	add_func(hf);
}

// The visible generator function's new body: allocate the Gen on the arena
// (never freed, like a coroutine stack), spawn the hidden body with the
// parameters and the Gen pointer, remember the coroutine id, advance to the
// first yield and hand the Gen to the caller.
fn gen_spawner(f *Func, hf *Func, gv *Var) *Node {
	var p i64 = f.pos;
	var blk *Node = new_node(ND_BLOCK, p);
	var head Node;
	var tail *Node = &head;
	// var _$g = arena_alloc(sizeof(Gen(T)), 8) as *Gen(T);
	var sz *Node = new_node(ND_SIZEOF, p);
	sz.typeval = f.ret.base;
	var ac *Node = new_node(ND_CALL, p);
	ac.name = "arena_alloc";
	ac.args = sz;
	sz.next = num_node(8, p);
	ac.nargs = 2;
	var acast *Node = new_node(ND_CAST, p);
	acast.ty = f.ret;
	acast.lhs = ac;
	var gv1 *Node = new_node(ND_VAR, p);
	gv1.varp = gv;
	var decl *Node = new_node(ND_EXPRSTMT, p);
	decl.lhs = bin_node(ND_ASSIGN, gv1, acast, p);
	tail.next = decl;
	tail = decl;
	// _$g.coro = coro_spawn(_$gen<N>, params..., _$g, 0...); -- six
	// arguments: the target plus the five words coro_spawn carries.
	var sp *Node = new_node(ND_CALL, p);
	sp.name = "coro_spawn";
	var fa *Node = new_node(ND_FUNCADDR, p);
	fa.name = hf.name;
	sp.args = fa;
	var stail *Node = fa;
	var gi int = 0;
	while (gi < f.nparams) {
		var pn *Node = new_node(ND_VAR, p);
		pn.varp = func_param(f, gi);
		var pc *Node = new_node(ND_CAST, p);
		pc.ty = type_lookup("i64");
		pc.lhs = pn;
		stail.next = pc;
		stail = pc;
		gi = gi + 1;
	}
	var gv2 *Node = new_node(ND_VAR, p);
	gv2.varp = gv;
	var gc *Node = new_node(ND_CAST, p);
	gc.ty = type_lookup("i64");
	gc.lhs = gv2;
	stail.next = gc;
	stail = gc;
	while (gi < 4) {
		stail.next = num_node(0, p);
		stail = stail.next;
		gi = gi + 1;
	}
	sp.nargs = 6;
	var cm *Node = new_node(ND_MEMBER, p);
	var gv3 *Node = new_node(ND_VAR, p);
	gv3.varp = gv;
	cm.lhs = gv3;
	cm.name = "coro";
	var cs *Node = new_node(ND_EXPRSTMT, p);
	cs.lhs = bin_node(ND_ASSIGN, cm, sp, p);
	tail.next = cs;
	tail = cs;
	// gen_resume(_$g);
	var gr *Node = new_node(ND_CALL, p);
	gr.name = "gen_resume";
	var gv4 *Node = new_node(ND_VAR, p);
	gv4.varp = gv;
	gr.args = gv4;
	gr.nargs = 1;
	var gs *Node = new_node(ND_EXPRSTMT, p);
	gs.lhs = gr;
	tail.next = gs;
	tail = gs;
	// return _$g;
	var rn *Node = new_node(ND_RET, p);
	var gv5 *Node = new_node(ND_VAR, p);
	gv5.varp = gv;
	rn.lhs = gv5;
	tail.next = rn;
	blk.body = head.next;
	return blk;
}

fn parse_stmt_inner(t **Token) *Node {
	var p i64 = (*t).pos;

	if (cur_func as i64 != 0 && cur_func.naked) {
		if (tok_eq(*t, "let") || tok_eq(*t, "var")) {
			error_at(p, "naked functions cannot have locals");
		}
		if (tok_eq(*t, "return")) { error_at(p, "naked functions cannot return a value"); }
		if (tok_eq(*t, "defer")) { error_at(p, "naked functions cannot defer"); }
	}

	if (tok_eq(*t, "{")) { return parse_block(t); }

	if (tok_eq(*t, "spawn") && (*t).next.kind == TK_IDENT) {
		return parse_spawn_like(t, p, "coro_spawn", "spawn");
	}

	if (tok_eq(*t, "go") && (*t).next.kind == TK_IDENT) {
		return parse_spawn_like(t, p, "go", "go");
	}

	// `select { case <-ch: ... case ch <- v: ... default: ... }` desugars
	// to a polling loop over chan_try_recv/chan_try_send; see parse_select.
	if (tok_eq(*t, "select") && tok_eq((*t).next, "{")) {
		return parse_select(t, p);
	}

	// `yield v;` inside a generator function (return type *Gen(T)) becomes
	// gen_yield(_$g, v); the rewrite to the hidden coroutine body happens
	// in parse_generator_rewrite after the body is parsed. Anywhere else it
	// is an error, not an expression: `yield` is reserved in statement
	// position.
	if (tok_consume(t, "yield")) {
		if (cur_gen_ret as i64 == 0) {
			error_at(p, "'yield' outside a generator function (its return type must be *Gen(T))");
		}
		gen_yields_seen = true;
		if (gen_g_var as i64 == 0) { gen_g_var = declare_var("_$g", cur_gen_ret, p); }
		var n *Node = new_node(ND_EXPRSTMT, p);
		var c *Node = new_node(ND_CALL, p);
		c.name = "gen_yield";
		var gv *Node = new_node(ND_VAR, p);
		gv.varp = gen_g_var;
		c.args = gv;
		var v *Node = parse_assign(t);
		gv.next = v;
		c.nargs = 2;
		n.lhs = c;
		tok_expect(t, ";");
		return n;
	}

	if (tok_consume(t, "return")) {
		if (in_defer_body) { error_at(p, "cannot return from inside a defer body"); }
		var n *Node = new_node(ND_RET, p);
		if (!tok_eq(*t, ";")) { n.lhs = parse_expr(t); }
		tok_expect(t, ";");
		return n;
	}

	// `super v;` is the value of the nearest enclosing typed block -- it is
	// `return` inside that block's hidden function, spelled differently so
	// it reads as "the block's value" rather than "exit the function".
	if (tok_consume(t, "super")) {
		if (!capturing) { error_at(p, "'super' is only valid inside a typed block"); }
		if (in_defer_body) { error_at(p, "cannot return from inside a defer body"); }
		var n *Node = new_node(ND_RET, p);
		if (!tok_eq(*t, ";")) { n.lhs = parse_expr(t); }
		tok_expect(t, ";");
		return n;
	}

	if (tok_consume(t, "if")) {
		tok_expect(t, "(");
		var n *Node = new_node(ND_IF, p);
		n.cond = parse_expr(t);
		tok_expect(t, ")");
		n.then = stmt_as_body(parse_stmt(t));
		if (tok_consume(t, "else")) { n.els = stmt_as_body(parse_stmt(t)); }
		return n;
	}

	if (tok_consume(t, "while")) {
		tok_expect(t, "(");
		var n *Node = new_node(ND_FOR, p);
		n.cond = parse_expr(t);
		tok_expect(t, ")");
		n.body = stmt_as_body(parse_stmt(t));
		return n;
	}

	if (tok_consume(t, "break")) {
		if (in_defer_body) { error_at(p, "cannot break from inside a defer body"); }
		tok_expect(t, ";");
		return new_node(ND_BREAK, p);
	}
	if (tok_consume(t, "continue")) {
		if (in_defer_body) { error_at(p, "cannot continue from inside a defer body"); }
		tok_expect(t, ";");
		return new_node(ND_CONT, p);
	}

	if (tok_consume(t, "for")) {
		var n *Node = new_node(ND_FOR, p);
		enter_scope();
		// for i in lo..hi / for x in collection
		if ((*t).kind == TK_IDENT && tok_eq((*t).next, "in")) {
			var name str = (*t).text;
			var np i64 = (*t).pos;
			*t = (*t).next.next;
			var lo *Node = parse_assign(t);
			if (!tok_consume(t, "..")) {
				// `for x in <gen>`: pull values off a generator with
				// while (gen_next(&g, &x)) instead of indexing. The
				// expression is hoisted like any other collection, the
				// loop variable is a plain `var x T;` gen_next writes
				// through, and the call in the condition both advances
				// the generator and ends the loop when it is done.
				var gc *Node = lo;
				add_type(gc);
				if (gen_elem_of(gc.ty) as i64 == 0 && chan_elem_of(gc.ty) as i64 == 0) {
					var pit *Node = iter_protocol_call(gc, np);
					if (pit as i64 != 0) {
						add_type(pit);
						lo = pit;
						gc = pit;
					}
				}
				var elem *Type = gen_elem_of(gc.ty);
				if (elem as i64 != 0) {
					if (gc.ty.kind != TY_PTR) {
						error_at(np, "for-in over a generator needs a *Gen(T); a Gen(T) value is a snapshot and cannot drive the coroutine");
					}
					if (gc.kind != ND_VAR) {
						var cv *Var = declare_var("_$c", gc.ty, np);
						var clhs *Node = new_node(ND_VAR, np);
						clhs.varp = cv;
						var cin *Node = new_node(ND_EXPRSTMT, np);
						cin.lhs = bin_node(ND_ASSIGN, clhs, gc, np);
						var cr *Node = new_node(ND_VAR, np);
						cr.varp = cv;
						n.init = cin;
						gc = cr;
					}
					var v *Var = declare_var(name, elem, np);
					var vz *Node = new_node(ND_ZERO, np);
					vz.varp = v;
					var zstmt *Node = new_node(ND_EXPRSTMT, np);
					zstmt.lhs = vz;
					if (n.init as i64 == 0) { n.init = zstmt; }
					else {
						var it *Node = n.init;
						while (it.next as i64 != 0) { it = it.next; }
						it.next = zstmt;
					}
					var gn *Node = new_node(ND_CALL, np);
					gn.name = "gen_next";
					var g1 *Node = gc;
					var g2 *Node = new_node(ND_ADDR, np);
					var xv *Node = new_node(ND_VAR, np);
					xv.varp = v;
					g2.lhs = xv;
					gn.args = g1;
					g1.next = g2;
					gn.nargs = 2;
					n.cond = gn;
					n.body = stmt_as_body(parse_stmt(t));
					leave_scope();
					return n;
				}
				// `for x in ch` over a channel: receive until the channel
				// is closed and drained -- Go's `for v := range ch`. The
				// channel expression is hoisted like any other collection
				// and the loop is
				//   while (true) {
				//       var _$sok = false;
				//       x = chan_recv_range(g, &_$sok);
				//       if (!_$sok) { break; }
				//       <body>
				//   }
				// chan_recv_range blocks while the channel is open and
				// empty, so the body runs exactly once per delivered
				// value, never on the trailing zero of a drained channel.
				// break/continue inside the body behave as in Go: break
				// stops the range, continue receives the next value.
				var celem *Type = chan_elem_of(gc.ty);
				if (celem as i64 != 0) {
					var gty *Type = gc.ty;
					if (gc.kind != ND_VAR) {
						var cv *Var = declare_var("_$c", gc.ty, np);
						var clhs *Node = new_node(ND_VAR, np);
						clhs.varp = cv;
						var cin *Node = new_node(ND_EXPRSTMT, np);
						cin.lhs = bin_node(ND_ASSIGN, clhs, gc, np);
						var cr *Node = new_node(ND_VAR, np);
						cr.varp = cv;
						n.init = cin;
						gc = cr;
					}
					var g1 *Node = gc;
					if (gty.kind != TY_PTR) {
						var ad *Node = new_node(ND_ADDR, np);
						ad.lhs = gc;
						g1 = ad;
					}
					var v *Var = declare_var(name, celem, np);
					var vz *Node = new_node(ND_ZERO, np);
					vz.varp = v;
					var zstmt *Node = new_node(ND_EXPRSTMT, np);
					zstmt.lhs = vz;
					if (n.init as i64 == 0) { n.init = zstmt; }
					else {
						var it *Node = n.init;
						while (it.next as i64 != 0) { it = it.next; }
						it.next = zstmt;
					}
					n.cond = num_node(1, np);
					var bhead Node;
					var btail *Node = &bhead;
					var okv *Var = declare_var(select_name("ok"), type_lookup("bool"), np);
					btail.next = select_ok_decl(okv, np);
					btail = btail.next;
					var call *Node = new_node(ND_CALL, np);
					call.name = "chan_recv_range";
					var g2 *Node = g1;
					var on *Node = new_node(ND_ADDR, np);
					on.lhs = new_node(ND_VAR, np);
					on.lhs.varp = okv;
					call.args = g2;
					g2.next = on;
					call.nargs = 2;
					var xl *Node = new_node(ND_VAR, np);
					xl.varp = v;
					var xas *Node = new_node(ND_EXPRSTMT, np);
					xas.lhs = bin_node(ND_ASSIGN, xl, call, np);
					btail.next = xas;
					btail = btail.next;
					var cv2 *Node = new_node(ND_VAR, np);
					cv2.varp = okv;
					var notn *Node = new_node(ND_NOT, np);
					notn.lhs = cv2;
					var ifn *Node = new_node(ND_IF, np);
					ifn.cond = notn;
					var brkblk *Node = new_node(ND_BLOCK, np);
					var brk *Node = new_node(ND_BREAK, np);
					brkblk.body = brk;
					ifn.then = brkblk;
					btail.next = ifn;
					btail = btail.next;
					btail.next = stmt_as_body(parse_stmt(t));
					var blk *Node = new_node(ND_BLOCK, np);
					blk.body = bhead.next;
					n.body = blk;
					leave_scope();
					return n;
				}
				// for x in a: iterate by value over an array, a slice or a
				// string. The index is a hidden local; a collection that is
				// not a plain variable is evaluated once into a hidden
				// variable, because the node would otherwise be typed and
				// emitted twice. The body is `var x = coll[i]` prepended,
				// which is exactly the shape the bounds elision knows.
				var coll *Node = lo;
				var coll_init *Node = null;
				if (coll.kind != ND_VAR) {
					var cv *Var = declare_var("_$c", null, np);
					add_type(coll);
					cv.ty = coll.ty;
					var clhs *Node = new_node(ND_VAR, np);
					clhs.varp = cv;
					coll_init = new_node(ND_EXPRSTMT, np);
					coll_init.lhs = bin_node(ND_ASSIGN, clhs, coll, np);
					var cr *Node = new_node(ND_VAR, np);
					cr.varp = cv;
					coll = cr;
				}
				var v *Var = declare_var(name, null, np);
				var hv *Var = declare_var("_$i", type_lookup("int"), np);
				var iv *Node = new_node(ND_VAR, np);
				iv.varp = hv;
				var init *Node = new_node(ND_EXPRSTMT, np);
				init.lhs = bin_node(ND_ASSIGN, iv, num_node(0, np), np);
				if (coll_init as i64 != 0) { coll_init.next = init; n.init = coll_init; }
				else { n.init = init; }
				var iv2 *Node = new_node(ND_VAR, np);
				iv2.varp = hv;
				var ml *Node = new_node(ND_MEMBER, np);
				ml.lhs = coll;
				ml.name = "len";
				n.cond = bin_node(ND_LT, iv2, ml, np);
				var iv3 *Node = new_node(ND_VAR, np);
				iv3.varp = hv;
				var step *Node = bin_node(ND_OPASSIGN, iv3, num_node(1, np), np);
				step.val = ND_ADD;
				n.step = step;
				var iv4 *Node = new_node(ND_VAR, np);
				iv4.varp = hv;
				var rhs *Node = bin_node(ND_INDEX, coll, iv4, np);
				add_type(rhs);
				v.ty = rhs.ty;
				var d *Node = new_node(ND_EXPRSTMT, np);
				var lv *Node = new_node(ND_VAR, np);
				lv.varp = v;
				d.lhs = bin_node(ND_ASSIGN, lv, rhs, np);
				var blk *Node = new_node(ND_BLOCK, np);
				blk.body = d;
				d.next = stmt_as_body(parse_stmt(t));
				n.body = blk;
				leave_scope();
				return n;
			}
			var hi *Node = parse_assign(t);
			var v *Var = declare_var(name, type_lookup("int"), np);
			var iv *Node = new_node(ND_VAR, np);
			iv.varp = v;
			var init *Node = new_node(ND_EXPRSTMT, np);
			init.lhs = bin_node(ND_ASSIGN, iv, lo, np);
			n.init = init;
			var iv2 *Node = new_node(ND_VAR, np);
			iv2.varp = v;
			n.cond = bin_node(ND_LT, iv2, hi, np);
			var iv3 *Node = new_node(ND_VAR, np);
			iv3.varp = v;
			var step *Node = bin_node(ND_OPASSIGN, iv3, num_node(1, np), np);
			step.val = ND_ADD;
			n.step = step;
		} else {
			tok_expect(t, "(");
			if (!tok_eq(*t, ";")) {
				if (tok_eq(*t, "let") || tok_eq(*t, "var")) { n.init = parse_decl(t); }
				else {
					var e *Node = new_node(ND_EXPRSTMT, (*t).pos);
					e.lhs = parse_expr(t);
					n.init = e;
					tok_expect(t, ";");
				}
			} else { *t = (*t).next; }
			if (!tok_eq(*t, ";")) { n.cond = parse_expr(t); }
			tok_expect(t, ";");
			if (!tok_eq(*t, ")")) { n.step = parse_expr(t); }
			tok_expect(t, ")");
		}
		n.body = stmt_as_body(parse_stmt(t));
		leave_scope();
		return n;
	}

	if (tok_consume(t, "defer")) {
		var n *Node = new_node(ND_DEFER, p);
		in_defer_body = true;
		n.lhs = stmt_as_body(parse_stmt(t));
		in_defer_body = false;
		return n;
	}

	if (tok_consume(t, "match")) {
		tok_expect(t, "(");
		var n *Node = new_node(ND_MATCH, p);
		n.cond = parse_expr(t);
		tok_expect(t, ")");
		tok_expect(t, "{");
		var head Node;
		var tail *Node = &head;
		while (!tok_eq(*t, "}")) {
			var arm *Node = new_node(ND_ARM, (*t).pos);
			if (tok_consume(t, "_")) { arm.name.len = 0; }
			else {
				arm.name = (*t).text;
				*t = (*t).next;
			}
			enter_scope();
			if (tok_consume(t, "(")) {
				var bh Node;
				var bt *Node = &bh;
				while (!tok_eq(*t, ")")) {
					if (bt != &bh) { tok_expect(t, ","); }
					var b *Node = new_node(ND_VAR, (*t).pos);
					b.varp = declare_var((*t).text, null, (*t).pos);
					*t = (*t).next;
					bt.next = b;
					bt = b;
				}
				tok_expect(t, ")");
				arm.args = bh.next;
			}
			tok_expect(t, "=>");
			arm.body = stmt_as_body(parse_stmt(t));
			leave_scope();
			tail.next = arm;
			tail = arm;
		}
		tok_expect(t, "}");
		n.body = head.next;
		return n;
	}

	if (tok_eq(*t, "let") || tok_eq(*t, "var")) { return parse_decl(t); }

	// `a, b = 1, 2` assigns several targets at once. Only at statement
	// level, and only when the shape is actually present: inside an
	// expression the comma already means the comma operator, so the
	// detection scans the targets first (`a, b = ...`), and a bare comma
	// expression (`a, b;`) keeps its old meaning.
	if (multi_assign_ahead(t)) {
		return parse_multi_assign(t, p);
	}

	var n *Node = new_node(ND_EXPRSTMT, p);
	n.lhs = parse_expr(t);
	tok_expect(t, ";");
	return n;
}

// Does the statement at `t` have the shape of a multi-assignment: a
// comma-separated list of assignable targets (identifier, member, index
// or deref chains) followed by `=`? The scan is token-level and stops at
// the first element that is not a target, so `a, b + 1;` stays a comma
// expression.
fn multi_assign_ahead(t **Token) bool {
	var j *Token = *t;
	var ncommas int = 0;
	while (j as i64 != 0) {
		if (j.kind == TK_PUNCT && str_eq(j.text, "*")) { j = j.next; }
		if (j as i64 == 0 || j.kind != TK_IDENT) { return false; }
		j = j.next;
		while (j as i64 != 0) {
			if (j.kind == TK_PUNCT && str_eq(j.text, ".")) {
				j = j.next;
				if (j as i64 == 0 || j.kind != TK_IDENT) { return false; }
				j = j.next;
				continue;
			}
			if (j.kind == TK_PUNCT && str_eq(j.text, "[")) {
				var depth i64 = 1;
				j = j.next;
				while (j as i64 != 0 && depth > 0) {
					if (j.kind == TK_PUNCT) {
						if (str_eq(j.text, "[")) { depth = depth + 1; }
						else if (str_eq(j.text, "]")) { depth = depth - 1; }
					}
					j = j.next;
				}
				if (depth != 0) { return false; }
				continue;
			}
			break;
		}
		if (j as i64 == 0) { return false; }
		if (j.kind == TK_PUNCT && str_eq(j.text, ",")) { j = j.next; ncommas = ncommas + 1; continue; }
		// A single target (`a = 1;`) is an ordinary assignment; the
		// multi form needs at least one comma.
		if (j.kind == TK_PUNCT && str_eq(j.text, "=")) { return ncommas > 0; }
		return false;
	}
	return false;
}

// `a, b = b, a` parses into a chain of plain statements: the right side
// is evaluated into hidden temps first (so a swap reads the old values),
// then each target is assigned from its temp. The chain is:
// [t0 = rhs0, t1 = rhs1, a = t0, b = t1], chained through `.next` like a
// declaration's synthetic defer. A target's temp takes the target's own
// type when it is known at parse time (an identifier), so `var a i8; a,
// b = 5, 6;` keeps the fitting-constant rule; otherwise the right side's
// type is used.
fn parse_multi_assign(t **Token, p i64) *Node {
	var lhs_head *Node = null;
	var lhs_tail *Node = null;
	var nlhs int = 0;
	while (true) {
		var lhs *Node = parse_logor(t);
		if (lhs.kind != ND_VAR && lhs.kind != ND_MEMBER &&
		    lhs.kind != ND_INDEX && lhs.kind != ND_DEREF) {
			error_at(lhs.pos, "the left side of a multi-assignment must be a variable, member, deref or index");
		}
		if (lhs_tail as i64 == 0) { lhs_head = lhs; }
		else { lhs_tail.next = lhs; }
		lhs_tail = lhs;
		nlhs = nlhs + 1;
		if (!tok_consume(t, ",")) { break; }
	}
	tok_expect(t, "=");

	var rhs_head *Node = null;
	var rhs_tail *Node = null;
	var nrhs int = 0;
	while (true) {
		if (nrhs > 0) { tok_expect(t, ","); }
		var rhs *Node = parse_assign(t);
		add_type(rhs);
		if (rhs_tail as i64 == 0) { rhs_head = rhs; }
		else { rhs_tail.next = rhs; }
		rhs_tail = rhs;
		nrhs = nrhs + 1;
		if (nrhs == nlhs) { break; }
	}
	if (tok_eq(*t, ",")) {
		error_at(p, "a multi-assignment needs exactly one right-hand value per left-hand target");
	}
	tok_expect(t, ";");

	var chain_head *Node = null;
	var chain_tail *Node = null;
	var tvars [16]*Var;
	if (nlhs > 16) { error_at(p, "too many targets in a multi-assignment (at most 16)"); }
	var rnode *Node = rhs_head;
	var target *Node = lhs_head;
	var ti int = 0;
	while (target as i64 != 0) {
		var tb Buf;
		fmt_str(&tb, "_$m");
		fmt_i64(&tb, multi_assign_seq as i64);
		multi_assign_seq = multi_assign_seq + 1;
		var tty *Type = rnode.ty;
		if (target.kind == ND_VAR && target.varp.ty as i64 != 0) { tty = target.varp.ty; }
		var tv *Var = declare_var(buf_str(&tb), tty, p);
		tvars[ti] = tv;
		ti = ti + 1;
		var tvar *Node = new_node(ND_VAR, p);
		tvar.varp = tv;
		var tstmt *Node = new_node(ND_EXPRSTMT, p);
		tstmt.lhs = bin_node(ND_ASSIGN, tvar, rnode, p);
		if (chain_tail as i64 == 0) { chain_head = tstmt; }
		else { chain_tail.next = tstmt; }
		chain_tail = tstmt;
		rnode = rnode.next;
		target = target.next;
	}
	// All the temps are assigned before any target is: the right side of
	// every element must read the old values, so `a, b = b, a` swaps.
	target = lhs_head;
	ti = 0;
	while (target as i64 != 0) {
		var tvn *Node = new_node(ND_VAR, p);
		tvn.varp = tvars[ti];
		ti = ti + 1;
		var astmt *Node = new_node(ND_EXPRSTMT, p);
		astmt.lhs = bin_node(ND_ASSIGN, target, tvn, p);
		chain_tail.next = astmt;
		chain_tail = astmt;
		target = target.next;
	}
	return chain_head;
}

// ── top-level ──

// Walks a not-yet-typed default-value expression looking for a reference
// to a parameter that itself carries a default. Only the parameters of
// the function currently being declared can appear here (an identifier
// resolves through the live scope chain, and a defaulted Var is only ever
// a parameter of the function whose declaration is still open), so a hit
// means exactly that: no dependency chain between two defaults.
fn expr_refs_default_param(n *Node) bool {
	if (n as i64 == 0) { return false; }
	if (n.kind == ND_VAR && n.varp as i64 != 0 && n.varp.default as i64 != 0) { return true; }
	if (expr_refs_default_param(n.next)) { return true; }
	if (expr_refs_default_param(n.lhs)) { return true; }
	if (expr_refs_default_param(n.rhs)) { return true; }
	if (expr_refs_default_param(n.cond)) { return true; }
	if (expr_refs_default_param(n.then)) { return true; }
	if (expr_refs_default_param(n.els)) { return true; }
	if (expr_refs_default_param(n.init)) { return true; }
	if (expr_refs_default_param(n.step)) { return true; }
	if (expr_refs_default_param(n.body)) { return true; }
	if (expr_refs_default_param(n.args)) { return true; }
	return false;
}

// Clones a parameter's default expression, substituting any reference to
// one of f's own parameters with the value the caller actually gave for
// it. A default may only name a required (non-defaulted) parameter, so
// `provided` is always filled by the time substitution reaches it -- the
// same clone-per-reference shape as `macro_expand`, keyed by Func params
// instead of Macro params.
fn default_expand(n *Node, f *Func, provided **Node) *Node {
	if (n as i64 == 0) { return null; }
	if (n.kind == ND_VAR) {
		var i int = 0;
		while (i < f.nparams) {
			if ((n.varp as i64) == (func_param(f, i) as i64)) {
				return default_expand(provided[i], f, provided);
			}
			i = i + 1;
		}
	}
	var c *Node = arena_alloc(sizeof(Node), 8) as *Node;
	*c = *n;
	c.next = default_expand(n.next, f, provided);
	c.lhs = default_expand(n.lhs, f, provided);
	c.rhs = default_expand(n.rhs, f, provided);
	c.cond = default_expand(n.cond, f, provided);
	c.then = default_expand(n.then, f, provided);
	c.els = default_expand(n.els, f, provided);
	c.init = default_expand(n.init, f, provided);
	c.step = default_expand(n.step, f, provided);
	c.body = default_expand(n.body, f, provided);
	c.args = default_expand(n.args, f, provided);
	return c;
}

// A named/default call: `sum(a=1, c=3)`. The shape of the first argument
// -- `ident '=' expr` where ident names a real parameter of f -- decides
// the whole call; once decided every further argument must match it.
// Missing parameters fall back to their declared default. `f` is only
// ever non-null here for an already-resolved, non-generic function (one
// declared earlier in the source, or in an already-parsed import), so a
// forward reference to a function declared later in the file cannot use
// named/default arguments -- it falls back to a plain positional call,
// same as if this function had never been consulted.
fn call_args_named(t **Token, n *Node, f *Func) *Node {
	tok_expect(t, "(");
	var provided [14]*Node;
	var have [14]bool;
	var i int = 0;
	while (i < 14) { have[i] = false; i = i + 1; }
	var named_mode bool = false;
	var nseen int = 0;
	while (!tok_eq(*t, ")")) {
		if (nseen > 0) { tok_expect(t, ","); }
		var looks_named bool = (*t).kind == TK_IDENT && tok_eq((*t).next, "=");
		var is_named bool = false;
		var pidx int = -1;
		var ppos i64 = (*t).pos;
		if (nseen == 0) {
			if (looks_named) {
				pidx = func_param_index(f, (*t).text);
				if (pidx >= 0) { named_mode = true; is_named = true; }
			}
		} else if (named_mode) {
			if (!looks_named) { error_at(ppos, "expected a named argument here (this call started with one)"); }
			pidx = func_param_index(f, (*t).text);
			if (pidx < 0) {
				var mb Buf;
				fmt_str(&mb, "'");
				fmt_str(&mb, f.name);
				fmt_str(&mb, "' has no parameter named '");
				fmt_str(&mb, (*t).text);
				fmt_str(&mb, "'");
				error_at(ppos, buf_str(&mb));
			}
			is_named = true;
		} else if (looks_named && func_param_index(f, (*t).text) >= 0) {
			// This call committed to positional mode on its first argument,
			// but a later one looks like a named argument that would match
			// a real parameter -- almost certainly a mixed call, which the
			// design forbids outright rather than guessing the intent.
			error_at(ppos, "cannot mix positional and named arguments in one call");
			is_named = true;
		}
		if (is_named) {
			*t = (*t).next;
			*t = (*t).next;
			var e *Node = parse_assign(t);
			if (have[pidx]) { error_at(ppos, "duplicate named argument"); }
			provided[pidx] = e;
			have[pidx] = true;
		} else {
			var e *Node = parse_assign(t);
			var tail **Node = &n.args;
			while (*tail as i64 != 0) { tail = &(*tail).next; }
			*tail = e;
		}
		nseen = nseen + 1;
	}
	tok_expect(t, ")");
	// An empty call `f()` to a function with parameters has no first
	// argument to read the mode from -- treat it as "everything
	// defaulted" and let the fill loop below either supply every
	// default or fail with "missing required argument".
	if (!named_mode && nseen > 0) {
		n.nargs = nseen;
		return n;
	}
	i = 0;
	while (i < f.nparams) {
		if (!have[i]) {
			var pv *Var = func_param(f, i);
			if (pv.default as i64 == 0) {
				var mb Buf;
				fmt_str(&mb, "missing required argument '");
				fmt_str(&mb, pv.name);
				fmt_str(&mb, "'");
				error_at((*t).pos, buf_str(&mb));
			}
			provided[i] = default_expand(pv.default, f, &provided[0]);
			have[i] = true;
		}
		i = i + 1;
	}
	var head Node;
	var tail *Node = &head;
	i = 0;
	while (i < f.nparams) {
		tail.next = provided[i];
		tail = tail.next;
		i = i + 1;
	}
	tail.next = null;
	n.args = head.next;
	n.nargs = f.nparams;
	return n;
}

fn func_param_index(f *Func, name str) int {
	var i int = 0;
	while (i < f.nparams) {
		if (str_eq(func_param(f, i).name, name)) { return i; }
		i = i + 1;
	}
	return -1;
}

// ── interpreted/dynamic signature classes ──
//
// A function crosses the runtime ABI in one of two shapes. The scalar
// shape (every parameter and the return is a one-word, non-float value:
// integers, bool, pointers, void) packs arguments into an i64 array and
// returns a plain i64. Everything else -- str, floats, structs, arrays,
// payloadless enums -- is the marshalled shape: the trampoline serializes
// each value type-directed into a byte payload, and the return value comes
// back as marshalled bytes (or, under the jit, through a hidden
// out-parameter in a rewritten signature).
//
// A scalar crossing the wire is always 8 bytes; a str is u64 length plus
// the bytes; a POD struct/array (every field a scalar, float or array of
// those) is its raw size-byte image; any other struct is its fields in
// member order (scalars as 8-byte slots, strs as length-prefixed, nested
// structs recursively). Both sides generate from the same parsed types,
// so the conventions can never drift.

fn interp_pod_ok(ty *Type) bool {
	if (ty.kind == TY_ARRAY) { return interp_pod_ok(ty.base); }
	if (ty.kind == TY_STRUCT) { return interp_struct_pod(ty); }
	if (ty.kind == TY_ENUM) {
		// A payload enum's memory image is tag plus the widest payload
		// union; it crosses the wire raw as long as no payload field can
		// hold a pointer.
		var v *Variant = ty.variants;
		while (v as i64 != 0) {
			var m *Member = v.fields;
			while (m as i64 != 0) {
				if (!interp_pod_ok(m.ty)) { return false; }
				m = m.next;
			}
			v = v.next;
		}
		return true;
	}
	return is_float(ty) || is_integer(ty);
}

fn interp_struct_pod(ty *Type) bool {
	var m *Member = ty.members;
	while (m as i64 != 0) {
		if (!interp_pod_ok(m.ty)) { return false; }
		m = m.next;
	}
	return true;
}

fn interp_struct_ok(ty *Type) bool {
	var m *Member = ty.members;
	while (m as i64 != 0) {
		var mt *Type = m.ty;
		if (interp_pod_ok(mt)) { m = m.next; continue; }
		if (mt.kind == TY_SLICE && interp_pod_ok(mt.base)) { m = m.next; continue; }
		if (mt.kind == TY_STRUCT && interp_struct_ok(mt)) { m = m.next; continue; }
		return false;
	}
	return true;
}

fn interp_marshal_ok(ty *Type) bool {
	if (ty.kind == TY_SLICE) { return interp_pod_ok(ty.base); }
	if (ty.kind == TY_STRUCT) { return interp_struct_ok(ty); }
	return interp_pod_ok(ty);
}

fn interp_scalar_ok(ty *Type) bool {
	if (is_float(ty)) { return false; }
	if (ty.kind == TY_PTR) { return true; }
	return is_integer(ty);
}

// The marshalled class: at least one parameter or the return is not a
// one-word scalar. Void counts as scalar (there is no value to carry).
fn interp_marshalled(f *Func) bool {
	if (f.ret.kind != TY_VOID && !interp_scalar_ok(f.ret)) { return true; }
	var i int = 0;
	while (i < f.nparams) {
		if (!interp_scalar_ok(func_param(f, i).ty)) { return true; }
		i = i + 1;
	}
	return false;
}

fn interp_sig_reject(ty *Type, pos i64, what str) {
	if (ty.kind == TY_VOID) { return; }
	if (interp_scalar_ok(ty) || interp_marshal_ok(ty)) { return; }
	var b Buf;
	fmt_str(&b, "a '");
	fmt_str(&b, type_name(ty));
	fmt_str(&b, "' ");
	fmt_str(&b, what);
	fmt_str(&b, " cannot cross the interpreted/dynamic ABI: only scalars, str, floats, slices of POD elements, and structs/enums of those are supported (see docs/INTERPRETED.md)");
	error_at(pos, buf_str(&b));
}

// An eval var's value crosses as a payload the host's generated
// dispatchers decode into the real global. A non-str slice would leave
// its elements pointing into the host's reusable receive buffer (str is
// special-cased with a duplicate on decode), so eval vars stay str-only
// for slices.
fn interp_sig_reject_var(ty *Type, pos i64, what str) {
	if (ty.kind == TY_VOID) { return; }
	if (interp_scalar_ok(ty)) { return; }
	if (ty.kind == TY_SLICE && ty.base as i64 != ty_u8 as i64) {
		var b Buf;
		fmt_str(&b, "an 'eval var' of type '");
		fmt_str(&b, type_name(ty));
		fmt_str(&b, "' cannot cross the runtime ABI: slice globals are limited to str for now (see docs/INTERPRETED.md)");
		error_at(pos, buf_str(&b));
	}
	if (interp_marshal_ok(ty)) { return; }
	interp_sig_reject(ty, pos, what);
}

// The eval fn/eval var ABI is still scalar-only (phase 2 of the
// marshalling work); kept as the classic aggregate/float rejection.
fn interp_check_scalar(ty *Type, pos i64, what str) {
	if (is_aggregate(ty) || is_float(ty)) {
		var b Buf;
		fmt_str(&b, "an 'eval fn'/'eval var' ");
		fmt_str(&b, what);
		fmt_str(&b, " must be a scalar integer type for now (see docs/INTERPRETED.md)");
		error_at(pos, buf_str(&b));
	}
}

// How many argument registers a value occupies under the compiled ABI: an
// aggregate up to 16 bytes rides raw in words, a bigger one passes by
// pointer in one word. The jit path packs this many slots per parameter.
fn interp_jit_words(ty *Type) int {
	if (is_aggregate(ty) && !abi_by_ref(ty.size)) { return ((ty.size + 7) / 8) as int; }
	return 1;
}

// The rewritten jit signature appends a hidden out-pointer parameter, so
// the total register budget is six words including it.
fn interp_jit_budget(f *Func) bool {
	var w int = 0;
	var i int = 0;
	while (i < f.nparams) {
		w = w + interp_jit_words(func_param(f, i).ty);
		i = i + 1;
	}
	if (f.ret.kind != TY_VOID) { w = w + 1; }
	return w <= 6;
}

// Appends the payload-build code for one parameter value. `expr` is the
// source expression naming the value (a parameter name or dotted path).
fn interp_gen_marshal(b *Buf, expr str, ty *Type) {
	if (ty.kind == TY_SLICE) {
		fmt_str(b, " buf_u64(&__b, ");
		fmt_str(b, expr);
		fmt_str(b, ".len); if (");
		fmt_str(b, expr);
		fmt_str(b, ".len > 0) { buf_bytes(&__b, ");
		fmt_str(b, expr);
		fmt_str(b, ".ptr as *u8, ");
		fmt_str(b, expr);
		fmt_str(b, ".len * ");
		fmt_i64(b, ty.base.size as i64);
		fmt_str(b, "); }");
		return;
	}
	if (ty.kind == TY_STRUCT && !interp_struct_pod(ty)) {
		interp_gen_marshal_fields(b, expr, ty);
		return;
	}
	if (ty.kind == TY_STRUCT || ty.kind == TY_ARRAY || ty.kind == TY_ENUM) {
		// A POD struct, array or enum is its raw image; `&f` of an
		// aggregate is its memory (never a promoted register), and for a
		// by-ref value `&f` already is the data pointer. An enum is an
		// aggregate here, so `f as i64` would hand over its address.
		fmt_str(b, " buf_bytes(&__b, &");
		fmt_str(b, expr);
		fmt_str(b, " as *u8, ");
		fmt_i64(b, ty.size as i64);
		fmt_str(b, ");");
		return;
	}
	if (is_float(ty)) {
		if (ty.size == 4) {
			fmt_str(b, " { var __st [4]u8; *(&__st[0] as *f32) = ");
			fmt_str(b, expr);
			fmt_str(b, "; buf_u64(&__b, *(&__st[0] as *u32) as i64); }");
		} else {
			fmt_str(b, " { var __st [8]u8; *(&__st[0] as *f64) = ");
			fmt_str(b, expr);
			fmt_str(b, "; buf_u64(&__b, *(&__st[0] as *u64) as i64); }");
		}
		return;
	}
	fmt_str(b, " buf_u64(&__b, ");
	fmt_str(b, expr);
	fmt_str(b, " as i64);");
}

fn interp_gen_pname(b *Buf, idx int) {
	fmt_str(b, "__p");
	fmt_i64(b, idx as i64);
}

// Decodes one marshalled argument into a `__p<i>` local of the generated
// eval dispatcher, advancing the `__cur` cursor. Mirrors the child side's
// abi_unmarshal_value: scalars as 8-byte slots, strs length-prefixed,
// POD aggregates as raw images, everything else field by field.
fn interp_gen_eval_decode(b *Buf, idx int, ty *Type) {
	fmt_str(b, " var ");
	interp_gen_pname(b, idx);
	if (ty.kind == TY_SLICE) {
		fmt_str(b, " ");
		fmt_str(b, type_name(ty));
		fmt_str(b, "; ");
		interp_gen_pname(b, idx);
		fmt_str(b, ".len = *(__cur as *i64); ");
		interp_gen_pname(b, idx);
		fmt_str(b, ".ptr = (__cur + 8) as *");
		fmt_str(b, type_name(ty.base));
		fmt_str(b, "; __cur = __cur + 8 + ");
		interp_gen_pname(b, idx);
		fmt_str(b, ".len * ");
		fmt_i64(b, ty.base.size as i64);
		fmt_str(b, ";");
		return;
	}
	if (ty.kind == TY_STRUCT && !interp_struct_pod(ty)) {
		fmt_str(b, " ");
		fmt_str(b, type_name(ty));
		fmt_str(b, ";");
		var pb Buf;
		interp_gen_pname(&pb, idx);
		interp_gen_wire_fields(b, buf_str(&pb), ty);
		return;
	}
	fmt_str(b, " ");
	fmt_str(b, type_name(ty));
	fmt_str(b, " = *(__cur as *");
	fmt_str(b, type_name(ty));
	fmt_str(b, "); __cur = __cur + ");
	// An enum is an aggregate like a struct: the wire carries its whole
	// raw image, so the cursor advances by its size, not one word.
	if (ty.kind == TY_STRUCT || ty.kind == TY_ARRAY || ty.kind == TY_ENUM) {
		fmt_i64(b, ty.size as i64);
	} else { fmt_str(b, "8"); }
	fmt_str(b, ";");
}

// The body of one eval-fn branch in the generated dispatcher: decode the
// arguments, call the function, marshal the return value into the
// caller-provided Buf (`__b`), which the host side then sends back.
fn interp_gen_eval_body(b *Buf, ef *Func) {
	fmt_str(b, " var __cur *u8 = args;");
	var ei int = 0;
	while (ei < ef.nparams) {
		interp_gen_eval_decode(b, ei, func_param(ef, ei).ty);
		ei = ei + 1;
	}
	fmt_str(b, " ");
	var callb Buf;
	fmt_str(&callb, ef.name);
	fmt_str(&callb, "(");
	ei = 0;
	while (ei < ef.nparams) {
		if (ei > 0) { fmt_str(&callb, ", "); }
		interp_gen_pname(&callb, ei);
		ei = ei + 1;
	}
	fmt_str(&callb, ")");
	var call str = buf_str(&callb);
	if (ef.ret.kind == TY_VOID) {
		fmt_str(b, call);
		fmt_str(b, ";");
		return;
	}
	if (ef.ret.kind == TY_SLICE) {
		fmt_str(b, "var __r0 ");
		fmt_str(b, type_name(ef.ret));
		fmt_str(b, " = ");
		fmt_str(b, call);
		fmt_str(b, "; buf_u64(__b, __r0.len); if (__r0.len > 0) { buf_bytes(__b, __r0.ptr as *u8, __r0.len * ");
		fmt_i64(b, ef.ret.base.size as i64);
		fmt_str(b, "); }");
		return;
	}
	if (is_float(ef.ret)) {
		if (ef.ret.size == 4) {
			fmt_str(b, "{ var __st [4]u8; *(&__st[0] as *f32) = ");
			fmt_str(b, call);
			fmt_str(b, "; buf_u64(__b, *(&__st[0] as *u32) as i64); }");
		} else {
			fmt_str(b, "{ var __st [8]u8; *(&__st[0] as *f64) = ");
			fmt_str(b, call);
			fmt_str(b, "; buf_u64(__b, *(&__st[0] as *u64) as i64); }");
		}
		return;
	}
	if (ef.ret.kind == TY_STRUCT && !interp_struct_pod(ef.ret)) {
		fmt_str(b, "var __r0 ");
		fmt_str(b, type_name(ef.ret));
		fmt_str(b, " = ");
		fmt_str(b, call);
		fmt_str(b, ";");
		interp_gen_marshal_fields(b, "__r0", ef.ret);
		return;
	}
	if (ef.ret.kind == TY_STRUCT || ef.ret.kind == TY_ARRAY || ef.ret.kind == TY_ENUM) {
		fmt_str(b, "var __r0 ");
		fmt_str(b, type_name(ef.ret));
		fmt_str(b, " = ");
		fmt_str(b, call);
		fmt_str(b, "; buf_bytes(__b, &__r0 as *u8, ");
		fmt_i64(b, ef.ret.size as i64);
		fmt_str(b, ");");
		return;
	}
	fmt_str(b, "buf_u64(__b, ");
	fmt_str(b, call);
	fmt_str(b, " as i64);");
}

// Decodes one marshalled value into the named global of the generated set
// dispatcher, advancing the `__cur` cursor. The mirror of
// interp_gen_marshal: scalars as 8-byte slots, strs length-prefixed and
// duplicated (the payload lives in the host's receive buffer, which is
// reused), POD aggregates as raw images, everything else field by field.
fn interp_gen_global_decode(b *Buf, name str, ty *Type) {
	if (ty.kind == TY_SLICE) {
		fmt_str(b, " { var __t str; __t.len = *(__cur as *i64); __t.ptr = __cur + 8; ");
		fmt_str(b, name);
		fmt_str(b, " = str_dup(__t); __cur = __cur + 8 + __t.len; }");
		return;
	}
	if (ty.kind == TY_STRUCT && !interp_struct_pod(ty)) {
		var m *Member = ty.members;
		while (m as i64 != 0) {
			var mb Buf;
			fmt_str(&mb, name);
			fmt_str(&mb, ".");
			fmt_str(&mb, m.name);
			interp_gen_global_decode(b, buf_str(&mb), m.ty);
			m = m.next;
		}
		return;
	}
	if (is_float(ty)) {
		fmt_str(b, " { var __st [8]u8; *(&__st[0] as *i64) = *(__cur as *i64); ");
		fmt_str(b, name);
		fmt_str(b, " = *(&__st[0] as *");
		fmt_str(b, type_name(ty));
		fmt_str(b, "); __cur = __cur + 8; }");
		return;
	}
	if (ty.kind == TY_STRUCT || ty.kind == TY_ARRAY || ty.kind == TY_ENUM) {
		fmt_str(b, " { var __t ");
		fmt_str(b, type_name(ty));
		fmt_str(b, " = *(__cur as *");
		fmt_str(b, type_name(ty));
		fmt_str(b, "); ");
		fmt_str(b, name);
		fmt_str(b, " = __t; __cur = __cur + ");
		fmt_i64(b, ty.size as i64);
		fmt_str(b, "; }");
		return;
	}
	fmt_str(b, " ");
	fmt_str(b, name);
	fmt_str(b, " = *(__cur as *");
	fmt_str(b, type_name(ty));
	fmt_str(b, "); __cur = __cur + 8;");
}

fn interp_gen_marshal_fields(b *Buf, expr str, ty *Type) {
	var m *Member = ty.members;
	while (m as i64 != 0) {
		var pb Buf;
		fmt_str(&pb, expr);
		fmt_str(&pb, ".");
		fmt_str(&pb, m.name);
		var path str = buf_str(&pb);
		var mt *Type = m.ty;
		if (mt.kind == TY_STRUCT && !interp_struct_pod(mt)) {
			interp_gen_marshal_fields(b, path, mt);
		} else if (mt.kind == TY_STRUCT || mt.kind == TY_ARRAY) {
			// A POD struct or array is its raw image; `&f` of an aggregate
			// is its memory (never a promoted register), and for a by-ref
			// value `&f` already is the data pointer.
			fmt_str(b, " buf_bytes(&__b, &");
			fmt_str(b, path);
			fmt_str(b, " as *u8, ");
			fmt_i64(b, mt.size as i64);
			fmt_str(b, ");");
		} else {
			interp_gen_marshal(b, path, mt);
		}
		m = m.next;
	}
}

// Appends the register-word packing for one parameter; returns the next
// free slot index. The staging arrays keep floats out of gen_addr's
// promoted-local trap (a float local can live in a register).
fn interp_gen_slot(b *Buf, expr str, ty *Type, idx int) int {
	if (ty.kind == TY_SLICE) {
		fmt_str(b, " __ia[");
		fmt_i64(b, idx as i64);
		fmt_str(b, "] = ");
		fmt_str(b, expr);
		fmt_str(b, ".ptr as i64; __ia[");
		fmt_i64(b, (idx + 1) as i64);
		fmt_str(b, "] = ");
		fmt_str(b, expr);
		fmt_str(b, ".len;");
		return idx + 2;
	}
	if (is_float(ty)) {
		var st i64 = 4;
		var rt str = "f32";
		var ut str = "*u32";
		if (ty.size == 8) { st = 8; rt = "f64"; ut = "*u64"; }
		fmt_str(b, " { var __st [");
		fmt_i64(b, st);
		fmt_str(b, "]u8; *(&__st[0] as *");
		fmt_str(b, rt);
		fmt_str(b, ") = ");
		fmt_str(b, expr);
		fmt_str(b, "; __ia[");
		fmt_i64(b, idx as i64);
		fmt_str(b, "] = *(&__st[0] as ");
		fmt_str(b, ut);
		fmt_str(b, ") as i64; }");
		return idx + 1;
	}
	if (is_aggregate(ty)) {
		if (abi_by_ref(ty.size)) {
			fmt_str(b, " __ia[");
			fmt_i64(b, idx as i64);
			fmt_str(b, "] = &");
			fmt_str(b, expr);
			fmt_str(b, " as i64;");
			return idx + 1;
		}
		var nw int = ((ty.size + 7) / 8) as int;
		var j int = 0;
		while (j < nw) {
			fmt_str(b, " __ia[");
			fmt_i64(b, (idx + j) as i64);
			fmt_str(b, "] = *((&");
			fmt_str(b, expr);
			fmt_str(b, " as *i64) + ");
			fmt_i64(b, j as i64);
			fmt_str(b, ");");
			j = j + 1;
		}
		return idx + nw;
	}
	fmt_str(b, " __ia[");
	fmt_i64(b, idx as i64);
	fmt_str(b, "] = ");
	fmt_str(b, expr);
	fmt_str(b, " as i64;");
	return idx + 1;
}

// `return *(BASE as *T);` -- the value sits in memory in its real image.
// Covers scalars (the wire carries a full 8-byte slot, the read takes the
// value's own width), floats, and every aggregate including str.
fn interp_gen_mem_ret(b *Buf, base str, ty *Type) {
	fmt_str(b, " return *(");
	fmt_str(b, base);
	fmt_str(b, " as *");
	fmt_str(b, type_name(ty));
	fmt_str(b, ");");
}

// The wire-shaped return decode: str arrives length-prefixed, a non-POD
// struct field by field, everything else as its own-type read.
fn interp_gen_wire_ret(b *Buf, base str, ty *Type) {
	if (ty.kind == TY_SLICE) {
		fmt_str(b, " var __rs ");
		fmt_str(b, type_name(ty));
		fmt_str(b, "; __rs.len = *(");
		fmt_str(b, base);
		fmt_str(b, " as *i64); __rs.ptr = (");
		fmt_str(b, base);
		fmt_str(b, " + 8) as *");
		fmt_str(b, type_name(ty.base));
		fmt_str(b, "; return __rs;");
		return;
	}
	if (ty.kind == TY_STRUCT && !interp_struct_pod(ty)) {
		fmt_str(b, " var __rs ");
		fmt_str(b, type_name(ty));
		fmt_str(b, "; var __cur *u8 = ");
		fmt_str(b, base);
		fmt_str(b, ";");
		interp_gen_wire_fields(b, "__rs", ty);
		fmt_str(b, " return __rs;");
		return;
	}
	interp_gen_mem_ret(b, base, ty);
}

fn interp_gen_wire_fields(b *Buf, path str, ty *Type) {
	var m *Member = ty.members;
	while (m as i64 != 0) {
		var mt *Type = m.ty;
		var pb Buf;
		fmt_str(&pb, path);
		fmt_str(&pb, ".");
		fmt_str(&pb, m.name);
		var fpath str = buf_str(&pb);
		if (mt.kind == TY_SLICE) {
			fmt_str(b, " ");
			fmt_str(b, fpath);
			fmt_str(b, ".len = *(__cur as *i64); ");
			fmt_str(b, fpath);
			fmt_str(b, ".ptr = (__cur + 8) as *");
			fmt_str(b, type_name(mt.base));
			fmt_str(b, "; __cur = __cur + 8 + ");
			fmt_str(b, fpath);
			fmt_str(b, ".len * ");
			fmt_i64(b, mt.base.size as i64);
			fmt_str(b, ";");
		} else if (mt.kind == TY_STRUCT && !interp_struct_pod(mt)) {
			interp_gen_wire_fields(b, fpath, mt);
		} else if (mt.kind == TY_STRUCT || mt.kind == TY_ARRAY || mt.kind == TY_ENUM) {
			fmt_str(b, " ");
			fmt_str(b, fpath);
			fmt_str(b, " = *(__cur as *");
			fmt_str(b, type_name(mt));
			fmt_str(b, "); __cur = __cur + ");
			fmt_i64(b, mt.size as i64);
			fmt_str(b, ";");
		} else {
			fmt_str(b, " ");
			fmt_str(b, fpath);
			fmt_str(b, " = *(__cur as *");
			fmt_str(b, type_name(mt));
			fmt_str(b, "); __cur = __cur + 8;");
		}
		m = m.next;
	}
}

// The child re-parses the bundle from scratch, so every type an
// interpreted/dynamic function can mention has to come along: user structs
// and enums, and the templates the child instantiates on use. Generic
// instances are skipped -- their "Name(Args)" names are not source text.
fn interp_emit_struct_body(b *Buf, ty *Type) {
	fmt_str(b, "{ ");
	var m *Member = ty.members;
	while (m as i64 != 0) {
		fmt_str(b, m.name);
		fmt_str(b, " ");
		fmt_str(b, type_name(m.ty));
		fmt_str(b, ", ");
		m = m.next;
	}
	fmt_str(b, "}\n");
}

fn interp_emit_struct(b *Buf, ty *Type) {
	fmt_str(b, "struct ");
	fmt_str(b, ty.name);
	fmt_str(b, " ");
	interp_emit_struct_body(b, ty);
}

fn interp_emit_enum_body(b *Buf, ty *Type) {
	fmt_str(b, "{ ");
	var v *Variant = ty.variants;
	while (v as i64 != 0) {
		fmt_str(b, v.name);
		if (v.fields as i64 != 0) {
			fmt_str(b, "(");
			var m *Member = v.fields;
			while (m as i64 != 0) {
				fmt_str(b, type_name(m.ty));
				if (m.next as i64 != 0) { fmt_str(b, ", "); }
				m = m.next;
			}
			fmt_str(b, ")");
		}
		fmt_str(b, ", ");
		v = v.next;
	}
	fmt_str(b, "}\n");
}

fn interp_emit_enum(b *Buf, ty *Type) {
	fmt_str(b, "enum ");
	fmt_str(b, ty.name);
	fmt_str(b, " ");
	interp_emit_enum_body(b, ty);
}

fn interp_emit_tmpl(b *Buf, tm *Tmpl) {
	if (tm.proto.kind == TY_STRUCT) { fmt_str(b, "struct "); }
	else { fmt_str(b, "enum "); }
	fmt_str(b, tm.name);
	fmt_str(b, "(");
	fmt_str(b, tm.tv0.name);
	if (tm.nparams >= 2) { fmt_str(b, ", "); fmt_str(b, tm.tv1.name); }
	if (tm.nparams >= 3) { fmt_str(b, ", "); fmt_str(b, tm.tv2.name); }
	if (tm.nparams >= 4) { fmt_str(b, ", "); fmt_str(b, tm.tv3.name); }
	fmt_str(b, ") ");
	if (tm.proto.kind == TY_STRUCT) { interp_emit_struct_body(b, tm.proto); }
	else { interp_emit_enum_body(b, tm.proto); }
}

fn interp_emit_types(b *Buf) {
	var nt *Named = named_types;
	while (nt as i64 != 0) {
		var nty *Type = nt.ty;
		if (str_find(nt.name, '(' as u8) < 0) {
			if (nty.kind == TY_STRUCT && nty.members as i64 != 0) {
				interp_emit_struct(b, nty);
			} else if (nty.kind == TY_ENUM && nty.variants as i64 != 0) {
				interp_emit_enum(b, nty);
			}
		}
		nt = nt.next;
	}
	var tml *Tmpl = tmpls;
	while (tml as i64 != 0) {
		interp_emit_tmpl(b, tml);
		tml = tml.next;
	}
}

fn interp_gen_scalar_body(b *Buf, f *Func) {
	fmt_str(b, "{ var __ia [14]i64;");
	var i int = 0;
	while (i < 14) {
		fmt_str(b, " __ia[");
		fmt_i64(b, i as i64);
		fmt_str(b, "] = ");
		if (i < f.nparams) {
			fmt_str(b, func_param(f, i).name);
			fmt_str(b, " as i64");
		} else { fmt_str(b, "0"); }
		fmt_str(b, ";");
		i = i + 1;
	}
	if (f.ret.kind != TY_VOID) {
		fmt_str(b, " return ");
	} else {
		fmt_str(b, " ");
	}
	// The jit call goes through a six-slot function pointer, so a
	// scalar-signature function with more than six parameters skips it.
	if (f.dynamic && f.nparams <= 6) { fmt_str(b, "__dyn_jit_call(\""); }
	else { fmt_str(b, "__interp_call_dispatch(\""); }
	fmt_str(b, f.name);
	fmt_str(b, "\", &__ia[0])");
	if (f.ret.kind != TY_VOID) {
		fmt_str(b, " as ");
		fmt_str(b, type_name(f.ret));
	}
	fmt_str(b, "; }");
}

fn interp_gen_marshalled_body(b *Buf, f *Func) {
	fmt_str(b, "{ var __b Buf; buf_u8(&__b, ");
	fmt_i64(b, f.name.len as i64);
	fmt_str(b, " as u8); buf_bytes(&__b, (\"");
	fmt_str(b, f.name);
	fmt_str(b, "\").ptr, ");
	fmt_i64(b, f.name.len as i64);
	fmt_str(b, ");");
	var i int = 0;
	while (i < f.nparams) {
		interp_gen_marshal(b, func_param(f, i).name, func_param(f, i).ty);
		i = i + 1;
	}
	if (f.dynamic && interp_jit_budget(f)) {
		fmt_str(b, " var __ia [6]i64;");
		var si int = 0;
		var pi int = 0;
		while (pi < f.nparams) {
			si = interp_gen_slot(b, func_param(f, pi).name, func_param(f, pi).ty, si);
			pi = pi + 1;
		}
		if (f.ret.kind != TY_VOID) {
			fmt_str(b, " var __r [");
			fmt_i64(b, f.ret.size as i64);
			fmt_str(b, "]u8; __ia[");
			fmt_i64(b, si as i64);
			fmt_str(b, "] = &__r[0] as i64;");
		}
		fmt_str(b, " if (__dyn_jit_call_marshalled(\"");
		fmt_str(b, f.name);
		fmt_str(b, "\", &__ia[0]) == 1) {");
		if (f.ret.kind != TY_VOID) {
			interp_gen_mem_ret(b, "&__r[0]", f.ret);
		}
		fmt_str(b, " }");
	}
	fmt_str(b, " var __resp str = __interp_call_marshalled(buf_str(&__b));");
	if (f.ret.kind != TY_VOID) {
		interp_gen_wire_ret(b, "__resp.ptr", f.ret);
	}
	fmt_str(b, " }");
}

fn interp_escape_src(raw str, pos i64) str {
	var b Buf;
	buf_u8(&b, '"');
	var i i64 = 0;
	while (i < raw.len) {
		var c u8 = raw.ptr[i];
		if (c == '$' && i + 1 < raw.len && raw.ptr[i + 1] == '{') {
			error_at(pos, "an interpreted/dynamic function's source cannot contain string interpolation -- it collides with re-embedding the source over the runtime ABI");
		}
		if (c == '\\') { buf_u8(&b, '\\'); buf_u8(&b, '\\'); }
		else if (c == '"') { buf_u8(&b, '\\'); buf_u8(&b, '"'); }
		else if (c == '\n') { buf_u8(&b, '\\'); buf_u8(&b, 'n'); }
		else if (c == '\r') { buf_u8(&b, '\\'); buf_u8(&b, 'r'); }
		else if (c == '\t') { buf_u8(&b, '\\'); buf_u8(&b, 't'); }
		else { buf_u8(&b, c); }
		i = i + 1;
	}
	buf_u8(&b, '"');
	return buf_str(&b);
}

var interp_trampoline_seq int = 0;

// The scalar trampoline body is parsed in place (it references only
// deferred call names). A marshalled body needs the `Buf` type, which
// does not exist until std/interpcall.qela and its imports are spliced
// in -- and the splice happens at the next top-level loop iteration, not
// synchronously here. So the marshalled body is emitted as a real
// top-level function (`__tramp<N>`) whose tokens are injected into the
// main stream right after the function being synthesized: the loop then
// splices the interp modules first, parses the tramp with `Buf` in
// scope, and `f.body` is a thin forwarder that calls it. The tramp is
// `__`-internal, so the --interpreted/--jit flags never touch it.
fn interp_synthesize_trampoline(t **Token, f *Func, fn_start i64, body_start i64, end_pos i64) {
	interp_sig_reject(f.ret, f.pos, "return type");
	var i int = 0;
	while (i < f.nparams) {
		interp_sig_reject(func_param(f, i).ty, f.pos, "parameter type");
		i = i + 1;
	}

	var fid int = diag_file_of(f.pos);
	var src str = diag_src_of(fid);
	var def_src str = str_slice(src, diag_offset_of(fn_start), diag_offset_of(end_pos));
	interp_escape_src(def_src, f.pos);
	f.src_start = fn_start;
	f.src_end = end_pos;
	f.body_start = body_start;

	var b Buf;
	if (interp_marshalled(f)) {
		var mb Buf;
		fmt_str(&mb, "fn __tramp");
		fmt_i64(&mb, interp_trampoline_seq as i64);
		fmt_str(&mb, "(");
		i = 0;
		while (i < f.nparams) {
			if (i > 0) { fmt_str(&mb, ", "); }
			fmt_str(&mb, func_param(f, i).name);
			fmt_str(&mb, " ");
			fmt_str(&mb, type_name(func_param(f, i).ty));
			i = i + 1;
		}
		fmt_str(&mb, ") ");
		if (f.ret.kind != TY_VOID) {
			fmt_str(&mb, type_name(f.ret));
			fmt_str(&mb, " ");
		}
		interp_gen_marshalled_body(&mb, f);
		var tb str = buf_str(&mb);
		var tfile int = diag_add_file("<interp-marshalled>", tb);
		var ttoks *Token = lex(tb, (tfile as i64) << FILE_SHIFT);
		var ttail *Token = ttoks;
		while (ttail.next as i64 != 0 && ttail.next.kind != TK_EOF) { ttail = ttail.next; }
		ttail.next = *t;
		*t = ttoks;

		fmt_str(&b, "{ ");
		if (f.ret.kind != TY_VOID) { fmt_str(&b, "return "); }
		fmt_str(&b, "__tramp");
		fmt_i64(&b, interp_trampoline_seq as i64);
		fmt_str(&b, "(");
		i = 0;
		while (i < f.nparams) {
			if (i > 0) { fmt_str(&b, ", "); }
			fmt_str(&b, func_param(f, i).name);
			i = i + 1;
		}
		fmt_str(&b, "); }");
	} else {
		interp_gen_scalar_body(&b, f);
	}
	interp_trampoline_seq = interp_trampoline_seq + 1;

	var nameb Buf;
	fmt_str(&nameb, "<interp-trampoline:");
	fmt_i64(&nameb, interp_trampoline_seq as i64);
	buf_u8(&nameb, '>');

	var synth_file int = diag_add_file(buf_str(&nameb), buf_str(&b));
	var synth_toks *Token = lex(buf_str(&b), (synth_file as i64) << FILE_SHIFT);
	f.interp_body = f.body;
	add_type(f.interp_body);
	f.body = parse_block(&synth_toks);
	need_interp = true;
}

// `dyn_clone_into(x, &x);` prepended to a function body for each `~`
// parameter: the parameter then owns a deep copy of the caller's boxed
// payload, so a later write (which frees the slot's old box) never frees
// the caller's memory. A call statement, not an assignment: a
// dynamic-to-dynamic assignment is rejected (it could alias two boxes).
// The name resolves once std/dyn.qela is spliced in; std files skip the
// rewrite because std/dyn.qela's own helpers manage boxes internally.
fn dyn_param_clone(v *Var, body *Node, pos i64) {
	var xr *Node = new_node(ND_VAR, pos);
	xr.varp = v;
	var xw *Node = new_node(ND_VAR, pos);
	xw.varp = v;
	var ad *Node = new_node(ND_ADDR, pos);
	ad.lhs = xw;
	var cc *Node = new_node(ND_CALL, pos);
	cc.name = "dyn_clone_into";
	cc.args = xr;
	xr.next = ad;
	cc.nargs = 2;
	var st *Node = new_node(ND_EXPRSTMT, pos);
	st.lhs = cc;
	st.next = body.body;
	body.body = st;
}

fn parse_function(t **Token, is_extern bool) *Func {
	var fn_start i64 = (*t).pos;
	tok_expect(t, "fn");
	// A naked function runs without prologue or epilogue: no frame, no
	// implicit ret. The body is asm bytes plus bare stores, so the
	// restrictions below are the frame's absence stated out loud.
	var naked_fn bool = tok_consume(t, "naked");
	var interrupt_fn bool = false;
	if (!naked_fn) { interrupt_fn = tok_consume(t, "interrupt"); }
	var interpreted_fn bool = false;
	var dynamic_fn bool = false;
	var frozen_fn bool = false;
	if (!naked_fn) {
		interpreted_fn = tok_consume(t, "interpreted");
		if (!interpreted_fn) {
			dynamic_fn = tok_consume(t, "dynamic");
			if (!dynamic_fn) { frozen_fn = tok_consume(t, "frozen"); }
		}
	}
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;

	var is_internal bool = name.len > 2 && name.ptr[0] == '_' && name.ptr[1] == '_';
	if (!naked_fn && !interpreted_fn && !dynamic_fn && !frozen_fn &&
	    !is_extern && !is_internal && !is_std_path(diag_path_of(diag_file_of(p)))) {
		if (opt_global_jit) { dynamic_fn = true; }
		else if (opt_global_interpreted) { interpreted_fn = true; }
	}

	var f *Func = arena_alloc(sizeof(Func), 8) as *Func;
	f.name = name;
	f.ret = type_lookup("void");
	f.pos = p;
	f.naked = naked_fn;
	f.interrupt = interrupt_fn;
	f.interpreted = interpreted_fn;
	f.dynamic = dynamic_fn;
	f.frozen = frozen_fn;
	f.extern = is_extern;
	if (is_extern && (interpreted_fn || dynamic_fn)) {
		error_at(p, "an extern function cannot be 'interpreted' or 'dynamic'");
	}
	cur_func = f;
	type_set_fn(f);

	enter_scope();
	tok_expect(t, "(");
	var nparams int = 0;
	var rwords int = 0;
	var stack_slot int = 0;
	var saved_ntype_vars int = ntype_vars;
	while (!tok_eq(*t, ")")) {
		if (nparams > 0) { tok_expect(t, ","); }
		if (naked_fn) { error_at((*t).pos, "naked functions cannot take parameters"); }

		if (tok_consume(t, "comptime")) {
			var pn str = (*t).text;
			var pp i64 = (*t).pos;
			*t = (*t).next;
			tok_expect(t, ":");
			if (f.nct != nparams) { error_at(pp, "comptime parameters must come first"); }
			if (f.nct == 6) { error_at(pp, "too many comptime parameters"); }
			parse_type(t);
			var tv *Type = type_new_var(pn);
			type_vars[ntype_vars] = tv;
			ntype_vars = ntype_vars + 1;
			// The parameter carries the type variable itself: monomorphization
			// reads it back from here to know what to substitute.
			var v *Var = declare_var(pn, tv, pp);
			f.nct = f.nct + 1;
			set_func_param(f, nparams, v);
			nparams = nparams + 1;
			continue;
		}

		var pn str = (*t).text;
		var pp i64 = (*t).pos;
		*t = (*t).next;
		// `a=expr i32` -- a default value, parsed before the type since
		// that's the declared order. It may name a global freely, or an
		// earlier, non-defaulted parameter of this same function
		// (substituted at the call site); it may not name a defaulted
		// parameter -- there is no dependency order between defaults.
		var pdefault *Node = null;
		if (tok_consume(t, "=")) {
			pdefault = parse_assign(t);
			if (expr_refs_default_param(pdefault)) {
				error_at(pp, "a default value cannot reference another defaulted parameter");
			}
		}
		var pty *Type = parse_type(t);
		var is2word bool = is_aggregate(pty) && pty.size > 8 && pty.size <= 16;
		if (is2word) { rwords = rwords + 2; } else { rwords = rwords + 1; }
		var v *Var = declare_var(pn, pty, pp);
		v.by_ref = is_aggregate(pty) && abi_by_ref(pty.size);
		v.default = pdefault;
		// Comptime parameters occupy p0..p5 by position too, so a run of
		// six of them (f.nct == 6, allowed) leaves no register slot for
		// any regular parameter that follows even if its own word cost is
		// small -- treat that the same as a register-word overflow.
		if (rwords > abi_n_arg_regs() || nparams >= abi_n_arg_regs()) {
			if (is2word) {
				error_at(pp, "a str or struct parameter here would not fit in the argument registers (pass it earlier, or by pointer)");
			}
			if (f.extern) {
				error_at(pp, "an extern function takes at most six register words (SysV marshalling is register-only for now)");
			}
			v.arg_stack = true;
			v.no_reg = true;
			v.offset = (16 + 8 * stack_slot) as int;
			stack_slot = stack_slot + 1;
			f.n_stack_args = f.n_stack_args + 1;
		}
		set_func_param(f, nparams, v);
		nparams = nparams + 1;
		// gen_args carries at most 14 arguments through its placement
		// arrays; beyond that the overflow scan misses the tail and the
		// spill pushes never happen, so the callee reads garbage.
		if (nparams > 14) { error_at(pp, "too many parameters (at most 14)"); }
	}
	f.nparams = nparams;
	tok_expect(t, ")");
	if (interrupt_fn && nparams != 0) {
		error_at(p, "an interrupt handler takes no parameters");
	}

	// A dynamic value's type id is only stable within the compilation that
	// assigned it, so a `~` parameter or return cannot cross the object
	// boundary -- same rule as `extern ~var`.
	if (f.extern && ty_dynval_cache as i64 != 0) {
		var dpi int = 0;
		while (dpi < nparams) {
			if (func_param(f, dpi).ty as i64 == ty_dynval_cache as i64) {
				error_at(p, "an extern function cannot take or return a dynamic value");
			}
			dpi = dpi + 1;
		}
	}

	if (!tok_eq(*t, "{")) { f.ret = parse_type(t); }
	if (f.extern && ty_dynval_cache as i64 != 0 &&
	    f.ret as i64 == ty_dynval_cache as i64) {
		error_at(p, "an extern function cannot take or return a dynamic value");
	}
	// A *Gen(T) return type marks a generator candidate: `yield` is legal
	// only in its body, and the body is rewritten to a coroutine below when
	// it actually contains one. A Gen-returning function without yields is
	// an ordinary factory and is left alone.
	cur_gen_ret = null;
	if (gen_elem_of(f.ret) as i64 != 0) { cur_gen_ret = f.ret; }
	gen_yields_seen = false;
	gen_g_var = null;
	if (tok_eq(*t, ";")) {
		// `extern fn f(...) t;` -- a declaration only. A plain function
		// still has to have a body; a bare prototype needs the extern to
		// mean "the linker supplies this symbol".
		if (!f.extern) { error_at((*t).pos, "function declaration without a body needs 'extern'"); }
		f.body = null;
		*t = (*t).next;
	} else {
		var body_start i64 = (*t).pos;
		f.body = parse_block(t);
		// A `~` parameter arrives as a shallow DynVal copy: its ptr aliases
		// the caller's box, and the first write to the parameter would free
		// that box out from under the caller. Prepend `x = dyn_clone(x);`
		// so the parameter owns its payload from the start. Runs before the
		// generator rewrite below, so a generator body keeps its clones.
		if (ty_dynval_cache as i64 != 0 &&
		    !is_std_path(diag_path_of(diag_file_of(p)))) {
			var dpi int = 0;
			while (dpi < nparams) {
				var dv *Var = func_param(f, dpi);
				if (dv.ty as i64 == ty_dynval_cache as i64) {
					dyn_param_clone(dv, f.body, p);
				}
				dpi = dpi + 1;
			}
		}
		if (gen_yields_seen) { parse_generator_rewrite(f); }
		if (f.interpreted || f.dynamic) {
			interp_synthesize_trampoline(t, f, fn_start, body_start, (*t).pos);
		}
	}
	leave_scope();
	ntype_vars = saved_ntype_vars;
	cur_func = null;
	type_set_fn(null);
	return f;
}

// `fn (params) { body }` in an expression: an anonymous function. It is
// compiled to a hidden function of its own and this node is the address of
// that function, so the value is an ordinary fn value. No captures: a
// variable from an enclosing function is rejected (there is no environment
// to carry), which also means the return type can be inferred from the
// body's returns by type.qela.
fn lambda_capture_node(v *Var, p i64) *Node {
	var off i64 = -1;
	var c *LamCap = lam_cap_head;
	while (c as i64 != 0) {
		if (c.outer as i64 == v as i64) { off = c.off; }
		c = c.next;
	}
	if (off < 0) {
		if (lam_env as i64 == 0) {
			if (cur_func.nparams >= abi_n_arg_regs()) {
				error_at(p, "a lambda that captures takes one parameter fewer");
			}
			lam_env = declare_var("_$env", type_ptr(type_lookup("u8")), p);
			set_func_param(cur_func, cur_func.nparams, lam_env);
			cur_func.nparams = cur_func.nparams + 1;
		}
		var al i64 = v.ty.align as i64;
		if (al < 1) { al = 1; }
		lam_cap_size = (lam_cap_size + al - 1) & ~(al - 1);
		off = lam_cap_size;
		lam_cap_size = lam_cap_size + v.ty.size as i64;
		var nc *LamCap = arena_alloc(sizeof(LamCap), 8) as *LamCap;
		nc.outer = v;
		nc.off = off;
		if (lam_cap_head as i64 == 0) { lam_cap_head = nc; } else { lam_cap_tail.next = nc; }
		lam_cap_tail = nc;
	}
	var ev *Node = new_node(ND_VAR, p);
	ev.varp = lam_env;
	var add *Node = bin_node(ND_ADD, ev, num_node(off, p), p);
	var cst *Node = new_node(ND_CAST, p);
	cst.lhs = add;
	cst.ty = type_ptr(v.ty);
	var dr *Node = new_node(ND_DEREF, p);
	dr.lhs = cst;
	return dr;
}

fn lambda_env_build(name str, p i64) *Node {
	need_arena = true;
	var cb Buf;
	fmt_str(&cb, "_$clo");
	fmt_i64(&cb, lambda_seq as i64);
	var clo *Var = declare_var(buf_str(&cb), type_ptr(type_lookup("u8")), p);

	var cl0 *Node = new_node(ND_VAR, p);
	cl0.varp = clo;
	var alloc *Node = new_node(ND_CALL, p);
	alloc.name = "arena_alloc";
	alloc.args = num_node(lam_cap_size, p);
	alloc.args.next = num_node(8, p);
	alloc.nargs = 2;
	var chain *Node = bin_node(ND_ASSIGN, cl0, alloc, p);

	var fa *Node = new_node(ND_FUNCADDR, p);
	fa.name = name;
	chain = bin_node(ND_COMMA, chain, lambda_env_store(clo, 0, type_lookup("i64"), fa, p), p);

	var c *LamCap = lam_cap_head;
	while (c as i64 != 0) {
		var src *Node = new_node(ND_VAR, p);
		src.varp = c.outer;
		chain = bin_node(ND_COMMA, chain, lambda_env_store(clo, c.off, c.outer.ty, src, p), p);
		c = c.next;
	}

	var cl1 *Node = new_node(ND_VAR, p);
	cl1.varp = clo;
	var iv *Node = new_node(ND_CAST, p);
	iv.lhs = cl1;
	iv.ty = type_lookup("i64");
	var tagged *Node = bin_node(ND_BITOR, iv, num_node(1, p), p);
	return bin_node(ND_COMMA, chain, tagged, p);
}

fn lambda_env_store(clo *Var, off i64, ty *Type, val *Node, p i64) *Node {
	var cv *Node = new_node(ND_VAR, p);
	cv.varp = clo;
	var base *Node = cv;
	if (off != 0) { base = bin_node(ND_ADD, cv, num_node(off, p), p); }
	var cst *Node = new_node(ND_CAST, p);
	cst.lhs = base;
	cst.ty = type_ptr(ty);
	var dr *Node = new_node(ND_DEREF, p);
	dr.lhs = cst;
	return bin_node(ND_ASSIGN, dr, val, p);
}

fn parse_lambda(t **Token, p i64) *Node {
	var b Buf;
	fmt_str(&b, "_$lambda");
	fmt_i64(&b, lambda_seq as i64);
	lambda_seq = lambda_seq + 1;
	var name str = buf_str(&b);

	var f *Func = arena_alloc(sizeof(Func), 8) as *Func;
	f.name = name;
	f.ret = null;
	f.pos = p;
	var saved_func *Func = cur_func;
	cur_func = f;
	type_set_fn(f);

	enter_scope();
	var saved_lscope *Scope = lambda_scope;
	lambda_scope = scope_root;
	// A typed block may be in progress in an enclosing scope; a plain
	// lambda nested inside one still has no environment of its own.
	var saved_capturing bool = capturing;
	capturing = false;
	var saved_lam_cap bool = lam_capturing;
	var saved_cap_head *LamCap = lam_cap_head;
	var saved_cap_tail *LamCap = lam_cap_tail;
	var saved_cap_size i64 = lam_cap_size;
	var saved_env *Var = lam_env;
	lam_capturing = true;
	lam_cap_head = null;
	lam_cap_tail = null;
	lam_cap_size = 8;
	lam_env = null;
	// A lambda is its own function: `yield` inside one is an error even
	// when the lambda is nested in a generator body.
	var saved_gen_ret *Type = cur_gen_ret;
	var saved_gen_yields bool = gen_yields_seen;
	var saved_gen_g *Var = gen_g_var;
	cur_gen_ret = null;
	gen_yields_seen = false;
	gen_g_var = null;
	tok_expect(t, "(");
	var nparams int = 0;
	var rwords int = 0;
	while (!tok_eq(*t, ")")) {
		if (nparams > 0) { tok_expect(t, ","); }
		var pn str = (*t).text;
		var pp i64 = (*t).pos;
		*t = (*t).next;
		var pty *Type = parse_type(t);
		var is2word bool = is_aggregate(pty) && pty.size > 8 && pty.size <= 16;
		if (is2word) { rwords = rwords + 2; } else { rwords = rwords + 1; }
		var v *Var = declare_var(pn, pty, pp);
		v.by_ref = is_aggregate(pty) && abi_by_ref(pty.size);
		if (rwords > abi_n_arg_regs() || nparams >= abi_n_arg_regs()) {
			error_at(pp, "a lambda takes at most six one-word parameters");
		}
		set_func_param(f, nparams, v);
		nparams = nparams + 1;
	}
	f.nparams = nparams;
	tok_expect(t, ")");

	if (!tok_eq(*t, "{")) { f.ret = parse_type(t); }
	f.body = parse_block(t);
	leave_scope();
	lambda_scope = saved_lscope;
	capturing = saved_capturing;
	cur_gen_ret = saved_gen_ret;
	gen_yields_seen = saved_gen_yields;
	gen_g_var = saved_gen_g;
	cur_func = saved_func;
	type_set_fn(saved_func);

	add_func(f);

	var caps *LamCap = lam_cap_head;
	lam_capturing = saved_lam_cap;
	lam_cap_head = saved_cap_head;
	lam_cap_tail = saved_cap_tail;
	var size i64 = lam_cap_size;
	lam_cap_size = saved_cap_size;
	lam_env = saved_env;

	if (caps as i64 != 0) {
		var saved2 *LamCap = lam_cap_head;
		var saved2t *LamCap = lam_cap_tail;
		var saved2s i64 = lam_cap_size;
		lam_cap_head = caps;
		lam_cap_size = size;
		var built *Node = lambda_env_build(name, p);
		lam_cap_head = saved2;
		lam_cap_tail = saved2t;
		lam_cap_size = saved2s;
		if (f.ret as i64 != 0) {
			var full int = f.nparams;
			f.nparams = nparams;
			var fty *Type = func_type_of(f);
			f.nparams = full;
			var cst *Node = new_node(ND_CAST, p);
			cst.lhs = built;
			cst.ty = fty;
			return cst;
		}
		return built;
	}

	var n *Node = new_node(ND_FUNCADDR, p);
	n.name = name;
	return n;
}

// `T { stmts...; super v; }` as an expression: an inline value-producing
// block. Compiles to a hidden function called immediately in place, like a
// lambda, but reads of outer locals are captures instead of errors --
// `capture_get_or_add` (via the flip in parse_primary's "no closures"
// check) turns each one into a hidden by-value parameter the first time it
// is seen, and the call below passes the outer variables as the matching
// arguments. `super` is `return` inside this hidden function.
fn parse_typed_block(t **Token, p i64, ty *Type) *Node {
	if (cur_func as i64 != 0 && cur_func.naked) {
		error_at(p, "naked functions cannot use a typed block");
	}
	var b Buf;
	fmt_str(&b, "_$tblock");
	fmt_i64(&b, lambda_seq as i64);
	lambda_seq = lambda_seq + 1;
	var name str = buf_str(&b);

	var f *Func = arena_alloc(sizeof(Func), 8) as *Func;
	f.name = name;
	f.ret = ty;
	f.pos = p;
	var saved_func *Func = cur_func;
	cur_func = f;
	type_set_fn(f);

	enter_scope();
	var saved_lscope *Scope = lambda_scope;
	lambda_scope = scope_root;
	var saved_capturing bool = capturing;
	capturing = true;
	var saved_cap_head *Capture = cap_head;
	var saved_cap_tail *Capture = cap_tail;
	var saved_cap_n int = cap_n;
	var saved_cap_rwords int = cap_rwords;
	var saved_cap_stack_slot int = cap_stack_slot;
	cap_head = null;
	cap_tail = null;
	cap_n = 0;
	cap_rwords = 0;
	cap_stack_slot = 0;
	// A typed block is its own function: `yield` inside one is an error.
	var saved_gen_ret *Type = cur_gen_ret;
	var saved_gen_yields bool = gen_yields_seen;
	var saved_gen_g *Var = gen_g_var;
	cur_gen_ret = null;
	gen_yields_seen = false;
	gen_g_var = null;

	f.body = parse_block(t);
	f.nparams = cap_n;
	var call_cap *Capture = cap_head;
	var nargs int = cap_n;

	leave_scope();
	lambda_scope = saved_lscope;
	capturing = saved_capturing;
	cap_head = saved_cap_head;
	cap_tail = saved_cap_tail;
	cap_n = saved_cap_n;
	cap_rwords = saved_cap_rwords;
	cap_stack_slot = saved_cap_stack_slot;
	cur_gen_ret = saved_gen_ret;
	gen_yields_seen = saved_gen_yields;
	gen_g_var = saved_gen_g;
	cur_func = saved_func;
	type_set_fn(saved_func);

	add_func(f);

	var call *Node = new_node(ND_CALL, p);
	call.name = name;
	var ahead Node;
	var atail *Node = &ahead;
	var c *Capture = call_cap;
	while (c as i64 != 0) {
		var an *Node = new_node(ND_VAR, p);
		if (c.outer.is_global || !capturing) {
			an.varp = c.outer;
		} else {
			// The call site sits inside an enclosing typed block whose
			// captures are live again (cap_head and cur_func were restored
			// above). The argument must be that block's own copy of the
			// outer variable -- the only one its frame holds -- not the
			// original. A block that never referenced the variable itself
			// picks it up here, exactly as a body reference would.
			an.varp = capture_get_or_add(c.outer, p);
		}
		atail.next = an;
		atail = an;
		c = c.next;
	}
	call.args = ahead.next;
	call.nargs = nargs;
	return call;
}

fn parse_struct(t **Token) {
	var packed bool = tok_consume(t, "packed");
	tok_expect(t, "struct");
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;

	if (tok_consume(t, ";")) {
		if (type_lookup(name) as i64 == 0) {
			var ty *Type = arena_alloc(sizeof(Type), 8) as *Type;
			ty.kind = TY_STRUCT; ty.align = 8; ty.size = 8; ty.name = name;
			type_define(name, ty);
		}
		return;
	}

	var saved_tv int = ntype_vars;
	var tm *Tmpl = parse_tmpl_params(t, name, p);
	var ty *Type = null;
	if (tm as i64 != 0) {
		ty = tm.proto;
		ty.kind = TY_STRUCT;
	} else {
		ty = type_lookup(name);
		if (ty as i64 != 0 && ty.members as i64 != 0) { error_at(p, "redefinition"); }
		if (ty as i64 == 0) {
			ty = arena_alloc(sizeof(Type), 8) as *Type;
			ty.kind = TY_STRUCT; ty.name = name;
			type_define(name, ty);
		}
	}

	tok_expect(t, "{");
	var mhead Member;
	var mtail *Member = &mhead;
	var off int = 0; var align int = 1;
	var bitpos int = 0;
	var bitunit *Type = null;
	while (!tok_eq(*t, "}")) {
		if (mtail != &mhead) { tok_expect(t, ","); }
		if (tok_eq(*t, "}")) { break; }
		var fnm str = (*t).text;
		var fp i64 = (*t).pos;
		*t = (*t).next;
		var fty *Type = parse_type(t);
		var m *Member = arena_alloc(sizeof(Member), 8) as *Member;
		m.name = fnm; m.ty = fty; m.pos = fp;
		if (tok_consume(t, ":")) {
			if (fty.kind != TY_INT) { error_at(fp, "a bit field must have an integer type"); }
			var w i64 = (*t).val;
			if ((*t).kind != TK_NUM || w < 1 || w > (fty.size as i64) * 8) {
				error_at((*t).pos, "a bit field needs a width between 1 and the type's own bits");
			}
			*t = (*t).next;
			if (bitunit as i64 != 0 && same_type(bitunit, fty) &&
			    bitpos + (w as int) <= fty.size * 8) {
				m.offset = off - fty.size;
				m.bitoff = bitpos;
				m.bitw = w as int;
				bitpos = bitpos + (w as int);
			} else {
				if (!packed) { off = (off + fty.align - 1) & ~(fty.align - 1); }
				m.offset = off;
				m.bitoff = 0;
				m.bitw = w as int;
				off = off + fty.size;
				bitunit = fty;
				bitpos = w as int;
				if (fty.align > align) { align = fty.align; }
			}
			mtail.next = m; mtail = m;
			continue;
		}
		// A postfix string literal tags the field: `x i64 "json-key"` names
		// the JSON key, "-" omits the field. Stage1-only: stage0's struct
		// parser does not know it, and no bootstrap-subset file uses it.
		if ((*t).kind == TK_STR) {
			m.tag = (*t).sval;
			*t = (*t).next;
		}
		bitunit = null;
		bitpos = 0;
		if (!packed) { off = (off + fty.align - 1) & ~(fty.align - 1); }
		m.offset = off;
		off = off + fty.size;
		if (fty.align > align) { align = fty.align; }
		mtail.next = m; mtail = m;
	}
	tok_expect(t, "}");
	ty.members = mhead.next;
	ty.packed = packed;
	if (packed) { align = 1; }
	ty.align = align;
	ty.size = (off + align - 1) & ~(align - 1);
	ntype_vars = saved_tv;
}

fn parse_enum(t **Token) {
	tok_expect(t, "enum");
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;

	var saved_tv int = ntype_vars;
	var tm *Tmpl = parse_tmpl_params(t, name, p);
	var ty *Type = null;
	if (tm as i64 != 0) {
		ty = tm.proto;
		ty.kind = TY_ENUM; ty.align = 8;
	} else {
		ty = arena_alloc(sizeof(Type), 8) as *Type;
		ty.kind = TY_ENUM; ty.align = 8; ty.name = name;
		type_define(name, ty);
	}

	tok_expect(t, "{");
	var vhead Variant;
	var vtail *Variant = &vhead;
	var tag int = 0;
	var maxpay int = 0;
	while (!tok_eq(*t, "}")) {
		if (vtail != &vhead) { tok_expect(t, ","); }
		if (tok_eq(*t, "}")) { break; }
		var vnm str = (*t).text;
		var vp i64 = (*t).pos;
		*t = (*t).next;
		var dv *Variant = vhead.next;
		while (dv as i64 != 0) {
			if (str_eq(dv.name, vnm)) {
				emsg("duplicate variant '"); emsg(vnm); emsg("'"); efail(vp);
			}
			dv = dv.next;
		}
		// match's arm_seen is a fixed 64-entry table, so an enum cannot
		// have more variants than that.
		if (tag == 64) { error_at(vp, "at most 64 variants are supported"); }
		var v *Variant = arena_alloc(sizeof(Variant), 8) as *Variant;
		v.name = vnm; v.tag = tag; v.pos = vp; tag = tag + 1;

		if (tok_consume(t, "(")) {
			var fhead Member;
			var ftail *Member = &fhead;
			var voff int = 8;
			var nf int = 0;
			while (!tok_eq(*t, ")")) {
				if (ftail != &fhead) { tok_expect(t, ","); }
				var fty *Type = parse_type(t);
				voff = (voff + fty.align - 1) & ~(fty.align - 1);
				var m *Member = arena_alloc(sizeof(Member), 8) as *Member;
				m.ty = fty; m.offset = voff; m.pos = vp;
				voff = voff + fty.size;
				nf = nf + 1;
				ftail.next = m; ftail = m;
			}
			tok_expect(t, ")");
			v.fields = fhead.next;
			v.nfields = nf;
			if (voff - 8 > maxpay) { maxpay = voff - 8; }
		}
		vtail.next = v; vtail = v;
	}
	tok_expect(t, "}");
	ty.variants = vhead.next;
	ty.size = ((8 + maxpay + 7) & ~7) as int;
	ntype_vars = saved_tv;
}

fn trunc_to(v i64, ty *Type) i64 {
	if (ty.size == 1) {
		if (ty.is_unsigned || ty.kind == TY_BOOL) { return v & 255; }
		return ((v & 255) ^ 128) - 128;
	}
	if (ty.size == 2) {
		if (ty.is_unsigned) { return v & 0xffff; }
		return ((v & 0xffff) ^ 0x8000) - 0x8000;
	}
	if (ty.size == 4) {
		if (ty.is_unsigned) { return v & 0xffffffff; }
		return ((v & 0xffffffff) ^ 0x80000000) - 0x80000000;
	}
	return v;
}

fn eval_const(n *Node) i64 {
	var k int = n.kind;
	if (k == ND_NUM) { return n.val; }
	// A reference to a constant global (`let K = 5;`) folds to its
	// initializer; every has_init global's initializer is constant by
	// construction (global initializers fold at declaration). A local is
	// never a compile-time constant.
	if (k == ND_VAR) {
		if (n.varp as i64 != 0 && n.varp.is_global && n.varp.has_init) {
			return n.varp.init;
		}
		error_at(n.pos, "this is not a compile-time constant");
	}
	if (k == ND_IFEXPR) {
		if (eval_const(n.cond) != 0) { return eval_const(n.then); }
		return eval_const(n.els);
	}
	if (k == ND_NEG) {
		// A float constant negates by flipping the IEEE sign bit, not by
		// two's-complementing the stored bits (a literal keeps its f64
		// pattern, so `-x` of that would be garbage).
		var nv i64 = eval_const(n.lhs);
		if (n.lhs.ty as i64 != 0 && is_float(n.lhs.ty)) {
			var mask i64 = 0x8000000000000000;
			if (n.lhs.ty.size == 4) { mask = 0x80000000; }
			return nv ^ mask;
		}
		return -nv;
	}
	if (k == ND_BITNOT) { return ~eval_const(n.lhs); }
	if (k == ND_NOT) { if (eval_const(n.lhs) == 0) { return 1; } return 0; }
	if (k == ND_CAST) {
		var v i64 = eval_const(n.lhs);
		if (n.ty.kind == TY_BOOL) { if (v != 0) { return 1; } return 0; }
		return trunc_to(v, n.ty);
	}
	if (k == ND_COMPTIME) { return n.val; }
	if (k == ND_SIZEOF) { return n.typeval.size as i64; }
	if (k == ND_ADD) { return eval_const(n.lhs) + eval_const(n.rhs); }
	if (k == ND_SUB) { return eval_const(n.lhs) - eval_const(n.rhs); }
	if (k == ND_MUL) { return eval_const(n.lhs) * eval_const(n.rhs); }
	if (k == ND_BITAND) { return eval_const(n.lhs) & eval_const(n.rhs); }
	if (k == ND_BITOR) { return eval_const(n.lhs) | eval_const(n.rhs); }
	if (k == ND_BITXOR) { return eval_const(n.lhs) ^ eval_const(n.rhs); }
	if (k == ND_SHL) { return eval_const(n.lhs) << eval_const(n.rhs); }
	if (k == ND_SHR) { return eval_const(n.lhs) >> eval_const(n.rhs); }
	if (k == ND_EQ) { if (eval_const(n.lhs) == eval_const(n.rhs)) { return 1; } return 0; }
	if (k == ND_NE) { if (eval_const(n.lhs) != eval_const(n.rhs)) { return 1; } return 0; }
	if (k == ND_LT) { if (eval_const(n.lhs) < eval_const(n.rhs)) { return 1; } return 0; }
	if (k == ND_LE) { if (eval_const(n.lhs) <= eval_const(n.rhs)) { return 1; } return 0; }
	if (k == ND_DIV || k == ND_MOD) {
		var d i64 = eval_const(n.rhs);
		if (d == 0) { error_at(n.pos, "division by zero in a constant expression"); }
		if (k == ND_DIV) { return eval_const(n.lhs) / d; }
		return eval_const(n.lhs) % d;
	}
	error_at(n.pos, "initializer must be a constant expression");
	return 0;
}

// "std/..." names the library the compiler carries inside itself. A file of
// the same name on disk wins, so the shipped modules stay editable.
fn is_std_path(s str) bool {
	if (s.len < 4) { return false; }
	return s.ptr[0] == 's' && s.ptr[1] == 't' && s.ptr[2] == 'd' && s.ptr[3] == '/';
}

fn blob_find(name str) int {
	var i int = 0;
	var n int = std_blob_count();
	while (i < n) {
		if (str_eq(std_blob_name(i), name)) { return i; }
		i = i + 1;
	}
	return -1;
}

fn parse_global(t **Token, is_extern bool, is_eval bool) {
	var kw str = (*t).text;
	var is_tls bool = str_eq(kw, "tvar");
	var typed bool = str_eq(kw, "var") || is_tls;
	*t = (*t).next;
	var name str = (*t).text;
	var p i64 = (*t).pos;
	*t = (*t).next;
	var ty *Type = null;
	if (typed && !tok_eq(*t, "=")) { ty = parse_type(t); }
	var init i64 = 0;
	var has_init bool = false;
	if (tok_consume(t, "=")) {
		has_init = true;
		var rhs *Node = parse_assign(t);
		add_type(rhs);
		if (ty as i64 == 0) { ty = rhs.ty; }
		init = eval_const(rhs);
	}
	if (is_extern && ty as i64 == 0) {
		error_at(p, "extern var needs a type");
	}
	// A dynamic global would need a function scope for its box rewrites,
	// and its type id is not stable across the object boundary -- same
	// rule as `extern fn` and the local-only `~` of the first cut.
	if (ty as i64 != 0 && ty_dynval_cache as i64 != 0 && ty as i64 == ty_dynval_cache as i64) {
		error_at(p, "a global cannot be dynamic");
	}
	if (is_tls && is_extern) { error_at(p, "tvar cannot be extern"); }
	var gv *Var = declare_var(name, ty, p);
	gv.extern = is_extern;
	gv.has_init = has_init;
	gv.init = init;
	gv.is_tls = is_tls;
	gv.eval_export = is_eval;
	tok_expect(t, ";");
}

// "dir/../std/x.qela" normalizes to "std/x.qela", so the same module
// reached through two relative spellings dedups in the file table.
fn path_norm(p str) str {
	var parts [16]str;
	var n int = 0;
	var i i64 = 0;
	var start i64 = 0;
	while (i <= p.len) {
		if (i == p.len || p.ptr[i] == '/') {
			var part str;
			part.ptr = p.ptr + start;
			part.len = i - start;
			if (part.len == 2 && part.ptr[0] == '.' && part.ptr[1] == '.') {
				if (n > 0) { n = n - 1; }
			} else if (!(part.len == 1 && part.ptr[0] == '.')) {
				parts[n] = part;
				n = n + 1;
			}
			start = i + 1;
		}
		i = i + 1;
	}
	var b Buf;
	var k int = 0;
	while (k < n) {
		if (k > 0) { buf_u8(&b, '/'); }
		buf_bytes(&b, parts[k].ptr, parts[k].len);
		k = k + 1;
	}
	return buf_str(&b);
}

// Loads a module and splices its tokens before `tok`, unless a file of
// that path is already in the table. Returns the new head of the stream.
fn splice_import(tok *Token, path str, pos i64) *Token {
	path = path_norm(path);
	if (diag_already_imported(path)) { return tok; }
	var isrc str;
	if (file_exists(path)) {
		isrc = read_file(path);
	} else {
		var bi int = blob_find(path);
		if (bi < 0) {
			emsg("cannot open "); emsg(path); efail(pos);
		}
		isrc = std_blob_src(bi);
	}
	var fid int = diag_add_file(path, isrc);
	var ihead *Token = lex(isrc, (fid as i64) << FILE_SHIFT);
	var itail *Token = ihead;
	while (itail.next as i64 != 0 && itail.next.kind != TK_EOF) {
		itail = itail.next;
	}
	itail.next = tok;
	return ihead;
}

fn parse(tok *Token) *Unit {
	enter_scope();
	var head Func;
	while (true) {
		// An interpolated string was desugared somewhere in the previous
		// top-level item; the formatting helpers are std/fmt.qela. It is
		// imported here, at top level, so the splice cannot land inside a
		// function body. Checked before the EOF test: a file whose last
		// item used interpolation has no iteration left otherwise. One
		// file of the same path already in the table (an explicit user
		// import) makes this a no-op.
		if (need_fmt) {
			need_fmt = false;
			tok = splice_import(tok, "std/fmt.qela", tok.pos);
		}
		if (need_dyn) {
			need_dyn = false;
			tok = splice_import(tok, "std/dyn.qela", tok.pos);
		}
		if (need_arena) {
			need_arena = false;
			tok = splice_import(tok, "std/arena.qela", tok.pos);
		}
		if (need_interp) {
			need_interp = false;
			tok = splice_import(tok, "std/interpcall.qela", tok.pos);
		}
		resolve_comptime(&tok);
		if (tok.kind == TK_EOF) { break; }
		if (tok_eq(tok, "asm") && tok.next.kind == TK_PUNCT && tok_eq(tok.next, "{")) {
			parse_top_asm(&tok); continue;
		}
		if (tok_eq(tok, "$") && tok_eq(tok.next, "flag")) { parse_source_flag(&tok); continue; }
		if (tok_eq(tok, "entry")) { parse_entry(&tok); continue; }
		if (tok_eq(tok, "macro")) { parse_macro(&tok); continue; }
		if (tok_eq(tok, "struct")) { parse_struct(&tok); continue; }
		if (tok_eq(tok, "packed") && tok_eq(tok.next, "struct")) { parse_struct(&tok); continue; }
		if (tok_eq(tok, "enum")) { parse_enum(&tok); continue; }
		if (tok_eq(tok, "let") || tok_eq(tok, "var") || tok_eq(tok, "tvar")) { parse_global(&tok, false, false); continue; }
		if (tok_eq(tok, "extern") && tok.next.kind == TK_KW && str_eq(tok.next.text, "var")) {
			// `extern var x i64;` imports the C symbol, `extern var x i64 = K;`
			// exports a Qela global. Same split as extern fn, keyed on the
			// initializer.
			tok = tok.next;
			parse_global(&tok, true, false);
			continue;
		}
		if (tok_eq(tok, "eval") && tok.next.kind == TK_KW && str_eq(tok.next.text, "var")) {
			tok = tok.next;
			parse_global(&tok, false, true);
			continue;
		}
		if (tok_eq(tok, "import")) {
			var ipos i64 = tok.pos;
			tok = tok.next;
			if (tok.kind != TK_STR) { error_at(tok.pos, "import needs a string path"); }
			var raw str = tok.sval;
			tok = tok.next;
			tok_expect(&tok, ";");

			var path str = raw;
			if (!is_std_path(raw)) {
				var pb Buf;
				fmt_str(&pb, diag_file_dir(diag_file_of(ipos)));
				fmt_str(&pb, raw);
				path = buf_str(&pb);
			}
			tok = splice_import(tok, path, ipos);
			continue;
		}
		// `extern fn f(...) t;` -- a declaration without a body -- declares a
		// symbol the linker must provide, and `extern fn f(...) t { ... }`
		// exports the function's symbol for the C side. Both only matter
		// under `-c`; a plain compile cannot resolve the former (no linker).
		var is_ext bool = false;
		if (tok_eq(tok, "extern")) {
			if (tok.next.kind != TK_KW || !str_eq(tok.next.text, "fn")) {
				error_at(tok.pos, "expected 'fn' or 'var' after 'extern'");
			}
			is_ext = true;
			tok = tok.next;
		}
		var is_eval_fn bool = false;
		if (tok_eq(tok, "eval") && tok.next.kind == TK_KW && str_eq(tok.next.text, "fn")) {
			is_eval_fn = true;
			tok = tok.next;
		}
		var nf *Func = parse_function(&tok, is_ext);
		nf.eval_export = is_eval_fn;
		// Appending through funcs_tail keeps mid-parse instantiations
		// (a generic call typed by a var initializer) and lambdas in the
		// list: the local chain alone would orphan them on the next append.
		if (funcs_tail as i64 == 0) { head.next = nf; }
		else { funcs_tail.next = nf; }
		funcs_tail = nf;
		// A lambda parsed inside this function may have seeded the list
		// before head.next was set; anchor the chain on the first entry.
		if (head.next as i64 == 0) { head.next = all_funcs; }
		all_funcs = head.next;
	}

	if (find_func("abi_spawn") as i64 != 0 && find_func("__eval_call_dispatch") as i64 == 0) {
		var db Buf;
		fmt_str(&db, "fn __eval_call_dispatch(name str, args *u8, __b *Buf) bool { if (name.ptr as i64 == args as i64 || __b.p as i64 != __b.p as i64) { return false; }");
		var ef *Func = all_funcs;
		while (ef as i64 != 0) {
			if (ef.eval_export && ef.nct == 0) {
				interp_sig_reject(ef.ret, ef.pos, "return type");
				var ei int = 0;
				while (ei < ef.nparams) {
					interp_sig_reject(func_param(ef, ei).ty, ef.pos, "parameter type");
					ei = ei + 1;
				}
				fmt_str(&db, " if (str_eq(name, \"");
				fmt_str(&db, ef.name);
				fmt_str(&db, "\")) {");
				interp_gen_eval_body(&db, ef);
				fmt_str(&db, " return true; }");
			}
			ef = ef.next;
		}
		fmt_str(&db, " return false; }");

		var dfile int = diag_add_file("<eval-dispatch>", buf_str(&db));
		var dtoks *Token = lex(buf_str(&db), (dfile as i64) << FILE_SHIFT);
		var dnf *Func = parse_function(&dtoks, false);
		if (funcs_tail as i64 == 0) { head.next = dnf; }
		else { funcs_tail.next = dnf; }
		funcs_tail = dnf;
		if (head.next as i64 == 0) { head.next = all_funcs; }
		all_funcs = head.next;
	}

	if (find_func("abi_spawn") as i64 != 0 && find_func("__eval_get_dispatch") as i64 == 0) {
		var gb Buf;
		fmt_str(&gb, "fn __eval_get_dispatch(__name str) str { if (__name.len < 0) { var e str; return e; }");
		var gv *Var = global_vars;
		while (gv as i64 != 0) {
			if (gv.eval_export) {
				interp_sig_reject_var(gv.ty, gv.pos, "global type");
				fmt_str(&gb, " if (str_eq(__name, \"");
				fmt_str(&gb, gv.name);
				fmt_str(&gb, "\")) { var __b Buf;");
				interp_gen_marshal(&gb, gv.name, gv.ty);
				fmt_str(&gb, " return buf_str(&__b); }");
			}
			gv = gv.next;
		}
		fmt_str(&gb, " var e str; return e; }");

		var gfile int = diag_add_file("<eval-get-dispatch>", buf_str(&gb));
		var gtoks *Token = lex(buf_str(&gb), (gfile as i64) << FILE_SHIFT);
		var gnf *Func = parse_function(&gtoks, false);
		if (funcs_tail as i64 == 0) { head.next = gnf; }
		else { funcs_tail.next = gnf; }
		funcs_tail = gnf;
		if (head.next as i64 == 0) { head.next = all_funcs; }
		all_funcs = head.next;
	}

	if (find_func("abi_spawn") as i64 != 0 && find_func("__eval_set_dispatch") as i64 == 0) {
		var sb Buf;
		fmt_str(&sb, "fn __eval_set_dispatch(__name str, __p *u8) { if (__name.ptr as i64 == __p as i64) { return; }");
		var sv *Var = global_vars;
		while (sv as i64 != 0) {
			if (sv.eval_export) {
				interp_sig_reject_var(sv.ty, sv.pos, "global type");
				fmt_str(&sb, " if (str_eq(__name, \"");
				fmt_str(&sb, sv.name);
				fmt_str(&sb, "\")) { var __cur *u8 = __p;");
				interp_gen_global_decode(&sb, sv.name, sv.ty);
				fmt_str(&sb, " return; }");
			}
			sv = sv.next;
		}
		fmt_str(&sb, " }");

		var sfile int = diag_add_file("<eval-set-dispatch>", buf_str(&sb));
		var stoks *Token = lex(buf_str(&sb), (sfile as i64) << FILE_SHIFT);
		var snf *Func = parse_function(&stoks, false);
		if (funcs_tail as i64 == 0) { head.next = snf; }
		else { funcs_tail.next = snf; }
		funcs_tail = snf;
		if (head.next as i64 == 0) { head.next = all_funcs; }
		all_funcs = head.next;
	}

	if (find_func("abi_spawn") as i64 != 0 && find_func("__interp_all_src") as i64 == 0) {
		var cb Buf;
		interp_emit_types(&cb);
		// eval fns are host functions; the child gets their signatures as
		// bodyless extern declarations so a call from eval'd or
		// interpreted code types correctly, then routes to the host (see
		// ip_call_node's extern+abi-mode branch).
		var ed *Func = all_funcs;
		while (ed as i64 != 0) {
			if (ed.eval_export && ed.nct == 0) {
				fmt_str(&cb, "extern fn ");
				fmt_str(&cb, ed.name);
				fmt_str(&cb, "(");
				var edi int = 0;
				while (edi < ed.nparams) {
					if (edi > 0) { fmt_str(&cb, ", "); }
					var edv *Var = func_param(ed, edi);
					fmt_str(&cb, edv.name);
					fmt_str(&cb, " ");
					fmt_str(&cb, type_name(edv.ty));
					edi = edi + 1;
				}
				fmt_str(&cb, ") ");
				if (ed.ret.kind != TY_VOID) {
					fmt_str(&cb, type_name(ed.ret));
					fmt_str(&cb, " ");
				}
				fmt_str(&cb, ";\n");
			}
			ed = ed.next;
		}
		// eval vars are host globals; the child gets their declarations as
		// bodyless extern vars so an eval'd read or write types correctly,
		// then routes to the host (see ip_ev_var/ip_assign's extern+abi-mode
		// branches).
		var eg *Var = global_vars;
		while (eg as i64 != 0) {
			if (eg.eval_export) {
				fmt_str(&cb, "extern var ");
				fmt_str(&cb, eg.name);
				fmt_str(&cb, " ");
				fmt_str(&cb, type_name(eg.ty));
				fmt_str(&cb, ";\n");
			}
			eg = eg.next;
		}
		var cf *Func = all_funcs;
		while (cf as i64 != 0) {
			if ((cf.interpreted || cf.dynamic) && cf.nct == 0) {
				var cfid int = diag_file_of(cf.pos);
				var csrc str = diag_src_of(cfid);
				var cbody str = str_slice(csrc, diag_offset_of(cf.body_start), diag_offset_of(cf.src_end));
				fmt_str(&cb, "fn ");
				if (cf.dynamic) { fmt_str(&cb, "dynamic "); } else { fmt_str(&cb, "interpreted "); }
				fmt_str(&cb, cf.name);
				fmt_str(&cb, "(");
				var cpi int = 0;
				while (cpi < cf.nparams) {
					if (cpi > 0) { fmt_str(&cb, ", "); }
					var cpv *Var = func_param(cf, cpi);
					fmt_str(&cb, cpv.name);
					fmt_str(&cb, " ");
					fmt_str(&cb, type_name(cpv.ty));
					cpi = cpi + 1;
				}
				fmt_str(&cb, ") ");
				if (cf.ret.kind != TY_VOID) {
					fmt_str(&cb, type_name(cf.ret));
					fmt_str(&cb, " ");
				}
				fmt_str(&cb, cbody);
				buf_u8(&cb, '\n');
			}
			cf = cf.next;
		}
		var escaped_all str = interp_escape_src(buf_str(&cb), 0);

		var ab Buf;
		fmt_str(&ab, "fn __interp_all_src() str { return ");
		fmt_str(&ab, escaped_all);
		fmt_str(&ab, "; }");

		var afile int = diag_add_file("<interp-all-src>", buf_str(&ab));
		var atoks *Token = lex(buf_str(&ab), (afile as i64) << FILE_SHIFT);
		var anf *Func = parse_function(&atoks, false);
		if (funcs_tail as i64 == 0) { head.next = anf; }
		else { funcs_tail.next = anf; }
		funcs_tail = anf;
		if (head.next as i64 == 0) { head.next = all_funcs; }
		all_funcs = head.next;
	}

	leave_scope();

	var f *Func = head.next;
	while (f as i64 != 0) {
		if (find_func(f.name) as i64 != f as i64) {
			emsg("redefinition of function '"); emsg(f.name); emsg("'"); efail(f.pos);
		}
		if (f.nct == 0) {
			type_func(f);
			opt_func(f);
			elide_bounds(f);
			regalloc(f);
			count_reads(f);
			warn_unused(f);

			var off i64 = (f.nsaved as i64) * 8;
			var v *Var = f.locals;
			while (v as i64 != 0) {
				if (!v.has_reg && !v.arg_stack) {
					var size i64 = v.ty.size as i64;
					var al i64 = v.ty.align as i64;
					if (v.by_ref) { size = 8; al = 8; }
					else if (size < 8) { size = 8; }
					off = (off + size + al - 1) & ~(al - 1);
					v.offset = off as int;
				}
				v = v.next;
			}
			f.stack_size = ((off + 15) & ~15) as int;
		}
		f = f.next;
	}

	var u *Unit = arena_alloc(sizeof(Unit), 8) as *Unit;
	u.funcs = head.next;
	u.globals = global_vars;
	u.strs = strlist_head;
	u.nstrs = nstrs;
	return u;
}
