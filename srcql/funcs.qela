import "comp.qela";

var all_funcs *Func;
var funcs_tail *Func;

fn add_func(f *Func) {
	if (all_funcs as i64 == 0) { all_funcs = f; }
	else { funcs_tail.next = f; }
	funcs_tail = f;
}

fn find_func(name str) *Func {
	var f *Func = all_funcs;
	while (f as i64 != 0) {
		if (str_eq(f.name, name)) { return f; }
		f = f.next;
	}
	return null;
}
