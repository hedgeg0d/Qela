var flags [512]u8;
fn main() int {
	var i int = 0;
	while (i < 512) { flags[i] = 1; i = i + 1; }
	var count int = 0;
	i = 2;
	while (i < 512) {
		if (flags[i] != 0) {
			count = count + 1;
			var j int = i + i;
			while (j < 512) { flags[j] = 0; j = j + i; }
		}
		i = i + 1;
	}
	return count & 255;
}
