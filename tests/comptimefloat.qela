// stage1-only
// expect-exit: 0
// Integer-only IEEE754 evaluation in comptime: normal arithmetic, f32
// narrowing, signed zero, infinities and NaN all become runtime literals.
fn half(x f64) f64 { return x / 2.0; }

fn main() int {
	let base = comptime { return 1.5; };
	let add = comptime { return 1.5 + 2.25; };
	let mul = comptime { return 1.25 * 3.0; };
	let div = comptime { return 7.0 / 2.0; };
	let short = $c("1.5 + 2.25");
	let sum32 = comptime { return (16777217.0 as f32) + (1.0 as f32); };
	let narrow = comptime { return 16777217.0 as f32; };
	let tie = comptime { return (1.0 as f32) + (1.0 as f32) / (16777216.0 as f32); };
	let cancel = comptime { return (10000000000000000.0 + 1.0) - 10000000000000000.0; };
	let tiny = comptime { return 5e-324 + 5e-324; };
	let neg = comptime { return 0.0 + -2.5; };
	let zero_false = comptime {
		if (-0.0) { return false; }
		return !(-0.0) && !(-0.0 as bool);
	};
	let edges = comptime {
		var x = 1.0;
		x += 1.0 / 9007199254740992.0;
		var minsub = 1e-323 / 2.0;
		var under = 5e-324 / 2.0;
		return x == 1.0 && minsub == 5e-324 && under == 0.0 &&
		       half(7.0) == 3.5 && 1.7976931348623157e308 * 2.0 > 1.7976931348623157e308;
	};
	let inf = comptime { return 1.0 / 0.0; };
	let ninf = comptime { return 1.0 / -0.0; };
	let special = comptime {
		var n = 0.0 / 0.0;
		var pi = 1.0 / 0.0;
		var ni = 1.0 / -0.0;
		return !(n == n) && !(n < 0.0) && !(n <= 0.0) && pi > 1.0 && ni < 0.0;
	};
	if (base != 1.5 || add != 3.75 || mul != 3.75 || div != 3.5 || short != 3.75) { return 1; }
	if (sum32 != (16777216.0 as f32) || narrow != (16777216.0 as f32)) { return 2; }
	if (tie != (1.0 as f32) || cancel != 0.0 || tiny != 1e-323) { return 3; }
	if (!special) { return 4; }
	if (!(inf > 1.0) || !(ninf < 0.0)) { return 5; }
	if (neg != -2.5 || !zero_false) { return 6; }
	if (!edges) { return 7; }
	return 0;
}
