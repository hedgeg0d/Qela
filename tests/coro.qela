// stage1-only
// expect-exit: 0
// expect-out: 12312312
// Coroutines round-robin: three workers with 3, 3 and 2 rounds print their
// id before every yield, so the log is 12312312.
import "std/coro.qela";
import "std/fmt.qela";

var log Buf;

fn worker(id i64, rounds i64) {
	var i i64 = 0;
	while (i < rounds) {
		fmt_i64(&log, id);
		coro_yield();
		i = i + 1;
	}
}

fn main() int {
	spawn worker(1, 3);
	spawn worker(2, 3);
	spawn worker(3, 2);
	coro_run_all();
	if (log.n != 8) { return 1; }
	if (log.p[0] != '1' || log.p[1] != '2' || log.p[2] != '3') { return 2; }
	if (log.p[6] != '1' || log.p[7] != '2') { return 3; }
	$if (TARGET != "x86_64") {
		syscall(64, 1, log.p, log.n);
	} $else {
		syscall(1, 1, log.p, log.n);
	}
	return 0;
}
