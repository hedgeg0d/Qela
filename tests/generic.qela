// expect-exit: 42
// The type variable of a generic function has to be substituted for the
// concrete type. While it was not, a T-typed value silently kept the 8-byte
// size of the variable itself and overwrote its neighbours in memory.
fn swap(comptime T: type, a *T, b *T) {
	var tmp T = *a;
	*a = *b;
	*b = tmp;
}
struct Small { a i64, b i64, }

fn sizeof_of(comptime T: type) i64 { return sizeof(T); }

fn main() int {
	var arr [4]u8;
	arr[0] = 1; arr[1] = 2; arr[2] = 3; arr[3] = 4;
	swap(u8, &arr[0], &arr[1]);
	if (arr[0] != 2) { return 1; }
	if (arr[1] != 1) { return 2; }
	if (arr[2] != 3) { return 3; }
	if (arr[3] != 4) { return 4; }

	var w [4]i16;
	w[0] = 300; w[1] = 1; w[2] = 2; w[3] = 3;
	swap(i16, &w[0], &w[1]);
	if (w[0] != 1) { return 5; }
	if (w[1] != 300) { return 6; }
	if (w[2] != 2) { return 7; }

	var s Small;
	s.a = 9; s.b = 8;
	var s2 Small;
	s2.a = 1; s2.b = 2;
	swap(Small, &s, &s2);
	if (s.a != 1 || s.b != 2) { return 8; }
	if (s2.a != 9 || s2.b != 8) { return 9; }

	if (sizeof_of(u8) != 1) { return 10; }
	if (sizeof_of(Small) != 16) { return 11; }
	return 42;
}
