// stage1-only
// expect-exit: 0
// expect-out: true-false-true-true-false-1
// `a < b <= c`: chained comparisons. Every middle operand is evaluated at
// most once, a comparison only when the one before it held, and `>` and
// `>=` chain like their flipped forms. `-` after the results: the printed
// sum of the three tests.
import "std/fmt.qela";

fn main() int {
	var z i64 = 5;
	var a bool = 0 <= z < 10;
	var b bool = 2 < 1 < 3;
	var c bool = 10 > z > 0;
	var d bool = 1 < 2 < 3;
	var e bool = 3 >= z >= 3;
	var o = fmt_begin();
	o = fmt_put_bool(o, a);
	o = fmt_put_str(o, "-");
	o = fmt_put_bool(o, b);
	o = fmt_put_str(o, "-");
	o = fmt_put_bool(o, c);
	o = fmt_put_str(o, "-");
	o = fmt_put_bool(o, d);
	o = fmt_put_str(o, "-");
	o = fmt_put_bool(o, e);
	o = fmt_put_str(o, "-");
	o = fmt_put_i64(o, side_effect());
	var r = fmt_result(o);
	sys_write(1, r.ptr, r.len);
	return 0;
}

// f() must run exactly once per chain, and g() not at all when the first
// compare already fails: the chain evaluates middles lazily.
fn side_effect() i64 {
	var n i64 = 0;
	if (f() < 2 < 5) { n = n + 1; }
	if (5 < 2 < f()) { n = n + 1; }
	return n;
}

var calls i64 = 0;

fn f() i64 {
	calls = calls + 1;
	return 1;
}
