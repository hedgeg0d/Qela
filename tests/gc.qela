// stage1-only
// expect-exit: 42
// The collector keeps the reachable list alive through two collections
// while reclaiming the junk allocated between them.
import "std/gc.qela";

struct Node { val i64, next *Node, }

var head *Node;

fn push(v i64) {
	var n *Node = gc_alloc(sizeof(Node)) as *Node;
	n.val = v;
	n.next = head;
	head = n;
}

fn sum() i64 {
	var t i64 = 0;
	var p *Node = head;
	while (p as i64 != 0) { t = t + p.val; p = p.next; }
	return t;
}

fn main() int {
	var i i64 = 0;
	while (i < 50) { push(i); i = i + 1; }
	var before i64 = sum();

	i = 0;
	while (i < 2000) { var junk *u8 = gc_alloc(64); junk[0] = 1; i = i + 1; }
	var peak i64 = gc_live_bytes();
	gc_collect();
	var kept i64 = gc_live_bytes();
	if (sum() != before) { return 1; }
	if (kept >= peak) { return 2; }
	if (kept == 0) { return 3; }

	i = 0;
	while (i < 1000) { var junk2 *u8 = gc_alloc(32); junk2[0] = 2; i = i + 1; }
	var peak2 i64 = gc_live_bytes();
	gc_collect();
	var kept2 i64 = gc_live_bytes();
	if (sum() != before) { return 4; }
	if (kept2 >= peak2) { return 5; }
	return 42;
}
