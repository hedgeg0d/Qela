// expect-exit: 97
// The step of an inner loop may be a variable the enclosing elided loop
// bounds: inside `while (i < 512)` the value of i is known to be 0 <= i < 512
// across the body, so `j = j + i` is a non-negative step and the inner
// `flags[j]` check is dropped too -- the sieve still counts 97 primes below
// 512. The `+=` form is the same shape.
var flags [512]u8;
var seen [512]u8;
fn main() int {
	var i int = 0;
	while (i < 512) { flags[i] = 1; i = i + 1; }
	var count int = 0;
	i = 2;
	while (i < 512) {
		if (flags[i] != 0) {
			count = count + 1;
			var j int = i + i;
			while (j < 512) { flags[j] = 0; j += i; }
		}
		i = i + 1;
	}
	// The same nested shape again, writing a different array, counted
	// separately so a wrong elision would show up as a wrong total.
	var marks int = 0;
	i = 3;
	while (i < 512) {
		var j int = i;
		while (j < 512) { seen[j] = 1; marks = marks + 1; j = j + i; }
		i = i + 1;
	}
	if (marks == 0) { return 1; }
	return count & 255;
}
