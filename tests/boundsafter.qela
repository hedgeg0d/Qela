// stage1-only
// expect-exit: 134
// expect-out: index out of bounds
// An access after the increment sees i == N, so only accesses before it
// are elidable; this second access must keep its check and panic at
// a[8].
fn main() int {
	var a [8]int;
	var i int = 0;
	while (i < 8) {
		a[i] = 1;
		i = i + 1;
		a[i] = 2;
	}
	return a[0];
}
