// stage1-only
// expect-exit: 42
// A tvar whose initializer is all zeros carries no bytes in the file: the
// block is reserved past the file-backed data and the kernel zero-fills it,
// and the copy tls_init makes is zeros over already-zeroed anonymous
// memory. What this pins: the value reads as zero in the main thread, a
// write sticks, a second thread gets its own zeroed copy, and the child's
// writes never reach the parent's copy.
import "std/sys.qela";

tvar slots [64]i64;
tvar count i64;

var child_seen i64 = -1;
var done i64 = 0;

fn child(arg i64) i64 {
	tls_init();
	child_seen = slots[63] + count;
	slots[0] = 5;
	count = 6;
	atomic_store(&done, 1);
	return 0;
}

fn main() int {
	if (count != 0) { return 1; }
	if (slots[0] != 0) { return 2; }
	if (slots[63] != 0) { return 3; }
	slots[7] = 99;
	count = 4;
	if (slots[7] != 99) { return 4; }
	if (count != 4) { return 5; }

	var stack_size i64 = 65536;
	var stack i64 = sys_mmap_anon(stack_size);
	if (stack < 0 && stack > -4096) { return 6; }
	var top i64 = (stack + stack_size) & ~15;

	var tid i64 = thread_clone(child, 0, top, CLONE_THREAD_FLAGS);
	if (tid <= 0) { return 7; }

	var spins i64 = 0;
	while (atomic_load(&done) == 0) {
		spins = spins + 1;
		if (spins % 1000 == 0) { sys_sched_yield(); }
		if (spins > 400000000) { return 8; }
	}

	if (child_seen != 0) { return 9; }
	if (count != 4) { return 10; }
	if (slots[7] != 99) { return 11; }
	if (slots[0] != 0) { return 12; }
	return 42;
}
