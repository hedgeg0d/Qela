// stage1-only
// expect-exit: 42
// Every task is pushed directly onto pool thread 0's queue, bypassing
// go()'s round-robin -- the only way the other three threads get any work
// at all is by stealing it out of thread 0's queue while idle. Each task
// records which thread actually ran it; if only worker 0 ever shows up,
// stealing never happened.
import "std/thread.qela";

let TASKS = 400;

var seen [32]i64;
var done_count i64 = 0;

fn task(n i64) i64 {
	atomic_add(&seen[pool_worker_id], 1);
	atomic_add(&done_count, 1);
	return 0;
}

// Pushes straight into queue 0's ring buffer, the same shape go() writes.
fn push_to_zero(fn_ptr i64, n i64) {
	while (!atomic_cas(&pool_lock[0], 0, 1)) { }
	var slot i64 = pool_tail[0] % POOL_QUEUE;
	pool_queue[0][slot].fn_ptr = fn_ptr;
	pool_queue[0][slot].a0 = n;
	pool_queue[0][slot].a1 = 0;
	pool_queue[0][slot].a2 = 0;
	pool_queue[0][slot].a3 = 0;
	pool_queue[0][slot].a4 = 0;
	pool_tail[0] = pool_tail[0] + 1;
	atomic_store(&pool_lock[0], 0);
}

fn main() int {
	thread_pool_init(4);

	var i i64 = 0;
	while (i < TASKS) {
		push_to_zero(task, i);
		i = i + 1;
	}

	var spins i64 = 0;
	while (atomic_load(&done_count) < TASKS) {
		spins = spins + 1;
		if (spins % 1000 == 0) { sys_sched_yield(); }
		if (spins > 500000000) { return 1; }
	}

	if (atomic_load(&seen[0]) + atomic_load(&seen[1]) + atomic_load(&seen[2]) + atomic_load(&seen[3]) != TASKS) {
		return 2;
	}
	// Real stealing: at least one task landed on a thread other than 0.
	if (atomic_load(&seen[1]) == 0 && atomic_load(&seen[2]) == 0 && atomic_load(&seen[3]) == 0) {
		return 3;
	}
	return 42;
}
