// interp-todo
// stage1-only
// expect-exit: 42
// A buffered channel actually shared between two real OS threads: one
// pushes, the other pops, both blocking on a channel too small to hold
// everything at once. Exercises the spinlock-guarded Chan(T) and the
// coro_live()==0 blocking path together.
import "std/chan.qela";
import "std/sys.qela";

let COUNT = 2000;

var ch Chan(i64);
var producer_done i64 = 0;

fn producer(arg i64) i64 {
	var i i64 = 0;
	while (i < COUNT) {
		chan_send(&ch, i);
		i = i + 1;
	}
	atomic_store(&producer_done, 1);
	return 0;
}

fn main() int {
	chan_init(&ch, 8);

	var stack_size i64 = 65536;
	var stack i64 = sys_mmap_anon(stack_size);
	if (stack < 0 && stack > -4096) { return 1; }
	var top i64 = (stack + stack_size) & ~15;

	var tid i64 = thread_clone(producer, 0, top, CLONE_THREAD_FLAGS);
	if (tid <= 0) { return 2; }

	var sum i64 = 0;
	var got i64 = 0;
	while (got < COUNT) {
		sum = sum + chan_recv(&ch);
		got = got + 1;
	}

	var want i64 = (COUNT as i64 - 1) * COUNT / 2;
	if (sum != want) { return 3; }

	var spins i64 = 0;
	while (atomic_load(&producer_done) == 0) {
		spins = spins + 1;
		if (spins % 1000 == 0) { sys_sched_yield(); }
		if (spins > 400000000) { return 4; }
	}
	return 42;
}
