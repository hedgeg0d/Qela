// stage1-only
// expect-exit: 0
// expect-out: 10 4
// expect-out: 2
// expect-out: 10
// vec[a, b, c]: a Vec literal with the element type inferred from the
// first element, rewritten at type time into vec_init + one vec_push
// per element -- the ordinary Vec API on the other side.
import "std/io.qela";
import "std/vec.qela";

fn main() int {
	var v = vec[1, 2, 3];
	v.push(4);
	var t i64 = 0;
	for x in v {
		t = t + x;
	}
	println("${t} ${v.len}");
	var w = vec["a", "b"];
	println("${w.len}");
	var u = vec[vec[1, 2], vec[3, 4]];
	var s i64 = 0;
	for inner in u {
		for x in inner {
			s = s + x;
		}
	}
	println("${s}");
	return 0;
}
