// stage1-only
// expect-exit: 0
// expect-out: 4-1-6-1
// vec_of([1, 2, 3]) is the vec literal: the slice parameter binds T from
// the array literal's element type (unify accepts an array where a slice
// is declared, and coerce wraps it), and the result is a growable Vec.
import "std/fmt.qela";
import "std/vec.qela";

fn main() int {
	var v = vec_of([1, 2, 3]);
	v.push(4);
	var a [2]i64 = [5, 6];
	var w = vec_of(a);
	var o = fmt_begin();
	o = fmt_put_i64(o, v.len);
	o = fmt_put_str(o, "-");
	o = fmt_put_i64(o, v[0]);
	o = fmt_put_str(o, "-");
	o = fmt_put_i64(o, w[1]);
	o = fmt_put_str(o, "-");
	o = fmt_put_i64(o, 3 in v);
	var r = fmt_result(o);
	sys_write(1, r.ptr, r.len);
	return 0;
}
