// stage1-only
// expect-exit: 0
import "std/math.qela";
import "std/fmath.qela";

fn main() int {
	var fails int = 0;

	var s f64 = sqrt(2.0);
	var d f64 = s * s - 2.0;
	if (d < 0.0) { d = -d; }
	if (d > 1e-9) { fails = fails + 1; }

	if (sqrt(0.0) != 0.0) { fails = fails + 1; }

	var sp f64 = sin(1.5707963267948966) - 1.0;
	if (sp < 0.0) { sp = -sp; }
	if (sp > 1e-4) { fails = fails + 1; }

	if (sin(0.0) != 0.0) { fails = fails + 1; }

	var cp f64 = cos(3.141592653589793) + 1.0;
	if (cp < 0.0) { cp = -cp; }
	if (cp > 1e-4) { fails = fails + 1; }

	var c0 f64 = cos(0.0) - 1.0;
	if (c0 < 0.0) { c0 = -c0; }
	if (c0 > 1e-4) { fails = fails + 1; }

	if (clamp(5, 0, 3) != 3) { fails = fails + 1; }
	if (clamp(-5, 0, 3) != 0) { fails = fails + 1; }
	if (clamp(2, 0, 3) != 2) { fails = fails + 1; }

	if (gcd(12, 18) != 6) { fails = fails + 1; }
	if (gcd(7, 5) != 1) { fails = fails + 1; }
	if (gcd(0, 5) != 5) { fails = fails + 1; }

	return fails;
}
