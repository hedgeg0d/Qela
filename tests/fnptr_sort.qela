// expect-exit: 42
// stage1-only
// std/sortcmp.qela sorts through a caller-supplied comparator function
// value. Two different comparators on the same array must give opposite
// orders.
import "std/sortcmp.qela";

fn lt(a i64, b i64) bool { return a < b; }
fn gt(a i64, b i64) bool { return a > b; }

fn main() int {
	var a [6]i64;
	a[0] = 5; a[1] = 1; a[2] = 4; a[3] = 2; a[4] = 3; a[5] = 0;
	sort_cmp(a, 0, 5, lt);
	var i i64 = 0;
	while (i < 6) {
		if (a[i] != i) { return i + 1; }
		i = i + 1;
	}
	var b [6]i64;
	b[0] = 5; b[1] = 1; b[2] = 4; b[3] = 2; b[4] = 3; b[5] = 0;
	sort_cmp(b, 0, 5, gt);
	i = 0;
	while (i < 6) {
		if (b[i] != 5 - i) { return 10 + i; }
		i = i + 1;
	}
	return 42;
}
