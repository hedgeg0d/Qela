// interp-skip
// expect-compile-error x86
// expect-exit: 0
// stage1-only
// A str is a {ptr, len} pair: two register words. On x86-64 a str that
// would straddle the 6-GPR budget (here: five ints fill rdi..r9, the str
// needs two more) is rejected -- SysV would move the whole pair onto the
// stack, which Qela does not marshal. AAPCS64 and LP64D have eight
// integer registers, so the same signature fits and the round trip below
// runs there.
extern fn ssum(a i64, b i64, c i64, d i64, e i64, s str) i64 {
	return a + b + c + d + e + s.len;
}
fn main() int {
	var r i64 = ssum(1, 2, 3, 4, 5, "hello");
	if (r != 20) { return 1; }
	return 0;
}