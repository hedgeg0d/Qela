// stage1-only
// expect-exit: 45
// More than 6 parameters: the 7th, 8th, 9th spill to the stack (rbp+16,
// +24, +32) instead of being rejected.
fn nine(a int, b int, c int, d int, e int, f int, g int, h int, i int) int {
	return a + b + c + d + e + f + g + h + i;
}
fn main() int {
	return nine(1, 2, 3, 4, 5, 6, 7, 8, 9);
}
