// interp-skip
// stage1-only
// x86-only
// expect-exit: 225
// expect-out: 481
// The encodings in docs/ASM.md, exercised end to end: mov imm32/reg,
// push/pop, add/sub, shl, lea, jmp rel8, cmp/test and syscall all as raw
// bytes and multi-byte constants.
import "std/io.qela";

let NOP      = 0x90;
let RET      = 0xc3;
let MOV_RAX_IMM32 = 0x48c7c0;
let MOV_RDI_IMM32 = 0x48c7c7;

fn naked return_path() int {
	asm(0x48, 0xc7, 0xc0, 5, 0, 0, 0);   // mov rax, 5
	asm(0x50, 0x48, 0x83, 0xc4, 8, 0x58, 0xc3);   // push rax; add rsp,8; pop rax; ret
}

fn main() int {
	var a i64 = asm(0x48c7c0, 55, 0, 0, 0);        // mov rax, 55
	var b i64 = asm(0x48, 0x83, 0xe8, 3);          // sub rax, 3
	var c i64 = asm(0x48, 0x83, 0xc0, 3);          // add rax, 3
	var d i64 = asm(0x48, 0xc1, 0xe0, 1);          // shl rax, 1
	var e i64 = asm(0x48, 0x8d, 0x80, 1, 0, 0, 0); // lea rax, [rax + 1]
	var f i64 = asm(0x48, 0xc1, 0xe8, 1);          // shr rax, 1
	var g i64 = asm(0x48, 0x31, 0xc0);             // xor rax, rax
	var h i64 = asm(0x48, 0xff, 0xc0);             // inc rax
	var i i64 = asm(0x48, 0xff, 0xc8);             // dec rax
	var j i64 = asm(0x48, 0x85, 0xc0);             // test rax, rax
	var k i64 = asm(0x48, 0x83, 0xf8, 0);          // cmp rax, 0
	var l i64 = asm(0x48, 0xb8, 0x2a, 0, 0, 0, 0, 0, 0, 0); // movabs rax, 42
	write_str(STDOUT, "${a + b + c + d + e + f + g + h + i + j + k + l}\n");
	return (a + b + c + d + e + f + g + h + i + j + k + l) as int;
}
