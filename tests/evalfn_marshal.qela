// expect-exit: 0
// expect-out: eval fn marshalling ok
// stage1-only
// eval fn host functions with str, float and struct signatures, called
// from eval'd and interpreted code.
import "std/eval.qela";
import "std/io.qela";

struct Pair { a i64, b i64 }
enum Lvl { Lo, Hi }

eval fn ulen(s str) i64 {
	return s.len;
}
eval fn ucat(a str, b str) str {
	var r str;
	if (a.len == 0) { return b; }
	r.ptr = a.ptr;
	r.len = a.len + b.len;
	return r;
}
eval fn usum(p Pair, x f64) f64 {
	return (p.a + p.b) as f64 + x;
}

fn interpreted from_interp(s str) i64 {
	return ulen(s) + ucat("x", s).len;
}
eval fn lvl_tag(l Lvl) i64 {
	return l as i64;
}
eval fn next_lvl(l Lvl) Lvl {
	if (l as i64 == 0) { return Lvl.Hi; }
	return Lvl.Lo;
}
enum Opt { Some(i64), None }
eval fn opt_val(o Opt) i64 {
	match (o) {
		Some(v) => return v;
		None => return -1;
	}
	return -1;
}
eval fn sum_sl(a []i64) i64 {
	var s i64 = 0;
	for x in a { s = s + x; }
	return s;
}
eval fn mk_opt(v i64) Opt {
	if (v > 0) { return Opt.Some(v); }
	return Opt.None;
}

eval var gsl [4]i64;

fn main() int {
	var fails i64 = 0;
	gsl[0] = 3; gsl[1] = 4; gsl[2] = 5; gsl[3] = 6;
	if (eval("ulen(\"hello\")") != 5) { fails = fails + 1; }
	if (eval("ucat(\"ab\", \"cd\").len") != 4) { fails = fails + 1; }
	if (eval("(usum(Pair{a: 3, b: 4}, 0.5) as i64)") != 7) { fails = fails + 1; }
	if (from_interp("abc") != 7) { fails = fails + 1; }
	if (eval("lvl_tag(Lvl.Hi)") != 1) { fails = fails + 1; }
	if (eval("lvl_tag(Lvl.Lo)") != 0) { fails = fails + 1; }
	if (eval("next_lvl(Lvl.Lo) as i64") != 1) { fails = fails + 1; }
	if (eval("next_lvl(Lvl.Hi) as i64") != 0) { fails = fails + 1; }
	if (eval("opt_val(Opt.Some(41))") != 41) { fails = fails + 1; }
	if (eval("opt_val(Opt.None)") != -1) { fails = fails + 1; }
	if (eval("sum_sl(gsl[0..4])") != 18) { fails = fails + 1; }
	if (eval("mk_opt(7) as i64") != 0) { fails = fails + 1; }
	if (eval("mk_opt(0) as i64") != 1) { fails = fails + 1; }
	if (fails == 0) { write_str(STDOUT, "eval fn marshalling ok\n"); }
	return fails as int;
}
