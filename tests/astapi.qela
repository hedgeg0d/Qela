// expect-exit: 0
// expect-out: all ast api paths ok
// stage1-only
// ast inspection and mutation: kind/value/count accessors, child
// handles, the statement chain, and type-checked child replacement.
import "std/eval.qela";
import "std/io.qela";
eval var price i64 = 10;
fn main() int {
	var fails i64 = 0;
	// the top-level handle of an expression parse is the value-capture
	// wrapper: exprstmt(lhs = assign(rhs = cast(lhs = <the expression>)))
	var a *Ast = parse_ast("price * 2 + 1");
	var w AstInfo = ast_info(a);
	if (!str_eq(w.kind, "exprstmt")) { fails = fails + 1; }
	var asg *Ast = ast_child(a, 0);
	var cst *Ast = ast_child(asg, 1);
	var expr *Ast = ast_child(cst, 0);
	var ei AstInfo = ast_info(expr);
	if (!str_eq(ei.kind, "add") || ei.count != 2) { fails = fails + 1; }
	var l *Ast = ast_child(expr, 0);
	var li AstInfo = ast_info(l);
	if (!str_eq(li.kind, "mul")) { fails = fails + 1; }
	var lv *Ast = ast_child(l, 0);
	var lvi AstInfo = ast_info(lv);
	if (!str_eq(lvi.kind, "var")) { fails = fails + 1; }
	var one *Ast = ast_child(expr, 1);
	var oi AstInfo = ast_info(one);
	if (!str_eq(oi.kind, "num") || oi.value != 1) { fails = fails + 1; }
	var two *Ast = parse_ast("2");
	var two_expr *Ast = ast_child(ast_child(ast_child(two, 0), 1), 0);
	if (!ast_set(expr, 1, two_expr)) { fails = fails + 1; }
	var r i64 = run_ast(a);
	if (r != 22) { fails = fails + 1; }
	var s *Ast = parse_ast("var x = 1; x + 1;");
	var s2 *Ast = ast_next(s);
	if (s2 as i64 == 0) { fails = fails + 1; }
	var si AstInfo = ast_info(s2);
	if (!str_eq(si.kind, "exprstmt")) { fails = fails + 1; }
	var bad *Ast = parse_ast("true");
	if (ast_set(expr, 1, bad)) { fails = fails + 1; }
	var r2 i64 = run_ast(a);
	if (r2 != 22) { fails = fails + 1; }
	if (ast_set(a, 9, two_expr)) { fails = fails + 1; }
	var ni AstInfo = ast_info(null);
	if (ni.count != 0) { fails = fails + 1; }
	if (fails == 0) { write_str(STDOUT, "all ast api paths ok\n"); }
	return fails as int;
}
