// stage1-only
// expect-exit: 42
// std/math.qela and std/sort.qela, written in the bootstrap subset. The
// import of a "std/..." module resolves via S2's embedded library; stage0
// resolves every import against the importing file, so it skips this.
import "std/math.qela";
import "std/sort.qela";

fn main() int {
	if (abs(-7) != 7) { return 1; }
	if (abs(9) != 9) { return 2; }
	if (min(3, 8) != 3) { return 3; }
	if (max(3, 8) != 8) { return 4; }
	if (min(-4, -9) != -9) { return 5; }

	var a [9]i64;
	a[0] = 3;
	a[1] = 1;
	a[2] = 4;
	a[3] = 1;
	a[4] = 5;
	a[5] = 9;
	a[6] = 2;
	a[7] = 6;
	a[8] = 5;
	sort_i64(a[0..9], 0, 8);
	var i i64 = 1;
	while (i < 9) {
		if (a[i - 1] > a[i]) { return 6; }
		i = i + 1;
	}
	// sorted: 1 1 2 3 4 5 5 6 9; 10 * (7 - 3) + 2 = 42
	if (a[0] != 1 || a[8] != 9) { return 7; }
	if (a[3] != 3 || a[4] != 4 || a[5] != 5) { return 8; }
	return (a[0] + a[8]) * (max(3, 7) - min(3, 7)) + abs(-2);
}
