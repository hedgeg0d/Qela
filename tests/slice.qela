// expect-exit: 1
fn sum(xs []int) int {
	var t int = 0;
	for i in 0..xs.len {
		t += xs[i];
	}
	return t;
}

fn head(xs []int, k int) []int {
	return xs[..k];
}

fn main() int {
	var ok int = 1;
	var a [6]int;
	for i in 0..6 {
		a[i] = i + 1;
	}
	if (sum(a[..]) != 21) { ok = 0; }
	if (sum(a[2..4]) != 7) { ok = 0; }
	if (sum(head(a[..], 3)) != 6) { ok = 0; }
	let s = a[1..5];
	if (s.len != 4) { ok = 0; }
	if (s[0] != 2) { ok = 0; }
	let t = s[1..3];
	if (t.len != 2 || t[0] != 3 || t[1] != 4) { ok = 0; }
	let msg = "abc";
	if (msg.len != 3 || msg[0] != 97) { ok = 0; }
	return ok;
}
