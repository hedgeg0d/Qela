// stage1-only
// expect-exit: 42
import "std/map.qela";

fn main() int {
	var m Map(i64);
	map_init(&m);
	map_put(&m, "a", 1);
	map_put(&m, "b", 2);
	map_put(&m, "c", 3);
	if (m["b"] != 2) { return 1; }
	if (m["z"] != 0) { return 2; }
	if (map_len(&m) != 3) { return 3; }
	if (map_has(&m, "z")) { return 4; }

	m["b"] = 40;
	if (m["b"] != 40) { return 5; }
	if (map_len(&m) != 3) { return 6; }

	if (!str_eq(map_key_at(&m, 0), "a")) { return 7; }
	if (map_val_at(&m, 1) != 40) { return 8; }

	var i i64 = 0;
	while (i < 300) {
		map_put(&m, "k${i}", i + 10);
		i = i + 1;
	}
	if (m["k29"] != 39) { return 9; }
	if (map_len(&m) != 303) { return 10; }

	var seen i64 = 0;
	for k in m { seen = seen + k.len; }
	if (seen < 300) { return 11; }

	var s Map(str);
	map_init(&s);
	s["name"] = "qela";
	if (!str_eq(s["name"], "qela")) { return 12; }

	return (m["k29"] + 3) as int;
}
