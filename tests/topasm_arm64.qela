// stage1-only
// arm64-only
// expect-exit: 42
// Top-level asm bytes are the image's first bytes. `entry start` makes the
// naked function the ELF entry: it branches into the rest of the program
// with `$rel` and exits on its own.
asm { 0x00, 0x00, 0x00, 0x14 }; // b .

var stack_top [256]u8;

entry start;

fn naked start() {
	asm($stack_top);                  // x0 = &stack_top (MOVZ+MOVK)
	asm(0xe1, 0x03, 0x00, 0xaa);      // mov x1, x0
	asm(0x40, 0x05, 0x80, 0xd2);      // mov x0, #42
	asm(0x20, 0x00, 0x00, 0xf9);      // str x0, [x1]
	asm($rel kmain);                  // bl kmain
	asm(0xc0, 0x03, 0x5f, 0xd6);      // ret (never: kmain exits)
}

fn kmain() int {
	asm(0x21, 0x00, 0x40, 0xf9);      // ldr x1, [x1]
	asm(0xe0, 0x03, 0x01, 0xaa);      // mov x0, x1
	asm(0xc8, 0x0b, 0x80, 0xd2);      // mov x8, #94 (exit_group)
	asm(0x01, 0x00, 0x00, 0xd4);      // svc #0
	return 0;
}
