// stage1-only
// arm64-only
// expect-exit: 225
// A sequence of raw A64 words, each expression re-initialising X0 (the
// backend cannot be assumed to keep X0 live between asm blocks): movz/
// add/lsr/lsl/eor round-trip through the accumulator.
fn main() int {
	var a i64 = asm(0x00, 0x05, 0x80, 0xd2, 0x00, 0x04, 0x00, 0x91);
	var b i64 = asm(0x00, 0x05, 0x80, 0xd2, 0x00, 0x08, 0x00, 0x91);
	var c i64 = asm(0x00, 0x05, 0x80, 0xd2, 0x00, 0xfc, 0x41, 0x93);
	var d i64 = asm(0x00, 0x05, 0x80, 0xd2, 0x00, 0xf8, 0x7f, 0x93);
	var e i64 = asm(0x00, 0x05, 0x80, 0xd2, 0x00, 0x00, 0x00, 0xca);
	var f i64 = asm(0x40, 0x05, 0x80, 0xd2);
	return (a + b + c + d + e + f) as int;
}
