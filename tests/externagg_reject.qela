// interp-skip
// expect-compile-error riscv64
// expect-exit: 0
// stage1-only
// An all-float struct of 17..32 bytes is not uniformly MEMORY: on
// AArch64/LP64D it can be an HFA and ride the FP registers, where Qela
// cannot stage it past 16 bytes. LP64D accepts up to eight HFA elements,
// so a six-element {f32...} is rejected there; AAPCS64 caps the HFA at
// four, so the same struct falls to the memory path and compiles, as it
// does on x86-64, where every aggregate wider than 16 bytes is stacked
// (verified against gcc for a 24-byte all-double struct). The body-ful
// round trip below proves the memory path on the targets that take it.
struct S6 { a f32, b f32, c f32, d f32, e f32, f f32 }
extern fn s6_sum(s S6, k f32) f64 {
	return s.a as f64 + s.b as f64 + s.c as f64 + s.d as f64 +
	       s.e as f64 + s.f as f64 + (k as f64);
}
fn main() int {
	var s S6 = S6{a: 1.0 as f32, b: 2.0 as f32, c: 3.0 as f32,
	              d: 4.0 as f32, e: 5.0 as f32, f: 6.0 as f32};
	var r f64 = s6_sum(s, 7.0);
	if (r < 27.99 || r > 28.01) { return 1; }
	return 0;
}