// expect-exit: 0
// expect-out: all marshalled paths ok
// stage1-only
// interpreted/dynamic functions with str, float and struct signatures,
// both over the runtime ABI wire and through the jit's rewritten
// out-parameter form.
struct P { x i64, y i64 }
struct Big { a i64, b i64, c i64, d i64 }
struct Bag { tag i64, s str, n i64 }

fn dynamic dlen(s str) i64 { return s.len; }
fn interpreted ilen(s str) i64 { return s.len; }
fn dynamic dgreet(s str) str { return s; }
fn interpreted igreet(s str) str { return s; }
fn dynamic dsum(p P) i64 { return p.x + p.y; }
fn interpreted isum(p P) i64 { return p.x + p.y; }
fn dynamic dbig(b Big) i64 { return b.a + b.b + b.c + b.d; }
fn interpreted ibig(b Big) i64 { return b.a + b.b + b.c + b.d; }
fn dynamic dfmul(x f64, y f64) f64 { return x * y; }
fn interpreted ifmul(x f64, y f64) f64 { return x * y; }
fn dynamic dbag(b Bag) i64 { return b.tag + b.s.len + b.n; }
fn interpreted ibag(b Bag) i64 { return b.tag + b.s.len + b.n; }
fn interpreted i7(a i64, b i64, c i64, d i64, e i64, f i64, g i64) i64 { return a + b + c + d + e + f + g; }
fn dynamic dfib(n i64) i64 {
	if (n < 2) { return n; }
	return dfib(n - 1) + dfib(n - 2);
}
fn dynamic dlenrec(s str, n i64) i64 {
	if (n <= 0) { return s.len; }
	return dlenrec(s, n - 1);
}
fn dynamic dgreetrec(s str, n i64) str {
	if (n <= 0) { return s; }
	return dgreetrec(s, n - 1);
}
fn dynamic dsumrec(s str, n i64) i64 {
	if (n <= 0) { return s.len; }
	return dsumrec(s, n - 1) + dsumrec(s, n - 2);
}

// Slices of POD elements and POD-payload enums cross the wire as raw
// images now; a >16-byte enum rides the by-ref parameter path.
enum E { A(i64), B }
enum BigE { N(i64, i64, i64), Z }
struct H { tag i64, xs []i64 }

eval var gsl [4]i64;

fn dynamic dsumsl(a []i64) i64 {
	var s i64 = 0;
	for x in a { s = s + x; }
	return s;
}
fn interpreted isumsl(a []i64) i64 {
	var s i64 = 0;
	for x in a { s = s + x; }
	return s;
}
fn dynamic dmksl(n i64) []i64 { return gsl[0..n]; }
fn interpreted imksl(n i64) []i64 { return gsl[0..n]; }
fn dynamic dopt(o E) i64 {
	match (o) {
		A(v) => return v;
		B => return 0;
	}
	return 0;
}
fn interpreted iopt(o E) i64 {
	match (o) {
		A(v) => return v;
		B => return 0;
	}
	return 0;
}
fn dynamic dmkopt(v i64) E {
	if (v > 0) { return E.A(v); }
	return E.B;
}
fn interpreted imkopt(v i64) E {
	if (v > 0) { return E.A(v); }
	return E.B;
}
fn dynamic dbe(b BigE) i64 {
	match (b) {
		N(x, y, z) => return x + y + z;
		Z => return 0;
	}
	return 0;
}
fn interpreted ibe(b BigE) i64 {
	match (b) {
		N(x, y, z) => return x + y + z;
		Z => return 0;
	}
	return 0;
}
fn dynamic dmkbig() BigE { return BigE.N(1, 2, 3); }
fn interpreted imkbig() BigE { return BigE.N(1, 2, 3); }
fn dynamic dh(h H) i64 {
	var s i64 = h.tag;
	for x in h.xs { s = s + x; }
	return s;
}
fn interpreted ih(h H) i64 {
	var s i64 = h.tag;
	for x in h.xs { s = s + x; }
	return s;
}

fn main() int {
	var fails i64 = 0;
	gsl[0] = 1; gsl[1] = 2; gsl[2] = 3; gsl[3] = 4;
	if (dlen("abcd") != 4) { fails = fails + 1; }
	if (ilen("xyz") != 3) { fails = fails + 1; }
	if (dgreet("hi").len != 2) { fails = fails + 1; }
	if (igreet("yo").len != 2) { fails = fails + 1; }
	var p P = P{x: 1, y: 2};
	if (dsum(p) != 3) { fails = fails + 1; }
	if (isum(p) != 3) { fails = fails + 1; }
	var b Big = Big{a: 1, b: 2, c: 3, d: 4};
	if (dbig(b) != 10) { fails = fails + 1; }
	if (ibig(b) != 10) { fails = fails + 1; }
	if (dfmul(2.5, 4.0) != 10.0) { fails = fails + 1; }
	if (ifmul(2.5, 4.0) != 10.0) { fails = fails + 1; }
	var bag Bag = Bag{tag: 10, s: "abc", n: 5};
	if (dbag(bag) != 18) { fails = fails + 1; }
	if (ibag(bag) != 18) { fails = fails + 1; }
	if (i7(1, 2, 3, 4, 5, 6, 7) != 28) { fails = fails + 1; }
	if (dfib(10) != 55) { fails = fails + 1; }
	if (dlenrec("abcd", 4) != 4) { fails = fails + 1; }
	if (dgreetrec("yo", 3).len != 2) { fails = fails + 1; }
	if (dsumrec("ab", 5) != 26) { fails = fails + 1; }

	var arr [4]i64 = [1, 2, 3, 4];
	if (dsumsl(arr[0..4]) != 10) { fails = fails + 1; }
	if (isumsl(arr[0..3]) != 6) { fails = fails + 1; }
	var sl []i64 = dmksl(3);
	if (sl.len != 3 || sl[0] != 1 || sl[2] != 3) { fails = fails + 1; }
	var sl2 []i64 = imksl(4);
	if (sl2.len != 4 || sl2[3] != 4) { fails = fails + 1; }
	if (dopt(E.A(5)) != 5) { fails = fails + 1; }
	if (dopt(E.B) != 0) { fails = fails + 1; }
	if (iopt(E.A(7)) != 7) { fails = fails + 1; }
	if ((dmkopt(9) as i64) != 0) { fails = fails + 1; }
	if ((dmkopt(0) as i64) != 1) { fails = fails + 1; }
	if ((imkopt(9) as i64) != 0) { fails = fails + 1; }
	if (dbe(BigE.N(1, 2, 3)) != 6) { fails = fails + 1; }
	if (dbe(BigE.Z) != 0) { fails = fails + 1; }
	if (ibe(BigE.N(4, 5, 6)) != 15) { fails = fails + 1; }
	var be BigE = dmkbig();
	if (be as i64 != 0) { fails = fails + 1; }
	var be2 BigE = imkbig();
	if (be2 as i64 != 0) { fails = fails + 1; }
	var h H = H{tag: 3, xs: arr[0..2]};
	if (dh(h) != 6) { fails = fails + 1; }
	if (ih(h) != 6) { fails = fails + 1; }
	if (fails == 0) { write_str(STDOUT, "all marshalled paths ok\n"); }
	return fails as int;
}
