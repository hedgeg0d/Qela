// stage1-only
// expect-exit: 0
// expect-out: 16 8
// expect-out: 1 3 14 0 1048575
// expect-out: 1 1 14
// expect-out: 115
import "std/io.qela";

packed struct Idt {
	lo u16,
	sel u16,
	ist u8,
	attr u8,
	mid u16,
	hi u32,
	zero u32,
}

struct Flags {
	present u8 : 1,
	dpl u8 : 2,
	kind u8 : 4,
	spare u8 : 1,
	tail u32 : 20,
}

fn main() int {
	println("${sizeof(Idt)} ${sizeof(Flags)}");
	var f Flags;
	f.present = 1;
	f.dpl = 3;
	f.kind = 14;
	f.tail = 1048575;
	println("${f.present} ${f.dpl} ${f.kind} ${f.spare} ${f.tail}");
	f.dpl = 1;
	println("${f.present} ${f.dpl} ${f.kind}");
	var raw *u8 = &f as *u8;
	println("${raw[0] as i64}");
	return 0;
}
